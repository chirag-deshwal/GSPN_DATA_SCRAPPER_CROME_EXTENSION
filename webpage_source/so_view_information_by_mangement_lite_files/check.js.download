// 주어진 날자와 오늘 날자가 같은지를 확인한다.
function checkEqualToday(_checkDay) {
	var _toDay = getToday();
	var _tgDay = trimSlash(_checkDay);

	if(_toDay == _tgDay) {
		return true;
	} else {
		return false;
	}
}

// 오늘 날자 구하기
function getToday() {
	date = new Date();
	var year = date.getYear();
	var month = date.getMonth()+1;
 	var day = date.getDate();

	if (month < 10) month = "0" + month;
	if (day < 10) day = "0" + day;

	return year + "" + month + "" + day;
}


// 오늘 날자 구하기2
function getToday2() {
	date = new Date();
	var year = date.getYear();
	var month = date.getMonth()+1;
 	var day = date.getDate();

	if (month < 10) month = "0" + month;
	if (day < 10) day = "0" + day;

	return year + "." + month + "." + day;
}

// 오늘 날자 구하기3
function getToday3(str) {
	date = new Date();
	var year = date.getYear();
	var month = date.getMonth()+1;
 	var day = date.getDate();

	if (month < 10) month = "0" + month;
	if (day < 10) day = "0" + day;

	return year + str + month + str + day;
}

// 해당 년/월에 해당하는 가장 첫번째 날짜를 구한다
function getFirstDay(str) {
	date = new Date();
	var year = date.getYear();
	var month = date.getMonth()+1;

	if (month < 10) month = "0" + month;

	var total_days = year + str + month + str + '01';

	return total_days
}

// 빠른 SUM 계산 처리
var sumValueF = 0;

function sumFocusField(formName, obj) {
	sumValueF = obj.value;
}

function sumBlurField(formName, obj, targetName) {
	var targetObj = document[formName].elements[targetName];
	var oldValue = targetObj.value;
	var newValue = oldValue - sumValueF;

	targetObj.value = eval(newValue) + eval(obj.value);
	//targetObj.value = eval(targetObj.value) - sumValueF;
	//targetObj.value = eval(targetObj.value) + eval(obj.value);
}

function sumBlurFieldOther(formName, objValue, targetName) {
	var targetObj = document[formName].elements[targetName];
	targetObj.value = eval(targetObj.value) - eval(objValue);
}

// 삭제 한번으로 2개의 필드에 영향을 준다.
function sumBlurFieldOtherTwo(formName, objValue1, targetName1, objValue2, targetName2) {
	var targetObj1 = document[formName].elements[targetName1];
	    targetObj2 = document[formName].elements[targetName2];
	targetObj1.value = eval(targetObj1.value) - eval(objValue1);
	targetObj2.value = eval(targetObj2.value) - eval(objValue2);
}

// 몇번째 필드인가를 확인한다.
// EX. abc.def[0].gh 라는 필드명에서 0을 리턴해준다.
function thisFieldLine(_str) {
	var str="";
	    isStart = "";

	for(i=0; i<_str.length; i++) {
		var c=_str.charAt(i);
		if(c=="[" || isStart=="T") {
			if(c=="]") return removeChar(str,"[");
			isStart="T";
			str += c;
		}
	}
	return _str;
}


// 날짜에서 얼마간을 더한 값을 세팅해준다
// _targetObj : 날짜값을 받아오고 세팅해줄 object
// _plusDay : 더할 일수
// _type : 날짜를 구분할 캐릭터(-, /)
function plusDay(_targetObj, _plusDay, _type){
	var inputDay = removeChar(_targetObj.value, _type);
	var date = new Date(inputDay.substring(0,4), inputDay.substring(4,6)-1, inputDay.substring(6,8));
	date.setDate(date.getDate() + parseInt(_plusDay));

	var month = date.getMonth()+1;
	var day = date.getDate();

	if (month < 10) month = "0" + month;
	if (day < 10) day = "0" + day;

	_targetObj.value = date.getYear()+ _type + month + _type + day;

	_targetObj.fireEvent("onchange");

}

// 날짜에서 얼마간을 더한 값을 리턴해준다.
// _targetObj : 날짜값을 받아오는 object
// _plusDay : 더할 일수
// _type : 날짜를 구분할 캐릭터(-, /)
function rtnPlusDay(_targetObj, _plusDay, _type){
	var inputDay = removeChar(_targetObj.value, _type);
	var date = new Date(inputDay.substring(0,4), inputDay.substring(4,6)-1, inputDay.substring(6,8));
	date.setDate(date.getDate() + parseInt(_plusDay));

	var month = date.getMonth()+1;
	var day = date.getDate();

	if (month < 10) month = "0" + month;
	if (day < 10) day = "0" + day;

	var newDay = date.getYear()+ _type + month + _type + day;

	return newDay;
}


// 날짜에서 달수를 더해준다.
// _targetObj : 날짜값을 받아오고 세팅해줄 object
// _plusMonth : 더할 달수
// _type : 날짜를 구분할 캐릭터(-, /)
function plusMonth(_targetObj, _plusMonth, _type){
	var inputDay = removeChar(_targetObj.value, _type);
	var date = new Date(inputDay.substring(0,4), inputDay.substring(4,6)-1, 1);
	date.setMonth(date.getMonth() + parseInt(_plusMonth));

	var month = date.getMonth()+1;

	if (month < 10) month = "0" + month;
	_targetObj.value = date.getYear()+ _type + month;
	_targetObj.fireEvent("onchange");
}

// 두 날짜간 실제 일수 구하기
function daysBetween(sdate1, sdate2)
{
  var date1 = new Date(parseInt(sdate1.substr(0,4), 10),
                       parseInt(sdate1.substr(4,2), 10)-1,
                       parseInt(sdate1.substr(6,2), 10));
  var date2 = new Date(parseInt(sdate2.substr(0,4), 10),
                       parseInt(sdate2.substr(4,2), 10)-1,
                       parseInt(sdate2.substr(6,2), 10));
  // constants used for our calculations below
  var oneDay = 1000 * 60 * 60 * 24;
  var diff =date2.getTime() - date1.getTime();

  return Math.ceil(diff/oneDay);
}

/**
 *
 * @param dateType(숫자형식) from~to를 계산하는 형태를 나타낸다
 *					1 : 당일
 *					2 : 해당 주
 *					3 : 해당월
 *					4 : 해당년
 *					5 : 특정일(period) 전
					6 : 당월(1일 ~ 현재일)
 * @param period from ~ to 계산시에 며칠 전으로 세팅할지를 넣어준다
 * @param stDateObj from 에 해당하는 날짜 input textfield object 를 넣어준다
 * @param endDateObj to 에 해당하는 날짜 input textfield object 를 넣어준다.
 * @param today 오늘 날짜 8자리를 얻어온다(서버에서 얻어와야 한다. 클라이언트 날짜 설정이 틀릴수도 있으므로)
 * @param delimeter / 혹은 - 등을 설정한다
 */
function setPeriod(dateType, period, stDateObj, endDateObj, today, delimeter){

	var st, end, date, day;
	var stYear, stMonth, stDate, sDay, endYear, endMonth, endDate, endDay;

	today = removeChar(today, delimeter);

	// 오늘에 해당하는 날짜객체 구하기
	date = new Date(today.substring(0,4), parseInt(today.substring(4,6),10)-1, today.substring(6,8));

	switch(dateType){
		case 1:
			stYear=date.getYear();endYear=date.getYear();
			stMonth=date.getMonth()+1;endMonth=date.getMonth()+1;
			stDate=date.getDate();endDate=date.getDate();
			break;
		case 2:
			// 오늘이 무슨 요일인지를 구한다
			day = date.getDay();

			// 해당 주의 월요일에 해당하는 날짜 구하기
			st = new Date(date);
			st.setDate(st.getDate() - (day - 1));

			// 해당 주의 일요일에 해당하는 날짜 구하기
			end = new Date(date);
			end.setDate(end.getDate() + (7 - day));

			stYear = st.getYear(); stMonth = st.getMonth() + 1; stDate = st.getDate();
			endYear = end.getYear(); endMonth = end.getMonth() + 1; endDate = end.getDate();
			break;
		case 3:
			stYear = date.getYear(); stMonth = date.getMonth() + 1; stDate = 1;
			endYear = date.getYear(); endMonth = date.getMonth() + 1; endDate = getLastDay(date.getYear(), date.getMonth()+1);
			break;
		case 4:
			stYear = date.getYear(); stMonth = 1; stDate = 1;
			endYear = date.getYear(); endMonth = 12; endDate = 31;
			break;
		case 5:
			st = new Date(date);
			st.setDate(st.getDate() + parseInt(period));
			stYear = st.getYear(); stMonth = st.getMonth()+1; stDate = st.getDate();
			endYear = date.getYear(); endMonth = date.getMonth()+1; endDate = date.getDate();
			break;
		case 6:
			stYear = date.getYear(); stMonth = date.getMonth() + 1; stDate = 1;
			endYear = date.getYear(); endMonth = date.getMonth() + 1; endDate = date.getDate();
			break;
		default: break;
	}


	if (stMonth < 10) stMonth = "0" + stMonth;
	if (stDate < 10) stDate = "0" + stDate;
	if (endMonth < 10) endMonth = "0" + endMonth;
	if (endDate < 10) endDate = "0" + endDate;

	stDateObj.value = stYear + delimeter + stMonth + delimeter + stDate;
	endDateObj.value = endYear + delimeter + endMonth + delimeter + endDate;
}



// 해당 년/월에 해당하는 가장 마지막 날짜를 구한다
function getLastDay(year, month) {
	var total_days

	// 각 달의 총 날수를 구한다.
	if(month == 1) total_days = 31
	else if(month == 2) {
		// 윤년 조사
		if(((year % 4 == 0) && (year % 100 != 0)) || (year % 400 == 0)) {
			total_days = 29
		}
		else {
			total_days = 28
		}
	}
	else if(month == 3) { total_days = 31 }
	else if(month == 4) { total_days = 30 }
	else if(month == 5) { total_days = 31 }
	else if(month == 6) { total_days = 30 }
	else if(month == 7) { total_days = 31 }
	else if(month == 8) { total_days = 31 }
	else if(month == 9) { total_days = 30 }
	else if(month == 10) { total_days = 31 }
	else if(month == 11) { total_days = 30 }
	else if(month == 12) { total_days = 31 }

	return total_days
}


//반드시 하나의 체크박스를 선택하였는지를 검사하여
//단하나만 선택되었을 경우 선택된 키값을 넘겨준다.
function getCheckKey(formName){
	var checkCnt = 0;
	var selectKey;

	for( var i=0; i<document[formName].length && checkCnt < 2 ; i++) {
		var ele = document[formName][i];

		if (ele.type=='checkbox') {
			if(ele.name == 'selectKey'){
				if(ele.checked==true){
					checkCnt ++ ;
					selectKey = ele.value;
				}
			}
		}
	}
	if( checkCnt == 1 ){
		return selectKey;
	}else if( checkCnt == 0 ){
		alert('작업할 대상을 선택하십시오.');
		return null;
	}else{
		alert('하나의 대상만 선택하십시오.');
		return null;
	}
}

//리스트에서 삭제 체크박스을 모두 non check로 만든다.(Nothing)
function checkNothing(formName, checkElemName){
	if(checkElemName == null || checkElemName == "")
	{
		checkElemName = 'selectKey';
	}

	for( var i=0; i<document[formName].length; i++) {
		var ele = document[formName][i];

		if (ele.type=='checkbox') {
			if(ele.name == checkElemName){
				ele.checked=false;
			}
		}
	}
	return;
}

