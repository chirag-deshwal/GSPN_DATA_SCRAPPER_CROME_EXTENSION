function checkMod(a, b, gubun)
{
	var compSt = "";

	compSt = String(a / b);
	index = compSt.indexOf(gubun);

	if(index < 0) return true;

	return false;
}


function compFormatCheck(_compFormat)
{
  var gubun = "";

  if( _compFormat.indexOf("-")>0 ){
	gubun = "-";
  }else if( _compFormat.indexOf("/")>0 ){
	gubun = "/";
  }else if( _compFormat.indexOf(".")>0 ){
	gubun = ".";
  }

  return gubun;
}


function toDisplayDay(_date, _gubun, _compFormat)
{
  var Day = "";

  if(typeof(_date) == 'object'){
	  _date = _date.value;
  }
  
  if( _date.length == 10 ){
	if( removeChar(_compFormat.toUpperCase(),_gubun) == "YYYYMMDD" ){
	  Day = _date.substring(8,10);
	}else if( removeChar(_compFormat.toUpperCase(),_gubun) == "MMDDYYYY" ){
	  Day = _date.substring(3,5);
	}else if( removeChar(_compFormat.toUpperCase(),_gubun) == "DDMMYYYY" ){
	  Day = _date.substring(0,2);
	}
  } else {
	Day = _date.substring(6,8);
  }

  return Day;
}


function toDisplayMonth(_date, _gubun, _compFormat)
{
  var Mon = "";
  
  if(typeof(_date) == 'object'){
	  _date = _date.value;
  }
  
  if( _date.length == 10 ){
	if( removeChar(_compFormat.toUpperCase(),_gubun) == "YYYYMMDD" ){
	  Mon = _date.substring(5,7);
	}else if( removeChar(_compFormat.toUpperCase(),_gubun) == "MMDDYYYY" ){
	  Mon = _date.substring(0,2);
	}else if( removeChar(_compFormat.toUpperCase(),_gubun) == "DDMMYYYY" ){
	  Mon = _date.substring(3,5);
	}
  } else {
	Mon = _date.substring(4,6);
  }

  return Mon;
}


function toDisplayYear(_date, _gubun, _compFormat)
{
  var Year = "";
  
  if(typeof(_date) == 'object'){
	  _date = _date.value;
  }
  
  if( _date.length == 10 ){	 
	if( removeChar(_compFormat.toUpperCase(),_gubun) == "YYYYMMDD" ){
	  Year = _date.substring(0,4);
	}else if( removeChar(_compFormat.toUpperCase(),_gubun) == "MMDDYYYY" ){
	  Year = _date.substring(6,10);
	}else if( removeChar(_compFormat.toUpperCase(),_gubun) == "DDMMYYYY" ){
	  Year = _date.substring(6,10);
	}
  } else {
	Year = _date.substring(0,4);
  }

  return Year;
}


function checkDateFormat(obj, delKey, direction, compFormat)
{
  var gubun = compFormatCheck( compFormat );

  if (obj.value.length < 10){
  	if (delKey != 9){
	  	if(delKey !=8 && delKey !=46 && delKey !=16 && !(delKey > 36 && delKey < 41)){
  			var _str = obj.value.length;
   			if ((delKey >= 48 && delKey <= 57) || (delKey >= 96 && delKey <=105)){
				if( removeChar(compFormat.toUpperCase(),gubun).substring(0,4) == "YYYY" ){
			    	if (_str == 4 && obj.value.indexOf(gubun) <= 0){
			    		obj.value = obj.value + gubun;
			    	} else if (_str == 5 && obj.value.indexOf(gubun) == 3){
			    		obj.value = obj.value.substring(0,3).concat(obj.value.substring(4,5)).concat(obj.value.substring(3,4));
			    	} else if (_str == 7 && obj.value.lastIndexOf(gubun) == 4){
			    		obj.value = obj.value + gubun;
					} else if (_str == 8 && obj.value.lastIndexOf(gubun) == 6){
			    		obj.value = obj.value.substring(0,6).concat(obj.value.substring(7,8)).concat(obj.value.substring(6,7));
			    	}
			    } else { // MMDDYYYY or DDMMYYYY
			    	if (_str == 2 && obj.value.indexOf(gubun) <= 0){
			    		obj.value = obj.value + gubun;
			    	} else if (_str == 3 && obj.value.indexOf(gubun) == 1){
			    		obj.value = obj.value.substring(0,1).concat(obj.value.substring(2,3)).concat(obj.value.substring(1,2));
			    	} else if (_str == 5 && obj.value.lastIndexOf(gubun) == 2){
			    		obj.value = obj.value + gubun;
			    	} else if (_str == 6 && obj.value.lastIndexOf(gubun) == 4){
			    		obj.value = obj.value.substring(0,4).concat(obj.value.substring(5,6)).concat(obj.value.substring(4,5));
			    	}
			    }
   			} else {
   				if (direction == "up"){
     				if (obj.value.length == 0){
      					obj.value = ""
	     			} else {
		      			obj.value = obj.value.substring(0,obj.value.length-1)
	   				}
    			}
	 		}
  			obj.focus()
	  	}
 	} else {
 		if (direction == "down"){
 			checkDate(obj, compFormat);
  		}
  	}
  } else {
    if (delKey != 229){
	  if ((delKey > 34 && delKey < 41) || (delKey > 47 && delKey < 58) || (delKey > 95 && delKey < 106) || delKey == 8 || delKey == 9 || delKey == 13 || delKey == 46){
		if (direction == "up"){
		  checkDate(obj, compFormat);
	    }
	  } else {
	  	if (direction == "up"){
	  	  obj.value = obj.value.substring(0,obj.value.length-1);
	    }
	    obj.focus();
  	  }
  	}
  }
}


function isEmail(_str)
{
  return _str.search(/^\s*[\w\~\-\.]+\@[\w\~\-]+(\.[\w\~\-]+)+\s*$/g)>=0;
}

function isEmptyString(_str)
{
  var str = trim(_str);
  if ( str == null || str == "" ){
	return false;
  }
  return true;
}


function timeCheck(_obj)
{
  var err = 0;
  var hh, mm;
  var chartest = "";
  if( typeof _obj === "object" ){
	chartest = removeChar(_obj.value,":");
  }else{
	chartest = removeChar(_obj,":");
  }
  if (chartest == '') return true;
  if (chartest.length != 4) { return false; }
  if (isNaN(chartest)) return false;
  hh = chartest.substring(0, 2); // hour
  mm = chartest.substring(2, 4); // min
  if (hh < 0 || hh > 24) err = 1;
  if (mm < 0 || mm > 60) err = 1;
  if (err == 1) { return false; }
  return true;
} 


function AddMonths(date_string,mm) {
	var date = toTimeObject(date_string);
	date.setMonth(date.getMonth() + mm );
	return toTimeString(date) ;
}


function converttoDBFormat(_date, compFormat)
{
  var Year = "";
  var Mon  = "";
  var Day  = "";
  var _displayDate = "";

  var gubun = compFormatCheck( compFormat );

  //if( _date == "[object]" ){
  if(typeof(_date) == "object") {
	_displayDate = _date.value;
  } else { 
	_displayDate = _date;
  }

  Year = toDisplayYear(_displayDate, gubun, compFormat);
  Mon = toDisplayMonth(_displayDate, gubun, compFormat);
  Day = toDisplayDay(_displayDate, gubun, compFormat);

  return Year.concat(Mon).concat(Day);
}

function converttoTimeFormat(_str)
{
  var _displayTime = "";
  var temp=""

  //if( _str == "[object]" ){
  if(typeof(_str) == "object") {
	_displayTime = _str.value;
  } else { 
	_displayTime = _str;
  }

  for(var i=0;i<_displayTime.length;++i) {
	var c = _displayTime.charAt(i)
	if(c!=":") temp += c
  }
  return temp
}



function convertToDisp(_date, _time, _ampm, _compFormat)
{
  var _displayDate, _displayTime, _displayAmPm, _displayFormat;

  var gubun = compFormatCheck( _compFormat );

  if(typeof(_date) == 'object'){
	  _date = _date.value;
  }
  
  if( _compFormat.toUpperCase().substring(0,4) == "YYYY" ){
	_displayFormat = "0000".concat(gubun).concat("00").concat(gubun).concat("00");
  } else {
	_displayFormat = "00".concat(gubun).concat("00").concat(gubun).concat("0000");
  }
  if( !isEmptyString(_date) && trim(_date) != _displayFormat ){
    _displayDate = _date;
  } else {
	_displayDate = _displayFormat;
  }
  if( !isEmptyString(_time) && trim(_time) != "00:00" ){
	_displayTime = _time;
  } else {
	_displayTime = "";
  }
  if( (trim(_ampm).toUpperCase() == "AM") || (trim(_ampm).toUpperCase() == "PM") ){
    _displayAmPm = _ampm;
  } else {
	_displayAmPm = "";
  }
  return _displayDate.concat(" ").concat(_displayTime).concat(" ").concat(_displayAmPm);  
}


// Date Type
function LastDate(oDate)
{
    var yyyy = oDate.getYear();
    var mm = oDate.getMonth();
    var strLastDay = null ;
    var monthDD = new MonthArr(31,28,31,30,31,30,31,31,30,31,30,31);
    if ( ( (yyyy%4 == 0) && (yyyy%100 != 0) ) || (yyyy%400 == 0) )
    {
        monthDD[1] = 29;
    }
    strLastDay = monthDD[mm] ;
    return strLastDay ;
}


// Calendar Array
function MonthArr(m0,m1,m2,m3,m4,m5,m6,m7,m8,m9,m10,m11)
{
      this[0]   = m0;
      this[1]   = m1;
      this[2]   = m2;
      this[3]   = m3;
      this[4]   = m4;
      this[5]   = m5;
      this[6]   = m6;
      this[7]   = m7;
      this[8]   = m8;
      this[9]   = m9;
      this[10]  = m10;
      this[11]  = m11;
}

function nvl(str1, str2)
{
  if ( str1 == null || str1 == "" ) return str2;
	return str1;
}


function stringTrim(str)
{
  return stringRTrim(stringLTrim(str));
}

function stringLTrim(str)
{
  return (typeof(str) != "string") ? null : str.replace(/^ +/, "");
}

function stringRTrim(str)
{
  return (typeof(str) != "string") ? null : str.replace(/ +$/, "");
}


// String Type (YYYYMM)
function strLastDate(yyyymm)
{
    var yyyy = yyyymm.substring(0,4) +"" ;
    var mm   = yyyymm.substring(4,6) +"" ;
    var strLastDay = null ;

    var monthDD = new MonthArr(31,28,31,30,31,30,31,31,30,31,30,31);
    var im = eval(mm) - 1;

    if ( ( (yyyy%4 == 0) && (yyyy%100 != 0) ) || (yyyy%400 == 0) )
    {
        monthDD[1] = 29;
    }
    strLastDay = monthDD[im] ;
    return strLastDay ;
}


function submitEventHandler( _frm ){
	var pattern = /<script|<\/script/;
	//var pattern = /<script|<\\script/;    
	var _obj = _frm.getElementsByTagName("INPUT");
	var size = _obj.length;
	
	for(var i=0; i<size; i++){
		var _input = _obj[i];
		if( _input.type=="text" ){
			if( pattern.test( _input.value.toLowerCase() ) ){
				alert("You can't input this value.[" + _input.value + "]" );
				_input.select();
				return false;
			}
		}           
	}
	return true;
} 


function toTimeObject(time) {
	var year  = time.substr(0,4);
	var month = time.substr(4,6) - 1;
	return new Date(year,month);
}

function toTimeString(date) {
	var year  = date.getFullYear();
	var month = date.getMonth() + 1;
	if (("" + month).length == 1) month = "0" + month;
	return ("" + year + month)
}



function enCheck(target){
    var eng="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-_/0123456789~!@#$%&*()+=`[{}]'^\|:,.?";
    var i;
    var tempStr;

    for(i=0;i<target.length;i++){
      tempStr = target.substring(i,i+1);
      if(eng.indexOf(tempStr) < 0 ) return false;
    }
    return true;
}


function trim(_str)
{
	return _str == null ? "" : _str.replace(/(^\s*)|(\s*$)/gi, "");
}



function setFormatDate(obj, compFormat){				
	
	var strResult = "";			
	var strDate = "";				
	
	var yyyy="";				
	var mm="";				
	var dd="";				
	
	strDate = obj.value;				
	if(strDate != ""){				
		strDate = removeDot(strDate);		
		if(strDate.length != 8 || !numCheck(strDate)){		
			alert("Invalid date!");	
			obj.focus();	
			return;	
		}else{		
			if (compFormat == "yyyy.MM.dd"){	
				strResult = strDate.substring(0,4)+"."+strDate.substring(4,6)+"."+strDate.substring(6,8);		
				yyyy = strDate.substring(0,4);
				mm = strDate.substring(4,6);
				dd = strDate.substring(6,8);
			}else{		
				strResult = strDate.substring(0,2)+"."+strDate.substring(2,4)+"."+strDate.substring(4,8);
				yyyy = strDate.substring(4,8);
				mm = strDate.substring(2,4);
				dd = strDate.substring(0,2);
			}	
			if(!chkDate(yyyy,mm,dd)){	
				alert("not exsist date!!");
				obj.focus();
				return;
			}	
			obj.value = strResult;			
		}			
	}				

	if(!chkDate(yyyy,mm,dd)){			
		alert("not exsist date!!");		
		obj.focus();		
	}			


}				


function setFormatDate(obj){		

	var strResult = "";	
	var strDate = "";		
	
	strDate = obj.value;		
	strDate = removeDot(strDate);	
	if(strDate.length != 8 || !numCheck(strDate)){	
		alert("Invalid date!");
		obj.focus();
		return;
	}else{	
		strResult = strDate.substring(0,2)+"."+strDate.substring(2,4)+"."+strDate.substring(4,8);	
		obj.value = strResult;		
	}		
}		


function setFormatMonth(obj){											
									
	var strResult = "";										
	var strDate = "";											
										
	strDate = obj.value;											
	strDate = removeDot(strDate);										
	if(strDate.length != 6 || !numCheck(strDate)){										
		alert("Invalid date!");									
		obj.focus();									
		return;									
	}else{										
		strResult = strDate.substring(0,2)+"."+strDate.substring(2,6);										
		obj.value = strResult;											
	}											
}											


String.prototype.trim = function()
{
	return this.replace(/(^\s*)|(\s*$)/gi, "");
}

String.prototype.replaceAll = function(str1, str2)
{
	var temp_str = "";

	if (this.trim() != "" && str1 != str2)
	{
		temp_str = this.trim();

		while (temp_str.indexOf(str1) > -1)
		{
  			temp_str = temp_str.replace(str1, str2);
		}
	}

	return temp_str;

}  


function chkDate(y, m, d) {
	var er = 0; // ���� ����
	var daa = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
	if (y%1000 != 0 && y%4 == 0) daa[1] = 29; // 1��
	if (d > daa[m-1] || d < 1) er = 1; // ��¥ üũ
	if (m < 1 || m > 12) er = 1; // �� üũ
	if (m%1 != 0 || y%1 != 0 || d%1 != 0) er = 1; // d�� üũ
	if (er == 1) return true;
	else return false;
}	


/**
 *	Checks fields for number only
 */
function checkDigit( msg )
{
	var eventKeyVal = event.keyCode;

	if( !event.ctrlKey ){
		
		if( 
			eventKeyVal==8 || 	// backspace
			eventKeyVal==9 || 	// tab
			eventKeyVal==46 ||  // delete
			eventKeyVal==16 ||  // shift
			eventKeyVal==17 ||  // control
			eventKeyVal==18 ||  // alt
			eventKeyVal==33 ||	// PgUp
			eventKeyVal==34 ||  // PgDn
			eventKeyVal==35 || 	// end
			eventKeyVal==36 || // home
			eventKeyVal==37 || // left arrow
			eventKeyVal==38 || // up arrow
			eventKeyVal==39 || // right arrow
			eventKeyVal==40 ) // down arrow
		
			return;

		// Numeric pad
		if( eventKeyVal==144 || eventKeyVal==13) return; // Num Loc, Enter, dot(110)
		if( eventKeyVal>=96 && eventKeyVal<=105 ) return; // 0~9
		
		if( event.keyCode<48 || event.keyCode>57 ){
			alert( msg );
			if(event.preventDefault){
	            event.preventDefault();
	        } else {
	            event.returnValue = false;
	        }
		}
	}
}


function checkDigitIncludeDot( msg ){
	
	var eventKeyVal = event.keyCode;

	if( !event.ctrlKey ){
		
		if( 
		eventKeyVal==8 || // backspace
		eventKeyVal==9 || // tab
		eventKeyVal==46 ||  // delete
		eventKeyVal==16 ||  // shift
		eventKeyVal==17 ||  // control
		eventKeyVal==18 ||  // alt
		eventKeyVal==33 ||   // PgUp
		eventKeyVal==34 ||  // PgDn
		eventKeyVal==35 || // end
		eventKeyVal==36 || // home
		eventKeyVal==37 || // left arrow
		eventKeyVal==38 || // up arrow
		eventKeyVal==39 || // right arrow
		eventKeyVal==40 ) // down arrow
		
		return;
		
		// Numeric pad
		if( eventKeyVal==144 || eventKeyVal==13 || eventKeyVal==110  || eventKeyVal==190) return; // Num Loc, Enter, dot(190)
		if( eventKeyVal>=96 && eventKeyVal<=105 ) return; // 0~9

		// can input minus sign (2007-12-11) 
		if ( event.keyCode == 45 || event.keyCode == 189  ) {
			return;
		}
		
		if( event.keyCode<48 || event.keyCode>57 ){
			alert( msg );
			if(event.preventDefault){
	            event.preventDefault();
	        } else {
	            event.returnValue = false;
	        }
		}
		
	}
	
}


function checkDigitExceptDot( msg ){
	var eventKeyVal = event.keyCode;

	if( !event.ctrlKey ){
			if( eventKeyVal==190 || // dot
				eventKeyVal==110 ) // dot(numeric pad)
					return;

			
			checkDigit( msg );
	}
}

function checkDigitOnly( msg ){	
	var eventKeyVal = event.keyCode;

	if( !event.ctrlKey ){
		
		if( 
			eventKeyVal==8 || 	// backspace
			eventKeyVal==9 || 	// tab
			eventKeyVal==46 ||  // delete
			
			eventKeyVal==17 ||  // control
			eventKeyVal==18 ||  // alt
			eventKeyVal==33 ||	// PgUp
			eventKeyVal==34 ||  // PgDn
			eventKeyVal==35 || 	// end
			eventKeyVal==36 || // home
			eventKeyVal==37 || // left arrow
			eventKeyVal==38 || // up arrow
			eventKeyVal==39 || // right arrow
			eventKeyVal==40 ) // down arrow
		
			return;

		// Numeric pad
		if( eventKeyVal==144 || eventKeyVal==13) return; // Num Loc, Enter, dot(110)
		if( eventKeyVal>=96 && eventKeyVal<=105 ) return; // 0~9
		
		if( event.keyCode<48 || event.keyCode>57 ){
			alert( msg );
			if(event.preventDefault){
	            event.preventDefault();
	        } else {
	            event.returnValue = false;
	        }
		}
	}
}
