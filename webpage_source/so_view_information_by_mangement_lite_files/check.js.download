//리스트에서 삭제 체크박스 반전(ALL or Nothing)(Hidden으로 되어있는것은 제외)
function checkAllNothingView(formName, checkElemName, rowId, maxRow){
	_idx = 0;
	var fCh = null;
	_maxRow = 0;
	var _form = document[formName];

	if(checkElemName == null || checkElemName == ""){
		checkElemName = 'selectKey';
	}

	if(rowId == null || rowId == ""){
		rowId = 'row_no';
	}

	if(maxRow == null || maxRow  == ''){
		_maxRow = 0;
	}else{
		_maxRow = maxRow;
	}

	var rowObj = eval('document.all.' + rowId);

	if( _form[checkElemName] == null ){
		return;
	}else if(_form[checkElemName].type == 'checkbox'){
		ele = _form[checkElemName];

		if(rowObj[0].style.display=="none") {
				return;
		}

		if(fCh == null) {
			if(ele.checked==false){
				fCh = true;
			}else if(ele.checked==true){
				fCh = false;
			}
		}
		if(fCh){
			ele.checked = true;
		}else {
			ele.checked=false;
		}
	}else{
		for( i=0; i< _form[checkElemName].length; i++) {
			ele = _form[checkElemName][i];

			if(rowObj[i].style.display=="none") {
				if ( _maxRow > i )
				{
					continue;
				}else{
					return;
				}
			}

			if(fCh == null) {
				if(ele.checked==false){
					fCh = true;
				}else if(ele.checked==true){
					fCh = false;
				}
			}
			if(fCh){
				ele.checked = true;
			}else {
				ele.checked=false;
			}
		}
	}
	return;
}

//리스트에서 삭제 체크박스 반전(토글기능)
function checkAll(formName){

	for( var i=0; i<document[formName].length; i++) {
		var ele = document[formName][i];

		if (ele.type=='checkbox') {
			if(ele.name == 'selectKey'){
				if(ele.checked==false){
					ele.checked = true;
				}else{
					ele.checked=false;
				}
			}
		}
	}
	return;
}

//리스트에서 삭제 체크박스 반전(토글기능)(Hidden으로 되어있는것은 제외)
function checkAllView(formName){
	var _idx = 0;
	for( var i=0; i<document[formName].length; i++) {
		var ele = document[formName][i];

		if (ele.type=='checkbox') {
			if(ele.name == 'selectKey'){
				if(document.all.row_no[_idx++].style.display=="none") return;

				if(ele.checked==false){
					ele.checked = true;
				}else{
					ele.checked=false;
				}
			}
		}
	}
	return;
}

//리스트에서 삭제하기 전 삭제항목 체크 확인
function delCheck(formName, checkElemName ){

	if(checkElemName == null || checkElemName == "")
	{
		checkElemName = 'selectKey';
	}

	for( var i=0; i<document[formName].length; i++) {
		var ele = document[formName][i];

		if (ele.type=='checkbox') {
			if(ele.name == checkElemName){
				if(ele.checked==true){
					return true;
				}
			}
		}
	}
	return false;
}


/*
* 리스트에서 삭제하기
* _form : 삭제 대상 ListForm 이름
* _action : 삭제 대상 ListAction mapping 이름
*/
function delList(_form, _action){
		if(!delCheck(_form)) {
			alert("선택한 항목이 없습니다.");
		} else {
			if(confirm("선택한 항목을 삭제하시겠습니까?")){
				document.forms[_form].action=_action+"?method=delete";
				document.forms[_form].submit();
				return true;
			}
		}
		return false;
}

// onblur 시 콤마를 넣자
// 금액 필드에 컴마를 찍어 표시한다.
// _target: 해당 필드의 객체
function displayComma(_target){
	var str = _target.value;

	str = trimComma(str);

	if (str.length > 3) {
		var mod = str.length % 3;
		var output = (mod > 0 ? (str.substring(0,mod)) : '');

		for (i=0 ; i < Math.floor(str.length / 3); i++) {
			if ((mod == 0) && (i == 0))
			output += str.substring(mod+ 3 * i, mod + 3 * i + 3);
			else
			output+= ',' + str.substring(mod + 3 * i, mod + 3 * i + 3);
		}
		_target.value = output;

	}
}

//숫자에 3 자리마다 콤마찍어 준다. -(음수) 금액처리
function commaSplit(_target) {
	srcNumber = _target.value;

	//콤마를 제거 한다.
	srcNumber = trimComma(srcNumber);

	// - 만 입력했을 때는 강제로 0을 셋팅한다.
	if(srcNumber == "-") {
		srcNumber = "0";
	}

	// 0000 식의 입력값을 0으로 처리한다.
	if(parseInt(srcNumber) == 0) {
		srcNumber = "0";
	}

	// 세자리마다 콤마를 넣어준다.
    var txtNumber = '' + srcNumber;

	var rxSplit = new RegExp('([0-9])([0-9][0-9][0-9][,.])');
	var arrNumber = txtNumber.split('.');
	arrNumber[0] += '.';

	do {
		arrNumber[0] = arrNumber[0].replace(rxSplit, '$1,$2');
	} while (rxSplit.test(arrNumber[0]));

	if (arrNumber.length > 1) {
		_target.value = arrNumber.join('');
	}
	else {
		_target.value = arrNumber[0].split('.')[0];
	}

}

// onfocus 시 콤마를 없애자
// _target: 해당 필드의 객체
function deleteComma(_target)
{

	_target.value = trimComma(_target.value);
	_target.select();
}


// 스트링값에서 Comma( ,)를 제외
function trimComma(_str)
{
	var un_str = "";
	str = String(_str);

	for(j=0; j<str.length; j++) {
		if(str.charAt(j) != "," ){
			un_str = un_str + str.charAt(j);
		}
	}

	return un_str;
}

// 스트링값에서 "/"를 제외
function trimSlash(str)
{
	var un_str = "";

	for(j=0; j<str.length; j++) {
		if(str.charAt(j) != "/" ){
			un_str = un_str + str.charAt(j);
		}
	}

	return un_str;
}

// 스트링값에 다시 컴마 넣기
function inComma(str)
{
//	str = trimComma(String(str));
//    uncomm_str = String(str);
//    comm_str = "";
//    loop_j = uncomm_str.length - 3;
//        for(j=loop_j; j>=1 ; j=j-3)
//        {
//                comm_str=","+uncomm_str.substring(j,j+3)+comm_str;
//        }
//        comm_str = uncomm_str.substring(0,j+3)+comm_str;
//        return comm_str;

	return inCommaMinus(str);
}

function inCommaMinus(str)
{
	str = trimComma(String(str));
    uncomm_str = String(str);
    comm_str = "";
    loop_j = uncomm_str.length - 3;
        for(j=loop_j; j>=1 ; j=j-3){
			if(str.charAt(j-1) == "-" ){
				comm_str = uncomm_str.substring(j,j+3)+comm_str;
			}else{
				comm_str=","+uncomm_str.substring(j,j+3)+comm_str;
			}
		}
		comm_str = uncomm_str.substring(0,j+3)+comm_str;
        return comm_str;
}


// onkeyup 이벤트가 있는 폼의 모든 text field에서 Comma 제거
function trimAllComma(_form) {
		if(_form == null) _form = document.forms[0];
		_cnt = _form.elements.length;	//폼 객체의 갯수
		for(i=0; i<_cnt; i++) {
			_ele = _form.elements[i];
			if( (_ele.type=="text" && _ele.onkeyup != null) || _ele.id=='Int' || _ele.id=='NeedInt') {
				str = trimComma(_ele.value);
				_ele.value = str;
			}
		}
}

// onkeyup 이벤트가 있는 폼의 모든 text field에 Comma 넣음
function displayAllComma(_form) {
		if(_form == null) _form = document.forms[0];
		_cnt = _form.elements.length;	//폼 객체의 갯수
		for(i=0; i<_cnt; i++) {
			_ele = _form.elements[i];
			if(_ele.type=="text" && _ele.onkeyup != null) {
				str = inComma(_ele.value);
				_ele.value = str;
			}
		}
}

function checkYYYYMM(_str, _name) {
	if(_name == null || _name =="")
		_name = "해당 년월";
	//alert(_str);

	if (_str.length>=7) {
		if (_str.charAt(4) == "/") {
			temp = _str.split("/");
			year = temp[0];
			month = temp[1];
			if ( year >="1000" && year <= "9999") {
				if(month > "0" && month <= "12"){
					if(year <"1900" || year > "2100") {
						if(confirm("입력하신 연도는 "+year+"년으로, 1900~2100년 사이가 아닙니다.\n\n              그래도 입력하시겠습니까?"))
							return true;
						else return false;
					}
					return true;
				}
			}
		}
	}
	if(_str.length==0) return true;
	alert(_name + " - 날짜가 유효하지 않거나 입력형식(예, 2003/06 )과 다릅니다.\n\n          날짜 찾기를 이용하여 입력하기를 권장합니다.");
	return false;
}



// trim : input field의 값에서 공백을 제거한다
function Jtrim(str) {
	var temp=""
	for(var i=0;i<str.length;++i) {
      		var c=str.charAt(i)
      		if(c!=" ") temp += c
   	}
   	return temp
}

function removeChar(str, _del) {
	var temp=""
	for(var i=0;i<str.length;++i) {
      		var c=str.charAt(i)
      		if(c!=_del) temp += c
   	}
   	return temp
}

function removeComma(str) {
	var temp=""
	for(var i=0;i<str.length;++i) {
      		var c=str.charAt(i)
      		if(c!=",") temp += c
   	}
   	return temp
}

function removeDot(str) {
	var temp=""
	for(var i=0;i<str.length;++i) {
      		var c=str.charAt(i)
      		if(c!=".") temp += c
   	}
   	return temp
}
function removeDash(str) {
	var temp=""
	for(var i=0;i<str.length;++i) {
      		var c=str.charAt(i)
      		if(c!="-") temp += c
   	}
   	return temp
}


// 필드의 내용이 있는가를 체크한다.
function JfieldIsEmpty(_target, _content) {
	var str = Jtrim(_target.value);
		if ( str == null || str == "" ) {
			/***********************************************
			* 다국어 처리를 위해 한글은 우선 영문으로 대체한다
			************************************************/
			// Case : Korean
			alert("["+_content + "] 은(는) 필수 입력항목 입니다.");
			// Case : English
			//alert(_content + " item should be filled up");
			return false;
		}
	return true;
}

// 반드시 숫자가 들어와야 하는 field를 메세지 박스로 알린다
function Jcheck_number(_target, _content, _isReplace){
	var str = _target.value;
	    str = removeComma(str);
		str = removeDot(str);
		str = Jtrim(str);
	if(_isReplace == "1" && (str == null || str == '')){
		str = '0';
	}
	   _target.value = str;

	for (var i=0 ; i<str.length;i++) {
		if (str.charAt(i) < "0" || str.charAt(i) > "9"){
			/***********************************************
			* 다국어 처리를 위해 한글은 우선 영문으로 대체한다
			************************************************/
			// Case : Korean
			alert("["+_content + "] 항목에 숫자가 아닌 값이 들어왔습니다");
			// Case : English
			//alert(_content + " item has non-numeric value");
			return false;
		}
	}

	return true;
}

// 반드시 숫자(소숫점포함)가 들어와야 하는 field를 메세지 박스로 알린다
function Jcheck_number_dot(_target, _content, _isReplace){
	var str = _target.value;
	    str = removeComma(str);
		str = removeDot(str);
		str = Jtrim(str);
	if(str.substring(0,1) == "-"){
		str = str.substring(1,str.length);
	}
	if(_isReplace == "1" && (str == null || str == '')){
		str = '0';
	}
	for (var i=0 ; i<str.length;i++) {
		if (str.charAt(i) < "0" || str.charAt(i) > "9"){
			/***********************************************
			* 다국어 처리를 위해 한글은 우선 영문으로 대체한다
			************************************************/
			// Case : Korean
			alert("["+_content + "] 항목에 숫자가 아닌 값이 들어왔습니다");
			// Case : English
			//alert(_content + " item has non-numeric value");
			return false;
		}
	}

	return true;
}
// 반드시 숫자(-값 포함)가 들어와야 하는 field를 메세지 박스로 알린다
function Jcheck_num_dash(_target, _content){

	var str = _target.value;
	    str = removeComma(str);
		str = removeDot(str);
		str = Jtrim(str);
	if(str == null || str == ''){
		str = '0';
	}
	   _target.value = str;

	if(str.charAt(0) < "0" || str.charAt(0) > "9"){
		if(str.charAt(0) != "-"){
			alert("["+_content + "] 항목에 숫자가 아닌 값이 들어왔습니다");

			return false;
		}
	}
	for (var i=1 ; i<str.length;i++) {
		if (str.charAt(i) < "0" || str.charAt(i) > "9"){

			alert("["+_content + "] 항목에 숫자가 아닌 값이 들어왔습니다");

			return false;
		}
	}

	return true;
}

// 반드시 숫자가 들어와야 하는 값을 메세지 박스로 알린다(값 비교)
function Jcheck_number_val(_target, _content){
	var str = _target;
	    str = removeComma(str);
		str = removeDot(str);
		str = Jtrim(str);
	    _target.value = str;

	for (var i=0 ; i<str.length;i++) {
		if (str.charAt(i) < "0" || str.charAt(i) > "9"){
			/***********************************************
			* 다국어 처리를 위해 한글은 우선 영문으로 대체한다
			************************************************/
			// Case : Korean
	    	//alert("["+_content + "] 항목에 숫자가 아닌 값이 들어왔습니다");
			// Case : English
