function gfn_CheckDate(yyyy, mm, dd)
{
  var Year = yyyy;
  var Mon  = mm;
  var Day  = dd;

  if(Year < "1971")                 return false;
  else if(Mon < "01" || Mon > "12") return false;
  else if(Day == ""  || Day == null ) return true;
  else if(Day < "01" || Day > "31") return false;

  switch (Mon) {
    case "01" :
    case "03" :
    case "05" :
    case "07" :
    case "08" :
    case "10" :
    case "12" :
      return true;
      break;
    case "04" :
    case "06" :
    case "09" :
    case "11" :
      if(Day > "30")  return false;
      else            return true;
      break;
    case "02" :
      if(Day > "29") 	return false;
      else if(Day == "29") {
        if(! gfn_Mod(Year,"4"))       return false;
        else {
          if(! gfn_Mod(Year,"100"))   return true;
          else {
            if(! gfn_Mod(Year,"400")) return false;
            else                      return true;
          }
        }
      } else                          return true;
  }
}

function gfn_Mod(a, b)
{
	var compSt = "";

	compSt = String(a / b);
	index = compSt.indexOf(".");

	if(index < 0) return true;

	return false;
}


function checkDate(_date, compFormat)
{
  var Year, Mon, Day, Date;
  var _displayDate = "";
  var gubun = compFormatCheck( compFormat );
  
  if( typeof _date === "object" ){
	_displayDate = _date.value;
  } else { 
	_displayDate = _date;
  }
  
  //from china : 사용자 날짜 형식과 입력한 날짜 형식이 틀려도 정상적인 날짜로  인식되는 경우를 방지하기 위해 해당 로직 추가
  if(_displayDate.indexOf(".") != compFormat.indexOf(".")){
	  return false;
  }

  Year = toDisplayYear(_displayDate, gubun, compFormat);
  Mon = toDisplayMonth(_displayDate, gubun, compFormat);
  Day = toDisplayDay(_displayDate, gubun, compFormat);

  if(Year < "1971")                 return false;
  else if(Mon < "01" || Mon > "12") return false;
  else if(Day == ""  || Day == null ) return true;
  else if(Day < "01" || Day > "31") return false;

  switch (Mon) {
    case "01" :
    case "03" :
    case "05" :
    case "07" :
    case "08" :
    case "10" :
    case "12" :
      return true;
      break;
    case "04" :
    case "06" :
    case "09" :
    case "11" :
      if(Day > "30")  return false;
      else            return true;
      break;
    case "02" :
      if(Day > "29") 	return false;
      else if(Day == "29") {
        if(! checkMod(Year,"4",gubun))       return false;
        else {
          if(! checkMod(Year,"100",gubun))   return true;
          else {
            if(! checkMod(Year,"400",gubun)) return false;
            else                      return true;
          }
        }
      } else                          return true;
  }
}



