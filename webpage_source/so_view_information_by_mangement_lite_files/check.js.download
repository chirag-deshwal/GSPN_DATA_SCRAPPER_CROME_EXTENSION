/*
* 중국 수량과 IMEI 갯수 비교 체크
* 
* @param qty : 입력한 자재수량
* @param imeis : 입력한 IMEI 값(,로 구분, 예:1234,2345)
* @return : true/false
*/
function checkPBACount(qty, imeis) {
	var sImeis = stringTrim(imeis)
	if ( sImeis == '' ) {
		return false;
	} else {
		var aryImei = sImeis.split(",");

		if ( eval(qty) != aryImei.length ) {
			return false;
		}
	}
	return true;
}


/********************************************************************
*  Function Name : isValidLatitudeLongitude()                       *
*  Description   : 경위도의 유효성을 체크한다.                         *
*  Input Data    : str, intNum, ptNum                               *
*                  예) "111.22" -> intNum:3, ptNum=2                *
*  Output Data   : return (true/false)                              *
*  사용 Function :                                                  *
********************************************************************/
function isValidLatitudeLongitude(str, intNum, ptNum) {
	var chars = '0123456789.';
	
	//1. 숫자, Dot(.)로 되어있는지 체크
	for (var inx = 0; inx < str.length; inx++) {
		if (chars.indexOf(str.charAt(inx)) == -1) {
           return false; 
	    }
	}

	//2. 자릿수 체크
    var ptindex = str.indexOf('.');
    if (ptindex != -1) {
        intstr = str.substring(0, ptindex);
        ptstr  = str.substring(ptindex+1, str.length);

        if (intstr.length > intNum) {
            return false;
        }
        if (ptstr.length > ptNum) {
            return false;
        }
        if (ptstr.indexOf('.') != -1) {
            return false;
        }
    } else {
        if (str.length > intNum) {
            return false;
        }
    }
    return true;
}