		}
	}
	return true;
}

//시간을 표현하는 형태인지 메세지 박스로 알린다.
function Jcheck_time(_target, _content){
	var str = _target.value;
	    str = removeChar(str, ":");
		str = Jtrim(str);
		if(str.length>0 && str.length<4){
			alert("["+_content+"] 항목은 시간형태(12:00)가 아닙니다.");
			return false;
		}
		for(var i=0 ; i<str.length; i++){
			if(str.charAt(i)<"0" || str.charAt(i)>"9"){
				alert("["+_content+"] 항목은 시간형태(12:00)가 아닙니다.");
				return false;
			}
		}
		return true;
}

// 길이를 체크하기 위한 함수
function Jcheck_length(_target, _maxlen, _content){
	var str = _target.value;
	var len = 0;

	for(i=0; i<str.length; i++) {
	//alert(escape(str.charAt(i)));
		if(escape(str.charAt(i)).length>4) len+=2; else len++;
	}

	if( len > _maxlen){
		/***********************************************
		* 다국어 처리를 위해 한글은 우선 영문으로 대체한다
		************************************************/
		// Case : Korean
		alert("["+_content + "] 항목이 길이 " + _maxlen + "를(을) 넘었습니다");
		// Case : English
		//alert(_content + "'s length exceeds " + _maxlen + " charactres");
		return false;
	}
	return true;
}

// 폼의 text field에서 특수문자( &, ", <, >)를 제외하고 메세지 박스로 알린다
function Jtrim_char(formName, _content)
{
	var str = "";
	var istrim = false;

	// form field 갯수 만큼 loop를 수행
	for ( var i = 0 ; i < window.document[formName].length ; i++ )
	{
		str = "";
		if ( (window.document[formName][i].type == "text")
				&& (Jtrim(window.document[formName][i].value) != "") ) {
					for(j=0; j<window.document[formName][i].value.length; j++) {

						if( ( window.document[formName][i].value.charAt(j) != "\"" )
							&& ( window.document[formName][i].value.charAt(j) != "\'" )
							&& (window.document[formName][i].value.charAt(j) != "&")
							&& (window.document[formName][i].value.charAt(j) != ">")
							&& (window.document[formName][i].value.charAt(j) != "<") ) {
								str = str + window.document[formName][i].value.charAt(j);
							}else istrim = true;

					}
					window.document[formName][i].value = str;
		}
	}

	if(istrim){
//		alert(_content);
	}

}

function actConfirm(_method) {
		if (_method == 'delete'){
			if (!confirm('삭제 하시겠습니까 ?'))
				return false;
		} else if (_method == 'update'){
			if (!confirm('수정 하시겠습니까 ?'))
				return false;
		} else {
			if (!confirm('저장 하시겠습니까 ?'))
				return false;
		}
	return true;
}


function numCheck(_str){
	for (var i=0 ; i<_str.length;i++) {
		if (_str.charAt(i) < "0" || _str.charAt(i) > "9"){
			return false;
		}
	}
	return true;
}


//숫자에 콜론(:)빼고 다시 넣어주기
function CheckTime(obj){
	var str = obj.value;

	if(Jcheck_time(obj, obj.title)){
		a = removeChar(str, ":");
		b = a.substring(0,2);
		c = a.substring(2,4);

		obj.value = b+":"+c;
	}else{
		obj.value="";
		obj.focus();
	}
}


// 숫자에 컴마빼고 다시 계산후 컴마찍기.
function CheckMoney(obj){
        a=out_comma(obj.value);
        obj.value=in_comma(a);
}


//컴마 빼기
function out_comma(str)	{
	comm_str = String(str);

	var index = comm_str.indexOf('.',0);
	var num1,num2;

	uncomm_str="";

	if(index != -1)	{
		num1 = comm_str.substring(0,index);
		num2 = comm_str.substring(index+1);
	}else{
		num1 = comm_str;
		num2 = '';
	}


	for(i=0; i<num1.length; i++)	{
		substr = num1.substring(i,i+1);
		if(substr!=",")
			uncomm_str += substr;
	}

	if(num2 == '')
		return uncomm_str;
	else
		return uncomm_str + '.' + num2;
}

	//컴마 넣기
function in_comma(str){
		uncomm_str = String(str);

		var index = uncomm_str.indexOf('.',0);
		var num1, num2;

		if(index != -1)	{

			num1 = uncomm_str.substring(0,index);
			num2 = uncomm_str.substring(index+1);
		}else{

			num1 = uncomm_str;
			num2 = '';
		}

		comm_str = "";
		loop_j = num1.length - 3;
		for(j=loop_j; j>=1 ; j=j-3)	{
			comm_str=","+num1.substring(j,j+3)+comm_str;
		}

		comm_str = num1.substring(0,j+3)+comm_str;
        var size = comm_str.length;
		if(num2 == ''){
			if(size>2 && comm_str.substring(0,1) == "-" && comm_str.substring(1,2) == ","){
				comm_str = comm_str.substring(0,1) + comm_str.substring(2,size);
			}
			return comm_str;
		}else{
			if(size>2 && comm_str.substring(0,1) == "-" && comm_str.substring(1,2) == ","){
				comm_str = comm_str.substring(0,1) + comm_str.substring(2,size);
			}
			return comm_str + '.' + num2;
		}
}

function resetForm(_formName){
	var _obj = document[_formName];
	_obj.reset();
}

//Radio Object의 선택된 값을 반환
function getCheckedValue( _obj ){
	for(i=0 ; i < _obj.length ; i++){
		if( _obj[i].checked ){
			return _obj[i].value;
		}
	}
	return '';
}

//Radio Object 에 값을 셋팅
function setRadioValue( _obj, _newValue ){
	for(i=0 ; i < _obj.length ; i++){
		if( _obj[i].value == _newValue ){
			_obj[i].checked = true;
			break;
		}
	}
}







/**
 * 입력값에 특정 문자(chars)가 있는지 체크
 * 특정 문자를 허용하지 않으려 할 때 사용
 * ex) if (containsChars(form.name,"!,*&^%$#@~;")) {
 *         alert("이름 필드에는 특수 문자를 사용할 수 없습니다.");
 *     }
 */
function containsChars(input,chars) {
    for (var inx = 0; inx < input.value.length; inx++) {
       if (chars.indexOf(input.value.charAt(inx)) != -1)
           return true;
    }
    return false;
}

/**
 * 입력값이 특정 문자(chars)만으로 되어있는지 체크
 * 특정 문자만 허용하려 할 때 사용
 * ex) if (!containsCharsOnly(form.blood,"ABO")) {
 *         alert("혈액형 필드에는 A,B,O 문자만 사용할 수 있습니다.");
 *     }
 */
function containsCharsOnly(input,chars) {
    for (var inx = 0; inx < input.value.length; inx++) {
       if (chars.indexOf(input.value.charAt(inx)) == -1)
           return true;
    }
    return false;
}

function containsCharsOnlyByValue(value,chars) {
	if (chars.indexOf(value) == -1){
    	return true;
    }else{
    	return false;
    }
}

/**
 * 입력값이 알파벳인지 체크
 * 아래 isAlphabet() 부터 isNumComma()까지의 메소드가
 * 자주 쓰이는 경우에는 var chars 변수를
 * global 변수로 선언하고 사용하도록 한다.
 * ex) var uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
 *     var lowercase = "abcdefghijklmnopqrstuvwxyz";
 *     var number    = "0123456789";
 *     function isAlphaNum(input) {
 *         var chars = uppercase + lowercase + number;
 *         return containsCharsOnly(input,chars);
 *     }
 */
function isAlphabet(input, msg) {
    var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";

    if(containsCharsOnly(input,chars))
    {
    	alert("[" + msg + "] 은(는) 영문만 가능합니다.");
    	return false;
    }
    else	return true;
}

/**
 * 입력값이 알파벳 대문자인지 체크
 */
function isUpperCase(input, msg) {
    var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

    if(containsCharsOnly(input,chars))
    {
    	alert("[" + msg + "] 은(는) 영문 대문자만 가능합니다.");
    	return false;
    }
    else	return true;
}

/**
 * 입력값이 알파벳 소문자인지 체크
 */
function isLowerCase(input, msg) {
    var chars = "abcdefghijklmnopqrstuvwxyz";

    if(containsCharsOnly(input,chars))
    {
    	alert("[" + msg + "] 은(는) 영문 소문자만 가능합니다.");
    	return false;
    }
    else	return true;
}

/**
 * 입력값이 알파벳,숫자로 되어있는지 체크
 */
function isAlphaNum(input, msg) {
    var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";

    if(containsCharsOnly(input,chars))
    {
    	alert("[" + msg + "] 은(는) 영문, 숫자만 가능합니다.");
    	return false;
    }
    else	return true;
}

/**
 * 입력값이 숫자로만 되어있는지 체크
 */
function isNum(input, msg) {
    var chars = "0123456789";

    if(containsCharsOnly(input,chars))
    {
    	alert("[" + msg + "] item has non-numeric value");
    	input.value = "";
    	return false;
    }
    else	return true;
}

/**
 * 입력값이 숫자,대시(-)로 되어있는지 체크
 */
function isNumDash(input, _content) {
    var chars = "-0123456789";

    if(input.value == "-0" || input.value == "-") {
    	alert("[" + _content + "] 은(는) 정상적인 숫자가 아닙니다.");
    	input.value = "0";
    	return false;
    }

    if(containsCharsOnly(input,chars))
    {
    	alert("[" + _content + "] 은(는) 숫자,대시(-)만 가능합니다.");
    	return false;
    }
    else	return true;

}

/**
 * 입력값이 숫자,콤마(,)로 되어있는지 체크
 */
function isNumComma(input, msg) {
    var chars = ",0123456789";
    if(containsCharsOnly(input,chars))
    {
    	alert("[" + msg + "] 은(는) 숫자,콤마(,)만 가능합니다.");
    	return false;
    }
    else	return true;
}

/**
 * 입력값이 숫자,콤마(,)로 되어있는지 체크 한 후 첫자리가 0이 아닌 것
 * 통화 체크
 */
function isCurrency(input, msg) {
	if(!isNumComma(input, msg))	{input.focus(); return false;}			//숫자, 콤마만 체크

	//한자리면 숫자여야 한다.
	if(input.value.length == 1)
	{
		if(input.value == ",")
		{
			alert(msg+"는(은) 한자리 금액이면 ','이 아닌 숫자여야 합니다.");
			input.focus();
			return false;
		}

	}
	//두자리이상
	else
	{
		if(input.value.substring(0, 1) == "0" || input.value.substring(0, 1) == ",")
		{
			alert(msg+"는(은) 첫자리가 ',' , '0'이 아닌 숫자여야 합니다.");
			input.focus();
			return false;
		}
	}

	return true;
}

/**
 * 입력값이 숫자,콤마(,)로 되어있는지 체크
 */
function isNumPeriod(input, msg) {
    var chars = ".0123456789";
    if(containsCharsOnly(input,chars))
    {
    	alert("[" + msg + "] item has non-numeric value.");
    	return false;
    }
    else	return true;
}

/**
 * 입력값이 사용자가 정의한 포맷 형식인지 체크
 * 자세한 format 형식은 자바스크립트의 'regular expression'을 참조
 */
function isValidFormat(input,format) {
    if (input.value.search(format) != -1) {
        return false; //올바른 포맷 형식
    }
    return true;
}

/**
 * 입력값이 이메일 형식인지 체크
 * ex) if (!isValidEmail(form.email)) {
 *         alert("올바른 이메일 주소가 아닙니다.");
 *     }
 */
function isValidEmail(input, msg) {
//    var format = /^(\S+)@(\S+)\.([A-Za-z]+)$/;
    var format = /^((\w|[\-\.])+)@((\w|[\-\.])+)\.([A-Za-z]+)$/;

    if(isValidFormat(input,format))
    {
    	alert(msg);
    	return false;
    }
    else	return true;
}

/**
 * 입력값이 전화번호 형식(숫자-숫자-숫자)인지 체크
 */
function isValidPhone(input, msg) {
    var format = /^(\d+)-(\d+)-(\d+)$/;

    if(isValidFormat(input,format))
    {
    	alert("[" + msg + "] 은(는) 올바른 전화번호가 아닙니다.");
    	return false;
    }
    else	return true;
}
function isValidPhoneAmerica(input, msg) {
    var format = /[2-9][0-9]{2}-[0-9]{3}-[0-9]{4}/;
  //  "[2-9][0-9]{2}-[0-9]{3}-[0-9]{4}";

    if(isValidFormat(input,format))
    {
    	alert("Wrong Number format.");
    	if(event.preventDefault){
            event.preventDefault();
        } else {
            event.returnValue = false;
        }
    	return false;
    }
    else	return true;
}


/**
 * 글자 수가 같은지 체크한다(한글처리 안되어 있음).
 */
function isLengthCheck(input, len, msg) {

	var val = input.value;

	if(val.length != len)
	{
    	alert("[" + msg + "] 은(는) "+len+"글자만 가능합니다.");
    	return false;
	}
	else	return true;
}

/**
 * firstDate : 시작일
 * secondDate : 종료일
 * 시작일 <= 종료일 일때 true를 반환
 */
function compare_date(strFirstDate, strSecondDate) {

	iFirstDate = eval(strFirstDate);
	iSecondDate = eval(strSecondDate);

	if(iFirstDate > iSecondDate) {
		return false;
	} else if(iFirstDate == iSecondDate) {
		return true;
	} else {
		return true;
	}
}

/**
* 검색기간 지정이 올바른지 체크
* @param _form : form 객체 명
* @param _sDate : 조회 시작일 element명
* @param _eDate : 조회 종료일 element명
*/
function checkSearchDate(_form, _sDate, _eDate) {
	var form = eval('document.'+ _form);
	var sDate = form[_sDate].value.replace(/\//g,"");
	var eDate = form[_eDate].value.replace(/\//g,"");
	//alert(sDate+":"+eDate);
	if(sDate=="" && eDate!=""){
		alert("조회 기간이 입력되지 않았습니다.");
		form[_sDate].focus();
		return false;
	}else if(sDate!="" && eDate==""){
		alert("조회 기간이 입력되지 않았습니다.");
		form[_eDate].focus();
		return false;
	}
	if (sDate > eDate) {
		alert("조회 시작일이 종료일보다 뒤입니다.\n\n조회기간을 다시선택해주십시오");
		form[_sDate].focus();
		return false;
	} else
		return true;
}

/**
* 올바른 날짜 표현식인지 체크
* @param _form : form 객체 명
* @param _date : 날짜 입력 element명
*/
function isValidDate(_form, _date) {
	var form = eval('document.'+ _form);
	var date = form[_date].value.replace(/\//g,"");
	var format = /\d{8}/;

	if (date.length==8 && date.search(format) != -1) {
		var yyyy = parseInt(date.substring(0,4),10);
		var mm = parseInt(date.substring(4,6),10);
		var dd = parseInt(date.substring(6,8),10);

    	var end = new Array(31,28,31,30,31,30,31,31,30,31,30,31);
    	if ((yyyy % 4 == 0 && yyyy % 100 != 0) || yyyy % 400 == 0) {
	        end[1] = 29;
    	}

		if ((mm >= 1 && mm <= 12) && (dd >= 1 && dd <= end[mm-1]))
			return true;
	}
	alert("유효한 날짜 또는 유형(YYYY/MM/DD)이 아닙니다. 날짜 찾기 버튼을 권장합니다.");
	form[_date].focus();
	form[_date].select();
	return false;
}

/**
* YYYY/MM/DD형식인지 체크
* @param _form : form 객체 명
* @param _date : 날짜 입력 element명
*/
function isValidSlashDate(_form, _date) {
	var form = eval('document.'+ _form);
	var format = /\d{4}\/\d{2}\/\d{2}/;

	if (form[_date].value.search(format) != -1) {
		return isValidDate(_form, _date);
	}
	alert("유효한 날짜 또는 유형(YYYY/MM/DD)이 아닙니다. 날짜 찾기 버튼을 권장합니다.");
	form[_date].focus();
	form[_date].select();
	return false;
}

// 날짜 형식을 YYYY/MM/DD 형으로 맞춰준다.
function inSlash(obj, delemiter) {
	date = removeChar(obj.value, delemiter);
	if(date == "" || date.length != 8)
		obj.value = date;

	if(date.length == 8) {
		obj.value = date.substring(0,4) + delemiter + date.substring(4,6) + delemiter + date.substring(6,8);
	}
}

// 날짜 형식을 YYYY/MM 형으로 맞춰준다.
function inSlashMnth(obj, delemiter) {
	date = removeChar(obj.value, delemiter);
	if(date == "" || date.length != 6)
		obj.value = date;

	if(date.length == 6) {
		obj.value = date.substring(0,4) + delemiter + date.substring(4,6);
	}
}

//년월일 체크
//format : 20030707
function chkYYYYMMDD(obj, msg)
{
	//1. null 체크
	if(!JfieldIsEmpty(obj, msg))	{return false;}				//null체크

	//2. 8자리 체크
	if(!isLengthCheck(obj, '8', msg)){return false;}		//최대길이만 가능

	//3. 숫자 체크
	if(!Jcheck_number(obj, msg))	{return false;}			//숫자만 체크

	//4. 날짜 유효성 체크
	if(!isDateValue(obj, msg)) {return false;}

	return true;
}

/********************************************************************
*  Function Name : isDateValue()                                        *
*  Description   : Input Data가 정확한 년월일로 구성되었는지 Check  *
*                  (윤년check포함)                                  *
*  Input Data    : obj -> (yyyymmdd)                            *
*  Output Data   : true/false                                       *
*  사용되는 Function : None                                         *
********************************************************************/
function isDateValue(obj, msg)
{
	var str = obj.value;

	yy = parseInt(str.substring(0,4),10);
	mm = parseInt(str.substring(4,6),10);
	dd = parseInt(str.substring(6,8),10);

	if (mm == 1)
	{
		max_days = 31
	}
	else if (mm == 2)
	{
		if ((( yy % 4 == 0) && (yy % 100 != 0)) || (yy % 400 == 0))
			max_days = 29;
		else
			max_days = 28;
	}
	else if (mm == 3)   max_days = 31;
	else if (mm == 4)   max_days = 30;
	else if (mm == 5)   max_days = 31;
	else if (mm == 6)   max_days = 30;
	else if (mm == 7)   max_days = 31;
	else if (mm == 8)   max_days = 31;
	else if (mm == 9)   max_days = 30;
	else if (mm == 10)  max_days = 31;
	else if (mm == 11)  max_days = 30;
	else if (mm == 12)  max_days = 31;
	else
	{
		alert(msg + "에 입력한 월이 틀립니다..");
		obj.select();
		return false;
	}
	if(dd < 1 || dd > max_days)
	{
		alert(msg + "에 입력한 일이 틀립니다..");
		obj.select();
		return false;
	}

	return true;
}




/*
 *	입력한 달의 지난달을 리턴
 */
function beforeMonth(obj){
	if(obj.value == '' || obj.value == ""){
		alert("YYYYMM 형식으로 년월을 입력하세요");
		return;
	}
	var msg = '년월';
	if(!Jcheck_number(obj, msg))	{obj.focus(); return;}				//숫자만 체크
	if(!isLengthCheck(obj, obj.maxLength, msg)){obj.focus(); return;}	//최대길이만 가능

	var beforeCheck;
	var beforeCheckTwo;
	var beforeYear;
	var beforeMonth;
	var returnYear;
	var returnMonth;

	beforeCheck = Number(obj.value.substring(4,6));
	if(beforeCheck > 12){
		alert("잘못된 날짜를 입력하셨습니다");
		return;
	}
	beforeCheck = Number(obj.value.substring(4,5));
	beforeCheckTwo = Number(obj.value.substring(5,6));
	if(beforeCheck == 0 && beforeCheckTwo == 0){
		alert("잘못된 날짜를 입력하셨습니다");
		return;
	}

	beforeCheck = Number(obj.value.substring(4,5));
	beforeYear = Number(obj.value.substring(0,4));
	if(beforeCheck > 0){
		beforeMonth = Number(obj.value.substring(4,6));
	}else{
		beforeMonth = Number(obj.value.substring(5,6));
	}
	if(beforeMonth == 1){
		beforeMonth = 12;
		beforeYear = beforeYear-1;
	}else{
		beforeMonth = beforeMonth-1;
	}
	if(beforeMonth < 10){
		returnMonth = '0' + beforeMonth.toString();
	}else{
		returnMonth = beforeMonth.toString();
	}
	returnYear = beforeYear.toString();
	obj.value = returnYear + returnMonth;
}
/*
 *	입력한 달의 앞달을 리턴
 */
function laterMonth(obj){
	if(obj.value == '' || obj.value == ""){
		alert("YYYYMM 형식으로 년월을 입력하세요");
		return;
	}

	var msg = '년월';
	if(!Jcheck_number(obj, msg))	{obj.focus(); return;}			//숫자만 체크
	if(!isLengthCheck(obj, obj.maxLength, msg)){obj.focus(); return;}	//최대길이만 가능

	var laterCheck;
	var laterCheckTwo;
	var laterYear;
	var laterMonth;
	var returnYear;
	var returnMonth;
	laterCheck = Number(obj.value.substring(4,6));
	if(laterCheck > 12){
		alert("잘못된 날짜를 입력하셨습니다");
		return;
	}
	laterCheck = Number(obj.value.substring(4,5));
	laterCheckTwo = Number(obj.value.substring(5,6));
	if(laterCheck == 0 && laterCheckTwo == 0){
		alert("잘못된 날짜를 입력하셨습니다");
		return;
	}

	laterCheck = Number(obj.value.substring(4,5));
	laterYear = Number(obj.value.substring(0,4));
	if(laterCheck > 0){
		laterMonth = Number(obj.value.substring(4,6));
	}else{
		laterMonth = Number(obj.value.substring(5,6));
	}
	if(laterMonth == 12){
		laterMonth = 1;
		laterYear = laterYear+1;
	}else{
		laterMonth = laterMonth+1;
	}
	if(laterMonth < 10){
		returnMonth = '0' + laterMonth.toString();
	}else{
		returnMonth = laterMonth.toString();
	}
	returnYear = laterYear.toString();
	obj.value = returnYear + returnMonth;
}

//콤보박스 텍스트 얻기(선택값 없을 때 "" 리턴)
function getComboText(obj)
{
	if(obj == null) return "";
	if(obj.options == null) return "";
	if(obj.options.length == null || obj.options.length == 0) return "";

	return obj.options(obj.selectedIndex).text;
}

//콤보박스 텍스트 얻기(선택값 없을 때 "" 리턴)
function getComboValue(obj)
{
	if(obj == null) return "";
	if(obj.options == null) return "";
	if(obj.options.length == null || obj.options.length == 0) return "";

	return obj.options(obj.selectedIndex).value;
}

function setCombo(_combo, _value){
	for(i = 0 ; i < _combo.options.length ; i++){
		if( _combo.options[i].value == _value){
			_combo.options[i].selected = true;
			var eventObj = document.createEventObject();
			_combo.fireEvent("onchange");
			break;
		}
	}
}

/********************************************************************
*  Function Name : isValidFloat()                                   *
*  Description   : 소수의 유효성을 체크한다.                         *
*  Input Data    : obj, intNum, ptNum                          *
*                  예) "111.22" -> intNum:3, ptNum=2                *
*  Output Data   : true/false                                       *
*  사용 Function :                                                  *
********************************************************************/
function isValidFloat(obj, intNum, ptNum, msg) {

	//1. null 체크
	if(!JfieldIsEmpty(obj, msg))	{obj.focus(); return false;}				//null체크

	//2. 숫자,콤마(,)로 되어있는지 체크
	if(!isNumPeriod(obj, msg))	{obj.select(); return false;}			//숫자만 체크

	//3. 자릿수 체크
    var val = trimComma(obj.value);
    var ptindex = val.indexOf('.');
    if (ptindex != -1) {
        intstr = val.substring(0, ptindex);
        ptstr  = val.substring(ptindex+1, val.length);

        if (intstr.length > intNum) {
            alert('자리수 초과입니다.');
	        obj.select();
            return false;
        }

        if (ptstr.length > ptNum) {
            alert('소수점이하 ' + ptNum + '까지 입력할 수 있습니다.');
	        obj.select();
            return false;
        }
        if (ptstr.indexOf('.') != -1) {
            alert('소수점위치가 잘못되었습니다.');
	        obj.select();
            return false;
        }
    } else {
        if (val.length > intNum) {
            alert('자리수 초과입니다.');
	        obj.select();
            return false;
        }
    }
    return true;
}

/**
* 올바른 월 표현식인지 체크
* @param _form : form 객체 명
* @param _date : 날짜 입력 element명
*/
function isValidMonth (_form, _date) {
	var form = eval('document.'+ _form);
	var date = form[_date].value.replace(/\//g,"");
	var format = /\d{6}/;

	if (date.length==6 && date.search(format) != -1) {
		var yyyy = parseInt(date.substring(0,4),10);
		var mm = parseInt(date.substring(4,6),10);
		if ((mm >= 1 && mm <= 12)) return true;
	}
	alert("유효한 년월 또는 유형(YYYY/MM)이 아닙니다.");
	form[_date].focus();
	form[_date].select();
	return false;
}

/**
* YYYY/MM형식인지 체크
* @param _form : form 객체 명
* @param _date : 날짜 입력 element명
*/
function isValidSlashMonth(_form, _date) {
	var form = eval('document.'+ _form);
	var format = /\d{4}\/\d{2}/;

	if (form[_date].value.search(format) != -1) {
		return isValidMonth(_form, _date);
	}
	alert("유효한 년월 또는 유형(YYYY/MM)이 아닙니다.");
	form[_date].focus();
	form[_date].select();
	return false;
}

function floatRound(_value, _index){
	return Math.round( _value * Math.pow(10,_index) )/ Math.pow(10,_index);
}

// disabled 되는 체크박스를 제외한 체크박스 전체선택(파라미터 :체크박스 객체)
function checkAnAbleView(objNm){
	if(objNm == null){
		return;
	}
	var obj = objNm.length;
	if(obj == null){
		if(objNm.disabled == true){
			return;
		}else{
			if(objNm.checked == true){
				objNm.checked = false;
			}else{
				objNm.checked = true;
			}
		}
	}else{
		var allCheck;
		var disAbledCheck = new Array;
		var idx = 0;
		for(var i=0; i<objNm.length; i++){
			if(objNm[i].disabled == true){
				disAbledCheck[idx] = i;
				idx += 1;
			}else{
				if(objNm[i].checked == true){
					allCheck = false;
				}else{
					allCheck = true;
				}
			}
		}
		idx = 0;
		for(var i=0; i<objNm.length; i++){
			if(disAbledCheck.length == null){
				objNm[i].checked = allCheck;
			}else{
				if(disAbledCheck[idx] == i){
					objNm[i].checked = false;
					idx += 1;
				}else{
					objNm[i].checked = allCheck;
				}
			}
		}
	}
	return;
}

function displayText(_text, _width, _length){
	if(_length == null || _length == '' || _length <= 0){
		_width = _width - 10 ;
		_length = _width/11;
	}

	if(_text == null){
		return '';
	}else if(_length != null && _length > 0 && _text.length > _length ){
		return _text.substring(0, _length-3) + '...';
	}else{
		return _text;
	}
}

//선택된 Check Box 갯수 구하기
function getSelectCount(checkOBJ){
	//변수선언
	var selectCount = 0;

	//한건도 없다면...
	if (!checkOBJ) {return selectCount;}

	//1건이라면 그건이 선택되었는지 체크
	if (!checkOBJ.length) {
		if (checkOBJ.checked) {selectCount=1;}
		else {selectCount=0;}
		return selectCount;
	}

	//선택건수 구하기
	for (i=0; i<checkOBJ.length; i++){if (checkOBJ[i].checked) {selectCount++;}}
	return selectCount;
}

function checkNum(_elem){
	if(event.keyCode == 13 || event.keyCode == 9){
		return true;
	}else if( event.keyCode == 45 ){
		//입력이 '-'이면
		event.keyCode = '';
		alert('음수를 입력할 수 없습니다.');
		return false;
	}else if( event.keyCode < 48 || 57 < event.keyCode ){
		//입력이 숫자가 아니면
		event.keyCode = '';
		alert('숫자만 입력가능합니다.');
		return false;
	}else{

	}

	return true;
}


//전체 선택 버튼 처리
//check box object(document.all.checkboxName)를 넣어준다.
function cbCheck(cks)
{
	//체크박스 존재 X
	if(cks == null){}
	//체크박스 존재 O
	else
	{
		var len = cks.length;
		//체크박스 1개 존재
		if(len == null)
		{
			if(cks.checked)	{cks.checked = false;}
			else	{cks.checked = true;}
		}
		//체크박스 2개 이상 존재
		else
		{
			var bool;
			for(ii=0; ii< len; ii++)
			{
				if(ii == 0)
				{
					if(cks[ii].checked)	bool = false;
					else	bool = true;
				}

				cks[ii].checked = bool;	//1번째 것을 따르자.

//				if(cks[ii].checked)	{cks[ii].checked = false;}
//				else	{cks[ii].checked = true;}
			}
		}
	}
}

//파라미터 변경(POST -> GET)
//파라미터 form Object
function generate(frm)
{
	var rstVal = "";
	var bufArr;

	if(frm == null)	return "";
	var objArr = frm.all;
	if(objArr == null)	return "";

	rstVal += generate2(objArr);

	return rstVal;
}

//파라미터 변경2(POST -> GET)
function generate2(cks)
{
	var rstVal = "";

	//존재 X
	if(cks == null){}
	//존재 O
	else
	{
		var len = cks.length;
		//1개 존재
		if(len == null)
		{
			var ck = cks;
			if(ck.disabled != true)
			{
				if(rstVal == "")
					rstVal += generate3(ck);
				else
				{
					var bufRst = generate3(ck);
					rstVal += (bufRst=="" ? "" : ("&" + bufRst));
				}
			}
		}
		//2개 이상 존재
		else
		{
			var rstVal = "";
			for(i=0; i< len; i++)
			{
				var ck = cks[i];
				if(ck.disabled != true)
				{
					if(rstVal == "")
						rstVal += generate3(ck);
					else
					{
						var bufRst = generate3(ck);
						rstVal += (bufRst=="" ? "" : ("&" + bufRst));
					}
				}
			}
		}
	}

	return rstVal;
}

//파라미터 변경3(POST -> GET)
//input의 radio, checkbox, text, hidden, password 처리 및 select, textarea 처리
function generate3(obj)
{
	var rstVal = "";

	//input tag
	switch(obj.tagName.toUpperCase())
	{
		case "INPUT":
			switch(obj.type.toUpperCase())
			{
				case "RADIO":
				case "CHECKBOX":
					if(obj.checked)
						rstVal += (obj.name + "=" + obj.value);
					break;
				case "TEXT":
				case "HIDDEN":
				case "PASSWORD":
					rstVal += (obj.name + "=" + obj.value);
					break;
			}
			break;
		case "SELECT":
		case "TEXTAREA":
			rstVal += (obj.name + "=" + obj.value);
			break;
	}

	return rstVal;
}





function chkTwoDate(fromObj, toObj, compFormat){

   var fromD;
	var	toD;

	datefrom = fromObj.value;
	dateto = toObj.value;

   if(!(datefrom.length == 0 || dateto.length == 0)){
		if (compFormat == "dd.MM.yyyy"){
			fromD = new Date(datefrom.substring(6,10), datefrom.substring(3,5)-1, datefrom.substring(0,2), 0, 0,0);
			toD   = new Date(dateto.substring(6,10), dateto.substring(3,5)-1, dateto.substring(0,2), 0, 0,0);
		}else{
			fromD = new Date(datefrom.substring(6,10), datefrom.substring(0,2)-1, datefrom.substring(3,5), 0, 0,0);
			toD   = new Date(dateto.substring(6,10), dateto.substring(0,2)-1, dateto.substring(3,5), 0, 0,0);
		}

		if(fromD.getTime() > toD.getTime()){
			return false;
		}
	   return true;
   }
	return false;
}


/**
 * fromObj : source date
 * toObj : target date
 * compFormat : user date format
 * Compare two date
 */ 
function compareTwoDate(fromObj, toObj, compFormat, mode)
{
	var fromD;
	var	toD;
	var ret = false;

	var datefrom = "";
	var dateto = "";
	
	if( typeof fromObj  === "object" ){
		datefrom = fromObj.value;
	} else { 
		datefrom = fromObj;
	}
	
	if( typeof toObj === "object" ){
		dateto = toObj.value;
	} else { 
		dateto = toObj;
	}
	
	
	if(!mode){
		mode = "<=";
	}

   	if (!(datefrom.length == 0 || dateto.length == 0))
   	{
   		compFormat = removeChar(compFormat, ".");
   		compFormat = removeChar(compFormat, "/");
   		compFormat = removeChar(compFormat, "-");
   	
   		datefrom = removeChar(datefrom, ".");
   		datefrom = removeChar(datefrom, "/");
   		datefrom = removeChar(datefrom, "-");
   		
   		dateto = removeChar(dateto, ".");
   		dateto = removeChar(dateto, "/");
   		dateto = removeChar(dateto, "-");
   		
   		var idx_y = compFormat.indexOf('yyyy');
		var year1 = datefrom.substring(idx_y, idx_y+4);
		var year2 = dateto.substring(idx_y, idx_y+4);
		
		var idx_m = compFormat.indexOf('MM');
		var mon1 = datefrom.substring(idx_m, idx_m+2);
		var mon2 = dateto.substring(idx_m, idx_m+2);

		var idx_d = compFormat.indexOf('dd');
		var day1 = datefrom.substring(idx_d, idx_d+2);
		var day2 = dateto.substring(idx_d, idx_d+2);

		fromD = new Date(year1, mon1-1, day1, 0, 0, 0);
		toD   = new Date(year2, mon2-1, day2, 0, 0,0);

		if(mode == ">"){
			ret = (fromD.getTime() > toD.getTime());
		}else if(mode == "<"){
			ret = (fromD.getTime() < toD.getTime());
		}else if(mode == "<="){
			ret = (fromD.getTime() <= toD.getTime());
		}else if(mode == ">="){
			ret = (fromD.getTime() >= toD.getTime());
		}else if(mode == "=="){
			ret = (fromD.getTime() == toD.getTime());
		}
		
		/*
		if(fromD.getTime() > toD.getTime())
		{
			return false;
		}
	   	return true;
	   	*/
   	}
	return ret;
}



