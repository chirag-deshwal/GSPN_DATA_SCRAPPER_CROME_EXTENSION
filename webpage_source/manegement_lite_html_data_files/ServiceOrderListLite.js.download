}
var inputRestored=false;
var loadComplete=false;
var searchFlag=false;
function loadCondition(){

	if(!parent.svcInput) return;
	inputRestored=true;
	searchOption = parent.svcInput.searchOption; 
	setTab(searchOption);
	//china version intergration 2016/07/14 pcs73.
	if(isChinaRegion){
		
		$j('#tablemain01 input[type=text],#tablemain01 select').each(function() {
			$j(this).val(parent.svcInput[this.name]);
		});
		
		$j('#tablemain02 input[type=text],#tablemain02 select').each(function() {
			$j(this).val(parent.svcInput[this.name]);
		});

		$j('#table01 input[type=text],#table01 select').each(function() {
			$j(this).val(parent.svcInput[this.name]);
		});
		$j('#table02 input[type=text],#table02 select').each(function() {
			$j(this).val(parent.svcInput[this.name]);
		});
		//Mobile Flag Load
		$j('#table01 input[type=checkbox]').each(function() {
			if(parent.svcInput[this.name]){
				$j(this).attr("checked", true);							
			}							
		});
		$j('#table02 input[type=checkbox]').each(function() {
			if(parent.svcInput[this.name]){
				$j(this).attr("checked", true);							
			}
		});
		
		//상세조건 입력하고 조회한 경우 리스트로 돌아올때 테이블 영역을 보여준다...
		var detailCondInput = false;
		$j('#table03 input, #table03 select').each(function() {
			$j(this).val(parent.svcInput[this.name]);
			if(this.value !='') detailCondInput = true;
		});
		if(detailCondInput) moreOpenid(1);		
		
	}else{//if(isChinaRegion){
		
	setComboValue($('asc_code'),parent.svcInput.asc_code);
	setComboValue($('cc_code'),parent.svcInput.cc_code);
	setComboValue($('status1'),parent.svcInput.status1);
	//setComboValue($('reason1'),parent.svcInput.reason1);
	setComboValue($('status2'),parent.svcInput.status2);
	//setComboValue($('reason2'),parent.svcInput.reason2);
	$('req_date_from1').value=parent.svcInput.req_date_from1;
	$('req_date_to1').value=parent.svcInput.req_date_to1;
	setComboValue($('service_type'),parent.svcInput.service_type);
	$('model').value=parent.svcInput.model;
	$('serial_no').value=parent.svcInput.serial_no;

	//$('CONSUMER').value=parent.svcInput.CONSUMER;
	$('appt_date_from').value=parent.svcInput.appt_date_from;
	$('appt_date_to').value=parent.svcInput.appt_date_to;
	setComboValue($('voc_flag'),parent.svcInput.voc_flag);
	setComboValue($('b2b_flag'),parent.svcInput.b2b_flag);
	//setComboValue($('product'),parent.svcInput.product);
	//engineer..  LOCAL_PRODUCT..
	setComboValue($('wty_flag'),parent.svcInput.wty_flag);
	setComboValue($('wty_type'),parent.svcInput.wty_type);
	setComboValue($('high_risk_flag'),parent.svcInput.high_risk_flag);
	$('OBJECT_ID_FROM').value=parent.svcInput.OBJECT_ID_FROM;
	$('OBJECT_ID_TO').value=parent.svcInput.OBJECT_ID_TO;

	if(_l.u.c == "C370"){
		$j('#dateType_from').val( parent.svcInput.dateType_from );
		$j('#dateType_to').val( parent.svcInput.dateType_to );
		$j('#SODETAILTYPE'+searchOption).val( parent.svcInput.SODETAILTYPE ) ;
		
	}
	
	$j('#service_order_no').val(parent.svcInput.service_order_no);
	
	try{
		setComboValue($('billing_flag'),parent.svcInput.billing_flag);
		setComboValue($('cust_return_dt_flag'),parent.svcInput.cust_return_dt_flag);
	}catch(e){}

	
	}//if(isChinaRegion){
	
	//china version intergration 2016/07/14 pcs73.
	//중국은 아래의 displaySearch() 호출안함..
	if(isChinaRegion){
		return;
	}
	
	if(searchFlag){
		if(parent.svcInput.service_order_no == ""){
			if(searchOption==1){
				displaySearch(0,0);
			}else if(searchOption==2){
				if(loadComplete) displaySearch(0,0);
			}
		}else{
			$j('#service_order_no').val(parent.svcInput.service_order_no);
			serviceOrderDetailSearch();
		}
	}
}

function setComboValue(selectObj,def){
    for (var i=0; i<selectObj.length; i++){
        if(def==selectObj[i].value){
            selectObj[i].selected=true;
            break;
        }
    }
}

/**
 * Json Object(ê·¸ë¦¬ë ë°ì´í°) ê°ì²´
 */
var jsonObj = null;
/**
 * íë©´ ê²ì ë©ìë
 */
function displaySearch(currPage, currBlock) {
	
	if(searchOption==1){
        $('status').value=$('status1').value;
        $('reason').value=$('reason1').value;
        $('req_date_from').value="";
        $('req_date_to').value="";
        
        if(_l.u.c == "C370"){
        	$('soDetailType').value=$('soDetailType1').value;
        	if($('soDetailType').value == "DET002"){
        		var dateType_from = $j("#dateType_from").val();
            	var dateType_to = $j("#dateType_to").val();
            	
        		$j("#req_date_from").val(dateType_from);
            	$j("#req_date_to").val(dateType_to);
            	
            	if(!checkNullSvc($('dateType_from'), _l.r.m.MAND_XVALUE_00699 ) ){return}
            	if(!checkNullSvc($('dateType_to'), _l.r.m.MAND_XVALUE_00699 ) ){return}
            	
            	if(!checkDateInteval()) {
            		return;
            	}   
        	}
        }
        if(_l.u.c == "C310" && $('status').value == "ST035"){
        	$j("#req_date_from").val(_l.oneMonthAgoDate);
        	$j("#req_date_to").val(_l.today);
        }
        //china version intergration 2016/07/14 pcs73.
        if(isChinaRegion){
        	$('soDetailType').value=$('soDetailType1').value;
        	if($j('#MOBILE_FLAG1').is(':checked')){
		        $('MOBILE_FLAG').value = $('MOBILE_FLAG1').value;
	        }
        }//if(isChinaRegion){
    }else {
        $('status').value=$('status2').value;
        $('reason').value=$('reason2').value;

    	$('req_date_from').value =$('req_date_from1').value;
    	$('req_date_to').value   =$('req_date_to1').value;
    	
    	if(!checkNullSvc($('req_date_from1'), _l.r.m.MAND_XVALUE_00699) ){return}
    	if(!checkNullSvc($('req_date_to1'), _l.r.m.MAND_XVALUE_00699) ){return}
    	
    	if(!checkReqDtInteval()) {
    		return;
    	}
    	if(_l.u.c == "C370"){
    		$('soDetailType').value=$('soDetailType2').value;
    	}
        //china version intergration 2016/07/14 pcs73.
        if(isChinaRegion){
        	$('soDetailType').value=$('soDetailType2').value;
        	if($j('#MOBILE_FLAG2').is(':checked')){
		        $('MOBILE_FLAG').value = $('MOBILE_FLAG2').value;
	        }
        }//if(isChinaRegion){
    }
    
    
    /*
    * if serial is not empty, model have to exist
    */
    if(!checkModelSerial()) {
        return;
    }    
    
	searchPageNo = currPage;
	searchBlckNo = currBlock;
	
    /** TBody  ê°ì²´ ID */
    var tbodyObj = $('searchContentTableBody');
    /** ì´ì  Grid ê°ì²´ì ë¸ëê° ìë ê²½ì° ìë¡ ê°±ì íê¸° ìí´ ì­ì íë¤. */
    clearGridJsonObject(tbodyObj);
    $('datacnt').innerHTML='';//data count display.

    if(_l.useDynatrace) {
    	dtAction = dynaTrace.enterAction('SOListSearch();'+_l.dtADKCode, 'Click SOListSearch');
    }
    
    if($j("#SUB_SVC_TYPE3").length && $j("#SUB_SVC_TYPE3").val() != ""){
    	$j("#SUB_SVC_TYPE").append("<option value='" + $('SUB_SVC_TYPE3').value + "' selected>");
    }
    
    //china version intergration 2016/07/14 pcs73.
    if(isChinaRegion){
		// 이전 설치관련 노트가 있는 경우 삭제
	    if($j("[name=toggle]").length > 0){
			$j("[name=toggle]").parent().remove();        	
	    }			
		$j("#installPrintTd").hide();
    }//if(isChinaRegion){
	/**
	 * íë¡ê·¸ëë°ë¥¼ ì§íìí¨ë¤.
	 */
	$('progressloading').startWaiting();

	$('searchFormMain').cmd.value = 'SvcOrderArkListCmd';

	AjaxRequest(urlPatternGZIP,'searchFormMain', setGridJsonObject);
	setCondition();
}
//china version intergration 2016/07/14 pcs73.
function displaySummary(currPage, currBlock){
	
	searchPageNo = currPage;
	searchBlckNo = currBlock;

    /** TBody  객체 ID */
    var tbodyObj = $('searchContentTableBody');
    /** 이전 Grid 객체에 노드가 있는 경우 새로 갱신하기 위해 삭제한다. */
    clearGridJsonObject(tbodyObj);
    $('datacnt').innerHTML='';//data count display.
    
	$('progressloading').startWaiting();
    
    var length = $j("[name=OBJECT_LIST_ID]").length;
    for(var i=length-1;i>-1;i--){
    	if($j("[name=OBJECT_LIST_ID]").eq(i).val().length == 0){
    		$j("[name=OBJECT_LIST_ID]").eq(i).remove();
    	}
    	
    }	
    
	$('summaryForm').cmd.value = 'SvcOrderArkListCmd';
	
	AjaxRequest(urlPatternGZIP,'summaryForm', setGridJsonObject);
	setCondition();
}
function checkDateInteval(){

    if( !checkValidDate($('dateType_from')) ) {$('dateType_from').select();return false;}
    if( !checkValidDate($('dateType_to')) )   {$('dateType_to')  .select();return false;}

    var format=_l.u.DateFormat;
    var frdt=$('dateType_from').value;
    var todt=$('dateType_to').value;	
	
    var maxdate = 31;

    if(cfGetDateDiff(cfGetDate(frdt, format), cfGetDate(todt, format))>maxdate){
        alert("Adjust search condition : Request Date must be shorter than "+maxdate+" days");
        $('req_date_from1').focus();
        return false;
    }
    return true;
}






function checkModelSerial(){
	var isOk = false;
	var serial = $("searchFormMain").serial_no.value.strip();
	var model = $("searchFormMain").model.value.strip();
	
	if(serial != "" && model == ""){
		alert(_l.r.m.MAND_XVALUE_00457);
		$("searchFormMain").model.focus();
	}else{
		isOk = true;
	}
	
	return isOk;
}
/**
 * 
 */
function setGridJsonObject(response) {//alert(response.responseText);
    $('progressloading').stopWaiting();
	try {
		jsonObj = eval('('+response.responseText+')');

		if (jsonObj.error) {
			cfExceptionPop(jsonObj);
			return;
		}
		if (jsonObj.success) {
            //
            try{
                parent.jsonGlobalTemp=jsonObj;
            }catch(e){}

			gridDraw(searchPageNo, searchBlckNo);
			
			
		} else {
			appendGridNoObjectDisplay('searchContentTableBody', '17',dataNotFoundMsg, 'pagingProcess');
		}
	} catch (e) {}
	finally	{		
		if(_l.useDynatrace) {
			dynaTrace.leaveAction(dtAction);
		}		
	}
	//china version intergration 2016/07/14 pcs73.
	if(isChinaRegion){
		colorDraw();
	}//if(isChinaRegion){
}

//china version intergration 2016/07/14 pcs73.
function colorDraw(){
	
	if(jsonObj != null){
	
		if(jsonObj.etSvcSummary.length > 0){
	
			var obj = jsonObj.etSvcSummary[0];
	
			$('NO_ENGR_2').update(obj.NO_ENGR_2);			
			$('NO_ENGR_3').update(obj.NO_ENGR_3); 		
			$('NO_ENGR_5').update(obj.NO_ENGR_5);
						
			$('NO_APPOINT_10').update(obj.NO_APPOINT_10);			
			$('NO_APPOINT_30').update(obj.NO_APPOINT_30); 			 
			$('NO_APPOINT_60').update(obj.NO_APPOINT_60); 
			 			
			$('NO_COMP_1').update(obj.NO_COMP_1);			
			$('NO_COMP_3').update(obj.NO_COMP_3); 			 
			$('NO_COMP_7').update(obj.NO_COMP_7); 
			 			
			$('NO_DELI_1').update(obj.NO_DELI_1); 			 
			$('NO_DELI_3').update(obj.NO_DELI_3); 			 
			$('NO_DELI_5').update(obj.NO_DELI_5); 
			 			
			$j("[name=LIST_SUM]").eq(0).val(obj.LIST_ENGR_2);
			$j("[name=LIST_SUM]").eq(1).val(obj.LIST_ENGR_3);
			$j("[name=LIST_SUM]").eq(2).val(obj.LIST_ENGR_5);
			$j("[name=LIST_SUM]").eq(3).val(obj.LIST_APPOINT_10);
			$j("[name=LIST_SUM]").eq(4).val(obj.LIST_APPOINT_30);
			$j("[name=LIST_SUM]").eq(5).val(obj.LIST_APPOINT_60);
			$j("[name=LIST_SUM]").eq(6).val(obj.LIST_COMP_1);
			$j("[name=LIST_SUM]").eq(7).val(obj.LIST_COMP_3);
			$j("[name=LIST_SUM]").eq(8).val(obj.LIST_COMP_7);
			$j("[name=LIST_SUM]").eq(9).val(obj.LIST_DELI_1);
			$j("[name=LIST_SUM]").eq(10).val(obj.LIST_DELI_3);
			$j("[name=LIST_SUM]").eq(11).val(obj.LIST_DELI_5);
		}else{
	
			$('NO_ENGR_2').update("0");			
			$('NO_ENGR_3').update("0"); 		
			$('NO_ENGR_5').update("0");
						
			$('NO_APPOINT_10').update("0");			
			$('NO_APPOINT_30').update("0"); 			 
			$('NO_APPOINT_60').update("0"); 
			 			
			$('NO_COMP_1').update("0");			
			$('NO_COMP_3').update("0"); 			 
			$('NO_COMP_7').update("0"); 
			 			
			$('NO_DELI_1').update("0"); 			 
			$('NO_DELI_3').update("0"); 			 
			$('NO_DELI_5').update("0"); 
			
			$j("[name=LIST_SUM]").each(function(i){
				$j(this).val("");
			});				
		}
	}
}


/**
 * SAP ë°ì´í°ì ê·¸ë¦¬ë ì¶ë ¥ í¨ì.
 */
function gridDraw(currPage, currBlock) {
	if (jsonObj != null) {
		/** TBody  ê°ì²´ ID */
		var tbodyObj = $('searchContentTableBody');
					
		/*  íë¡ê·¸ëë°ë¥¼ ì§íìí¨ë¤. */
		//$('pagingProcess').startWaiting();
		
		/** ì´ì  Grid ê°ì²´ì ë¸ëê° ìë ê²½ì° ìë¡ ê°±ì íê¸° ìí´ ì­ì íë¤. */
		clearGridJsonObject(tbodyObj);

		/**
		 * íì´ì§ : SAP ë°ì´í°ë¥¼ ê·¸ë¦¬ëì íì´ì§ ì²ë¦¬ë¥¼ ìí ìì ë°ì´í°ì ë§ì§ë§ ë°ì´í°ì ì²ë¦¬í¨ìí¸ì¶.
		 */
		searchPageNo = currPage;
		searchBlckNo = currBlock;
		setDisplayRow();
		

		/**
		 * DAOê²°ê³¼ë¥¼ íë©´ì ì¶ë ¥
		 */
		var tdTag = null;
		var aTag = null;
		var length = jsonObj.etSvcInfo.length;
		
		//검색 결과가 한개이고 Update 화면에서 List버튼으로 오지 않았을경우 바로 수정화면으로 전환, //exchange/refund ticket : DET002,003 / exclude SEA Walk in Service
		var onlyOneObj = jsonObj.etSvcInfo[0];
		if(length==1 && _l.fromListButton!='Y' && _l.u.c_SEA == "C310" && _l.dataChange != "X"){
			svcOrderLinkLiteEdit(onlyOneObj.service_order_no);
			return;			
		}else{	
			_l.fromListButton = '';
			_l.dataChange="";
		}
		
		totRow = length;  
        $('datacnt').innerHTML=length;//data count display.
		for (var i = displayBeginRow; i < length; i++) {
			
			/** paging : ë§ì§ë§ ì¶ë ¥ ë°ì´í° ì¬ë¶ */
			if (i >= displayFinishRow) {
				break;
			}
        
			/**
			 * SAPê²°ê³¼ë¥¼ íë©´ì ì¶ë ¥
			 */
			var obj = jsonObj.etSvcInfo[i];
        
			var tdAtt = {};
        	if (i % 2 == 1) tdAtt = {'style' : 'background-color : #F4F4F4'};
			
        	var style = obj.status;
        		
        	if (obj.WARRANTY_STATUS) style = 'ST055';
        	
			var trTag = document.createElement("tr");

			/** NO */
			tdTag = new Element("td", tdAtt);
			tdTag.rowSpan = "2";
			tdTag.className = "td_ac";
			tdTag.addClassName(style);
			tdTag.appendChild(document.createTextNode(i+1));
			trTag.appendChild(tdTag);

			/** Service Order No */
			tdTag = new Element("td", tdAtt);
			tdTag.className = "td_al";
			
			if(_l.u.c == "C550"){ //SIEL %>
				var checkBox= new Element("input", {'type':'checkBox','name':'print_id','id':'print_id','value':obj.service_order_no});
				tdTag.appendChild(checkBox);
				tdTag.appendChild(document.createTextNode(' '));
			}
			//aTag = document.createElement("a");
			//aTag.href='javascript:svcOrderLink("'+obj.service_order_no+'")';//'javascript:void(0)';
			//aTag.appendChild(document.createTextNode(obj.service_order_no));
			
			
			
			
			if(_l.u.c_SEA == "C310"){
				tdTag.insert("<a href=javascript:svcOrderLinkLitePop('"+obj.service_order_no+"')>" + obj.service_order_no + "</a>&nbsp;&nbsp;");
			}else{
				tdTag.insert("<a href=javascript:svcOrderLinkLite('"+obj.service_order_no+"')>" + obj.service_order_no + "</a>&nbsp;&nbsp;");
			}
			
			if(isChinaRegion || ( (obj.detail_type != "DET002" || _l.u.c == "C370") && obj.detail_type != "DET003")){//exchange/refund ticket : DET002,003 / exclude SEA Walk in Service
				tdTag.insert("<a href=javascript:svcOrderLinkLiteEdit('"+obj.service_order_no+"')>"+_l.r.c.EDIT+"</a>");
			}
									
			//tdTag.appendChild(aTag);
			trTag.appendChild(tdTag);

			
			/** asc_job_no */
			tdTag = new Element("td", tdAtt);
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. asc_job_no));
			trTag.appendChild(tdTag);
			if(_l.u.c == "C310"){
				/** Posting */
				tdTag = new Element("td", tdAtt);
				tdTag.className = "td_ac";
				tdTag.appendChild(document.createTextNode(obj. posting_date));
				trTag.appendChild(tdTag);				
				/** Call Received Date */
				tdTag = new Element("td", tdAtt);
				tdTag.className = "td_ac";
				tdTag.appendChild(document.createTextNode(obj. CALL_RCV_DT));
				trTag.appendChild(tdTag);				
				/** Call Received Time */
				tdTag = new Element("td", tdAtt);
				tdTag.className = "td_ac";
				tdTag.appendChild(document.createTextNode(obj. CALL_RCV_TM));
				trTag.appendChild(tdTag);								
			}else{			
				/** Created */
				tdTag = new Element("td", tdAtt);
				tdTag.className = "td_ac";
				tdTag.appendChild(document.createTextNode(obj. request_date));
				trTag.appendChild(tdTag);
				/** Assigned */
				tdTag = new Element("td", tdAtt);
				tdTag.className = "td_ac";
				if(obj.otbFlag == "X"){
					tdTag.addClassName("ST030");
				}
				tdTag.appendChild(document.createTextNode(obj. assigned_date));
				trTag.appendChild(tdTag);
				
				/** Assigned Time*/
				tdTag = new Element("td", tdAtt);
				tdTag.className = "td_ac";
				tdTag.appendChild(document.createTextNode(obj. assigned_time));
