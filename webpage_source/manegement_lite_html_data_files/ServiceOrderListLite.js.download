var searchOption=1;
function setTab( val){
	
	if( val == "1"){ 
        searchOption=1; 
		document.getElementById("table01").style.display = "block";
		document.getElementById("td1_01").className = "tab_left_ov";
		document.getElementById("td1_02").className = "tab_ov";
		document.getElementById("td1_03").className = "tab_right_ov";
		
		if(!isAsiaRegion){
		
		document.getElementById("table02").style.display = "none";
		document.getElementById("td2_01").className = "tab_left";
		document.getElementById("td2_02").className = "tab";
		document.getElementById("td2_03").className = "tab_right";
		document.getElementById("excelButtonTable").style.display = "none";
		
		}
	
		//china version intergration 2016/07/14 pcs73.
		if(!isChinaRegion){
		var ticketType = $j("#SODETAILTYPE1").val();
		showDateType(ticketType);
		}//if(!isChinaRegion){
		
	}else if( val == "2" ){
        searchOption=2;
		document.getElementById("table01").style.display = "none";
		document.getElementById("td1_01").className = "tab_left";
		document.getElementById("td1_02").className = "tab";
		document.getElementById("td1_03").className = "tab_right";
		
		document.getElementById("table02").style.display = "block";
		document.getElementById("td2_01").className = "tab_left_ov";
		document.getElementById("td2_02").className = "tab_ov";
		document.getElementById("td2_03").className = "tab_right_ov";
		document.getElementById("excelButtonTable").style.display = "block";
		//china version intergration 2016/07/14 pcs73.
		if(!isChinaRegion){
		var ticketType = $j("#SODETAILTYPE2").val();
		showDateType(ticketType);
		}//if(!isChinaRegion){
		
	}

}

function showDateType(ticketType){
	if(searchOption == 2){
		$j("#dateTitle").show();
		$j("#dateValue").show();
		
		$j("#date370Title").hide();
		$j("#date370Value").hide();
		
	}else if(_l.u.c == "C370" && ticketType == "DET002"){
		$j("#dateTitle").hide();
		$j("#dateValue").hide();
		
		$j("#date370Title").show();
		$j("#date370Value").show();
	}
	
}


