function quickSearchEnter(obj, ev){

	var KeyID = (window.event) ? event.keyCode : ev.keyCode;
	try {
		if( KeyID == 13 ) {
			if(obj.value != '') {
				serviceOrderDetailSearch();
			}else {
				return;
			}
		}
	}
	catch(e) { 
	}
}

function changeTicketType(type,seq){
	
	var select1 = $j("#searchFormMain").find("#status"+seq);
	select1.empty();
		
	if (type == "DET001") {
		if(seq == 1){//open data
			$j("<option/>").text("- Pending (NOT include Repair Completed) -").val("ALL").appendTo(select1);
			$j.each(trstatus, function(key, value) {
				if("ST010 ST015 ST025 ST030 ST035".indexOf(trstatus[key].codeId) < 0) return true;
				$j("<option/>").text(trstatus[key].codeId + " " + trstatus[key].codeName)
				.prop("selected", trstatus[key].codeId == "ST030")
				.val(trstatus[key].codeId).appendTo(select1);
			});
		}else{//all data
			$j("<option/>").text("- - - -").val("").appendTo(select1);
			statusCodeGroupSearch();			
		}
		
		
        /* 미주 통합
		- RT-007
		- C370일 경우 appointment,posting,complete date 선택 기능 추가
		- #dateType_from,#dateType_to 추가					
		- 2015-09-30
		 */									
		if(seq == 1 && _l.u.c == "C370"){
			$j("#dateTitle").show();
			$j("#dateValue").show();
			
			$j("#date370Title").hide();
			$j("#date370Value").hide();
		}
		
	} else {
		$j("<option/>").text("ALL").val("ALL").appendTo(select1);
		$j.each(exStatusList, function(key, value) {
			$j("<option/>").text(exStatusList[key].codeName)
			.val(exStatusList[key].codeId).appendTo(select1);
		});
		
		if(seq == 1){
			$('reason1').length=1;			
		}else{
			$('reason2').length=1;
		}
        /* 미주 통합
		- RT-007
		- C370일 경우 appointment,posting,complete date 선택 기능 추가
		- #dateType_from,#dateType_to 추가					
		- 2015-09-30
		 */	
		if(seq == 1 && _l.u.c == "C370"){
			$j("#dateTitle").hide();
			$j("#dateValue").hide();
			
			$j("#date370Title").show();
			$j("#date370Value").show();
			
		}
		
		
	}
}


//china version intergration 2016/07/14 pcs73.
function openInsPrintPop(){
	if(!insPrintVerify()){
		return;		
	}
	var url = "/svctracking/print/ServiceOrderInsBillPrint.jsp";
	w = window.open(url, "svcIns_popup", 'toolbar=no,location=no,directories=no,status=yes,'
			+'menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=900,height=530');
}
function insPrintVerify(){
	var aryCusName = [];
	var aryModel = [];	
	if($j("[name=chk]:checked").length == 1){
		return true;
	}
	if($j("[name=chk]:checked").length > 12){
		alert(_l.r.m.MSG_0116);
		return false;
	}
	$j("[name=chk]").each(function(i){
		if($j(this).is(":checked")){			
			aryCusName.push($j("[name=hidcustomer_name]").eq(i).val());
			aryModel.push($j("[name=hidmodel]").eq(i).val());
		}		
	});
	
	for(var i=0;i<aryCusName.length;i++){
		if(aryCusName[0] != aryCusName[i]){			
			alert(_l.r.m.MSG_0114);
			return false;
		}
		if(aryModel[0] != aryModel[i]){
			alert(_l.r.m.MSG_0115);	
			return false;
		}
	}
	return true;
}
var isNeeedHqConfirmBranch = null;
function checkSoFlag(){
	if($j("#searchFormMain [name=asc_code]").val() == ""){
		isNeeedHqConfirmBranch = false;			
		return;
	}
	$j("#checkSoForm [name=cmd]").val("ZNWNETWORKPROFILEDISPLAYCNCMD");
	$j("#checkSoForm [name=ascCode]").val($j("#searchFormMain [name=asc_code]").val());
	AjaxRequest(urlPatternGZIP,'checkSoForm', setCheckSoResult);
}
function setCheckSoResult(response){
	try {
		var jsonCheckSoObj = eval('('+response.responseText+')');
		if (jsonCheckSoObj != null) {
			if(jsonCheckSoObj.eS_CENTER_ATTR.chk_so.length > 0){
				isNeeedHqConfirmBranch = true;
			}else{
				isNeeedHqConfirmBranch = false;
			}
		} 
	}catch (e){
		alert(e);
	}
}

function toggleSubServicetype(svctype){
	$j('#SUB_SVC_TYPE,#SUB_SVC_TYPE3').hide();


	if(_l.u.c == 'C820' || _l.u.c == 'C390') { 
		if (svctype == 'II'){
			$j('#SUB_SVC_TYPE').show();
			$j('#SUB_SVC_TYPE3').val("");
		}else if("AD" == svctype || "IH" == svctype || "CI" == svctype || "PS" == svctype){
			$j('#SUB_SVC_TYPE').val("");
			$j('#SUB_SVC_TYPE3').show();
		}else{
			$j('#SUB_SVC_TYPE').val("");
			$j('#SUB_SVC_TYPE3').val("");
		}	
	}else if(_l.u.c == 'C430') { 
		$j('#SUB_SVC_TYPE').show();
		$j('#SUB_SVC_TYPE3').val("");
	}else if(useScPlusSubSvcType && !isNaUser){
		$j('#SUB_SVC_TYPE').val("");
		$j('#SUB_SVC_TYPE3').show();
	}
}

function moreOpenid(val){
	$j('#btnheadid'+val).hide();
	$j('#btntailid'+val).show();
	$j('#moretailid'+val).show();
}
	
function moreCloseid(val){
	$j('#btnheadid'+val).show();
	$j('#btntailid'+val).hide();
	$j('#moretailid'+val).hide();
}

function getVanId() {
	 
 	if(_l.u.c != "C550")
	{
 		return;
	}
 	
	var url = urlPatternGZIP;

	var data = "cmd=ZifGspnSryVanMappingCmd&IV_COMPANY=" + _l.u.c + "&IV_ASC_CODE="+$('asc_code').value;

	$j.ajax({
		type : "POST",
		async : false, /* 동기 */
		url : url,
		data : data,
		success : function(data) {
			
			for(var i= $j("#VANID")[0].options.length-1; i>=2 ; i--){
		    	 $j("#VANID")[0].removeChild( $j("#VANID")[0].options[i]);
			}
			$("VANID").value = "";
			
			if (data.success) {
				if(data.EtList != null && data.EtList.length > 0){
					
					// 데이터 넣기
					$('vanIdTr').style.display = '';
					
					var objSelect = $('VANID');
					var objOption;
					for(var z =0 ; z < data.EtList.length; z++){
						objOption = document.createElement('option');
						objOption.appendChild(document.createTextNode(data.EtList[z].VANID));
						objOption.setAttribute("value", data.EtList[z].VANID);
						if(_l.vanId == data.EtList[z].VANID)
							objOption.selected = true;
						
						objSelect.appendChild(objOption);
					}
				}else
				{
					// 숨김
					$('vanIdTr').style.display = 'none';
				}
			} else {
				$('vanIdTr').style.display = 'none';
			}
		},
		dataType : 'json'
	});
}