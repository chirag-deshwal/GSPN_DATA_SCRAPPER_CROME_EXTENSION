			}			
		});			
		
	}else{//if(isChinaRegion){
		
	parent.svcInput.asc_code=$('asc_code').value;
	parent.svcInput.cc_code=$('cc_code').value;
	parent.svcInput.status1=$('status1').value;
	//parent.svcInput.reason1=$('reason1').value;
	parent.svcInput.status2=$('status2').value;
	//parent.svcInput.reason2=$('reason2').value;
	parent.svcInput.req_date_from1=$('req_date_from1').value;
	parent.svcInput.req_date_to1  =$('req_date_to1').value;
	parent.svcInput.service_type=$('service_type').value;
	parent.svcInput.model  =$('model').value;
	parent.svcInput.serial_no  =$('serial_no').value;

	//parent.svcInput.CONSUMER=$('CONSUMER').value;
	parent.svcInput.appt_date_from=$('appt_date_from').value;
	parent.svcInput.appt_date_to  =$('appt_date_to').value;
	parent.svcInput.voc_flag=$('voc_flag').value;
	parent.svcInput.b2b_flag=$('b2b_flag').value;
	//parent.svcInput.product=$('product').value;
	parent.svcInput.wty_flag=$('wty_flag').value;
	parent.svcInput.wty_type=$('wty_type').value;
	parent.svcInput.high_risk_flag=$('high_risk_flag').value;
	parent.svcInput.OBJECT_ID_FROM=$('OBJECT_ID_FROM').value;
	parent.svcInput.OBJECT_ID_TO  =$('OBJECT_ID_TO').value;

	
	parent.svcInput.dateType_from  = $j('#dateType_from').val();
	parent.svcInput.dateType_to    = $j('#dateType_to').val();
