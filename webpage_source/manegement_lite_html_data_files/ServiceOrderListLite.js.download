/* status code group. */
function statusCodeGroupSearch(codeGroup) {
	$('status2').length=1;//ì´ê¸°í

	$('frmStatus').cmd.value = 'CICCodeSearchCmd';

	//china version intergration 2016/07/14 pcs73.
	if(codeGroup == null) codeGroup = "TRSTATUS";
	$('frmStatus').CODE_GROUP .value = codeGroup;

	AjaxRequest(urlPatternGZIP,'frmStatus', setStatusCodeCombo);
}
function setStatusCodeCombo(response){
	var jsonObjC = eval('('+response.responseText+')');
	var jcode = "";
	var jtitle = "";

	/** Select ë°ì¤ ID */
	var selectObj = $('status2');

	var length = jsonObjC.EtCodeInfo.length;
	if (jsonObjC.success) {
		for (var i=0; i < length; i++) {
			var obj = jsonObjC.EtCodeInfo[i];
			jcode = obj.CODE_VALUE;
			jtitle = obj.CODE_TEXT;

			var newOption = document.createElement('option');
			newOption.appendChild(document.
					createTextNode(jtitle+"["+jcode+"]" ) );//+"["+jcode+"]"
			newOption.setAttribute("value", jcode);
			selectObj.appendChild(newOption);
		}
	}
	//china version intergration 2016/07/14 pcs73.
	if(isChinaRegion){
		//Detail Type: REPAIR 가 아닌 경우만 카피...
		if($j('[name=soDetailType1]').val()!='' && $j('[name=soDetailType1]').val()!='DET001'){			
			$j('#status2 option').clone().appendTo('#status1');
		}
		reasonCodeGroupSearch();		
	}else{
		if(inputRestored) {
			loadComplete=true;
			//loadCondition();
			if(selectObj.value!='')reasonCodeGroupSearch();
		}	
	}
}

