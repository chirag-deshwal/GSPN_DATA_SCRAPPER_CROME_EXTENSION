		for (var i = 0; i < length; i++) {
			var obj = jsonObj.etSvcInfo[i];
			var trTag = document.createElement("tr");

			/** NO */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(i+1));
			trTag.appendChild(tdTag);

			/** Service Order No */
			tdTag = document.createElement("td");
			tdTag.className = "td_al";
			tdTag.appendChild(document.createTextNode(obj.service_order_no));
			trTag.appendChild(tdTag);

			/** asc_job_no */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. asc_job_no));
			trTag.appendChild(tdTag);

			/** Created */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. request_date));
			trTag.appendChild(tdTag);
							
			/** CC App Date */
			tdTag = new Element("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. CC_APP_DT));
			trTag.appendChild(tdTag);
		
			/** Assigned */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. assigned_date));
			trTag.appendChild(tdTag);
			
			/** Assigned Time*/
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. assigned_time));
			trTag.appendChild(tdTag);
			
			/** COMPLETE_DT(완료일) */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj.COMPLETE_DT));
			trTag.appendChild(tdTag);
			
			/** Model */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. model));
			trTag.appendChild(tdTag);

			/** Serial No */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. serial_no));
			trTag.appendChild(tdTag);
			
			/** IMEI */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(markIMEI(obj. imei)));
			trTag.appendChild(tdTag);

			/** Wty */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. wty_type));
			trTag.appendChild(tdTag);
			
			/** VOC */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. voc_flag));
			trTag.appendChild(tdTag);
			
			/** REDO */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. redo_flag));
			trTag.appendChild(tdTag);
			/** Detail Type */
			tdTag = document.createElement("td");				
			tdTag.className = "td_ac";
			for(var k=0;k< _l.aryDetailType.length;k++){
				if(_l.aryDetailType[k].codeId == obj. detail_type){
					tdTag.appendChild(document.createTextNode(_l.aryDetailType[k].codeName));
					break;
				}
			}
			trTag.appendChild(tdTag);
			/** Remind Cnt (독촉) */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. remind_cnt));
			trTag.appendChild(tdTag);
			
			/** HQ CONF */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			if(isNeeedHqConfirmBranch){
				tdTag.appendChild(document.createTextNode(obj.hq_conf_flag=='X'?_l.r.c.Y:_l.r.c.NO));
			}
			trTag.appendChild(tdTag);
			/** 고객등급 (VIP)*/
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. customer_grade));
			trTag.appendChild(tdTag);
			 
			/** Customer Name */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. customer_name));
			trTag.appendChild(tdTag);
				
			/** City */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. city_name));
			trTag.appendChild(tdTag);

			/** App Date */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. anticipated_date));
			trTag.appendChild(tdTag);
			
			
			/** App Time */
			tdTag = document.createElement("td");
			tdTag.colSpan = "2";
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. anticipated_time));
			trTag.appendChild(tdTag);

			/** Service Type */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. service_type_desc));
			trTag.appendChild(tdTag);

			/** Status */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. status_desc));
			trTag.appendChild(tdTag);

			/** Reason */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. reason_desc));
			trTag.appendChild(tdTag);

			/** B2B */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj.b2b_svc=='Y'?_l.r.c.Y:''));
			trTag.appendChild(tdTag);
							
			/** Risk Grade */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj.risk_grade));
			trTag.appendChild(tdTag);
				
			/** Risk Sensiong */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. sen_dt));
			trTag.appendChild(tdTag);

			/** Risk Reason */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			tdTag.appendChild(document.createTextNode(obj. risk_name+'-'+obj. risk_grade_desc));
			trTag.appendChild(tdTag);

			tbodyObj.appendChild(trTag);
		}
        return true;
	}
}

//unique search..
function serviceOrderDetailSearch() {
	/* token_no 검색조건 추가로 체크로직 변경 jiw 2015.01.06 */
	//china version intergration 2016/07/14 pcs73.
	var must_soNo_jobNo = false;
	if(isChinaRegion){
		must_soNo_jobNo = ($('service_order_no').value == '' && $('asc_job_no').value == '');
	}else{
		must_soNo_jobNo = ($('service_order_no').value == '' && $('asc_job_no').value == '' && $('token_no').value == '');
	}
	if (must_soNo_jobNo) {
        alert(_l.r.m.EXT_0004);
        $('service_order_no').focus();
		return;
	}
    

	if(!_l.seeDetailWithoutAscCode){
		  //if only one ship-to  exist except All, skip below check logic
	    if ($('asc_code').options.length > 2 && $('asc_code').value == '' ) {
	        alert(_l.r.m.MAND_XVALUE_00790);
	        $('asc_code').focus();
			return;
		}
	}

    $j('#searchContentTableBody').empty();
    $('datacnt').innerHTML='';//data count display.
	
	
    var formObj=$('searchFormMain');
	formObj.cmd.value = 'SvcOrderArkListCmd';
	formObj.objectID.value = $('service_order_no').value;
	formObj.ascJobNo.value = $('asc_job_no').value;
	formObj.tokenNo.value = $('token_no').value;
	formObj.ascCode.value = $('asc_code').value;
	
	searchPageNo = 0;
	searchBlckNo = 0;	
	AjaxRequest(urlPatternGZIP+'?Quick=QUICK','searchFormMain', setGridJsonObject);
	setCondition();
	
	$('progressloading').startWaiting();
	$('progressloading').style.height=self.document.body.scrollHeight;
    self.scrollTo(0,document.body.scrollHeight/3);
}


