			tbodyObj.appendChild(trTag);
		}

		if (length == 0) {
			appendGridNoObjectDisplay('searchContentTableBody', '17',dataNotFoundMsg);
		}
		
		loadingComplete(searchPageNo, searchBlckNo, totRow, 'gridDraw', 'SAP');
	
		/**
		* after searching, the user have to move the cursor to see the result, because the search condition is lot of
		* therefor, automatically move the screen to "search result panal"
		*/
		document.location.href="#searchResult";
		
		
		//china version intergration 2016/07/14 pcs73.
		if(isChinaRegion){
			//서비스타입이 'II'(설치건)일때 프린트&체크박스 보이기
			if(length > 0 && $j("#service_type").val() == "II"){
				if($j('[name=installChkTD]')){					
					$j('[name=installChkTD]').remove();
				}
				$j("#installPrintTd").show();				
				$j("#searchContentTableHead").prepend("<td rowspan=\"2\" name=\"installChkTD\" class=\"tb_ti\"><input type=\"checkbox\" id=\"toggle\" name=\"toggle\" onClick=\"javascript:cfSelectDeselectAll('toggle','chk')\" /></td>");				
				$j("#searchContentTableBody tr:even").each(function(i){
					$j(this).prepend("<td rowspan=\"2\" class=\"td_ac\"><input type=\"checkbox\" id=\"chk\" name=\"chk\"/></td>");
				});
			}		
		}//if(isChinaRegion){
		
	}
}

function gridDrawExcel() {
    if(jsonObj==null)return false;
