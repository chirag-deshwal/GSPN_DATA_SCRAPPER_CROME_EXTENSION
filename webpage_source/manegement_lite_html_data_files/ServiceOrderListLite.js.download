var dtAction = null;
	/** Onload */
	$j(start);
	if (loginUserCorpCode == 'C310') $j(initializeC310);

	/** SEA Exclusive */
	function initializeC310() {
		$j('#trCollectionCenter').hide();
		if($('asc_code').value==""){// Ship-to-Branch : --ALL-- 일때  화면로드 시 getEngineerList() 호출 
			getEngineerList();
		}
	}

//china version intergration 2016/07/14 pcs73.
function initializeC6(){
	moreCloseid(1); //for china, hide the detail search options.	
	$j("[name=A_SUM]").live('click', function(){
		
		var idx = $j("[name=A_SUM]").index($j(this));
		
		if($j("[name=LIST_SUM]").eq(idx).val().length == 0 ){
			
			return false;
		}
		var hiDiv = $("hiddenDiv");
		var input = null;
		var arySoNum = $j("[name=LIST_SUM]").eq(idx).val().split(":");
		for(var i=0;i<arySoNum.length;i++){
			input = new Element("input",{"type":"hidden","name":"OBJECT_LIST_ID","value":arySoNum[i]})
			hiDiv.appendChild(input);
		}
		displaySummary(0,0);
		$j("#hiddenDiv").empty();
	});	
	$j('select option').each(function(index){
		this.title = this.value;
	});
	$j('[type=text],select').each(function(index){
		this.title = this.name;
	});
	
	//***** status Initialize Logic  ************************
	//"  ST010 ST015 ST025 ST030 ST035"
	if(_l.soDetailType==''||_l.soDetailType=='DET001'){
		$j('select[name="status1"] option').each(function(index){
			var val = this.value;
			if(!(val=='ALL'||val=='ST010'||val=='ST015'||val=='ST025'||val=='ST030'||val=='ST035')){
				$j(this).remove();
			}
		});
	}	

	$j('select[name="TRSTATUS_BACK"] option').each(function(index){
		var val = this.value;
		if(!(val=='ALL'||val=='ST010'||val=='ST015'||val=='ST025'||val=='ST030'||val=='ST035')){
			$j(this).remove();
		}
	});

	$j('[name=soDetailType1],[name=soDetailType2]').change(function(){
		if(searchOption == 1){
			$j('[name=soDetailType2]').val($j('[name=soDetailType1]').val());
		}else{
			$j('[name=soDetailType1]').val($j('[name=soDetailType2]').val());
		}
		$('status1').length=0;
		$('reason1').length=1;
		$('status2').length=1;
		$('reason2').length=1;
		var codeGroup = getDetailTypeGroup(this.value);

		if(codeGroup=='')return;
		
		if(codeGroup=='TRSTATUS'){
			$j('#TRSTATUS_BACK option').clone().appendTo('#status1');
// 			$j('#status1 option[value=ALL]').attr('selected',true);
			setReason1();
		}else if(codeGroup=='RFSTATUS' || codeGroup=='EXSTATUS'){
			reason1_CodeGroupSearch();
		}
		//status2 Setting
		statusCodeGroupSearch(codeGroup);
	});
	//***** status Initialize Logic  ************************ 	
}

/* Page Loading Intialize!!*/
function start(){
	//china version intergration 2016/07/14 pcs73.
	if(isChinaRegion){
		initializeC6();
	}
    /* Calendar Set init st */
	initialDatePicker();
	var elementId="#req_date_from1,#req_date_to1,#appt_date_from,#appt_date_to";
	if(_l.u.c == 'C310'){
		elementId = elementId + ",#CUST_REQ_DATE_FROM,#CUST_REQ_DATE_TO"; 
	} 
	if(isChinaRegion){//china version intergration 2016/07/14 pcs73.
		elementId = elementId + ",#CC_APP_DT_FROM, #CC_APP_DT_TO";
	}
	
	/*
	 * 미주 통합
	- RT-007
	- C370일 경우 appointment,posting,complete date 선택 기능 추가
	- #dateType_from,#dateType_to 추가					
	- 2015-09-30
	 */		
	if(_l.u.c == 'C370'){
		elementId = elementId + ",#dateType_from,#dateType_to"; 
		
		var sdt = $j("#SODETAILTYPE1").val();
		if(sdt != "DET001"){
			$j("#dateTitle").hide();
			$j("#dateValue").hide();
			
			$j("#date370Title").show();
			$j("#date370Value").show();
		}
	} 
	$j(elementId).datepicker( {dateFormat: _l.pickerFormat } ).css('margin-right','3px');
	$j('.hasDatepicker').keypress(validateDate);
    /* Calendar Set init ed */


    //ServiceOrderDetail.jsp history.back() ì¼ë¡ ì¤ë ê²½ì° ì¡°íê²°ê³¼ ë³µì...
    //try{
    //    if(parent.backForward){ jsonObj=parent.jsonGlobalTemp; gridDraw(0, 0); setTimeout('setReason1();',300);  }
    //}catch(e){}

    if(_l.dataChange =="X"){//after udpate on the ticket edit screen, go back to the list
		searchFlag=true;
		loadCondition();
    }
    else if(_l.p_listCall=="X"){//no matter if update or not on the ticket edit screen, go back to the list
		searchFlag=false;
		loadCondition();		
        jsonObj=parent.jsonGlobalTemp;
		if (jsonObj!=null && jsonObj.success) gridDraw(0, 0);
    }


    if ($('asc_code').value != ''){
        //collectionPointSearch();
        getEngineerList();
    }
	
    setReason1();
    if(!isChinaRegion){//china version intergration 2016/07/14 pcs73.
    	statusCodeGroupSearch();
    }
    if(isEuUser || isLaUser){
    	svcLevelSearch();
    }

	localProdGroupSearch();
	
	if(isChinaRegion){//china version intergration 2016/07/14 pcs73.
		//ASC의 본점확인 권한 여부를 판단하기 위해 펑션 호출 SBSC법인 전용
		//ASC변경시 펑션 호출, 전체검색일때는 호출하지 않는다.
		if(isNewChina){
			checkSoFlag();
		}
		
		//ASC JOB No입력란에 focus on/out시 대문자로 변경하여준다 2013-08-05 수정
		$j("#asc_job_no").focusout(function(){
			$j(this).val($j(this).val().toUpperCase());
		});
	}
	
	//CC타입추가
	//if(!isCanSelectCC){
	//	$j("#service_type").find("option[value='CC']").remove();
	//	
	//}
	
	//C720 - 9개 수리점에 대해서 SVC Type 'IS' activation
	if(_l.u.c == 'C720' && !limitTypeSSA){
		$j("#service_type").find("option[value='IS']").remove();
	}
	
	toggleSubServicetype($j("#service_type").val());
	
	getVanId();

}

function getDetailTypeGroup(DetailType){//china version intergration 2016/07/14 pcs73.
	var codeGroup='TRSTATUS';
	if(DetailType =='') codeGroup='TRSTATUS';
	else if(DetailType =='DET001') codeGroup='TRSTATUS';
	else if(DetailType =='DET002') codeGroup='EXSTATUS';//교환
	else if(DetailType =='DET003') codeGroup='RFSTATUS';//환불
	else if(DetailType =='DET005') codeGroup='CPSTATUS';//보상
	else if(DetailType =='DET006') codeGroup='EXSTATUS';//교환+보상
	else if(DetailType =='DET007') codeGroup='RFSTATUS';//환불+보상
	else codeGroup='';
	
	return codeGroup;
}

function setReason1(){
    var statusCode = $("status1").value;
    var strHTML = "";
	
	if (_l.r.AscDepotUser && (statusCode == "ST030" || statusCode == "ST034")) {	//ASC Depot User ì´ê³  Pending ëë , Ready for shipping.ì´ë©´
		$("td_reason").innerHTML = _l.r.c.DEPOT_REASON1;
	} else {
	
	    if(statusCode == "ST015") {// "ACKREASON"; //ack
	        //strHTML = "<%//=resource.getCodeComboBoxRender("ACKREASON","reason1", "","","- - - -", "class='selectSN'")%>";
	    }else if(statusCode == "ST025") {// "ENGASSIGN"; //assign
	        //strHTML = "<%//=resource.getCodeComboBoxRender("ENGASSIGN","reason1", "","","- - - -", "class='selectSN'")%>";
	    }else if(statusCode == "ST030"){ // "PENREASON"; //pending
	        //strHTML = "<%//=resource.getCodeComboBoxRender("PENREASON","reason1", "","","- - - -", "class='selectSN'")%>";
	    }else if(statusCode == "ST035"){ // "COMREASON"; //completed
	        //strHTML = "<%//=resource.getCodeComboBoxRender("COMREASON","reason1", "","","- - - -", "class='selectSN'")%>";
	    }
	    else if(statusCode == "ST033") {// "DECREASON"; //decline
	        //strHTML = "<%//=resource.getCodeComboBoxRender("DECREASON","reason1", "","","- - - -", "class='selectSN'")%>";
	    }else if(statusCode == "ST052") {// "CANREASON"; //cancel
	        //strHTML = "<%//=resource.getCodeComboBoxRender("CANREASON","reason1", "","","- - - -", "class='selectSN'")%>";
	    }else{
			strHTML ="<select id='reason1' name=\"reason1\" class=\"selectSN\"><option value=''>- None -</option></select>";
	    }
	
	    //$("td_reason").innerHTML = strHTML;
	    if($j('[name=soDetailType1]').val() == 'DET002' || $j('[name=soDetailType1]').val() == 'DET003'){
	    	return;
	    }
		$('reason1').length=1;//ì´ê¸°í
		if(statusCode=='ALL') return;
		reason1_CodeGroupSearch();
	}
}

/* reason code group. */
function reason1_CodeGroupSearch() {

	$('frmReason').cmd.value = 'CICCodeSearchCmd';
	$('frmReason').CODE_GROUP.value = '';
	//china version intergration 2016/07/14 pcs73.
	if(isChinaRegion){
		var upperGroup = getDetailTypeGroup($j('[name=soDetailType1]').val());
		$('frmReason').UPPER_GROUP.value = upperGroup;
		$('frmReason').CODE_GROUP.value = 'RMASTATUS';
	}else{
		$('frmReason').UPPER_GROUP .value = 'TRSTATUS';	
	}
	$('frmReason').UPPER_VALUE .value = $('status1').value;

	AjaxRequest(urlPatternGZIP,'frmReason', setReason1_CodeCombo);
}
function setReason1_CodeCombo(response){
	var jsonObjC = eval('('+response.responseText+')');
	var jcode = "";
	var jtitle = "";

	/** Select ë°ì¤ ID */
	var selectObj = $('reason1');

	var length = jsonObjC.EtCodeInfo.length;//alert(length);
	//if (jsonObjC.success) {
	for (var i=0; i < length; i++) {
		var obj = jsonObjC.EtCodeInfo[i];
		jcode = obj.CODE_VALUE;
		jtitle = obj.CODE_TEXT;

		var newOption = document.createElement('option');
		newOption.appendChild(document.
				createTextNode(jtitle+"["+jcode+"]" ) );//+"["+jcode+"]"
		newOption.setAttribute("value", jcode);
		selectObj.appendChild(newOption);
	}
	//}
}

