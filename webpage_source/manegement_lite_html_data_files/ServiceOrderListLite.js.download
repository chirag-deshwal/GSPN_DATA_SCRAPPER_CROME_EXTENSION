function download(){
    if(!gridDrawExcel()) return;
    $j("#ReportDisplay").val( $j("<div>")
            .append($j("#ReportTable").eq(0).clone()).html());
    $("excelForm").excelFileName.value = "ServiceOrderList_" + _l.today;
    $("excelForm").submit();
}


function changeASC(){
	//china version intergration 2016/07/14 pcs73.
	if(isChinaRegion){
		if(isNewChina){
			checkSoFlag();
		}
	}else{
		collectionPointSearch();
		
		if($('VANID').style.display == '')
			getVanId();
	}	
	getEngineerList();
}


function getEngineerList(){
	var branchCode = $('asc_code').value;
	$('engineer').length=1;//ì´ê¸°í

	//C310의 경우 EngineerSearchD3Cmd[RFC] 호출
	if(_l.u.c_SEA == "C310"){
		$('searchFormE').cmd.value = 'EngineerSearchD3Cmd';
	}else if (branchCode == ''){
		return;
	}else{
		$('searchFormE').cmd.value = 'EngineerSearchCmd';
	}
	 
	$('searchFormE').ascCode.value = branchCode;
	AjaxRequest(urlPatternGZIP+'?IV_F4_FLAG=X','searchFormE', setEngineerList);		
}
/**
 * collection point list.
 */
function collectionPointSearch() {
	$('cc_code').focus();
	$('cc_code').length=1;//ì´ê¸°í
	//$('cc_code').innerHTML='';//ì´ê¸°í
	if ($('asc_code').value == '') {
		return;
	}
	/**
	 * íë¡ê·¸ëë°ë¥¼ ì§íìí¨ë¤.
	 */
	//$('pagingProcess').startWaiting();

	$('searchFormC').cmd.value = 'collectPntListCmd';
	$('searchFormC').ascCode .value = $('asc_code').value;
	$('searchFormC').assignedFlag .value = 'X';//collection point list ëì

	AjaxRequest(urlPatternGZIP+'?IV_F4_FLAG=X','searchFormC', setCollectPointCombo);	
}
function setCollectPointCombo(response){
	var jsonObjC = eval('('+response.responseText+')');
	var jcode = "";
	var jtitle = "";

	/** Select ë°ì¤ ID */
	var selectObj = $('cc_code');

	/** ì ì²´ìµìì ë§¨ ìë¨ì ìì¹ ìí¨ë¤.
	var firstOption = document.createElement('option');
	firstOption.appendChild(document.createTextNode("- - - -"));
	firstOption.setAttribute("value", jcode);
	selectObj.appendChild(firstOption); */

	var length = jsonObjC.etCCInfoList.length;
	if (jsonObjC.success) {
		for (var i=0; i < length; i++) {
			var obj = jsonObjC.etCCInfoList[i];
			jcode = obj.SHOP_CODE;
			jtitle = obj.SHOP_NAME;

			var newOption = document.createElement('option');
			newOption.appendChild(document.
					createTextNode(jcode + " - [" + jtitle + "]"));
			newOption.setAttribute("value", jcode);
			selectObj.appendChild(newOption);
		}
	}
}

function setEngineerList(response){
	var jsonObjC = eval('('+response.responseText+')');
	var jcode = "";
	var jtitle = "";

	/** Select ë°ì¤ ID */
	var selectObj = $('engineer');
	
	// Engineer Not Assigned 추가
	if(_l.u.c_SEA == "C310"){
		var notAssigned = document.createElement('option');
		notAssigned.appendChild(document.createTextNode('-- Engineer Not Assigned --'));
		notAssigned.setAttribute("value", 'NONE');
		selectObj.appendChild(notAssigned);
	}

	var length = jsonObjC.EtEngineerInfo.length;
	if (jsonObjC.success) {
		for (var i=0; i < length; i++) {
			var obj = jsonObjC.EtEngineerInfo[i];
			jcode = obj.ENGINEER;
			jtitle = obj.ENGINEER + " | " + obj.ASC_ENGINEER + " | " + obj.ENGINEER_NAME ;

			var newOption = document.createElement('option');
			newOption.appendChild(document.createTextNode(jtitle));
			newOption.setAttribute("value", jcode);
			selectObj.appendChild(newOption);
		}
	}
}

function searchOrderNo(){
	if ($('old_service_order_no').value.strip() == '') return;

	$('searchFormD').cmd.value = 'SvcOrdNoSearchCmd';
	$('searchFormD').IV_OBJECT_ID.value = $('old_service_order_no').value;
	AjaxRequest(urlPatternGZIP,'searchFormD', setOrderNo);
	$('progressloading').startWaiting();
}
function setOrderNo(response){
    $('progressloading').stopWaiting();
	var jsonObjC = eval('('+response.responseText+')');
    if (jsonObjC.error) {
        cfExceptionPop(jsonObjC);
        return;
    }
    if (jsonObjC.success) {
        $('service_order_no').value = jsonObjC.EV_OBJECT_ID;
    } else {
        alert(jsonObjC.returnMessage);
    }
}




function checkValidDate(obj){
    if(obj.value=="") return false;
    if( !checkDate(obj.value, _l.u.DateFormat) ){
        alert(_l.r.m.CHK_DATE);
        return false;
    } else return true;
}

function checkReqDt(obj){

    if( !checkValidDate(obj) ) { obj.select(); return;}

    var frdt=$('req_date_from1').value;
    var todt=$('req_date_to1').value;
    if( frdt !="" && todt!="" )
        checkReqDtInteval();
}
function checkReqDtInteval(){

    if( !checkValidDate($('req_date_from1')) ) {$('req_date_from1').select();return false;}
    if( !checkValidDate($('req_date_to1')) )   {$('req_date_to1')  .select();return false;}

    var format=_l.u.DateFormat;
    var frdt=$('req_date_from1').value;
    var todt=$('req_date_to1').value;	
	var maxdate ;
	
	if(_l.u.c == "C550" || _l.u.c == "C820"){ //SIEL & SEDA Brasil
		maxdate = 10;
	}else if(_l.u.c == "C310"){
		maxdate = 61;
	}else {
		maxdate = 31;
	}

    if(cfGetDateDiff(cfGetDate(frdt, format), cfGetDate(todt, format))>maxdate){
        alert("Adjust search condition : Request Date must be shorter than "+maxdate+" days");
        $('req_date_from1').focus();
        return false;
    }
    return true;
}
function checkNullSvc(obj, msg){
    if(obj.value.strip() == ""){//strip = trim -- prototype.js
        alert(msg);
        obj.focus();
        return false;
    }
    return true;
}

function setCondition(){
	parent.svcInput={};
	parent.svcInput.searchOption=searchOption;

	//china version intergration 2016/07/14 pcs73.
	if(isChinaRegion){

		$j('#tablemain01 input[type=text],#tablemain01 select').each(function() {
			parent.svcInput[this.name] = this.value;
		});
		
		$j('#tablemain02 input[type=text],#tablemain02 select').each(function() {
			parent.svcInput[this.name] = this.value;
		});

		$j('#table01 input[type=text],#table01 select').each(function() {
			parent.svcInput[this.name] = this.value;
		});
		$j('#table02 input[type=text],#table02 select').each(function() {
			parent.svcInput[this.name] = this.value;
		});
		
		$j('#table03 input, #table03 select').each(function() {
