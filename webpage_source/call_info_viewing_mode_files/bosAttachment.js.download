
	/**
	 * Json Object(그리드 데이터) 객체
	 */
	var jsonBosListObj = null;
	
	function readBOS(action) {
		//=================================================================================//
		//제  목 : 인도 Demand HHP Warranty Verification Process Change with Sim Activation
		//수정일 : 2015.04.28
		//수정자 : 채보람 (로젠 솔루션)
		//내  용 : 인도일 경우 BOS 첨부 삭제시 바로 삭제 하지 않고 저장 버튼 누를때 삭제 시켜 동기화 시킨다.
		if((_l.isIndia || _l.isBangladesh || _l.isSrilanka || _l.isNepal) && isProdHHPIndia()){
			if(_l.bosAttachFlag == "Y"){
				alert("You must first save when re-attached.");
				return;
			}

			insertValue("bosForm", "isIndia", _l.isIndia);
			insertValue("bosForm", "isBangladesh", _l.isBangladesh);
			insertValue("bosForm", "isSrilanka", _l.isSrilanka);
			insertValue("bosForm", "isNepal", _l.isNepal);
			insertValue("bosForm", "isHHPIndia", isProdHHPIndia());
			insertValue("bosForm", "postDate", _l.CREATE_DATE);
		}
		//=================================================================================//
		
		 var url = "";
		    w = window.open(url, "attach_bos_popup", 'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=300,width=700,height=300');
		    w.focus();
		    var obj = $('bosForm');
		    obj.action = action;
		    obj.method = 'post';
		    obj.target = 'attach_bos_popup';
		    obj.submit(); 
	}

	/**
	 * 화면 검색 메소드
	 */
	function displayBosAtt() {
	
		/**
		 * 프로그래바를 진행시킨다.
		 */
		$('progressloading').startWaiting();
		if(_l.isReadOnlyBOS){
			$('bosForm').isReadOnly.value = "true";
		}else{
			$('bosForm').isReadOnly.value = "";
		}
		
		$('bosForm').cmd.value = 'AttachFileBOSReadCmd';
		
		AjaxRequest(urlPattern ,'bosForm', setGridJsonBosAttObject);		
	}

	/**
	 * Grid 객체 설정
	 */
	function setGridJsonBosAttObject(response) {
		try {
			jsonBosListObj = response.responseText.evalJSON();
			
			toggleBOSDivision(jsonBosListObj.success);
			
			if (jsonBosListObj.success) {
				gridBosDraw(searchPageNo, searchBlckNo);
			} else {
				if(jsonBosListObj.error){
				     cfExceptionPop(jsonBosListObj);
				}
			}
		} catch (e) {}	
		$('progressloading').stopWaiting();
	}

	/**
	 * SAP 데이터의 그리드 출력 함수.
	 */
	function gridBosDraw(currPage, currBlock) {
		
		if (jsonBosListObj != null) {
			/** TBody  객체 ID */
			var tbodyObj = $('bosAttContentTableBody');
						
			/*  프로그래바를 진행시킨다. */
			$('progressloading').startWaiting();
			
			/** 이전 Grid 객체에 노드가 있는 경우 새로 갱신하기 위해 삭제한다. */
			clearGridJsonObject(tbodyObj);	

			/**
			 * SAP결과를 화면에 출력
			 */
			var obj = jsonBosListObj;

			/* first Line start*/
			var trTag = new Element("tr");
			/** filename */
			tdTag = new Element("td", {"class":"td_ac"});
			tdTag.insert("<b>BOS</b>");
			trTag.appendChild(tdTag);

			if (obj.filename.indexOf(".") > 14) {
				/** filename */
				tdTag = new Element("td", {"class":"td_ac"});
				tdTag.insert("<a href=\"javascript:downloadBosAtt()\" title='" + obj.filename + "' >"+obj.filename.substring(0,9) + "..." + obj.filename.substring(obj.filename.indexOf("."), obj.filename.length) +"</a>");
				trTag.appendChild(tdTag);
			} else {
				/** filename */
				tdTag = new Element("td", {"class":"td_ac"});
				tdTag.insert("<a href=\"javascript:downloadBosAtt()\" title='" + obj.filename + "' >"+obj.filename+"</a>");
				trTag.appendChild(tdTag);
			}

			if (!((navigator.userAgent.match(/Android/i)) || 
					(navigator.userAgent.match(/iPhone/i)) ||
					(navigator.userAgent.match(/iPad/i)) ||
					(navigator.userAgent.match(/iPod/i)) ||
					(navigator.userAgent.match(/BlackBerry/i)))) {	
				/** file size */
				tdTag = new Element("td", {"class":"td_ac"});
				tdTag.update(obj.filesize);
				trTag.appendChild(tdTag);
			}

			if (!obj.isReadOnly) {
				/** delete */
				tdTag = new Element("td", {"class":"td_ac"});
				var delImg = new Element("img", {"src":"/img/ico_delete.gif", "width":"15", "height":"13", "style":"cursor:pointer"});
				
				//=================================================================================//
				//제  목 : 인도 Demand HHP Warranty Verification Process Change with Sim Activation
				//수정일 : 2015.04.28
				//수정자 : 채보람 (로젠 솔루션)
				//내  용 : 인도일 경우 BOS 첨부 삭제시 바로 삭제 하지 않고 저장 버튼 누를때 삭제 시켜 동기화 시킨다.
				if((_l.isIndia || _l.isBangladesh || _l.isSrilanka || _l.isNepal) && _l.isHHPIndia){
					if(_l.CurrStatus == "ST035" || _l.CurrStatus == "ST040"){
						delImg = new Element("");
					}else{
						delImg.onclick = displayBosDelAttIndo.bind(delImg);		//ServiceOrderUpdateLite.js
					}
				}else{
					delImg.onclick = displayBosDelAtt.bind(delImg);
				}
				//=================================================================================//
				
				tdTag.appendChild(delImg);
				trTag.appendChild(tdTag);
			}

			tbodyObj.appendChild(trTag);
		}
	}


	

	/**
	 * Json Object(그리드 데이터) 객체
	 */
	var jsonBosDelObj = null;

	/**
	 * 화면 검색 메소드
	 */
	function displayBosDelAtt() {
	
		/**
		 * 프로그래바를 진행시킨다.
		 */
		$('progressloading').startWaiting();

		$('bosForm').cmd.value = 'AttachFileBOSDeleteCmd';
		
		AjaxRequest(urlPattern ,'bosForm', setGridJsonBosDelAttObject);		
	}

	/**
	 * Grid 객체 설정
	 */
	function setGridJsonBosDelAttObject(response) {
		try {
			jsonBosDelObj = response.responseText.evalJSON();
			
			toggleBOSDivision(!jsonBosDelObj.success);
			
			if (jsonBosDelObj.success) {				
				alert(bosDeleteSuccessMsg);
				$j('#bosAttContentTableBody').empty();
			} else {				
				if(jsonBosDelObj.error){
				     cfExceptionPop(jsonBosDelObj);
				}
			}
		} catch (e) {}	

		resetPurchaseDateByDeletingBOS('#PURCHASE_DATE');
		$('progressloading').stopWaiting();
	}

	function resetPurchaseDateByDeletingBOS(obj) {
		setDateReadOnly(obj, true); // date.js
		$j(obj).val(zeroDate);
		checkWarranty = true;
	}

	function downloadBosAtt(){
	    var obj = $('bosForm');
	    obj.cmd.value = 'AttachFileDownloadBosCmd';
	    obj.action = urlPattern;
	    obj.method = 'post';
	    obj.target = 'ifr_attach';
	    obj.submit();
	}


	function toggleBOSDivision(bosExist){
		if(bosExist){
			$("tableBOSList").show();
			$("tableBOSBtn").hide();
		}else{
			$("tableBOSList").hide();
			$("tableBOSBtn").show();				
		}		
		if(_l.hideBOSBtn){
			$("tableBOSBtn").hide();
		}
	}
