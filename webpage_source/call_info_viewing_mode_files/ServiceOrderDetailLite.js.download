
	/*
	* mainDivCnt : all information division number
	* if you add new information division then increase mainDivCnt var +1
	*/
	var mainDivCnt = 28;
	
	function openAllDiv(){
		for(var i=1;i<mainDivCnt+1;i++){
			moreOpenid(i);
		}
		$j('#btnShowHideAll').html("<input type=\"button\"  value=\"" + _l.r.c.HIDEALL + "\" onclick=\"closeAllDiv()\">");
	}
	function closeAllDiv(){
		for(var i=1;i<mainDivCnt+1;i++){
			moreCloseid(i);
		}
		$j('#btnShowHideAll').html("<input type=\"button\"  value=\"" + _l.r.c.SHOWALL + "\" onclick=\"openAllDiv()\">");
	}
	function moreOpenid(val){
		if($('moretailid'+val) != null){
			$('btnheadid'+val).hide();  // ^ button id
			$('btntailid'+val ).show();   // V button id
			$('moretailid'+val).show();  // content id 
		}
	}

	function moreCloseid(val){
		if($('moretailid'+val) != null){
			$('btnheadid'+val).show();  // ^ button id
			$('btntailid'+val).hide();   // V button id
			$('moretailid'+val).hide();  // content id
		}
	}
	
