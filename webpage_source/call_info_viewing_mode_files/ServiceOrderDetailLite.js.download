	$('progressloading').stopWaiting();
	var jsonObj = eval('('+response.responseText+')');
	
	var length = jsonObj.pT_OUTPUT.length;
	if(length>0){
		doaReqModel = jsonObj.pT_OUTPUT[0].matnr;
		
