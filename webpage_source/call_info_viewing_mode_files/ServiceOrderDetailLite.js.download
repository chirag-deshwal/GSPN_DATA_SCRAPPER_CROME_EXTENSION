	}
	
}

function loadHhpExch(modelRbCompany){
	
	var $form = $j('#frm');
	var orderNo = _l.ObjectId;
	var ascCode = _l.ASC_CODE;
	
	$form.empty();
	$j("<input type='hidden' name='cmd'/>").val("ZcseDoarfRcvDefectCmd").appendTo($form);
	
	AjaxRequest(urlPattern+'?PI_FLAG=V&PI_BUKRS='+modelRbCompany+'&PI_KUNNR='+ascCode
			+'&ACCEPT_NO='+orderNo,'frm', setHhpExch);
	$('progressloading').startWaiting();
}
function setHhpExch(response){
	$('progressloading').stopWaiting();
	var jsonObj = eval('('+response.responseText+')'); 
	var length = jsonObj.pT_OUTPUT.length;

	var tbodyObj = $j('#tbodyDoaDefect');
	tbodyObj.children().remove();	
	
	var arr = [
	   		'accept_no'	,//접수번호
	   		'kunnr'		,//ASC No		 
	   		'matnr'		,//Model code
	   		'imei_esn'	,//IMEI/ESN No 
	   		'serno'		,//Serial No
	   		'status_text'	,//상태
	   		'rb_company'	,//접수DC
	   		'status_date1'	,//불량품 재생 요청일
	   		'status_date2'	//고장품 출고일자					
	   	];
	//출고탭을 보여준다
	$j("#doaGiTab").show();	
	if(length==0){
		jsonObj.pT_OUTPUT[0] = new Object();
	}else{
						
		loadDOAShipping(newPro_Comp);
		for (var i = 0; i < jsonObj.pT_OUTPUT.length; i++) {
			var obj = jsonObj.pT_OUTPUT[i];
			
			var trTag = $j("<tr/>");
			var tdTag = null;
			for(var i=0; i<arr.length; i++){
				
				var key = arr[i];
				var content = obj[key];
				
				if(key == 'rb_company'){				
					var len1 = aryRB_COMPANY.length;	
					for (var k = 0 ; k < len1 ; k++) {
						if (aryRB_COMPANY[k].codeId == content) {												
							content = aryRB_COMPANY[k].codeName;
							break;
						}
					}
				}				
				tdTag = $j('<td class="td_ac"/>');
				//IMEI PROJECT
				if(key=='imei_esn'){
					tdTag.append(markIMEI(content));
				}else{
					tdTag.append(content);
				}
				
				trTag.append(tdTag);
			}
			$j(tbodyObj).append(trTag);
		}		
	}
}
function loadDOADefectList(modelRbCompany) {
	
	var $form = $j('#frm');
	var orderNo = _l.ObjectId;
	var ascCode = _l.ASC_CODE;
	
	$form.empty();
	$j("<input type='hidden' name='cmd'/>").val("ZcseDoarfRcvDefectCmd").appendTo($form);

	AjaxRequest(urlPattern+'?PI_FLAG=V&PI_BUKRS='+modelRbCompany+'&PI_KUNNR='+ascCode+'&ACCEPT_NO='+orderNo,'frm', setDOADefectList);
	$('progressloading').startWaiting();
}
function setDOADefectList(response) {
	$('progressloading').stopWaiting();
	var jsonObj = eval('('+response.responseText+')'); 
	var length = jsonObj.pT_OUTPUT.length;

	var tbodyObj = $j('#tbodyDoaDefect');
	tbodyObj.children().remove();	
	
//	if(length>0 && jsonObj.pT_OUTPUT[0].secu_no == ""){		
//		$j('#DOAPrintPopBtn').show();
//	}
	
	var arr = [
		'accept_no'	,//접수번호
		'kunnr'		,//ASC No		 
		'matnr'		,//Model code
		'imei_esn'	,//IMEI/ESN No 
		'serno'		,//Serial No
		'status_text'	,//상태
		'rb_company'	,//접수DC
		'status_date1'	,//불량품 재생 요청일
		'status_date2'	//고장품 출고일자					
	];

	var secu_no = "";
	if(length==0){
		$j("#doaGiTab").hide();
		jsonObj.pT_OUTPUT[0] = new Object();

	}else{		
		$j("#doaGiTab").show();
		//생산법인 출고이력조회
		loadDOAShipping(modelRbCompany);
	}
	for (var i = 0; i < jsonObj.pT_OUTPUT.length; i++) {
		var obj = jsonObj.pT_OUTPUT[i];
		
		if(i==0) secu_no = obj.secu_no;
		
		var trTag = $j("<tr/>");
		var tdTag = null;
		for(var i=0; i<arr.length; i++){
			
			var key = arr[i];
			var content = obj[key];

			if(key == 'rb_company'){				
				var len1 = aryRB_COMPANY.length;	
				for (var k = 0 ; k < len1 ; k++) {
					if (aryRB_COMPANY[k].codeId == content) {												
						content = aryRB_COMPANY[k].codeName;
						break;
					}
				}
			}
			
			tdTag = $j('<td class="td_ac"/>');
			//IMEI PROJECT
			if(key=='imei_esn'){
				tdTag.append(markIMEI(content));
			}else{
				tdTag.append(content);
			}
			
			
			trTag.append(tdTag);
		}
		$j(tbodyObj).append(trTag);
	}
	loadInspection();

}

function loadDOAShipping(modelRbCompany) {
	
	var $form = $j('#frm');
	var orderNo = _l.ObjectId;
	var ascCode = _l.ASC_CODE;

	$form.empty();
	$j("<input type='hidden' name='cmd'/>").val("ZcseDoarfShippingCmd").appendTo($form);
		
	AjaxRequest(urlPattern+'?PI_FLAG=N&PI_BUKRS='+modelRbCompany+'&PI_ACCEPT_NO='+orderNo+'&PI_KUNNR='+ascCode,'frm', setDOAShipping);
	$('progressloading').startWaiting();
}

function setDOAShipping(response) {
	$('progressloading').stopWaiting();
	var jsonObj = eval('('+response.responseText+')');

	var tbodyObj = $j('#tbodyDoaShipping');
	tbodyObj.children().remove();

	var arr = [
		'accept_no',	//접수번호
		'exch_type',	//교환유형 
		'request_dt',	//신청일자
		'rb_gi_dt',		//출고일자
		'new_matnr',	//신모델코드
		'new_imei_esn',	//신IMEI/ESN No
		'new_serno',	//신Serial No
		'new_color',	//신Color
		'matnr',		//구모델
		'imei_esn',		//구IMEI/ESN No
		'serno'		//구Serial No
	];
	
	var length = jsonObj.pT_OUTPUT.length;
	if(length==0){
		jsonObj.pT_OUTPUT[0] = new Object();
		$j("#doaGrTab").hide();
	}else{
		$j("#doaGrTab").show();
	}
	for (var i = 0; i < jsonObj.pT_OUTPUT.length; i++) {
		var obj = jsonObj.pT_OUTPUT[i];
		
		var trTag = $j("<tr/>");
		var tdTag = null;
		for(var i=0; i<arr.length; i++){
			var key = arr[i];
			var content = obj[key];
			
			tdTag = $j('<td class="td_ac"/>');
			//IMEI PROJECT
			if(key=='imei_esn' || key=='new_imei_esn'){
				tdTag.append(markIMEI(content));
			}else{
				tdTag.append(content);
			}
			
			trTag.append(tdTag);
		}
		$j(tbodyObj).append(trTag);
	}
}
function loadInspection(){
	
	var $form = $j('#frm');	
	$form.empty();
	$j("<input type='hidden' name='cmd'/>").val("ZifGspnSvcInspectionListCmd").appendTo($form);
	$j("<input type='hidden' name='IV_OBJECT_ID'/>").val(_l.ObjectId).appendTo($form);
	$j("<input type='hidden' name='IV_ASC_CODE'/>").val(_l.ASC_CODE).appendTo($form);
	
	AjaxRequest(urlPattern,'frm', afterLoadInspection);
	$('progressloading').startWaiting();
}
function afterLoadInspection(response){
	$('progressloading').stopWaiting();
	
	var jsonObj = eval('('+response.responseText+')');
	if (jsonObj.error) {
		cfExceptionPop(jsonObj);
	}
	//NPC초기교환인 경우에 교환유형을 SWAP로 강제지정하고 DAP와 같게 한다.
	if(isNpcExchFlag == true){		
		$j("#doaInspectTab [name=EXCH_TYPE]").empty();		
		$j("#doaInspectTab [name=EXCH_TYPE]").append($j("<option/>").val("SWAP").text("SWAP"));
		
	}
	
	var ET_INSPECT_LIST = new Object();
	//테이터가 있는경우 
	if(jsonObj.ET_INSPECT_LIST.length>0){
				
		ET_INSPECT_LIST = jsonObj.ET_INSPECT_LIST[0];		
		$j('#doaInspectTab input').each(function(index){
			setDoaInspectData(ET_INSPECT_LIST,this);
		});
		$j('#doaInspectTab select').each(function(index){
			setDoaInspectData(ET_INSPECT_LIST,this);
		});
				
		var state = $j("#doaInspectTab").find("#STATE");
		var city = $j("#doaInspectTab").find("#CITY");
		var colony = $j("#doaInspectTab").find("#COLONY");
		
		$j("<option/>").text(ET_INSPECT_LIST.STATE).appendTo(state);
		$j("<option/>").text(ET_INSPECT_LIST.CITY).appendTo(city);
		$j("<option/>").text(ET_INSPECT_LIST.COLONY).appendTo(colony);
		
		//조회시 달력을 보여주지 않고 텍스트로 보여준다. 박스개봉일자, 바이오스구매일자
		$j("#BOX_OPEN_DT_TD").text(ET_INSPECT_LIST.BOX_OPEN_DT);
		$j("input #BOX_OPEN_DT").hide();
		$j("#bios_dateTd1").text(ET_INSPECT_LIST.BIOS_PUR_DT);
		$j("input #BIOS_PUR_DT").hide();
							
		//환불여부에 따라서 환불이유 필드 show,hide
		if($j("#doaInspectTab #REFUND_FLAG").val() == "X"){
			$j("#REFUND_REASON").show();
			$j("#REFUND_REASON").attr("disabled", false);
		}else{
			$j("#REFUND_REASON").hide();
			$j("#REFUND_REASON").attr("disabled", true);
		}
		//인터넷판매상
		if($j("#doaInspectTab #EXCH_TYPE").val()=="INT"){	

			$j("#problem_typeTd").attr("colspan", "1");
			$j("#intDelerListTd").show();
			$j("#intDelerListTd1").show();
			$j("#INT_DELAER").attr("disabled", false);
		}else{
			$j("#INT_DELAER").attr("disabled", true);
			$j("#intDelerListTd").hide();
			$j("#intDelerListTd1").hide();	

			$j("#problem_typeTd").attr("colspan", "3");
		}
		//구매15일이내 필드값 조정
		if(doaVisible){
			if($j("#doaInspectTab #PURCHASE15DAYS").val() == "X"){
				$j("#doaInspectTab #PUR_15").val("是");
			}else{
				$j("#doaInspectTab #PUR_15").val("否");
			}			
		}else if(accVisible){
			$j("#doaInspectTab #PUR_15").val("是");
		}
		//수정금지추가
		$j("#doaInspectTab").find("input,select").prop("disabled", true);
		
					
	}else{//Inspection 데이터가 없는경우
		$j("#doaInspectTab").hide();		
	}
	
	setTimeout(function() {
		checkPrcdField();			
	}, 500);
}
function setDoaInspectData(ET_INSPECT_LIST,obj){
	var value = ET_INSPECT_LIST[obj.name];
	if(value){
		$j(obj).val(value);
		return;
	}
}
function checkPrcdGroup(){
	var code = $j('[name=detailForm] #SVC_PRCD').val();
	var group = $j('[name=detailForm] #SVC_PRCD').val().substr(0,3);
	
	if(group == 'THB'){
		group = 'HHP';
	}
	//코드 SDT02(데스크탑)에 한해서 NPC분류에 적용함 2013-05-20 법인IT담당자 요청으로 수정
	if(group=='NPC'|| code =='SDT02'){
		group = 'NPC';
	}
	if(group=='CLP'||group=='FAX'||group=='PRT'||group=='MFP'||group=='MLP'){
		group='PRT';
	}
	return group;
}
//'NPC' 또는 'PRT'제품 판단해서 특정필드만 보여주기
var aryDisabled = [];
function checkPrcdField(){	
	var group =  checkPrcdGroup();
	
	$j("#doaInspectTab #REFUND_FLAG").live("change", function(){
		if($j(this).val() == "X"){
			$j("#REFUND_REASON").show();
			$j("#REFUND_REASON").attr("disabled", false);
		}else{
			$j("#REFUND_REASON").hide();
			$j("#REFUND_REASON").attr("disabled", true);
		}
	});
	
	$j("#doaInspectTab #EXCH_TYPE").live("change" , function(){
		if($j(this).val() == "INT"){
			$j("#problem_typeTd").attr("colspan", "1");			
			$j("#intDelerListTd").show();
			$j("#intDelerListTd1").show();
			$j("#INT_DELAER").attr("disabled", false);
		}else{
			$j("#problem_typeTd").attr("colspan", "3");
			$j("#INT_DELAER").attr("disabled", true);
			$j("#intDelerListTd").hide();
			$j("#intDelerListTd1").hide();				
		}
	});

	if(group == "NPC" || group == "PRT"){
		//색상 - 노트북,프린트 X
		$j("#colorTd").hide();
		$j("#colorTd1").hide();
		
		$j("#requester_typeTd").attr("colspan", "5");
		//교환여부,사유 - 노트북,프린트X
		$j("#refund_flagTr").hide();
		
		
		//영수증,협의서 - 노트북,프린트X
		$j("#receiptTr").hide();
		//SW버전,라벨번호,비닐봉지번호 - 노트북,프린트X
		$j("#swversionTr").hide();
		//해제여부 - 노트북,프린트X
		$j('#unlocked_ynTr').hide();
		
		//고장재현비율,시간 - 노트북,프린트X
		$j("#emersion_rateTr").hide();
		
		//soft인위고장,검측빈도 - 노트북,프린트O
		$j("#soft_defectTr").show();
		//검측방법 - 노트북,프린트O - 2013-05-20 DOADAP IT담당자의 요청으로 검측방법 필드삭제처리
//		$j("#inspect_descTr").show();
		//기기외관상황 - 노트북,프린트O
		$j("#appear_descTr").show();		
		//포장상황 - 노트북,프린트O
		$j("#pack_descTr").show();
		//악세사리상황 - 노트북O - 2013-07-04 프린터 일때도 DOA/DAP일때 악세사리 상황보여달라고 요청들어옴
		$j("#accessory_descTr").show();
		$j("#doaInspectTab #ACCESSORY_DESC").attr("disabled" ,false);
		
		if(group == "NPC"){
			//특수설명 - 노트북O,프린트X - 2013-05-17 프린터일때 특수설명 안보이게 변경요청으로 수정
			$j("#spe_descTr").show();
			$j("#doaInspectTab #SPE_DESC").attr("disabled" ,false);
			
		}
		//기타비고 - 프린트O, 2013-05-17 HHP일때도 비고란이 보여달라고 신명하 과장요청으로
		//기타비고항목 다 보여주도록 수정
//		if(group == "PRT"){
//			$j("#remark_remarkTr").show();
//			$j("form[name=doaForm] #REMARK").attr("disabled" ,false);
//		}
		
		exchTypeChangeOp($j("#EXCH_TYPE").val(), group);
		
		$j("#EXCH_TYPE").live("change", function(e){
			exchTypeChangeOp($j(this).val() , group);
		});
		
		autoSelect();	
		//파라미터 비활성화
		aryDisabled = ["COLOR","REFUND_FLAG","REFUND_REASON","RECEIPT_NO","RECEIPT_CODE","AGREE_NO","SW_VERSION","LABEL_NO","COVER_NO","UNLOCKED_FLAG","EMERSION_TERM"];
		changeDisable(aryDisabled,1);
		//파라미터 활성화
		aryDisabled =["SOFT_DEFECT","DEFECT_FREQ","INSPECT_DESC","APPEAR_DESC","PACK_DESC","SPE_DESC"];
		changeDisable(aryDisabled,2);
	}	
	
	//수정하지 못하도록 처리한다.
	$j("#doaInspectTab").find("input,select").prop("disabled", true);
}
function exchTypeChangeOp(exchType, prcdGroup){
	//DAP선택시
	if(exchType == "DAP" || exchType == "SWAP"){
		//구매영수증여부
		$j("#pop_ynTr").show();
		//구매15일 이내 여부,상품보증부합성능고장,판정결과
		$j("#pur_15Tr").show();
		aryDisabled = ["POP_YN","PUR_15","PURCHASE15DAYS"];				
		changeDisable(aryDisabled,2);
		
		//결실된 악세서리
		if(prcdGroup == "NPC"){
			$j("#missing_accsTr").show();
			$j("#bios_Tr").hide();			
			$j("#os_statusTr").hide();
			$j("#WTY_DEFECT_FLAG_Tr").show();
			
			$j("#doaInspectTab #MISSING_ACCS").attr("disabled" ,false);
			$j("#doaInspectTab #WTY_DEFECT_FLAG").attr("disabled" ,false);
			aryDisabled = ["BIOS_PUR_FLAG","BIOS_PUR_DT","OS_STATUS","HDD_USE_TIME","OTH_EQUIP_CODE"];
			changeDisable(aryDisabled,1);
		
		}
		//OA자재라인번호,기타악세서리상황
		else if(prcdGroup == "PRT"){
			$j("#oa_labelTr").show();
			$j("#PRINTED_CNT_TR").hide();
				
//			$j("#other_accsTd").show();
//			$j("#other_accsTd1").show();			
			
			aryDisabled = ["OA_LABEL_NO"];
			changeDisable(aryDisabled,2);
			$j("#doaInspectTab #PRINTED_CNT").attr("disabled" ,true);
			
		}
		
		$j("#box_openTr").hide();
		$j("#used_descTr").hide();
		$j("#result_descTr").hide();
		
		aryDisabled = ["BOX_OPEN_DT","DEFECT_CLASS","USED_DESC","RESULT_DESC"];
		changeDisable(aryDisabled,1);
						
	}
	//DOA선택시
	else if(exchType == "DOA"){
		//구매영수증여부
		$j("#pop_ynTr").hide();
		
		//구매15일 이내 여부,상품보증부합성능고장,판정결과
		$j("#pur_15Tr").hide();
		aryDisabled = ["POP_YN","PUR_15","PURCHASE15DAYS"];
		changeDisable(aryDisabled,1);
		
		
		//결실된 악세서리
		if(prcdGroup == "NPC"){
			$j("#bios_Tr").show();
			$j("#os_statusTr").show();			
			$j("#missing_accsTr").hide();
			$j("#WTY_DEFECT_FLAG_Tr").hide();
			$j("#doaInspectTab #WTY_DEFECT_FLAG").attr("disabled" ,true);
			
			$j("#doaInspectTab #MISSING_ACCS").attr("disabled" ,true);
			
			aryDisabled = ["BIOS_PUR_FLAG","BIOS_PUR_DT","OS_STATUS","HDD_USE_TIME","OTH_EQUIP_CODE"];
			changeDisable(aryDisabled,2);
		}
		//OA자재라인번호,기타악세서리상황
		else if(prcdGroup == "PRT"){
			$j("#oa_labelTr").show();
//			$j("#other_accsTd").hide();
//			$j("#other_accsTd1").hide();	
			$j("#PRINTED_CNT_TR").show();
			
			
//			$j("form[name=doaForm] #ETC_ACC_STATUS").attr("disabled" ,true);
						
			aryDisabled = ["OA_LABEL_NO","PRINTED_CNT"];
			changeDisable(aryDisabled,2);
			
		}
		
		$j("#box_openTr").show();
		$j("#used_descTr").show();
		$j("#result_descTr").show();
								
		aryDisabled = ["BOX_OPEN_DT","DEFECT_CLASS","USED_DESC","RESULT_DESC"];
		changeDisable(aryDisabled,2);
		
	}
	//OTHER선택시
	else{
		//구매영수증여부
		$j("#pop_ynTr").hide();		
		//구매15일 이내 여부,상품보증부합성능고장,판정결과
		$j("#pur_15Tr").hide();
		aryDisabled = ["POP_YN","PUR_15","PURCHASE15DAYS"];
		changeDisable(aryDisabled,1);
		//결실된 악세서리
		if(prcdGroup == "NPC"){
			$j("#missing_accsTr").hide();
			$j("#bios_Tr").hide();
			$j("#os_statusTr").hide();
			$j("#WTY_DEFECT_FLAG_Tr").hide();
			$j("#doaInspectTab #WTY_DEFECT_FLAG").attr("disabled" ,true);
			
			aryDisabled = ["MISSING_ACCS","BIOS_PUR_FLAG","BIOS_PUR_DT","OS_STATUS","HDD_USE_TIME","OTH_EQUIP_CODE"];
			changeDisable(aryDisabled,1);
		}
		//OA자재라인번호,기타악세서리상황
		else if(prcdGroup == "PRT"){
			$j("#oa_labelTr").hide();
//			$j("#other_accsTd").hide();
//			$j("#other_accsTd1").hide();
			$j("#PRINTED_CNT_TR").hide();
			
			aryDisabled = ["OA_LABEL_NO","PRINTED_CNT"];
			changeDisable(aryDisabled,1);
						
		}
		
		$j("#box_openTr").hide();
		$j("#used_descTr").hide();
		$j("#result_descTr").hide();
		
		aryDisabled = ["BOX_OPEN_DT","DEFECT_CLASS","USED_DESC","RESULT_DESC"];
		changeDisable(aryDisabled,1);		
	}

}
function autoSelect(){	
	//bios Y선택에 따라서 달력보여주고 안보여주기 구현
	if($j("[name=BIOS_PUR_FLAG]").val() == "X"){
		$j("#bios_dateTd").show();
		$j("#bios_dateTd1").show();
		$j("#bios_purTd").attr("colspan" , "1");
	}else{
		$j("#bios_dateTd").hide();
		$j("#bios_dateTd1").hide();
		$j("#bios_purTd").attr("colspan" , "5");
	}
	$j("#BIOS_PUR_FLAG").live("change" , function(e){
		if($j(this).val() == "X"){
			$j("#bios_dateTd").show();
			$j("#bios_dateTd1").show();
			$j("#bios_purTd").attr("colspan" , "1");
			$j("#BIOS_PUR_DT").attr("disabled" ,false);
		}else{
			$j("#bios_dateTd").hide();
			$j("#bios_dateTd1").hide();
			$j("#bios_purTd").attr("colspan" , "5");
			$j("#BIOS_PUR_DT").attr("disabled" ,true);
		}
	});
}
function changeDisable(ary , type){
	
	if(type == 1){
		for(var i=0;i<ary.length;i++){			
			$j('#doaInspectTab #'+ary[i]).attr("disabled", true);
		}
	}else{
		for(var i=0;i<ary.length;i++){
			$j('#doaInspectTab #'+ary[i]).attr("disabled", false);
		}	
	}
}

function openSTSSvcPrintPop(){
	var group = $j('[name=detailForm] #SVC_PRCD').val().substr(0,3);
	if(group=='THB'){
		group = "HHP";
	}else{
		group = "CE_IT";
	}
	
	var url = "";
	if(_l.SERVICE_TYPE == "II"){
		url = "/svctracking/svcorder/sts/accept_install_print.jsp?pageType=page";
	}else{
		if(group == 'HHP') url = "/svctracking/svcorder/sts/accept_hhp_print_new.jsp?objectID="+ _l.ObjectId+"&pageType=page";
		else url = "/svctracking/svcorder/sts/accept_hhp_print.jsp?objectID="+ _l.ObjectId+"&pageType=page";;
	}
	
	w = window.open(url,"SvcRequestPrintPop",'width=1180,height=650,top=50,left=100,toolbar=no,location=no,directories=no,'
		+'status=yes,menubar=yes,resizable=yes,copyhistory=no,scrollbars=yes');
	w.focus();
}

function loadAscProfile(){	
	var formId = 'AscProfileSearchForm';
	$j("#"+formId).remove();
	var $frm = $j('<form id="'+formId+'" method=post />');
	$frm.append('<input type="hidden" name="cmd" value="ZnwNetworkProfileDisplayCnCmd" />');
	$frm.append('<input type="hidden" name="ascCode" value="'+_l.ASC_CODE+'"/>');
	$j('body').append($frm);
    
	$('progressloading').startWaiting();
    AjaxRequest(urlPatternGZIP, formId, setAscProfile);
}

function setAscProfile(response){
	$('progressloading').stopWaiting();
    var jsonObjC = eval('('+response.responseText+')');
    
    if(!jsonObjC.eS_CENTER_ATTR) return;
	var centerAttr = jsonObjC.eS_CENTER_ATTR;
    
    AscChk_soUse = (centerAttr.chk_so && centerAttr.chk_so!="")?true:false;
	viewHqConfField();//AscChk_soUse
}

function viewHqConfField(){
	if(AscChk_soUse && display_hqConf == true){
		$j('#textdHqConf,[name=HQ_CONF_FLAG],[name=HQ_CONF_FLAG_view]').show();
		$j('#tdHqConf').attr('class','ser_ti');
	}else{
		$j('#textdHqConf,[name=HQ_CONF_FLAG],[name=HQ_CONF_FLAG_view]').hide();
		$j('#tdHqConf').attr('class','ser_td');
	}
}
function openSendDocumentPop(){
	var url = "";
	w = window
			.open(
					url,
					"rrr_popup",
					'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=250,left=300,width=650,height=280');
	w.focus();
	var formObj = $('detailForm');
	formObj.action =  urlPatternGZIP+'?pageType=DetailPage';
	formObj.cmd.value = 'ServiceOrderSendDocumentCmd';
	formObj.target = 'rrr_popup';
	formObj.submit();	
}