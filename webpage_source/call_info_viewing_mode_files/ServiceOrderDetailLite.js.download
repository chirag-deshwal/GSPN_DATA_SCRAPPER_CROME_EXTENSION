/**
* only for C310, add part from recommended part list
**/
function addPartsFromRecommended(part){
	var frm = document.detailForm;
	var arrParts = cfArray(frm.PARTS_CODE);
	var arrQty = cfArray(frm.PARTS_QTY);
	var partLen = arrParts.length;
	for(var i = 0; i < partLen; i++){
		if(part.strip() == arrParts[i].value.strip()){
			alert("Selected Parts No.  " + part + " has already added or ordered on the Repair Part Information tab, please first check Parts No.  " + part + " Quantity ");
			return;
		}
	}
	
	var ptype = "";
	if(_l.InventoryFlag){
		ptype = "I";
	}else if(_l.FSC){
		ptype = "F";
	}else{
		ptype = "N";
	}
		
	addParts(ptype);
	
	var arrParts = cfArray(frm.PARTS_CODE);
	var arrQty = cfArray(frm.PARTS_QTY);
	var partLen = arrParts.length;
	
	arrParts[partLen-1].value = part;
	arrQty[partLen-1].value = "1";
	
	alert(part + " added!")
}

function downFile(FILEOBJKEY,fileName,fileSize) {
    var frm = $j("#frmFileDown");
    if(frm.length == 0){
    	var url = urlPattern + "?cmd=AttachFileDownloadSvcCmd";
    	url += "&fileSize=" + fileSize;
    	frm = $j("<form id=frmFileDown method=post action=" + url + " target=ifr_attach><input type=hidden name=IV_OBJKEY /><input type=hidden name=objectID value=" + _l.ObjectId + " /><input type=hidden name=file_name /></form>");
    	$j('body').append(frm);
    }
    else
    {
    	var url = urlPattern + "?cmd=AttachFileDownloadSvcCmd";
    	url += "&fileSize=" + fileSize;
    	frm[0].action = url;
    }
    
    if($j("#ifr_attach").length == 0){
    	$j('body').append("<IFRAME name='ifr_attach' id='ifr_attach' frameborder=0 height=0 width=0 scrolling=yes />");
    }
    frm.find("[name='IV_OBJKEY']").val(FILEOBJKEY);
    frm.find("[name='file_name']").val(encodeURIComponent(fileName));
    frm.submit();
}


