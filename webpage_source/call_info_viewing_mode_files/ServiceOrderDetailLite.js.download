	}else{
		$j('#tdAirIn').attr('class','ser_td');
		$j('#txtAirIn').hide();
		$j('[name=AIR_INOUT_TYPE]').val("").hide();
		$j('[name=AIR_INOUT_TYPE_VIEW]').hide();
	}
}
//Product Repair Info
function getGasChargeInfo() {
	$('wtyCostCheckForm').action = urlPattern;
	$('wtyCostCheckForm').cmd.value = 'WtyCostCheckCmd';
	$('wtyCostCheckForm').COST_TYPE.value = 'GASCHARGE';
	AjaxRequest(urlPattern, "wtyCostCheckForm", setGasChargeInfo);
}
function setGasChargeInfo(response) {
	try {
		jsonGasCharge = eval('('+response.responseText+')');
		getOtherList();
	} catch (e) {}
}
function getOtherList() {
	$('wtyCostCheckForm').action = urlPattern;
	$('wtyCostCheckForm').cmd.value = 'WtyCostCheckCmd';
	$('wtyCostCheckForm').COST_TYPE.value = 'OTHER';
	AjaxRequest(urlPattern, "wtyCostCheckForm", setOtherList);
}
function setOtherList(response) {
	jsonOther = eval('('+response.responseText+')');
	aryProdGroupII = jsonOther.prodGroupII;
	
	setWtyCostCondition();
}
function setWtyCostCondition() {
	getLaborList2();
	setGasChargeCombo();
    setProdOptField();
    setOtherOptField();

    if(isNewChina){
    	setDistanceCombo();
    }
    
    setWtyObjAttr();
}
function getLaborList2() {
	$('wtyCostCheckForm').action = urlPattern;
	$('wtyCostCheckForm').cmd.value = 'WtyCostCheckCmd';
	$('wtyCostCheckForm').COST_TYPE.value = 'LABOR2';
	
	var params = {};
	params['CICPROD'] = $j("#prod_category").val();
	params['SVCPROD'] = $j("#SVC_PRCD").val();
	
	AjaxSyncRequest(urlPattern + "?" + $j.param(params), "wtyCostCheckForm", setLaborList2);
}
function setLaborList2(response) {
	try {
		jsonLaborCheckList = eval('('+response.responseText+')');
		getProdGroup();
	} catch (e) {}
}
//<%--에어컨안에 여러svc_prod가 있어서, svc_prod에 해당하는 대표prod 코드를 가져옴(Start)--%>
function getProdGroup() {
	$j("#local_svc_prod").val($j("#SVC_PRCD").val());
	$j("#PROD_GROUP").val($j("#SVC_PRCD").val());
	$j("#PROD_GROUP_F").val($j("#SVC_PRCD").val());
	$j("#PROD_GROUP_O").val($j("#SVC_PRCD").val());
	$j("#PROD_GROUP_II").val($j("#SVC_PRCD").val());
	$j("#STS_PROD_GROUP").val( $j("#SVC_PRCD").val().substr(0, 3) );
	
	if ( jsonLaborCheckList.prodMap != null ) {
		if ( jsonLaborCheckList.prodMap.length > 0 ) {
			var len = jsonLaborCheckList.prodMap.length;
			for ( var i = 0 ; i < len ; i++ ) {
				if ( jsonLaborCheckList.prodMap[i].costType == 'LABOR' ) {
					var svcPrcd = $j("#SVC_PRCD").val();
					if(loginUserCorpCode == 'C610') svcPrcd = $j("#prod_category").val();
					if ( jsonLaborCheckList.prodMap[i].svcProd == svcPrcd ) {
						$j("#PROD_GROUP").val(jsonLaborCheckList.prodMap[i].prodGroup);
					}
				}
				if ( jsonLaborCheckList.prodMap[i].costType == 'FREIGHT' ) {
					if ( jsonLaborCheckList.prodMap[i].svcProd == $j("#SVC_PRCD").val() ) {
						$j("#PROD_GROUP_F").val(jsonLaborCheckList.prodMap[i].prodGroup);
					}
				}
				if ( jsonLaborCheckList.prodMap[i].costType == 'OTHER' ) {
					if ( jsonLaborCheckList.prodMap[i].svcProd == $j("#SVC_PRCD").val() ) {
						$j("#PROD_GROUP_O").val(jsonLaborCheckList.prodMap[i].prodGroup);
					}
				}
				if ( jsonLaborCheckList.prodMap[i].costType == 'PROD_GROUP_II' ) {
					var svcPrcd = $j("#SVC_PRCD").val().substr(0, 3);
					if(loginUserCorpCode == 'C610') svcPrcd = $j("#prod_category").val();
					if ( jsonLaborCheckList.prodMap[i].svcProd == svcPrcd ) {
						$j("#PROD_GROUP_II").val(jsonLaborCheckList.prodMap[i].prodGroup);
					}
				}
			}
		}
	}
}
//<%--에어컨안에 여러svc_prod가 있어서, svc_prod에 해당하는 대표prod 코드를 가져옴(End)--%>


//<%-- GasCharge 정보가져오기(Start) --%>
function setGasChargeCombo() {
	
	if ( jsonGasCharge != null ) {
		var svc_prod = $j('#PROD_GROUP_O').val();
		$j('#sel_gas_charge option').remove();

		if ( svc_prod != 'ACG' && svc_prod != 'ACN' ) {
			$j("#trGasCharge").hide();
			return;
		}

		//<%-- SRC36(현장할인):PD이고, SRC36건이 있을경우->거리없음 --%>
		if ( _l.SERVICE_TYPE == 'PD' ) {
			if ( isSRC36 ) {
				$j("#trGasCharge").hide();
				return;
			}
		}

		//<%-- RH이고, RH_OTHER_AMT 의 SUB_CATEGORY 일경우->거리없음 --%>
		if ( _l.SERVICE_TYPE == 'RH' ) {
			if ( jsonOther.rhOtherAmt != null && jsonOther.rhOtherAmt != undefined ) { 
				var len = jsonOther.rhOtherAmt.length;
				for ( var i = 0 ; i < len ; i++ ) {
					if ( $j("#LOC_PRCD").val() == jsonOther.rhOtherAmt[i].codeId ) {
						$j("#trGasCharge").hide();
						$j("#RH_OTHER_AMT").val(jsonOther.rhOtherAmt[i].codeName);
						return;
					}
				}
			}
		}

		//<%--일반(ACG)이고, RepairType이 A13일때, GAS_CHARGE_BYMODEL 목록이 채워진다. --%>
		//<%--A15, B02 추가 (2013.07.11 by yinyu) --%>
		if ( svc_prod == 'ACG' ) {
			if ( _l.IRIS_REPAI == 'A13' || _l.IRIS_REPAI == 'A15' || _l.IRIS_REPAI == 'B02' ) {
				$j("<option></option>").text("- -").attr("value", "").appendTo("#sel_gas_charge");
				var len = jsonGasCharge.gasChargeModel.length;
				for ( var i = 0 ; i < len ; i++ ) {
					if (jsonGasCharge.gasChargeModel[i].codeName == _l.MODEL ) {
						$j("<option></option>").text(jsonGasCharge.gasChargeModel[i].codeName).attr("value", jsonGasCharge.gasChargeModel[i].sapCodeId).appendTo("#sel_gas_charge");						
						$j("#trGasCharge").show();
						break;
					}
				}
			} else {
				$j("#trGasCharge").hide();
				return;
			}
		} 
		//<%--중앙ACN일떄, GAS_CHARGE 목록이 채워진다. --%>
		else if ( svc_prod == 'ACN' ) {
			$j("<option></option>").text("- -").attr("value", "").appendTo("#sel_gas_charge");
			var len = jsonGasCharge.gasCharge.length;
			for ( var i = 0 ; i < len ; i++ ) {
				$j("<option></option>").text(jsonGasCharge.gasCharge[i].codeName).attr("value", jsonGasCharge.gasCharge[i].codeId).appendTo("#sel_gas_charge");
			}
		}
		
		if ( $j('#sel_gas_charge option').size() == 0 ) {
			$j("#trGasCharge").hide();
		} else {
			$j("#sel_gas_charge").val( $j('[name=GAS_CHARGE]').val() );
			$j("#trGasCharge").show();
		}
	}
}
//<%-- GasCharge 정보가져오기(End) --%>
//<%-- 설치옵션세팅(Start) --%>
function setProdOptField() {
	var svc_type = _l.SERVICE_TYPE;
	var local_svc_prod = $j("#SVC_PRCD").val();		//<%--local svc prod --%>
	var svc_prod = $j("#PROD_GROUP").val();			//Labor 대표 코드
	var prodOpt = jsonLaborCheckList.prodOpt;
	var len = prodOpt.length;
	var str = '';
	var str1 = '';
	var isExistProdOpt = false;
	var isExistProdOpt43 = false;
	var isAutoLabor = false;

	for ( var i = 0 ; i < len ; i++ ) {
		
		//<%-- 설치옵션 없이,DefectType고정인 경우  --%>
		if ( prodOpt[i].field02 == "" ) {
			
			//<%-- ServiceType이 ZZZ인 경우, local svc prod만 비교함  --%>
			if ( prodOpt[i].svcType == 'ZZZ' ) {
				if ( prodOpt[i].prodOpt == local_svc_prod ) {
					$j("#LAB_TYPE").val(prodOpt[i].defectType);
					$j("#spanProdOpt").html(prodOpt[i].defectType);
					isAutoLabor = true;
				}
			} else {
				if ( svc_type == prodOpt[i].svcType && prodOpt[i].prodOpt == local_svc_prod ) {
					$j("#LAB_TYPE").val(prodOpt[i].defectType);
					$j("#spanProdOpt").html(prodOpt[i].defectType);
					isAutoLabor = true;
				}
			}
			
		//<%-- 설치옵션 있는 경우(TV:벽걸이 등)  --%>
		} else {
			if ( svc_type == prodOpt[i].svcType && svc_prod == prodOpt[i].svcProd  && (prodOpt[i].prodOpt.indexOf("01") > -1 || prodOpt[i].prodOpt.indexOf("02") > -1 )) {
				str1 += "<input type='radio' name='PROD_OPT' value='" + prodOpt[i].prodOpt + "' def_type='" + prodOpt[i].defectType + "'/>" + prodOpt[i].prodOptName + "&nbsp;&nbsp;&nbsp;";
				//str += "<input type='radio' name='PROD_OPT' value='" + prodOpt[i].prodOpt + "' txt='" + prodOpt[i].prodOptName + "'/>" + prodOpt[i].prodOptName + "&nbsp;&nbsp;&nbsp;";
				isExistProdOpt = true;
				isExistProdOpt43 = true;
			}else if(svc_type == prodOpt[i].svcType && svc_prod == prodOpt[i].svcProd){
				str += "<input type='radio' name='PROD_OPT' value='" + prodOpt[i].prodOpt + "' def_type='" + prodOpt[i].defectType + "'/>" + prodOpt[i].prodOptName + "&nbsp;&nbsp;&nbsp;";
				//str += "<input type='radio' name='PROD_OPT' value='" + prodOpt[i].prodOpt + "' txt='" + prodOpt[i].prodOptName + "'/>" + prodOpt[i].prodOptName + "&nbsp;&nbsp;&nbsp;";
				isExistProdOpt = true;
			}

		}
	}
	
	//<%-- 설치옵션이 있으면, DefectType고정 --%>
	if ( isExistProdOpt ) {
		$j("#spanProdOpt").html(str+"<br>"+str1);
		$j("#trProdOpt").show();
		
		if ( $j('[name=INSTALL_TYPE]').val() == '' ) {
			var sDefaultInstallType = '';
			
			if(loginUserCorpCode == 'C610') {

			} else {
				$j("input:radio[name=PROD_OPT]").eq(0).attr("checked", true);
				$j("input:radio[name=PROD_OPT]").eq(0).trigger("click");
			}
		} else {
			$j("input:radio[name=PROD_OPT]").filter('input:radio[value='+$j('[name=INSTALL_TYPE]').val()+']').attr("checked", true);
			$j("input:radio[name=PROD_OPT]").filter('input:radio[value='+$j('[name=INSTALL_TYPE]').val()+']').trigger("click");
		}
						
	} else {
		if ( isAutoLabor ) {
			
		} else {
			$j("#spanProdOpt").html("");
			$j("#trProdOpt").hide();
			
		}
	}
	
	var group = $j('[name=detailForm] #SVC_PRCD').val().substr(0,3);
	var airType = $j('[name=AIR_INOUT_TYPE]').val();
	if( jQuery.type($j('[name=AIR_INOUT_TYPE]').val()) === 'undefined' ) {
		airType = '';
		} 
	
	
	if($j('#SERVICE_TYPE').val()=='II' && (group=='RAS'||group=='RAO' ||group=='PAC'||group=='PAO' ) && loginUserCorpCode=='C610' ) {
		if ( airType == "I" ) {
			$j("input:radio[name=PROD_OPT]").filter('input:radio[value=ACNIN]').attr("checked", true);
		} else if ( airType == "O" ) {
			$j("input:radio[name=PROD_OPT]").filter('input:radio[value=ACNEX]').attr("checked", true);
		}
		$j("input:radio[name=PROD_OPT]").attr('disabled', true);
	}
	
	if($j('#SERVICE_TYPE').val()=='II' && (group=='RAS'||group=='RAO' ||group=='PAC'||group=='PAO' ) && isNewChina) {
		if ( airType == "I" ) {
			$j("input:radio[name=PROD_OPT]").filter('input:radio[value=ACNIN]').attr("checked", true);
		} else if ( airType == "O" ) {
			$j("input:radio[name=PROD_OPT]").filter('input:radio[value=ACNEX]').attr("checked", true);
		}

	}else if($j('#SERVICE_TYPE').val()=='II' && (group=='SWD'||group=='SWM' ||group=='AUD '||group=='HTS ' ||$j('[name=detailForm] #SVC_PRCD').val()=='ZHA08' ||$j('[name=detailForm] #SVC_PRCD').val()=='ZHA07')){
		$j("input:radio[name=PROD_OPT]").attr('disabled', true);	
		
	}else{
		 if($j('#SERVICE_TYPE').val()=='II'){
		    $j("input:radio[name=PROD_OPT]").attr('disabled', false);	
		 }
	}
	
	if(loginUserCorpCode == 'C610') $j("input:radio[name=PROD_OPT]").attr('disabled', true);
	
	if ( isNewChina ) {
		//TV 벽걸이 설치 재고 수량 조회..
		if ( svc_type == 'II' && ( svc_prod == 'LTV' || svc_prod == 'TV43S' || svc_prod == 'TV43SP')) {
			$j("#text_wmStock").show();
			searchWmStock();
		} else {
			$j("#text_wmStock").hide();
		}
	}
}

function searchWmStock(){
	var formId = 'searchWmStockForm';
	$j("#"+formId).remove();
	var $frm = $j('<form id="'+formId+'" method=post />');
	$frm.append('<input type="hidden" name="cmd" value="ZifGspnInvWmStockStatusCmd"/>');
	$frm.append('<input type="hidden" name="IV_ASC_CODE" value="'+$j('[name=detailForm] [name=ASC_CODE]').val()+'" />');
	$j('body').append($frm);
	
	AjaxRequest(urlPattern,formId, setWmStock);
}
function setWmStock(response){
	var jsonObj = eval('('+response.responseText+')');
	if(jsonObj.eT_STOCK_INFO.length>0){
		var stock_qty = jsonObj.eT_STOCK_INFO[0].stock_qty;
		$j("#txt_wmQty").html(stock_qty);
		$j("#wm_stock_qty").val(stock_qty);
	}else{
		$j("#txt_wmQty").html("0");
		$j("#wm_stock_qty").val("0");
	}
}
function setOtherOptField() {
	var svc_prod = $j('#PROD_GROUP_O').val();
	var svc_type = _l.SERVICE_TYPE;
	var repairCd = _l.IRIS_REPAI;
	
	var otherAry = jsonOther.otherAry;
	var len = otherAry.length;
	var str = "<input type='radio' name='OTHER_OPT' value=''/>" + noValue + "&nbsp;&nbsp;&nbsp;";
	var str1 = "";
	var isExistOtherOpt = false;
	var brTag = '';
	var cnt = 0;
	for ( var i = 0 ; i < len ; i++ ) {
		if ( otherAry[i].svcProd == svc_prod && otherAry[i].svcType == svc_type ) {
			cnt++;
			if ( cnt%2 == 0 ) brTag = '<br>';
			else brTag = '';
			str1 += "<input type='radio' name='OTHER_OPT' title='" + otherAry[i].svcInd + "' value='" + otherAry[i].svcInd + "' />" + otherAry[i].name + "&nbsp;&nbsp;&nbsp;" + brTag;
			isExistOtherOpt = true;
		}
	}
	
	//<%-- 2013.07.23 Added  --%>
	if ( $j('[name=detailForm] #SVC_PRCD').val() == "LED05" && (svc_type == "IH" || svc_type == "PS" || svc_type == "SI") && repairCd == "A06" ) {
		str1 = "<input type='radio' name='OTHER_OPT' value='D1' title='D1' txt='" + led05IND + "'/>" + led05IND + "&nbsp;&nbsp;&nbsp;" + brTag;
		isExistOtherOpt = true;
	}

	if ( isExistOtherOpt ) {
		$j("#spanOtherOpt").html(str + str1);
		$j("#trOtherOpt").show();
		
		if ( ticketGAS_CHARGE == '' ) {
			$j("input[name=OTHER_OPT]").eq(0).attr('checked', true);
		} else {
			$j("input:radio[name=OTHER_OPT]").filter('input:radio[value=' + ticketGAS_CHARGE + ']').attr("checked", "checked");
		}
	} else {
		$j("#spanOtherOpt").html("");
		$j("#trOtherOpt").hide();
	}
	
	//<%--예외로직1--%>
	if ( svc_prod == 'NPC' ) {
		$j("#trIntWty").show();
		$j("input:radio[name=IND_INT_WTY]").filter('input:radio[value='+$j('[name=INTER_WTY_FLAG]').val()+']').attr("checked", true);
	} else {
		$j("#trIntWty").hide();
	}
}
//<%-- Freight-Distance 콤보세팅(Start) --%>
function setDistanceCombo() {
	
	if ( loginUserCorpCode == 'C610' ) {
		$j('#i_distance option').remove();
		$j("#trDistance").hide();
		return;
	}

	//<%--Distance 예외로직--%>
	//<%--KT빼고, IS추가(2013.07.30) --%>
	//<%--IU추가(2013.10.02) --%>
	//<%--CC추가(2016.07.02) --%>
	if ( _l.SERVICE_TYPE == 'CI' || _l.SERVICE_TYPE == 'ER'
			|| _l.SERVICE_TYPE == 'PL' || _l.SERVICE_TYPE == 'PR' || _l.SERVICE_TYPE == 'SC' || _l.SERVICE_TYPE == 'IU'
			|| _l.SERVICE_TYPE == 'CC') {
		$j('#i_distance option').remove();
		$j("#trDistance").hide();
		return;
	}
	
	if(_l.SERVICE_TYPE == 'IS' ){
		$j("#trDistance").hide();	
	}
	
	//<%--KT인경우, TV가 아니면 원거리 없음(2013.07.30) --%>
	if ( _l.SERVICE_TYPE == 'KT' && $j("#PROD_GROUP_F").val() != 'TV' ) {
		$j('#i_distance option').remove();
		$j("#trDistance").hide();
		return;
	}

	//C18090002188 [GSPN]_Request for deleting (samsung Distance) item
	if (C6V0_fieldChekGroup() == 'HHP' && ( _l.SERVICE_TYPE == 'AD' || _l.SERVICE_TYPE == 'BS' ||  _l.SERVICE_TYPE == 'SH')) {
		$j('#i_distance option').remove();
		$j("#trDistance").hide();
		return;
	}
	
	if ( _l.SERVICE_TYPE == 'PS' ) {
		if( $j("#STS_PROD_GROUP").val() != 'REF' && $j("#STS_PROD_GROUP").val() != 'SBS' 
				&& $j("#STS_PROD_GROUP").val() != 'HTV' && $j("#STS_PROD_GROUP").val() != 'LED' 
				&& $j("#STS_PROD_GROUP").val() != 'LTV' && $j("#STS_PROD_GROUP").val() != 'PDP' ) {
			$j('#i_distance option').remove();
			$j("#trDistance").hide();
			return;
		}
	}
	if ( _l.SERVICE_TYPE == 'II' ) {
		//<%-- 설치 && SBS/REF && BCD-4* => REQUEST_SHIP_FEE가 빈값이면, 거리X --%>
		var model = _l.MODEL;
		if ( $j("#SVC_PRCD").val() == 'SBS01' || model.indexOf("BCD-4") >= 0 ) {
//			if ( !auth_request_ship_fee  ) {
				$j('#i_distance option').remove();
					$j("#trDistance").hide();
					return;
//			}
		}
		if ( model.indexOf("BCD-28") >= 0 ) {
			$j('#i_distance option').remove();
			$j("#trDistance").hide();
			return;
		}

	}

	//<%-- SRC36(현장할인):PD이고, SRC36건이 있을경우. --%>
	if ( _l.SERVICE_TYPE == 'PD' ) {
		if ( isSRC36 ) {
			$j('#i_distance option').remove();
			$j("#trDistance").hide();
			return;
		}
	}
	
	//<%-- RH이고, RH_OTHER_AMT 의 SUB_CATEGORY 일경우->거리없음 --%>
	if ( _l.SERVICE_TYPE == 'RH' ) {
		if ( jsonOther.rhOtherAmt != null && jsonOther.rhOtherAmt != undefined ) { 
			var len = jsonOther.rhOtherAmt.length;
			for ( var i = 0 ; i < len ; i++ ) {
				if ( $j("#LOC_PRCD").val() == jsonOther.rhOtherAmt[i].codeId ) {
					$j('#i_distance option').remove();
					$j("#trDistance").hide();
					return;
				}
			}
		}
	}

	//<%-- SW이고, Printer제품이지만, InBound인 경우 ->거리없음 --%>
	if ( _l.SERVICE_TYPE == 'SW' && $j("#PROD_GROUP_F").val() == "PRT" ) { 
		if ( ticketCALL_CATEGORY == 'I' ) {
			$j('#i_distance option').remove();
			$j("#trDistance").hide();
			return;
		}
	}
	//<%--Distance 예외로직--%>
	
	$('wtyCostCheckForm').action = urlPattern;
	$('wtyCostCheckForm').cmd.value = 'WtyCostCheckCmd';
	$('wtyCostCheckForm').COST_TYPE.value = 'FREIGHT';
	
	$('wtyCostCheckForm').SVC_TYPE.value = _l.SERVICE_TYPE;
	$('wtyCostCheckForm').TF_SVC_PROD.value = $j("#SVC_PRCD").val();

	//<%-- Dealer마스터정보의 Dealer유형 먼저체크. 그다음, Consumer Type 체크--%>
	//<%-- DEALER_GUBUN(M:양판점, L:경소상, C:고객)--%>
	if ( $j("#DEALER_TYPE").val() == 'DT02' ) {
		$('wtyCostCheckForm').DEALER_GUBUN.value = 'L' + gsASCType;
	} else  {
		$('wtyCostCheckForm').DEALER_GUBUN.value = 'C' + gsASCType;
	}
	
	if($j("#DEALER_TYPE").val() == 'DT05'){
	   if($j('#storageAddr').val() == '' && 
       ($j('[name=detailForm] #SVC_PRCD').val() == 'SBS01' || $j('[name=detailForm] [name=MODEL]').val().substr(0,5) == 'BCD-4'
    	   || $j('[name=detailForm] #SVC_PRCD').val() == 'SBS02'|| $j('[name=detailForm] #SVC_PRCD').val() == 'SBS03'
    		   || $j('[name=detailForm] #SVC_PRCD').val() == 'SBS04'|| $j('[name=detailForm] #SVC_PRCD').val() == 'REF02'
    			   || $j('[name=detailForm] #SVC_PRCD').val() == 'SKR01')){
		$('wtyCostCheckForm').DEALER_GUBUN.value = 'D';
	   }
	}
	AjaxRequest(urlPattern, "wtyCostCheckForm", setDistance);
}
function setDistance(response) {
	try {
		jsonFreight = eval('('+response.responseText+')');
		$j('#i_distance option').remove();
		$j("<option></option>").text("- -").attr("value", "").appendTo("#i_distance");
		var len = jsonFreight.freightAry.length;
		for ( var i = 0 ; i < len ; i++ ) {
			
			//<%-- 해당제품에, B2B/B2C구분값이 SVC_IND와 같으면 추가하지 않음(2013.07.05)  --%>
			if ( gB2B_B2C == 'B2C' ) {
				if ( jsonFreight.freightAry[i].svcProd == 'TV' && 'L010' == jsonFreight.freightAry[i].svcInd ) {
					continue;
				}
			}
			$j("<option></option>").text(jsonFreight.freightAry[i].distDesc).attr("value", jsonFreight.freightAry[i].svcInd).attr("title", jsonFreight.freightAry[i].svcInd).appendTo("#i_distance");
		}
		if ( len == 0 ) {
			$j("#trDistance").hide();
		}
		else {
			
			//<%-- PD(F/U)인 경우->거리60만 나오게. --%>
			if ( _l.SERVICE_TYPE == 'PD' ) {
				if ( isPD_FU ) {
					$('i_distance').length = 2;
				}
			}

			
			//<%-- 2013.07.11. SI/SR인경우, R15 추가(경소상거리). --%>
			if ( _l.SERVICE_TYPE == 'SI' || _l.SERVICE_TYPE == 'SR' ) {
				$j("#i_distance option:eq(1)").before(gDealerOption);
			}
			
			//<%-- LABOR,LTV인 경우, TVWE이면 원거리항목 안보이게 처리 (2013.09.09) --%>
			var checkedVal = $j("input[name=PROD_OPT]:checked").val();
			if ( $j("#PROD_GROUP").val() == 'LTV' ) {
				if ( checkedVal == 'TVWE' ) {
					$j("#trDistance").hide();
					return;
				}
			}
			$j("#trDistance").show();
			$j('#i_distance').val( $j('[name=DISTANCE]').val() );
			//<%-- LABOR,LTV인 경우, TVWE이면 원거리항목 안보이게 처리 (2013.07.27) --%>
			if ( $j("#PROD_GROUP").val() == 'TV43S' || $j("#PROD_GROUP").val() == 'TV43SP' ) {
				
				if(checkedVal == "TVFL01" || checkedVal == "TVIP01" || checkedVal == "TVR401" || checkedVal == "TVR402" || checkedVal == "TVWE"){
					$j("#trDistance").hide();
					$('i_distance').value = "";
				}else{
					$j("#trDistance").show();
				}
			}
			
			if(isNewChina && _l.REP_TYPE == "IS"){
						if(_l.IRIS_REPAI == 'RR' || _l.IRIS_REPAI == 'RP' || _l.IRIS_REPAI == 'RT'  || _l.IRIS_REPAI == 'RN'  || _l.IRIS_REPAI == 'RD'){
						$j("#trDistance").show();
						$j('#i_distance').val( $j('[name=DISTANCE]').val() );
		               }else{
		            	$('i_distance').value = "";
		            	$j("#trDistance").hide();
		               }
			}

		}
	} catch (e) {}
	
}
//<%-- Freight-SvcInd 콤보세팅(End) --%>
function setWtyObjAttr() {
	
	$j('select option').each(function(index){
		this.title = this.value;
	});
	$j('input[type="radio"]').each(function(index){
		$j(this).attr('title', (this.name == ''?this.id:this.name)+'='+this.value  );
	});
	
	$j("select,input[type='radio']").prop("disabled", true);
}
//VIP
function onlyNumeric(e) {
	var characterCode;
	if(e && e.which) 				//if which property of event object is supported (NN4)
	{
		characterCode = e.which; 	//character code is contained in NN4's which property
	}
	else{
		e = event;
		characterCode = e.keyCode; 	//character code is contained in IE's keyCode property
	}
	if( (characterCode<48 ||characterCode>57) //exclude all characters except numeric
	){
		return false;
	 }
	else{
		return true;
	}
}
