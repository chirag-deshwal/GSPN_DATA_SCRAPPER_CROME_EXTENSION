	$('invoiceForm').submit();
}

//Customer info
function search_related_bp(flag) {
	related_bp_search = false;
	if(flag) related_bp_search = true;
	var bpNo='';
	if(related_bp_search ==false){
		bpNo = $j('#CONSUMER').val();
	}else{
		bpNo = related_bp_no;
	}
	
	var formId='related_bpForm';
	$j("#"+formId).remove();
	var $frm = $j('<form id="'+formId+'" method=post />');
	$frm.append('<input type="hidden" name="cmd" value="SVCPopCustomerDetailCmd" />');
	$frm.append('<input type="hidden" name="BP_NO" value="'+bpNo+'" />');
	$j('body').append($frm);
	
	AjaxRequest(urlPattern+'?BP_ONLY=X', formId, set_related_bp);
}
var related_bp_search = false;
var related_bp_no = '';
function set_related_bp(response) {
	jsonObj = eval('('+response.responseText+')');
	var obj = jsonObj.dataLists;
	if(obj.length > 0){
		var obj = jsonObj.dataLists[0];
		
		if(related_bp_search ==false){
			related_bp_no = obj.RELATED_BP;
			if(related_bp_no !='') search_related_bp(true);
		}else{
			$j("#rel_com").html(obj.NAME_FIRST);
			$j("#rel_addr").html(obj.REGION+' '+obj.CITY+' '+obj.DISTRICT+' '+obj.STREET1+' '+obj.STREET2);
			$j("#rel_phone").html(obj.OFFICE_PHONE);
			$j("#rel_key_man").html(obj.KEY_MAN);
		}
	}
}

function searchDealerStorage(dealer) {
	$j("#dealerSearchForm").remove();
	var $frm = $j('<form id="dealerSearchForm" method=post />');
	$frm.append('<input type="hidden" name="cmd" />');
	$frm.append('<input type="hidden" name="IV_DEALER_CODE"/>');
	$frm.append('<input type="hidden" name="IV_STORAGE" id=IV_STORAGE />');
	$j('body').append($frm);
	
	
	$j("#dealerSearchForm [name=IV_DEALER_CODE]").val(dealer);
	$('dealerSearchForm').cmd.value = 'ZifGspnBpStorageInfoCmd';
	AjaxRequest(urlPattern, "dealerSearchForm", setDealerStorage);
}

function setDealerStorage(response) {
	$j("#storageInfo").html("");
	$j("#storageAddr").val("");
	$j("#storageZipcode").val("");
	
	jsonObj = eval('('+response.responseText+')');
	var obj = jsonObj.eT_STORAGE_INFO;
	if(obj.length > 0){
		var obj = jsonObj.eT_STORAGE_INFO[0];
		var strName = obj.storage_name;
		var strAddr = obj.state_name+' '+obj.city+' '+obj.colony+' '+obj.street;
		$j("#storageInfo").html('['+strName+'] ('+obj.zipcode+') '+strAddr);
		$j("#storageAddr").val(strAddr);
		$j("#storageZipcode").val(obj.zipcode);
		if($j('#SERVICE_TYPE').val()=='IS') $j("#storageInfo").hide();
	}
}

function searchDealerDetail(dealer) {
	$j("#dealerSearchForm").remove();
	var $frm = $j('<form id="dealerSearchForm" method=post />');
	$frm.append('<input type="hidden" name="cmd" />');
	$frm.append('<input type="hidden" name="IV_DEALER_CODE"/>');
	$j('body').append($frm);
	
	$j("#dealerSearchForm [name=IV_DEALER_CODE]").val(dealer);
	$('dealerSearchForm').cmd.value = 'zifGspnBpDealerInfoCmd';
	AjaxRequest(urlPattern, "dealerSearchForm", setDealerDetail);
}

function setDealerDetail(response) {
	$j("#DEALER_TYPE").val('');
	$j("#DEALER_NAME").html('');
	$j("#DEALER_TEL_NO").html('');
	
	jsonObj = eval('('+response.responseText+')');
	var obj = jsonObj.eT_DEALER_INFO;
	if(obj.length > 0){
		var obj = jsonObj.eT_DEALER_INFO[0];
		$j("#DEALER_TYPE").val(obj.dealer_type);
		$j("#DEALER_NAME").html(obj.dealer_name);
		$j("#DEALER_TEL_NO").html(obj.tel_no);
	}
}

