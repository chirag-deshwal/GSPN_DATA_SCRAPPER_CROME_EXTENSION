		url += "&model=" + _l.MODEL;
		url += "&svc_type=SR";
		url += "&CODE_VALUE=" + svcTypeReason;
		
		$j.get(url, function(json){
			if(json.success){
				$j("#ServiceTypeReasonDesc").text(json.CODE_TEXT);				
			}//if(json.success){
