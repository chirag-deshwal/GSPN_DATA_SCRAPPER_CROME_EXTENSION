function loadHhpExchData(){
// 	Saw list에서 신규모델정보를 로드한 후에 작업한다.
	loadSawHhpNewModel(setSawHhpNewModelForLoad);
}
//HHP교환 SAW승인된건의 saw no불러와서 sawlist조회후 신모델정보 가져옴 
//newModelHhpExch 에 저장 
function loadSawHhpNewModel(afterFun){
	
	var sawNo = hhpExchApprovalSawNo;		
	var $form = $j('#frm');
	var orderNo = _l.ObjectId;
	var ascCode = _l.ASC_CODE;
	
	$form.empty();
	$j("<input type='hidden' name='cmd'/>").val("SawStatusListCmd").appendTo($form);
	
	AjaxRequest(urlPattern+'?isawNo='+sawNo+'&ascCode='+ascCode
			+'&objectID='+orderNo,'frm', afterFun);
	$('progressloading').startWaiting();
	
}
function setSawHhpNewModelForLoad(response){
	try{
		var jsonObj = eval('('+response.responseText+')');
		var length = jsonObj.etSawInfo.length;
		var i = 0;
		var idx = 0;
		
		if(length > 0){
			for(i=0; i<length; i++){
				//승인 상태일 경우
				if(jsonObj.etSawInfo[i].STATUS == "SS010" && jsonObj.etSawInfo[i].REQ_CATEGORY == "SRC54"){
					idx = i;
				}
			}
			
			newModelHhpExch = jsonObj.etSawInfo[idx].EXCH_MODEL;
			newModelHhpExchAccessory  = jsonObj.etSawInfo[idx].HHP_ACCESSORY_STS;
			if(newModelHhpExchAccessory == "ALL"){
				$j("#tdAccesory").each(function(){this.style.display = ''});
				$j("#tdAccesory").show();
			}
			newPro_Comp = jsonObj.etSawInfo[idx].PRO_COMP;
			loadDOAModelList(setHhpExchModel);
		}
	
	}catch(e){
		alert(e);
	}finally{
		$('progressloading').stopWaiting();
	}
}
function loadDOADefect() {	
	loadDOAModelList(setDOAModelCompany);
}

function loadDOAModelList(afterFunction) {	
	var $form = $j('#frm');
	var modelNo ="";
		
	if(newModelHhpExch==""){
		modelNo = $j('form[name="detailForm"] [name="MODEL"]').val();
	}else{	//다차수리일 경우 최종 승인된 새로운 모델코드
		modelNo = newModelHhpExch;
	}
	
	$form.empty();
	$j("<input type='hidden' name='cmd'/>").val("ZcseDoarfRbModelListCmd").appendTo($form);
	
	AjaxRequest(urlPattern+'?PI_FLAG=M&MATNR='+modelNo,'frm', afterFunction);
	$('progressloading').startWaiting();
}
