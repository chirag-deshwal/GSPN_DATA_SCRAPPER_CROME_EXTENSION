	function setIRISInfo(){

		var url = urlPatternGZIP+"?cmd=GetIRISGroupCmd";
		$j.get(url, function(jsonObj){
	
			if (jsonObj.success) {
				var codeGroup = "";
				var codeValue = "";
				var length = jsonObj.codeGroup.length;
				//IRIS-C,IRIS-S,IRIS-D,IRIS-R
				//EIA-D,EIA-R
				//NSAM-C,NSAM-S,NSAM-D,NSAM-R
				for (var i = 0; i < length; i++) {
					var tmp = jsonObj.codeGroup[i].code_group;
					if (tmp.indexOf("-C") > 0 && _l.IRIS_CONDI != ""){
						codeGroup += "," + tmp;
						codeValue += "," + _l.IRIS_CONDI;
					}else if(tmp.indexOf("-D") > 0 && _l.IRIS_DEFEC != ""){
						codeGroup += "," + tmp;
						codeValue += "," + _l.IRIS_DEFEC;
					}else if(tmp.indexOf("-R") > 0 && _l.IRIS_REPAI != ""){
						codeGroup += "," + tmp;
						codeValue += "," + _l.IRIS_REPAI;
					}else if(tmp.indexOf("-S") > 0 && _l.IRIS_SYMPT != ""){
						codeGroup += "," + tmp;
						codeValue += "," + _l.IRIS_SYMPT;
					}
				}
				
				if("C310" == _l.u.c){//does not use defect block, condition, symptom
				}else{
					if(_l.DEF_BLK != ""){
					codeGroup += ",DEFECT_BLOCK";
					codeValue += "," + _l.DEF_BLK;
					}
					if(_l.SVC_INDICATOR != ""){
						codeGroup += ",SVC_IND";
						codeValue += "," + _l.SVC_INDICATOR;
					}
				}
				
				if(codeGroup.length < 2){return;}
				codeGroup = codeGroup.substr(1);
				if(codeValue.length < 2){return;}
				codeValue = codeValue.substr(1);

		
				//isIrisFiltering
				var url = urlPatternGZIP+"?cmd=GetIRISInfoCmd";
				url += "&model=" + _l.MODEL;
				url += "&ctype=" + codeGroup;
				url += "&code=" + codeValue;
				
				$j.get(url, function(jsonObj){
					if (jsonObj.success) {
						var length = jsonObj.dataLists.length;
						for (var i = 0; i < length; i++) {
							var obj = jsonObj.dataLists[i];
							var ctype = obj.ctype;							
							if ( ctype.indexOf('-C') > 0 ) {
								if(obj.code == _l.IRIS_CONDI){
									$j("#IRIS_CONDI_DESC").text(obj.codetx);
								}
							} else if ( ctype.indexOf('-D') > 0 ) {
								if(obj.code == _l.IRIS_DEFEC){
									$j("#IRIS_DEFECT_DESC").text(obj.codetx);
									if(_l.isUseGcicIris && ctype == 'EIA-D'){
										$j("#IRIS_DEFECT_QCODE_DESC").text("("+obj.qcode+"-"+obj.qcodetx+") ");
									}
								}
							} else if ( ctype.indexOf('-S') > 0 ) {
								if(obj.code == _l.IRIS_SYMPT){
									$j("#IRIS_SYMPT_DESC").text(obj.codetx);
									if(_l.isUseGcicIris){
										$j("#IRIS_SYMPT_QCODE_DESC").text("("+obj.qcode+"-"+obj.qcodetx+") ");
									}
								}
							} else if ( ctype.indexOf('-R') > 0 ) {
								if(obj.code == _l.IRIS_REPAI){
									$j("#IRIS_REPAIR_DESC").text(obj.codetx);
									if(_l.isUseGcicIris){
										$j("#IRIS_REPAIR_QCODE_DESC").text("("+obj.qcode+"-"+obj.qcodetx+") ");
									}
								}
							} else if ( ctype == 'DEFECT_BLOCK' || ctype.indexOf('-B') > 0) {
								if(obj.code == _l.DEF_BLK){
									$j("#DEF_BLK_DESC").text(obj.codetx);
								}
							} else {
								$j("#SVC_INDICATOR_DESC").text(obj.codetx);
							}							
						}//for (var i = 0; i < length; i++) {						
					}//if (jsonObj.success) {					
				}, 'json');//$j.get(url, function(jsonObj){
				
			}//if (jsonObj.success) {					
		}, 'json');//$j.get(url, function(jsonObj){		
	}
	setIRISInfo();
	
