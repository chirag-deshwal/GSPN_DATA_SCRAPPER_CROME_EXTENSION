	$j("#btnCreatePO").click(function(){
		var parts = _l.parts;
		var partLen = parts.length;
		var serviceDate = _l.LAST_APP_DATE;
		var objectId = _l.ObjectId;		
		var partQuery = addPartInfoForPO(false, parts, objectId, serviceDate);			
		
		
		if(partQuery == "") {			
			if(	partLen == 0){
					alert("Please enter the part at first!"); 
					return;
			}else{				
					if(_l.u.c == "C310"){
							if(  !confirm("There is parts already ordered. Make sure that it is DOA parts.\n\nDo you want to order it anyway?")   ){
								return;
							}else{
								partQuery = addPartInfoForPO(true, parts, objectId, serviceDate);
							}
					}else{
							alert(_l.r.m.EXT_0039); 
							return;	
					}//if(loginUserCorpCode == "C310"){
			}//if(	partLen == 0){
		}
		
		var url = '/order/po/POVerify.jsp';			
		if (isDistyASC()){
			url = '/disty/purchase/purchaseOrderCreate.jsp'
		}		
		url += "?referer=SO";
		url += partQuery;
		
		var w = window.open(url, "po_popup","toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=0,left=200,width=1000,height=700");
		w.focus();
		
		
		function addPartInfoForPO(skipSoNo, parts, objectId, serviceDate){
			var partQuery = "";
			
			for(var i=0; i<partLen; i++){
				var obj = parts[i];
				var valid = (obj.SEQ_NO != "" && obj.PARTS_CODE != "");
				if(!skipSoNo){
					valid = (valid && obj.SO_NO == "");
				}
				
				if(valid){
					partQuery += "&poRefNo=" + objectId;
					partQuery += "&poSvcPartSeqNo=" + obj.SEQ_NO;
					partQuery += "&poPart=" + obj.PARTS_CODE;
					partQuery += "&poQty=" + obj.PARTS_QTY;
					partQuery += "&poSvcDate=" + serviceDate;
					partQuery += "&poPartWty=" + obj.IN_OUT_WTY;	//for europe medison distributor
				}
			}//for(var i=0; i<partLen; i++){
			return partQuery;
		}//function addPartInfoForPO(skipSoNo, obj){
		function isDistyASC() {
			var belongsToDisty = ("C810,C850".indexOf(_l.u.c) != -1);
			var belongsToCOSMOS = _l.u.COSMOSUser;
			return belongsToDisty && belongsToCOSMOS;
		}//function isDistyASC() {
		
	});//$j("#btnCreatePO").click(function(){
	
	if(isChinaRegion){
		
		loadAscProfile();
		
		if ( _l.ASC_JOB_NO.substring(0,1) == "B" ) {
			gB2B_B2C = "B2B";
		}
		
		if(isRepairOrder == false){
			$j('#trRepairPartInfo').hide();
			$j('#trProdRepInfo').hide();
			$j('#trBillingInfo').hide();
		}
					
		$j('[type=text],[type=checkbox],select,textarea ').each(function(index){
			$j(this).attr('title',this.name == ''?this.id:this.name);
		});
		$j('select option').each(function(index){
			this.title = this.value;
		});
		$j("input[type=text]").attr("readonly","readonly");
		$j("input[type=text][readonly]").keydown(function(e){
			if(e.which == 8){//back space뒤로 가기방지
				return false;
			}
		});
		
		//Customer info
		if($j('#BP_TYPE_CD').val()==""){//b2b contact person 
			$j('#div_related_bp').show();
			search_related_bp();
		}

		if($j('#END_CUSTOMER').val()!="" || ($j('#BP_TYPE_CD').val()=="B003" || $j('#BP_TYPE_CD').val()=="") ){
			$j('#i_cust_tbl').show();
		}
		
		if($j('#BP_TYPE_CD').val()=="B003" || $j('#BP_TYPE_CD').val()==""){
			$j('#spanCheckSameB2b').show();
			if("ST035;ST040".indexOf(_l.CurrStatus) > -1 && $j('#END_CUSTOMER').val()==''){
				$j('#checkSameB2b').attr('checked','checked');
				$j('#i_cust_tbl').hide();
			}
		}
			
		if($j('#DEALER').val()!=""){
			$j('#dealerDtlBtn').show();	
			searchDealerStorage($j('#DEALER').val());
			searchDealerDetail($j('#DEALER').val());
