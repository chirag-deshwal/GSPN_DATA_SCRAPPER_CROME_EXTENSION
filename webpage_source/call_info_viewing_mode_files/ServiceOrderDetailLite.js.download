//		if(isNpcExchFlag != true) $j("#doaForm [name=COLOR]").val(jsonObj.pT_OUTPUT[0].color);
		
		$j("#doaInspectTab [name=COLOR]").val(jsonObj.pT_OUTPUT[0].color);
		
