/**
 * button onclick
 */
function goList(){
	try{parent.setBackForward();}catch(e){}//jsonTemp

	if(_l.jspName=="/report/kpi/QualityOfService.jsp"){
		var formObj=$('tempForm');
		formObj.action='/report/kpi/QualityOfService.jsp?frYear =' + _l.FrYear + '&frMonth=' +_l.FrMonth + '&toYear=' + _l.ToYear + '&toMonth=' + _l.ToMonth;
		formObj.target='_self';
		formObj.submit();
	}else if(_l.jspName=="/svctracking/svcorder/ServiceOrderListBatch.jsp"){
			var formObj=$('tempForm');
			formObj.action='/svctracking/svcorder/ServiceOrderListBatch.jsp';
			formObj.target='_self';
			formObj.submit();
	}else if(_l.jspName=="/saw/SawStatus.jsp"){
		var formObj=$('tempForm');
		formObj.action='/saw/SawStatus.jsp';
		formObj.target='_self';
		formObj.submit();
	// prebooking list 20181107 sena0605.cho Start
	}else if(_l.jspName=="/svctracking/svcorder/PreBookingListCN.jsp"){ //Prebooking List(CN)
		var formObj=$('tempForm');
		formObj.action='/svctracking/svcorder/PreBookingListCN.jsp';
		formObj.target='_self';
		formObj.submit();
	// prebooking list 20181107 sena0605.cho End
	// 온라인 서비스 Post Office IF 20181107 sena0605.cho Start
	}else if(_l.jspName=="/svctracking/postofficeif/PostOfficeIFListCN.jsp"){ // Post Office IF List
		var formObj=$('tempForm');
		formObj.action='/svctracking/postofficeif/PostOfficeIFListCN.jsp';
		formObj.target='_self';
		formObj.submit();
	//bh1130.park 태국 - Post Office IF List
	}else if(_l.jspName=="/svctracking/postofficeif/PostOfficeIFListTSE.jsp"){ 
		var formObj=$('tempForm');
		formObj.action='/svctracking/postofficeif/PostOfficeIFListTSE.jsp';
		formObj.target='_self';
		formObj.submit();
	// 온라인 서비스 Post Office IF 20181107 sena0605.cho End
	}else {
		var formObj=$('tempForm');
		formObj.action='/svctracking/lite/ServiceOrderListLite.jsp';
		formObj.target='_self';
		formObj.submit();
	}
	
}

