/*
1. IT :  앞세자리가  CLP  MLP PRT TFB HSB MMC RAM SSD
2. HA :  앞세자리가  MWO  DWM  PAC REF  REG RES SEW SRA SRB SAL CAC DVM FJM SAC 
3. HHP:  앞세자리가  THB , 
4. VD :  앞세자리가  PJM PPM  DVD HMT SST CAM BPV BTV CTV PDP PTV LCD-TV  
5. DSC:  앞세자리가  DSC, DVC
 */
function C6V0_fieldChekGroup() {
	var group = $j('[name=detailForm] #SVC_PRCD').val().substr(0,3);
	//IT
	if(group=='CLP'||group=='FAX'||group=='LFD'||group=='LPF'||group=='MFP'||group=='MLP'||group=='MON'||group=='NPC'||group=='OLM'
		||group=='PDM'||group=='PRT'||group=='SDT'||group=='TFT'||group=='TFB'||group=='HSB'||group=='MMC'||group=='RAM'){
		return "IT";
	}
	//HA
	else if(group=='MWO'||group=='DWM'||group=='PAC'||group=='REF'||group=='REG'||group=='RES'||group=='SEW'||group=='SRA'||group=='SRB'
		||group=='SAL'||group=='CAC'||group=='DVM'||group=='FJM'||group=='SAC'){
		return "HA";
	}
	//HHP
	else if(group=='THB'){
		return "HHP";
	}
	//VD
	else if(group=='PJM'||group=='PPM'||group=='DVD'||group=='HMT'||group=='SST'||group=='CAM'||group=='BPV'||group=='BTV'||group=='CTV'
		||group=='PDP'||group=='PTV'||group=='LCD'){
		return "VD";
	}
	//DSC
	else if(group=='DSC'||group=='DVC'){
		return "DSC";
	}
}

function C6V0_fieldView() {
	if(!isNewChina) return;
	// hide Restore..
	fieldViewGroupHA(false);
	fieldViewGroupVD(false);
	fieldViewGroupHHP(false);

	var group = C6V0_fieldChekGroup();
	if(group == "HA") fieldViewGroupHA(true);
	else if(group == "VD") fieldViewGroupVD(true);
	else if(group == "HHP") fieldViewGroupHHP(true);
	
}
function fieldViewGroupHA(flag) {
	if(flag){
		$j('#txt_imei').hide();
		$j('#IMEI').hide();
		$j('#trNewFirm').hide();
		$j('#trNewModel').hide();

	}else{
		$j('#txt_imei').show();
		$j('#IMEI').show();
		$j('#trNewFirm').show();
		$j('#trNewModel').show();
	}
}
function fieldViewGroupVD(flag) {
	var localProduct = $j('#LOC_PRCD').val();
	var cicProduct = $j('#CIC_PRCD').val();
	if(flag){
		$j('#trNewFirm').hide();
		$j('#trNewModel').hide();

		if((localProduct == "VDE_LED" || localProduct == "VDE_PDP") && (cicProduct == "VDE")){
			$j('#trNewFirm').show();
		}
			
	}else{
		$j('#trNewFirm').show();
		$j('#trNewModel').show();
	}
}
function fieldViewGroupHHP(flag) {
	if(flag){
		$j('#txt_serial2').hide();
		$j('[name="SERIAL_NO2"]').hide();
	}else{
		$j('#txt_serial2').show();
		$j('[name="SERIAL_NO2"]').show();
	}
}
function viewAIR_INOUT_TYPE() {
	if(_l.SERVICE_TYPE=='II' && $j('[name=detailForm] #prod_category').val()=='ACN'/*ACN*/) {
		$j('#tdAirIn').attr('class','ser_ti');
		$j('#txtAirIn').show();
		$j('[name=AIR_INOUT_TYPE]').show();
