function loadExchData(){
	var $form = $j('#frm');
	var orderNo = _l.ObjectId;
	
	$form.empty();
	$j("<input type='hidden' name='cmd'/>").val("ZifGspnSvcExchDetailCmd").appendTo($form);
	$j("<input type='hidden' name='motoObjectId'/>").val(motoObjectId).appendTo($form);
	$j("<input type='hidden' name='ORI_PUR_AMT'/>").val(ORI_PUR_AMT).appendTo($form);
	$j("<input type='hidden' name='ORI_EX_STATUS'/>").val(ORI_EX_STATUS).appendTo($form);
	
	AjaxRequest(urlPattern+'?IV_OBJECT_ID='+orderNo,'frm', setExchData);
	$('progressloading').startWaiting();
}

function setExchData(response){
	$('progressloading').stopWaiting();
	var jsonData = response.responseText.evalJSON();
	if (jsonData.error) {
		cfExceptionPop(jsonData);
	}	

	refreshExchList(jsonData.ES_EXCH_INFO);
	refreshGR_INFO(jsonData.ES_PROD_INFO);
	refreshGI_INFO(jsonData.ES_PROD_INFO);
	refreshSEND_INFO(jsonData.ET_PROOF_INFO, jsonData.ES_PROD_INFO);
}
function refreshExchList(EXCH_INFO){
	var tbodyObj = $('exchTableBody');

	var fieldArray=[
		"DETAIL_TYPE",	//처리방안
		"EXCH_MODEL",	//교환모델
		"COMPANY_PAYMENT",//삼성 실지불비
		"DEPR_AMO",	//감가상각비용
		"STATUS"		//상태
	];
	
	var trTag = $j("<tr/>");
	var tdTag = null;
	for(var i=0; i<fieldArray.length; i++){
		var key = fieldArray[i];
		var content = EXCH_INFO[key];//+'&nbsp;';
		var style = "td_ac";
		tdTag = $j('<td title="'+key+'" class="'+style+'"/>');
		if(key =='DETAIL_TYPE'){
			$j('#DETAIL_TYPE').val(content);
			content = $j('#DETAIL_TYPE option:selected').text();
		}else if(key == 'COMPANY_PAYMENT' || key == 'DEPR_AMO'){
			style = "td_ar";
		}else if(key == 'STATUS'){
			for (var j=0; j<codeNegotiationStatus.length; j++) {
				if (codeNegotiationStatus[j]['codeId'] == content) {
					var stockIn = content;
					var stockIn_nm = codeNegotiationStatus[j]['codeName'];
					content = $j('<span>'+ stockIn_nm +'</span>');
					tdTag.append(content);
					content = $j('<input type="hidden" name="NEGOTIATION_STATUS" value="'+ stockIn +'">');
					tdTag.append(content);
					content = $j('<input type="hidden" name="NEGOTIATION_STATUS_DESC" value="'+ stockIn_nm +'">');
					break;
				}
			}
		}else if(key == 'EXCH_MODEL'){
			
			var exModel = content;
			var exNegoTd = EXCH_INFO['EX_NEGO'];
			content = $j('<span>'+ content +'</span>');
			tdTag.append(content);
			content = $j('<input type="hidden" name="' + 'EXCH_MODEL' +'" value="'+ exModel +'">');
			tdTag.append(content);
			content = $j('<input type="hidden" name="' + 'EX_NEGO_TD' +'" value="'+ exNegoTd +'">');
		}
		
		tdTag.append(content);
		trTag.append(tdTag);
	}
	$j(tbodyObj).html(trTag);

	
}

function refreshGR_INFO(GR_INFO){
	var tbodyObj = $('grInfoTableBody');

	var fieldArray=[
	"MODEL",
	"SERIAL_NO",
	"SERIAL_NO2",
	"NEW_MODEL",
	"NEW_SERIAL_NO",
	"NEW_SERIAL_NO2",
	"PARTS_PLBM_YN",
	"APPEAR_PLBM_YN",
	"PARTS_PLMB_DESC",
	"REMARK2",
	"DELAY_REASON_DESC"
	];
	
	var trTag = $j("<tr/>");
	var tdTag = null;
	for ( var i = 0; i < fieldArray.length; i++) {
		var key = fieldArray[i];
		var content = GR_INFO[key];//+'&nbsp;';
		var style = "td_ac";
		tdTag = $j('<td title="'+key+'" class="'+style+'"/>');
		if(key == 'MODEL'){
			var temp = $j('<input type="hidden" name="' + 'MODEL_TD' +'" value="'+ content +'">');
			tdTag.append(temp);
			content = $j('<span>'+ content +'</span>');
		}else if(key == 'SERIAL_NO'){
			var temp = $j('<input type="hidden" name="' + 'SERIAL_NO_TD' +'" value="'+ content +'">');
			tdTag.append(temp);
			content = $j('<span>'+ content +'</span>');		
		}			
		tdTag.append(content);
		trTag.append(tdTag);
	}
	$j(tbodyObj).html(trTag);
	
}

