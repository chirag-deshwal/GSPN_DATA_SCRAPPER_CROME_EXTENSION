	function openSendDocumentInvPop(){
		var url = "";
		w = window
				.open(
						url,
						"rrr_popup",
						'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=250,left=300,width=650,height=280');
		w.focus();
		var formObj = $('detailForm');
		formObj.action =  urlPatternGZIP+'?pageType=DetailInvPage';
		formObj.cmd.value = 'ServiceOrderSendDocumentCmd';
		formObj.target = 'rrr_popup';
		formObj.submit();
		
	}
	
	function openCustomerInvoiceDetailPop(){
		var url = urlPatternGZIP+"?";
		url += "&cmd=TaxInvoicePrintCmd";
		url += "&objectID=" + _l.ObjectId;
		if(_l.u.c == "C570"){
			url += "&forward_page=TaxInvoicePrint_sein.jsp";//SEIN
		}else if(loginUserCorpCode == "C720" || loginUserCorpCode == "C701"){
			url += "&forward_page=TaxInvoicePrint_SSA.jsp";
		}
		
		w = window.open(url,"CustomerInvoicePop",'width=800,height=730,top=50,left=200,toolbar=no,location=no,directories=no,status=yes,menubar=yes,resizable=yes,copyhistory=no,scrollbars=yes');
		w.focus();
	}
	
