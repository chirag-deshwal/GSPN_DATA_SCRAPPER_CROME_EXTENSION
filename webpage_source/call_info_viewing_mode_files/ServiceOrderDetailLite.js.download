function refreshSEND_INFO(SEND_INFO, SEND_PROD_INFO){
	var tbodyObj = $j('#sendInfoTableBody');
	tbodyObj.children().remove();
	/*
	택배회사	택배전화	택배번호	자료수	내용	발송일자	삼성도착일자	삼성반송일자	상태	사유
	*/
	var fieldArray=[
	"SEND_COURIER",
	"SEND_TEL_NO",
	"SEND_DOC_NO",
	"SEND_DOC_CNT",
	"SEND_REMARK",
	"ASC_SEND_DATE",
	"DELIVERED_DATE", //삼성도착일자
	"RETURN_DATE",  //삼성반송일자
	"STATUS_DESC",  //상태
	"CONFIRM_REMARK" // 사유
	];
	
	var idx = 0;
	var seq = 0;
	var length = SEND_INFO.length;
	if(SEND_INFO.length==0) SEND_INFO[0]=new Object();
	for ( var ix = 0; ix < SEND_INFO.length; ix++) {
		var trTag = $j("<tr/>");
		var tdTag = null;
		var aTag = null;
		var temp = "";
		var content = "";
		for ( var i = 0; i < fieldArray.length; i++) {
			
			var key = fieldArray[i];
			var style = "td_ac";
			tdTag = $j('<td title="'+key+'" class="'+style+'"/>');
			if(length != 0) {
				content = SEND_INFO[ix][key];
				temp = content;
				//content, hidden
				if(key == 'SEND_DOC_NO'){
					if("" != content){
						
						tdTag.append(content);
					}
				} else if (key == 'STATUS_DESC'){
					if("" != content){
						for (var j=0; j<codeExchangeConfirm.length; j++) {
							if (codeExchangeConfirm[j]['codeId'] == SEND_INFO[ix]['STATUS']) {
								temp = codeExchangeConfirm[j]['codeName'];
								break;
							}
						}

						tdTag.append(temp);
					}
				} else {
					if(key == 'SEND_COURIER'){
						content = $j('<input type="hidden" name="' + 'SEQ' +'" value="'+ SEND_INFO[ix]['SEQ'] +'">');
						tdTag.append(content);
					} else if (key == 'CONFIRM_REMARK'){
						var short = getStrCuts(temp, 5);
						content = $j('<input type="hidden" name="' + 'CONFIRM_REMARK_LONG' +'" value="'+ temp +'">');
						tdTag.append(content);
						content = $j('<input type="hidden" name="' + 'CONFIRM_DATE' +'" value="'+ SEND_INFO[ix]['CONFIRM_DATE'] +'">');
						tdTag.append(content);
						if(short != "") temp = short + "....";
					}
					content = $j('<span>'+ temp +'</span>');
					tdTag.append(content);
				}
			}
			
			content = $j('<input type="hidden" name="' + key +'" value="'+ temp +'">');
			tdTag.append(content);
			trTag.append(tdTag);
		}
		$j(tbodyObj).append(trTag);
	}
	

}

function getStrCuts(str, max) {//25자이상글자자르기
    ns = str.substr(0, max);
    if (ns.length != str.length) {
        ns = ns + "";
    }
    return ns;
}

function loadExchNote(){
	
	var $form = $j('#frm');
	var orderNo = _l.ObjectId;
	
	$form.empty();
	$j("<input type='hidden' name='cmd'/>").val("ZifGspnSvcExchNoteCmd").appendTo($form);
	$j("<input type='hidden' name='motoObjectId'/>").val(motoObjectId).appendTo($form);
	$j("<input type='hidden' name='ORI_PUR_AMT'/>").val(ORI_PUR_AMT).appendTo($form);
	$j("<input type='hidden' name='ORI_EX_STATUS'/>").val(ORI_EX_STATUS).appendTo($form);
	
	AjaxRequest(urlPattern+'?IV_OBJECT_ID='+orderNo,'frm', setExchNote);
	$('progressloading').startWaiting();	
}
function setExchNote(response){
	$('progressloading').stopWaiting();
	var jsonData = response.responseText.evalJSON();
	if (!jsonData.success) {
		if (jsonData.error) {
			cfExceptionPop(jsonData);
		}else alert(jsonData.returnMessage);
    }

	refreshExchNote(jsonData.ES_GR_INFO);
}

function refreshExchNote(ES_GR_INFO){
	$j('#tbodyExchNote').children().remove();
	var tbodyObj = $('tbodyExchNote');

	var fieldArray=[
		"GRPLANT",	//입고처
		"PLANT_MGR",	//창고담당
		"MGR_TEL_NO",//전화번호
		"GR_ADDR",	//창고 상세 주소
		"REGIST_DT", 	//등록일
		"REGIST_BY_NAME",	//등록자
		"Print"	//Print
	];
	
	var trTag = $j("<tr/>");
	var tdTag = null;
	for(var i=0; i<fieldArray.length; i++){
		var key = fieldArray[i];
		var content = ES_GR_INFO[key];//+'&nbsp;';
		var style = "td_ac";
		tdTag = $j('<td title="'+key+'" class="'+style+'"/>');
		if(key=='Print'){
			content = "";
		} else if(key=='GRPLANT'){
			for (var j=0; j<codeAccountName.length; j++) {
				if (codeAccountName[j]['codeId'] == content) {
					var stockIn = content;
					var stockIn_nm = codeAccountName[j]['codeName'];
					content = $j('<span>'+ stockIn_nm +'</span>');
					tdTag.append(content);
					content = $j('<input type="hidden" name="GRPLANT" value="'+ stockIn +'">');
					tdTag.append(content);
					content = $j('<input type="hidden" name="GRPLANT_NM" value="'+ stockIn_nm +'">');
					break;
				}
			}
		} else if(key == 'REGIST_DT'){
			var registDt = content;
			content = $j('<span>'+ registDt +'</span>');
			tdTag.append(content);
			content = $j('<input type="hidden" name="REGIST_DT" value="'+ registDt +'">');
		} else if(key == 'REGIST_BY_NAME'){
			var name = content;
			if("" == name){
				content = ES_GR_INFO['REGIST_BY'];
			}
		}
			
		tdTag.append(content);
		trTag.append(tdTag);
	}
	$j(tbodyObj).html(trTag);
}

