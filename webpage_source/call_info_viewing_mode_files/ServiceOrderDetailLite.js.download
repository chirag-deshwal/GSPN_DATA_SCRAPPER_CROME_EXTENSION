function initDoaData(){
	//SW건중 HHP교환 SAW승인이 있는것은 HHP교환(RETUN)으로 처리
	//Other건은 DOA/DAP로 처리
	if(isHhpExchApprovalFlag){
		$j('#doaInspectTab').hide();
		$j('#doaGiTab').show();
		
		loadHhpExchData();  //HHP 교환			
	
	}else{
