function exchTabControl(){
	
	if( (isRepairOrder && $j("#SERVICE_TYPE").val()=='PD') || isCompensation ) {
		$j('#exchCouncel,#exchDetail,#exchGrGi').hide();
		$j('#exchProof').show();
	}
	else if(!isRepairOrder)
		$j('#exchCouncel,#exchDetail,#exchGrGi,#exchProof').show();
	else if(isRepairOrder)
		$j('#exchCouncel,#exchDetail,#exchGrGi,#exchProof').hide();
	
	if(isCompensation && isExchange){
		$j('#trProdRepInfo').show();// 교환 환불일 경우
	}
	if(isQQUser){
		$j('#trProdRepInfo').show();// QQ Logic
	}	
	
	initExchData();
}
