$j(function(){
	var _l = window._l;

	if ((_l.u.c == 'C310' || _l.u.c == 'C370') && _l.SVC_LEVEL == "BUILD") { // Builder 
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0589);
	}
	
	function setStatusDisplay(){return;
			var currStatus = _l.CurrStatus;
			if(currStatus == "ST015"){ //ack
					moreOpenid(1); moreOpenid(3); moreOpenid(4); moreOpenid(5);
			}else if(currStatus == "ST025"){ //assign
					moreOpenid(3); moreOpenid(4);
			}else if(currStatus == "ST030"){ //pending
					moreOpenid(4); moreOpenid(5);
			}else if("ST033;ST050;ST051;ST052;ST070;ST040".indexOf(currStatus) >= 0){ //decline, cancel, trans other%>
					moreOpenid(4); moreOpenid(5);
			}else if(currStatus == "ST035"){ //completed
					if(_l.isWtyClaimed){ 
						moreOpenid(4);
					}else{ 
						moreOpenid(4); moreOpenid(7);
	
						if(isEaUser){ 
							$("freeDeliveryTable").show();
						}
						if(_l.billingFlag){
							moreOpenid(14);
				  		}
					}
			}else if(currStatus == "ST040"){ //delivered
					moreOpenid(4); moreOpenid(7); moreOpenid(14);
			}
	
			if(_l.partslength > 0) {
					moreOpenid(10);
			}
			if(_l.isBillingSaved){ 
					moreOpenid(14);
			}
	
			if(_l.sawlength > 0) {
					moreOpenid(13);
			}
			if(_l.filelength > 0) {
				moreOpenid(8); 
			}
	
			var serviceType = _l.SERVICE_TYPE;
			if(serviceType == "PS")
				moreOpenid(6);
	
			if(_l.displayRepairScenario){
					moreOpenid(16);
			}
	
			if(_l.displayRepairHistory){
					moreOpenid(15);
			}

			
	}
	openAllDiv();
	//setStatusDisplay();
	
	
	 //collection point in general information
	function getCPList(){
		var ccCode = $j("#CC_CODE").text();
		if(ccCode == "" || ccCode.length != 10) return;
		var url = urlPatternGZIP+"?";
		url += 'cmd=CollectPntListCmd&IV_F4_FLAG=X&assignedFlag=X&shopCode='+ccCode;
		
		$j.get(url, function(jsonObj){
			if (jsonObj.success && jsonObj.etCCInfoList.length > 0) {			
				var cp = jsonObj.etCCInfoList[0];
				$j('span #CC_CODE_NAME').text(cp.SHOP_NAME)
			}				
		}, 'json');
	}//function getCPList(){
	//china version intergration 2016/08/03 js1.baek
	if(!isChinaRegion) getCPList();	
	
	 //state/region only for C310
	function getCodeListRegion(){
		var CountryCd = _l.u.CountryCd;				
		if(CountryCd == "" || CountryCd.length != 2) return;
		
		var regionCode = $j("#REGION_CODE").text();
		if(regionCode == "" || regionCode.lenth < 2 ) return;
		
		var url = urlPatternGZIP+"?";
		url += 'cmd=CICCodeSearchCmd&CODE_GROUP=REGION&UPPER_GROUP=COUNTRY&UPPER_VALUE='+CountryCd;
		url += '&CODE_VALUE=' + regionCode;
		
		$j.get(url, function(jsonObj){
	
			if (jsonObj.success) {
				$j("#REGION_NAME").text(jsonObj.CODE_TEXT);				
			}//if (jsonObj.success) {			
			
		}, 'json');
	}//function getCPList(){
	getCodeListRegion();
	
	//managed svc 정보 import 2016.02.22 jiw
	function getManagedSvc(){
	 	if(_l.SERIAL_NO == ""){
			//alert("Please input the Serial no for getting managed svc info.");
			return;
		}
		if(_l.MODEL == ""){
			//alert("Please input the Model code for getting managed svc info.");
			return;
		}
		var url = urlPatternGZIP+"?";
		url += 'cmd=ZifGspnSvcGetManagedSvcCmd&SERIAL_NO='+ _l.SERIAL_NO +'&MODEL='+_l.MODEL;
		$j.get(url, function(jsonObj){
			if(jsonObj.success){
				$("MANAGED_SVC_CODE").value = jsonObj.topCode;
				var managedSvcDesc = "";
				for(var i=0; i<jsonObj.etSlaDataList.length; i++){
					if(i==0){
						managedSvcDesc = jsonObj.etSlaDataList[i].CONTRACT_DESC;
					}else{
						managedSvcDesc = managedSvcDesc + ", " + jsonObj.etSlaDataList[i].CONTRACT_DESC;
					}
				}
				$("MANAGED_SVC_DESC").value = managedSvcDesc;
			}else{
				//alert(jsonObj.returnMessage);
				$("MANAGED_SVC_CODE").value = "";
				$("MANAGED_SVC_DESC").value = "";
			}			
		}, 'json');
	}
	//china version intergration 2016/08/03 js1.baek
	if(!isChinaRegion) getManagedSvc();	
	
