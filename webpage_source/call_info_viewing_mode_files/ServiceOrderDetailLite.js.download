		//job info
		if(isRepairOrder == false ){
			$j('#trSvcType').hide();
		}
		
		//Product Repair Info
		if(isNewChina){
			$j('#tdIrisDef1').hide();
			$j('#tdIrisDef2').hide();
		}
		$j("#spanSamsungDist").hide();
		
		getGasChargeInfo();//WtyCostCheckCmd
		
		//VIP
		if($j('#STATUS').val() >= 'ST035'){
			$j('#img_vipCardSearch').hide();
		}
		//교환환불
		if(exchVisible) exchTabControl();//initExchData
		
		//doa dap
		if(doaVisible || accVisible) doaTabControl();//initDoaData		
		
	}//if(isChinaRegion){
	
	function setModuleId(){
		var ppidPrdCodeList = _l.r.c.PPID_PRD_CODE_LIST.evalJSON();
		var isPPIDList = false;
		var hqSvcProd = $('HQ_SVC_PRCD').value;
		for(var i=0; i<ppidPrdCodeList.length; i++){
			if(hqSvcProd == ppidPrdCodeList[i].codeId){
				isPPIDList = true;
				break;
			}
		}
		
		if(isPPIDList){
			$("divModuleId").style.display='';
		}
	}
	setModuleId();
	
