function TextAreaValidation(obj, maxlen) {
    var len = obj.value.length;
    var count = 0;
    var one_ch = "";
    var maxsize = 0;
    var wchar = false;
    for (i = 0; i < len ; i++) {
       one_ch = obj.value.charAt(i);
        if (escape(one_ch).length > 4) {
            count = count + 2;   // 2byte
            wchar = true;
        } else {
            count = count + 1;   // 1byte
        }
    }

    maxsize = Math.floor(maxlen/2);
    if (count > maxlen) {
        alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0662 + maxlen + _l.r.m.EXT_0663);
        if (wchar) {
       obj.value = obj.value.substr(0, maxsize);
      } else {
       obj.value = obj.value.substr(0, maxlen);
      }
      obj.select();
      return false;
   }
} 
function onChangeUnitReceivedDate(){
	var obj = $("UNIT_RECV_DATE");
	var objDesc = _l.r.m.MAND_INPUT_00898;
	var SERVICE_TYPE = $("SERVICE_TYPE").value;
	if(_l.u.c =="C550" && (SERVICE_TYPE == "CI" || SERVICE_TYPE == "PS")){
		var creationBefore5Date = _l.CREATE_DATE_5;
		if( !checkFromToDate(creationBefore5Date, obj.value, _l.u.DateFormat2)){
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_DATE + objDesc+"[" + obj.value + "] : It can be up to five days before Created Date."); 
// moreOpenid(5);
			obj.focus();
			obj.value='';
			return false;
		}
	}
	if( !checkDateIsCorrectAndNotFuther(obj, objDesc) ){
		obj.focus();
		obj.value='';
		return false;
	}
	if(_l.u.c.substring(0,2) == "C8" && SERVICE_TYPE == "PS"){
		var creationDateToCheck = _l.creationDateToCheck;
		if( !checkFromToDate(creationDateToCheck, obj.value,_l.u.DateFormat2) ){
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_DATE + objDesc+"[" + obj.value + "] : It cannot be selected before Created Date."); 
// moreOpenid(5);
			obj.focus();
			obj.value='';
			return false;
		}
	}
	if( _l.u.c == "C330" && !checkDateIs30DaysPast(obj, objDesc) ){
		obj.focus();
		obj.value='';
		return false;
	}

}


function setModelVersion(jsonObject,idx){
	var jsonObjC = jsonObject;

	/** Select 박스 ID */
	var selectObj = $j("#VERSION");

	/** 전체옵션을 맨 상단에 위치 시킨다. */
	selectObj.empty();// 초기화
	//PAICC-3527 SO 화면 오픈시 모델버전을 취득해서 모델을 변경할수 있도록 변경(버전정보 유무에 상관없이 초기 옵션 none)
	//if (!jsonObjC.success){
		selectObj.append("<option value=''>- - - -");
	//}

	var length = jsonObjC.etModelVersionList.length;
	if (jsonObjC.success) {var cnt=0;
		var modelCd=jsonObjC.etModelInfoList[idx].model; var tmpCd='';
		for (var i=0; i < length; i++) {
			var verInfo = jsonObjC.etModelVersionList[i];
			if(modelCd!=verInfo.model) continue;
			cnt++;
			selectObj.append("<option value='" + verInfo.version + "'>" + verInfo.version);
		}
		//if(cnt==0){
		//	selectObj.append("<option value=''>- None -");
		//}
		// version set!!
		setComboValue(selectObj[0], MODELVERSION_inBPInfo);
	}
}

function setModelVersion310(jsonObject, idx) {
	var jsonObjC = jsonObject;

	/** Select 박스 ID */
	var selectObj = $("VERSION");

	/** 초기화 */
	selectObj.length = 0;
	$j('#VERSION').removeAttr('disabled');
	$('VERSION').className="input";

	var noneOption = document.createElement('option');	
	noneOption.appendChild(document.createTextNode("- None -"));
	noneOption.setAttribute("value", '');
	

	if (jsonObjC.success) {
		// var cnt = 0;
		var modelCd = jsonObjC.etModelInfoList[idx].model;

		var length = jsonObjC.etModelVersionList.length;
		if(length == 0) {
			selectObj.appendChild(noneOption);
			return;
		} 
		var firstOption = document.createElement('option');	
		firstOption.appendChild(document.createTextNode("- Select -"));
		firstOption.setAttribute("value", '');
		selectObj.appendChild(firstOption);

		for (var i=0; i < length; i++) {
			var verInfo = jsonObjC.etModelVersionList[i];
			var objOption = document.createElement('option');	
			objOption.appendChild(document.createTextNode(verInfo.version));
			objOption.setAttribute("value", verInfo.version);
			
			if (modelCd != verInfo.model) {
				selectObj.appendChild(objOption);
				continue;

			}



			if (verInfo.version == _l.modelVersion) {
				$j("#VERSION").empty();
				objOption.setAttribute("selected", true);
				selectObj.appendChild(objOption);
				$("VERSION").className="inputRO";
				return;
			} else {
				selectObj.appendChild(objOption);
			} 
		}

	} else {
		selectObj.appendChild(noneOption);
	} 
}

function allowToEditTheDate(dateTag){
	
	// =================================================================================//
	// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
	// Activation
	// 수정일 : 2015.08.05
	// 수정자 : 채보람 (로젠 솔루션)
	// 내 용 : 인도일 경우 Purchase Date를 수정 못하게 함.
	if((_l.isIndia || _l.isBangladesh || _l.isSrilanka || _l.isNepal) && isProdHHPIndia()){
		return;
	}
	// =================================================================================//
	
	dateTag.readOnly = "";
	dateTag.className = "input";
	dateTag.onClick=showCal(dateTag);
}	

