}

function clickCloseFeedback() {
	$j('#divFeedbackInfo').hide();
	$j('#divBlock').hide();
}

function saveFeedbackProactive(){
	$('progressloading').startWaiting();
	
	var lenSuccessYn = $j("[name=partsRecommendationSuccessYn]").size();
	
	for ( var i = 0 ; i < lenSuccessYn ; i++ ) {
		var radioName = $j(".c_partsRecommendationSuccessYn").eq(i).attr('name');
		var tempPartsRecommendationSuccessYn = $j(":input:radio[name=" + radioName + "]:checked").val();
		
		if ( tempPartsRecommendationSuccessYn == 'Y' ) {
			$j("[name=partsRecommendationSuccessYn]").eq(i).val(tempPartsRecommendationSuccessYn);
		}else if(tempPartsRecommendationSuccessYn == 'N' ){
			if($j("[name=partsRecommendationReason]").eq(i).val() == ""){
				alert("Please select reason for Fail.");
				return;
			}else{
				$j("[name=partsRecommendationSuccessYn]").eq(i).val(tempPartsRecommendationSuccessYn);
			}
		}else{
			$j("[name=partsRecommendationSuccessYn]").eq(i).val("");
		}
		$j("select[name=partsRecommendationReason]").eq(i).attr('disabled',false);
	}
	
	var ftcVal = $j("[name=firstTimeCompletionSuccessYn]").val();
	if(ftcVal != ""){
		if($j("[name=firstTimeCompletionReason]").val() == ""){
			alert("Please select reason for FTC.");
			return;
		}
	}
	
	$('feedbackForm').cmd.value = 'SaveFeedbackToProactiveCmd';
	AjaxRequest(urlPatternGZIP, "feedbackForm", callbackSaveFeedbackToProactive);
	
}
function callbackSaveFeedbackToProactive(response) {
    try {
    	var jsonObjSaveFeedbackResult = eval('('+response.responseText+')');
		if (jsonObjSaveFeedbackResult.success && jsonObjSaveFeedbackResult.result !='fail'){
			alert("Feedback saved successfully.");
		}else{
			alert("errors occured when feedback saving.");
		}
	} catch (e) {}
	
	callDetail();
	
    $('progressloading').stopWaiting();
}

function setPartsRecommendationSuccessYn(obj, index){
	$j("select[name=partsRecommendationReason]").eq(index).val("");
	if(obj.value == "Y" || obj.value == ""){
		$j("select[name=partsRecommendationReason]").eq(index).attr('disabled',true);
	}else{
		$j("select[name=partsRecommendationReason]").eq(index).attr('disabled',false);
	}
}
function openHassDiagSearch() {
	if ($('detailForm').SERIAL_NO.value == '') {
		alert(_l.u.WEB_MSG_PREFIX + 'SERIAL_NO needs!');
		return;
	}
	var url = "";
	w = window
			.open(
					url,
					"hass_popup",
					'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=250');
	w.focus();

	var formObj = $('tempForm');
	$('model_p').value = $("detailForm").MODEL.value;
	$('ASC_CODE_p').value = $("detailForm").ASC_CODE.value;
	$('serialNo_p').value = $('detailForm').SERIAL_NO.value;
	formObj.action = '/svctracking/common/SVCPopHassDiagSearch.jsp';
	formObj.target = 'hass_popup';
	formObj.submit();
}
function openHassDiagSearchOnDiv() {
	$('progressloading').startWaiting();
	clearForm("frm");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_ASC_CODE", _l.ASC_CODE);
	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId);
	insertValue("frm", "IV_MODEL", $j("#MODEL").val());
	insertValue("frm", "IV_SERIAL_NO", $j("#SERIAL_NO").val());
	insertValue("frm", "IV_LANG", _l.u.SapLanguage);
	
	insertValue("frm", "cmd", "ZifGspnSvcHassDiagSearchCmd");
	AjaxSyncRequest(urlPattern,'frm', setHassDiagSearchResult);
}

function setHassDiagSearchResult(response) {
	$('progressloading').stopWaiting();
    try {
		var jsonObjHassDiagSearchResult = eval('('+response.responseText+')');

		if (jsonObjHassDiagSearchResult.success){
			
			/** TBody 객체 ID */
			var tbodyObj = $('tbodyHassDiagSearch');
			/** 이전 Grid 객체에 노드가 있는 경우 새로 갱신하기 위해 삭제한다. */
			clearGridJsonObject(tbodyObj);
			var obj = jsonObjHassDiagSearchResult;
			
			var $tr	= $j("<tr></tr>");
			$tr.append($j("<td class='td_ac'>" + obj.EV_COMPATIBLILITY + "</td>"));
			$tr.append($j("<td class='td_ac'>" + obj.EV_EXECUTION + "</td>"));
			$tr.append($j("<td class='td_ac'>" + obj.EV_DIAG_RESULT + "</td>"));
			$tr.append($j("<td class='td_ac'>" + obj.EV_OQC_RESULT + "</td>"));
			$j('#tbodyHassDiagSearch').append($tr);
			
			$j('#divHassDiagSearch').css('left', $j(window).width()/2-325);
			$j('#divBlock').show();
			$j('#divHassDiagSearch').show();
    	} else {
    		alert(jsonObjHassDiagSearchResult.RET_MSG);
    	}

	} catch (e) {}  
	$('progressloading').stopWaiting();
}

function clickCloseHassCheckDiv() {
	$j('#divHassDiagSearch').hide();
	$j('#divBlock').hide();
}

function limitSvcGrade() {
	var svcGrade = $('svcGrade').value;	
	
	var options = $j('#svcGrade option');
	for ( var i = 0; i < options.length; i++) {
		var option = options[i];
		var optionValue = option.value;
		if (optionValue == "OOW1" || optionValue == "OOW2"
			|| svcGrade == "OOW1" || svcGrade == "OOW2") {
			option.disabled = true;
		}
	}
	
}

