function isAscJobNoOptional() {
	var isSubsidiarySeca = _l.u.c == 'C330';
	var isServiceTypeCIorPS = $('SERVICE_TYPE').value != '' && 'CI|PS'.indexOf($('SERVICE_TYPE').value) != -1;
	var isStatusAcknowledged = $('STATUS').value == 'ST015';
	var isReasonWaitingForProduct = $('REASON').value == 'HA010';
	return isSubsidiarySeca && isServiceTypeCIorPS && isStatusAcknowledged && isReasonWaitingForProduct;
}

