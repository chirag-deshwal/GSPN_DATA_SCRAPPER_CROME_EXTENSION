//내  용 : OTP Check Popup 호출
function otpCheckPop(){
	if(_l.mobile_phone == "" && _l.TR_TYPE == "I"){
		alert(_l.u.WEB_MSG_PREFIX + "Mobile Number is not Exist. Please Change Customer Information.");
		return;
	}
	
	var url = "";
	
	w = window.open(url, "ServiceOrderOtpPopup", 'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=300,width=550,height=300');
	w.focus();
	
	clearForm("frm");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_PARTNER", $j("#CONSUMER").val());
	insertValue("frm", "MOBILE_PHONE", _l.mobile_phone);
	insertValue("frm", "OBJECTID", _l.ObjectId);
	insertValue("frm", "IV_MODEL", _l.MODEL);
	insertValue("frm", "DATAORIGIN", _l.TR_TYPE);
	insertValue("frm", "countOTP", _l.countOTP);

	var obj = $('frm');
	obj.action = "/svctracking/lite/ServiceOrderOtpPopup.jsp";
	obj.method = 'post';
	obj.target = 'ServiceOrderOtpPopup';
	obj.submit();
}

//call direct SVCPopCustomerSearchCmd for not bpSearchUsed [[
function searchDirectSAQR() {
	if($j('[name=SAQR]').val()==''){ 
		alert(_l.u.WEB_MSG_PREFIX + 'Please input Samsung Account QR');
		return;
	}
	$('progressloading').startWaiting();

	clearForm("frm");
    insertValue("frm", "cmd", "SVCPopCustomerSearchCmd");
    insertValue("frm", "IV_COMPANY", "<%=userVO.getCicCorpCode()%>");
    insertValue("frm", "IV_COUNTRY", "<%=userVO.getCountryCd()%>");
    insertValue("frm", "IV_C_CHANNEL", "QG");
    insertValue("frm", "IV_SA_QR", $('SAQR').value);
	
	AjaxRequest(urlPattern, "frm", setCustomerJsonObject);
}

function setCustomerJsonObject(response) {
	try {
		jsonObj = eval('('+response.responseText+')');
		if (jsonObj.success) {
			setCustomerInfoBySAQR(jsonObj);
		} else {
			if (jsonObj.error) {
                cfExceptionPop(jsonObj);
            }
            alert(_l.u.SAP_MSG_PREFIX+jsonObj.retmsg);
			$j('#SAQR').val('');
            $j('#SAQR').focus();
            $('progressloading').stopWaiting();
		}
		$('progressloading').stopWaiting();
	} catch (e) {
		$('progressloading').stopWaiting();
		alert(_l.u.WEB_MSG_PREFIX + e);
	}
}

function setCustomerInfoBySAQR(jsonObjDtl){
	if($("d_CUSTNAME") != null && $("d_CUSTNAME") != undefined) {
		$('d_CUSTNAME').innerHTML = _l.bpTypeDesc;
	}
    if($("CONTACT_FLAG") != null && $("CONTACT_FLAG") != undefined) {
    	$('CONTACT_FLAG').value = jsonObjDtl.dataLists[0].CONTACT_FLAG;
    }
    $('NAME_FIRST').value = jsonObjDtl.dataLists[0].NAME_FIRST;
    $('NAME_LAST').value =  jsonObjDtl.dataLists[0].NAME_LAST;
    $('CONSUMER').value =  jsonObjDtl.dataLists[0].CONSUMER;
    $('HOMEPHON_NUMBER').value = jsonObjDtl.dataLists[0].HOME_PHONE;
    $('MOBILE_NUMBER').value = jsonObjDtl.dataLists[0].MOBILE_PHONE;
    $('OFFICEPHON_NUM').value = jsonObjDtl.dataLists[0].OFFICE_PHONE;
    $('EMAIL').value = jsonObjDtl.dataLists[0].EMAIL;
    $('POST_CODE').value = jsonObjDtl.dataLists[0].POST_CODE;
    $('REGION').value = jsonObjDtl.dataLists[0].REGION_CODE;
    $('STREET').value = jsonObjDtl.dataLists[0].STREET1;
	$('STREET3').value = jsonObjDtl.dataLists[0].STREET3;
	$('STREET2').value = jsonObjDtl.dataLists[0].STREET2;
	$('DISTRICT').value = jsonObjDtl.dataLists[0].DISTRICT; 
    $('CITY').value = jsonObjDtl.dataLists[0].CITY; 
}
