	//중국안탐.
	if (statusCode == "ST") {
		if (!validatePRTCheckSerialNo())
			return;
	}
	function validatePRTCheckSerialNo() {
		var url = urlPatternGZIP;
		var data = "cmd=ZcsbCicCheckSerialNoCmd&MODEL=" + modelInfo + "&ASC_CODE="
				+ _l.ASC_CODE + "&SERIAL_NO=" + $j("#SERIAL_NO").val()+ "&GUBUN=A";
		var isValid = true;
		$j.ajax({
			type : "POST",
			async : false, /* 동기 */
			url : url,
			data : data,
			success : function(data) {
				if (data.success) {
					isValid = true;
				} else {
					if ($('attachTableBody').rows.length < 1) {
						alert(_l.u.WEB_MSG_PREFIX + "Attachment is required.");
						isValid = false;
					}
				}

			},
			dataType : 'json'
		});
		return isValid;
	}
	//중국 안탐, CHECK_CORE_PARTS 없어서 checkCoreParts 항상 거짓임. 
	if(_l.checkCoreParts){
		if(statusCode == "ST035" && hasPart && statusCode != currStatus){
