		dataType : 'json'
	});
	return returnCode;
	// return true;
}

function getVanId() {
	 
 	if(_l.u.c != "C550")
	{
 		return;
	}
 	
	var url = urlPatternGZIP;

	var data = "cmd=ZifGspnSryVanMappingCmd&IV_COMPANY=" + _l.u.c + "&IV_ASC_CODE="+_l.ASC_CODE;

	$j.ajax({
		type : "POST",
		async : false, /* 동기 */
		url : url,
		data : data,
		success : function(data) {
			if (data.success) {
				if(data.EtList != null && data.EtList.length > 0){
					$('vanIdTr').style.display = '';
					// 데이터 넣기
					var objSelect = $('VANID');
					var objOption;
					for(var z =0 ; z < data.EtList.length; z++){
						if(data.EtList[z].STATUS == "I"){
							continue;
						}
						objOption = document.createElement('option');
						objOption.appendChild(document.createTextNode(data.EtList[z].VANID));
						objOption.setAttribute("value", data.EtList[z].VANID);
						
						objSelect.appendChild(objOption);
					}
					
					objSelect.value = _l.vanId;
				}else {
					// 숨김
					$('vanIdTr').style.display = 'none';
				}
			} else {
				$('vanIdTr').style.display = 'none';
			}
		},
		dataType : 'json'
	});
}

function changeVANID(){
	if($("DISTANCE") != null && $("DISTANCE") != undefined){
		var obj = $("VANID");
		if(obj.value != "" && obj.value != "NOT_REQUIRED"){
			$("DISTANCE").value = 0;
			$("DISTANCE").disabled = true;
		}else{
			$("DISTANCE").disabled = false;
		}
	}
}

function validateVanId(){
	
 	if(_l.u.c != "C550")
	{
 		return true;
	}
 	
 	
	if($("vanIdTr") != null && $("vanIdTr") != undefined && $("vanIdTr").style.display == ""){
		if(
				"IH;DM;II;SR;BS;CI".indexOf($("SERVICE_TYPE").value) > -1
				&& "ST015;ST025;ST030;ST035;ST040".indexOf($("STATUS").value) > -1
				&& $('VANID').value == ""
		)
		{
			alert(_l.u.WEB_MSG_PREFIX + "Please choose the VAN use option from the drop down menu");
			return false;
		}
	}
	return true;
}

/**
 * India Demand. 2017/03/30. j.peter.kim
 * check SAW for India
 * check Gas Charging (SIEL) : SRC80/ Panel water logged (SIEL) : SRC81
 */
function checkSAWForIndia() {

    // check Gas Charging A/C (SIEL)
    if (checkGasChargeTicketAC()) {
        if (!_l.isSawExistGasChargeApproved) {
            alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0596);
            return false;
        }
    }
    
    // check Gas Charging REF (SIEL)
    if (checkGasChargeTicketRef()) {
        if (!_l.isSawExistGasChargeApproved) {
            alert(_l.u.WEB_MSG_PREFIX + "Please raise SAW Approval {Ref Gas charging} for RC.");
            return false;
        }
    }

    // check Panel water logged (SIEL)
    if (checkPanelWaterLoggedTicket()) {
        if (!_l.isSawExistPanelWaterLogApproved) {
            alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0597);
            return false;
        }
    }
    
    return true;
}


/**
 * India Demand GCR Reduction. 2017/03/30. j.peter.kim
 * check ticket must have approved SAW (Gas Charging (SIEL), SRC80)
 * Condition : 
 *   - service brach : true
 *   - next status : Repair Complete
 *   - product : Air Conditioner
 *   - In/Out Warranty : 'LP'
 *   - Service Type in ["SR", "IH", "PS"]
 *   - GAS Charge : Gas Charge seleted
 *   - parts length : 1, location is not empty, part no is empty
 */
function checkGasChargeTicketAC() {

    // service branch
/*    if (!_l.isSawGasChargeServiceBranch) {
        return false;
    }*/

    // next status is ST035 (Repair Completed)
    if ("ST035" != $j('#STATUS').val()) {
        return false;
    }

    // CIC Product is Air Conditioner
    //if ("ACN" != _l.CIC_PRCD) {
    if("A/C02|A/C08".indexOf($j("#SVC_PRCD").val()) == -1) {
        return false;
    }

    // in warranty
    if ("LP" != $j('#wtyInOut').val()) {
        return false;
    }

    // service type in ["SR", "IH", "PS"]
    var svcTypeArray = ["SR", "IH", "PS"];
    if ($j.inArray($j('#SERVICE_TYPE').val(), svcTypeArray) == -1) {
        return false;
    }

    // gas charge selected added by C21030000532
    if("2" == $j('#GAS_CHARGE').val() || "13" == $j('#GAS_CHARGE').val()){
    	
    }else{
        return false;
    }
    

    // part code
    var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
    var locations = $j("#partsTableBody input[name='REPAIR_LOC']");

/*    var compressorPartsCodes = "UR8D165JHDEHSI,UR8D165JHDEH,UR8C124JTAELSI,UR8C110DNEELTS,UR8BK5170DESSI,UR8BH8170DESSI,UR8B180JHDEH," + 
    							"UR8B180DUBEHTS,UR8B180DUBEHSI,UR8B170DNBESTS,UR8B170DNBESSI,UR5AJ8165DENSI,UR5A250JHHENSS,UR5A250JHDEMSS," + 
    							"UR5A250JHDEMSI,UR5A250JHDEM,UR5A215DNCEMTS,UR5A215DNCEMSI,UR5A165JTBENSI,UR4D124DXEELTS,UR4D124DXEELSS," + 
    							"UR4D124DXEELSI,UR4D124DXEEL,UR4D115DNCELTS,UG9TK3150FE4TS,UG9TK3150FE4SI,UG9AJ3090FERTS,UG9AJ1090FERTS," + 
    							"UG9A090FUBEPSS,UG9A090FUAERTS,UG9A090FUAER,UG4T200FUAE4TS,UG4T200FUAE4,UG4T150LNBEQTS,UG4T150LNBEQ," + 
    							"DB95-05610A,DB95-05609A,DB95-05464A,DB59-00026A,DB59-00025A,55A180JTAEN-SI";
    
    	if(partCodes.length >= 1){
    	    for (var i=0 ; i < partCodes.length ; i++) {
    	        var partCode = $j.trim($j(partCodes[i]).val());
    	        if (compressorPartsCodes.indexOf(partCode) != -1 && !partCode.blank()) {
    	        	checkTarget = false;
    	            break;
    	        }
    	    }
        }*/

    var checkTarget = true;
    var compressorACPartsCodes = _l.r.c.COMP_AC_PARTS_CODE.evalJSON();
	if(partCodes.length >= 1){
		loop1:
		for(var i=0 ; i < partCodes.length ; i++) {
			var partCode = $j.trim($j(partCodes[i]).val());
			var location = $j.trim($j(locations[i]).val());
			if(!partCode.blank()){
				loop2:
				for(var j=0 ; j < compressorACPartsCodes.length ; j++){
					if(partCode == compressorACPartsCodes[j].codeId || location == "COMP"){
						checkTarget = false;
						break loop1;
					}
				}
			}
		}
	}
    
    if (!checkTarget) {
        return false;
    }

    return true;

}


