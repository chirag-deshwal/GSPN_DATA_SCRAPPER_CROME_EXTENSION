function addParts(type, partCode, partQty) {
	
	if (checkWarranty) {
        alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0079);
		return;
	}
	
	if(!(_l.u.isChinaRegion || isMedisonUser)){
		if(_l.isDreamModel){
			$j("#OLD_PARTS_SEQ_NO,#OLD_SHIP_DATE,#OLD_SERIAL_MAT").removeAttr("disabled");
			$j("#OLD_PARTS_SN_CHK,#newPartsFront").css("display","inline");
		}else{
			$j("#OLD_PARTS_SEQ_NO,#OLD_SHIP_DATE,#OLD_SERIAL_MAT").attr("disabled", "disabled");
			$j("#OLD_PARTS_SN_CHK,#newPartsFront").css("display","none");
		}
	}
	
	var serviceType = $("SERVICE_TYPE").value;
	
	//china : 중국과 글로벌이 자재입력 가능한 서비스 타입 조건이 서로 다름.
	var svcTypeCanNotInsertPart = (serviceType == "SH");
	if(_l.u.isChinaRegion){
		var svcProd = $("HQ_SVC_PRCD").value;
		//svcTypeCanNotInsertPart = (serviceType == "SH" || serviceType == "II" || serviceType == "PD" ||  (serviceType == "SW" && !(svcProd == "LTV99" || svcProd == "SSD01")));
		// 2017.11.09 C6V0 &serviceType == "II"일때 건조기 제품의 설치 서비스 타입에 한하여 자재    Insert 가능하게 설정 
		svcTypeCanNotInsertPart = (serviceType == "SH" || serviceType == "PD" ||  (serviceType == "SW" && !(svcProd == "LTV99" || svcProd == "SSD01")) || 
				(serviceType == "II" && !(svcProd == "HTS01" || svcProd == "HTS02" || svcProd =="HTS03"||svcProd == "SWD01" || svcProd == "REF01" || svcProd == "REF02" || $("SVC_PRCD").value == "LED03" || $("SVC_PRCD").value == "LED04" || $("SVC_PRCD").value == "LED05" || $("SVC_PRCD").value == "LED06")));
	}
	
	var ppidPrdCodeList = _l.r.c.PPID_PRD_CODE_LIST.evalJSON();
	var isPPIDList = false;
	var hqSvcProd = $('HQ_SVC_PRCD').value;
	for(var i=0; i<ppidPrdCodeList.length; i++){
		if(hqSvcProd == ppidPrdCodeList[i].codeId){
			isPPIDList = true;
			break;
		}
	}
	
	if (svcTypeCanNotInsertPart && !isPPIDList) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0164);
	} else if((serviceType == "BM") && (("C710" == _l.u.c && ("PK" == _l.u.CountryCd || "IR" == _l.u.CountryCd)) || "C711" == _l.u.c || "C712" == _l.u.c || "C713" == _l.u.c || "C750" == _l.u.c || "C770" == _l.u.c || "C780" == _l.u.c)) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0164);
	} else {

		//china : 중국에는 아래 변수가 있어, 저장후 화면 리프레시 하도록 하지만, 글로벌에서는 이변수 없이 무조건 갱신하므로 이관안함.
		//haveToReload = true;
		
		var tbodyObj = $('partsTableBody');
		var length = tbodyObj.rows.length;
		
		if("C310" == _l.u.c && length == 0 && $j('input#CIC_PRCD').val() == 'REF'){
			checkIceMakerIrKit();
		}
		
		var bodyTemplate = new Template($("partInsertTemplate").innerHTML);

		var obj = {
				rowIdx : length,
				partCode : "0201-000280",
				partQty : "1"				
			};
		var partItem = $j(bodyTemplate.evaluate(obj));


		if (!thisStatusCanSearchSalesOrder()) {
			partItem.find("img[name='imgSearchPO']").hide();
		}

		if(partCode != undefined){
			partItem.find("input[name='PARTS_CODE']").val(partCode);
		}
		if(partQty != undefined){
			partItem.find("input[name='PARTS_QTY']").val(partQty);
		}
		//if.C370 SERIAL_MAT Value = IRIS_REPAIR value로 세팅 requested by SEA 정상천 과장
/*		if(_l.u.c == "C370"){			
			partItem.find("input[name='SERIAL_MAT']")
			.val($j("#detailForm").find("#IRIS_REPAIR").val());
		}*/
		
		if (_l.usePartInvoiceNoAuto && _l.isCompensationAsc) {
			partItem.find("input[name='INVOICE_NO']").removeClass().addClass("inputRO").prop("readonly", true);
			partItem.find("input[name='INVOICE_ITEM_NO']").removeClass().addClass("inputRO").prop("readonly", true);
		}
		
		// EHN15 : (divistion id 변경)
		$j('#divRparts').show();
		$j("#partsTable").children().show();
		
		$j('#partsTableBody').append(partItem);
	}
	// EHN21
	preventInputEnter();
}


function lfSearchPopPart(part, dest, obj) {
	var idx = obj.parentNode.parentNode.rowIndex - 1;// tr head 제외	
	
	if(!_l.isRunningOnOperation && ("C550" == _l.u.c || "C310" == _l.u.c)){
		cfSearchPopPartFromBOM(_l.MODEL, _l.modelVersion, _l.ObjectId, part, dest, idx, 'SODETAIL');
	}else if(_l.u.c_SEA == "C310"){
		cfSearchPopPartFromBOM(_l.MODEL, _l.modelVersion, _l.ObjectId, part, dest, idx, 'SODETAIL');
	}else{
		cfSearchPopPart(part, dest, idx, 'SODETAIL');
	}
}
// EHN15 : ksy2702.kwon
function lfSearchPopPartForSO(part, dest, ascCode, obj) {
	var idx = obj.parentNode.parentNode.rowIndex - 1;// tr head 제외	
	
	if(!_l.isRunningOnOperation){
		cfSearchPopPartForSOUpdate(part, dest, idx, 'SODETAIL');
	}else if(_l.u.c_SEA == "C310"){
		cfSearchPopPartFromBOM_AC(_l.MODEL, _l.modelVersion, _l.ObjectId, part, dest, idx, 'SODETAIL',ascCode);
	}else{
		cfSearchPopPartForSOUpdate(part, dest, idx, 'SODETAIL');
	}
}

