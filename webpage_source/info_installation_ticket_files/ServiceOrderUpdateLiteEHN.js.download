			var sobj = $('sENGINEER');
			$('ENGINEER').value = sobj.value;
			$('ENGINEERNAME').innerHTML = sobj.options[sobj.selectedIndex].text
					.split('|')[0];
			$j('#engList_area').css("display","none");
			return true;
		}
	}
}
