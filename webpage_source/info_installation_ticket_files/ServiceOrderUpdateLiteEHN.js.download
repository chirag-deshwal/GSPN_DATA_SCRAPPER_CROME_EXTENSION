						if(_l.u.Locale == "esl"){
							alert(_l.u.WEB_MSG_PREFIX + "ATENCIÓN: PROGRAMA VOLUNTARIO DE PREVENCIÓN DE RIESGOS\nHa recibido un aviso del PROGRAMA VOLUNTARIO DE PREVENCIÓN DE RIESGOS fuera de garantía, que requiere reparación. Por favor complete la reparación y reciba el pago de cliente del servicio fuera de garantía; documente el reclamo de garantía para aplicar un pago adicional por el retrabajo. Para obtener información adicional, consulte la Guía de políticas y procedimientos del PROGRAMA VOLUNTARIO DE PREVENCIÓN DE RIESGOS de Samsung, ubicada en la sección \"Aviso\" de GSPN.");
						}else{
							alert(_l.u.WEB_MSG_PREFIX + "ATTENTION: RECALL ADD-ON!\nYou have received an In-Home out-of-warranty dispatch that requires an add-on recall repair. Please complete and receive payment from customer for the OOW repair, and then file the warranty claim to apply additional payment for add-on work - Do not forget to add the recall part kit number on the claim. For additional information, please see the Samsung Top Load Washer Recall Policy & Procedure Guide, located in the \"Notice\" section in GSPN.");
						}
					}
					else if(serviceType == "IH"){
						if(_l.u.Locale == "esl"){
							alert(_l.u.WEB_MSG_PREFIX + "ATENCIÓN: PROGRAMA VOLUNTARIO DE PREVENCIÓN DE RIESGOS\nHa recibido un aviso del PROGRAMA VOLUNTARIO DE PREVENCIÓN DE RIESGOS que requiere reparación dentro de garantía. Por favor complete la reparación y documente la reclamación de garantía de acuerdo a los procesos normales. No olvide agregar el número de parte del kit en el reclamo, ya que se aplicará un pago adicional como complemento. Para obtener información adicional, consulte la Guía de políticas y procedimientos del PROGRAMA VOLUNTARIO DE PREVENCIÓN DE RIESGOS de Samsung, ubicada en la sección \"Aviso\" de GSPN.");
						}else{
							alert(_l.u.WEB_MSG_PREFIX + "ATTENTION: RECALL ADD-ON!\nYou have received an In-Home in-warranty dispatch that requires an add-on recall repair Please complete the repair and file the warranty claim per normal process - Do not forget to add the recall part kit number on the claim, as additional payment will be applied for add-on. For additional information, please see the Samsung Top Load Washer Recall Policy & Procedure Guide, located in the \"Notice\" section in GSPN.");
						}
					}
					else{
						if(_l.u.Locale == "esl"){
							alert(_l.u.WEB_MSG_PREFIX + "ATENCIÓN: PROGRAMA VOLUNTARIO DE PREVENCIÓN DE RIESGOS\nHa recibido un aviso del PROGRAMA VOLUNTARIO DE PREVENCIÓN DE RIESGOS. Por favor complete la reparación y documente la reclamación de garantía de acuerdo a los procesos normales - No olvide agregar el número de parte del kit en el reclamo. Para obtener información adicional, consulte la Guía de políticas y procedimientos del PROGRAMA VOLUNTARIO DE PREVENCIÓN DE RIESGOS de Samsung, ubicada en la sección \"Aviso\" de GSPN.");
						}else{
							alert(_l.u.WEB_MSG_PREFIX + "ATTENTION: RECALL!\nYou have received a recall dispatch. Please complete the repair and file the warranty claim per normal process - Do not forget to add the recall part kit number on the claim. For additional information, please see the Samsung Top Load Washer Recall Policy & Procedure Guide, located in the \"Notice\" section in GSPN.");
						}
					}
						
					$('spanRecallFlag').innerHTML = "<font color=red><b>Recall</b></font>";
				}
			} else {
				
			}
