//			if(_l.isBillingSaved || _l.isWtyClaimed){
//				alert("ADH Package Info cannot be changed if Warranty Claimed or Billing saved.")
//				return;
//			}
//		}
//	}
	
	if(_l.isBillingSaved || _l.isWtyClaimed || _l.CurrStatus == "ST035" ){
		alert(_l.u.WEB_MSG_PREFIX + "ADH Package Info cannot be changed if Warranty Claimed or Billing saved or Repair Completed.")
		return;
	}
	// Care Pack 고도화 - 2017.03 - End //
	
	if((_l.u.c == "C850" || _l.u.c == "C813") && !_l.noMoreUseModelForADH){

		// Care Pack 고도화 - 2017.03 - Start //
		if(_l.isCarePackService){
			
			clearForm("frm");
			insertValue("frm", "cmd", "ZifGspnCarePackInfoCmd");	
			insertValue("frm", "IV_GUBUN", "X");
			insertValue("frm", "IV_COMPANY", _l.u.c);
			insertValue("frm", "IV_SERIAL_NO", $j("#SERIAL_NO").val());
			insertValue("frm", "IV_IMEI", $j("#IMEI").val());
			AjaxRequest(urlPattern,'frm', checkADHPack);
			
			function checkADHPack(response){
				
				try{
					jsonObj = response.responseText.evalJSON();
					if(jsonObj.success){
						if("X" == jsonObj.eS_RESULT.ADH_IND){
							if(confirm(_l.u.WEB_MSG_PREFIX +"Do you want to use ADH package?")){
								confirmADHfromPop("Y","","","");
							}else{
								confirmADHfromPop("N","","","");
							}
						}else{
							var w = window.open(
											"",
											"adhPackInfo_popup",
									'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=530');
							w.focus();
							var obj = $('tempForm');		
							obj.action = "/svcpack/master/SearchCarePackage.jsp?type=svc&IMEI=" + $j('#IMEI').val()+"&CERTI_NO=" + $j('#CERTI_NO').val()+"&ADH_FLAG=" + $j('#ADH_FLAG').val()+"&SERIAL_NO=" + $j('#SERIAL_NO').val()+"&IN_OUT_WTY=" + $j('#IN_OUT_WTY').val()+"&MODEL=" + $j('#MODEL').val() + "&SUB_SVC_TYPE=" + $j('#SUB_SVC_TYPE3').val() + "&OBJECT_ID=" + _l.ObjectId;
							obj.method = 'post';
							obj.target = 'adhPackInfo_popup';
							obj.submit();
						}
					}
				} catch (e) { }
				
			}

		}else{

			if(confirm(_l.u.WEB_MSG_PREFIX +"Do you want to use ADH package?")){
				confirmADHfromPop("Y","","","");
			}else{
				confirmADHfromPop("N","","","");
			}
		
		}
		
		// Care Pack 고도화 - 2017.03 - End //
		
	}else{
		
		// Care Pack 고도화 - 2017.03 - Start //
		if(_l.isCarePackService){
			viewTab($("tdJob"), "divJob");
		}
		// Care Pack 고도화 - 2017.03 - End //
		
		var w = window.open(
						"",
						"adhPackInfo_popup",
				'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=530');
		w.focus();
		var obj = $('tempForm');		
		// Care Pack 고도화 - 2017.03 - Start //
		if(_l.isCarePackService){
			obj.action = "/svcpack/master/SearchCarePackage.jsp?type=svc&IMEI=" + $j('#IMEI').val()+"&CERTI_NO=" + $j('#CERTI_NO').val()+"&ADH_FLAG=" + $j('#ADH_FLAG').val()+"&SERIAL_NO=" + $j('#SERIAL_NO').val()+"&IN_OUT_WTY=" + $j('#IN_OUT_WTY').val()+"&MODEL=" + $j('#MODEL').val() + "&SUB_SVC_TYPE=" + $j('#SUB_SVC_TYPE3').val() + "&OBJECT_ID=" + _l.ObjectId;
		}else{
			obj.action = "/svcpack/master/SearchAdhPackage.jsp?type=svc&IMEI=" + $j('#IMEI').val()+"&CERTI_NO=" + $j('#CERTI_NO').val()+"&ADH_FLAG=" + $j('#ADH_FLAG').val()+"&SERIAL_NO=" + $j('#SERIAL_NO').val()+"&IN_OUT_WTY=" + $j('#IN_OUT_WTY').val()+"&MODEL=" + $j('#MODEL').val() 
						+ "&OBJECT_ID=" + _l.ObjectId + "&SC_PLUS_FLAG=" + $j('#SC_PLUS_FLAG').val() +"&PACK_BASE=" + $j('#PACK_BASE').val()+"&PURCHASE_DATE=" + $j('#PURCHASE_DATE').val()+"&SALES_COUNTRY=" + $j('#SALES_COUNTRY').val()+"&LOSS_TYPE_ID=" + $j('#LOSS_TYPE_ID').val();
		}
		// Care Pack 고도화 - 2017.03 - End //
		obj.method = 'post';
		obj.target = 'adhPackInfo_popup';
		obj.submit();
	}
}

