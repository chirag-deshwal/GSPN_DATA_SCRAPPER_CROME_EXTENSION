	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId);
	insertValue("frm", "cmd", "ZifGspnSvcOtpCheckCmd");
	
	AjaxSyncRequest(urlPattern, "frm", setInitOTPCheck);
}

function changeOTPCheck(){
	if(!isOTPShowSVCType()){
		isOTPButton();
		return;
	}
	
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_PARTNER", $j("#CONSUMER").val());
	insertValue("frm", "IV_TYPE", "B");
	insertValue("frm", "IV_MODEL", _l.MODEL);
	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId);
	insertValue("frm", "cmd", "ZifGspnSvcOtpCheckCmd");
	
	AjaxSyncRequest(urlPattern, "frm", setInitOTPCheck);
}

function setInitOTPCheck(response){
	$('progressloading').stopWaiting();
	
	try{
		var initOTPJsonObj = eval('('+response.responseText+')');
		
		_l.countOTP = initOTPJsonObj.EV_OTP_CNT;
		
		if(initOTPJsonObj.success){
			if(initOTPJsonObj.EV_BP_CHK == "N"){
				_l.eligibleOTPFlag = true;			//OTP 대상 여부.
				_l.initOTPCheckFlag = false;		//OTP Check 여부.
			}else{
				_l.eligibleOTPFlag = false;			//OTP 대상 여부.
			}
			
			isOTPButton();
		}
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
	}
}

//OTP Insert
function sendOTP(){
	if(_l.mobile_phone == ""){
		//alert(_l.u.WEB_MSG_PREFIX + "Mobile Number is not Exist. OTP did not send.");
		return;
	}
	
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "IV_SEND_TYPE", "N");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_PARTNER", $j("#CONSUMER").val());
	insertValue("frm", "IV_OBJECT", _l.ObjectId);
	insertValue("frm", "cmd", "ZifGspnSvcOtpSmsSendCmd");

	AjaxRequest(urlPattern, "frm", setSendOTP);
}

function setSendOTP(response){
	$('progressloading').stopWaiting();
	
	try{
		jsonObj = eval('('+response.responseText+')');
		
		if(jsonObj.success && jsonObj.EV_RET_CODE == "S"){
			otpCheck(jsonObj.EV_OTP_NUM);
		}else{
			alert(_l.u.SAP_MSG_PREFIX + jsonObj.EV_RET_MSG);
		}
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
	}
}

//OTP SMS Send
function otpCheck(EV_OTP_NUM){
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "IV_OTP_NUM", EV_OTP_NUM);
	insertValue("frm", "OBJECTID", _l.ObjectId);
	insertValue("frm", "MOBILE_PHONE", _l.mobile_phone);
	insertValue("frm", "serviceType", $j('#SERVICE_TYPE').val());
	insertValue("frm", "dataOrigin", _l.TR_TYPE);
	insertValue("frm", "cmd", "OtpSMSSendCmd");
	
	AjaxRequest(urlPattern, "frm", setotpSendSMS);
}

function setotpSendSMS(response){
	$('progressloading').stopWaiting();
	
	var otpSendSMSJsonObj = eval('('+response.responseText+')');

	try{
		otpSendSMSJsonObj = eval('('+otpSendSMSJsonObj.Message+')');
		_l.otpReturnCode = otpSendSMSJsonObj.result.returncode;
		
		if(otpSendSMSJsonObj.success && otpSendSMSJsonObj.result.returncode == "0"){
			// SMS 발송 성공
		}else{
			alert("[OPT_SMS]" + otpSendSMSJsonObj.result.returnmsg);
		}
	} catch (e) {
		//alert(otpSendSMSJsonObj.Message);
		alert(_l.u.WEB_MSG_PREFIX + "Transmission failure a message.");
	}
	
	// 2015.11.19 G-CIC 에서 OTP 번호 생성 후 SMS 전송이 완료 되면,
	// G-CIC ZTSVC566 테이블에 OTP COUNT, MOBILE COUNT 를 업데이트 하도록 변경
	updateOTP();
}

// 2015.11.19 G-CIC 에서 OTP 번호 생성 후 SMS 전송이 완료 되면,
// G-CIC ZTSVC566 테이블에 OTP COUNT, MOBILE COUNT 를 업데이트 하도록 변경
function updateOTP(){
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId);
	insertValue("frm", "IV_PARTNER", $j("#CONSUMER").val());
	insertValue("frm", "IV_RETURN_FLAG", _l.otpReturnCode);
	insertValue("frm", "cmd", "ZifCspSvcOtpCountUpdateCmd");

	AjaxRequest(urlPattern, "frm", setUpdateOTP);
}

function setUpdateOTP(response){
	$('progressloading').stopWaiting();
	
	try{
		jsonObj = eval('('+response.responseText+')');
		
		if(jsonObj.success && jsonObj.EV_RET_CODE == "S"){
			//SMS 전송 완료 후 ZTSVC566 테이블 Update 완료
		}else{
			alert(_l.u.SAP_MSG_PREFIX + jsonObj.EV_RET_MSG);
		}
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
	}
}

function isOTPButton(){
	if(_l.eligibleOTPFlag && !_l.initOTPCheckFlag && isOTPShowSVCType()){
		$j("#btnOTPCheck").show();
	}else{
		$j("#btnOTPCheck").hide();
	}
}

function isOTPShowSVCType(){
	if(!_l.isPioltASC){
		return false;
	}
	
	if($j('#SERVICE_TYPE').val() == "SR" && $j("#STATUS").val() == "ST025"){
		return true;
	}
	
	// 인도 법인 양윤정 과장 요청으로 2015/11/18일 PS제외 에서
	// 2015/11/20일 Service Type = PS 건은 Data Origin = O 일 경우 OTP 적용 로직으로 변경
	if($j('#SERVICE_TYPE').val() == "PS" && _l.TR_TYPE == "O" && $j("#IN_OUT_WTY").val() != "OW"){
		return true;
	}
	
	return (($j('#SERVICE_TYPE').val() == "CI" ||
				$j('#SERVICE_TYPE').val() == "IH" ||
				$j('#SERVICE_TYPE').val() == "BS" ||
				$j('#SERVICE_TYPE').val() == "DM" ||
				$j('#SERVICE_TYPE').val() == "SH" ||		// 인도 법인 양윤정 과장 요청으로 2015/11/20일 SH추가
				$j('#SERVICE_TYPE').val() == "II") &&
				$j("#IN_OUT_WTY").val() != "OW");
	
				//	$j('#SERVICE_TYPE').val() == "PS"		// 인도 법인 양윤정 과장 요청으로 2015/11/18일 PS제외
}
