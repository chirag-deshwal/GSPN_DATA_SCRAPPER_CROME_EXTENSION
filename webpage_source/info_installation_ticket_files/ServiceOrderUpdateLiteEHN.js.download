/*
 * 2011.04.28 updated by je0801.kim SEDA requested to check UNIT_RECV_DATE when
 * Service Type is Pick Up Service - check when the user tries save with status
 * ST035 It is effected on all the subsidiaries. (Confirmed by HiSig Lee) It is
 * effected on only SEDA changed 2011.05.19. (Confirmed by HiSig Lee) updated by
 * HyukSang Kwon.
 */
// SEDA Only 였으나, 전 법인 적용으로 변경(김정은 선임 요청)updated by HyukSang Kwon. 2011.05.31
/**
 * verify whether unit receive date is need condition : (SH and ST035) or ( (PS
 * or CI) and over ST025 )
 */
function validUnitReceiveDate() {
	var valid = true;

	var unitReceiveNeed = unitReceiveDateNeed();
	if (!unitReceiveNeed) {
		return valid;
	}	
	// unitReceiveNeed is true
	/*MAN_CHK_UNIT_RECV_DATE_8 이관
	if ($('UNIT_RECV_DATE').value == "") {
		alert(_l.r.m.MAND_INPUT_00898);
		valid = false;
	} else 
	*/
	
	if (!checkDate($('UNIT_RECV_DATE').value, _l.u.DateFormat2)) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_DATEFORMAT_00898);
		valid = false;
	}
	if (!valid) {
		moreOpenid(5);
		$('UNIT_RECV_DATE').focus();
	}
	
	//중국만 아래로직 더 있어서 추가함.
	if(_l.u.isChinaRegion && !valid && $('UNIT_RECV_TIME') != null){
		$('UNIT_RECV_DATE').readOnly = "";
		$('UNIT_RECV_TIME').readOnly = "";
		$('UNIT_RECV_DATE').className = "input";
		$('UNIT_RECV_TIME').className = "input";
		$('ICO_UNIT_RECV_TIME').style.display="";
		$j('#UNIT_RECV_DATE').focus();
	}	
	
	return valid;
}

function unitReceiveDateNeed() {
	var need = false;
	var statusCode = $("STATUS").value;
	var SERVICE_TYPE = $("SERVICE_TYPE").value;
	// Service Handling and Repair Completed
	if (SERVICE_TYPE == 'SH') {
		// //Repair Escalation Process Check
		if(statusCode == "ST035"){need = true;}
	} else if (SERVICE_TYPE == 'PS') {

		if (statusCode == "ST035" || statusCode == "ST040"
				|| statusCode == "ST055") {
			need = true;
		}
	}
	return need;
}
// ----validUnitReceiveDate end------------------


