	function validateCheckListYN() {
		var url = urlPatternGZIP;
		var data = "cmd=CheckListSearchCmd&iv_company=" + _l.u.c + "&iv_object_id=" + _l.ObjectId;
		var isValid = true;
		$j.ajax({
			type : "POST",
			async : false,  /* 동기 */ 
			url : url,
			data : data,
			success : function(data) {
				if (data.success) {
					isValid = true;
				} else {
					alert(_l.u.WEB_MSG_PREFIX + "please Input Check List!!!.");
					isValid = false;
				}

			},
			dataType : 'json'
		});
		
		return isValid;
	}
	
