																		 * be
																		 * selected
																		 */); // 과거날짜는
																											// 안됨
		// moreOpenid(5);
		obj.value = '';
		obj.focus();
		return;
	}
}

/**
 * china : 자재만 저장하는 기능에서 callback 메소드에서 호출햇으며, 자재정보만 다시 읽어 오는 로직이였음.
 * 그러나, 자재만 저장기능을 데이터 정합성 문제로 삭제햇으므로, 더이상 사용되지 않음.
 * 중국 소스 머지하면서, KT경우 미사용자재 삭제하는 기능의 callback에서 호출되는 곳이 있음.
 * 거기콜백은 자재만 갱신하는거엿으나, 데이터 정합성 문제로 전체 갱신으로 변경함.
 */
function partsReload(){
			callDetail();
			return;
}

function checkDateIs30DaysPast(obj, objDesc){
	var dateFormat = _l.u.DateFormat2;

	if( !checkDate(obj.value, dateFormat) ){
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_DATE + objDesc);
		obj.value='';
		return false;
	}

	if( checkFromToDate(obj.value, _l.before30Date,dateFormat)){
		alert(_l.u.WEB_MSG_PREFIX + objDesc+"is older than 30 days. Please check "+objDesc+" again");
		obj.value='';
		return false;
	}
	
	return true;
}

function adhPackInfoSearch() {
	
	// Care Pack 고도화 - 2017.03 - Start //
