function selectAD() {
	beforeADServiceTypeString = $j("#SERVICE_TYPE").html();
	$j("#SERVICE_TYPE").html("");
	try{
		$j("#SERVICE_TYPE").html("<option value='AD'>Accidental Damage Handling</option>");
	} catch (e) {}
	$j("#SERVICE_TYPE").val("AD");
	
	// Care Pack 고도화 - 2017.03 - Start //
	if(_l.isCarePackService){
		$j('#tdSubType1,#tdSubType2').show();
		$j('#SUB_SVC_TYPE').val()=="";
		$j('#SUB_SVC_TYPE2').val()=="";
		$j('#SUB_SVC_TYPE3').show();
	}

	if(_l.owPackFlag == "X" || _l.u.c == "C820" || _l.u.c == "C5A0"){
		setComboValue($('detailForm').WTY_EXCEPTION, $('WTY_EXCEPTION').value);
	}else{
		$('WTY_EXCEPTION').value = "";
	}
	$j("#WTY_EXCEPTION").removeClass().addClass("inputRO").prop("readonly", true).prop("disabled", true);
	$j('#MODEL').removeClass().addClass("inputRO").prop("readonly", true);
	$j('#SERIAL_NO').removeClass().addClass("inputRO").prop("readonly", true);
	//IMEI PROJECT
	if(isAutoImei){
		$j('#IMEI_TXT').removeClass().addClass("inputRO").prop("readonly", true);
	}else{
		$j('#IMEI').removeClass().addClass("inputRO").prop("readonly", true);
	}
	// Care Pack 고도화 - 2017.03 - End //
	if(_l.useScPlusSubSvcType) {
		var subType = $j('#SUB_SVC_TYPE3').val();
		selectADSub(subType, '');
	}
	
	if(_l.u.isChinaRegion){
		// Care Pack 고도화 - 2017.03 - Start //
		$j('[name=REP_TYPE]').val("AD");
		$j('#spanREP_TYPE').html("Accidental Damage Handling");
		// Care Pack 고도화 - 2017.03 - End //
	}	
}

// Care Pack 고도화 - 2017.03 - Start //
function selectADSub(code, text) {
	if(_l.useScPlusSubSvcType) {		
		if (currTabId == 'divJob') {
			toggleSubServicetype(isEuUser, true, $j("#SERVICE_TYPE").val());
/*			$j("#SUB_SVC_TYPE3 option").each(function() {
				var val = $j(this).val();
				var ret = true;
				if(isLaUser){
					if(val == code || val == "EI" || val == "RU"){
						ret = false;
					}else{
						ret = true;
					}
				}else{
					ret = (val == code);
				}

				var ret = (val == code);
				$j(this).prop("disabled", ret);
			});
*/
			if("AD" == $j("#SERVICE_TYPE").val() ||_l.ewSmcFlag == "X"){
				$j('#SUB_SVC_TYPE3 option').prop("disabled", false);
			}else{
				$j('#SUB_SVC_TYPE3 option').prop("disabled", true);
			}
			if(_l.blockSubtypeSC){
				$j("#SUB_SVC_TYPE3").find("option:[value=SC]").remove();
			}
		}
		$j("#SUB_SVC_TYPE3").val(code);
	} else {		
		$j("#SUB_SVC_TYPE3").html("");
		$j("#SUB_SVC_TYPE3").html("<option value='"+code+"'>"+text+"</option>");
		$j("#SUB_SVC_TYPE3").val(code);
	}
}
// Care Pack 고도화 - 2017.03 - End //

function verify() {
	var _l = window._l;
	var frm = $("detailForm");
	var statusCode = $j("#STATUS").val();
	var statusReason = $j('#REASON').val();
	var modelInfo = $j("#MODEL").val();
	var SVC_PRCD = $j("#SVC_PRCD").val();
	var wtyInOut = $j('#IN_OUT_WTY').val();
	var serviceType = $j("#SERVICE_TYPE").val();
	var defectType = $j("#LAB_TYPE").val();
	var corp = _l.u.c;
	var isBillingSaved = _l.isBillingSaved;
	var billingFlag = _l.billingFlag;
	var currStatus = _l.CurrStatus;
	var IRIS_CONDI = $j('#IRIS_CONDI').val();
	var checkStatusMGSPNTicket =  "ST030,ST035,ST040".indexOf(statusCode) != -1;
	var hasPart = hasRepairPart();
	
	var modelCode = modelInfo.substring(0, 3);
	if(modelCode == "MNA"){
		if($j("#RANK_NO").val()==""){ //RANK 정보 없으면 티켓 생성 불가
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0821 + "\n" + _l.r.m.EXT_0822);
			return false;
		}
	}
    
	var modelType = modelInfo.substring(modelInfo.length-3,modelInfo.length-2);
	var modelLast3digit = modelInfo.substring(modelInfo.length-3,modelInfo.length);
	if(_l.isIndia && ($j("#CIC_PRCD").val() == "ACN" || $j("#prod_category").val() == "ACN") && (serviceType == "II" || serviceType == "BS" || serviceType == "DM" || serviceType == "CC")){
		if($('SVC_PRCD').value != "A/C06" && $('SVC_PRCD').value != "A/C07" && modelType == "X"){
			alert(_l.u.WEB_MSG_PREFIX + "Service Order creation & modification is restricted for Outdoor A/C unit w.r.t service type- II/DM/BS/CC. Kindly input Indoor model details.");
			return false;
		}
		if(modelLast3digit == "NMD"){
			alert(_l.u.WEB_MSG_PREFIX + "Service Order creation & modification is restricted for Dealer Display A/C unit w.r.t service type- II/DM/BS/CC. Kindly check model details.");
			return false;
		}
	}

	if(_l.isMyPjtImei){
		if(_l.IMEI == $("IMEI").value){
			if(_l.warningMessageType == 'W'){
				alert(_l.u.SAP_MSG_PREFIX + _l.warningMessage);
			}
		}
	}
	
	// Care Pack 고도화 - 2017.03 - Start //
	if(_l.isCarePackService){
		if(serviceType == "AD"){
			var subServiceType = $j("#SUB_SVC_TYPE3").val();
			$('detailForm').SUB_SVC_TYPE_AD.value = subServiceType;
		}
	}
	if(_l.useScPlusSubSvcType){
		if(serviceType == "AD" || serviceType == "CI" || serviceType == "PS" || serviceType == "IH"){
			var subServiceType = $j("#SUB_SVC_TYPE3").val();
			$('detailForm').SUB_SVC_TYPE_AD.value = subServiceType;
		}
	}
	
	if(_l.useQNACodeSearch && statusReason == "HP010"){
		if($j("#QNA_CODE").val() == ""){
			alert("If you select this pending reason, please register QNA related S/O No.");
			return;
		}
	}
	// Care Pack 고도화 - 2017.03 - End //

	if(_l.useDefectDetailDesc){
		var defectDetailDescInput = $("DEFECTDESC_L").value.replace(/\s|\n|\r|\^|\[|\]|\,/g,'');
		var defectDetailDescDB = _l.r.c.DEFECT_COMMENT_TEMPLETE.replace(/\s|\n|\r|\^|\[|\]|\,/g,'');

		if(_l.u.c == "C813"){
		
		}else{
			if($("DEFECTDESC_L").value.length > 70){
				$('DEFECT_DESC').value = $("DEFECTDESC_L").value.substring(0, 70);
			}else{
				$('DEFECT_DESC').value = $("DEFECTDESC_L").value;
			}
		}
		
		if(defectDetailDescInput == "" || defectDetailDescInput == defectDetailDescDB){
			if(statusCode == "ST035"){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0657/* Defect Detail Desc is mandatory*/);
				return false;
			}
		}		
	}else{
		if(_l.u.c == "C813"){
			
		}else{
			$('DEFECTDESC_L').value = $("DEFECT_DESC").value;
		}
	}
	// REPAIR_DESC -> REPAIRDESC_L
	if($("REPAIRDESC_L").value.length > 70){
		$('REPAIR_DESC').value = $("REPAIRDESC_L").value.substring(0, 70);
	}else{
		$('REPAIR_DESC').value = $("REPAIRDESC_L").value;
	}
	
	//중국 전용 로직으로 추가함.
	var DEALER = $j('#DEALER').val();
	var prod_category = $j('#prod_category').val();
	var IRIS_REPAIR = $j('#IRIS_REPAIR').val();
	if (_l.u.isChinaRegion){
		
		if(isNewChina && statusCode == "ST035" ){		//수리 완료 상태일 경우
			if(!confirm(_l.u.WEB_MSG_PREFIX +_l.r.m.SVC_MSG_CONFIRM/*Impossible to modify after saving. (Y,N)*/)) return;
		} else {
			if(!confirm(_l.u.WEB_MSG_PREFIX +_l.r.m.SVC_MSG_SAVE/*Do you really want to save it?*/)) return;
		}
		
		//START : C18090007404 [중국 GSPN]_Dealer invoice 필드 추가 및 해당 정보 저장 max값 변경요청
		// ST035시점, 구매일자(#PURCHASE_DATE)가 있는데 LOCAL_INVOICE_NO(Dealer invoice)가 입력되지 않는경우 메세지 보임
		//if((_l.u.c == 'C630' || _l.u.c == 'C6V0') && statusCode == "ST035" && $j("#PURCHASE_DATE").val() != "" && $("PURCHASE_DATE").value.substring(0,2) != "00" ){		
		//	var localInvoiceNo = frm.LOCAL_INVOICE_NO.value.strip();
		//	if (localInvoiceNo=="") {  
		//		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0802);
		//		$('LOCAL_INVOICE_NO').focus();
		//		return;
		//	}
		//}
		//END  : C18090007404 [중국 GSPN]_Dealer invoice 필드 추가 및 해당 정보 저장 max값 변경요청
		
		//mobile GSPN 에서만 저장가능한 상태로 여기서는 저장못함.
		//VAL_CHK_REASON_1 이관
		/*
		if(isNewChina && statusCode == "ST035" && statusReason == "HL020"){//wait to confirm (mobile)
				alert(_l.r.m.EXT_0390); //0330 메세지는 글로벌에서 다른 페이지에서 사용중이라서 변경
				return;
		}		
		*/

		function validModelInfo() {
			var valid = true;
			var url = urlPatternGZIP;
			var data = "cmd=GetIMEICheckCmd&imei=" + $j('#IMEI').val() + "&model=" + $j('#MODEL').val() + "&serial=" + $j('#SERIAL_NO').val().trim() + "&src=O";
			
			$('progressloading').startWaiting();
			$j.ajax({
				type : "POST",
				async : false,  /* 동기 */ 
				url : url,
				data : data,
				success : function(data) {
					if (data.success) {
						if(!(data.model.substr(0,2)=='GH' || data.model.substr(0,2)=='AD')){
							if($j('#MODEL').val() != data.model || $j('#SERIAL_NO').val() != data.serial){
								valid = false;
							}else{
								valid = true;
							}
						}else{
							if($j('#SERIAL_NO').val() != data.serial){
								valid = false;
							}else{
								valid = true;
							}
						}
					} else {
						alert(_l.u.WEB_MSG_PREFIX + data.returnMessage);
						valid = false;
					}
				},
				dataType : 'json'
			});
			$('progressloading').stopWaiting();
			
			return valid;
		}
		/*
		 * 중국 OUTBOUND SO의 경우 ST035저장시 IMEI를 MPTS와 비교하여 모델/IMEI/SN불일치시 에러 팝업 적용 요청
		 * 에러 메세지:
		 * 중문:IMEI与型号不匹配，请重新确认型号信息 
		 * 영문:The IMEI doesn`t match the model. Please confirm the model information again.
		 */
		if(isNewChina && prod_category == 'HHP' && _l.isOutBound && statusCode == "ST035" && currStatus != statusCode){
