var billingPopFlag = "";
function beforeBillingPop(flag) {
	if (flag != "D"){
		var wtyInOut = $('IN_OUT_WTY').value;
		if(_l.u.c == "C550" && _l.CurrStatus == "ST035" && wtyInOut != 'OW'){
			billingPopFlag = flag;
			checkAuthorizedModel("2");
			return;
		}else{
			openBillingPop(flag);
		}
	}else{
		openBillingPop(flag);
	}
}


var billing_popup;
function openBillingPop(flag) {
	
	var statusCode = $("STATUS").value;
	var modelInfo = $("detailForm").MODEL;
	var svcProd = $("SVC_PRCD").value;
	var wtyInOut = $('IN_OUT_WTY').value;
	var serviceType = $("SERVICE_TYPE").value;
	var defectType = $("LAB_TYPE").value;

	//china version intergration 2016/08/16 js1.baek
	if(_l.u.isChinaRegion){
		if( !validPartGIStatus() ){
			return;
		}
	}else{//if(_l.u.isChinaRegion){
		// HME 제품일 경우, Warranty Term = OW , Service type = IH or BS, Defect type =
		// FL, Status = ST035 or ST040
		if (!_l.isBillingSaved && _l.u.c == "C550"
				&& (_l.CurrStatus == "ST040" || _l.CurrStatus == "ST035")
				&& "HME" == svcProd.substring(0, 3) && wtyInOut == "OW"
				&& (serviceType == "IH" || serviceType == "BS")
				&& defectType == "FL" && !_l.sawExistLabor) {
			alert(_l.u.WEB_MSG_PREFIX + "In case of AMC, before billing SAW for labor is mandatory.");
			return;
		}

		if (flag != "D") { // before billing
			if (_l.useCleaningCodeForHHP
					&& (statusCode == 'ST035' || statusCode == 'ST040')) {
				if (!validCleanCodeLocation()) {
					return;
				}
			}

			if (!isSerialNumberValid()) {
				return;
			}
		}
		/*
		 * * When S/O is saved with ST035 or 040, All part status should be GIed. * >>
		 * ASC cano't add the repair part after ST035 but can remove * ST052 then
		 * All parts status should not be GIed.
		 */
		if(_l.u.c == "C710" && _l.CurrStatus != 'ST035' && _l.CurrStatus != 'ST040') {
			
		} else {
			if (!validPartGIStatus("B")) {
				return;
			}
		}		
	}//if(_l.u.isChinaRegion){
	
	// Billing전 close안된 SAW가 있을 경우 confirm해서 진행할 경우 aprroved 된 금액만 billing에 반영
	if (_l.sawPending) {
		if (!confirm(_l.u.WEB_MSG_PREFIX +_l.r.m.EXT_0169)) {
			return;
		}
	}

	var usingParts = 'N';
	if (usingPartsChk())
		usingParts = 'Y';
	billing_popup = window
			.open(
					"",
					"billing_popup",
					'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=350');
	billing_popup.focus();
	
	var url = "";
	var tempForm = $('tempForm');
	
	if(_l.u.isChinaRegion){
		url = "/svctracking/svcorder/SVCPopBilling.jsp" + "?lossTypeId=" + _l.lossTypeId;
		
		tempForm.partsUsed.value = usingParts;
		
	}else{//if(_l.u.isChinaRegion){
		url = "/svctracking/svcorder/SVCPopBilling.jsp?hasOutWtyPart="
			+ _l.hasOutWtyPart + "&hasPartItem=" + _l.hasPartItem 
			+ "&serviceType=" + _l.SERVICE_TYPE 
			+ "&status=" + _l.CurrStatus
			+ "&lossTypeId=" + _l.lossTypeId;
		
		if(_l.isFieldNewUser){
			url = "/feme/ticket/common/TicketDetailPopBilling.jsp?hasOutWtyPart="
				+ _l.hasOutWtyPart + "&hasPartItem=" + _l.hasPartItem 
				+ "&serviceType=" + _l.SERVICE_TYPE; 
		}
		if(_l.u.c == 'C370'){
			url = "/wis/ticket/common/TicketDetailPopBilling.jsp?hasOutWtyPart="
				+ _l.hasOutWtyPart + "&hasPartItem=" + _l.hasPartItem 
				+ "&serviceType=" + _l.SERVICE_TYPE
				+ "&ticketCompany=" + _l.u.c;
		}
		tempForm.defectType.value = defectType;
		tempForm.svcProd.value = svcProd;
	
		if (_l.isBillingForQuotation) {
			tempForm.quotationFlag.value = 'X';
		}
	
		tempForm.partsUsed.value = usingParts;
		if(_l.isBillingSaved){
			tempForm.billingSearch.value = 'Y';
		}else{
			tempForm.billingSearch.value = 'N';
		}
		tempForm.hasWtyBilling.value = 'N';
	
	}//if(_l.u.isChinaRegion){	
	
	// Care Pack 고도화 - 2017.03 - Start //
	if(_l.isCarePackService){
		if(_l.SERVICE_TYPE == "AD" && _l.SUB_SVC_TYPE != ""){
			url = "/svctracking/svcorder/SVCPopBillingForADH.jsp?hasOutWtyPart="
				+ _l.hasOutWtyPart + "&hasPartItem=" + _l.hasPartItem 
				+ "&serviceType=" + _l.SERVICE_TYPE 
				+ "&status=" + _l.CurrStatus;
		}
	}
	// Care Pack 고도화 - 2017.03 - End //
	
	tempForm.cancelFlag.value = flag;
	tempForm.action = url;
	tempForm.target = 'billing_popup';
	tempForm.submit();
	
	
	// divBilling
}

