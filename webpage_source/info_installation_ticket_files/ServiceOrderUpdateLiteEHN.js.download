function setSymptomCodeInit(type) {
	// Symptom에 대한 초기 selected setting
	var obj;
	var obj_val;

	if (type == 1) {
		obj = $('detailForm').SYMPTOM_CAT1;
		obj_val = _l.SYMPTOM1_CODE;
	} else if (type == 2) {
		obj = $('detailForm').SYMPTOM_CAT2;
		obj_val = _l.SYMPTOM2_CODE;
	} else if (type == 3) {
		obj = $('detailForm').SYMPTOM_CAT3;
		obj_val = _l.SYMPTOM3_CODE;
	} else if (type == 4) {
		obj = $('detailForm').SYMPTOM_CAT4;
		obj_val = _l.SYMPTOM4_CODE;
	}
	for ( var i = 0; i < obj.length; i++) {
		if (obj.options[i].value == obj_val) {
			obj.options[i].selected = true;
			break;
		}
	}
}

