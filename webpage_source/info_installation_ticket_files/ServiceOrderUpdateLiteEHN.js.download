	/*
	if(corp == 'C5F0'){
		
		if(serviceType == "IH" && statusCode == "ST035"){
			
			//MAN_CHK_FIRST_VISIT_DATE_4 중복, MAN_CHK_FIRST_VISIT_TIME_1 이관
