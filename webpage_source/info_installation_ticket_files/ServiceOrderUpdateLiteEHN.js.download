	var PRODUCT_DATE = $('PRODUCT_DATE').value;
	var PURCHASE_DATE = $('PURCHASE_DATE').value;	
	if (PURCHASE_DATE != "" && !isDate0000(PURCHASE_DATE, _l.u.DateFormat2)) {
		if (!checkFromToDate(PRODUCT_DATE, PURCHASE_DATE, _l.u.DateFormat2)) {			
