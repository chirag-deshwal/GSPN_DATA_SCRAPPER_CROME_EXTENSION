				if($j(this).val() != _l.WTY_EXCEPTION){
					$j(this).prop("disabled", true);
				}
			});		
		}	
		if(_l.currStatus == "ST040" || _l.currStatus == "ST035"){
			$('detailForm').WTY_EXCEPTION.disabled = true;
		}		
	}else if(tabId == 'divSAW'){
		//EHN1031 : pcs73 : SAW 탭 선택시 saw 생성 버튼 조건을 제어햇지만, 이제는 saw 생성 조건이 SAW 탭 밖으로 나갓으므로, 위 로직도 tabId 무관하게 호출되어야 한다.
		//아래로직 주석처리함.
		//if(_l.currStatus == "ST035" || _l.currStatus == "ST040" || _l.currStatus == "ST052" || _l.currStatus == "ES135" ||  _l.currStatus == "ES140"){
		//	if($j("#btnSaw").length > 0) $j("#btnSaw").hide();
		//}
	}else if(tabId == "divBilling"){
		if(_l.currStatus != "ST035" || _l.IN_OUT_WTY != "OW" || $j.trim(_l.WTY_BILL_NO) != "" || _l.isInWarranty){
			if($j("[id=btnBilling]").length > 0) $j("[id=btnBilling]").hide();
		}
	}
	
	//EHN1031 : pcs73 : SAW 탭 선택시 saw 생성 버튼 조건을 제어햇지만, 이제는 saw 생성 조건이 SAW 탭 밖으로 나갓으므로, 위 로직도 tabId 무관하게 호출되어야 한다.
	if(_l.currStatus == "ST035" || _l.currStatus == "ST040" || _l.currStatus == "ST052" || _l.currStatus == "ES135" ||  _l.currStatus == "ES140"){		
		//버튼이 위아래 두개 있으므로 이름으로 찾아와야함. id 로 찾으면 하나만 나옴.
		var arr_btnSawRequest = $j("input[name='btnSawRequest']");		
		if(arr_btnSawRequest.length > 0){
			arr_btnSawRequest.hide();
		}		
	}	 

	if(_l.hasRcDatePendingStatus && !_l.isSeaImAscUser){
		preventModifyPendingSO();
	}	
}

function returnOnlyAlphabet(input) {
    var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";

    for (var i = input.length -1 ; i > -1 ; i--) {
        if (chars.indexOf(input.charAt(i)) == -1){        	
        	input = input.replace(input.charAt(i), "");
        }
     }
    return input;
}
function returnOnlyNum(input) {
    var chars = "0123456789";

    for (var i = input.length -1 ; i > -1 ; i--) {
        if (chars.indexOf(input.charAt(i)) == -1){
        	input = input.replace(input.charAt(i), "");
        }
     }
    return input;
}
function ValidateEmail(inputText) {
	var mailformat = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;
	if (inputText.value.match(mailformat)) {
		return true;
	} else {
		alert(_l.u.WEB_MSG_PREFIX + "You have entered an invalid email address!");
		$j(inputText).focus();
		return false;
	}
}
