	* 미주 통합
	- RT-007
	- Assigned ASC 를 추가하여 Service Branch를 선택할 수 있도록 한다 (SEA CE & IM 동일) 								
	- Assigned ASC가 선택되면 ASC 의 Active Engineer List를 선택할 수 있도록 한다.								
	- 2015-09-14
	*/	
	if (!_l.u.isChinaRegion && (_l.useEngineer || _l.isFieldUser )) { // if ASC use engineer then check below logic
		
		if (statusCode == "ST025"
				|| (	
						_l.u.c == "C962" 
						|| _l.u.c == "C550" 
						|| (_l.isFieldUser&& (statusCode == "ST035" || statusCode == "ST040"))
					)
			) {
			
			var sENGINEER = $('sENGINEER');
			// engineer 가 없는 경우 필수 체크 하지 않음...
			if (sENGINEER.options.length == 0
					|| ( sENGINEER.options.length == 1 && sENGINEER.options[0].value == ''  )
			) {// do nothing...
			} else {
				var engObj = $('ENGINEER');
				if (engObj.value == "") {
					if (statusCode == "ST035" || statusCode == "ST040") {
						alert(_l.u.WEB_MSG_PREFIX + "Engineer code is mandatory before changing to Repair completed or goods delivered.");
					} else {
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_INPUT_00264);
					}
					moreOpenid(4);
					engObj.focus();
					return;
				}
			}
		}else if (statusCode == "ST035"){
			if(_l.u.c == "C310" && !_l.isFieldUser){
				//pass until 1st April
			}else{
				var sENGINEER = $('sENGINEER');
				// engineer 가 없는 경우 필수 체크 하지 않음...
				if (sENGINEER.options.length == 0
						|| ( sENGINEER.options.length == 1 && sENGINEER.options[0].value == ''  )
				) {// do nothing...
				} else {
					var engObj = $('ENGINEER');
					if (engObj.value == "") {
						
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_INPUT_00264);
						moreOpenid(4);
						engObj.focus();
						return;
					}
				}
			}
		}
	}// if(_l.useEngineer){ //if ASC use engineer then check below logic

