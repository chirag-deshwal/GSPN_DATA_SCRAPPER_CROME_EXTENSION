		//수정일 : 2015.10.06
		//수정자 : 채보람 (로젠 솔루션)
		//내  용 : 인도일 경우 ST035 저장시 해당 Engineer 의 출석 여부 체크
		//		   출석 여부와 Engineer 수리 날짜가 맞지 않으면 SO 저장 불가
		var userRCStatus = frm.STATUS.value;
		var toRCBIOCheck = (currStatus != userRCStatus && userRCStatus == "ST035");
		
		if(toRCBIOCheck && _l.isIndia){
			checkEngineerAttendance();
			
			if(!_l.isEngineerAttendance){
