	}
	if (_l.sawPendingOnGoodsDeilivered){ //SRZ30 은 ST040 인 경우만 체크
		if (statusCode == "ST040") {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0036);
			return;
		}
	}

	// 현 상태가 statusCode == "ST035"이면서 그대로 저장할시 //Status Repair Completed Good
	// Delivered
	if (currStatus == statusCode && statusCode == "ST035"
			&& _l.REPAIR_COMP_DATE.substr(0, 2) == "00") {
		if ($('REPAIR_COMP_DATE').value == ""
				|| !checkDate($('REPAIR_COMP_DATE').value, _l.u.DateFormat2)) {
			
			if(_l.u.isChinaRegion){				
				var REPAIR_COMP_DATE= $("REPAIR_COMP_DATE");
				var REPAIR_COMP_TIME= $("REPAIR_COMP_TIME");
				if(REPAIR_COMP_TIME != null){
					REPAIR_COMP_DATE.readOnly = "";
					REPAIR_COMP_TIME.readOnly = "";
					REPAIR_COMP_DATE.className = "input";
					REPAIR_COMP_TIME.className = "input";
					REPAIR_COMP_DATE.onClick = showCal(REPAIR_COMP_DATE);
					REPAIR_COMP_DATE.onChange = checkValidDate(REPAIR_COMP_DATE);
					// $('ICO_REPAIR_COMP_TIME').style.display="";
					REPAIR_COMP_DATE.focus();
				}				
				return;
			}else{			
				alert(_l.u.WEB_MSG_PREFIX + "Repair Completed Date does not exist. Please contact to admin.");
				return;
			}
			
		}
	}

	var isStatusDifferent = (statusCode != currStatus);
	var isServiceStarted = "|ST025|ST035|ST040|".indexOf(statusCode) > 0;
	//중국도 동일하게 사용. 글로벌은 체크로직이 서버사이드로 들어갓음.
	if (isStatusDifferent && isServiceStarted) {
		if (!validateServiceDate())
			return;
	}
	function validateServiceDate() {
		var paramMap = {};
		paramMap.STATUS = statusCode;
		paramMap.ASC_ASSIGN_DATE = $j('#ASC_ASSIGN_DATE').val();
		paramMap.UNIT_RECV_DATE = $j('#UNIT_RECV_DATE').val();
		paramMap.SERVICE_DATE = $j('#SERVICE_DATE').val();
		paramMap.ENG_ASSIGN_DATE = $j('#ENG_ASSIGN_DATE').val();
		paramMap.REPAIR_COMP_DATE = $j('#REPAIR_COMP_DATE').val();
		paramMap.FIRST_VISIT_DATE = $j('#FIRST_VISIT_DATE').val();
		paramMap.REPAIR_RECEIVED_DATE = _l.postingDate;
		paramMap.SERVICE_TYPE = $j('#SERVICE_TYPE').val();
		if(_l.u.isChinaRegion) {
			paramMap.IS_CP = isCPSo;
		}else{
			paramMap.IS_CP = "";
		}
	
		
		var isValid = true;
		$j.ajax({
			type : 'post',
			dataType : 'json',
			async : false,
			url : '/svctracking/svcorder/serviceDateValidate.gspn',
			data : paramMap,
			success : function(data) {
				if (data) {
					alert(_l.u.WEB_MSG_PREFIX + data.message);
					isValid = false;
				}
			},
			error : function(jqXHR, textStatus) {
				// console.log(textStatus);
			}
		});
		return isValid;
	}// function validateServiceDate() {
	
	
	
