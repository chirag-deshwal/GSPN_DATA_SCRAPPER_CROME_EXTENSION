			}
		}
		//=================================================================================//
		
		/** U01 Start : 2017.06.19 채보람 서남아 Demand : 인도일 경우 GD 저장시 Billing Date 와 GD Date 가 다를 경우 저장 불가. Billing Cancel 가이드 에러 메시지 호출 **/
		var currStatus = _l.CurrStatus;
		var userStatus = frm.STATUS.value;
		var transitToGD = (currStatus != userStatus && userStatus == "ST040");
		
		if(transitToGD){
			getGSTAuth();
			
			if(_l.gstFlag == "S" && _l.BILLING_DATE != "00000000"){
				var today = _l.todayUserFormat;
				var billingDate = toDisplayScreenDate(_l.BILLING_DATE, ".", _l.u.DateFormat2);
				var equalBillingGDDate = cfGetDateDiff(cfGetDate(billingDate, _l.u.DateFormat2), cfGetDate(today, _l.u.DateFormat2)) == 0;
				
				if(!equalBillingGDDate){
					alert(_l.u.WEB_MSG_PREFIX + "Billing date is not equal to Goods delivered date, cancel billing and recalculate.");
					return;
				}
			}
		}
		/** U01 End   : 2017.06.19 채보람 서남아 Demand : 인도일 경우 GD 저장시 Billing Date 와 GD Date 가 다를 경우 저장 불가. Billing Cancel 가이드 에러 메시지 호출 **/
		
	}
	
