function insertComment(msglength) {
	moreOpenid(11);
	$('messageTRObj' + msglength).toggle();
	$('msgComment' + msglength).toggle();
}

function textareaExtend(obj,event){
	if(event.keyCode==13){
	obj.style.height = (13+obj.scrollHeight);
	}else{
		return;
	}
}


function showCommentAll(option, msglength) {
	var tbodyObj = $('messageTableBody');
	var length = tbodyObj.rows.length / 2;
	moreOpenid(11);
	if (option == 1)
		$('viewAllText').innerHTML = "<input type=\"button\" onclick=\"showCommentAll(0, "  + msglength + ");\" value=\"" + _l.r.c.VIEWALL + "\">";
	else
		$('viewAllText').innerHTML = "<input type=\"button\" onclick=\"showCommentAll(1, "  + msglength + ");\" value=\"" + _l.r.c.HIDEALL + "\">";

	if (option == 1)	$j("#messageTableBody>tr:odd").hide();
	else 	$j("#messageTableBody>tr:odd").show();
	
	
	if ("C310" == _l.u.c || "C330" == _l.u.c || "C370" == _l.u.c) {
		$('messageTRObj' + msglength).hide();
		$('msgComment' + msglength).hide();
	}

}
function showComment(val) {
	$("msgComment" + val).toggle();
}

var feedbackidx;
function saveFeedback(seq, idx, interMessageType, guid) {
	if ($('inputfeedback' + idx).value.strip() == "") {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_XVALUE_00243);
		$('inputfeedback' + idx).focus();
		return;
	}
	$('progressloading').startWaiting();
	$('progressloading').style.height = self.document.body.scrollHeight;

	$('tempForm').msg_seqno.value = seq;

	if(guid != undefined && guid != ""){
		$('tempForm').msgGuid.value = guid;
	}else{
		$('tempForm').msgGuid.value = "";
	}

	$('tempForm').interMessageType.value = interMessageType;
	$('tempForm').msgText.value = $('inputfeedback' + idx).value;
	$('tempForm').cmd.value = 'ServiceOrderMsgModifyCmd';

	feedbackidx = idx;
	AjaxRequest(urlPatternGZIP, 'tempForm', setFeefback);
}

function setFeefback(response) {
	$('progressloading').stopWaiting();
	try {
		var jsonObj = eval('(' + response.responseText + ')');
		if (jsonObj.success) {

			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.SAVE);

			var TDobj = $('feedbackTD' + feedbackidx);
			var ttext = $('inputfeedback' + feedbackidx).value;
			ttext = replaceAll(ttext, '\r\n', '<br>');
			TDobj.innerHTML = ttext;

			// below logic is only for SEA C310
			if ($('tempForm').interMessageType.value == _l.CREATE_MESSAGE) {
				$('msgSeqNo' + feedbackidx).innerHTML = jsonObj.seqNo;
				$('msgCreateDate' + feedbackidx).innerHTML = jsonObj.create_dt;
				$('msgBrief' + feedbackidx).innerHTML = ttext.substring(0, 44);
				$('tableMsgInsertBtn').hide();
			}
			
		} else {
			if (jsonObj.error) {
				cfExceptionPop(jsonObj);
			}
			if (jsonObj.returnMessage)
				alert(_l.u.SAP_MSG_PREFIX + "Error. " + jsonObj.returnMessage);
		}
	} catch (e) {
	}

}

function replaceAll(s, findStr, newStr) {
	var tmpStr = s;
	while (tmpStr.indexOf(findStr) != -1)
		tmpStr = tmpStr.replace(findStr, newStr);
	return tmpStr;
}

function ancsave() {
	if (_l.canSaveANC) {
		if ($('reportedBY').value != "" && $('reportedDept').value == "") {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_INPUT_ANC_REPORTER_INFO);
			return;
		}

		if ($('ancReason').value == "") {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_SELECT_FIELD_REASON);
			return;
		}

		$('progressloading').startWaiting();
		$('detailForm').cmd.value = 'SvcAdvClmRegiCmd';

		AjaxRequest(urlPatternGZIP, 'detailForm', setAncSaveResult);

	} else {
		if ("C820" == _l.u.c){
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_ANC_SEDA);
		}else{
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0181);
		}
		initializeANC();
	}
}

function onchangeANCReason() {
	setCurrentDateTime('registeredDT', 'registeredTM');
	if ($("ancReason").selectedIndex == 0) {
		initializeANC();
	}
}

function initializeANC() {
	$("ancRemark").value = "";
	$("ancReason").selectedIndex = 0;
	$("registeredDT").value = _l.zeroDateFormat;
	$("registeredTM").value = "00:00:00";
}

function setAncSaveResult(response) {
	$('progressloading').stopWaiting();

	try {
		var jsonObj = eval('(' + response.responseText + ')');

		if (jsonObj.error) {
			cfExceptionPop(jsonObj);
			return;
		}
		if (jsonObj.success) {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.COMP_SAVE);
		} else {
			alert(_l.u.SAP_MSG_PREFIX + jsonObj.message);
		}
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + '#error AncSave#')
	}
}

/**
 * only for C310, add part from recommended part list
 */
function addPartsFromRecommended(part, type) {
	var arrParts = $j("#partsTableBody input[name='PARTS_CODE']");// cfArray(frm.PARTS_CODE);
	var arrQty = $j("#partsTableBody input[name='PARTS_QTY']");// cfArray(frm.PARTS_QTY);
	var partLen = arrParts.length;
	for ( var i = 0; i < partLen; i++) {
		if (part.strip() == arrParts[i].value.strip()) {
			alert(_l.u.WEB_MSG_PREFIX + "Selected Parts No.  "
					+ part
					+ " has already added or ordered on the Repair Part Information tab, please first check Parts No.  "
					+ part + " Quantity ");
			return;
		}
	}

	var partFlag = "N";
	if(_l.inventoryFlag){
		partFlag = "I";
	}else if(_l.FSC){
		partFlag = "F";
	}	
	addParts(partFlag);

	arrParts = $j("#partsTableBody input[name='PARTS_CODE']");// cfArray(frm.PARTS_CODE);
	arrQty = $j("#partsTableBody input[name='PARTS_QTY']");// cfArray(frm.PARTS_QTY);
	partLen = arrParts.length;
	
	arrParts[partLen - 1].value = part;
	arrQty[partLen - 1].value = "1";

	if(type != 'PROACTIVE'){
		alert(_l.u.WEB_MSG_PREFIX + part + " added!")
	}
	
	if(_l.u.isChinaRegion){
		searchHighPartsInfo(arrParts[partLen - 1]);
	}
}

