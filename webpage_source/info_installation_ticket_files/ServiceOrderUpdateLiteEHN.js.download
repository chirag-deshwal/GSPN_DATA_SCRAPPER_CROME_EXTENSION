}

// EHN15 : (customer tab 데이터 조회여부 추가)
var getCustomer = false;

/**
 * customer information *
 * EHN15 : (제어 로직 및 필드 추가)
 */
function initCustomerTab() {

	// 데이터 조회는 최초 한번만
	if (getCustomer) {
		toggleTable('Customer'); 
		return;	
	}
	getCustomer = true;

	$('progressloading').startWaiting();
	$j("#divCustomer").load(urlPatternGZIP, {
		ui : _l.ehnUI,
		isFieldUser : _l.isFieldUser,
		useEngineer : _l.useEngineer,
		isBillingSaved : _l.isBillingSaved,
		cmd : 'ZifGspnSvcCustomerLDCmd',
		objectId : _l.ObjectId,
		ascCode : _l.ASC_CODE,
		isMedisonUser : isMedisonUser,
		serviceType : $("SERVICE_TYPE").value,
		tab : '/svctracking/lite/ServiceOrderUpdateCustInfo.jsp',
		sawExistReverseVoidApproved : _l.sawExistReverseVoidApproved
	}, function() {
		//china version intergration 2016/08/09 js1.baek
		if(_l.u.isChinaRegion){
			initChCustomerInfo();
		}else{
			if ($('REGION') != null) {			
				setCodeListRegion(_l.u.CountryCd);	// C310 일 경우에만 Region 콤보가 나옴.
			}
			
			if ( canChangeCustInfoDirectly ){
				$('STREET').className = "inputIDS";
				
				$('CITY').className = "inputIDS";
				$('REGION').className = "inputIDS";
				$('POST_CODE').className = "inputIDS";			
			}			
		}//if(_l.u.isChinaRegion){
		
// if(_l.isPSApp) {
// $("d_CUSTNAME").style.display="none";
// $("CONSUMER").style.display="none";
// $("HOMEPHON_NUMBER").style.display="none";
// }
		
		//=================================================================================//
		//제  목 : 인도 Demand OTP link with GSPN
		//수정일 : 2015.09.15
		//수정자 : 채보람 (로젠 솔루션)
		//내  용 : OTP Check Function 호출 후 OTP 대상일 경우 OTP Check 버튼 활성.
		if(_l.isIndia){
			isOTPButton();
		}
		//=================================================================================//
		
		$('progressloading').stopWaiting();

		// EHN01 : display 별도 제어
		//toggleOptionTab("divCustomer");
		$j('.ser_ti').each(function() {
			$j(this).attr('title', $j(this).html());
		});

		toggleTable('Customer'); 
		$j('#CUSTOMER_FLAG').val('X');
		
		// Premium Product for India. 2019. 05. 25 j.peter.kim
		if (_l.usePremiumProduct) {
			if (_l.isPremiumProduct) {
				$j('#L_PREMIUM_PRODUCT').text(_l.r.c.LBL_06371);
			} else {
				$j('#L_PREMIUM_PRODUCT').text(_l.r.c.LBL_06372);
			}
		}

	});
};

