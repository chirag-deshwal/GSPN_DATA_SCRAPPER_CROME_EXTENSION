var MODELVERSION_inBPInfo = "";
function setCustomerInfo(jsonObjDtl, idx) {
	
	if(_l.u.isChinaRegion){
		if($j('[name="detailForm"] [name="OBJECT_ID"]').length == 1 && 
				$j('[name="detailForm"] [name="OBJECT_ID"]').val()!=''){//change order
				setCustomerInfoInDetail(jsonObjDtl,idx);
				return;
		}
	}//if(_l.u.isChinaRegion){

	var obj = jsonObjDtl.dataLists[0];
	/** setCustomerInfo* */	
	//china version intergration 2016/08/16 js1.baek
	if(_l.u.isChinaRegion){		
		/**setCustomerInfo**/
	    $j('#NAME_FIRST').val(jsonObjDtl.dataLists[0].NAME_FIRST);
	    $j('#CONSUMER').val( jsonObjDtl.dataLists[0].CONSUMER);
	    $j('#BP_TYPE_CD').val(jsonObjDtl.dataLists[0].BP_TYPE);
	    $j('#ADDRNUMBER').val(jsonObjDtl.dataLists[0].ADDRNUMBER);
	    $j('#MOBILE_NUMBER').val(jsonObjDtl.dataLists[0].MOBILE_PHONE);
	    $j('#HOMEPHON_NUMBER').val(jsonObjDtl.dataLists[0].HOME_PHONE);
	    $j('#OFFICEPHON_NUM').val(jsonObjDtl.dataLists[0].OFFICE_PHONE);
	    $j('#EMAIL').val(jsonObjDtl.dataLists[0].EMAIL) ;
	    $j('#POST_CODE').val(jsonObjDtl.dataLists[0].POST_CODE);
	    $j('#AREA_CODE').val(jsonObjDtl.dataLists[0].HOUSE_NO);
	    //주소 block
	    $j('#OFFICEPHON_NUM').attr('readOnly',true).attr('class','inputRO');
	    $j('#EMAIL').attr('readOnly',true).attr('class','inputRO');
	    $j('#POST_CODE').attr('readOnly',true).attr('class','inputRO');
	    $j('#AREA_CODE').attr('readOnly',true).attr('class','inputRO');
	    $j('#addrSearch').hide(); 
		var STATE = jsonObjDtl.dataLists[0].REGION_CODE;
		var CITY = jsonObjDtl.dataLists[0].CITY;
		var COLONY = jsonObjDtl.dataLists[0].DISTRICT;
		var STREET = jsonObjDtl.dataLists[0].STREET1;
		
		$j("#REGION").val(STATE);
		$j("select[name=CITY]").attr('length',1);
		$j("select[name=CITY]").append($j('<option value="'+CITY+'" title="'+CITY+'" selected>'+CITY+'</option>'));
		$j("select[name=DISTRICT]").attr('length',1);
		$j("select[name=DISTRICT]").append($j('<option value="'+COLONY+'" title="'+COLONY+'" selected>'+COLONY+'</option>'));
		$j("#STREET").val(STREET);
		// 주소  block..
		$j("#REGION").attr('disabled',true);
		$j("select[name=CITY]").attr('disabled',true);
		$j("select[name=DISTRICT]").attr('disabled',true);
		
	}else{//if(_l.u.isChinaRegion){
		if(bpChangeNotAllowByRelatedTicket) {
			if($j('#CONSUMER').val() != jsonObjDtl.dataLists[0].CONSUMER){//bp chage
				alert(_l.u.WEB_MSG_PREFIX + "You can't change the customer code. (Prebooking order)");
				return;
			}
		}
		if(bpChangeNotAllowCompany) {
			if($j('#CONSUMER').val() != jsonObjDtl.dataLists[0].CONSUMER){//bp chage
				alert(_l.u.WEB_MSG_PREFIX + "You can't change the customer code.");
				return;
			}
		}
		$('CONSUMER').value = obj.CONSUMER;// saved Field
		$('ADDRNUMBER').value = obj.ADDRNUMBER;// saved Field
		$('CONTACT_FLAG').value = obj.CONTACT_FLAG;// saved Field
		
		$('d_CUSTNAME').innerHTML = obj.NAME_FIRST + ' ' + obj.NAME_LAST;
		$('D_CONTACT_FLAG').innerHTML = obj.D_CONTACT_FLAG_DESC;
		$('D_SAMSUNG_ACCOUNT').innerHTML = obj.C_SA;
		$('TELTEXT').innerHTML = "[Mobile]" + obj.MOBILE_PHONE + ' / [Home]'
		+ obj.HOME_PHONE + ' / [Office]' + obj.OFFICE_PHONE;
		
		$('UNIQUE_ID').innerHTML = obj.UNIQUE_ID;
		
		if (_l.u.c == 'C820' || isEuUser) {
			$('d_STREET').innerHTML = obj.STREET1 + '&nbsp;&nbsp;' + obj.STREET2
			+ '&nbsp;&nbsp;' + obj.STREET3;
		} else {
			$('d_STREET').innerHTML = obj.STREET3 + '&nbsp;&nbsp;' + obj.STREET2
			+ '&nbsp;&nbsp;' + obj.STREET1;
		}
		
		$('d_EMAIL').innerHTML = obj.EMAIL;
		$('d_POST_CODE').innerHTML = obj.POST_CODE;
		$('City/District').innerHTML = obj.DISTRICT + '&nbsp;&nbsp;'
		+ obj.CITY_CODE + '&nbsp;&nbsp;' + obj.CITY;
		$('State/Country').innerHTML = obj.REGION_CODE + '&nbsp;&nbsp;'
		+ obj.REGION + '&nbsp;&nbsp;' + obj.COUNTRY;
		
	}//if(_l.u.isChinaRegion){


	/* setModelInfo */
	if (idx > -1) {
		chkFromPop = true;
		var prodObj = jsonObjDtl.productlists[idx];
		$("detailForm").MODEL.value = prodObj.MODEL;
		$('detailForm').SERIAL_NO.value = prodObj.SERIAL_NO;
		//IMEI PROJECT
		if(isAutoImei){
			$('detailForm').IMEI_TXT.value = markIMEI(prodObj.IMEI);
			$('detailForm').IMEI.value = prodObj.IMEI;
		}else{
			$('detailForm').IMEI.value = prodObj.IMEI;
		}

		
		tmpImei = prodObj.IMEI;
		$('detailForm').PURCHASE_DATE.value = prodObj.PURCHASE_DATE;
		$('detailForm').TERM_LABOR.value = prodObj.LABOR_TERM;
		$('detailForm').TERM_PARTS.value = prodObj.PARTS_TERM;

		MODELVERSION_inBPInfo = prodObj.VERSION;
		searchModelInfo();// model research
	}
	
	//=================================================================================//
	//제  목 : 인도 Demand OTP link with GSPN
	//수정일 : 2015.09.15
	//수정자 : 채보람 (로젠 솔루션)
	//내  용 : 인도일 경우 OTP 체크 대상 여부 판단.
	if(_l.isIndia){
		changeOTPCheck();
		

		//=================================================================================//
		//제  목 : 인도 Demand OTP link with GSPN
		//수정일 : 2015.09.15
		//수정자 : 채보람 (로젠 솔루션)
		//내  용 : mobile Number 담기
		if(isOTPShowSVCType()){
			_l.mobile_phone = obj.MOBILE_PHONE;
		}
		//=================================================================================//
		
	}
	//=================================================================================//
	if(_l.u.isChinaRegion){
		
	    var bp_type = jsonObjDtl.dataLists[0].BP_TYPE;
	    if(bp_type==''||bp_type=='B003'){
	    	$j('#i_cust_tbl').show();
	    	$j('#spanCheckSame').hide();
	    	$j('#i_cust_tbl [type=text]').each(function() {
//	    		if(this.name!='END_NAME_FIRST')
//	    			$j(this).attr('readOnly',true).attr('class','inputRO');
				$j(this).val('');
			});
	    	$j('#i_cust_tbl select').each(function() {
				//$j(this).attr('disabled',true);
	    		$j(this).val('');
			});
	    }else{
	    	$j('#i_cust_tbl').hide();
	    	if($j('#SERVICE_TYPE').val()=='II'){
	    		$j('#spanCheckSame').show();
	    		$j('#checkSame')[0].checked = true;
	    	}
	    	$j('#i_cust_tbl [type=text]').each(function() {
				$j(this).val('');
				//$j(this).attr('readOnly',false).attr('class','input').val('');
			});
	    	$j('#i_cust_tbl select').each(function() {
				$j(this).val('');
				//$j(this).attr('disabled',false);
			});
	    }
	    
	    if(bp_type ==''){//b2b contact person 
			$j('#div_related_bp').show();
			search_related_bpByBpNo(jsonObjDtl.dataLists[0].RELATED_BP);
		}else{
			$j('#div_related_bp').hide();
		}
	    
	    if(isNewChina){
	    	changeC6V0Asc_codeObj();
	    }
	}
	
}

// EHN15 : (product tab 데이터 조회여부 추가)
var getProduct = false;

/**
 * product information *
 * EHN15 : (제어 로직 및 필드 추가)
 */
function initProductTab() {

	// 데이터 조회는 최초 한번만
	if (getProduct) {
		toggleTable('Product'); 	
		return;
	}	
	getProduct = true;

	$('progressloading').startWaiting();
	$j("#divProduct").load(
			urlPatternGZIP,
			{
				ui : _l.ehnUI,
				hqSvcProd : _l.hqSvcProd,
				adhFlag : _l.ADH_FLAG,
				certiNo : _l.CERTI_NO,
				damageExplanation : _l.damageExplanation,
				lossTypeId : _l.lossTypeId,
				claimInsuNo : _l.claimInsuNo,
				policyId : _l.policyId,
				packBase : _l.packBase,
				chargeType : _l.chargeType,
				chargeAmount : _l.chargeAmount,
				chargeWaers : _l.chargeWaers,
				rType : _l.rType,
				sCompany : _l.sCompany,
				salesBuyer : _l.salesBuyer,
				cmd : 'ZifGspnSvcProductLDCmd',
				objectId : _l.ObjectId,
				tab : '/svctracking/lite/ServiceOrderUpdateProdInfo.jsp',
				CREATE_DATE : 	_l.CREATE_DATE,
				sawExistCompressorSerialApproved : _l.sawExistCompressorSerialApproved,
				sawExistSerialNoValidationApproved : _l.sawExistSerialNoValidationApproved,
				dealerJobNo : _l.dealerJobNo,
				stdProd : _l.stdProd
				//wtyTermRemark : _l.wtyTermRemark
			},
			function() {

				// EHN15 : field control
				serviceTypeChangeEHN($("SERVICE_TYPE").value, true);
				modelChangeEHN(_l.CIC_PRCD, true);				

				if(_l.u.isChinaRegion){
					initChProductInfo();
				}else{
					
					$("detailForm").MODEL.className = "inputIDS";
					
					initializePurchaseDate('#PURCHASE_DATE');
					initializeBOS(); // bos.jspf
					getManagedSvc();
					// 갤럭시S7 로열티 쿠폰 2016.03.22 jiw
/*					if(_l.useLoyaltyCheck){
						$('btnLoyalty').show();
					}
*/
					//=================================================================================//
					//제  목 : 인도 Demand OTP link with GSPN
					//수정일 : 2015.09.15
					//수정자 : 채보람 (로젠 솔루션)
					//내  용 : Customer Tab 실행 시 OTP 대상 여부 체크
					if(_l.isIndia){
						initOTPCheck();
					}
					//=================================================================================//
					
					if("C330" == _l.u.c || "C540" == _l.u.c || _l.u.subRegionCd == "EU"){ 
						carrierCodeGroupSearch();
					}
					
					if(manageE_Warranty){ 
							$('detailForm').EWTY_YN.value = ("X"==_l.EWTY_FLAG)?"Y":"N";
					}
					
					//var checkD2D = $("STATUS").value == "ST015" && _l.SERVICE_TYPE == "PS" && D2D 체크로직 추가;
					var checkD2D = _l.isIndia && _l.isHHPIndia && $("STATUS").value == "ST015" && _l.SERVICE_TYPE == "PS" && _l.shipMethod == "01";
					
					if(!checkD2D){
						serialReadOnly(true);
					}
					
					if(_l.currStatus == "ST040" || _l.currStatus == "ST035"){
                        $j("#wtyCheckBtn").hide();
                    }
					
					if(_l.useGMESHHPByIMEI || "C5A0" == _l.u.c || "C713" == _l.u.c || "C770" == _l.u.c || "C780" == _l.u.c){
							if(_l.COUNTRY=="" && _l.isWorkingMPTS || (("C713" == _l.u.c || "C770" == _l.u.c || "C780" == _l.u.c) && _l.IMEI != "")){
								imeiChange("I");
							}else{
									isReturnedGMES = true;
									if(!("C770" == _l.u.c || "C780" == _l.u.c)){
										if(_l.WTY_EXCEPTION == "VOID4" || _l.WTY_EXCEPTION == "VOID6"){
											$('detailForm').WTY_EXCEPTION.disabled = true;
										}
									}
							}
							if(_l.currStatus == "ST040" || _l.currStatus == "ST035"){
								$('detailForm').WTY_EXCEPTION.disabled = true;
							}
					}// if(_l.useGMESHHPByIMEI){
					
					var SVC_PRCD = _l.SVC_PRCD;
					if("C550" == _l.u.c 
							&& SVC_PRCD.length >= 3 && "CTV" == SVC_PRCD.substring(0,3)

							&& "VOID4" == _l.WTY_EXCEPTION){

						$('detailForm').WTY_EXCEPTION.disabled = "";

					}
					
					var repairCode = $('IRIS_REPAIR').value;
					if("C820" == _l.u.c && _l.sawExistVoidApproved && (repairCode == "R32" || repairCode == "X09"))
					{
						$('detailForm').WTY_EXCEPTION.disabled = true;
					}
					
					
					if("C550" == _l.u.c && SVC_PRCD.length >= 3 && "HHP" == SVC_PRCD.substring(0,3)){
							$('detailForm').PURCHASE_DATE.className = "inputRO";
					}
					
					if(_l.u.c =="C550" && ($("SERVICE_TYPE").value =="DM" || $("SERVICE_TYPE").value =="II")){
							var creationBefore180Date = _l.CREATE_DATE_180;
				        	if( !checkFromToDate($('PURCHASE_DATE').value, creationBefore180Date, _l.u.DateFormat2)){
									if($('detailForm').WTY_EXCEPTION.value == "VOID5"){
										alert(_l.u.WEB_MSG_PREFIX + "Demo/Installation service already provided for this unit, this time it will be on chargeable basis.");
										$('detailForm').WTY_EXCEPTION.disabled = true;
									}
							}
			        }
					
					if(_l.useSwapHistory 
							&& SVC_PRCD.length >= 3
							&& ("HHP" == SVC_PRCD.substring(0,3) || "PRT" ==  SVC_PRCD.substring(0,3))
					){
						$('tdSwapHistoryBtn').show();
					}
					
					if(_l.u.c =="C310" || _l.u.c =="C370"){
							// $('tdPartInfo').show();
							if(_l.DISPLAY_UNIT != ""){
								$('DISPLAY_UNIT_CHECK').checked = true;
							}
							if(_l.u.c == "C310") setPRCExtensionCheck();
							searchOnlyModelInfo();
					}
					// 휴대폰 모델 조건 추가 2015.07.23 jiw
					if (_l.useMobileInterface && isMIFCheckModel) {
							if ("Y" == _l.MB_IF_YN) {
								$j(document.detailForm.MODEL).removeClass().addClass("inputRO").prop("readonly", true);
								$j(document.detailForm.SERIAL_NO).removeClass().addClass("inputRO").prop("readonly", true);
								//IMEI PROJECT
								if(isAutoImei){
									$j(document.detailForm.IMEI_TXT).removeClass().addClass("inputRO").prop("readonly", true);
								}else{
									$j(document.detailForm.IMEI).removeClass().addClass("inputRO").prop("readonly", true);
								}

							}// if("Y" == _l.MB_IF_YN){
		
							if ("Y" == _l.MB_IF_RT_YN) {
								$j(document.detailForm.WTY_EXCEPTION).disable = true;
							}// if("Y" == _l.MB_IF_RT_YN){
							
							// checkMIFModel();
					}// if(_l.useMobileInterface){
					if(_l.sawExistSerialNoValidationApproved && "C550" == _l.u.c){
						$j(document.detailForm.SERIAL_NO).removeClass().addClass("inputRO").prop("readonly", true);
						if(!(_l.currStatus == "ST070" || _l.currStatus == "ST035")){
							$j("#aSerialSearch").hide();
						}
					}
					// if(_l.isPSApp &&
					// "ST030,ST035,ST040".indexOf($j("#STATUS").val()) == -1) {
					// $j("#SERIAL_NO,#IMEI").removeClass().addClass("inputRO").prop("readonly",
					// true);
					// $j("#aSerialSearch").hide();//SERIAL_NO_ICON
					// }
					
					// EHN22
					/*
					if (_l.useMobileInterface && !_l.useFenrirCheck) {
						if (isMIFCheckModel && ($("SERVICE_TYPE").value == "CI" || $("SERVICE_TYPE").value == "PS" || $("SERVICE_TYPE").value == "SR" || (_l.u.c == 'C720' && $("SERVICE_TYPE").value == "IU"))) {
							$j("#tabProdTitle").css("display","inline");
						} else {							
							$j("#tabProdTitle").css("display","none");
						}
					}
					*/
					if (_l.u.c == 'C310' || _l.u.c == 'C370') {
						$j("#spanWtyTermRemark").text(_l.wtyTermRemark);
					}
					
					if(_l.u.c == 'C310' || _l.u.c == 'C330' || _l.u.c == 'C370'){
						$('spanRecallFlag2').innerHTML = "<font color=red><b>"+$('spanRecallFlag').innerText+"</b></font>";
					}
					
				}//if(_l.u.isChinaRegion){	
				
				// Care Pack 고도화 - 2017.03 - Start //
				//if(_l.isCarePackService){
					if($("SERVICE_TYPE").value == "AD"){
						if(_l.owPackFlag == "X" || _l.u.c == "C820" || _l.u.c == "C5A0"){
							setComboValue($('detailForm').WTY_EXCEPTION, $('WTY_EXCEPTION').value);
						}else{
							$('WTY_EXCEPTION').value = "";
						}
						$j("#WTY_EXCEPTION").removeClass().addClass("inputRO").prop("readonly", true).prop("disabled", true);
						$j('#MODEL').removeClass().addClass("inputRO").prop("readonly", true);
						$j('#SERIAL_NO').removeClass().addClass("inputRO").prop("readonly", true);
						//IMEI PROJECT
						if(isAutoImei){
							$j('#IMEI_TXT').removeClass().addClass("inputRO").prop("readonly", true);
						}else{
							$j('#IMEI').removeClass().addClass("inputRO").prop("readonly", true);
						}


					}
				//}
				// Care Pack 고도화 - 2017.03 - End //
				if(isEaUser || isEuUser || isMeaUser){
					$j('#trPACKINFO').show();
				}else{
					$j('#trPACKINFO').hide();
				}
					$('progressloading').stopWaiting();

				// EHN01 : display 별도 제어
				//toggleOptionTab("divProduct");
				$j('.ser_ti').each(function() {
					$j(this).attr('title', $j(this).html());
				});
	
				// Care Pack 고도화 - 2017.03 - Start //
				if(_l.ADH_FLAG=="X"){
					$j("#adhPackConfirmArea").show();
					$('adhPackConfirmCheck').checked = true;
					//selectAD();
		            if ("X" == _l.smcFlag){
		            	$('adhPackConfirmBtn').innerHTML = "<A href=\"javascript:adhPackInfoSearch();\">SC+ Confirm</A>";
		                $('adhPackConfirmDesc').innerHTML = "SC+ Confirm";
		            }
					if(_l.SERVICE_TYPE == "AD"){
						selectAD();
						if((_l.owPackFlag == "X" || _l.u.c == "C820" || _l.u.c == "C5A0") && "ST015,ST025,ST030".indexOf(_l.CurrStatus) != -1){
							$j("#WTY_EXCEPTION").removeClass().addClass("inputRO").prop("readonly", false).prop("disabled", false);
						}
					}
				}
				// Care Pack 고도화 - 2017.03 - End //

				toggleTable('Product'); 
				$j('#PRODUCT_FLAG').val('X');
				
				//WTY_EXCEPTION
				var isUseGCICOversea = true;
				if(_l.useMPTSOversea){
					if ($j("#overseas").val() == "Y") {
			        	isUseGCICOversea = true;
			        }else{
			        	isUseGCICOversea = false;
			        }
				}
		      	//VOID5 Mark
				if(_l.disabledWtyException == "X" && isUseGCICOversea){
					$('WTY_EXCEPTION').value = _l.newWtyException;
					$j("#WTY_EXCEPTION").removeClass().addClass("inputRO").prop("readonly", true).prop("disabled", true);
				}
				
				if(isEuUser && _l.sawExistReverseVoidApproved){
					$j("#WTY_EXCEPTION").removeClass().addClass("inputRO").prop("readonly", true).prop("disabled", true);
				}
				
				if(_l.eulaFlag != ""){
					$j("#trEULAINFO").css("display","");
					$j("#spanBasicDate").text("Basic Date");
					$j("#PURCHASE_DATE").datepicker("destroy");
					$j('#PURCHASE_DATE').removeClass().addClass("inputRO").prop("readonly", true);
				}
				
				// C21060003990 Request to roll out changes for VOID4 selection in GSPN (Attached VOC)
				setModuleId();
				setRank();
				//C310, C370은 위에서 searchOnlyModelInfo()호출
				if (_l.u.c != 'C310' && _l.u.c != 'C370') {
					getModelVersion();
				}
			});
};

function initializePurchaseDate(obj) {
	if (_l.purchaseDateReadOnly) {
		setDateReadOnly(obj, true); // date.js
	} else {
		setDatepicker(obj); // date.js
	}
}

var dateFormat = _l.u.DateFormat;
var bosDeleteSuccessMsg = _l.r.m.MSG_0064;
function initializeBOS() {
	if (_l.u.c == 'C310' || _l.u.c == 'C370') {
		if(_l.u.c == 'C310'){
			var serviceType = $("SERVICE_TYPE").value;
			if(serviceType == "SR" || serviceType == "SI"){
				$j('#tdBOS').hide();
			}else{
				$j('#tdBOS').show();
				displayBosAtt(); // bosAttachment.js
			}
		}else if(_l.u.c == 'C370'){
			if (_l.BosBusiness_wisCollects) {				
				$j('#tdBOS').show();				
				displayBosAtt(); // bosAttachment.js
			}						
		}
	}else{
		if ("Y" == _l.BOS_FLAG) {

			$j('#tdBOS').show();

			displayBosAtt(); // bosAttachment.js
		}
	}		

	
	// =================================================================================//
	// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
	// Activation
	// 수정일 : 2015.04.28
	// 수정자 : 채보람 (로젠 솔루션)
	// 내 용 : 인도이고 _l.SVC_PRCD == "HHP01", "HHP05", "HHP06" 일때 PURCHASE_DATE 를
	// 수정못하게함
	if((_l.isIndia || _l.isBangladesh || _l.isSrilanka || _l.isNepal) && _l.isHHPIndia){	// add BD
		_l.bosAttachFlag = "";
		
		if(_l.SERVICE_TYPE == "CI"){
			$j("#PURCHASE_DATE").datepicker("destroy");
			$j("#PURCHASE_DATE").attr("readonly", "readonly");
			
			$j("#MODEL").attr("readonly", "readonly");
			$j("#MODEL").parent().find("img").remove();
			$j("#MODEL").parent().find("a").remove();
			
			$j("#SERIAL_NO").attr("readonly", "readonly");
			$j("#SERIAL_NO").parent().find("a").remove();
		}
		
		if(_l.SERVICE_TYPE == "SR" || _l.SERVICE_TYPE == "SH" || _l.SERVICE_TYPE == "IH" || _l.SERVICE_TYPE == "RH"){
			$j("#PURCHASE_DATE").datepicker("destroy");
			$j("#PURCHASE_DATE").attr("readonly", "readonly");
		}
		
		//var checkD2D = $("STATUS").value == "ST015" && _l.SERVICE_TYPE == "PS" && D2D 체크로직 추가;
		var checkD2D = _l.isIndia && _l.isHHPIndia && $("STATUS").value == "ST015" && _l.SERVICE_TYPE == "PS" && _l.shipMethod == "01";
		
		if(_l.SERVICE_TYPE != "IH" && !checkD2D){
			//IMEI PROJECT
			if(isAutoImei){
				$j("#IMEI_TXT").attr("readonly", "readonly");
			}else{
				$j("#IMEI").attr("readonly", "readonly");
			}
		}
		
		$j("#tableSIMBtn").show();
		
		// ZIF_GSPN_SVC_SIM_ACT_INFO 펑션 호출
		initSearchSim();
	}
	// =================================================================================//
}

function getRank(){
	
	if(_l.blockRankFuncCall){
		return;
	}
	
	if($("SERIAL_NO").value == ""){
		//alert("Please input the Serial no for getting managed svc info.");
		return;
	}
	if($("MODEL").value == ""){
		//alert("Please input the Model code for getting managed svc info.");
		return;
	}
	
	var model = $('MODEL').value;
	var modelCode = model.substring(0, 3);
	
	if(modelCode != "MNA"){ //Micro LED 제품에 해당할 경우 (모델코드 : MNA****) Rank # 함수 호출
		$("divRank").style.display='none';
		return;
	}else{
		$("divRank").style.display='';
	}
	
	$('progressloading').startWaiting();
	//$('detailForm').IV_PRODSN.value = $("SERIAL_NO").value;
	$('detailForm').cmd.value = 'ZifGspnSvcGetRankCmd';
	AjaxRequest(urlPatternGZIP,"detailForm", setRankResult);
	
}

function setRankResult(response){
	var jsonObjRank = response.responseText.evalJSON();
	
	if(jsonObjRank.success && jsonObjRank.returnCode == "S"){

		var len = jsonObjRank.etTable.length;
		
		if(len > 0) {
			for(var i=0; i<len; i++) {
				var unitId = jsonObjRank.etTable[i].UNITID;
				if(unitId != null && unitId != ""){
					var unitIdCode = unitId.substring(1,3);
					
					if(unitIdCode == "C2" || unitIdCode == "M1"){
						var unitSn = jsonObjRank.etTable[i].UNIT_SN;
						var unitSnCode = unitSn.substring(14,24);
						$("RANK_NO").value = unitSnCode;
						break;
					}else{
						$("RANK_NO").value = "";
					}
				}else{
					$("RANK_NO").value = "";
				}
			}
		} else {
			$("RANK_NO").value = "";
		}

		$('progressloading').stopWaiting();
	}else{
		//alert(jsonObj.returnMessage);
		$("RANK_NO").value = "";
		$('progressloading').stopWaiting();
	}
}

//managed svc 정보 import 2016.02.22 jiw
function getManagedSvc(){
 	if($("SERIAL_NO").value == ""){
		//alert("Please input the Serial no for getting managed svc info.");
		return;
	}
	if($("MODEL").value == ""){
		//alert("Please input the Model code for getting managed svc info.");
		return;
	}
	$('detailForm').cmd.value = 'ZifGspnSvcGetManagedSvcCmd';
	AjaxRequest(urlPatternGZIP,"detailForm", setManagedSvc);
	$('progressloading').startWaiting();
}
    
function setManagedSvc(response){
	var jsonObj = response.responseText.evalJSON();
	if(jsonObj.success){
		$("MANAGED_SVC_CODE").value = jsonObj.topCode;
		var managedSvcDesc = "";
		for(var i=0; i<jsonObj.etSlaDataList.length; i++){
			if(i==0){
				managedSvcDesc = jsonObj.etSlaDataList[i].CONTRACT_DESC;
			}else{
				managedSvcDesc = managedSvcDesc + ", " + jsonObj.etSlaDataList[i].CONTRACT_DESC;
			}
		}
		$("MANAGED_SVC_DESC").value = managedSvcDesc;
		$('progressloading').stopWaiting();
	}else{
		//alert(jsonObj.returnMessage);
		$("MANAGED_SVC_CODE").value = "";
		$("MANAGED_SVC_DESC").value = "";
		$('progressloading').stopWaiting();
	}
}

function modelChange() {
	setCheckWtyTrue();
	searchModelInfo();
	getEngineerList();
	isGetAvailQty = false;// WIS
}

// 로열티앱 연계 2016.03.07 jiw
function loyaltyMemPop(){
	if($("IMEI").value == ""){
		alert(_l.u.WEB_MSG_PREFIX + 'Please input IMEI first.');
		return;
	}
	
	var url = "/svctracking/common/LoyaltyMemPop.jsp";
	url = url + "?imei=" + $('detailForm').IMEI.value;
	w = window.open(url, "", 'toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=no,top=150,left=200,width=1000,height=350');
}

function getModelBySerialForMedison(){	
	$('progressloading').startWaiting();
	$j.post('/svctracking/svcorder/modelBySerialForMedison.gspn', $j("#detailForm").serialize(), function(json){
		
		$('progressloading').stopWaiting();
		
		if( json.model && json.model.length > 5){}else{return;}
		
		$j("#MODEL").val(json.model);
		modelChange();
		
	} , 'json');
	
}

function getModelVersion() {
	if(_l.u.isChinaRegion) {
		if ($("detailForm").MODEL.value.trim() == '') {
			return;
		}
		//2025.10.01 HAICC-11335 GSPN 접수화면 Model Version로직 개선
		var tempModelDesc = $('detailForm').MODEL_DESC.value;
		$('detailForm').MODEL_DESC.value = tempModelDesc.replace(/\s/gi," ");
	} else {
	    if ($('MODEL').value == '') {
	        return;
	    }
	}
	MODELVERSION_inBPInfo = _l.modelVersion;
	$('detailForm').cmd.value = 'ServiceOrderModelSearchCmd';
	AjaxSyncRequest(urlPatternGZIP, "detailForm", setJsonObjectModelVersion);
}

function setJsonObjectModelVersion(response) {
	try {
		var jsonObject = eval('(' + response.responseText + ')');
		setModelVersion(jsonObject,0);
	} catch (e) {}
}

function searchModelInfo() {

	if(_l.u.isChinaRegion){
		if ($("detailForm").MODEL.value.trim() == '') {
			return;
		}
		if(searchedModel == $('MODEL').value.trim()){
			return;
		}
		if(calledGMESBySerialButNoData){
			resetImeiSerial();
		}
		wtyInfoReset();
		$('detailForm').MODEL_DESC.value = '';		
		$('MODEL_NAME').value = '';
	}else{
	    if ($('MODEL').value == '') {
	        return;
	    }
	}
	
	$('detailForm').cmd.value = 'ServiceOrderModelSearchCmd';
	AjaxSyncRequest(urlPatternGZIP, "detailForm", setJsonObjectModel);
}
function setJsonObjectModel(response, validImeiModelChange) {
	try {
		var jsonObjM = eval('(' + response.responseText + ')');

		if (jsonObjM.success) {
			checkWarranty = true;
			
			if(_l.u.isChinaRegion){				
				if(jsonObjM.etModelInfoList.length > 1 ){
					if(calledGMESBySerialButNoData){
						resetImeiSerial();
					}
					searchPopModel();
					return;
				}else{
					setModelInfo(jsonObjM,0,validImeiModelChange);					
				}

				initRank();
				
				if (_l.canUseIqcGd || _l.canUseOqcGd) {
					checkDiagnosticModel();
				}
			}else{
				setModelInfo(jsonObjM, 0);
				
				initRank();
				
				serialReadOnly(true);
				//IMEI PROJECT
				if(isAutoImei){
					$("IMEI").value = "";
					$("IMEI_TXT").value = "";
				}else{
					$("IMEI").value = "";
				}


				if(chkFromPop == true && tmpImei != ""){
					//IMEI PROJECT
    				if(isAutoImei){
    					$("IMEI").value = tmpImei;
    					$("IMEI_TXT").value = markIMEI(tmpImei);
    				}else{
    					$("IMEI").value = tmpImei;
    				}
                	chkFromPop = false;
                	tmpImei = "";
                	imeiChange();
                }
				// 모델 변경시 엔지니어 초기화
				if (_l.u.c == "C550") {
					$('ENGINEER').value = "";
					$('ENGINEERNAME').innerHTML = "";
				}
				// 모델 변경시 엔지니어 그룹 다시 검색 2010-11-11
				getSvcEngineerSearch();
				// SEA ServiceType Default Setting K.H
				if (_l.u.c == "C310" || _l.u.c == "C370") {
					getDefaultServicetype();
				}
				
				if (_l.useGMESHHPByIMEI) {
					serialReadOnly(false);
					
					/*
					 * in case of HHP wty exception is set-uped by Mobile IMEI check
					 * logic, so there is no choice by user
					 */
					// var svcProd = $("SVC_PRCD").value;
					// var isHHPProduct = ("HHP01" == svcProd || "HHP02" == svcProd
					// || "HHP05" == svcProd);
					// if("IN" == "<%=userVO.getCountryCd()%>" && isHHPProduct){
					// $('detailForm').WTY_EXCEPTION.disabled = true;
					// }
				}
				
				// if(_l.isPSApp && checkStatusMGSPNTicket) {
				// $j("#SERIAL_NO,#IMEI").removeClass().addClass("inputIDS").prop("readonly",
				// false);
				// $j("#aSerialSearch").show();//SERIAL_NO_ICON
				// }
				
				if(jsonObjM.etModelInfoList.length > 0){				
					var info = jsonObjM.etModelInfoList[0];				
					if (_l.useSwapHistory) {
						if (info.local_svc_prod.substring(0, 3) == "HHP"
							|| info.local_svc_prod.substring(0, 3) == "PRT") {
							$('tdSwapHistoryBtn').show();
						}
					}
				}
			}//if(_l.u.isChinaRegion){
						
			if (_l.canUseIqcGd || _l.canUseOqcGd) {
				checkDiagnosticModel();
			}
		} else {
			
			if(_l.u.isChinaRegion) resetImeiSerial();
			
			if (jsonObjM.error) {
				cfExceptionPop(jsonObjM);
			} else {
				if (jsonObjM.returnMessage != '')
					alert(_l.u.SAP_MSG_PREFIX + jsonObjM.returnMessage + ":" + $j("#MODEL").val());
				else
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.ERROR);
			}
			setModelInfo(jsonObjM, 0);
			// alert('<%=resource.getMessage("MSG/NOTFOUND")%>');
			initRank();
		}
	} catch (e) {
	}
}

function setModelInfo(jsonObject, idx, validImeiModelChange) {

	//중국은 안탐, 글로벌 대부분 법인이 사용.
	if (isIrisFiltering) {
		clearIRISCode();
	}

	if (jsonObject.success) {
		
		var info = jsonObject.etModelInfoList[idx];

		// EHN15 : filed control
		modelChangeEHN(info.prod_category, false);
		
		// START : C20090003013 [SEAU] Sero QLED TV - Warranty labour rate
		// OLEDTV 모델일때 SVC_INDICATOR 값 고정시키도록 설정하기 위해 호출
		if(isQledTvCorp()){
			getServiceIndicator();
		}

		$("detailForm").MODEL.value = info.model;
		checkWarranty = true;
		if(_l.u.isChinaRegion){
			
			if(!validImeiModelChange) {
				if(calledGMESBySerialButNoData){
					resetImeiSerial();
				}
			}
			if(jsonObject.etModelInfoList[idx].B2B_FLAG !=''){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0464/*B2b Model*/);
			}
			$('MODEL_NAME').value = info.model_name;			
			
			/*
			 standard product : EBA0A  == HQ_SVC_PRCD
             svc product2       : THBB6  == SVC_PROD, local_svc_prod
             cic product          : HHP     == PROD_CATEGORY 
			 * */
			//중국 오투워런티 체크로직에서 사용하기 위해 추가함. 
			//워런티 화면의 모델 검색시  아래 파라미터들이 hidden 으로 가짐.
			//글로벌은 prod_category 히든 이용. 같은 값임.
			//$j("#PROD_CATEGORY").val(jsonObj.etModelInfoList[0].prod_category); 
	        
			//setDistanceCombo(), setGasChargeCombo() 에서 RH경우 $j("#SUB_CATEGORY").val() == jsonOther.rhOtherAmt[i].codeId 이면,
			//distance, gaschareg 를 숨기기 처리함.
			// SUB_CATEGORY 대신 LOC_PRCD 를 사용ㅎ면됨, 같은 값임.
			//$j("#SUB_CATEGORY").val(info.sub_category);
			
			//rfc 필드 local_svc_prod 와 SVC_PROD 같은 값이므로, 
			//LOCAL_SVC_PROD,SVC_PROD,HQ_SVC_PRCD 는  SVC_PRCD 를 사용하면 된다. 같은 값을 가지고 있다.
	        //$j("#LOCAL_SVC_PROD").val(jsonObj.etModelInfoList[0].local_svc_prod);
	        //$j("#SVC_PROD").val(jsonObj.etModelInfoList[0].SVC_PROD);			
	        //$j("#HQ_SVC_PRCD").val(jsonObj.etModelInfoList[0].SVC_PROD);
			
			

			
			
			
		}else{
			$("detailForm").SERVICE_COMPANY.value = info.serviceCompany;			
		}//if(_l.u.isChinaRegion){
		$('MODEL_NAME').value = info.model_name;
		$("detailForm").MODEL_DESC.value = info.model_desc;
		$("detailForm").MODEL_DESC.title = info.model_desc;
		$("detailForm").prod_category.value = info.prod_category;
		// $("detailForm").prod_category_desc.title=info.prod_category_desc;
		$("detailForm").LOC_PRCD_DESC.value = info.sub_category_desc;
		$("detailForm").SVC_PRCD_DESC.value = info.local_svc_prod_desc;
		$("detailForm").SVC_PRCD.value = info.local_svc_prod;
				
		
		if(_l.u.isChinaRegion){
			$j("[name=detailForm] [name=LOC_PRCD]").val(info.sub_category);
			$j("[name=detailForm] [name=HQ_SVC_PRCD]").val(info.SVC_PROD);			
		}else{
			$("detailForm").HQ_SVC_PRCD.value = info.hq_svc_prod;	
		}
		
		// EWP popup 2016.08.05 jiw
		//글로벌만 사용하는 필드로, 중국은 X가 절대 안나오므로 타지 않음.
		if(info.ewp_flag == 'X'){
			var popUrl = "/img/EWPpop.html";
			var popOption = "width=700, height=420, resizable=no, scrollbars=no, status=no;";    //팝업창 옵션(optoin)
				window.open(popUrl,"",popOption);
		}
		
		if(!_l.isPSApp) {
			if(info.service_type !="" && $('SERVICE_TYPE').value ==""){
				setComboValue($('SERVICE_TYPE'), info.service_type);
			}
		}
		
		if(_l.u.isChinaRegion){		
			$j('#COLOR').val(info.color);
			$j('#ETCHING_FLAG').val(info.ETCHING_FLAG);
			$j('#B2B_FLAG').val(info.B2B_FLAG);
		}else{
			symtomCodeSearch1(_l.MODEL);
			// serviceOrderWtyCheck();

			blockEntryOfDefectType();//C550
			if (isIrisFiltering) {
				$('tempForm').cicProd.value = $("detailForm").prod_category.value;
				getCodeGroup();
				getIRIS("IRIS-E");
			}
			
			var mptsPrdCodeList = _l.r.c.MPTS_PRD_CODE_LIST.evalJSON();
			var svcProd = info.local_svc_prod;
			if(_l.useHrPrdCodeMPTS){
				svcProd = info.hq_svc_prod;
			}
			var isHHPProduct = false;
			for(var i=0; i<mptsPrdCodeList.length; i++){
				if(svcProd == mptsPrdCodeList[i].codeId){
					isHHPProduct = true;
					break;
				}
			}			
		}//if(_l.u.isChinaRegion){
	} else {
		
		$("detailForm").prod_category.value = '';
		$("detailForm").MODEL_DESC.value = '';
		$("detailForm").SVC_PRCD_DESC.value = '';
		$("detailForm").LOC_PRCD_DESC.value = '';
		if(_l.u.isChinaRegion){
			$('MODEL_NAME').value = '';
			$("detailForm").prod_category.value = '';
			$j("[name=detailForm] [name=LOC_PRCD]").val('');
			$("detailForm").SVC_PRCD.value = '';
			$j("[name=detailForm] [name=HQ_SVC_PRCD]").val('');
		}else{
			$("detailForm").SERVICE_COMPANY.value = '';
			$j("#SYMPTOM_CAT1,#SYMPTOM_CAT2,#SYMPTOM_CAT3").empty().append("<option value=''>- None -");
			
			if (_l.u.c == 'C310') {
				$j("#SYMPTOM_CAT4").empty().append("<option value=''>- None -");
			}			
		}//if(_l.u.isChinaRegion){
		

		wtyInfoReset();
	}

	if(_l.u.isChinaRegion){
		searchedModel = $j('#MODEL').val();
		cloneExeptModel(jsonObject);
		
		try {setModelVersion(jsonObject,idx);} 
		catch (e) {alert(_l.u.WEB_MSG_PREFIX + 'setModelVersion error');}
		
		if(!validImeiModelChange) processAfterModelChange();
		
		if(isNewChina && $('SERVICE_TYPE').value == "II"){
			if("LED|PDP|LTV".indexOf($('SVC_PRCD').value.substring(0,3)) > -1){
				if(_l.isSawOTWE1Approved) {
				} else {
					$j("#WTY_EXCEPTION").find("option:[value=OTWE1]").remove();
				}
			}	
		}
	}else{
		if(!isHHPProduct){
			isHHPProduct = ("HHP01" == svcProd || "HHP02" == svcProd);
		}
		if (isHHPProduct){
			//IMEI PROJECT
			if(isAutoImei){
				$('IMEI_TXT').className = "inputIDS";
			}else{
				$('IMEI').className = "inputIDS";
			}
		}else{
			//IMEI PROJECT
			if(isAutoImei){
				$('IMEI_TXT').className = "input";
			}else{
				$('IMEI').className = "input";
			}
		}
		//IMEI PROJECT
		if(isAutoImei){
			$("IMEI").value = "";
			$("IMEI_TXT").value = "";
		}else{
			$("IMEI").value = "";
		}

		
		
		if (_l.u.c == 'C310' || _l.u.c == 'C370') {
			searchOnlyModelInfo();
		} else {		
			setModelVersion(jsonObject, idx);
		}
		
		if (_l.HHPAccessoryNoSerial) {
			var fileExist = $('attachTableBody').rows.length > 0;
			HHPAccessoryOnChangeModel("CHANGE", $('SVC_PRCD').value, fileExist);
		}// (HHPAccessoryNoSerial){
		
		// =================================================================================//
		// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
		// Activation
		// 수정일 : 2015.04.28
		// 수정자 : 채보람 (로젠 솔루션)
		// 내 용 : IMEI 가 Change 될때 마다 IMEI Tracker I/F Function 을 호출 한다.
		if(_l.isIndia || _l.isBangladesh || _l.isSrilanka || _l.isNepal){
			changeModel();
		}
		// =================================================================================//
	}//if(_l.u.isChinaRegion){
	getEngineerList();
	
	setModuleId();
}

function searchOnlyModelInfo() {
	if ($("detailForm").MODEL.value == '') {
		return;
	}

	$('detailForm').cmd.value = 'TicketModelSearchCmd';
	AjaxRequest(urlPatternGZIP, "detailForm", setJsonObjectOnlyModel);
}

function setJsonObjectOnlyModel(response) {
	try {
		var jsonObjM = eval('('+response.responseText+')');
		if (jsonObjM.success) {
			setModelVersion310(jsonObjM, 0);
		} else {
			if (jsonObjM.error) {
				 cfExceptionPop(jsonObjM);
			} else {
				if (jsonObjM.returnMessage!='') {
					alert(_l.u.SAP_MSG_PREFIX + jsonObjM.returnMessage);
				} else {
					alert(_l.u.WEB_MSG_PREFIX + '<%=/*Error*/resource.getMessage("MSG/ERROR")%>');
				}
			}
			setModelVersion310(jsonObjM, 0);
		}
	} catch (e) {}
}

function wtyInfoReset() {
	$('IN_OUT_WTY').value = '';
	$('TERM_LABOR').value = '';
	$('TERM_PARTS').value = '';
	$('TERM_OTHER').value = '';
	$('SALES_COUNTRY').value = '';
	
	if(_l.u.isChinaRegion){
		//china version intergration 2016/08/12 js1.baek
	}else{
		$('PRODUCT_DATE').value = '';
		
		if (isMedisonUser) {
			$('PURCHASE_DATE').value = '';
		}		
	}//if(_l.u.isChinaRegion){
	
}

function clearIRISCode() {
	clearGridJsonObject($('IRIS_CONDI'));
	clearGridJsonObject($('IRIS_DEFECT'));
	clearGridJsonObject($('IRIS_SYMPT'));
	clearGridJsonObject($('IRIS_REPAIR'));
	clearGridJsonObject($('DEF_BLK'));

	$("tempForm").IRIS_CONDI_DESC.value = '';
	$("tempForm").IRIS_DEFECT_DESC.value = '';
	$("tempForm").IRIS_SYMPT_DESC.value = '';
	$("tempForm").IRIS_REPAIR_DESC.value = '';

	var opt_html = "<option value=''>- " + _l.r.c.LBL_01035 + " -</option>";
	$('IRIS_CONDI').insert(opt_html);
	$('IRIS_DEFECT').insert(opt_html);
	$('IRIS_SYMPT').insert(opt_html);
	$('IRIS_REPAIR').insert(opt_html);
	$('DEF_BLK').insert(opt_html);
}

function HHPAccessoryOnChangeModel(mode, localProd, fileExist) {
	var needAlert = (localProd == "HHP03");
	if (mode == "CHANGE") {
		needAlert = needAlert && !fileExist;
	}

	if (needAlert) {
		alert(_l.u.WEB_MSG_PREFIX + "Use handset Model/Serial & IMEI no, if defective accessory is with in box of handset Model(HHP01/02)");
		//IMEI PROJECT
		if(isAutoImei){
			$j("#IMEI_TXT").removeClass().addClass("inputRO").prop("readonly", true).val("");
		}else{
			$j("#IMEI").removeClass().addClass("inputRO").prop("readonly", true).val("");
		}
		// $j("#SERIAL_NO").removeClass().addClass("inputRO").prop("readonly",
		// true).val("");
	} else {
		//IMEI PROJECT
		if(isAutoImei){
			$j("#IMEI_TXT").removeClass().addClass("inputIDS").prop("readonly", false).val("");
		}else{
			$j("#IMEI").removeClass().addClass("inputIDS").prop("readonly", false).val("");
		}
		
	}
}

function searchPopModel() {
	if ($('ASC_CODE').value == '') {
		alert(_l.u.WEB_MSG_PREFIX + 'Service Branch needs!');
		return;
	}
	var url = "";
	var w = window
			.open(
					url,
					"model_popup",
					'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=530');
	w.focus();

	var formObj = $('tempForm');
	$('model_p').value = $("detailForm").MODEL.value;
	$('ASC_CODE_p').value = $("detailForm").ASC_CODE.value;
	formObj.action = '/svctracking/common/SVCPopModelSearch.jsp';
	formObj.target = 'model_popup';
	formObj.submit();
}

function serialChange() {
	if (_l.u.c == 'C310' || _l.u.c == 'C370') {
		var serial = $('detailForm').SERIAL_NO.value.toUpperCase();
		if (serial == 'M000') {
			if (!jsonBosListObj.success && $j('#tableBOSList').is(':hidden')) {
				resetPurchaseDateByDeletingBOS('#PURCHASE_DATE');
			}
		}
	}
	checkWarranty = true;
		
	if (_l.getMoedelBySerial) {
		getModelBySerialForMedison();
		return;
	}
	
	
	/**/
	var mptsPrdCodeList = _l.r.c.MPTS_PRD_CODE_LIST.evalJSON();
	var svcProd = $("SVC_PRCD").value;
	if(_l.useHrPrdCodeMPTS){
		svcProd = $('HQ_SVC_PRCD').value;
	}
	var isHHPProduct = false;
	for(var i=0; i<mptsPrdCodeList.length; i++){
		if(svcProd == mptsPrdCodeList[i].codeId){
			isHHPProduct = true;
			break;
		}
	}// for
	
	
	if ( !haveTocheckIMEIforHHP(_l.CurrStatus, isHHPProduct,  $("SERVICE_TYPE").value, $("HQ_SVC_PRCD").value) ) {
		
		var paramMap = {};
		paramMap.TYPE = "M";
		paramMap.SERIAL_NO = $j('#SERIAL_NO').val();
		
		$('progressloading').startWaiting();
		
		$j.ajax({
			type : 'post',
			dataType : 'json',
			async : false,
			url : '/svctracking/svcorder/modelBySerialByGMES2ForNonHHP.gspn',
			data : paramMap,
			success : function(data) {
				if (data && data.modelNumber && data.modelNumber.length > 5) {
					$j("#MODEL").val(data.modelNumber);
					modelChange();
					if(data.versionNo != null){
						MODELVERSION_inBPInfo = data.versionNo;
					}
					setVersionComboValue($j("#VERSION")[0],MODELVERSION_inBPInfo);
					$("MODEL").className="inputRO";
					$("MODEL").readOnly = true;
					$j("#aModelSearch").hide();
					$j("#SERIAL_NO_ICON").hide();
					calledGMESBySerialButNoData = false;
				}else{
					calledGMESBySerialButNoData = true;
				}
			},
			error : function(jqXHR, textStatus) {
				// console.log(textStatus);
			}
		});		
		$('progressloading').stopWaiting();
		
	}// if ( !haveTocheckIMEIforHHP

	//china version intergration 2016/08/18 js1.baek
	if(_l.u.isChinaRegion){
		
		processAfterSerialChange();
		searchedSerial = $j('#SERIAL_NO').val();
		return;
	}//if(_l.u.isChinaRegion){
}

function setVersionComboValue(selectObj,def){
    for(var i=0; i<selectObj.length; i++){
        if(def.ltrimzero() == selectObj[i].value.ltrimzero()){
            selectObj[i].selected=true;
            break;
        }
    }
}

String.prototype.ltrimzero = function() { 
	return this.replace(/(^0+)/, ""); 
};

function onchangeWTY_EXCEPTION(){
	// if($j("#WTY_EXCEPTION_DB").val() != $j("#WTY_EXCEPTION").val()){
		setCheckWtyTrue();// checkWarranty = true;
	// }
}

/**
 * job & date information
 */
function initJobTab() {	
	$('progressloading').startWaiting();
	$j("#divJob").load(urlPatternGZIP, {
		cmd : 'ZifGspnSvcJobLDCmd',
		objectId : _l.ObjectId,
		ascCode : _l.ASC_CODE,
		tab : '/svctracking/lite/ServiceOrderUpdateJobInfo.jsp'
	}, function() {

		// EHN15 : field control
		serviceTypeChangeEHN($("SERVICE_TYPE").value, true);
		modelChangeEHN(_l.CIC_PRCD, true);

		bindDynamicDateOnTransitStatus(false);
		hideDynamicDateOnTransitStatus();
		
		var statusCode = $("STATUS").value;
		var svctype = $("SERVICE_TYPE").value;
		
		toggleSubServicetype(isEuUser, false, svctype);		

		if (!_l.isCustomerSymtomReadOnly) {
			symtomCodeSearch1(_l.MODEL);
			symtomCodeSearch2(_l.SYMPTOM1_CODE);
			symtomCodeSearch3(_l.SYMPTOM2_CODE);
			if(_l.u.c == "C310"){
				symtomCodeSearch4(_l.SYMPTOM3_CODE);
			}
		} 
		
		
		if(svctype=='SH'){// Service Handling
			if(statusCode == "ST035"){// Status Repair Completed
				setUnitRecvMendatoryDateField();
			}
		}		
		if(svctype=='PS'){// Pick up Service
			$j('#trShipMethod').show();
			if(statusCode == "ST025" || statusCode == "ST030" || statusCode == "ST035" || statusCode == "ST040" || statusCode == "ST055"){// Status
																																			// Repair
																																			// Completed
				setUnitRecvMendatoryDateField();
			}
		}else{
			$j('#trShipMethod').hide();
		}
		
		// Care Pack 고도화 - 2017.03 - Start //
		if(_l.isCarePackService){
			if(svctype=='AD'){
				$j('#tdSubType1,#tdSubType2').show();
				$j('#SUB_SVC_TYPE').val()=="";
				$j('#SUB_SVC_TYPE2').val()=="";
				$j('#SUB_SVC_TYPE3').show();
			}
		}
		// Care Pack 고도화 - 2017.03 - End //
		
		showCustomerCallAttempt( canSeeCallAttempt );
		
		if(_l.u.c == "C310"){
			try{
				$('newimei').hide();
				$('newimeiin').hide();	
			} catch (e) {}
		}
		
		/*
		 * 미주 통합 - RT-007 - SEA IM (C370)은 S-MES 시스템으로부터 Rent Date를 인터페이스하여
		 * ZTSVC101테이블의 RENT DT 필드에 저장한 후 Warranty시 필수데이터 - 2015-09-14
		 */	 			
		if(_l.u.c == "C370"){
			try{
				$('newimei').hide();
				$('newimeiin').hide();	
				$('rentdt').show();				
				$('rentdtData').show();				
				
			} catch (e) {}
		}
		
		
		if(_l.isPSApp) {
			$("UNIT_RECV_DATE").className="inputRO";
			$("UNIT_RECV_DATE").readOnly = true;
			$("UNIT_RECV_TIME").className="inputRO";
			$("UNIT_RECV_TIME").readOnly = true;
			$("ICO_UNIT_RECV_TIME").style.display="none";
		}
		
		toggleTokenNo($("SERVICE_TYPE").value);
		
		//china version intergration 2016/08/11 js1.baek
		if(isNewChina) C6V0_fieldView();
		
		$('progressloading').stopWaiting();
		toggleOptionTab("divJob");
	});
};
/**
 * product repair information
 */
function initRepairTab() {
	$('progressloading').startWaiting();
	$j("#divRepair").load(urlPatternGZIP, {
		cmd : 'ZifGspnSvcRepairLDCmd',
		objectId : _l.ObjectId,
		ascCode : _l.ASC_CODE,
		tab : '/svctracking/lite/ServiceOrderUpdateProdRepInfo.jsp'
	}, function() {
		
		

		
		/* Service Indicator */
		if(_l.useSvcIndicator){
				var obj = eval($('SVC_INDICATOR'));
				if (obj != null) getServiceIndicator();
		}
		
		if(_l.useTechnicianId){
			getTechnicianList("tab");
		}

		var statusCode = $("STATUS").value;
		if(statusCode == "ST035"){// Status Repair Completed , Goods Delivered
			$('REP_TYPE').className = "selectIDS";
			$('LAB_TYPE').className = "selectIDS";
		}
		if(_l.u.c == "C550"){
			$('REP_TYPE').value = $('SERVICE_TYPE').value;
		}
		
		if(_l.u.c == "C310" || _l.u.c == "C370"){
			$('GasChargeDistanceTr').hide();
			$('IrisCodeDec').hide();
			// $('defectbolck').hide();
		}
		
		// =============================================================================
		// 제 목 : 인도 Demand
		// 과 제 : extra conveyance process flow
		// 수 정 자 : 채보람 (로젠솔루션)
		// 수 정 일 : 2015-06-16
		// 내 용 : 인도일때 실거리를 가져오는 function 호출
		// =============================================================================
		if("C550" == _l.u.c && "IN" == _l.u.CountryCd && _l.IN_OUT_WTY == "LP"){
			initDistance();
		}
		// =============================================================================
		
		if("C550" == _l.u.c){
			changeVANID();
		}
	
		//C720 - 9개 수리점에 대해서 SVC Type 'IS' activation
		if(_l.u.c == 'C720' && !limitTypeSSA){
				$j("#detailForm").find("#SERVICE_TYPE").find("option:[value=IS]").remove();
		}
		
		/*C710, Country Code : IR 경우에만 로직 패스*/
		if (_l.u.c == 'C710' && _l.u.CountryCd != "IR"){
				$j("#detailForm").find("#LAB_TYPE").find("option:[value=IP]").remove();
		}
		
		// LK(스리랑카) 법인에 SVC TPYE 'SE' 추가 반영 요청건 - LK가 아니면 SE TYPE remove 
		if(_l.SERVICE_TYPE != "SE"){
			if(_l.u.c == 'C550' && _l.u.CountryCd != "LK"){  
				$j("#detailForm").find("#REP_TYPE").find("option:[value=SE]").remove();
			}
		}		
		
		$('progressloading').stopWaiting();
		toggleOptionTab("divRepair");
	});
};

