		if($j("[id=btnBilling]").length > 0) $j("[id=btnBilling]").hide();
	}
	//WTY_EXCEPTION
	if(_l.currStatus == "ST040" || _l.currStatus == "ST035"){
		$('detailForm').WTY_EXCEPTION.disabled = true;
	}	
		
	// Adv Exchange Case
	if(_l.isExchTicket){
		$j("#REMARK,#STATUS_COMMENT").attr("readonly", "readonly");

		// EHN15 : (division id 변경)
		$j("#defectDescTr,#defectTypeTr,#defectCodeTr,#divRparts").hide();		
		//$j("#defectDescTr,#defectTypeTr,#defectCodeTr,#partInfoTr").hide();

		if(!isRunningOnOperation) $j("#rmInstallTr").hide();
	}
	if(_l.currStatus == "ES140" || _l.currStatus == "ES110"){	
		if($j('[id=btnSave]').length > 0) $j('[id=btnSave]').hide();
		isPreventEdit = true;
	}
	if(isPreventEdit){
		if($j("#btnCreatePO").length > 0) $j("#btnCreatePO").hide();
		if($j("#btnAddPart").length > 0) $j("#btnAddPart").hide();	
	}
	
/*	$j("#detailForm").find("#IRIS_REPAIR").change(function(){
		$j("#partsTableBody input[name='SERIAL_MAT']").val($j(this).val()); 
	});*/
}
function initWisTab(tabId){
	// GSPN 로그인 한 어카운트와 상이한 ASC코드로 생성 된 티켓일 경우 먼저 Account수정 요
	// Account수정 후, Service Type 수정(PS → CI)
	/*
	var checkAccount = _l.isWalkInServiceUser?_l.wmB2bId:_l.u.AccountCode;
	if(checkAccount != _l.ticketAccount){
		if(_l.SERVICE_TYPE == 'CI' || _l.SERVICE_TYPE == 'PS'){
