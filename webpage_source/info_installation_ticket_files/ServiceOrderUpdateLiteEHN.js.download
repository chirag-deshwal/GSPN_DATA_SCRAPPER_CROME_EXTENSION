		return;
	}
	
	$('detailForm').cmd.value = 'GetMCSInfoMEACmd';
	AjaxRequest(urlPattern,"detailForm", setMCSInfoMEA);
	$('progressloading').startWaiting();
}

function setMCSInfoMEA(response)
{
	var jsonMCSObj = response.responseText.evalJSON();
	if(jsonMCSObj.success) {
		
		var retString  = "";
		retString += " \n- MODEL : " + jsonMCSObj.MODEL				    ;
		retString += " \n- PRODUCT : " + jsonMCSObj.PRODUCT				    ;
		retString += " \n- SOLD TO PARTY CODE : " + jsonMCSObj.SOLDTOPARTYCODE		    ;
		retString += " \n- SOLD TO PARTY NAME : " + jsonMCSObj.SOLDTOPARTYNAME		    ;
		retString += " \n- SOLD TO PARTY COUNTRY : " + jsonMCSObj.SOLDTOPARTYCOUNTRY	    ;
		retString += " \n- SHIP TO PARTY CODE : " + jsonMCSObj.SHIPTOPARTYCODE		    ;
		retString += " \n- SHIP TO PARTY NAME : " + jsonMCSObj.SHIPTOPARTYNAME		    ;
		retString += " \n- SHIP TO PARTY COUNTRY : " + jsonMCSObj.SHIPTOPARTYCOUNTRY      ;
		retString += " \n- SELL IN DATE : " + jsonMCSObj.SELLINDATE              ;
		retString += " \n- SELL OUT STORE : " + jsonMCSObj.SELLOUTSTORE            ;
		retString += " \n- SELL OUT COUNTRY : " + jsonMCSObj.SELLOUTCOUNTRY          ;
		retString += " \n- SELL OUT DATE : " + jsonMCSObj.SELLOUTDATE             ;
		alert("[MCS]"  + retString);
		$('progressloading').stopWaiting();
	} else {
		alert("[MCS]" + jsonMCSObj.returnMessage);
		$('progressloading').stopWaiting();
	}
}
// 북미통합
function getMesAvailQty(){
	$('progressloading').startWaiting();
	
	$form = $j("#frm");
	$form.empty();
	
	insertValue("frm", "IV_MODEL", $j("#detailForm").find("#MODEL").val());
	insertValue("frm", "IV_COMPANY", $j("#detailForm").find("#TICKET_COMPANY").val());
	insertValue("frm", "IV_CUR_LOC", $j("#detailForm").find("#IV_CUR_LOC").val());
	insertValue("frm", "IV_IMEI", $j("#detailForm").find("#IMEI").val());

	var url = "/wis/ticket/common/advExchangeWisGetAvailQty.gspn";
	$j.post(url, $form.serialize(), callbackMesAvailQty, 'json');
}
function callbackMesAvailQty(data){
	var jsonObjC = data;
	try {
		if(jsonObjC){
			if(jsonObjC.ev_MESSAGE.length > 0){
				// Can't request model case
				alert("[MES]" + jsonObjC.ev_MESSAGE);
				isGetAvailQty = false;
				return;
			}
			var intQty = parseInt(jsonObjC.ev_QTY, 10);			
			alert(_l.u.WEB_MSG_PREFIX + "Available Quantity : "+ intQty);
			
			if(intQty > 0){
				isGetAvailQty = true;
			}else{
				isGetAvailQty = false;
			}
		}
		
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
	} finally {
		$('progressloading').stopWaiting();
	}
}
// when create a SAW : Adv Exch SRZ10, log the reson why Adv Exch need in the
// original ticket's SAW Request comment
var SAW_REQ_COMMENT = "";
function modifyParentTicket(REQ_COMMENT){
	
	SAW_REQ_COMMENT = REQ_COMMENT;
	$('progressloading').startWaiting();
	if(_l.useDynatrace) {
		dtAction = dynaTrace.enterAction('SO modify();'+_l.dtADKCode, 'Click SO modify');	
	}
	$j("#frm").empty();
	
	$j("#detailForm").find("[name]").each(function(){		
		insertValue("frm", $j(this).attr("name"), $j(this).val());		
	});
	//Service Type SW -> SH로 변경 requested by SEA IM 정상천 과장
	//SH -> SW로 다시 변경 2015-11-17
	if(_l.isSEAInteUser){
		$j("#frm").find("[name=WTY_FLAG]").val("X");//auto warranty
		insertValue("frm", "ADV_EX_REQ_DATE", _l.toDate);
		insertValue("frm", "ADV_EX_REQ_TIME", _l.toTime);		
	}
	$j("#frm").find("[name=SERVICE_TYPE]").val("SW");
	//워런티 서비스타입도 SW 로 변경 필요
	$j("#frm").find("[name=REP_TYPE]").val("SW");
	$j("#frm").find("[name=STATUS]").val("ST040");
	$j("#frm").find("[name=REASON]").val("HOZ07");
	$j("#frm").find("[name=LAB_TYPE]").val("IP");
		
	$('frm').cmd.value = 'ServiceOrderModifyCmd';
	AjaxRequest(urlPatternGZIP, 'frm', callbackParentTicket);
}
function callbackParentTicket(response){
	try{
		var jsonObj = eval('('+response.responseText+')');
		if (jsonObj.error) {
			cfExceptionPop(jsonObj);
		}
		if (jsonObj.success){
			alert(_l.u.SAP_MSG_PREFIX + _l.r.m.COMP_SAVE + "\n" + jsonObj.message);
			createAdvTicket();	
		}else{
			alert(_l.u.SAP_MSG_PREFIX + jsonObj.message + "\n" + "On-Site Exchange is not Created.");			
		}
	    var length = jsonObj.EtErrInfo.length;
		$('errTable').show();
		$j('#errBody').empty();
		for (var i = 0; i < length; i++) {
			makeErrList(jsonObj.EtErrInfo[i].ERR_TYPE, jsonObj.EtErrInfo[i].ERR_CODE, jsonObj.EtErrInfo[i].ERR_MSG);
		}
		document.location.href = "#top";
		
	}catch(e){	
	}finally	{		
		if(_l.useDynatrace) {
			dynaTrace.leaveAction(dtAction);
		}		
	}
	$('progressloading').stopWaiting();
}
function createAdvTicket(){
	
	$('progressloading').startWaiting();
	if(_l.useDynatrace) {
		dtAction = dynaTrace.enterAction('SO modify();'+_l.dtADKCode, 'Click SO modify');	
	}
	$j("#frm").find("[name=SERVICE_TYPE]").val("ER");
	$j("#frm").find("[name=REP_TYPE]").val("ER");
	$j("#frm").find("[name=STATUS]").val("");
	$j("#frm").find("[name=OBJECT_ID]").val("");
	$j("#frm").find("[name=ASC_JOB_NO]").val("");
	$j("#frm").find("[name=REASON]").val("");
	if(_l.isSEAInteUser){
		$j("#frm").find("[name=WTY_FLAG]").val("");//auto warranty		
	}
	insertValue("frm", "PARENT_OBJECT_ID", $j("#detailForm").find("[name=OBJECT_ID]").val());
		
	$('frm').cmd.value = 'ServiceOrderModifyCmd';
	AjaxRequest(urlPatternGZIP,'frm', callbackAdvTicket);		
}
function callbackAdvTicket(response){
	try{
		var jsonObj = eval('('+response.responseText+')');
		if (jsonObj.error) {
			cfExceptionPop(jsonObj);
		}
		if (jsonObj.success){
			alert(_l.u.SAP_MSG_PREFIX + jsonObj.message+'\n'+_l.r.m.EXT_0007+jsonObj.returnObjectID);
			
			function createInteractionMessage(message, objectId) {
				var url = urlPattern;
				var data = "cmd=ServiceOrderMsgModifyCmd&INTERMESSAGETYPE=NEW&msgText=" + message + "&objectID=" + objectId;
				$j.ajax({
					type : "POST",
					async : false, /* 동기 */
					url : url,
					data : data,
					success : function(data) {
					},
					dataType : 'json'
				});
			}// function createInteractionMessage(message, objectId) {
			createInteractionMessage(SAW_REQ_COMMENT, jsonObj.returnObjectID);
			
			if($j("[id=btnSave]").length > 0) $j("[id=btnSave]").hide(); 
			$j("#frm").empty();
			insertValue("frm", "objectID", jsonObj.returnObjectID);
			
	        $('frm').target = "_self";
	        $('frm').action = urlPattern;
	        insertValue("frm", "cmd", "ZifGspnSvcMainLDCmd")					        
	        $('frm').submit();
								
		}else{
			alert(_l.u.SAP_MSG_PREFIX + jsonObj.message + "\n" + "On-Site Exchange is not Created.");			
		}
	    var length = jsonObj.EtErrInfo.length;
		$('errTable').show();
		$j('#errBody').empty();
		for (var i = 0; i < length; i++) {
			makeErrList(jsonObj.EtErrInfo[i].ERR_TYPE, jsonObj.EtErrInfo[i].ERR_CODE, jsonObj.EtErrInfo[i].ERR_MSG);
		}
		document.location.href = "#top";
		
	}catch(e){
		
	}finally{			
		if(_l.useDynatrace) {
			dynaTrace.leaveAction(dtAction);
		}	
	}		
	$('progressloading').stopWaiting();
}
function getAdvExchangeCreditInfo(){
	if(_l.currStatus == "ES105" || _l.currStatus == "ES125"){
		if(!isRetailFeeFlag && !isServiceFeeFlag){
			$j("#retailFeeBtn").show();
		}else if(isRetailFeeFlag || isServiceFeeFlag){								
			$j("#retailFeeBtn").show();
			$j("#serviceFeeBtn").show();
			if(isRetailFeeFlag && isServiceFeeFlag){
				if (_l.sawExistAdvExchFeeWaiveRequested || _l.sawExistAdvExchFeeWaiveApproved) {
					$j("#retailFeeBtn").hide();
					$j("#serviceFeeBtn").hide();
				}
				$j("#upsBtn").show();
			}
			// Adv Ex Billing Btn Show
			// $j("#btnAdvExBilling").show();
		}
		$j("#retailFeeBtn").hide();
		$j("#serviceFeeBtn").hide();
		$j("#upsBtn").hide();
		
	}	
}
function reasonCodeExch(){
	var exstatus = $j("#STATUS").val();
	$j("#reasonCodeTD").empty();
	var selectObj = $j("<select id=\"REASON\" name=\"REASON\" class=\"select\" style=\"width:99%\"></select>");
	if(exstatus == "ES125"){
		$j.each(_l.advExPendingReasonArray, function(idx, val){
			var option = $j("<option/>").val(_l.advExPendingReasonArray[idx].codeId)
			.text(_l.advExPendingReasonArray[idx].codeName); 
			if(_l.advExPendingReasonArray[idx].codeId == _l.currReason){
				option.attr("selected", "selected");					
			}
			option.appendTo(selectObj);
		});	
		selectObj.appendTo($j("#reasonCodeTD"));		
	}else if(exstatus == "ES140"){
		$j.each(_l.advExCancelReasonArray, function(idx, val){
			var option = $j("<option/>").val(_l.advExCancelReasonArray[idx].codeId)
			.text(_l.advExCancelReasonArray[idx].codeName);
			if(_l.advExCancelReasonArray[idx].codeId == _l.currReason){
				option.attr("selected", "selected");
			}
			option.appendTo(selectObj);
		});	
		selectObj.appendTo($j("#reasonCodeTD"));
	}else{
		$j("<input type=\"hidden\" id=\"REASON\" name=\"REASON\" class=\"input\" readonly style=\"width:99%\"/>")
		.val(_l.REASON).appendTo($j("#reasonCodeTD"));
		$j("<input type=\"text\" id=\"REASONDESC\" name=\"REASONDESC\" class=\"input\" readonly style=\"width:99%\"/>")
		.val(_l.REASONTEXT).appendTo($j("#reasonCodeTD"));
	}
}
function validateExchangeSave(){
	if($j.trim($j("#NAME_FIRST").val()) == ""){
		alert(_l.u.WEB_MSG_PREFIX + "Please input name first");
		$j("#NAME_FIRST").focus();
		return false;
	}
	if($j.trim($j("#NAME_LAST").val()) == ""){
		alert(_l.u.WEB_MSG_PREFIX + "Please input name last");
		$j("#NAME_LAST").focus();
		return false;
	}
	
	if($j.trim($j("#STREET").val()) == ""){
		alert(_l.u.WEB_MSG_PREFIX + "Please input address");
		$j("#STREET").focus();
		return false;
	}
	if($j.trim($j("#REGION").val()) == ""){
		alert(_l.u.WEB_MSG_PREFIX + "Please select State");
		$j("#REGION").focus();
		return false;
	}
	if($j.trim($j("#CITY").val()) == ""){
		alert(_l.u.WEB_MSG_PREFIX + "Please input City");
		$j("#CITY").focus();
		return false;
	}
	if($j.trim($j("#POST_CODE").val()) == ""){
		alert(_l.u.WEB_MSG_PREFIX + "Please input Zipcode");
		$j("#POST_CODE").focus();
		return false;
	}
	if($j.trim($j("#EMAIL").val()) == "") {
		alert(_l.u.WEB_MSG_PREFIX + "Please input E-mail Address");
		$j("#EMAIL").focus();
		return false;
	}
	if (!ValidateEmail($('detailForm').EMAIL)) {
		return false;
	}
	
	if (_l.sawPending) { /*
							 * SAW Request 상태인게 있으면 그 SO에 대해서는 close(Goods
							 * Delivered)하지 못하도록 - 2014-10-18 STA 양진우 대리
							 */
	
		if ($("STATUS").value == "ES110") {
			alert(_l.u.WEB_MSG_PREFIX + "The SAW is not closed yet. Please close it first");
			return;
		}
	}
	return true;
}
function initWis(){
	$j(document).on("keydown", "input:[readonly]", function(e){
		if(e.which == 8) return false;
	})	
	
	// GSPN 로그인 한 어카운트와 상이한 ASC코드로 생성 된 티켓일 경우 먼저 Account수정 요
