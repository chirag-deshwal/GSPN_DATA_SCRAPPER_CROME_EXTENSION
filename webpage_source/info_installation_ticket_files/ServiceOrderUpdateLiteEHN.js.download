	}
	var gubun = '';
	if (_l.u.c == "C310" || _l.u.c == "C370") {
		gubun = 'SODETAIL';
	}
	
	var url = '/master/part/PartHistory.jsp?serial=' + serial + '&gubun=' + gubun;
	
	var pop = window
