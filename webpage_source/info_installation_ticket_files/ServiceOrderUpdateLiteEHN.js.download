	}
	
}

/**
 * 
 * @param obj : $("detailForm").CONSUMER 또는 $('CONSUMER') 또는 $j('#CONSUMER') 세가지 형태로 들어올수 있음.
 *  세가지 형태 모두 var obj = $j(obj); 을 사용해서 처리할수 있다 그러나, 처음 두개 경우는 불필요하게 query 객체로 감싸는 비용이 드므로, 그걸 낭비하지 않기 위해 분기한다.
 * @param msg
 * @returns {Boolean}
 */
function checkNullSvc(obj, msg){
	if(!obj) return true;// undefined
    
    if(obj.length == undefined){
    	//$("detailForm").CONSUMER 또는 $('CONSUMER')
    	if(obj.value.strip() == ""){// strip = trim -- prototype.js
            alert(_l.u.WEB_MSG_PREFIX + msg);
            obj.focus();
            return false;
        }    	
    }else{
    	//$j('#CONSUMER')
    	var obj = $j(obj);
    	if(obj.length==0) {
    		return true;
    	}
        if($j(obj)[0].value.strip() == ""){//strip = trim -- prototype.js
            alert(_l.u.WEB_MSG_PREFIX + msg);
        	try{ $j(obj).focus(); }catch (e) {}
            return false;
        }
        return true;    	
    	
    }
    return true;
}

function checkMIFModel(){
	$('tempForm').MODEL.value = $("detailForm").MODEL.value;
	$('tempForm').cmd.value = 'CheckMifModelCmd';
	AjaxRequest(urlPatternGZIP,'tempForm', setMIFModel);
}

function setMIFModel(response) {
	try {
		var serviceType = $j("#SERVICE_TYPE").val();
		var jsonObj = eval('('+response.responseText+')');
		
		if (jsonObj.success) {
			if(jsonObj.modelCheck == "Y"){
				isMIFCheckModel = true;
				if(serviceType == "CI" || serviceType == "PS" || serviceType == "SR" || (_l.u.c == 'C720' && serviceType == "IU")){
					if(_l.u.c == 'C540' ){
						$j('#alertDiv').show();
					}else{
						if(_l.isSVCCompleted){
							alert(_l.u.WEB_MSG_PREFIX + "This is MIF supported model and MIF verification was done for this S/O.");
						}else{
							alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0268);
						}
					}
				}
			}else{
				isMIFCheckModel = false;
			}
		} else {
			isMIFCheckModel = false;
		}
		// EHN22
		if (_l.useMobileInterface && !_l.useFenrirCheck) {
			if (isMIFCheckModel && ($("SERVICE_TYPE").value == "CI" || $("SERVICE_TYPE").value == "PS" || $("SERVICE_TYPE").value == "SR" || (_l.u.c == 'C720' && $("SERVICE_TYPE").value == "IU"))) {
				$j("#tabProdTitle").css("display","inline");
			} else {							
				$j("#tabProdTitle").css("display","none");
			}
		}
	} catch (e) {}
}

function checkMIFModelAsync() {
	var url = urlPatternGZIP;

	var data = "cmd=CheckMifModelCmd&CorpCode=" + _l.u.c + "&MODEL="+ $("detailForm").MODEL.value+"&IV_DATE="+_l.CREATE_DATE+"&ascCode="+_l.ASC_CODE+"&IV_OBJECT_ID="+_l.ObjectId;
	var returnCode = "F";
	var isMIFCheckModelAsync = false;
	$j.ajax({
		type : "POST",
		async : false, /* 동기 */
		url : url,
		data : data,
		success : function(data) {
			if (data.success) {
				var alertMsg;
				if(data.modelCheck == "Y"){
					isMIFCheckModelAsync = true;
					returnCode = "Y";
				}else{
					isMIFCheckModelAsync = false;
					returnCode = "N";
				}
				if(data.fenrirCheck == "Y"){
					isFenrirCheckModel = true;
				}
			} else {
				isMIFCheckModelAsync = false;
				returnCode = "F";
			}
		},
		dataType : 'json'
	});
	return returnCode;
	// return true;
}

function checkDiagnosticModel(){
	$('tempForm').MODEL.value = $("detailForm").MODEL.value;
	$('tempForm').cmd.value = 'CheckDiagnosticModelCmd';
	AjaxSyncRequest(urlPatternGZIP,'tempForm', setDiagnosticModel);
}

function setDiagnosticModel(response) {
	try {
		var jsonObj = eval('('+response.responseText+')');
		
		gdEwpFlag = "";
		
		if (jsonObj.success) {
			if(jsonObj.modelCheck == "Y"){
				isDiagnosticCheckModel = true;
				gdEwpFlag = jsonObj.EV_EWP_FLAG;
				if(_l.canUseIqcGd || _l.canUseOqcGd) {
					$j("#gDRunDivActive").css("display","block");
					$j("#gDRunDivNonActive").css("display","none");
				}				
				//getLatestSWVersion();
				
			}else{
				isDiagnosticCheckModel = false;
				if(_l.canUseIqcGd || _l.canUseOqcGd) {
					$j("#gDRunDivActive").css("display","none");
					$j("#gDRunDivNonActive").css("display","block");
				}
			}
		} else {
			isDiagnosticCheckModel = false;
			if(_l.canUseIqcGd || _l.canUseOqcGd) {
				$j("#gDRunDivActive").css("display","none");
				$j("#gDRunDivNonActive").css("display","block");
			}
		}
	} catch (e) {}
}

function getLatestSWVersion() {
	$('tempForm').MODEL.value = $("detailForm").MODEL.value;
