function openPartListByModel(fromPage) {
	
	var model = $j("#MODEL").val();
	if(model == undefined || model == ""){
		model = _l.MODEL;
	}
	
	var modelVer = $j("#VERSION").val();
	if(modelVer == undefined || modelVer == ""){
		modelVer = _l.modelVersion;
	}
	var serial = $('detailForm').SERIAL_NO.value;
	if(serial == "M000"){
		serial = "";
	}
		
	var assignedAscCode = $('ASSIGNED_ASC_CODE').value;
	
	var url = '/master/part/PartListByModelVersion.jsp?model=' + model + '&modelVer=' + modelVer+ '&objectId=' + _l.ObjectId+ '&serialNo=' +serial;
	    url += '&fromPage=' + fromPage;
	    url += "&assignedAscCode=" + assignedAscCode;

	var pop = window
			.open(
					url,
					'part_list',
					'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=500');
	pop.focus();
}


