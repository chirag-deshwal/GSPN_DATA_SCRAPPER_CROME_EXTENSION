function goReopen() {
	$('progressloading').startWaiting();
	$('progressloading').style.height = self.document.body.scrollHeight;
	var now = new Date();
	var ntime = now.getFullYear()
			+ ("0" + (now.getMonth() + 1)).match(/\d{2}$/)
			+ ("0" + (now.getDate() + 1)).match(/\d{2}$/);
	$('reopenForm').receiveddate.value = ntime;
	$('reopenForm').cmd.value = 'ServiceOrderReopenCmd';
	AjaxSyncRequest(urlPatternGZIP, 'reopenForm', reopenResult);
}

function reopenResult(response) {
	$('progressloading').stopWaiting();
	var jsonObj = eval('(' + response.responseText + ')');
	if (jsonObj.success) {
		alert(_l.u.SAP_MSG_PREFIX + jsonObj.message);
		callDetail();
	} else {
		alert( _l.u.SAP_MSG_PREFIX + jsonObj.message);
	}

}

/**
 * if SO has repair part then return true
 */
function hasRepairPart() {
	var hasPart = false;
	var arrParts = $j("#partsTableBody input[name='PARTS_CODE']");// cfArray(frm.PARTS_CODE);
	var arrPartsInvoiceNo = $j("#partsTableBody input[name='INVOICE_NO']");// cfArray(frm.INVOICE_NO);
	var partLen = arrParts.length;
	for ( var i = 0; i < partLen; i++) {
		if (!arrParts[i].value.blank()) {
			hasPart = true;
			break;
		}
	}
	/*[[ C18110007473 [GSPN]_[DO Compensation]SEI 법인 FOC 자재 "STOCK" SO에 등록 요청건 */
	var frm = $('detailForm');
	var arrSawCategory = cfArray(frm.SAW_CATEGORY);
	var arrSawStatus = cfArray(frm.SAW_STATUS);
	for ( var i = 0, maxLen = arrSawCategory.length; i < maxLen; i++) {
		// SRC77 D/O Exception, SS010 : approved
		if (arrSawCategory[i].value == "SRC77" && arrSawStatus[i].value == "SS010") {
			isExceptDeliveryNoApproval = true;
			break;
		}
	}
		
	if(_l.isCompensationAsc && !isExceptDeliveryNoApproval){
		for ( var i = 0; i < partLen; i++) {
			if (arrPartsInvoiceNo[i].value == 'STOCK') {
				alert(arrParts[i].value + " is saved for STOCK instead of DO. It is not claimed for w'ty.");
			}
		}
	}
	/*C18110007473 [GSPN]_[DO Compensation]SEI 법인 FOC 자재 "STOCK" SO에 등록 요청건 ]] */
	return hasPart;
}

/**
 * * need the purchase date and purchase date is empty and Out of warranty then
 * block save with warning message
 */
function validPurchaseDate() {
	var valid = true;
	var wtyInOut = $('IN_OUT_WTY').value;

	// if serial is M000 then wtyInout value is empty and this ticket is not ouf
	// of wty
	var isOutOfWty = true;
	if (wtyInOut == "L" || wtyInOut == "L" || wtyInOut == "LP") {
		isOutOfWty = false;
	}

	var SERVICE_TYPE = $("SERVICE_TYPE").value;
	// START : C19050007571 [GSPN] Purchase date editable in SVC type KT for Network Product
	var svcProd = $('SVC_PRCD').value.substring(0, 3);
	var serviceTypeNotNeedPD = ((SERVICE_TYPE == "KT" && svcProd != "NEX")|| SERVICE_TYPE == "SR");
	// END   : C19050007571 [GSPN] Purchase date editable in SVC type KT for Network Product
	var emptyPurchaseDate = $("PURCHASE_DATE").value=="" || $("PURCHASE_DATE").value.substring(0,2) == "00";
	
	//VAL_CHK_PURCHASE_DATE_1 이관
	//17.12.08 원복함,이관된 SAP내 체크로직타기전에 구매일이 채워지는 로직이 있음.
	if(_l.u.c =="C550" && serviceTypeNotNeedPD && !emptyPurchaseDate	){
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.SERVICE_KT + " KT & SR");
		valid = false;
	    return valid;
	}
	
	var validDate = checkDate($("PURCHASE_DATE").value, _l.u.DateFormat2);

	if (needPurchaseDateForOW && isOutOfWty && !validDate) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0122);
	}// if(needPurchaseDateForOW && "OW" == jsonObjC.lp_inout){
	return valid;
}

/**
 * * for C550 & IN country
 */
function validPurchasePlace() {
	var valid = true;
	if ("C550" == _l.u.c && "IN" == _l.u.CountryCd ) {
	} else {
		return valid;
	}

	var statusCode = $('STATUS').value;
	var curr_status = _l.CurrStatus;
	var purchasePlace = $('PURCHASE_PLACE').value.trim();
	var serviceType = $("SERVICE_TYPE").value;
	var wtyInOut = $('IN_OUT_WTY').value;
	var svcProd = $("SVC_PRCD").value;
	var repairCode = $('IRIS_REPAIR').value;
	var isHHPProduct = ("HHP01,HHP02,HHP05,DSC05,HHP1A,HHP1B,HHP2A,HHP2B,HHP06".indexOf(svcProd) != -1);
	var transitToGD_RC = (curr_status != statusCode && (statusCode == "ST035" || statusCode == "ST040"));
	
	var isCheckedDate = true;
	var PURCHASE_DATE = $('PURCHASE_DATE').value;
	
	isCheckedDate = checkFromToDate(_l.CREATE_DATE_6, PURCHASE_DATE, _l.u.DateFormat2);
	if (isHHPProduct && serviceType == "RH" && isCheckedDate && statusCode == "ST040" && purchasePlace.length != 7 && _l.sawExistExchangeApporvedTa) {
		alert(_l.u.WEB_MSG_PREFIX + "Kindly enter DOA seal no. as this is HHP DOA call");
		valid = false;
		return valid;
	}		
	
	/*
	 * var checkPurchasePlace = false; if (isHHPProduct && wtyInOut == "LP" &&
	 * serviceType == "RH" && repairCode == "RP") { checkPurchasePlace = true; }
	 * if (checkPurchasePlace && transitToGD_RC) { if (purchasePlace.blank()) {
	 * alert("Before changing to Repair completed or goods delivered, Seal
	 * number is mandatory in place of purchase field"); valid = false; return
	 * valid; } else { if (purchasePlace.length != 7) { alert("Please input 7
	 * digit seal number"); valid = false; return valid; } }//
	 * if(purchasePlace.blank()){ }// if(checkPurchasePlace){
	 */	
	
	return valid;
}

function validTokenInfo() {
	var valid = true;
	var SERVICE_TYPE = $("SERVICE_TYPE").value;
	if (tokenASC && SERVICE_TYPE == 'CI') {
	} else {
		return true;
	}

	if (_l.tokenOnly3Digit && !_l.qMachine) {
		var tokenDate = $("TOKEN_DATE").value;
		var tokenSeq = $("TOKEN_SEQ").value.strip();

		if (tokenSeq != "" && tokenSeq.isNumber()) {
			tokenSeq = Number(tokenSeq);
		} else {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0166);
			return false;
		}

		if (tokenSeq.length == 1 || tokenSeq < 10) {
			tokenSeq = "00" + tokenSeq;
		} else if (tokenSeq.length == 2 || (tokenSeq >= 10 && tokenSeq < 100)) {
			tokenSeq = "0" + tokenSeq;
		}

		$("TOKEN_SEQ").value = tokenSeq;

		$("TOKEN_NO").value = "S" + tokenDate + tokenSeq;
	}// if(_l.tokenOnly3Digit && !_l.qMachine){

	var tokenNo = $("TOKEN_NO").value.strip();
	
	if (_l.u.c == "C710" && tokenNo.length != 0) {
		
	} else if (tokenNo.length != 10) {// Carry In
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0166);
		valid = false;
		return valid;
	}
	if (_l.u.c == "C550") {
		var checkNumberToken = tokenNo.substring(1, 10);
		if (!checkNumberToken.isNumber()) {
			alert(_l.u.WEB_MSG_PREFIX + "Please re-check the token number and enter correct token number.");
			valid = false;
			return valid;
		}
	}
	if (!tokenExistThenRepairCompleteTimeIsMandatory()) {
		valid = false;
		return valid;
	}

	if (_l.needTokenDateCheck) {
		var tokenDateFormat = "yyyyMMdd";
		var tokenDate = "20" + tokenNo.substring(1, 7); // yyMMdd
		var today_yyyyMMdd = _l.CREATE_DATE;
		var correctDateFormat = checkDate(tokenDate, tokenDateFormat);
		if (!correctDateFormat || Number(tokenDate) > Number(today_yyyyMMdd)) {
			alert(_l.u.WEB_MSG_PREFIX + "Token Date[" + tokenDate
					+ "] cannot be later than posting date [" + today_yyyyMMdd
					+ "].");
			valid = false;
			return valid;
		}
	}
	return valid;
}

function tokenExistThenRepairCompleteTimeIsMandatory() {
	var statusCode = $('STATUS').value;
	var currStatus = _l.CurrStatus;
	var repairCompairTime = "";
	var tokenExist = false;
	var validTime = false;

	// only for ST035 or ST40
	if (statusCode == "ST035" || statusCode == "ST040") {
	} else {
		return true;
	}
	if ($("TOKEN_NO").value) {
		tokenExist = !$("TOKEN_NO").value.blank();
	}
	if (!tokenExist) {
		return true;
	}
	// get the repair compair time
	if (statusCode == "ST035") {
		if (currStatus != statusCode) { // status transit to ST035
			repairCompairTime = $("SERVICE_TIME").value;
		} else {
			repairCompairTime = $("REPAIR_COMP_TIME").value;
		}
	} else if (statusCode == "ST040") {
		repairCompairTime = $("REPAIR_COMP_TIME").value;
	}

	if (cfValidTime(repairCompairTime)) {
		validTime = true;
	}

	if (tokenExist && !validTime) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_XVALUE_00662);
		if (currTabId == 'divJob') {

		}else{
			initJobTab();
		}
		$('REPAIR_COMP_TIME').className = "inputIDS";
		$('REPAIR_COMP_TIME').readOnly = "";
		$('REPAIR_COMP_TIME').style.display="";
		$("ICO_REPAIR_COMP_TIME").style.display="";
		
		return false;
	} else {
		return true;
	}
}

