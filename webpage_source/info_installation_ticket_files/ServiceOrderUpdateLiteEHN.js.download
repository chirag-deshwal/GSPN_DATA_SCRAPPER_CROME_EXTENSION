// 상단 Multi Err List display
function makeErrList(type, code, message) {

	var tbodyObj = $('errBody');

	var trTag = new Element("tr");
	var tdTag = null;

	/** 1. type */
	tdTag = new Element("td", {
		'class' : 'td_al'
	});
	tdTag.update("<font color=orange> [" + type + "]</font>");
	trTag.appendChild(tdTag);
	/** 2. code : message */
	tdTag = new Element("td", {
		'class' : 'td_al'
	});
	tdTag.update(code + " : " + message);
	trTag.appendChild(tdTag);

	tbodyObj.appendChild(trTag);

	$('progressloading').stopWaiting();
}

/**
 * Serial No Search (RFC : WB_MODEL_SERIALNO_CHECK)
 */
function serial_search() {
	var url = "/wty/wtyclaim/SearchSerial.jsp";
	
	if(isRsCheck) {
		url = "/wty/wtyclaim/RepairHistoryBySerial.jsp";
	} else if(isNewChina) {
		url = "/wty/wtyclaim/WtySearchSerial.jsp";
	} else if(isRedoCheck == "Y") {		
		url = "/wty/wtyclaim/RepairHistoryBySerial.jsp";
	}

	
	url = url + "?i_model=" + $('detailForm').MODEL.value;
	url = url + "&i_serno=" + $('detailForm').SERIAL_NO.value;
	url = url + "&redoCheck=" + isRedoCheck;
	url = url + "&fldSerno=SERIAL_NO";
	url = url + "&fldImei=IMEI";
	url = url + "&fldPurdt=PURCHASE_DATE";
	url = url + "&form=detailForm";
	url = url + "&asc_code=" + $('ASC_CODE').value;
	url = url + "&isAbleToPut=" + isAbleToChangeModel;
	
	if(_l.u.isChinaRegion) {
		url = url + "&func=processAfterSerialPut";
	} else {
		url = url + "&fldModel=MODEL";
		//IMEI PROJECT
		if(isAutoImei){
			 url = url + "&func=triggerIMEI";
		}
	}
	
	if(isRsCheck) {
		url = url + "&rsFlag=X";
		w = window
		.open(
				url,
				"rs_serial_popup",
		'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=530');
	} else {		
		w = window
		.open(
				url,
				"serial_popup",
		'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=530');
	}
}


