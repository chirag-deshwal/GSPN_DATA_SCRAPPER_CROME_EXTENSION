	    	        		}
	                	}
					}
                }
			} else {
				if (corp == "C550" ||  _l.u.subRegionCd == "EU") {
					if ($('attachTableBody').rows.length < 1) {
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0101);
