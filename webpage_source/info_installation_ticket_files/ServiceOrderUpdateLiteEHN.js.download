function isVisitDateValid() {
	var corp = _l.u.c;
	var isValid = true;

	var isFirstVisitDateBlank = $("FIRST_VISIT_DATE").value == ""
			|| $("FIRST_VISIT_DATE").value.substring(0, 2) == '00';
	var isLastVisitDateBlank = $("LAST_VISIT_DATE").value == ""
			|| $("LAST_VISIT_DATE").value.substring(0, 2) == '00';
	var FIRST_VISIT_DATE= $("FIRST_VISIT_DATE");
	var FIRST_VISIT_TIME= $("FIRST_VISIT_TIME");
	// Check if either first or last date is blank when this ticket is
	// completed.
	if ($('STATUS').value == "ST035") {
		
		/*
		if ($("FIRST_VISIT_DATE").value == "" || $("FIRST_VISIT_DATE").value.substring(0,2) == "00") {
			
			//MAN_CHK_FIRST_VISIT_DATE_3 이관,MAN_CHK_FIRST_VISIT_DATE_4 이관			
			if("C310" == corp || $('SERVICE_TYPE').value == 'IH'){
				isValid = false;
				alert(_l.r.m.MAND_XVALUE_00014);
				$j('#FIRST_VISIT_DATE').removeAttr("readonly").removeClass().addClass("input").focus();
				$j('#FIRST_VISIT_TIME').removeAttr("readonly").removeClass().addClass("input");
				$j($("FIRST_VISIT_DATE")).datepicker("destroy");
				$j('.hasDatepicker').keypress("destroy");
				$("FIRST_VISIT_DATE").onClick = showCal($("FIRST_VISIT_DATE"));
				$("FIRST_VISIT_DATE").onChange = checkValidDate($("FIRST_VISIT_DATE"), _l.r.c.LBL_00014);
				
				return isValid;
			}
		}		
		*/		

		//MAN_CHK_LAST_VISIT_DATE_1 이관 
		if ($("LAST_VISIT_DATE").value == "") {
			isValid = false;
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_XVALUE_00421);
			$("LAST_VISIT_TIME").focus();
		}
		
		// if ST035, repair received date <= 1st Visit date <= Repair Complete
		// date <= Goods delivered date
		if(_l.REPAIR_RCV_DATE == ""){
			_l.REPAIR_RCV_DATE = _l.postingDate;
		}
		if ($('SERVICE_TYPE').value == 'IH') {
			if (!checkFromToDate(_l.REPAIR_RCV_DATE,$("FIRST_VISIT_DATE").value, _l.u.DateFormat2)) {
				isValid = false;
				alert(_l.u.WEB_MSG_PREFIX + "Please check Date : The 1st Visit date cannot be prior to the Repair received Date.");
				$("FIRST_VISIT_DATE").value = '';
				moreOpenid(4);
				$j('#FIRST_VISIT_DATE').removeAttr("readonly").removeClass().addClass("input").focus();
				$j('#FIRST_VISIT_TIME').removeAttr("readonly").removeClass().addClass("input");
				$j($("FIRST_VISIT_DATE")).datepicker("destroy");
				$j('.hasDatepicker').keypress("destroy");
				$("FIRST_VISIT_DATE").onClick = showCal($("FIRST_VISIT_DATE"));
				$("FIRST_VISIT_DATE").onChange = checkValidDate($("FIRST_VISIT_DATE"));
				return isValid;
			}
			
			if (_l.CurrStatus != $('STATUS').value && !checkFromToDate($("FIRST_VISIT_DATE").value,	$("SERVICE_DATE").value, _l.u.DateFormat2)) {
				isValid = false;
				alert(_l.u.WEB_MSG_PREFIX + "Please check Date : The Repair Completed date cannot be prior to the 1st Visit date.");
				$("SERVICE_DATE").value = '';
				$("SERVICE_DATE").focus();
			}
			
			if (_l.CurrStatus != $('STATUS').value && !checkFromToDate($("LAST_VISIT_DATE").value,	$("SERVICE_DATE").value, _l.u.DateFormat2)) {
				isValid = false;
				alert(_l.u.WEB_MSG_PREFIX + "Please check Date : The Repair Completed date cannot be prior to the Last Visit date.");
				$("SERVICE_DATE").value = '';
				$("SERVICE_DATE").focus();
			}
		}
	}
	
	if ($('STATUS').value == "ST040") {
		if (_l.CurrStatus != $('STATUS').value && !checkFromToDate(_l.REPAIR_COMP_DATE,	$("SERVICE_DATE").value, _l.u.DateFormat2)) {
			isValid = false;
			alert(_l.u.WEB_MSG_PREFIX + "Please check Date : The Goods Delivered date cannot be prior to the Repair Completed date.");
			$("SERVICE_DATE").value = '';
			$("SERVICE_DATE").focus();
		}
	}
	
	// Check if the first visit date is prior to the last visit date.
	if (!isFirstVisitDateBlank && !isLastVisitDateBlank) {
		if (!checkFromToDate($("FIRST_VISIT_DATE").value,
				$("LAST_VISIT_DATE").value, _l.u.DateFormat2)) {
			isValid = false;
			alert(_l.u.WEB_MSG_PREFIX + "Please check Date : The Last Visit date cannot be prior to the 1st Visit date.");
			$("LAST_VISIT_DATE").value = '';
			$("LAST_VISIT_DATE").focus();
		}
	}
	
	// C4M6 IH, FIRST_APP_DATE, ST015.
	// ST025 시 전법인 1st app 필수 입력
	/*
	if($('SERVICE_TYPE').value == 'IH'){
		if((("C4M6" == corp || isLaUser) && ($('STATUS').value == "ST015" || $('STATUS').value == "ST030"))
				|| $('STATUS').value == "ST025"){
			
			//MAN_CHK_FIRST_APP_DATE_2 이관,	MAN_CHK_FIRST_APP_DATE_3 이관
			if ($("FIRST_APP_DATE").value == "" || $("FIRST_APP_DATE").value.substring(0,2) == "00") {
				isValid = false;
				alert(_l.r.m.MAND_XVALUE_00064);
				$j('#FIRST_APP_DATE').removeAttr("readonly").removeClass().addClass("input").focus();
				$j('#FIRST_APP_TIME').removeAttr("readonly").removeClass().addClass("input");
				$j($("FIRST_APP_DATE")).datepicker("destroy");
				$j('.hasDatepicker').keypress("destroy");
				$("FIRST_APP_DATE").onClick = showCal($("FIRST_APP_DATE"));
				$("FIRST_APP_DATE").onChange = checkValidDate($("FIRST_APP_DATE"), _l.r.c.LBL_00014);
				return isValid;
			}
		}
	}
	*/

	return isValid;
}

/**
 * 
 * //중국은 구매일, 수리완료일만 체크함. C550,C310 경우는 안타므로 validCustomerCallAttempt() 만 신경쓰면 되나
 * //이것도 C310만 타므로, UNIT_RECV_DATE 만 체크안하도록 하면됨.
 * */
function validDateInfo() {
	var valid = true;
	var dateFormat = _l.u.DateFormat2;

	
	/*
	 * purchase date <= today if there are two days then purchase date <= asc
	 * assigned date
	 */
	if (_l.u.c == "C550"
			&& checkDate($("PURCHASE_DATE").value, dateFormat)
			&& checkDate($("ASC_ASSIGN_DATE").value, dateFormat)
			&& !checkFromToDate($("PURCHASE_DATE").value,
					$("ASC_ASSIGN_DATE").value, dateFormat)) {

		alert(_l.u.WEB_MSG_PREFIX + "Purchase Date[" + $("PURCHASE_DATE").value
				+ "] cannot be later than ASC Assigned Date["
				+ $("ASC_ASSIGN_DATE").value + "].");
		moreOpenid(3);
		
		// =================================================================================//
		// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
		// Activation
		// 수정일 : 2015.08.05
		// 수정자 : 채보람 (로젠 솔루션)
		// 내 용 : 인도일 경우 PurcaseDate를 초기화 하지 않는다.
		if(!(_l.isIndia || _l.isBangladesh || _l.isSrilanka || _l.isNepal)){
			$("PURCHASE_DATE").value = "";
			allowToEditTheDate($("PURCHASE_DATE"));
			$("PURCHASE_DATE").focus();
			valid = false;
		}else{
			if(!isProdHHPIndia()){
				$("PURCHASE_DATE").value = "";
				allowToEditTheDate($("PURCHASE_DATE"));
				$("PURCHASE_DATE").focus();
				valid = false;
			}else{
				valid = false;
			}
		}
		// =================================================================================//

	} else if (!checkDateIsNotFutherForCorrectDate($('PURCHASE_DATE'),
			_l.r.c.LBL_00624, 3)) {
		valid = false;
// } else
	/*
	 * customer request date <= today : C310 don't use this date unit received
	 * date <= today repair complete date <= today
	 */
// if (!(_l.u.c == "C310" || _l.u.c.substring(0, 2) == "C8")
// && !checkDateIsNotFutherForCorrectDate($('REQUEST_DATE'),
// _l.r.c.LBL_00202, 5)) {
// valid = false;
	} else if (!_l.u.isChinaRegion && !checkDateIsNotFutherForCorrectDate($('UNIT_RECV_DATE'),
			_l.r.c.LBL_00898, 5)) {
		valid = false;
	} else if (!checkDateIsNotFutherForCorrectDate($('REPAIR_COMP_DATE'),
			_l.r.c.LBL_00662, 5)) {
		valid = false;
	}
	/*
	 * [SECA] UNIT_RECV_DATE must be past in 30 days CI and PS Ticket has only
	 * checked Unit Received Date.
	 */
	else if (_l.u.c == "C330"
			&& ($('REP_TYPE').value == "CI" || $('REP_TYPE').value == "PS")
			&& ("ST025|ST030|ST035".indexOf($('STATUS').value) != -1)
			&& !checkDateIs30DaysPast($('UNIT_RECV_DATE'), _l.r.c.LBL_00898)
			&& $("UNIT_RECV_DATE").className != "inputRO") {
		valid = false;
	} else if (!validCustomerCallAttempt()) {
		valid = false;
	}
	return valid;
}

function validCustomerCallAttempt() {

	if (!canSeeCallAttempt) {
		return true;
	}
	var valid = true;

	var callDate1 = $("CALL_ATTEMPT1_DT").value;
	var callTime1 = $("CALL_ATTEMPT1_TM").value;
	var callDate2 = $("CALL_ATTEMPT2_DT").value;
	var callTime2 = $("CALL_ATTEMPT2_TM").value;
	var callDate3 = $("CALL_ATTEMPT3_DT").value;
	var callTime4 = $("CALL_ATTEMPT3_TM").value;
	var userDateFormat = _l.u.DateFormat2;

	var needToInputAll = needToInputCustomerCallAttempt();

	if (needToInputAll || !callDate1.strip().blank()) {
		if (!onchangeCallAttempt(1)) {
			valid = false;
			return valid;
		}
		if (!onchangeCallAttemptTime(1)) {
			valid = false;
			return valid;
		}
	}

	if (needToInputAll || !callDate2.strip().blank()) {
		if (!onchangeCallAttempt(2)) {
			valid = false;
			return valid;
		}
		if (!onchangeCallAttemptTime(2)) {
			valid = false;
			return valid;
		}
	}

	if (needToInputAll || !callDate3.strip().blank()) {
		if (!onchangeCallAttempt(3)) {
			valid = false;
			return valid;
		}
		if (!onchangeCallAttemptTime(3)) {
			valid = false;
			return valid;
		}
	}

	return valid;
}

/*******************************************************************************
 * * dateControl : PURCHASE_DATE * dateControlDesc : Purchase Date * divId : 3
 ******************************************************************************/
function checkDateIsNotFutherForCorrectDate(dateControl, dateControlDesc, divId) {
	var isOk = true;
	var dateFormat = _l.u.DateFormat2;
	if (checkDate(dateControl.value, dateFormat)) {
		if (!checkFutureDate(dateControl, dateControlDesc)) {
			moreOpenid(divId);
			allowToEditTheDate(dateControl);
			dateControl.value = '';
			dateControl.focus();
			isOk = false;
		}
	}
	return isOk;
}

function checkFutureDate(obj, dateFieldDesc) {
	if (!checkFromToDate(obj.value, _l.today, _l.u.DateFormat2)) {
		alert(_l.u.WEB_MSG_PREFIX + dateFieldDesc + "[" + obj.value + "] " + _l.r.m.EXT_0156 + "["
				+ _l.today + "]"); // 미래날짜는 안됨
		obj.value = '';
		return false;
	}
	return true;
}

function showCustomerCallAttempt(visible){
// if(visible){
// $("trCustomerCallAttempt").show();
// }else{
// $("trCustomerCallAttempt").hide();
// }
// 2013-12-03 에러방지용 임시코드 추가
	if(!$("trCustomerCallAttempt"))return;
	
	if(visible){		
		$("trCustomerCallAttempt").show();
	}else{
		$("trCustomerCallAttempt").hide();
	}
}

function needToInputCustomerCallAttempt() {
	var needToInput = false;
	var status = "";
	var reason = "";
	if ($("STATUS")) {
		status = $("STATUS").value;
	}
	if ($("REASON")) {
		reason = $("REASON").value;
	}
	// ST052(Cancelled by ASC) Customer Not Home(More than X times)[HC025]
	if (status == "ST052" && reason == "HC025") {
		needToInput = true;
	}
	return needToInput;
}

function onchangeCallAttempt(calltype) {
	var valid = true;
	var callDate1 = $("CALL_ATTEMPT1_DT").value;
	var callTime1 = $("CALL_ATTEMPT1_TM").value;
	var callDate2 = $("CALL_ATTEMPT2_DT").value;
	var callTime2 = $("CALL_ATTEMPT2_TM").value;
	var callDate3 = $("CALL_ATTEMPT3_DT").value;
	var callTime4 = $("CALL_ATTEMPT3_TM").value;
	var userDateFormat = _l.u.DateFormat2;

	var dateField = $("CALL_ATTEMPT1_DT");
	var timeField = $("CALL_ATTEMPT1_TM");
	var dateDesc = _l.r.c.LBL_01703;

	if (calltype == 1) {
		dateField = $("CALL_ATTEMPT1_DT");
		timeField = $("CALL_ATTEMPT1_TM");
		dateDesc = _l.r.c.LBL_01703;
	} else if (calltype == 2) {
		dateField = $("CALL_ATTEMPT2_DT");
		timeField = $("CALL_ATTEMPT2_TM");
		dateDesc = _l.r.c.LBL_01704;
	} else if (calltype == 3) {
		dateField = $("CALL_ATTEMPT3_DT");
		timeField = $("CALL_ATTEMPT3_TM");
		dateDesc = _l.r.c.LBL_01705;
	}
	// is the date correct format?
	// is the date >= posting date ?
	// is the date <= today ?
	if (!validCallAttemptForTodayPostingDate(dateField, dateDesc)) {
		valid = false;
		return valid;
	}
	// 1st call attempt
	if (calltype == 1) {
		// start-----------: if(calltype == 1){
		// is th 1st date < 2st date ?
		if (!callDate2.strip().blank()) {
			var dateOrderIsCorrect = compareTwoDate(callDate1, callDate2,
					userDateFormat, "<");
			if (!dateOrderIsCorrect) {
				valid = false;
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0127);
				return valid;
			}
		}
		// end--------if(calltype == 1){
	} else if (calltype == 2) {
		// start-----------: if(calltype == 2){

		// is th 1st date < 2st date ?
		var dateOrderIsCorrect = compareTwoDate(callDate1, callDate2,
				userDateFormat, "<");
		if (!dateOrderIsCorrect) {
			valid = false;
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0127);
			return valid;
		}

		// is th 2st date < 3st date ?
		if (!callDate3.strip().blank()) {
			var dateOrderIsCorrect23 = compareTwoDate(callDate2, callDate3,
					userDateFormat, "<");
			if (!dateOrderIsCorrect23) {
				valid = false;
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0127);
				return valid;
			}
		}

		// end--------if(calltype == 2){
	} else if (calltype == 3) {
		// start-----------: if(calltype == 3){

		// is th 1st date < 2st date ?
		var dateOrderIsCorrect = compareTwoDate(callDate1, callDate2,
				userDateFormat, "<");
		if (!dateOrderIsCorrect) {
			valid = false;
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0127);
			return valid;
		}

		// is th 2st date < 3st date ?
		var dateOrderIsCorrect23 = compareTwoDate(callDate2, callDate3,
				userDateFormat, "<");
		if (!dateOrderIsCorrect23) {
			valid = false;
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0127);
			return valid;
		}

		// end--------if(calltype == 3){
	}

	return valid;
}

// are the call attempt dates valid for today and posting date?
function validCallAttemptForTodayPostingDate(callDate, dateDesc) {
	var valid = true;
	var userDateFormat = _l.u.DateFormat2;

	// is the date correct format?
	if (!checkDate(callDate, userDateFormat)) {
		valid = false;
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0145 + " : " + dateDesc);
		callDate.focus();
		return valid;
	}

	// is the date >= posting date ?
	var postingDate = _l.postingDate;
	var callDateIsAfterPostingDate = compareTwoDate(postingDate, callDate,
			userDateFormat, "<=");
	if (!callDateIsAfterPostingDate) {
		valid = false;
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0128);
		return valid;
	}
	// is the date <= today ?
	var today = _l.todayUserFormat;
	var callDateIsBeforeToday = compareTwoDate(callDate, today, userDateFormat,
			"<=");
	if (!callDateIsBeforeToday) {
		valid = false;
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0129);
		return valid;
	}
	return valid;
}

function onchangeCallAttemptTime(calltype) {
	var valid = true;

	var timeField = $("CALL_ATTEMPT1_TM");
	var dateDesc = _l.r.c.LBL_01703;

	if (calltype == 1) {
		timeField = $("CALL_ATTEMPT1_TM");
		dateDesc = _l.r.c.LBL_01703;
	} else if (calltype == 2) {
		timeField = $("CALL_ATTEMPT2_TM");
		dateDesc = _l.r.c.LBL_01704;
	} else if (calltype == 3) {
		timeField = $("CALL_ATTEMPT3_TM");
		dateDesc = _l.r.c.LBL_01705;
	}

	if (!validCallAttemptTime(timeField, dateDesc)) {
		valid = false;
		return valid;
	}
	return valid;
}

// are the call attempt time valid ?
function validCallAttemptTime(timeField, dateDesc) {
	var valid = true;

	// is the time correct format?
	var callTime = timeField.value.strip();
	if (callTime.length != 8) { // not empty ex) 23:59:59
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0146 + " : " + dateDesc + " " + _l.r.m.EXT_0147);
		timeField.focus();
		valid = false;
	} else if (callTime.substring(0, 2) == "00") {// not start with 00
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0146 + " : " + dateDesc + " " + _l.r.m.EXT_0147);
		timeField.focus();
		valid = false;
	}
	return valid;
}

function validImeiSerial() {
	var frm = $('detailForm');

	//아래로직은 중국은 안타야 함, 다행이 HHPAccessoryNoSerial 은 인도경우만 실행됨. 
	if (_l.HHPAccessoryNoSerial) {
		var fileExist = $('attachTableBody').rows.length > 0;
		if (!HHPAccessoryOnSaveTicket("CHANGE", $('SVC_PRCD').value, fileExist,
				$('IN_OUT_WTY').value, $('STATUS').value)) {
			return false;
		}
	}// if(HHPAccessoryNoSerial){
	
	//var checkD2D = $("STATUS").value == "ST015" && _l.SERVICE_TYPE == "PS" && D2D 체크로직 추가;
	var checkD2D = _l.isIndia && _l.isHHPIndia && $("STATUS").value == "ST015" && _l.SERVICE_TYPE == "PS" && _l.shipMethod == "01";
	
	if (!_l.isModelReadOnly && !checkD2D) {
		var serialNo = frm.SERIAL_NO.value.strip();
		if (serialNo.blank() || !validAlphabetNumber(serialNo)) {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0050_00747);
			$j(frm.SERIAL_NO).addClass("inputIDS").prop("readonly", false);
			frm.SERIAL_NO.focus();
			return false;
		}
	}// if(isModelReadOnly){%>
	var mptsPrdCodeList = _l.r.c.MPTS_PRD_CODE_LIST.evalJSON();
	var svcProd = $("SVC_PRCD").value;
	if(_l.useHrPrdCodeMPTS){
		svcProd = $('HQ_SVC_PRCD').value;
	}
	var isHHPProduct = false;
	for(var i=0; i<mptsPrdCodeList.length; i++){
		if(svcProd == mptsPrdCodeList[i].codeId){
			isHHPProduct = true;
			break;
		}
	}
	if(_l.u.c == "C370" && _l.CIC_PRCD == "HHP"){
		isHHPProduct = true;
	}
	if (!_l.isCompletedReadOnly && !checkD2D) {
		var imei = frm.IMEI.value.strip();
		if (!validAlphabetNumber(imei) || (!_l.u.isChinaRegion && isHHPProduct && imei.blank())) {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0050_00747);
			frm.IMEI.focus();
			return false;
		}
	}// if(isCompletedReadOnly){%>

	// if(imei != "" && imei.length != <%//=IMEI_LENGTH%>){
	// alert("<%//=resource.getMessageArg("MSG/EXT_0051",
	// resource.getContent("LBL/00369"), String.valueOf(IMEI_LENGTH))/*Please
	// enter on ${args.0}, exactly ${args.1} characters*/%>");
	// frm.IMEI.focus();
	// return false;
	// }

	var serialNoNew = frm.NEW_SERIAL_NO.value.strip();
	if (!validAlphabetNumber(serialNoNew)) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0050_00479);
		frm.NEW_SERIAL_NO.focus();
		return false;
	}

	var imeiNew = frm.NEW_IMEI.value.strip();
	if (!validAlphabetNumber(imeiNew)) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0050_00475);
		//IMEI PROJECT
		if(isAutoImei){
			frm.NEW_IMEI_TXT.focus();
		}else{
			frm.NEW_IMEI.focus();
		}

		
		return false;
	}
	return true;
}

function HHPAccessoryOnSaveTicket(mode, localProd, fileExist, wtyTerm, status) {
	var needAlert = (localProd == "HHP03" && wtyTerm == "LP" && !fileExist);
	var valid = true;

	if (mode == "CHANGE") {
		needAlert = needAlert && !(status == "ST052" || status == "ST040");
		if (needAlert) {
			alert(_l.u.WEB_MSG_PREFIX + "In case of Accessory purchased separately upload accessory invoice copy.");
			valid = false;
		} else {
			valid = true;
		}
	} else {
		if (needAlert) {
			valid = !confirm(_l.u.WEB_MSG_PREFIX +"In case of Accessory purchased separately, uploading of accessory Invoice copy is mandatory.\nDo you want to upload the invoice copy now?");
		}
	}

	return valid;
}

/**
 * for serial, imei number check
 */
function validAlphabetNumber(val) {
	return (val == "" || val.isAlphabetNumber());
}

function isDate0000(_fromDate, _compFormat) {
	var fromD, FromYear, FromMon, FromDay, _displayFromDate;
	var gubun = compFormatCheck(_compFormat);
	if (typeof _fromDate === "object") {
		_displayFromDate = _fromDate.value;
	} else {
		_displayFromDate = _fromDate;
	}

	FromYear = toDisplayYear(_displayFromDate, gubun, _compFormat);
	FromMon = toDisplayMonth(_displayFromDate, gubun, _compFormat);
	FromDay = toDisplayDay(_displayFromDate, gubun, _compFormat);

	var FromYmd = String(FromYear) + String(FromMon) + String(FromDay);

	if (FromYmd == "00000000")
		return true;
	return false;
}

/**
 * purchase date, ASC Assigned date, dealer invoice, defect desc, repair desc
 * need upper fields are mandatory for DOA Cert issue!
 */
function validDOACertIssue() {
	var frm = $('detailForm');

	// status, reason is not exist
	if (!frm.STATUS || !frm.REASON) {
		return true;
	}
	// only check when Service type is RH
	if (frm.SERVICE_TYPE.value != "RH") {
		return true;
	}

	var svcProd = $("SVC_PRCD").value;
	// var isHHPProduct = ("HHP01" == svcProd || "HHP02" == svcProd || "HHP05"
	// == svcProd);
	var isHHPProduct = ("HHP01,HHP02,HHP05,DSC05,HHP1A,HHP1B,HHP2A,HHP2B,HHP06".indexOf(svcProd) != -1);
	var currStatus = _l.CurrStatus;
	var userStatus = frm.STATUS.value;
	var transitToGD = (currStatus != userStatus && userStatus == "ST040");
	var serviceType = frm.SERVICE_TYPE.value;
	var statusReason = frm.REASON.value;
	var wtyInOut = $('IN_OUT_WTY').value;
	var repairCode = $('IRIS_REPAIR').value;
	
	var purchasePlace = $('PURCHASE_PLACE').value;
	

	// status = Good Delivered and reason = DOA Certificated Issued
	// HG071
	if (userStatus == "ST040" && serviceType == "RH" && isHHPProduct
			&& wtyInOut == "LP" && repairCode == "RP" && "C550" == _l.u.c) {
		//C20060009736-Reason Code 표준화	
		if (statusReason == "HOZ01" || statusReason == "HG071" ) {
			var purchaseDate = frm.PURCHASE_DATE.value.strip();
			if (purchaseDate.length <= 8) {
				moreOpenid(3);
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0052_00624);
				frm.PURCHASE_DATE.focus();
				return false;
			}

			// =================================================================================//
			// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
			// Activation
			// 수정일 : 2015.04.28
			// 수정자 : 채보람 (로젠 솔루션)
			// 내 용 : 인도일 경우 DOA 자격이 있을 경우에만 체크 하도록 변경.
			if(_l.isHHPIndia && _l.isIndia){
				if(!(statusReason == "HOZ01" && _l.sawExistExchangeApporvedTa3) || isEligibleDOA()){
					var localInvoiceNo = frm.LOCAL_INVOICE_NO.value.strip();
					if (localInvoiceNo == "") {
						moreOpenid(3);
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0052_00223);
						frm.LOCAL_INVOICE_NO.readOnly = false;
						$("LOCAL_INVOICE_NO").removeClassName("inputRO");
						$("LOCAL_INVOICE_NO").addClassName("input");
						frm.LOCAL_INVOICE_NO.focus();
						return false;
					}
				}else{
					alert(_l.u.WEB_MSG_PREFIX + "You cannot select reason(HG071) for Non DOA service order.");
					return false;
				}
			}else{
				var localInvoiceNo = frm.LOCAL_INVOICE_NO.value.strip();
				if (localInvoiceNo == "") {
					moreOpenid(3);
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0052_00223);
					frm.LOCAL_INVOICE_NO.readOnly = false;
					$("LOCAL_INVOICE_NO").removeClassName("inputRO");
					$("LOCAL_INVOICE_NO").addClassName("input");
					frm.LOCAL_INVOICE_NO.focus();
					return false;
				}
			}
			// =================================================================================//

			var defectDesc = frm.DEFECT_DESC.value.strip();
			if (defectDesc == "") {
				moreOpenid(3);
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0052_00229);
				frm.DEFECT_DESC.readOnly = false;
				$("DEFECT_DESC").removeClassName("inputRO");
				$("DEFECT_DESC").addClassName("input");
				frm.DEFECT_DESC.focus();
				return false;
			}
		} else {// if(statusReason == "HG071"){

			// Status reason <> HG071 && hhp 제품의 경우 체크 시작.
			if ("C550" == _l.u.c) {
				if ("IN" == _l.u.CountryCd) {
					
					// =================================================================================//
					// 제 목 : 인도 Demand HHP Warranty Verification Process Change
					// with Sim Activation
					// 수정일 : 2015.04.28
					// 수정자 : 채보람 (로젠 솔루션)
					// 내 용 : Sim activation 연계로 보증기간 검증 프로세스 강화.
					// 따라서 DOP가 7일 내이며 DOA seal no. 가 입력된 건에 대해 DOA 발행 허가토록 함.
					if(_l.isHHPIndia && _l.isIndia){
						// DOP 7일 이내, HG071 코드 미입력, Product tab 활성 여부, DOA seal
						// no 7자 입력
						if(transitToGD && isEligibleDOA()){
							if(_l.PURCHASE_PLACE.length == 7 && $j("#REASON").val() == ""){
								alert(_l.u.WEB_MSG_PREFIX + "Kindly select HG071 DOA certificate issued in Reason as this is DOA call.");
								return false;
							}
							
							if($j("#PURCHASE_PLACE").val() != "" && $j("#PURCHASE_PLACE").val().length == 7 && $j("#REASON").val() == ""){
								alert(_l.u.WEB_MSG_PREFIX + "Kindly select HG071 DOA certificate issued in Reason as this is DOA call.");
								return false;
							}
						} 
					}else{
						if (transitToGD && !_l.sawExistExchange) {
							alert(_l.u.WEB_MSG_PREFIX + "Kindly select DOA certificate issue(HG071) as reason if it is DOA sets!");
							return false;
						}
					}
					// =================================================================================//
					
				} else if("LK" == _l.u.CountryCd || "NP" == _l.u.CountryCd || "BD" == _l.u.CountryCd || "MV" == _l.u.CountryCd){
                    if(transitToGD && !(_l.sawExistExchange || _l.sawExistExchangeForBranchApproved)){
                        alert(_l.u.WEB_MSG_PREFIX + "Before goods delivered , Kindly select DOA certificate issue(HG071) as reason for DOA sets!");
                        return false;
                    }
                } else {
					if (transitToGD) {
						alert(_l.u.WEB_MSG_PREFIX + "Before goods delivered , Kindly select DOA certificate issue(HG071) as reason for DOA sets!");
						return false;
					}
				}
			}

		}// if(statusReason == "HG071"){
	}else if(userStatus == "ST035" && "C550" == _l.u.c){
		var isCheckedDoaSeal = true;
		if(isHHPProduct && serviceType == "RH"){
			if (!purchasePlace.blank() && purchasePlace.length == 7) {
				if(_l.sawExistExchangeRequestedTaExt || _l.sawExistExchangeApporvedTaExt){
					isCheckedDoaSeal = true;
				}else{
					isCheckedDoaSeal = false;
				}
			}
			
			// =================================================================================//
			// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
			// Activation
			// 수정일 : 2015.04.28
			// 수정자 : 채보람 (로젠 솔루션)
			// 내 용 : Warranty 버튼 누른 후, DOA 자격이고, Activation Date 가 존재하고, BOS 첨부가
			// 없으면
			if(_l.isIndia && _l.isHHPIndia){
				var cssFlag = $j("#tableBOSBtn").css("display");
				
				if(cssFlag != "none" && _l.pageInitSimActDate == ""){
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0079);
					return false;
				}
				
				if(cssFlag != "none" && _l.pageInitSimActDate != ""){
					isCheckedDoaSeal = true;
				}
			}
			// =================================================================================//
			if(!isCheckedDoaSeal){
				alert(_l.u.WEB_MSG_PREFIX + "In DOA call it is mandatory to enter SAW in exchange category with TA reason.");
				return false;
			}
		}
		
	}
	//C20060009736-Reason Code 표준화
	if(isHHPProduct && serviceType == "RH" && purchasePlace.length == 7 && _l.sawExistExchangeApporvedTa && userStatus == "ST040" && (statusReason != "HOZ01" && statusReason != "HG071") && "C550" == _l.u.c){
		alert(_l.u.WEB_MSG_PREFIX + "Kindly select HG071 DOA certificate issued  in Reason as this is DOA call");
		return false;
	}
	
	return true;
}

/**
 * check some service type is madatory SAW case C750 IS/PD (Inspection or
 * Product Discount) : SRC10 Warranty Extension(Grace period) SR (Srvice
 * Return): SRC36 Stock Repair SP (Service Point): SRC30 DAP Repair(SETK)
 * 
 */
function validSAW_ServiceType() {
	var frm = $('detailForm');
	if (!_l.hasServiceTypeNeedSAW) {
		return true;
	}

	var sawCategory = "";
	if (frm.STATUS.value == "ST035" || frm.STATUS.value == "ST040") {// Repair
																		// completed,
																		// Goods
																		// Deliveried
		var serviceType = $("SERVICE_TYPE").value;
		if (serviceType == "IS" || serviceType == "PD") { // Inspection or
															// Product Discount
			sawCategory = "SRC10";// Warranty Extension(Grace period)
		} else if (serviceType == "SR") { // Srvice Return
			sawCategory = "SRC36";// Stock Repair
		} else if (serviceType == "SP") { // Service Point
			sawCategory = "SRC30";// DAP Repair(SETK)
		}
	}// if(frm.STATUS.value == "ST035" ){//Repair completed

	if (sawCategory == "") {
		return true;
	}

	var hasSaw = false;
	var arrSawCategory = cfArray(frm.SAW_CATEGORY);
	var arrSawStatus = cfArray(frm.SAW_STATUS);
	for ( var i = 0, maxLen = arrSawCategory.length; i < maxLen; i++) {

		// SS005 requested, SS010 : approved
		if (arrSawStatus[i].value == "SS010"
				&& sawCategory == arrSawCategory[i].value) {
			hasSaw = true;
			break;
		}

	}// for(var i = 0, maxLen = arrSawCategory.length; i < maxLen; i++){

	if (!hasSaw) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0189);
	}
	return hasSaw;
}

/**
 * Check logic 1 : Status ->ST035 -if svc type = RH & repair code <> (RP/RT)
 * then error "Cant save, Kindly select Repair code “RP" or "RT" for svc type
 * RH” Reason : Only 2 repair codes(RP/RT) allowed for svc type RH. “RP” to
 * Accept Return & “RT” to Reject Return
 * 
 * Check logic 2 : ST035 <<== in RFC -if svc type = RH in current ticket then
 * search history of same serial/model for svc type RH ST040 calls If previous
 * RH exist with Repair code "RT" in history then error "Cant save, Return has
 * been Rejected for this serial/model“ Reason : RH Ticket Creation block in
 * case Return has been already rejected for same serial/model
 * 
 * Check logic 3 : ST035 If svc type = RH and Product = HHP and Repair code
 * ="RT" then a) warning error "DOA certificate will not be issued for Rejected
 * Return“ (Ticket can be save) b) ASC can NOT select ST040 Reason : HG071 DOA
 * Certificate in this case Reason : Block HHP DOA Certificate creation if
 * Return has been rejected by svc center
 * 
 */
function validReturnHandlingTicket() {
	var valid = true;
	if (!_l.checkReturnHandlingByRepairCode) {
		return valid;
	}
	
	var serviceType = $('SERVICE_TYPE').value;
	var status = $("STATUS").value;
	var statusReason = $("REASON").value;
	var repairCode = $('IRIS_REPAIR').value;
	var svcProd = $("SVC_PRCD").value;
	var isSAARC = _l.isBangladesh || _l.isSrilanka || _l.isNepal || _l.isMaldives;

	if ("RH" == serviceType 
			|| ("IS" == serviceType && isSAARC)) {
	} else {
		return valid;
	}

	if (status == "ST035" || status == "ST040") {
	} else {
		return valid;
	}
	
	/**
	 * Check logic : If Country = LK, NP, BD, MV and Screen Status = ST040
	 * 1. If status Reason = HG071 & if SRC41 (TA) <> SS010 then error “SAW under category TA is mandatory”
	 * 2. If SRC41 (TA) = SS010 & status Reason <> HG071 & repairCode <> "RT" then Error “Select reason “DOA certificate issue””
	 * 4. If Status = ST040, Svc type RH, If Status Reason <> HG071 & if SRC41 (<>TA)  <> SS010 then error “Exchange SAW under category Non TA is mandatory”
	 */		
	if(isSAARC){
		if(status == "ST040"){
			//C20060009736-Reason Code 표준화
			if(statusReason == "HOZ01" || statusReason == "HG071"){				// logic(1)
				if(!_l.sawExistExchangeForBranchApprovedTa){
					alert("SAW under category TA is mandatory");
					valid = false;
					return valid;
				}
			}else{								// logic(4)
				if("RH" == serviceType){
					if(!_l.sawExistForBranchExchange || 
							(_l.sawExistExchangeForBranchNotReasonTa && "SS010" != _l.sawExistForBranchExchangeStatus)){
						alert("Exchange SAW under category Non TA is mandatory");
						valid = false;
						return valid;
					}
				}
			}
			if(_l.sawExistExchangeForBranchApprovedTa){	// logic(2)
				//C20060009736-Reason Code 표준화
				if(statusReason != "HOZ01" && statusReason != "HG071" && repairCode != "RT"){
					alert("Select reason “DOA certificate issue”");
					valid = false;
					return valid;
				}
			}
		}
	}	

	// check logic 1
	if (status == "ST035") {
		if (repairCode == "RP" || repairCode == "RT") {
			// B2B 고객은 ST035 불가 2017.04.14 jiw
			if("B" == _l.u.CenterType){
				alert(_l.u.WEB_MSG_PREFIX + "Can not save! This is B2B customer. Please create exchange SAW under TD3 category.");
				valid = false;
				return valid;
			}
		} else {
			if("IS" == serviceType && isSAARC){
				alert(_l.u.WEB_MSG_PREFIX + "Can not save, kindly select repair code RP or RT for svc type “IS”");
			}else{
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0176);
			}
			valid = false;
			return valid;
		}
	}

	// chek logic 2 : in RFC

	// check logic3
	var isHHPProduct = ("HHP" == svcProd.substring(0, 3));
	if (isHHPProduct && repairCode == "RT") {
		if (status == "ST035") {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0177);
		} else if (status == "ST040" && (statusReason == "HOZ01" || statusReason == "HG071")) {//C20060009736-Reason Code 표준화
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0177);
			valid = false;
			return valid;
		}
	}

	return valid;
}

/**
 * * this function is called both onclick "All Save button" and "Part Save button"
 * 중국소스는 partOnly 파라미터를 받음. 
 * partOnly 는 자재만 저장할경우 true 가 넘어옴.다른곳에서는 partOnly 을 던지지도 않음.  
 * 그러나, 자재만 저장하는 기능은 여러문제로 통합시 제외하기로 하여 파라미터 추가 안함.
 */
function verifyPartInfoToSave() {
	var statusCode = $("STATUS").value;
	var reason = $('REASON').value;
	
	
	
	//new,old part,qty 무조건 필수,
	//TXT 타입은 워런티 수정화면에서 추가한다.10번은 수정못하는데 ??? 어떻게 추가하지?
	if(isNewChina){
		if(!validOldNewPartCheck()) {
			return false;
		}
	}
	
	
	
	// common check logic for part code, location, qty
	//china : 중국은 무조건 checkPartsSave() 타야함.
	if (_l.u.isChinaRegion ||  !(isMedisonUser && statusCode != "ST035")) {
		if (!checkPartsSave()) {
			return false;
		}
	}

	if (isMedisonUser && !checkOldPartsSave()) {
		return false;
	}
	
	// Accessory serial number check logic C550
	//china : 아래로직은 중국에 없지만, 중국경우 아래로직 타지 않으므로, 별도 분기처리 안함. 
	//validHHPAccessorySerialParts() 는 C550 만 타고 아래는  C370 경우만 사용.
	if (statusCode == "ST035" || statusCode == "ST040") {
		if (!validHHPAccessorySerialParts()) {//C550 경우만 사용.
			return false;
		}
/*		if(_l.u.c == "C370"){
			var hasPart = hasRepairPart();
			var arrParts = $j("#partsTableBody input[name='PARTS_CODE']");// cfArray(frm.PARTS_CODE);
			var arrSerialParts = $j("#partsTableBody input[name='SERIAL_MAT']");// cfArray(frm.PARTS_CODE);
			var partLen = arrParts.length;
			for ( var i = 0; i < partLen; i++) {
				
				if(arrSerialParts[i].value.blank()){
					alert("Please input part serial number in Repair parts information");
					arrSerialParts[i].focus();
					//SEA IM (C370)은 ST035 (Repair Completed)전에 Parts Serial이 필수입력 requested by 황상진 차장
					//break; 명령을 return false; 로 변경
					return false;
				
				//C370은 Parts Serial 자리에 Repair Code를 자동으로 넣어준다. request by 유상우 과장
				if($j.trim(arrParts.eq(i).val()) != ""){
					arrSerialParts.eq(i).val($j("#IRIS_REPAIR").val());
				}
			}
		}*/
	}
	
	//china : 아래 로직은 중국소스에는 없지만, 중국경우 안타므로 별도 분기 처리하지 않고 그대로 둠.
	if(_l.FSC) {
		if ((_l.u.c != "C820" && (statusCode == "ST035" || statusCode == "ST040")) 
				|| (_l.u.c == "C820"&& (statusCode == "ST035" && reason == "HL005"))) {
			
			var repairPartCode  = $j("#partsTableBody input[name='PARTS_CODE']");
			var repairGIDoc = GIObj = $j("#partsTableBody input[name='gi_document_no']");
			var validGiPosting = true;
			for(var i=0; i<repairGIDoc.length; i++){
				if(repairPartCode[i].value != "" && repairGIDoc[i].value == "") {
					validGiPosting = false;
					break;					    
				}
			}
			if(_l.u.c == "C310"){
				//if((!_l.isAutoWty && statusCode == "ST035") || (_l.isAutoWty && statusCode == "ST040")){
				if(statusCode == "ST040"){
					if (!validGiPosting) {				
						
						if(statusCode == "ST035"){
							alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0002);
						}else if(statusCode == "ST040"){
							alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0645);	
						}
						moreOpenid(10);
						valid = false;
						return valid;
					}
				}
			}else{
				if(!validGiPosting) {
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0002);
					return false;
				}
			}
		}		
	}
	
	//china : 아래 로직은 중국소스에는 없지만, 중국경우 안타므로 별도 분기 처리하지 않고 그대로 둠.
	//if(_l.u.c == "C310" || _l.u.c == "C370" || _l.isUseBilling){
	if(_l.u.c == "C310" || _l.u.c == "C370"){
		if(_l.isAutoWty && statusCode == "ST035" && _l.IN_OUT_WTY=="OW" && _l.isBillingSaved){
			alert(_l.u.WEB_MSG_PREFIX + "Already Billing saved.");
			return false;
		}
	}
	
	
	// [SEDA] Invoice No should be mandatory for ST035
	//china : 아래 로직은 중국소스에는 없지만, 중국경우 안타므로 별도 분기 처리하지 않고 그대로 둠.
	if(!_l.isRunningOnOperation){
		if(!isExistInvoiceNoForPart()){
			return false;
		}
	}

	//china : 중국경우 자재만 저장하는경우, GI상태 체크하지 않음.
	//자재만 저장하는 버튼 제거되엇으므로, partOnly는 언제나 undefined 이고   if(!partOnly){  조건은 늘 타게됨.
	//중국은 ST040 or ST052 경우  validPartGIStatus() 를 타지만,  validPartGIStatus() 안에서는 ST035 or ST040, ST052 상태에 따라서 조건 분기가 있음.
	//그러니 if(statusCode == "ST040" || statusCode == "ST052"){	 이 조건에 ST035를 추가해야 할것으로 보이나, 임의판단을 보류함.
	//다만 자재저장버튼을 통합할경우는 partOnly=true로 와서 validPartGIStatus()는 절대 타지 않음.
	//if(!partOnly){//Order 전체 저장 , partOnly==true : part 정보만 저장..
	//	var statusCode = $("STATUS").value;
	//	if(statusCode == "ST040" || statusCode == "ST052"){	
	//		if( !validPartGIStatus() ){
	//			return false;
	//		}
	//	}
	//}

	
	//중국은 ST035 이후 거의 모든 정보 수정 못하도록 해서, GI는 ST035 이전에 체크되도록 로직을 변경한다.
	//if (_l.u.isChinaRegion){
	//	if(statusCode == "ST040" || statusCode == "ST052"){
	//		if (!validPartGIStatus("S")) {
	//			return false;
	//		}
	//	}
	//}else{
		if (!validPartGIStatus("S")) {
			return false;
		}
	//}

	/**
	 * * when S/O is saved with ST035 and reason about part pending such as
	 * "Parts Not Available", * at least one part with part code should be.
	 */
	//중국 분기후 머지
	if (!validPartOnPendingPartReason()) {
		return false;
	}

	/**
	 * * some pending reasone must need the salea order no and item no
	 */
	//china : 중국은 아래체크하지 않음, 하지만 함수 내부에 _l.salesOrderPopup 이 참이여서 체크하게됨.
	if (!_l.u.isChinaRegion && !validSalesOrderOnPendingReason()) {
		return false;
	}

	/*
	 * check if SO has repair code to need the part repair code : DPRT -
	 * DEFECTIVE PART REPLACEMENT
	 */
	//china e : 중국은 아래체크안하하지만 그대로도무관.. 왜냐면 아래로직은 C310,370만 타게됨.
	if (!validRepairParts()) {
		return false;
	}

	// [SIEL] Check if the location is valid.
	//china e : 중국은 아래체크안하하지만 그대로도무. 왜냐면 아래로직은 C550만 타게됨.
	if (!isLocationValid()) {
		return false;
	}
	
	// [SIEL] Serial no. to be mandatory for compressor
	//china : 중국은 if(useCompCheck){ 조건 안에서 validCompSerialForSiel() 호출됨. 즉 useCompCheck로 한버더 감싸져 있음.
	//그러나, 	validCompSerialForSiel() 함수 맨 앞에 체크로직을 탈지 말지의 조건이 있어서, 그곳에 useCompCheck 로직을 추가함.
	// 인도 GMES 적용 2018.01.05 jiw
	// 인도랑 중국만 사용하는 고가자재 검증로직인데, 인도는 sap으로 로직이관하여 중국만 타도록 변경 2023.11.02
	// 다시 C550 원복(5개센터 제외) 2024.02.01
	if(!newValidCompSerialForSiel()){
		return false;
	}
	
	// 실물검증 Check Logic 2016.09.20 jiw
	//함수내에 특정 asc만 탇록 되어 있어서 중국은 안탐.
	if(!validSerialGMES()){
		return false;
	}
	
	// octa battery 검증 로직 2017.04.21 jiw
	if(!octaBatteryVerification(true)){
		return false;
	}
	
	//중국 분기후 머지.
	if (!isGasLeakValid()) {
		return false;
	}

	// when Resoldering or Alignment, repair code is one of them
	//china : 중국은 C6V0 외에만   !validPartLocation() 을 타도록 되어 있음.
	//그러나, validPartLocation() 탈지말지 조건이 validPartLocation() 함수 내에 있으므로, 그곳으로 c6V0 이외만 타는로직 이동시킴.
	if (!validPartLocation()) {
		return false;
	}
	
	//china : 아래로직은 중국에서 타지 않음. 그래서 _l.u.isChinaRegion 조건 추가함.
	if(!(_l.u.isChinaRegion || _l.u.c == "C850" || _l.u.c == "C813" || _l.isSamsungMobileCare) || _l.noMoreUseModelForADH){
		if ("AD" == $('SERVICE_TYPE').value && (statusCode == "ST035" || _l.isBillingSaved)) {
			if (!isAddedPartsForADH()) {//partcode 가 GH96*, GH97*, GH82* 여야만함 : LCD OTA Parts(GH96*, GH97*, GH82*)should be inputted
				return false;
			}
		}
	}

	//china : 아래로직은 중국에서 타지 않음.
	//validPartQty() 내부에서 C550 이나 위탁사용자만 타도록 되어 있으므로, 중국은 절대 타지 안흥ㅁ.
	//그래서 별도 분기로직 넣지 않음.
	if (!validPartQty()) {
		return false;
	}

	
	/*
	 * when status is ST035 or ST040, the part status is changed with 'U' at the
	 * below some cases 1. ASC have to GI bu they can't because of no part 2.
	 * ASC can not GI
	 */
	transitPartStatus();

	return true;
}


function validOldNewPartCheck(){
	var partsSeqObj = $j("#partsTableBody input[name='PARTS_SEQ_NO']");// document.getElementsByName('PARTS_SEQ_NO');
	var locatObj = $j("#partsTableBody input[name='REPAIR_LOC']");// document.getElementsByName('REPAIR_LOC');
	var partsObj = $j("#partsTableBody input[name='PARTS_CODE']");// document.getElementsByName('PARTS_CODE');
	var qtyObj = $j("#partsTableBody input[name='PARTS_QTY']");// document.getElementsByName('PARTS_QTY');
	var oldPartsObj = $j("#partsTableBody input[name='OLD_PARTS_CODE']");// document.getElementsByName('OLD_PARTS_CODE');
	
	
	/**
	 * var isMedisonUser = isMedisonUser
       _l.FSC = ticket.isFSC()
       ServiceOrderUpdate.jsp 에서 자재 추가할때, 
       FSC 이고 isMedisonUser 아니면 chinaOldPartShow 값이 false가 된다.
       chinaOldPartShow 가 참인경우만 old part 가 보여지고 사용자가 입력가능하다.
       ㄱ러므로 이때만 old/new part 필수 입력을 체크해야 한다.
	 * 
	 */

	//1. old part and new part allways required
	//2. qty always required.
	
	//새로 입력한 자재만 체크함, 기존 저장된 자재는 체크안함.
	var partLen = partsSeqObj.length;
	for ( var i = 0; i < partLen; i++) {
		if (partsSeqObj[i].value == "") { //새로 입력한 자재만 체크함, 기존 저장된 자재는 체크안함.
			
			//1. old part and new part allways required
			if(partsObj[i].value == "" && locatObj[i].value.strip() == ""){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0578);
				partsObj[i].focus();
				return false;
			}
			
			if(oldPartsObj[i].type!="hidden" && oldPartsObj[i].value == "" && locatObj[i].value.strip() == ""){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0578);
				oldPartsObj[i].focus();
				return false;
			}
			
			//2. qty always required.		
			if (partsObj[i].value != "" && (qtyObj[i].value=="" || Number(qtyObj[i].value) < 1 || isNaN(qtyObj[i].value) ) ) {
				qtyObj[i].select();
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0048);
				return false;
			}				
			
		}//신규입력자재경우
		
	}//for ( var i = 0; i < partLen; i++) 
	
	
	return true;
}

function checkPartsSave() {
	var isValidPartInfo = true;
	
	for ( var i = 0; i < $j("#partsTableBody input[name='PARTS_CODE']").length; i++) {
		$j("#partsTableBody input[name='PARTS_CODE']")[i].value = $j("#partsTableBody input[name='PARTS_CODE']")[i].value.strip();
	}
	var partsObj = $j("#partsTableBody input[name='PARTS_CODE']");	// document.getElementsByName('PARTS_CODE');
	var locatObj = $j("#partsTableBody input[name='REPAIR_LOC']");	// document.getElementsByName('REPAIR_LOC');
	var qtyObj = $j("#partsTableBody input[name='PARTS_QTY']");		// document.getElementsByName('PARTS_QTY');
	
	//china : 중국은 partsSerial,invoiceNo 변수 선언/정의 자체가 없음.
	var partsSerial = $j("#partsTableBody input[name='SERIAL_MAT']");// document.getElementsByName('SERIAL_MAT');
	var invoiceNo = "";
	if(_l.usePartInvoiceNo && (_l.u.c == "C310" || _l.u.c == "C370" || _l.allowSamepartsByInvoice)){
		invoiceNo = $j("#partsTableBody input[name='INVOICE_NO']");// document.getElementsByName('SERIAL_MAT');
	}
	
	if(_l.u.isChinaRegion && partsObj.length == 0){
		//IMEI PROJECT
		if(isAutoImei){
			$j('#NEW_IMEI_TXT').val("");
			$j('#NEW_IMEI').val("");	
		}else{
			$j('#NEW_IMEI').val("");	
		}
		
		$j('#NEW_SERIAL_NO').val("");
		$j('#NEW_MODEL').val("");
	}
	
	
	//for china : 중국소스은 아래로직이 없지만, 별로 분기처리 안함, C310,330만 체크로직을 타게되므로,
	if (!checkPartForRedo(partsObj, qtyObj)) {
		isValidPartInfo = false;
		return isValidPartInfo;
	}

	for ( var i = 0; i < partsObj.length; i++) {

		if (partsObj[i].value.strip() == "" && locatObj[i].value.strip() == "") {
			//$j('#td_usedPart').click();  중국만 td_usedPart click 로직이 있지만 상세화면 캡을 여는 로직이므로 여기서는 불필요함...주석 처리함.
			partsObj[i].focus();
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0059);
			isValidPartInfo = false;
			break;
		} 
		if(partsObj[i].value.replace(/\*/g,"").length < 4 && locatObj[i].value.strip() == ""){
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_PART_DIGIT);
			return;
		}
		
		//for china : 중국은 KT가 아닌경우만 part code & qty  체크함.
		var checkPartCodeAndQty = true; 
		if(_l.u.isChinaRegion){
			checkPartCodeAndQty = ($j('#SERVICE_TYPE').val()!='KT');
		}
		
		//for china : 중국은 KT가 아닌경우만 아래로직 체크함.
		if (checkPartCodeAndQty && partsObj[i].value.strip() != ""
				&& (Number(qtyObj[i].value) < 1 || isNaN(qtyObj[i].value))) {
			//$j('#td_usedPart').click();  중국만 td_usedPart click 로직이 있지만 상세화면 캡을 여는 로직이므로 여기서는 불필요함...주석 처리함.
			qtyObj[i].select();
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0048);
			isValidPartInfo = false;
			break;
		}
		/**
		 * check if the same part code exists the same part lead to GERP wty
		 * error and saw discount problem
		 */
		//for china : 중국소스은 partsSerial, invoiceNo 를 파라미터로 던지지 않음.
		// 그러나, partsSerial 을 던져서 part+serial 같아야만 동일 자재로 판단하는 로직은 글로벌이 진화된 형태 이므로 이대로 유지함. 별도 분기로 partsSerial 를 제외시지 않음.
		//invoiceNo 는 "" 이 들어가서 hasSamePart() 내에서  part+serial 로 체크하는 로직을 타게됨. 그러면 위와 같은 사유로 글로벌 로직을 유지함.  
		if (hasSamePart(i, partsObj, partsSerial, invoiceNo)) {
			if(invoiceNo == ""){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0058 + "[" + partsObj[i].value + "]");
			}else{
				alert(_l.u.WEB_MSG_PREFIX + "Please check part code and invoice No. " + "[" + partsObj[i].value + "]");
			}
			
			isValidPartInfo = false;
			break;
		}
	}

	return isValidPartInfo;
}

/**
 * when status transit ST035 that ASC can create a Warranty, then check this
 * logic
 */
function checkPartForRedo(arrPart, arrQty) {
	var isValidPartForRedo = true;
	if (!_l.useRedo) {
		return isValidPartForRedo;
	}

	if (_l.CurrStatus != $('STATUS').value && $('STATUS').value == "ST035") {
	} else {
		return isValidPartForRedo;
	}

	var partCount = 0;
	// count if SO has a part code and qty
	for ( var i = 0; i < arrPart.length; i++) {
		if (arrPart[i].value.strip() != "" && arrQty[i].value.strip() != ""
				&& isNaN(arrQty[i].value) && Number(arrQty[i].value) < 1) {
			partCount++;
		}
	}
	// if there is no part or valid part, give a warning to the user
	if (arrPart.length == 0 || partCount == 0) {
		if (!confirm(_l.u.WEB_MSG_PREFIX +_l.r.m.EXT_0062)) {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0063 + "\n\n" + _l.r.m.EXT_0064 + "\n\n"
					+ _l.r.m.EXT_0065);
			isValidPartForRedo = false;
		}
	}

	return isValidPartForRedo;
}

/**
 * check if the same part code exists the same part lead to GERP wty error and
 * saw discount problem i : current position, skip the current position when
 * check the same part
 */
//for china : 중국 기존로직은 arrPartSerial, arrInvoiceNo 파라미터를 던지지 않음.
function hasSamePart(idx, arrPart, arrPartSerial, arrInvoiceNo) {
	if (!arrPart)
		return false;
	if (!arrPart.length)
		return false;
	var part = arrPart[idx].value.strip();
	var partSerial = arrPartSerial[idx].value.strip();
	var partInvoiceNo = "";
	if(arrInvoiceNo != "" && arrInvoiceNo.length > 0){
		partInvoiceNo = arrInvoiceNo[idx].value.strip();
	}
	if (part == "")
		return false;

	if(_l.u.isChinaRegion){
		//china : 정확히 하기 위해 로직을 분기함
		for ( var i = 0, len = arrPart.length; i < len; i++) {
			if (i != idx
					&& arrPart[i].value.strip() == part) {
				return true;
			}
		}
	}else{
		if(partInvoiceNo == ""){
			//china : 중국소스 경우 part 만 동일한지 비교, 글로벌 로직이 진화된 형태 이므로 이대로 유지함.
			for ( var i = 0, len = arrPart.length; i < len; i++) {
				if (i != idx
						&& (arrPart[i].value.strip() + arrPartSerial[i].value.strip()) == (part + partSerial)) {
					return true;
				}
			}
		}else{
			for ( var i = 0, len = arrPart.length; i < len; i++) {
				if (i != idx
						&& (arrPart[i].value.strip() + arrInvoiceNo[i].value.strip()) == (part + partInvoiceNo)) {
					return true;
				}
			}
		}
	}
	
	return false;
}

function checkOldPartsSave() {
	var isValidPartInfo = true;

	var newPartsObj = $j("#partsTableBody input[name='PARTS_CODE']");// document.getElementsByName('PARTS_CODE');
	var partsObj = $j("#partsTableBody input[name='OLD_PARTS_CODE']");// document.getElementsByName('OLD_PARTS_CODE');
	var partsSerial = $j("#partsTableBody input[name='OLD_SERIAL_MAT']");// document.getElementsByName('OLD_SERIAL_MAT');
	var qtyObj = $j("#partsTableBody input[name='PARTS_QTY']");// document.getElementsByName('PARTS_QTY');

	for ( var i = 0; i < partsObj.length; i++) {
		if (partsObj[i].value.strip() == "") {
			partsObj[i].focus();
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0059);
			isValidPartInfo = false;
			break;
		}
		if (partsObj[i].value.strip() != ""
				&& newPartsObj[i].value.strip() == "") {
			newPartsObj[i].value = partsObj[i].value;
		}
		/**
		 * check if the same part code exists the same part lead to GERP wty
		 * error and saw discount problem
		 */
		//china : 중국은 partsSerial, invoice="" 를 파라미터로 던지지 않음.
		//그러나 partsSerial 을 던져서 자재+시리얼로 동일 자재 체크하는 글로벌 로직이 진화된 형태 이므로, 이대로 유지함.
		//invoice="" 는 공백으로 던지므로, 자재+시리얼만 동일자재 체크시 사용.
		if (hasSamePart(i, partsObj, partsSerial, "")) {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0058 + "[" + partsObj[i].value + "]");
			isValidPartInfo = false;
			break;
		}

		if (partsSerial[i].value.strip() != "" && qtyObj[i].value != "1") {
			qtyObj[i].value = '1';
			qtyObj[i].focus();
			alert(_l.u.WEB_MSG_PREFIX + "The qty should be one if part serial inputted.");
			isValidPartInfo = false;
			break;
		}
	}

	return isValidPartInfo;
}

/*
 * * When S/O is saved with ST035 or 040, All part status should be GIed. * >>
 * ASC cano't add the repair part after ST035 but can remove * ST052 then All
 * parts status should not be GIed. * GI : only for inventory and FSC user * if
 * billing user then All parts have to be GI before do "Billing" * else All
 * parts have to be GI before being ST035 or ST040
 */
function validPartGIStatus(type) {

	// inventoryFlag = '<%=inventoryFlag%>';
	// isFSC = '<%=isFSC%>';
	// userHaveToDoGI=<%=userHaveToDoGI%>
	var statusCode = $("STATUS").value;
	var reason = $('REASON').value;
	var valid = true;

	if (!_l.userHaveToDoGI) {
		/*
		 * some cases don't need to check GI 1. user is not necessary GI 2. this
		 * time is not to check GI
		 */
		return valid;// true
	}

	// Status Repair Completed, Good Delivered, Cacelled by Asc
	//for china : 중국은 ST033경우 GI상태 체크로직을 타지 않는다. 
	var statusNeedTocheck = true;
	if(_l.u.isChinaRegion){
		statusNeedTocheck = (statusCode == "ST035" || statusCode == "ST040" || statusCode == "ST052");
	}else{
		statusNeedTocheck = (statusCode == "ST035" || statusCode == "ST040" || statusCode == "ST052" || statusCode == "ST033");
	}	
	if (statusNeedTocheck) {
	} else {
		return valid;
	}

	var parts_gi_open = false;
	var parts_gi_close = false;
	var parts_pending = false;
	var repair_loc = $j("#partsTableBody input[name='REPAIR_LOC']");// document.getElementsByName('REPAIR_LOC');
	var partCode = $j("#partsTableBody input[name='PARTS_CODE']");// document.getElementsByName('PARTS_CODE');
	var GIObj = null;
	var partsStatus = $j("#partsTableBody input[name='PARTS_STATUS']");// document.getElementsByName('PARTS_STATUS');

	if (_l.inventoryFlag) {
		GIObj = $j("#partsTableBody input[name='GI_DATE']");// document.getElementsByName('GI_DATE');
	} else if (_l.FSC) {
		GIObj = $j("#partsTableBody input[name='gi_document_no']");// document.getElementsByName('gi_document_no');
	}

	// 완료일때 GI 체크//Status Repair Completed Good Delivered
	//statusCheckGiOpen :  global >> if(FSC & C820) 은 ST035 && HL005 else ST035 or ST040
	//                               china  >> ST035 or ST040
	//statusCheckGiClose :  global >> ST052 or ST033
	//                               china  >> ST052
	
	//특정 상태 변경시 GI 안한자재 존재하는지 체크. 
	var statusCheckGiOpen = false;
	if(_l.u.isChinaRegion){
		statusCheckGiOpen = (statusCode == "ST035" || statusCode == "ST040");
	}else{
		statusCheckGiOpen = (_l.FSC && _l.u.c == "C820" && statusCode == "ST035" && reason == "HL005")
										|| !(_l.FSC && _l.u.c == "C820") && (statusCode == "ST035" || statusCode == "ST040");
	}
	
	//특정 상태 변경시 GI 취소안한자재 존재하는지 체크.
	var statusCheckGiClose = false;
	if(_l.u.isChinaRegion){
		statusCheckGiClose = (statusCode == "ST052");
	}else{
		statusCheckGiClose = (statusCode == "ST052" || statusCode == "ST033");
	}
	
	
	if (statusCheckGiOpen) {
		// for already added part
		for ( var i = 0; i < GIObj.length; i++) {
			if (partCode[i].value != "" && GIObj[i].value == "") {
				parts_gi_open = true;
				break;//china : 중극은 브레이크 없음. 글로벌이 진화된 형태 무로 그대로 유지.
			}
		}

		if (!parts_gi_open) {//china : 중국은 이조건이 없음...글로벌이 진화된 형태 무로 그대로 유지.
			// for the part doesn't saved ( added just before )
			var partsSeqObj = $j("#partsTableBody input[name='PARTS_SEQ_NO']");// document.getElementsByName('PARTS_SEQ_NO');
			for ( var i = 0; i < partsSeqObj.length; i++) {
				if (partCode[i].value != "" && partsSeqObj[i].value == "") {
					parts_gi_open = true;
					break;
				}
			}
		}
		if(_l.u.c == "C310"){//china : 중국은 여기를 안탐.
			if((statusCode == "ST040")
					|| (statusCode == "ST035" && type=="B" && _l.IN_OUT_WTY=="OW")){
				if (parts_gi_open) {
					
					if(statusCode == "ST035"){
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0002);
					}else if(statusCode == "ST040"){
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0645);	
					}
					
					moreOpenid(10);
					valid = false;
					return valid;
				}
			}
		}else{
			if (parts_gi_open) {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0002);
				moreOpenid(10);
				valid = false;
				return valid;
			}
		}
	} else if (statusCheckGiClose) {//china : ST052 ,global : ST052 && ST033
		// Cacelled by Asc

		// for already added part
		for ( var i = 0; i < GIObj.length; i++) {
			if (partCode[i].value != "" && GIObj[i].value != "")
				parts_gi_close = true;
			if (partsStatus[i].value == "P" && GIObj[i].value == "")//parts_pending 판단 조건이 중국에는 엇ㅂ음.
				parts_pending = true;
		}

		if (parts_gi_close) {
			var giAlertMsg = "";
			if (statusCode == "ST052") {
				giAlertMsg = _l.r.m.EXT_0035;
			}
			if (statusCode == "ST033") {
				giAlertMsg = "Cancel GI & Remove parts and Engineer, Befor saving in ASC Decline status";
			}

			alert(_l.u.WEB_MSG_PREFIX + giAlertMsg);
			moreOpenid(14);
			valid = false;
			return valid;
		}

		if (_l.u.c == "C550" && parts_pending) {/* SIEL 인도만 사용 */
			if (confirm(_l.u.WEB_MSG_PREFIX +"Parts No and Engineer details will be removed when ASC Decline status saved ?")) {
				alert(_l.u.WEB_MSG_PREFIX + "G-SPN will delete part code and Engineer Code when G/I cancel is already done and USERs tries to update the ticket into ASC Decline (ST033) status");
				valid = true;
			} else {
				valid = false;
				moreOpenid(14);
			}
			return valid;
		}
	}

	return valid;
}

/**
 * * when S/O is saved with ST035 and reason about part pending such as "Parts
 * Not Available", * at least one part with part code should be.
 */
function validPartOnPendingPartReason() {
	var valid = true;
	var statusCode = $("STATUS").value;
	var REASON = $('REASON').value;
	// Status Pending .. Reason Parts Not Available
	var partRequiredPendReason = statusCode == "ST030" && (REASON == "HP040" // Parts Not Available (Samsung)
			|| REASON == "HP045" // Parts Not Available (ASC)
			|| REASON == "HP050" // Not possessed parts by Engr
			|| REASON == "PR045" || REASON == "PR040" || REASON == "HPZ02" // Waiting for parts(parts ordered)
			|| REASON == "HPZ16" || REASON == "HPZ17" 
			|| REASON == "HP041" || REASON == "HP042" || REASON == "HP043" || REASON == "HP046"	// part pending reason added 2016.01.20 jiw
	);
	
	//for china : 자재 사유로 팬딩인 경우 자재가 필요하다.
	if(_l.u.isChinaRegion){
		partRequiredPendReason = statusCode == "ST030" && (REASON == "HP040" 
			|| REASON == "HP045" 
			|| REASON == "HP050"
			|| REASON == "PR045" || REASON == "PR040" 
			|| REASON == "HPZ02"
		);
	}
	// SEDA 법인은 HPZ17, HP070 제외 2016.06.14 jiw
	if(_l.u.c == "C820"){
		partRequiredPendReason = statusCode == "ST030" && (REASON == "HP040" || REASON == "HP045" || REASON == "HP050"
				|| REASON == "PR045" || REASON == "PR040" || REASON == "HPZ02" || REASON == "HPZ16"
				|| REASON == "HP041" || REASON == "HP042" || REASON == "HP043" || REASON == "HP046"
		);
	}

	// Status Pending .. Reason Parts Not Available
	if (partRequiredPendReason) { // 임시 PENDING REASON
		var parts_pending = false;
		var partsObj = $j("#partsTableBody input[name='PARTS_CODE']");// document.getElementsByName('PARTS_CODE');
		var statusObj = $j("#partsTableBody input[name='PARTS_STATUS']");// document.getElementsByName('PARTS_STATUS');
		// Inventory Case
		for ( var i = 0; i < statusObj.length; i++) {
			if (statusObj[i].value == "P" && !partsObj[i].value.blank()) {
				parts_pending = true;
				break;
			}
		}

		// FSC Case
		if (_l.FSC && !parts_pending) {// china : 중국에는 이 조건이 없지만, 글로벌 로직이 더 발전된 형태므로 그대로 유지함.
			var giDoc = $j("#partsTableBody input[name='gi_document_no']");// document.getElementsByName('gi_document_no');
			for ( var i = 0; i < giDoc.length; i++) {
				if (giDoc[i].value == "") {
					parts_pending = true;
					break;
				}
			}
		}

		if (!parts_pending) {// china : 중국에는 이 조건이 없지만, 글로벌 로직이 더 발전된 형태므로 그대로 유지함.
			// 화면에서 part line Add 한 경우. 저장되지 않은 parts 입력 정보
			var part_seq = $j("#partsTableBody input[name='PARTS_SEQ_NO']");// document.getElementsByName('PARTS_SEQ_NO');
			for ( var i = 0; i < part_seq.length; i++) {
				if (partsObj[i].value != "" && part_seq[i].value == "") {
					parts_pending = true;
					break;
				}
			}
		}

		if (!parts_pending) {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0001);
			moreOpenid(10);
			valid = false;
		}

	}// if(partRequiredPendReason ){

	return valid;
}

function validSalesOrderOnPendingReason() {
	var valid = true;

	if (!_l.salesOrderPopup) {
		return true;
	}// if(salesOrderPopup) {

	var statusCode = $("STATUS").value;
	var corp = _l.u.c;
	var inventoryFlag = _l.inventoryFlag;
	// Status Pending .. Reason Parts Not Available
	var reasonForPartPending = "HPZ02";// Waiting for parts(parts ordered)
										// HPZ02
	var reasonForPartPending_why = "HP040";
	
	if ("C550" == corp) {
		reasonForPartPending = "HP040,HPZ16,HPZ17,HP041,HP042,HP043,HP046";
	}
	
	//EHN : reason mandatory 체크가 sap으로 이관되어, 리즌이 없는 경우도 존재함.
	//리즌 없으면 SO 번호 체크하지 않도록 하기 위해 $('REASON').value != "" 로직 추가한다.
	var SORequiredPendReason = (statusCode == "ST030" && $('REASON').value != "" && reasonForPartPending
			.indexOf($('REASON').value) != -1); 
	// thisStatusCanSearchSalesOrder()
	//var SORequiredPendReason_wh_stock = (statusCode == "ST030" && $('REASON').value != "" && reasonForPartPending.indexOf($('REASON').value) != -1);
	
	if (SORequiredPendReason) {
		// mandatory : Parts Order Number, Parts Order Item Number, Parts Code,
		// Qty
		var parts_pending = true;
		var qty_pending = true;
		var sono_pending = true;
		var pono_pending = true;
		var soitemno_pending = true;
		var asc_stock_pending = true;

		var arrPart = $j("#partsTableBody input[name='PARTS_CODE']");
		var arrQty = $j("#partsTableBody input[name='PARTS_QTY']");
		var arrPO = $j("#partsTableBody input[name='PO_NO']");
		var arrSO = $j("#partsTableBody input[name='SO_NO']");
		var arrSOItem = $j("#partsTableBody input[name='SO_ITEM_NO']");
		var arrStatus = $j("#partsTableBody input[name='PARTS_STATUS']");

		var arrGI = $j("#partsTableBody input[name='GI_DATE']");

		if (inventoryFlag) {
			arrGI = $j("#partsTableBody input[name='GI_DATE']");
		} else if (_l.FSC) {
			arrGI = $j("#partsTableBody input[name='gi_document_no']");
		}

		var partCount = arrPart.length;
		for ( var i = 0; i < partCount; i++) {
			if (arrGI && arrGI[i].value != "") {
				continue;
			}

			if (arrPart[i].value.length < 5) {
				parts_pending = false;
				alert(_l.u.WEB_MSG_PREFIX + "Please Input a part code!!");
				arrPart[i].focus();
				break;
			}
			if (!$j.isNumeric(arrQty[i].value)) {
				qty_pending = false;
				alert(_l.u.WEB_MSG_PREFIX + "Please Input the qty!!");
				arrQty[i].focus();
				break;
			}

			if ("C550" == corp) {
				if (inventoryFlag) {
					if (arrStatus[i].value == "P") {
						var ascStock = getBranchStockQty(arrPart[i].value);
						if (ascStock > arrQty[i].value) {
							asc_stock_pending = false;
							// alert(_l.u.WEB_MSG_PREFIX + "Parts available in stock. Please check
							// inventory & complete parts G/I!");
							alert(_l.u.WEB_MSG_PREFIX + "Can NOT SAVE  in Part Pending STATUS when Part_no  "
									+ arrPart[i].value
									+ "  is available in Stock ( ASC/Engg). Please check Inventory & Complete parts G/I !");
							break;
						}
					}// if( arrStatus[i].value == "P" ){
				}// if(inventoryFlag){

				if (arrPO[i].value.length < 2) {
					pono_pending = false;
					// alert("Please use PO search button to check existing PO's
					// raised");
					alert(_l.u.WEB_MSG_PREFIX + "Please use \"P/O no\"  search button to  check & update PO number in Service Order.");
					break;
				}
			}
			
			if(!(("B" == _l.u.CenterType  || "S" == _l.u.CenterType)&& "C460" == corp)){	
				if (!$j.isNumeric(arrSO[i].value) || arrSO[i].value.length < 10) {
					sono_pending = false;
					alert(_l.u.WEB_MSG_PREFIX + "Please Input the Confirmation NO!");
					break;
				}
				if (!$j.isNumeric(arrSOItem[i].value)) {
					soitemno_pending = false;
					alert(_l.u.WEB_MSG_PREFIX + "Please Input the Confirmation No ( item no )!");
					break;
				}
			}
			
		}

		if (partCount > 0) {
			valid = parts_pending && qty_pending && sono_pending
					&& soitemno_pending && asc_stock_pending && pono_pending;
		} else {
			valid = false;
		}

	}// if(SORequiredPendReason ){

	return valid;
}

function getBranchStockQty(part) {
	var stockQty = 0;
	if (!_l.inventoryFlag) {
		return stockQty;
	}

	var param = "cmd=BranchStockCmd&account=" + _l.u.AccountCode;
	param += "&ascCode=" + _l.u.DefaultBranch;
	param += "&ext_user=" + _l.u.UserId;
	param += "&Lang=" + _l.u.SapLanguage;
	param += "&material=" + part;

	$j.ajax({
		type : 'post',
		dataType : 'json',
		async : false,
		url : urlPatternGZIP,
		data : param,
		success : function(data) {
			if (data && data.ptData && data.ptData.length) {
				var length = data.ptData.length;
				for ( var i = 0; i < length; i++) {
					if($('REASON').value == "HP040") {						
						stockQty += Number(data.ptData[i].wh_stock_qty);
					} else {
						stockQty += Number(data.ptData[i].stock_qty);
					}
				}
			}
		},
		error : function(jqXHR, textStatus) {
			// console.log(textStatus);
		}
	});

	return stockQty;
}

/**
 * check if SO has repair code to need the part
 */
function validRepairParts() {
	if (!(_l.u.c == "C310" || _l.u.c == "C370"))
		return true;

	var valid = true;
	var partNeed = repairCodeNeedPart();
	var hasPart = hasRepairPart();

	if (partNeed && !hasPart) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0158);
		valid = false;
	}
	return valid;
}


/**
 * Serial no. to be mandatory for compressor (SIEL)
 */
function validCompSerialForSiel() {
	var isValid = true;
	
	//china : 중국은 C6V0만 사용함. 결론적으로 C6V0,C550 만 사용.
	//중국은 useCompCheck 조건이 validCompSerialForSiel()를 호출하는 쪽에 있었으나, 
	//체크로직을 탈지 말지의 조건은 본함수안에 있으므로, 이곳으로 이동함.
	
	//EHN11 2017.09.12 pcs73.park 
	//useCompCheck 에 C550 법인도 추가되엇음, C6V0는 asc code 확인중.
	//WL_USE_COMP_ASC : logic_code
	if (!_l.useCompCheck){
		return true;
	}
	/*
	if (_l.u.c == "C550" || (isNewChina && _l.useCompCheck)){
		//pass
	}else{
		return true;
	}
	*/

	// checking to GMES with isSerialNumberValid()
	var statusCode = $("STATUS").value;
	var isAirConditioner = false;
	var isCtv = false;
	var isWm = false;
	var isSMPS = false;
	var product = $j('input#SVC_PRCD').val();
	//china : 
	if(_l.u.isChinaRegion){
		product = $j('input#LOC_PRCD').val();
	}	 
	
	//china : 중국과 글로벌이 isAirConditioner,isCtv,isSMPS,isWm 판단 기준이 서로 다름.
	//실제로 C610은 이로직 타지 않음. 위에서 return true 되버림.	
	if(_l.u.isChinaRegion){
		
		if (product && 'REF'.indexOf(product.substring(0, 3)) > -1) {
			isAirConditioner = true;
		}else if(product.substring(0, 3) == "CTV"){
			isCtv = true;
		}else if(product.substring(0, 3) == "WSM"){
			isWm = true;
		}
		else{
			isAirConditioner = false;
			isCtv = false;
		}	
		
	}else{
		if (product && '|A/C|REF'.indexOf(product.substring(0, 3)) > -1) {
			isAirConditioner = true;
		}else if(product.substring(0, 3) == "CTV"){
			isCtv = true;
			if("|CTV04|CTV05|CTV06|CTV07|CTV08|CTV09|CTV10|CTV11|CTV12|CTV13|CTV14|CTV15|CTV16|".indexOf(product) > 0){
				isSMPS = true;
			}
		}else if(product.substring(0, 3) == "W/M"){
			isWm = true;
		}else{
			isAirConditioner = false;
			isCtv = false;
			isSMPS = false;
		}
	}
	
	
	var SERVICE_TYPE = $("SERVICE_TYPE").value;
	//china : 중국과 isServiceTypeToCheckSerialNo 판단 조건이 다름.
	var isServiceTypeToCheckSerialNo = (SERVICE_TYPE == "CI" || SERVICE_TYPE == "IH" || SERVICE_TYPE == "BS" || SERVICE_TYPE == "DM" || SERVICE_TYPE == "PS" || SERVICE_TYPE == "II" || SERVICE_TYPE == "SR");
	//china : 중국과 글로벌에서 if(!isCheckingThroughGMES($j("#SERIAL_NO").val())){ 호출해야할 조건을 정의함.
	//기존 로직에 중국분기를 달경우 복잡해져서, 소스를 재구성함.(needCheckingThroughGMES 변수 신규 추가)
	var needCheckingThroughGMES = isServiceTypeToCheckSerialNo && (isAirConditioner || isCtv || isWm) && _l.u.CountryCd == "IN";
	
	if(_l.u.isChinaRegion){
  		  isServiceTypeToCheckSerialNo = (SERVICE_TYPE == "CI" || SERVICE_TYPE == "IH" || SERVICE_TYPE == "BS" || SERVICE_TYPE == "DM" || SERVICE_TYPE == "PS" || SERVICE_TYPE == "II");
  		  needCheckingThroughGMES = isServiceTypeToCheckSerialNo && (isAirConditioner || isCtv || isWm);
	}
	
	var wtyInOut = $('IN_OUT_WTY').value;
	if(needCheckingThroughGMES && wtyInOut != "OW"){
		if(!isCheckingThroughGMES($j("#SERIAL_NO").val())){
			isValid = false;
			return isValid;
		}
	}
	
	try{
		var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
		var partSerials = $j('#partsTableBody input[name="SERIAL_MAT"]');
		//china : 중국만 아래 old 변수를 더 사용함.
		var OldpartCodes = $j('input[name="OLD_PARTS_CODE"]');
		var OldpartSerials = $j('input[name="OLD_SERIAL_MAT"]');
		
		var partDesc = $j('#partsTableBody input[name="PARTS_DESC"]');
		var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";


		var partsSeqObj = $j("#partsTableBody input[name='PARTS_SEQ_NO']");// document.getElementsByName('PARTS_SEQ_NO');
		var partsWtyObj = $j("#partsTableBody input[name='PARTS_INOUT']");// document.getElementsByName('PARTS_INOUT');
		
		var targetPartCode1 = "44B0,BK19,44D1,48B1,48B2,48D1,DK19,55A1,MK17,55A2,MK18,MK19,MKV1,MSA1,MSV1,NC1A,MSV4,UG4T,NC4M,UG9A,SD16,UR4D,SK18,UR5A,SK19,UR8B,UR8C,UR8D";
		var targetPartCode2 = "DA59-00556A,DA59-00556B,DA59-00566A,DB59-00025A,DB59-00026A";
		//china : 중국과 글로벌이 대상 자재가 서로 다름.
		if(_l.u.isChinaRegion){
			  targetPartCode1 = " DK190, ENV4A, EQ4A5,EU4A5, MD162,MK183,MK190,MK4A5,MSA47,MSE48, MSE4A, MSV46, MSV48,MSV4A,NC4EV,SD162,SK170,SK182,SK183,SK190,SK1A1,SK382";
			  targetPartCode2 = " 48C129DUAEL-DO,DA59-00024B,DA59-00025A,DA59-00027A,DA59-00034A,DA59-00052A,DA59-00052B,DA59-00052C,DA59-00116A,DA59-00124A,DA59-00202A," +
	    	                          	"DA59-00202B,DA59-00202C,DA59-00202D,DA59-00203A,DA59-00203B,DA59-00216A,DA59-00217A,DA59-00224B,DA59-00230A,DA59-00286A,DA59-00286B,DA59-00286C," +
	    	                          	"DA59-00304A,DA59-00304B,DA59-00307A,DA59-00316A,DA59-00322A,DA59-00325A,DA59-00325B,DA59-00327A,DA59-00330A,DA59-00332A,DA59-00339A,DA59-00360A," +
	    	                          	"DA81-01442A,DA92-00022B,DA92-00023A,DA92-00027A,DA92-00031A,DA92-00032A,DA92-00033A,DA92-00034A,DA92-00036A,DA92-00040A,DA92-00051A,DA92-00090A," +
	    	                          	"DA92-00354A,DB59-00010A,DB95-00201A,DB95-00909A";
		}
		
		
		for ( var i = 0; i < partCodes.length; i++) {
			var partCode = $j.trim($j(partCodes[i]).val());
			var partSerial = $j.trim($j(partSerials[i]).val());
			var oldpartSerial = $j.trim($j(OldpartSerials[i]).val());
			
			var isTargetPart1 = partCode != null && partCode.length > 4 && targetPartCode1.indexOf(partCode.substring(0,4)) != -1;
			var isTargetPart2 = partCode != null && partCode.length == 11 && targetPartCode2.indexOf(partCode) != -1;
			var enterCorrectCompressorPartSN = (partSerial == null || partSerial.length < 14 || !(/[a-zA-Z]/.test(partSerial)) || !(/[0-9]/.test(partSerial)));
			var startCREATE_DATE = '20150226';
			if(_l.u.isChinaRegion){
				isTargetPart1 = partCode != null && partCode.length > 5 && targetPartCode1.indexOf(partCode.substring(0,5)) != -1;
				isTargetPart2 = partCode != null  && targetPartCode2.indexOf(partCode) != -1;//&& partCode.length == 11
				enterCorrectCompressorPartSN = !callGMESToCheckSerial(oldpartSerial) || 
															(partSerial == null || partSerial.length < 14 || !(/[a-zA-Z]/.test(partSerial)) || !(/[0-9]/.test(partSerial)));
				startCREATE_DATE = '20160801';
			}
			
			
			
			
			if(isTargetPart1 || isTargetPart2) {
				if(enterCorrectCompressorPartSN){
					alert(_l.u.WEB_MSG_PREFIX + "It is mandatory to enter correct Compressor Part S/N under Repair Part Information Tab. [" + partCode + "]");
					$j(partSerials[i]).focus();
					if(_l.u.isChinaRegion){isValid = true;}else{isValid = false;}
					break;
				}else{//if(enterCorrectCompressorPartSN){
					
					if(Number(_l.CREATE_DATE+"") >= Number(startCREATE_DATE) 
						&& _l.CurrStatus != 'ST035' 
						&& $j("#STATUS").val() == 'ST035'
						&& isAirConditioner){
						
							if (partsSeqObj[i].value == "") {
								alert(_l.u.WEB_MSG_PREFIX + "Please save the service order to check Parts Term before changing status to Repair Completed.");
								isValid = false;
								break;
							}else {//if (partsSeqObj[i].value == "") {
								
								var invalidCompressorWarningError = ($j.trim($j(partsWtyObj[i]).val())=="I"
																						&& _l.u.CountryCd == "IN" 
																						&& !isCompressorWarningError(partSerial));
								if(_l.u.isChinaRegion){
									invalidCompressorWarningError = ($j.trim($j(partsWtyObj[i]).val())=="I"
										&& !isCompressorWarningError(partSerial));
								}
								if(invalidCompressorWarningError){
										isValid = false;
										break;
								}
								
							}//if (partsSeqObj[i].value == "") {
					}//if(Number(_l.CREATE_DATE+"") >= Number(startCREATE_DATE)					
				}//if(enterCorrectCompressorPartSN){
			}//if(isTargetPart1 || isTargetPart2) {
			
			//china : 중국은 아래 체크로직을 타지 않으며, 결론적으로 바로 for 조건문으로 되돌아간다.
			//그래서, continue;문을 추가한다.
			if(_l.u.isChinaRegion){ continue;}
			
			if(isCtv || isSMPS){
				if (partCode.substring(0, 4) == "BN07") {
					if (partSerial == '') {
						isValid = false;
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.PART_SERIAL_CHECK);
						break;
					}

					if (!(partSerial.length == 23 || partSerial.length == 25)) {
						isValid = false;
						alert(_l.u.WEB_MSG_PREFIX + 'Parts serial number length of BN07 must be 23 or 25.');
						break;
					}

					if (containsCharsOnlyByValue(partSerial.charAt(0), chars)
							|| containsCharsOnlyByValue(partSerial.charAt(1), chars)) {
						isValid = false;
						alert(_l.u.WEB_MSG_PREFIX + 'Parts serial number first two digit must be alphabet');
						break;
					}
					if(Number(_l.CREATE_DATE+"") >= Number('20150226') && _l.CurrStatus != 'ST035' && $j("#STATUS").val() == 'ST035'){
						if (partsSeqObj[i].value == "") {
							alert(_l.u.WEB_MSG_PREFIX + "Please save the service order to check Parts Term before changing status to Repair Completed.");
							isValid = false;
							break;
						}else {
							if($j.trim($j(partsWtyObj[i]).val())=="I"){
								if(_l.u.CountryCd == "IN" && !isCompressorWarningError(partSerial)){
									isValid = false;
									break;
								}
							}
						}
					}
					
				}
				// If Parts Number starts with BN95 or BN96 and ASSY PDP MODULE
				// &
				// PRODUCT LCD TEXT in Parts Description
				// then Part Serial Number is mandatory
				// Parts Serial No length = 25 (Refer #3)
				// Parts first two digit must be alphabet (Refer #4),
				
				//if ((partCode.substring(0, 4) == "BN95" || partCode.substring(0, 4) == "GH43" || partCode.substring(0, 4) == "GH44")
				if (((partCode.substring(0, 4) == "BN95" || partCode.substring(0, 4) == "BN96") && (($j.trim($j(partDesc[i]).val()).indexOf('ASSY PDP MODULE') >= 0) || ($j.trim($j(partDesc[i]).val()).indexOf('PRODUCT LCD') >= 0)))
					) {

					if (partSerial == '') {
						isValid = false;
						alert(_l.u.WEB_MSG_PREFIX + 'parts Serial number field is mandatory');
						break;
					}

					if (!(partSerial.length == 23 || partSerial.length == 25)) {
						isValid = false;
						alert(_l.u.WEB_MSG_PREFIX + 'Parts serial number length of BN95, BN96, BN44 must be 23 or 25.');
						break;
					}
					// var chars =
					// "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";

					if (containsCharsOnlyByValue(partSerial.charAt(0), chars)
							|| containsCharsOnlyByValue(partSerial.charAt(1), chars)) {
						isValid = false;
						alert(_l.u.WEB_MSG_PREFIX + 'Parts serial number first two digit must be alphabet');
						break;
					}
					if(Number(_l.CREATE_DATE+"") >= Number('20150226') && _l.CurrStatus != 'ST035' && $j("#STATUS").val() == 'ST035'){
						if (partsSeqObj[i].value == "") {
							alert(_l.u.WEB_MSG_PREFIX + "Please save the service order to check Parts Term before changing status to Repair Completed.");
							isValid = false;
							break;
						}else {
							if($j.trim($j(partsWtyObj[i]).val())=="I"){
								if(_l.u.CountryCd == "IN" && !isCompressorWarningError(partSerial)){
									isValid = false;
									break;
								}
							}
						}
					}
				}
			}//if(isCtv || isSMPS){
		}//for ( var i = 0; i < partCodes.length; i++) {
	}catch(e){}
	return isValid;
}

function newValidCompSerialForSiel() {
	var isValid = true;
	
	//china : 중국은 C6V0만 사용함. 결론적으로 C6V0,C550 만 사용.
	//중국은 useCompCheck 조건이 validCompSerialForSiel()를 호출하는 쪽에 있었으나, 
	//체크로직을 탈지 말지의 조건은 본함수안에 있으므로, 이곳으로 이동함.
	// _l.isValidSerialSIEL = 안쓰기 때문에 제외 대상 asc를 이것으로 구분 2024.02.01
	// _l.isValidSerialSIEL 에 Y 로 되어 있다면 SAP 로직 타도록 함
	if ((_l.u.c == "C550" && !_l.isValidSerialSIEL) || (isNewChina && _l.useCompCheck)){
		//pass
	}else{
		return true;
	}

	// checking to GMES with isSerialNumberValid()
	var statusCode = $("STATUS").value;
	var isAirConditioner = false;
	var isRef = false;
	var isCtv = false;
	var isWm = false;
	var isMwo = false;
	var product = $j('input#HQ_SVC_PRCD').val();
	//china : 
	if(_l.u.isChinaRegion){
		product = $j('input#LOC_PRCD').val();
	}
	
	//china : 중국과 글로벌이 isAirConditioner,isCtv,isSMPS,isWm 판단 기준이 서로 다름.
	//실제로 C610은 이로직 타지 않음. 위에서 return true 되버림.	
	if(_l.u.isChinaRegion){
		
		if (product && 'REF'.indexOf(product.substring(0, 3)) > -1) {
			isAirConditioner = true;
		}else if(product.substring(0, 3) == "CTV"){
			isCtv = true;
		}else if(product.substring(0, 3) == "WSM"){
			isWm = true;
		}
		else{
			isAirConditioner = false;
			isCtv = false;
		}	
		
	}else{	// SIEL 로직 수정 => Noida : Z & Chennai : P 2017.03.10 jiw
		//var isSIELSet = "Z,P,W".indexOf($j("#SERIAL_NO").val().charAt(5));
		var isSIELSet = "Z,P".indexOf($j("#SERIAL_NO").val().charAt(5));
		var loc_prod = $j('input#SVC_PRCD').val();
		var targetSvcProd = "PDP80,PDP64,PDP63,PDP60,PDP59,PDP58,PDP55,PDP51,PDP50,PDP43,PDP42,PDP37,"
			+ "WTV32,DTV34,DTV32,DTV29,DTV28,DTV21,"
			+ "LED52,LED50,LED48,LED46,LED42,LED40,"
			+ "LED39,LED37,LED32,LED28,LED27,LED26,LED24,LED22,LED19,"
			+ "LED78,LED75,LED70,LED65,LED60,LED58,LED57,LED55,LED85";
		if(isSIELSet != -1){
			if(targetSvcProd.indexOf(product.substring(0,5)) >= 0){
				isCtv = true;
			}
			if("A/C01,A/C02,A/C08".indexOf(loc_prod.substring(0,5)) >= 0){
				isAirConditioner = true;
			}
			if("REF01,REF02,REF03".indexOf(loc_prod.substring(0,5)) >= 0){
				isRef = true;
			}
			if("W/M01,W/M02,W/M03".indexOf(loc_prod.substring(0,5)) >= 0){
				isWm = true;
			}
			if("MWO01".indexOf(loc_prod.substring(0,5)) >= 0){
				isMwo = true;
			}
			// System Pop up should occur to create saw for M000 cases in Ref & AC product category
			if(isAirConditioner || isRef){
				if($j("#SERIAL_NO").val() == "M000" || $j("#SERIAL_NO").val() == "m000"){
					alert("Invalid serial number entered. Please input correct serial number.");
				}			
			}
		}
	}
	
	var SERVICE_TYPE = $("SERVICE_TYPE").value;
	//china : 중국과 isServiceTypeToCheckSerialNo 판단 조건이 다름.
	var isServiceTypeToCheckSerialNo = (SERVICE_TYPE == "CI" || SERVICE_TYPE == "IH" || SERVICE_TYPE == "BS" || SERVICE_TYPE == "DM" || SERVICE_TYPE == "PS" || SERVICE_TYPE == "II" || SERVICE_TYPE == "SR");
	//china : 중국과 글로벌에서 if(!isCheckingThroughGMES($j("#SERIAL_NO").val())){ 호출해야할 조건을 정의함.
	//기존 로직에 중국분기를 달경우 복잡해져서, 소스를 재구성함.(needCheckingThroughGMES 변수 신규 추가)
	
	// set serial check : isAirConditioner,isRef,isWm,isCtv,isMwo
	var needCheckingThroughGMES = false;
	
	// C550 모델 GMES 체크 로직 제거 2019.02.12 jiw
/*	if(_l.isValidSerialSIEL){
		needCheckingThroughGMES = isServiceTypeToCheckSerialNo && (isAirConditioner || isCtv || isWm || isRef || isMwo) && (_l.u.CountryCd == "IN" || _l.u.CountryCd == "LK");
	}else{
		needCheckingThroughGMES = isServiceTypeToCheckSerialNo && (isAirConditioner || isCtv || isWm || isRef) && (_l.u.CountryCd == "IN" || _l.u.CountryCd == "LK");
	}*/
	
	if(_l.u.isChinaRegion){
  		  isServiceTypeToCheckSerialNo = (SERVICE_TYPE == "CI" || SERVICE_TYPE == "IH" || SERVICE_TYPE == "BS" || SERVICE_TYPE == "DM" || SERVICE_TYPE == "PS" || SERVICE_TYPE == "II");
  		  needCheckingThroughGMES = isServiceTypeToCheckSerialNo && (isAirConditioner || isCtv || isWm);
	}
	
	// wty term이 out 일때는 체크 안함 2017.03.30 jiw 잠시보류
	//if(needCheckingThroughGMES && wtyInOut != "OW"){
	if(needCheckingThroughGMES){
		if(!isCheckingThroughGMES($j("#SERIAL_NO").val())){
			isValid = false;
			return isValid;
		}
	}
	
	try{
		var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
		var partSerials = $j('#partsTableBody input[name="SERIAL_MAT"]');
		//china : 중국만 아래 old 변수를 더 사용함.
		var OldpartCodes = $j('input[name="OLD_PARTS_CODE"]');
		var OldpartSerials = $j('input[name="OLD_SERIAL_MAT"]');
		
		var partDesc = $j('#partsTableBody input[name="PARTS_DESC"]');
		var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";


		var partsSeqObj = $j("#partsTableBody input[name='PARTS_SEQ_NO']");// document.getElementsByName('PARTS_SEQ_NO');
		var partsWtyObj = $j("#partsTableBody input[name='PARTS_INOUT']");// document.getElementsByName('PARTS_INOUT');
		
		// global REF
		var targetPartCode1 = "44B0,BK19,44D1,48B1,48B2,48D1,DK19,55A1,MK17,55A2,MK18,MK19,MKV1,MSA1,MSV1,NC1A,MSV4,UG4T,NC4M,UG9A,SD16,UR4D,SK18,UR5A,SK19,UR8B,UR8C,UR8D,ENV4,NC4E,NF54,NF94,NI34,NN34,NN35,NN54,UB1A";
		// global Air Conditioner
		var targetPartCode2 = "DA59-00556A,DA59-00556B,DA59-00566A,DB59-00025A,DB59-00026A,DB81-05016A,DB82-04857A,DB82-04863A," + 
								"DA59-00574A,DA59-00575A,DA59-00577A,DA59-00590A,DB95-05609A,NC4AV80ALP/TT1,NC4AV80ALP/TT2,NC4AV80ALR/TT1,NC4AV80ALR/TT2,NC4AV80ALR/TT3," + 
								"NC4AV80ALR/TT5,NC4EVA5ALM/ASH,NC4EVA5ALN/SJ3,NF34H9151AMASH,NF34J9131ANSJ3,NF34J9151ANSJ3,NF54M5151ARTT3,NI34N9801ADTT1,NI34N9802ADTT1," + 
								"NI34N9802ADTT2,NN34J9902APSI1,NN34J9902APTT3,NN34M9112ARASH,UG9TK3150FE4,NI34N9801ABTT3,NI34N9801ADTT2";
		
		//china : 중국과 글로벌이 대상 자재가 서로 다름.
		if(_l.u.isChinaRegion){
			  targetPartCode1 = " DK190, ENV4A, EQ4A5,EU4A5, MD162,MK183,MK190,MK4A5,MSA47,MSE48, MSE4A, MSV46, MSV48,MSV4A,NC4EV,SD162,SK170,SK182,SK183,SK190,SK1A1,SK382";
			  targetPartCode2 = " 48C129DUAEL-DO,DA59-00024B,DA59-00025A,DA59-00027A,DA59-00034A,DA59-00052A,DA59-00052B,DA59-00052C,DA59-00116A,DA59-00124A,DA59-00202A," +
	    	                          	"DA59-00202B,DA59-00202C,DA59-00202D,DA59-00203A,DA59-00203B,DA59-00216A,DA59-00217A,DA59-00224B,DA59-00230A,DA59-00286A,DA59-00286B,DA59-00286C," +
	    	                          	"DA59-00304A,DA59-00304B,DA59-00307A,DA59-00316A,DA59-00322A,DA59-00325A,DA59-00325B,DA59-00327A,DA59-00330A,DA59-00332A,DA59-00339A,DA59-00360A," +
	    	                          	"DA81-01442A,DA92-00022B,DA92-00023A,DA92-00027A,DA92-00031A,DA92-00032A,DA92-00033A,DA92-00034A,DA92-00036A,DA92-00040A,DA92-00051A,DA92-00090A," +
	    	                          	"DA92-00354A,DB59-00010A,DB95-00201A,DB95-00909A";
		}
		
		
		for ( var i = 0; i < partCodes.length; i++) {
			var partCode = $j.trim($j(partCodes[i]).val());
			var partSerial = $j.trim($j(partSerials[i]).val());
			var oldpartSerial = $j.trim($j(OldpartSerials[i]).val());
			
			var isTargetPart1 = partCode != null && partCode.length > 4 && targetPartCode1.indexOf(partCode.substring(0,4)) != -1;
			var isTargetPart2 = partCode != null && partCode.length > 10 && targetPartCode2.indexOf(partCode) != -1;
			var enterCorrectCompressorPartSN = (partSerial == null || partSerial.length < 14 || !(/[a-zA-Z]/.test(partSerial)) || !(/[0-9]/.test(partSerial)));
			var startCREATE_DATE = '20150226';
			if(_l.u.isChinaRegion){
				isTargetPart1 = partCode != null && partCode.length > 5 && targetPartCode1.indexOf(partCode.substring(0,5)) != -1;
				isTargetPart2 = partCode != null  && targetPartCode2.indexOf(partCode) != -1;//&& partCode.length == 11
				enterCorrectCompressorPartSN = !callGMESToCheckSerial(oldpartSerial) || 
															(partSerial == null || partSerial.length < 14 || !(/[a-zA-Z]/.test(partSerial)) || !(/[0-9]/.test(partSerial)));
				startCREATE_DATE = '20160801';
			}
			
			
			
			
			if(isTargetPart1 || isTargetPart2) {
				if(enterCorrectCompressorPartSN){
					alert("It is mandatory to enter correct Compressor Part S/N under Repair Part Information Tab. [" + partCode + "]");
					$j(partSerials[i]).focus();
					if(_l.u.isChinaRegion){isValid = true;}else{isValid = false;}
					break;
				}else{//if(enterCorrectCompressorPartSN){
					
					if(Number(_l.CREATE_DATE+"") >= Number(startCREATE_DATE) && _l.CurrStatus != 'ST035' && $j("#STATUS").val() == 'ST035' && (isAirConditioner || isRef)){
							if (partsSeqObj[i].value == "") {
								alert("Please save the service order to check Parts Term before changing status to Repair Completed.");
								isValid = false;
								break;
							}else {//if (partsSeqObj[i].value == "") {
								
								var invalidCompressorWarningError = ($j.trim($j(partsWtyObj[i]).val())=="I"
																						&& (_l.u.CountryCd == "IN" || _l.u.CountryCd == "LK") 
																						&& !isCompressorWarningError(partSerial));
								if(_l.u.isChinaRegion){
									invalidCompressorWarningError = ($j.trim($j(partsWtyObj[i]).val())=="I"
										&& !isCompressorWarningError(partSerial));
								}
								if(invalidCompressorWarningError){
										isValid = false;
										break;
								}
								
							}//if (partsSeqObj[i].value == "") {
					}//if(Number(_l.CREATE_DATE+"") >= Number(startCREATE_DATE)					
				}//if(enterCorrectCompressorPartSN){
			}//if(isTargetPart1 || isTargetPart2) {
			
			//china : 중국은 아래 체크로직을 타지 않으며, 결론적으로 바로 for 조건문으로 되돌아간다.
			//그래서, continue;문을 추가한다.
			if(_l.u.isChinaRegion){ continue;}
			
			if(isCtv && _l.isValidSerialSIEL){
				if (partCode.substring(0, 4) == "BN07") {
					if (partSerial == '') {
						isValid = false;
						alert(_l.r.m.PART_SERIAL_CHECK);
						break;
					}

					if (!(partSerial.length == 23 || partSerial.length == 25 || partSerial.length == 32)) {
						isValid = false;
						alert('Parts serial number length of BN07 must be 23, 25 or 32.');
						break;
					}

					if (containsCharsOnlyByValue(partSerial.charAt(0), chars)
							|| containsCharsOnlyByValue(partSerial.charAt(1), chars)) {
						isValid = false;
						alert('Parts serial number first two digit must be alphabet');
						break;
					}
					if(Number(_l.CREATE_DATE+"") >= Number('20150226') && _l.CurrStatus != 'ST035' && $j("#STATUS").val() == 'ST035'){
						if (partsSeqObj[i].value == "") {
							alert("Please save the service order to check Parts Term before changing status to Repair Completed.");
							isValid = false;
							break;
						}else {
							if($j.trim($j(partsWtyObj[i]).val())=="I"){
								if((_l.u.CountryCd == "IN" || _l.u.CountryCd == "LK") && !isCompressorWarningError(partSerial)){
									isValid = false;
									break;
								}
							}
						}
					}
					
				}
				// If Parts Number starts with BN95 or BN96 and ASSY PDP MODULE
				// &
				// PRODUCT LCD TEXT in Parts Description
				// then Part Serial Number is mandatory
				// Parts Serial No length = 25 (Refer #3)
				// Parts first two digit must be alphabet (Refer #4),
				
				//if ((partCode.substring(0, 4) == "BN95" || partCode.substring(0, 4) == "GH43" || partCode.substring(0, 4) == "GH44")
				if (((partCode.substring(0, 4) == "BN95" || partCode.substring(0, 4) == "BN96") && (($j.trim($j(partDesc[i]).val()).indexOf('ASSY PDP MODULE') >= 0) || ($j.trim($j(partDesc[i]).val()).indexOf('PRODUCT LCD') >= 0)))
					) {

					if (partSerial == '') {
						isValid = false;
						alert('parts Serial number field is mandatory');
						break;
					}

					if (!(partSerial.length == 23 || partSerial.length == 25 || partSerial.length == 32)) {
						isValid = false;
						alert('Parts serial number length of BN95, BN96, BN44 must be 23, 25 or 32.');
						break;
					}
					// var chars =
					// "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";

					if (containsCharsOnlyByValue(partSerial.charAt(0), chars)
							|| containsCharsOnlyByValue(partSerial.charAt(1), chars)) {
						isValid = false;
						alert('Parts serial number first two digit must be alphabet');
						break;
					}
					if(Number(_l.CREATE_DATE+"") >= Number('20150226') && _l.CurrStatus != 'ST035' && $j("#STATUS").val() == 'ST035'){
						if (partsSeqObj[i].value == "") {
							alert("Please save the service order to check Parts Term before changing status to Repair Completed.");
							isValid = false;
							break;
						}else {
							if($j.trim($j(partsWtyObj[i]).val())=="I"){
								if((_l.u.CountryCd == "IN" || _l.u.CountryCd == "LK") && !isCompressorWarningError(partSerial)){
									isValid = false;
									break;
								}
							}
						}
					}
				}
			}//if(isCtv || isSMPS){
		}//for ( var i = 0; i < partCodes.length; i++) {
	}catch(e){}
	return isValid;
}

//2016.09.19 SELV,SEIN GMES 적용
function validSerialGMES() {
	var isValid = true;
	
	if (!_l.usePhysicalVerification || $j("#STATUS").val() != 'ST035'){
		return true;
	}

	// checking to GMES with isSerialNumberValid()
	var statusCode = $("STATUS").value;
	var isVDE = false;
	var product = $j('input#CIC_PRCD').val();

	if(product == "VDE"){
		isVDE = true;
	}
	
	/*	추가 로직 : KD제품군 로직 제외 
	 *	KD 제품군 구분방법 :  Set S/N의 6번째 자리 = 4 or 6 or 7 or 8 or 9 이면 로직 Skip
	 *	2017.03.06 jiw	
    */
	var isKDSet = "4,6,7,8,9".indexOf($j("#SERIAL_NO").val().charAt(5));
	if(isVDE && isKDSet >= 0){
		return true;
	}
	
	var SERVICE_TYPE = $("SERVICE_TYPE").value;
	var isServiceTypeToCheckSerialNo = (SERVICE_TYPE == "CI" || SERVICE_TYPE == "IH" || SERVICE_TYPE == "BS" || SERVICE_TYPE == "DM" || SERVICE_TYPE == "PS" || SERVICE_TYPE == "II" || SERVICE_TYPE == "SR");
	if(isVDE && isServiceTypeToCheckSerialNo){
		if(_l.usePhysicalVerification && !isCheckingThroughGMES($j("#SERIAL_NO").val())){
			isValid = false;
			return isValid;
		}
	}

	try{
		var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
		var partSerials = $j('#partsTableBody input[name="SERIAL_MAT"]');
		
		var partDesc = $j('#partsTableBody input[name="PARTS_DESC"]');
		var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";

		var partsSeqObj = $j("#partsTableBody input[name='PARTS_SEQ_NO']");// document.getElementsByName('PARTS_SEQ_NO');
		var partsWtyObj = $j("#partsTableBody input[name='PARTS_INOUT']");// document.getElementsByName('PARTS_INOUT');

		for ( var i = 0; i < partCodes.length; i++) {
			var partCode = $j.trim($j(partCodes[i]).val());
			var partSerial = $j.trim($j(partSerials[i]).val());
			
			if(isVDE){
				if (partCode.substring(0, 4) == "BN07") {
					if (partSerial == '') {
						isValid = false;
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.PART_SERIAL_CHECK);
						break;
					}

					if (!(partSerial.length == 23 || partSerial.length == 25)) {
						isValid = false;
						alert(_l.u.WEB_MSG_PREFIX + 'Parts serial number length of BN07 must be 23 or 25.');
						break;
					}

					if (containsCharsOnlyByValue(partSerial.charAt(0), chars)
							|| containsCharsOnlyByValue(partSerial.charAt(1), chars)) {
						isValid = false;
						alert(_l.u.WEB_MSG_PREFIX + 'Parts serial number first two digit must be alphabet');
						break;
					}
					if(Number(_l.CREATE_DATE+"") >= Number('20150226') && _l.CurrStatus != 'ST035' && $j("#STATUS").val() == 'ST035'){
						if (partsSeqObj[i].value == "") {
							alert(_l.u.WEB_MSG_PREFIX + "Please save the service order to check Parts Term before changing status to Repair Completed.");
							isValid = false;
							break;
						}else {
							if($j.trim($j(partsWtyObj[i]).val())=="I"){
								if(_l.usePhysicalVerification && !isValidCheckGMES(partCode,partSerial)){
									isValid = false;
									break;
								}
							}
						}
					}
					
				}
				// If Parts Number starts with BN95 or BN96 and ASSY PDP MODULE
				// &
				// PRODUCT LCD TEXT in Parts Description
				// then Part Serial Number is mandatory
				// Parts Serial No length = 25 (Refer #3)
				// Parts first two digit must be alphabet (Refer #4),
				
				//if ((partCode.substring(0, 4) == "BN95" || partCode.substring(0, 4) == "GH43" || partCode.substring(0, 4) == "GH44")
				if (((partCode.substring(0, 4) == "BN95" || partCode.substring(0, 4) == "BN96") 
						&& (($j.trim($j(partDesc[i]).val()).indexOf('ASSY PDP MODULE') >= 0) || ($j.trim($j(partDesc[i]).val()).indexOf('PRODUCT LCD') >= 0)))) {

					if (partSerial == '') {
						isValid = false;
						alert(_l.u.WEB_MSG_PREFIX + 'parts Serial number field is mandatory');
						break;
					}

					if (!(partSerial.length == 23 || partSerial.length == 25)) {
						isValid = false;
						alert(_l.u.WEB_MSG_PREFIX + 'Parts serial number length of BN95, BN96, BN44 must be 23 or 25.');
						break;
					}

					if (containsCharsOnlyByValue(partSerial.charAt(0), chars)
							|| containsCharsOnlyByValue(partSerial.charAt(1), chars)) {
						isValid = false;
						alert(_l.u.WEB_MSG_PREFIX + 'Parts serial number first two digit must be alphabet');
						break;
					}
					if(Number(_l.CREATE_DATE+"") >= Number('20150226') && _l.CurrStatus != 'ST035' && $j("#STATUS").val() == 'ST035'){
						if (partsSeqObj[i].value == "") {
							alert(_l.u.WEB_MSG_PREFIX + "Please save the service order to check Parts Term before changing status to Repair Completed.");
							isValid = false;
							break;
						}else {
							if($j.trim($j(partsWtyObj[i]).val())=="I"){
								if(_l.usePhysicalVerification && !isValidCheckGMES(partCode,partSerial)){
									isValid = false;
									break;
								}
							}
						}
					}
				}
			}
		}
	}catch(e){}
	return isValid;
}

function octaBatteryVerification(verification){
	var isValid = true;
/*	if($j("#SERVICE_TYPE").val() == "AD"){
		return true;
	}*/
	// 이전 상태가 st035가 아니고 현재 상태가 st035이면 해당로직 수행, 아니면 skip
	// ST035 이면 무조건 호출하도록 변경 2018.04.12 jiw
	if(verification && $j("#STATUS").val() != 'ST035'){
		return true;
	}
	
	var product = $j('input#CIC_PRCD').val();
	if(product == "HHP" && _l.isDreamModel){
		var paramMap = {};
		paramMap.HHPYN = "Y";
		paramMap.OBJECT_ID = _l.ObjectId;
		paramMap.COMPANY = _l.ticketCompany;
		paramMap.ASC_CODE = _l.ASC_CODE;
		paramMap.CIC_PRD = $j('input#CIC_PRCD').val();
		paramMap.MODEL = $j("#MODEL").val();
		paramMap.SYMPTOM_CODE = $('IRIS_SYMPT').value;
		paramMap.REPAIR_CODE = $('IRIS_REPAIR').value;
		paramMap.SERVICE_TYPE = $j("#SERVICE_TYPE").val();
		paramMap.SERIAL_NO = $j('#SERIAL_NO').val();
		paramMap.IMEI = $j('#IMEI').val();
		paramMap.COMPLETE_DT = $("SERVICE_DATE").value;
		paramMap.STATUS = $("STATUS").value;
		paramMap.PARTS_CODE = "";
		paramMap.SN_PART_OLD = "";
		paramMap.SN_PART_NEW = "";
		paramMap.FAB_ID_OLD = "";
		paramMap.FAB_ID_NEW = "";
		//paramMap.IV_OLD_SN_CHECK ="";
		paramMap.NEW_IMEI = $("NEW_IMEI").value;
		
		var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
		var partOldSerials = $j('#partsTableBody input[name="OLD_SERIAL_MAT"]');
		var partSerials = $j('#partsTableBody input[name="SERIAL_MAT"]');
		var partOldFabIds = $j('#partsTableBody input[name="OLD_FAB_ID"]');
		var partFabIds = $j('#partsTableBody input[name="FAB_ID"]');
		
		var arrpartCodes = "";
		if(partCodes.length > 0){
			for ( var i = 0; i < partCodes.length; i++) {
				if(i == 0){
					paramMap.PARTS_CODE += $j.trim($j(partCodes[i]).val());
					paramMap.SN_PART_OLD += $j.trim($j(partOldSerials[i]).val());
					paramMap.SN_PART_NEW += $j.trim($j(partSerials[i]).val());
					paramMap.FAB_ID_OLD += $j.trim($j(partOldFabIds[i]).val());
					paramMap.FAB_ID_NEW += $j.trim($j(partFabIds[i]).val());
				}else{
					paramMap.PARTS_CODE += "," + $j.trim($j(partCodes[i]).val());
					paramMap.SN_PART_OLD += "," + $j.trim($j(partOldSerials[i]).val());
					paramMap.SN_PART_NEW += "," + $j.trim($j(partSerials[i]).val());
					paramMap.FAB_ID_OLD += "," + $j.trim($j(partOldFabIds[i]).val());
					paramMap.FAB_ID_NEW += "," + $j.trim($j(partFabIds[i]).val());
				}
				
			}
			
			$('progressloading').startWaiting();
			$j.ajax({
				type : 'post',
				dataType : 'json',
				async : false,
				url : '/svctracking/svcorder/modelBySerialByGMES2ForHHP.gspn',
				data : paramMap,
				success : function(data) {
					if(data.success) { // rfc 성공
						if(data.EV_CHECK_RESULT == "S"){
							isValid = true;
							if(!verification) {
								alert("Valid Check : Success");
							}
						}else if(data.EV_CHECK_RESULT == "W"){
							if(!verification) {
								alert("Valid Check : Success");
							} else {								
								if(confirm(_l.u.WEB_MSG_PREFIX +data.EV_CHECK_MSG)){
									isValid = true;
								}else{
									isValid = false;
								}
							}
						}else{	// EV_CHECK_RESULT == "E"
							alert(_l.u.SAP_MSG_PREFIX + data.EV_CHECK_MSG);
							isValid = false;
						}
					}else{ // rfc 에러
						alert( _l.u.SAP_MSG_PREFIX + data.EV_RET_MSG);
						isValid = false;
					}
				},
				error : function(jqXHR, textStatus) {
					// console.log(textStatus);
				}
			});		
			$('progressloading').stopWaiting();
		}
	}
	if(verification) {
		return isValid;
	}
}

function validPBAPartInfo(part){

	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_PARTS_CODE", part.value);
	insertValue("frm", "IV_ASC_CODE", _l.ASC_CODE);
	insertValue("frm", "IV_MODEL", $j("#MODEL").val());
	insertValue("frm", "IDX", part.parentNode.parentNode.rowIndex -1);
	insertValue("frm", "cmd", "ZifGspnMstPartsInfoCmd");
	
	AjaxSyncRequest(urlPattern, "frm", setValidPBAPartInfo);
}

function setValidPBAPartInfo(response){
	$('progressloading').stopWaiting();
	var jsonObj = eval('(' + response.responseText + ')');
	if (jsonObj.success && jsonObj.ES_PARTS_INFO.PBA_FLAG == "X") {
		$j('#partsTableBody').find('table[id="GenuineProductCertification"]').eq(jsonObj.IDX).css("display","inline");
	}
}

function genuineProductCheck(obj){
	var paramMap = {};
	paramMap.HHPYN = "Y";
	paramMap.OBJECT_ID = _l.ObjectId;
	paramMap.COMPANY = _l.u.c;
	paramMap.ASC_CODE = _l.ASC_CODE;
	paramMap.CIC_PRD = $j('input#CIC_PRCD').val();
	paramMap.MODEL = $j("#MODEL").val();
	paramMap.SYMPTOM_CODE = $('IRIS_SYMPT').value;
	paramMap.REPAIR_CODE = $('IRIS_REPAIR').value;
	paramMap.SERVICE_TYPE = $j("#SERVICE_TYPE").val();
	paramMap.SERIAL_NO = $j('#SERIAL_NO').val();
	paramMap.IMEI = $j('#IMEI').val();
	paramMap.COMPLETE_DT = $("SERVICE_DATE").value;
	paramMap.STATUS = $("STATUS").value;
	paramMap.IV_OLD_SN_CHECK = "X";

	var rowNo = obj.parentNode.parentNode.parentNode.parentNode.parentNode.parentNode.rowIndex - 1;

	var partCodes = $j('#partsTableBody').find('input[name="PARTS_CODE"]').eq(rowNo).val();
	var partOldSerials = $j('#partsTableBody').find('input[name="OLD_SERIAL_MAT"]').eq(rowNo).val();
	var partSerials = $j('#partsTableBody').find('input[name="SERIAL_MAT"]').eq(rowNo).val();

	paramMap.PARTS_CODE = partCodes;
	paramMap.SN_PART_OLD = partOldSerials;
	paramMap.SN_PART_NEW = partSerials;
		
	$('progressloading').startWaiting();
	$j.ajax({
		type : 'post',
		dataType : 'json',
		async : false,
		url : '/svctracking/svcorder/modelBySerialByGMES2ForHHP.gspn',
		data : paramMap,
		success : function(data) {
			if(data.success) { // rfc 성공
				if(data.EV_CHECK_RESULT == "S"){
					alert("The unit is Genuine");
				}else{	// EV_CHECK_RESULT == "E"
					alert(_l.u.SAP_MSG_PREFIX + data.EV_CHECK_MSG);
				}
			}else{ // rfc 에러
				alert( _l.u.SAP_MSG_PREFIX + data.EV_RET_MSG);
			}
		},
		error : function(jqXHR, textStatus) {
			// console.log(textStatus);
		}
	});		
	$('progressloading').stopWaiting();
}

/**
 * check if SO has repair code to need the part
 */
function validHHPAccessorySerialParts() {
	if (_l.u.c != "C550"){
		return true;
	}
	var valid = true;
	
	var svcProd = $("SVC_PRCD").value;
	var isHHPProduct = ("HHP01,HHP02,HHP05,DSC05,HHP1A,HHP1B,HHP2A,HHP2B,HHP06".indexOf(svcProd) != -1);
	
	var hasPart = hasRepairPart();
	var isAccessorySerialNeed = true;

	if (hasPart && isHHPProduct && !_l.isDreamModel) {
		var arrParts = $j("#partsTableBody input[name='PARTS_CODE']");// cfArray(frm.PARTS_CODE);
		var arrSerialParts = $j("#partsTableBody input[name='SERIAL_MAT']");// cfArray(frm.PARTS_CODE);
		var partLen = arrParts.length;
		for ( var i = 0; i < partLen; i++) {
			var isHHPAccessory = ("GH43,GH44".indexOf(arrParts[i].value.substring(0,4)) != -1);
			if (isHHPAccessory) {
				if(arrSerialParts[i].value.blank()){
					alert(_l.u.WEB_MSG_PREFIX + "Please input new part serial number in Repair parts information");
					isAccessorySerialNeed = false;
					arrSerialParts[i].focus();
					break;
				}else{
					var check11Digit = ("RT,DK,SC,KT,SL,DW,SE,BD,RC".indexOf(arrSerialParts[i].value.substring(0,2)) != -1);
					var check13Digit = ("A,B,L,Y,T,N".indexOf(arrSerialParts[i].value.substring(0,1)) != -1);
					if(check11Digit){
						if(arrSerialParts[i].value.length != 11){
							alert(_l.u.WEB_MSG_PREFIX + "Parts Serial number should be of 11 digits.");
							isAccessorySerialNeed = false;
							break;
						}
					}else if(check13Digit){
						if(arrSerialParts[i].value.length != 13){
							alert(_l.u.WEB_MSG_PREFIX + "Parts Serial number should be of 13 digits.");
							isAccessorySerialNeed = false;
							break;
						}
					}else{
						alert(_l.u.WEB_MSG_PREFIX + "Cannot save as part serial number is not valid.");
						isAccessorySerialNeed = false;
						break;
					}
				}
			}
		}
	}
	return isAccessorySerialNeed;
}

/**
 * if repair code need any part, return true
 */
function repairCodeNeedPart() {
	var partsNeed = false;
	var repairCode = $j("#IRIS_REPAIR").val();
	var arrCodeForPart = new Array('DPRT');
	for ( var i = 0; i < arrCodeForPart.length; i++) {
		if (arrCodeForPart[i] == repairCode) {
			partsNeed = true;
			break;
		}
	}
	return partsNeed;
}

function isLocationValid() {
	var isValid = true; // true

	if (_l.u.c != 'C550') {
		return isValid;
	}

	var isAirConditioner = false;
	var product = $j('input#SVC_PRCD').val();
	if (product && '|A/C|REF'.indexOf(product.substring(0, 3)) > -1) {
		isAirConditioner = true;
	}
	if (!isAirConditioner) {
		return isValid;
	}

	var isGasCharged = false;
	var gasCharge = $j('select#GAS_CHARGE option:selected').text();
	if (gasCharge && gasCharge.indexOf("Gas Charge") > -1) {
		isGasCharged = true;
	}
	if (!isGasCharged) {
		return isValid;
	}

	var regExp = /^JT\d{2}|^COMP/;
	var isValidLocationCode = false;
	var locations = $j('#partsTableBody input[name="REPAIR_LOC"]');
	var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');

	for ( var i = 0; i < locations.length; i++) {
		var locationCode = $j.trim($j(locations[i]).val());
		if(i==0){
			var isValidLocFormat = true;
			if(locationCode == ""){
				isValidLocFormat = false;
				isValidLocationCode = false;
				break;
			}
			var partCode = $j.trim($j(partCodes[i]).val());
			var isValidLocFormat = (locationCode.length == 4 && regExp
					.test(locationCode));

			if (partCode.blank() && isValidLocFormat) {
				isValidLocationCode = true;
				break;
			}
		}
		
	}// for (var i = 0; i < locations.length; i++) {

	// at least one part location is valid
	// at this position, isAirConditioner = true and isGasCharged = true

	if (isAirConditioner && isGasCharged) {
		if (!isValidLocationCode) {
			isValid = false;
		}
	} else {
		isValid = false;
	}

	if (!isValid) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0151);
	}

	return isValid;
}

/**
 * 체크로직 안타는 경우 : C550 또는 C962 & ST035,40
 * @returns {Boolean}
 */
function isGasLeakValid() {

	var isValid = true; // true
	if (_l.u.c == 'C550') {
		return isValid;
	}
	
	if (_l.u.c == 'C962' && ("ST035|ST040").indexOf($("STATUS").value) < 0) {
		return isValid;
	}

	var selectedGasLeakCode = false;
	var repairCode = $('IRIS_REPAIR').value;
	var symptomCode = $('IRIS_SYMPT').value;
	
	//글로벌은  ServiceOrderModelSearchCmd 호출후 hq_svc_prod 값을 사용한다.
	//그러나이미 모델 검색해서 히든값으로 있거나 수정시는 ticket.getModel().getHQ_SVC_PRCD() 로 히든값에 값을 담았는데
	//??왜 다시 호출할까???? 알수 없다.... 이유를 모르니 그래로 둔다.
	var product = '';
	if(_l.u.isChinaRegion){
		product = $j('#SVC_PRCD').val();
	}else{
		product = getHQSvcProdAsync();
	}
	
	var repairCodePossibleEntry = [ "X07", "B02", "WD", "A13", "D", "A1", "I1" ];
	var symptomCodePossibleEntry = [ "HE9", "C53", "TR41", "B50", "C50" ];
	var repairCodeGasLeak = false;
	var symptomCodeGasLeak = false;

	//아래 체크로직은 보이는건 중국과 많이 달라 보이나 동일한 로직이다.
	if (product
			&& ('|A/C|'.indexOf(product.substring(0, 3)) > -1 || 'RA'
					.indexOf(product.substring(0, 2))) > -1) {
		if (repairCode != "") {
			for ( var i = 0; i < repairCodePossibleEntry.length; i++) {
				if (repairCode == repairCodePossibleEntry[i]) {
					repairCodeGasLeak = true;
					break;
				}
			}
		}
		if (symptomCode != "") {
			for ( var i = 0; i < symptomCodePossibleEntry.length; i++) {
				if (symptomCode == symptomCodePossibleEntry[i]) {
					symptomCodeGasLeak = true;
					break;
				}
			}
		}
	}
	if (repairCodeGasLeak || symptomCodeGasLeak)
		selectedGasLeakCode = true;

	if (!selectedGasLeakCode) {
		return isValid;
	}
	var regExp = /^JT\d{2}/;
	var regExpC962 = /^JT\d{2}/;
	var isValidLocationCode = false;
	var locations = $j('#partsTableBody input[name="REPAIR_LOC"]');
	var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');

	//china : 중국에는 if(selectedGasLeakCode){ 문장이 없음. 
	//이미 앞에서 !selectedGasLeakCode 경우 return 햇으므로, 무조건selectedGasLeakCode 참이므로, 구지 if 문은 없어도 될것으로 보인다. 
	//if 하나라도 더 중첩이되면 소스를 읽기가 어려워 빼고는 싶지만. 그치만 그대로 둔다. 
	//그대로 둬도 로직은 문제없고, 혹시나 해서 그대로 두다. 
	if(selectedGasLeakCode){ 
		for ( var i = 0; i < locations.length; i++) {
			var locationCode = $j.trim($j(locations[i]).val());
			
			//china : 글로벌은 첫번째 자재칸에 loc를 넣어야 하지만, 중국은 어디에 넣어도 상관 없음.
			//if문안의 isValidLocFormat 판단 로직은 중국과글로벌이 눈으로 보기는 다르지만 결과는 동일함.
			//locations.length 를 조정해서 소스 머지가 가능하겟지만, 머지한 부분확인을 편하게 하기 위해 이방법 사용함. 
			var checkValidLocationCode = (i==0);
			//글로벌로직이 맞는로직이라 글로벌을 유지함.
			//글로벌/중국 다르게 가고자 할경우 아래 세줄 주석 풀어주세요.
			//if(_l.u.isChinaRegion){//중국은 항상 true 그래서 모든 자재에 대해서 체크함.
			//	checkValidLocationCode = true;
			//}
			
			
			if(checkValidLocationCode){
				var isValidLocFormat = true;
				if(locationCode == ""){
					isValidLocFormat = false;
					isValidLocationCode = false;
					break;
				}
				var partCode = $j.trim($j(partCodes[i]).val());
				
				if(_l.u.c == 'C962') {
					isValidLocFormat = (locationCode.length == 4 && regExpC962.test(locationCode.toUpperCase()));			
					if(Number(locationCode.substring(2, 4)) > 20) {
						isValidLocFormat = false;
					} 
				} else {
					isValidLocFormat = (locationCode.length == 4 && regExp.test(locationCode));
				}
						
				if (partCode.blank() && isValidLocFormat) {
					isValidLocationCode = true;
					break;
				}
			}
			
		}// for (var i = 0; i < locations.length; i++) {
		// at least one part location is valid
		// at this position, isAirConditioner = true and isGasCharged = true
	}

	if (selectedGasLeakCode) {
		if (!isValidLocationCode) {
			isValid = false;
		}
	}

	if (!isValid) {
		alert(_l.u.WEB_MSG_PREFIX + 'Enter Gas Leakage Joint number in Part Location field of 1st line for AC Product.');
	}
	
	//china : 중국은 isValid를 무조건 true로 리턴함. 즉 위체크로직에 결려도 자재가 저장이 되도록 허용함.
	//글로벌은 체크로직에 걸리면 자재 저장못하도록 함. 글로벌로직이 맞는로직이라 글로벌을 유지함.
	//글로벌/중국 다르게 가고자 할경우 아래 세줄 주석 풀어주세요.
	//if(_l.u.isChinaRegion){
	//	isValid = true;
	//}

	// isValid = true; //에어컨 품질그룹 홍의정 차장이 법인에 공지 및 Product Code 구분 완료까지 저장되도록 요청
	// 체크시 저장 안되도록 홍의정 차장 요청 2013.05.24
	return isValid;
}

/**
 * if true then pass save process else interrupt save process with alert message
 * when Resoldering or Alignment, part location should be inputed except model
 * start with THB if part location is empty, warranty will has PC005 error code
 * inspite of warranty claimed(status = 10) when Resoldering or Alignment,
 * repair code is one of them IRIS Repair code(IRIS-R) : C, D. EIA Repair
 * code(EIA-R) : ALEL, SOLD. New SAMSUNG Repair code(NSAM-R) : C09, B01
 * 
 */
function validPartLocation() {
	
	var valid = false;
	if(_l.u.c == "C310" && (_l.CIC_PRCD =="REF" || _l.CIC_PRCD =="WSM" || _l.CIC_PRCD =="HKE")){
		valid = true;	//C310 냉장고, 세탁기 및 식기 세척기 예외
		return valid; 	//china : if 중첩문을 제거 : 가독성 높이기위해.
	}
	//china : 중국은 validPartLocation() 호출하는곳에서  if(loginUserCorpCode == 'C6V0'){ 이 있어서 C6V0는  !validPartLocation() 을 안타도록 되어 있음.
	//그러나, validPartLocation() 탈지말지 조건이 validPartLocation() 함수 내에 있으므로, 이곳으로 이동함.
	//즉 호출처에서 분기하지 않음.
	if(isNewChina){
		valid = true;	//C310 냉장고, 세탁기 및 식기 세척기 예외
		return valid; 	//china : if 중첩문을 제거 : 가독성 높이기위해.
	}
	
	//}else{
		var IRISRepairCode = false; // (IRIS-R) : C, D.
		var EIARepairCode = false;// (EIA-R) : ALEL, SOLD.
		var NewSAMSUNGRepairCode = false;// (NSAM-R) : C09, B01
		
		var frm = document.detailForm;
		var model = frm.MODEL.value;

		var conditionCode = frm.IRIS_CONDI.value;
		var symptomCode = frm.IRIS_SYMPT.value;
		var defectCode = frm.IRIS_DEFECT.value;
		var repairCode = frm.IRIS_REPAIR.value;

		var arrParts = $j('#partsTableBody input[name="PARTS_CODE"]');// cfArray(frm.PARTS_CODE);
		var arrPartsLoc = $j('#partsTableBody input[name="REPAIR_LOC"]');// cfArray(frm.REPAIR_LOC);
		var arrPartsStatus;
		/**
		 * below cases, can skip this check logic 1. repair code is empty or model
		 * is empty or model start with THB 2. don't know repair code group 3.
		 * codegroup and repair code is not match
		 */
		// skip condition 1 : model is empty or model start with THB
		if (model == "" || model.indexOf("THB") == 0) {
			valid = true;
			return valid;
		}

		// skip condition 2 : IRIS code group
		var jsonObj_group = parent.jsonIrisCodeGroup_temp;
		if (jsonObj_group) {
			var codeGroupLength = jsonObj_group.dataLists.length;
			for ( var i = 0; i < codeGroupLength; i++) {
				var tmp = jsonObj_group.dataLists[i].ctype;
				if (tmp == "IRIS-R") {
					IRISRepairCode = true;
					break;
				} else if (tmp == "EIA-R") {
					EIARepairCode = true;
					break;
				} else if (tmp == "NSAM-R") {
					NewSAMSUNGRepairCode = true;
					break;
				}
			}// for (var i = 0; i < codeGroupLength; i++) {
		} else {
			valid = true;
			return valid;
		}

		//china : 중국은 아래 체크로직이  더 있음.
		//중국 소스 주석에는  C6V0 경우 제외한다고 되어 있지만 C6V0 이 함수 내로 들어올수가 없음. 위의 필터링 로직에서 rturn되어 버림. 
		//중국 소스 주석 : skip condition 3 : 시스템 에어컨 제외.. C6V0
		if(_l.u.isChinaRegion){
			var SVC_PRCD = $j('#SVC_PRCD').val().substr(0,3);
			if(SVC_PRCD=='SAC' || SVC_PRCD=='SAO' || SVC_PRCD=='CAC' ){
				return true;
			}
		}

		
		var locationCheck = new RepairLocationIRIS();
		locationCheck.IRIS = IRISRepairCode;
		locationCheck.EIA = EIARepairCode;
		locationCheck.NSAM = NewSAMSUNGRepairCode;
		locationCheck.condition = conditionCode;
		locationCheck.symptom = symptomCode;
		locationCheck.defect = defectCode;
		locationCheck.repair = repairCode;
		locationCheck.locations = arrPartsLoc;
		locationCheck.parts = arrParts;
		
		//china : 중국경우 아래 로직이 없지만, 넣어야함. 안녕으면, isREF_WM 값이 무조건 false로 나옴.
		//중국도 글로벌과 동일한 WSM,REF 코드를 가지고 사용하고 있음.
		locationCheck.prodCd = _l.CIC_PRCD;

		if (locationCheck.isOK()) {
			valid = true;
		} else {// if(locationCheck.isOK()){
			valid = false;
			
			if (locationCheck.isREF_WM()) {
				alert(_l.u.WEB_MSG_PREFIX + "Please Enter Joint Number in Part Location Field for Water & Gas Leakage. (REF,W/M)");
			} else {// if( locationCheck.isREF_WM() ){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0047);
			}// if( locationCheck.isREF_WM() ){

		}// if(locationCheck.isOK()){
	//}

	return valid;
}

/**
 * PARTS_QTY > 1 : 자재수량 맞는지 다시 확인함.
 * PARTS_CODE=GH82 or GH97 && PARTS_QTY > 1  : 자재 저장못함.
 */
function validPartQty() {
	var valid = true;

	if(!(_l.u.ConsignmentStockAsc || _l.u.c == 'C550')){
		valid = true;
		return valid;
	}
	
	var partsSeqObj = $j("#partsTableBody input[name='PARTS_SEQ_NO']");// document.getElementsByName('PARTS_SEQ_NO');
	var partsCodeObj = $j("#partsTableBody input[name='PARTS_CODE']");//
	// document.getElementsByName('PARTS_CODE');
	var partsQtyObj = $j("#partsTableBody input[name='PARTS_QTY']");// document.getElementsByName('PARTS_QTY');
	// var partsWtyObj = $j("#partsTableBody input[name='PARTS_INOUT']");//
	// document.getElementsByName('PARTS_INOUT');

	var partLen = partsSeqObj.length;
	for ( var i = 0; i < partLen; i++) {
		if(_l.u.ConsignmentStockAsc){
			if (partsSeqObj[i].value == "" && Number(partsQtyObj[i].value) > 1) {
				var valid = confirm(_l.u.WEB_MSG_PREFIX +"Part QTY Entered is more than 1. Please Reconfirm the Quantity !");
				// if return is OK then true.
				return valid;
			}
		}
		if(_l.u.c == 'C550'){
			if ((partsCodeObj[i].value.substring(0, 4) == "GH82" || partsCodeObj[i].value.substring(0, 4) == "GH97") && Number(partsQtyObj[i].value) > 1) {
				alert(_l.u.WEB_MSG_PREFIX + "More than 1 QTY consumption is not allowed for this part (s), please change the details.");
				valid = false;
				return valid;
			}
		}
		
	}
	
	return valid;
}

// service tracking, warranty claim
var RepairLocationIRIS = Class
		.create({

			initialize : function() {
			},

			IRIS : false,
			EIA : false,
			NSAM : false,
			condition : "",
			symptom : "",
			defect : "",
			repair : "",
			locations : [], // repair part location
			types : [], // part item type
			parts : [], // repair part code
			items : [], // wty condition TXT or MAT or CON
			wtyPage : false, // wty change page
			svcPage : false, // ticket change page
			prodCd : "",
			isRefrigerator : false,
			isWashMachine : false,

			/* IRIS codes that location is madatory */
			getIRISCodes : function() {
				// codes that location need
				var arrLocationNeedCode = [];

				this.setProductCode();

				if (this.isRefrigerator || this.isWashMachine) {
					if (this.IRIS) {
						arrLocationNeedCode = [
								/* condition */[],
								/* symptom */[ "120", "A50", "A51", "A5X",
										"B50", "B54", "C50", "C53", "C71",
										"C75", "B5X", "C5X" ],
								/* defect */[],
								/* repair */[ "D", "A1", "I1" ] ];
					}
					if (this.EIA) {
						arrLocationNeedCode = [
								/* condition */[],
								/* symptom */[],
								/* defect */[ "LEAK", "HE9", "HEA", "HF2",
										"HFA", "HFB", "HG6", "HGB", "HGD",
										"HGC", "HG8" ],
								/* repair */[ "RECH", "SOLD", "WM14", "SEAL",
										"RP01", "RP02", "RP03", "RP11", "RA04",
										"RA06", "AP05", "AP07", "AP13", "AP15",
										"AP16", "CA02", "CP01" ] ];
					}
					if (this.NSAM) {
						arrLocationNeedCode = [
								/* condition */[],
								/* symptom */[ "HE9", "HEA", "HF2", "HG6",
										"HGB", "HGC", "HGD", "HG8" ],
								/* defect */[],
								/* repair */[ "A13", "A15", "A19", "B01",
										"B02", "X07" ] ];
					}
				} else {// if(this.isRefrigerator || this.isWashMachine){
					if (this.IRIS) {
						arrLocationNeedCode = [
						/* condition */[],
						/* symptom */[],
						/* defect */[],
						/* repair */[ "C", "D" ] ];
					}
					if (this.EIA) {
						arrLocationNeedCode = [
						/* condition */[],
						/* symptom */[],
						/* defect */[],
						/* repair */[ "ALEL", "SOLD" ] ];
					}
					if (this.NSAM) {
						arrLocationNeedCode = [
						/* condition */[],
						/* symptom */[],
						/* defect */[],
						/* repair */[ "C09", "B01" ] ];
					}
				}// if(this.isRefrigerator || this.isWashMachine){
				return arrLocationNeedCode;
			},

			needLocation : function() {
				var need = false;
				var conditionValid = false;
				var symptomValid = false;
				var defectValid = false;
				var repairValid = false;

				var arrLocationNeedCode = this.getIRISCodes();

				if (this.condition == undefined || this.condition == null
						|| this.condition.blank()
						|| arrLocationNeedCode[0].length == 0) {
					conditionValid = true;
				} else {
					conditionValid = arrLocationNeedCode[0]
							.indexOf(this.condition) == -1;
				}

				if (this.symptom == undefined || this.symptom == null
						|| this.symptom.blank()
						|| arrLocationNeedCode[1].length == 0) {
					symptomValid = true;
				} else {
					symptomValid = arrLocationNeedCode[1].indexOf(this.symptom) == -1;
				}

				if (this.defect == undefined || this.defect == null
						|| this.defect.blank()
						|| arrLocationNeedCode[2].length == 0) {
					defectValid = true;
				} else {
					defectValid = arrLocationNeedCode[2].indexOf(this.defect) == -1;
				}

				if (this.repair == undefined || this.repair == null
						|| this.repair.blank()
						|| arrLocationNeedCode[3].length == 0) {
					repairValid = true;
				} else {
					repairValid = arrLocationNeedCode[3].indexOf(this.repair) == -1;
				}

				need = !(conditionValid && symptomValid && defectValid && repairValid);

				return need;
			},

			/* if everythig OK then return true */
			isOK : function() {
				var vaid = true;
				var need = this.needLocation();
				var hasLoc = false;
				if (this.wtyPage) {
					hasLoc = this.hasLocationWty();
				} else {
					hasLoc = this.hasLocation();
				}

				if (need & !hasLoc) {
					vaid = false;
				}
				return vaid;
				// return true;

			},

			hasLocation : function() {
				var hasLoc = false; // only location
				var hasLocPart = false; // location & part code
				var len = this.locations.length;
				for ( var i = 0; i < len; i++) {
					var loc = this.locations[i];
					var part = this.parts[i];

					if (this.isRefrigerator || this.isWashMachine) {
						
						if(_l.u.c == "C610"){
							//홍콩은 part && loc둘다 빈값이 아니면 hasLoc true로 함 - 법인요청에 따라 변경
							if (!part.value.blank() && !loc.value.blank()) {
								hasLoc = true;
							}
						}else{
							if (part.value.blank() && !loc.value.blank()) {
								hasLoc = true;
							}
						}

					} else {// if(this.isRefrigerator || this.isWashMachine){

						if (loc.value.blank()) {
							// loc.removeClass("inputRO").addClass("inputF").prop("readonly",
							// false);
							loc.readOnly = false;
							loc.className = "inputF";
						} else {
							hasLoc = true;
						}

					}// if(this.isRefrigerator || this.isWashMachine){

				}// for(var i = 0; i < len; i++){
				return hasLoc;
			},

			hasLocationWty : function() {
				var hasLoc = false;
				var len = this.locations.length;

				for ( var i = 0; i < len; i++) {
					var loc = this.locations[i];
					var item = this.items[i];

					if (this.isRefrigerator || this.isWashMachine) {

						if (item.value == "TXT" && !loc.value.blank()) {
							hasLoc = true;
						}

					} else {// if(this.isRefrigerator || this.isWashMachine){

						if (loc.value.blank()) {
							// loc.removeClass("inputRO").addClass("inputF").prop("readonly",
							// false);
							loc.readOnly = false;
							loc.className = "inputF";
						} else {
							hasLoc = true;
						}

					}// if(this.isRefrigerator || this.isWashMachine){

				}
				return hasLoc;
			},

			isREF_WM : function() {
				return this.isRefrigerator || this.isWashMachine;
			},

			setProductCode : function() {
				this.isRefrigerator = this.prodCd == "REF";
				this.isWashMachine = this.prodCd == "WSM";

				if (this.wtyPage) {/* not check for REF, WSM logic in wty page */
					this.isRefrigerator = false;
					this.isWashMachine = false;
				}

			}

		});

/**
 * status 'P' means that the part (code) for repair need but engineer don't have
 * when status is ST035 or ST040, the part status is changed with 'U' at the
 * below some cases 1. ASC have to GI bu they can't because of no part 2. ASC
 * can not GI * in case inventory or fsc user, if part no is empty and location
 * is not then status = U otherwise all parts status = U
 */
function transitPartStatus() {
	var statusCode = $("STATUS").value;
	// Status Repair Completed Good Delivered
	var afterRepairComplete = (statusCode == "ST035" || statusCode == "ST040");

	var partSts = $j("#partsTableBody input[name='PARTS_STATUS']");// document.getElementsByName('PARTS_STATUS');
	var partCode = $j("#partsTableBody input[name='PARTS_CODE']");// document.getElementsByName('PARTS_CODE');

	var inventoryFlag = _l.inventoryFlag;
	for ( var i = 0; i < partSts.length; i++) {
		var canNotGIByNoPartCode = partCode[i].value.blank();
		if (partCode[i].value.blank() || afterRepairComplete) {
			if (!inventoryFlag) {
				partSts[i].value = 'U';
			}
		}
	}// for(var i=0; i<partSts.length; i++){}//function
}

function validCleanCodeLocation() {
	var valid = true;
	var statusCode = $("STATUS").value;

	var svcProd = $("SVC_PRCD").value;
	var chkSvcProd = "HHP01,HHP01,HHP05,HHP1A,HHP1B,HHP2A,HHP2B,HHP06".indexOf(svcProd) != -1;
	/*
	 * . Repair Desc. or Defect Desc. or Remark 필드 중 하나라도 "Cleaning, Clean, Cle,
	 * Clen, Clening, Clin" 문구를 일부 포함 할경우, Repair Code 가 M01 가 아니면, ->Error
	 * Message 출력 "In case of Cleaning [Repair Code : Cleaning] should be
	 * selected." . Repair Code 가 M10 인데, Part Item 이 row 가 Zero 이거나, Part
	 * Location 이 blank 이면, ->Error Message 출력 "In case of Cleaning, Parts
	 * Location is required." 그리고, 메시지 출력 후 Save blcok.
	 */
	var inCludeClean = false;
	if (chkSvcProd) {
		var repairDesc = $('REPAIR_DESC').value;
		var defectDesc = $('DEFECT_DESC').value;
		var remark = $('REMARK').value;

		var repairCode = $('IRIS_REPAIR').value;
		var regExp = /^Cleaning|^Clean|^Cle|^Clen|^Clening|^Clin|^Cleen|^Claen|^Clining|^Clinning|^Claening/i;
		if (repairDesc != "" && regExp.test(repairDesc)) {// 포함되었다면,
			inCludeClean = true;
		}
		if (defectDesc != "" && regExp.test(defectDesc)) {// 포함되었다면,
			inCludeClean = true;
		}
		if (remark != "" && regExp.test(remark)) {// 포함되었다면,
			inCludeClean = true;
		}

		if (inCludeClean && repairCode != "M10") {
			alert(_l.u.WEB_MSG_PREFIX + "In case of Cleaning [ Repair code: Cleaning(M10) ] should be selected.");
			valid = false;
			$('IRIS_REPAIR').disabled = false;
			$('IRIS_REPAIR').className = "selectIDS";
			return valid;
		}
		if (repairCode == "M10") {
			var arrParts = $j("#partsTableBody input[name='PARTS_CODE']");// cfArray(frm.PARTS_CODE);
			var arrPartsLoc = $j("#partsTableBody input[name='REPAIR_LOC']");// cfArray(frm.REPAIR_LOC);

			var partLen = arrParts.length;
			var tbodyObj = $('partsTableBody');
			if (valid && $(tbodyObj).childNodes.length > 0) {
				for ( var i = 0; i < partLen; i++) {
					var part = arrParts[i].value.strip();
					var partLoc = arrPartsLoc[i].value.strip();

					if (partLoc == "") {
						alert(_l.u.WEB_MSG_PREFIX + "In case of Cleaning, Parts Location is required.");
						arrPartsLoc[i].readOnly = false;
						arrPartsLoc[i].className = "inputF";
						arrPartsLoc[i].focus();
						valid = false;
						$('IRIS_REPAIR').disabled = false;
						$('IRIS_REPAIR').className = "selectIDS";
						break;
					}
				}// for(var i = 0; i < partLen; i++){
			} else { // condition is correct, but there is no part.
				alert(_l.u.WEB_MSG_PREFIX + "In case of Cleaning, Parts Location is required.");
				$('IRIS_REPAIR').disabled = false;
				$('IRIS_REPAIR').className = "selectIDS";
				valid = false;
			}
		}// if(repairCode == "M10"){
	}
	return valid;
}

function getBufferOverviewDetail() {
	$('progressloading').startWaiting();
	$('progressloading').style.height = self.document.body.scrollHeight;

	$('bufferForm').model.value = $('detailForm').NEW_MODEL.value;
	$('bufferForm').serial.value = $('detailForm').NEW_SERIAL_NO.value;
	AjaxRequest(urlPatternGZIP + '?cmd=BufferOverviewDetailCmd', 'bufferForm',
			setBufferInfo);
}

function setBufferInfo(response) {
	$('progressloading').stopWaiting();
	var jsonObj = eval('(' + response.responseText + ')');
	var curr_sts = '';
	if (jsonObj.success) {
		var length = jsonObj.ptBs05.length;
		if (length > 0)
			curr_sts = jsonObj.ptBs05[0].curr_sts;
	}
	if (curr_sts == '22') {
		saveServiceOrder();
	} else {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0159);
	}
}

function saveAsPending() {
	$('STATUS').value = "ST030";
	//changeStatusCode();
	//$j("#REASON").find("option:[value=HP069]").prop("disabled", false);
	$j("#REASON option").remove();
	$j("#REASON").append("<option value='HP069'>HP069</option>");
	$('REASON').value = "HP069";
	saveServiceOrder();
}

function saveServiceOrder(type) {	

	if(isNewChina){
		if($("escalAscTd2") != null && $("ASC_SELF") != null && $("SOONFOONG") != null){
			if($("escalAscTd2").style.display != '' && $("escalAscTd2").style.display.toLowerCase() != 'none' && !$j("#ASC_SELF").attr("checked") && !$j("#SOONFOONG").attr("checked")){
				alert("请选择产品寄送方式！");
				return;
			}
		}
	}


	$('detailForm').WTY_EXCEPTION.disabled = false;

	$('detailForm').IRIS_REPAIR.disabled = false;
	
	if($('detailForm').SHIP_METHOD != undefined){
		$('detailForm').SHIP_METHOD.disabled = false;
	}

	$('progressloading').startWaiting();	
	// $('progressloading').style.height=self.document.body.scrollHeight;
	// self.scrollTo(0,document.body.scrollHeight/3);
	if(_l.useDynatrace) {
		dtAction = dynaTrace.enterAction('SO modify();'+_l.dtADKCode, 'Click SO modify');	
	}
	$j(document.detailForm.SERVICE_TYPE).prop("disabled", false);
	$('detailForm').WTY_FLAG.value = checkWtyFlag;	
	$('tempForm').dataChange.value = 'X';
	
	if(!(_l.u.isChinaRegion || isMedisonUser)){
		if(_l.isDreamModel){
			$('detailForm').OLD_PARTS_SERIAL_FLAG.value = 'X';
		}
	}

	if(isNewChina){
		$('detailForm').EX_FLAG.value = $j('input[name="EX_FLAG"]:checked').val();
		//START : 중국 서비스 디멘드 과제 - 집합수리 (jinhaw.bae)
	    if($j("#ASC_SELF").attr("checked")){
	    	$('detailForm').ASC_SELF.value ="X";
	    }
	    if($j("#ASC_ADDRESS").attr("checked")){
	    	$('detailForm').ASC_ADDRESS.value ="X";
	    } 
	    //END   : 중국 서비스 디멘드 과제 - 집합수리 (jinhaw.bae)
	}
	
	if(type=='WARNING_SKIP'){
		$('detailForm').WARNING_SKIP.value = "X";
		$j('#divConfirmNotice').hide();
		$j('#divBlock').hide();
	}else{
		$('detailForm').WARNING_SKIP.value = "";
	}
	
	//이전 status 가 변경 status 와 다르고, repairCompleted, Goods Deliverd로 변경시
	//EHN : auto wty 없이 VSR2 적용토록 수정함. 중남미는 vsr2 만 쓰기를 원함.
	
	var needVSR2StatusCondition = false;
	var userSelectedStatus = $j("#STATUS").val();
	var statusChanged = (_l.CurrStatus != userSelectedStatus);
	
	var globalConditionForVSR2 = statusChanged && (userSelectedStatus == "ST035" || userSelectedStatus == "ST040");
	
	if(isNewChina){
		if(_l.currReason == "HL020"){
			needVSR2StatusCondition = userSelectedStatus == "ST035" && _l.CurrStatus == "ST035";
		}else{
			needVSR2StatusCondition = globalConditionForVSR2;
		}
	}else if(_l.u.c == 'C330'){
		needVSR2StatusCondition = userSelectedStatus == "ST040";
	}else if(_l.u.c != 'C550' && !isNewChina && _l.repairCompletedOnMGSPN) {
		//전권역(인도,중국 제외)에서 mgspn에서 수리완료건은 VSR2 안태움. VSR2 태우고 에러가 나면 팬딩으로 간후 티겟정보 수정해야 하나 법인이 팬딩으로 가는걸 원치 않음.
		needVSR2StatusCondition = false;
	}else{
		needVSR2StatusCondition = globalConditionForVSR2;
	}
	if(isWtyIntegration){
		needVSR2StatusCondition = userSelectedStatus == "ST035" || userSelectedStatus == "ST040";
		
		if(_l.u.c == 'C310'){
			if(userSelectedStatus == "ST040" && $("SERVICE_TYPE").value =="IS"){
				needVSR2StatusCondition = false;
			}
		}
	}
	
	if(_l.isVSR2Check && needVSR2StatusCondition){
		if(type=='VERIFIED'){
			//verified 했고(isVerified: true), 결과 popup 에서 repairCompleted, Goods Deliverd 클릭시
			//VERIFY_FLAG : blank 로 호출 바로 저장
			$('detailForm').VERIFY_FLAG.value = "";
			$('detailForm').WARNING_SKIP.value = "X";
		}else{
			//Verified 하지 않았으면,
			//VERIFY_FLAG : X 로 호출
			$('detailForm').VERIFY_FLAG.value = "X";
		}//EHN : VSR2 적용안된체 수리완료된건(수리완료일<=VSR2적용일-1)은 ST040 시에 체크없이 오토워런티 되도록한다.
		//ST040 치는 경우.
		if(statusChanged && userSelectedStatus == "ST040"){
			//VSR2 적용안된체 수리완료된건(수리완료일<=VSR2적용일-1)
			if(checkFromToDate(_l.REPAIR_COMP_DATE, _l.VSR2_SKIP_MAX_DATE, _l.u.DateFormat2)){
				$('detailForm').VERIFY_FLAG.value = "";
			}
			$('detailForm').WARNING_SKIP.value = "X";
		}
	}else{//if(_l.isVSR2Check && needVSR2StatusCondition){
		//ST035/40 외에는 verify 안해야함.
		$('detailForm').VERIFY_FLAG.value = "";
		
		if ((_l.u.c == 'C310' && _l.IN_OUT_WTY == 'OW' && userSelectedStatus == "ST040")
			|| (_l.u.c == 'C330' && _l.IN_OUT_WTY == 'OW' && userSelectedStatus == "ST035")) {
			if (!confirm(_l.u.WEB_MSG_PREFIX +'This product is out of warranty and will not be processed for payment. Do you still want to continue?')){
				$('progressloading').stopWaiting();
				return;
			}
			$('detailForm').WARNING_SKIP.value = "X";
		}
	}
	
	/** U01 Start : 2017.10.25 정성균 중국 Collection Point SO 접수 : CP SO 구분 변수 세팅 **/
	if (_l.u.isChinaRegion && _l.CurrStatus != $j("#STATUS").val() && $j("#STATUS").val() == "ST035" && isCPSo) {
    	$j("#ISCPSOCN").val("Y");
    }
	/** U01 End  : 2017.10.25 정성균 중국 Collection Point SO 접수 : CP SO 구분 변수 세팅 **/
		
	$('progressloading').startWaiting();
	//EHN03 2017.08.22  pcs73.park 마스터화된 체크로직 RFC 사용하는 CMD 호출 - 시작	
	//$('detailForm').cmd.value = 'ZifGspnSvcModifyLMCmd';
	$('detailForm').cmd.value = 'ZifGspnSvcModifyLmEHNCmd';
	//EHN03 2017.08.22  pcs73.park 마스터화된 체크로직 RFC 사용하는 CMD 호출 - 종료

	AjaxRequest(urlPatternGZIP, 'detailForm', setResultMessage);

	if (billing_popup != null)
		billing_popup.close();// billing_popup window.close()
	if (saw_popup != null)
		saw_popup.close();// saw_popup window.close()
	
	$j('#divErrorInfo').hide();
	$j('#divWtyNoticeInfo').hide();
	$j('#divBlock').hide();	
}

function setResultMessage(response) {
	$('progressloading').stopWaiting();
	try {
		var jsonObj = eval('(' + response.responseText + ')');
		if (jsonObj.returncode && jsonObj.returncode == "L") {
			// L : check double job
			return;
		}
		
		// PBA 비정상 교체 에러 메세지 처리 2015.09.11 jiw
		if(jsonObj.returncode && jsonObj.message.indexOf('PBA:F') > 0){
			alert(_l.u.SAP_MSG_PREFIX + "[PBA:F]"+ _l.r.m.CHK_PBA_ABNORMAL);
			return;
		}
		
		// OCTA 비정상/Warning 메세지 처리 2017.07.21 jiw 
		if(jsonObj.returncode && jsonObj.message.indexOf('OCTA:F') > 0){
			alert(_l.u.SAP_MSG_PREFIX + "[OCTA:F]"+_l.r.m.CHK_OCTA_ABNORMAL);
			return;
		}
		
		if(jsonObj.returncode && jsonObj.message.indexOf('QR:F') > 0) {
			fenrirSavePopup();
			return;
		}
			
		if (jsonObj.error) {
			cfExceptionPop(jsonObj);
		}

		var currSvcType = _l.SERVICE_TYPE;
		if (jsonObj.returncode && jsonObj.returncode == "W") { // warranty
																// Create Error
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0160);
			$('wty_err_flag').value = "W";
			callDetail();
			return;
		}else if(jsonObj.returncode && jsonObj.returncode == "V"){
			if(isWtyIntegration){
				resultVSRNew(jsonObj, $('STATUS').value, jsonObj.message, "V");
			}else{
				resultVSR(jsonObj, $('STATUS').value);
			}
			
			return;
		}else if(jsonObj.returncode && jsonObj.returncode == "C"){
			confirmSave(jsonObj, "WARNING_SKIP");
			return;
		}
		
		if (jsonObj.success) {
			
			//var successAlertMsg = _l.r.m.COMP_SAVE + "\n" + jsonObj.message;
			var successAlertMsg = jsonObj.message;
			
			if(_l.u.c == 'C370' || _l.u.c == 'C310'){
				if(_l.isVSR2Check){
					if(showListCount > 0){
						successAlertMsg = "Successfully Saved. Review Warranty Errors.";
					}else{
						successAlertMsg = "Successfully Updated and Saved";
					}
				}
			}
			
			var SERVICE_TYPE = $("SERVICE_TYPE").value;
			
			// PBA 정상 교체 메세지 처리 2015.09.11 jiw
			// OCTA 비정상/Warning 메세지 처리 2017.07.21 jiw 
			if(jsonObj.message.indexOf('PBA:S') > 0){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_PBA_NORMAL);
			}else if(jsonObj.message.indexOf('OCTA:W') > 0){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_OCTA_WARNING);
			}else if(jsonObj.message.indexOf('OCTA:E') > 0){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_OCTA_WARNING_E);
			}else if(jsonObj.message.indexOf('OCTA:P') > 0){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_OCTA_WARNING_P);
			}
			
			if ("C1X0" == _l.u.c) {
				if ("ST015" == $('STATUS').value) {// Acknowledged
					successAlertMsg += "\n" + _l.r.m.EXT_0253;
				}
			}// if("C1X0".equals(userVO.getCorpCode())){%>

		
			// Repair Escalation Process
			if (currSvcType != SERVICE_TYPE && SERVICE_TYPE == 'SH' && $('ESCAL_ASC').value != "") {// Service
																									// Handling

				if(jsonObj.returnEscalObjectID)  
				successAlertMsg += " " + jsonObj.returnEscalObjectID;
			}
			if (_l.u.c == "C4A0" && $j('#SUB_SVC_TYPE2').val()=="ES" && SERVICE_TYPE == 'CI' && $('ESCAL_ASC').value != "") {// Service
																																// Handling

				if(jsonObj.returnEscalObjectID)  
				successAlertMsg += " " + jsonObj.returnEscalObjectID;
			} 
			
			// =================================================================================//
			// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
			// Activation
			// 수정일 : 2015.04.28
			// 수정자 : 채보람 (로젠 솔루션)
			// 내 용 : _l.bosAttachFlag == "Y" 일 경우 BOS 삭제 펑션 실행
			if((_l.isIndia || _l.isBangladesh || _l.isSrilanka || _l.isNepal) && _l.isHHPIndia){
				// 첨부된 BOS 파일을 삭제 했을경우 _l.bosAttachFlag == "Y"
				if(_l.bosAttachFlag == "Y" && $j("#PRODUCT_FLAG").val() == "X"){
					initDeleteBOS();
				}
			}
			// =================================================================================//
			
			//=================================================================================//
			//제  목 : 인도 Demand OTP link with GSPN
			//수정일 : 2015.09.15
			//수정자 : 채보람 (로젠 솔루션)
			//내  용 : Status 가 Engineer Assigned, Pending 일 경우 OTP SMS 전송을 한다.
			if(_l.isIndia){
				if(($j("#STATUS").val() == "ST025" ||
					$j("#STATUS").val() == "ST030")&&
					_l.countOTP == 0			   &&
					isOTPShowSVCType()){
					
					if($j('#SERVICE_TYPE').val() == "SR" && _l.countOTP == 0){
						sendOTP();
					}
					
					if(_l.eligibleOTPFlag && !_l.initOTPCheckFlag){
						sendOTP();
					}
				}
			}
			//=================================================================================//
			
			// Save Medison Remark 08.04
			// HME user role 화면 2015.04.17 jiw
			// "C1X0" == _l.u.c 추가 2015.05.15 JIW
			if("C1X0" == _l.u.c || isHmeUser)
				saveMedRemark();
			
			if(isWtyIntegration){
				
        		if(jsonObj.EtVsr2ErrInfo.length > 0){
        			if("ST015,ST025,ST030".indexOf($('STATUS').value) != -1){
        				$j('#divErrorInfo').hide();
        				$j('#divWtyNoticeInfo').hide();
        				$j('#divConfirmNotice').hide();
        				$j('#divBlock').hide();
    					resultVSRNew(jsonObj, $('STATUS').value, successAlertMsg, "S");
    				}else{
    					alert(successAlertMsg);
    				}
        		}else{
        			alert(successAlertMsg);
        		}
			}else{
				alert(successAlertMsg);
			}
			
			/** U01 Start : 2017.10.20 정성균 중국 Collection Point SO 접수 : 배송 신청 여부 메시지 처리 **/
			if (_l.u.isChinaRegion && _l.CurrStatus != $j("#STATUS").val() && $j("#STATUS").val() == "ST035"  &&  isCPSo) {
	        	if (jsonObj.cpFuncEvRetCode == "S") {
	        		if (jsonObj.cpMailNo != undefined && jsonObj.cpMailNo != null && jsonObj.cpMailNo != "") {
		        		alert(jsonObj.systemFlag + " : 物流指令发送成功\n" + jsonObj.cpMailNo);
	        		} else {
	        			alert(jsonObj.systemFlag + " : 物流指令发送失败\n" + jsonObj.cpMsg + "\n请联系ASC运营担当");
	        		}
	        	} else {
	        		alert(jsonObj.systemFlag + " : 物流指令" + jsonObj.cpMsg);
	        	}
	        }
	    	/** U01 End  : 2017.10.20 정성균 중국 Collection Point SO 접수 : 배송 신청 여부 메시지 처리 **/
			
			
			if (_l.u.c == "C550"){
				// callRefreshSTB(_l.ObjectId);
			}
			
            // Start -- India Demand . 2017/05/30. j.peter.kim
            if ("C550" == _l.u.c && "IN" == _l.u.CountryCd) {
                // send push message
                checkPushForIndia();
            }   
            // India -- India Demand . 2017/05/30. j.peter.kim 	
            
            if(_l.isUseNewUPC && (_l.CurrStatus == "ST025" || _l.CurrStatus == "ST030") && $j("#STATUS").val() == "ST035"){
            	getUsedPartsCheck(true);
            	if(_l.isUseFeedback && _l.CurrStatus != "ST035" && $j("#STATUS").val() == "ST035"){
                	showFeedBack();
                }else{
                	callDetail();
                }
            }else{
            	
            	if(isWtyIntegration && jsonObj.EtVsr2ErrInfo.length > 0 && "ST015,ST025,ST030".indexOf($('STATUS').value) != -1){
            		
    			}else{
    				if(_l.isUseFeedback && _l.CurrStatus != "ST035" && $j("#STATUS").val() == "ST035"){
                    	showFeedBack();
                    }else{
                    	callDetail();
                    }
    			}            	
            }
			return;
		} else {
			if(jsonObj.SKIP_SAVE) {
				$('detailForm').GD_SKIPSAVE.value="Y";
			}
			
			if(jsonObj.returncode && jsonObj.returncode == "GD") {
				if(_l.blockSkipGD) {
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0573);
					runDiagnostic("OQC");
					return;
				} else {					
					if(!confirm(_l.u.WEB_MSG_PREFIX +_l.r.m.EXT_0358)) {
						gdBypassPopup("");
					} else {
						runDiagnostic("OQC");
					}            
					return;
				}
	        } else if (jsonObj.returncode && jsonObj.returncode == "GDALLPASS") {
	            alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0368);
	            return;
	        }else if(jsonObj.returncode && jsonObj.returncode == "IQCBYPASS"){
	        	if(!confirm(_l.u.WEB_MSG_PREFIX +_l.r.m.EXT_0500)) {
	                gdBypassPopup("UI");
	            } else {
	                runDiagnostic("IQC");
	            }
	            return; 
	        }else if(jsonObj.returncode && jsonObj.returncode == "IQCMAND"){
	        	alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0376);
	        	runDiagnostic("IQC");
	        	return;
	        }else if(jsonObj.returncode && jsonObj.returncode == "GDCHKERR"){
	        	alert( jsonObj.message);
	        	return;
	        }			
			
			//중국 안탐, useGMESHHPByIMEI 는 인도만 사용.
			if (_l.useGMESHHPByIMEI) {
				if (_l.CurrStatus == "ST040" || _l.CurrStatus == "ST035") {
					$('detailForm').WTY_EXCEPTION.disabled = true;
				}
			}
			if($('detailForm').SHIP_METHOD != undefined){
				if(_l.shipMethodMod == "X"){
					$('detailForm').SHIP_METHOD.disabled = false;
				}else{
					$('detailForm').SHIP_METHOD.disabled = true;
				}
			}
		
			var errorMessage = "";
			if (jsonObj.message) {

				errorMessage += "\n" + jsonObj.message;

			}
			if(jsonObj.errorMessage){
				errorMessage += "\n" + jsonObj.errorMessage;

			}			

			if(errorMessage == "") {

				errorMessage = _l.r.m.FAIL;

			}
			
			//EHN13 2017.09.20 pcs73.park 다국어 메세지 추가.
			if(jsonObj.returncode != 9) {			
        		
				//exception 난 경우.
				if (jsonObj.error) {
					alert(_l.u.WEB_MSG_PREFIX + errorMessage);
				}else{
	        		//EHN13    2017.09.20  pcs73.park : 다국어 메세지 추가.
	        		//webMsgCode 없는경우 : 웹의 체크로직 마스터화되지 않은경우
	        		if(jsonObj.webMsgCode == '' || jsonObj.webMsgCode == undefined){
	    				var returnSAPMessage = replaceAll(jsonObj.message, '\\r\\n', '\n');
	        			alert(returnSAPMessage);
	        		}else{
	        			var alertMsg = _l.r.m[jsonObj.webMsgCode];
		        		//alertMsg 없는경우 : _l.r.m 으로 정의가안된경우.
	        			if(alertMsg == undefined){
	        				alert(jsonObj.message);	
	        			}else{
	        				alert("[" + jsonObj.checkLogicErrorCode + "] " + alertMsg);//[DC001]Please Input the Unit Received Date	
	        			}
	        			
	        			
	        			for (var i = 0; i < jsonObj.EtErrInfo.length; i++) {	        	        	
        	        		jsonObj.EtErrInfo[i].ERR_MSG = alertMsg;
	        			}	        			
	        			
	        		}     
	        		
	        		
	        		/*EHN12 SVC_MODIFY_L_M_V2 SAP 에서 체크된후 별도 스크립트가 필요한 경우.*/
	        		doPostActionForCheckLogic(jsonObj.checkLogicCode);
				}
			}
						
			if(
				((_l.u.c.indexOf("C4") > -1 && _l.u.c != "C4C0") || _l.u.c == "C981" || _l.u.c == "C983")
				&& errorMessage == "Complete date is earler than Last appointment date."
			)
			{

				$j("#serviceDateTD1_LAST_APP,#serviceDateTD2_LAST_APP").show();
				var tempHtml = "<input name=\"LAST_APP_DATE_DY_STT\" id=\"LAST_APP_DATE_DY_STT\" type=\"text\" class=\"inputIDS\" style=\"width:64; text-align: center\" onClick=\"javascript:showCal(this);\" onChange=\"javascript:checkValidDate(this);\" value=\""+$j("#LAST_APP_DATE").val()+"\">";
				tempHtml += " <input name=\"LAST_APP_TIME_DY_STT\" id=\"LAST_APP_TIME_DY_STT\"  onblur=\"timeCheck(this)\" type=\"text\" class=\"inputIDS\" style=\"width:49; text-align: center\" value=\""+$j("#LAST_APP_TIME").val()+"\">";
				tempHtml += " <img src=\"/img/ico_time.gif\" onClick=\"setCurrentDateTime_AppDt('LAST_APP_DATE_DY_STT','LAST_APP_TIME_DY_STT');\" style=cursor:hand; width=\"13\" height=\"12\" align=\"absmiddle\">";
				tempHtml += " &nbsp;&nbsp; Repair Complete : " + _l.REPAIR_COMP_DATE + " " + _l.REPAIR_COMP_TIME;
				$('serviceDateTD2_LAST_APP').colSpan = "3";
				$('serviceDateTD2_LAST_APP').innerHTML = tempHtml;
			}			
			
			/**
			 * if this same Service Order already have modified by another,
			 * refresh SO
			 */
			if (jsonObj.alreadyModified) {
				callDetail();
			}

			var length = jsonObj.EtErrInfo.length;
			$('errTable').show();
			$j('#errBody').empty();
			for ( var i = 0; i < length; i++) {
				makeErrList(jsonObj.EtErrInfo[i].ERR_TYPE,
						jsonObj.EtErrInfo[i].ERR_CODE,
						jsonObj.EtErrInfo[i].ERR_MSG);
			}
			document.location.href = "#top";
			
			if(jsonObj.returncode == 9) {
				//return code=9 지만 GD관련 에러가 아닌경우 메세지 출력토록함.
				if(jsonObj.EtErrInfo == undefined || jsonObj.EtErrInfo.length == 0){
					alert(errorMessage);
				    return;
				}
				if(jsonObj.EtErrInfo[0].ERR_TYPE == "3") {         
					alert(jsonObj.EtErrInfo[0].ERR_MSG);
					runDiagnostic("IQC");
					return;
				} else if(jsonObj.EtErrInfo[0].ERR_TYPE == "2" || jsonObj.EtErrInfo[0].ERR_TYPE == "B") {
					alert(jsonObj.EtErrInfo[0].ERR_MSG);
					return;
				} else if(jsonObj.EtErrInfo[0].ERR_TYPE == "7") {
					if($('STATUS').value == "ST035") {
						setGDBypassReason("S10006");
						return;
					} else {      
						if(!confirm(_l.u.WEB_MSG_PREFIX +_l.r.m.EXT_0500)) {
							gdBypassPopup("UI");
						} else {
							runDiagnostic("IQC");
						}            
						return;
					}
				} else if(jsonObj.EtErrInfo[0].ERR_TYPE == "5") {
					// All pass
					alert(jsonObj.EtErrInfo[0].ERR_MSG);
		            return;
				} else if(jsonObj.EtErrInfo[0].ERR_TYPE == "8" || jsonObj.EtErrInfo[0].ERR_TYPE == "A") {
					if(_l.blockSkipGD) {
						alert(jsonObj.EtErrInfo[0].ERR_MSG);
						runDiagnostic("OQC");
						return;
					} else {					
						if(!confirm(_l.u.WEB_MSG_PREFIX +_l.r.m.EXT_0358)) {
							gdBypassPopup("");
						} else {
							runDiagnostic("OQC");
						}            
						return;
					}
				} else if(jsonObj.EtErrInfo[0].ERR_TYPE == "R") {
					alert(jsonObj.EtErrInfo[0].ERR_MSG);
					if(_l.blockSkipGD) {
						alert(jsonObj.EtErrInfo[0].ERR_MSG);
						runDiagnostic("OQC");
						return;
					} else {					
						if(!confirm(_l.u.WEB_MSG_PREFIX +_l.r.m.EXT_0358)) {
							gdBypassPopup("");
						} else {
							runDiagnostic("OQC");
						}            
						return;
					}
				} else {
					alert(errorMessage);
					return;
				}
		   }
		}
	} catch (e) {
	} finally	{		
		if(_l.useDynatrace) {
			dynaTrace.leaveAction(dtAction);
		}		
		$('progressloading').stopWaiting();
	}
}

