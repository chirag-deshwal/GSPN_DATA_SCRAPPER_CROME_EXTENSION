	function checkDescSpecialChar(obj, lable) {
		var notAllowed = "<>";
		if (containsChars(obj, notAllowed)) {
			alert(_l.u.WEB_MSG_PREFIX + "[" + lable + "] Not Allowed '<' and '>'");
			obj.focus();
			return true;
		}
		return false;
	}
	// 아래 특수문자 체크로직은 중국도 동일하게 사용함.
	// Input Parameter 에 '<>' 특수문자 제어
	if (checkDescSpecialChar($('REPAIR_DESC'), _l.r.c.LBL_00664)) {
		return;
	}
	if (checkDescSpecialChar($('DEFECT_DESC'), _l.r.c.LBL_00229)) {
		return;
	}
	if (checkDescSpecialChar($('REMARK'), _l.r.c.LBL_00657)) {
		return;
	}
	if (checkDescSpecialChar($('ACCESSORY'), _l.r.c.LBL_00025)) {
		return;
	}
	//중국은 아래로직이 없지만, 타도록 그대로 둠.
	if (checkDescSpecialChar($('STATUS_COMMENT'), _l.r.c.LBL_00805)) {
		return;
	}
	
