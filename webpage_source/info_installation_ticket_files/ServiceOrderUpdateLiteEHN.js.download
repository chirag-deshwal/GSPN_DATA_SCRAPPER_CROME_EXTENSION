			product = getHQSvcProdAsync();
		}
		if (_l.isHHPAccesoryCheckCorp && product 
				&& ('THB98,THB99,THBZ1,THBZ2,THBZ3,THBZ4,THBZ5'.indexOf(product) > -1)) {
