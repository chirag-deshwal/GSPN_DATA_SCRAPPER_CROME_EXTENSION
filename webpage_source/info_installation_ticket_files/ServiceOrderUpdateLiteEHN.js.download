		if ($("FIRST_APP_DATE").value == "" || $("FIRST_APP_DATE").value == "00.00.0000") {
			alert(_l.r.m.MAND_XVALUE_00064);
			return;
		}
	}
	 */

	if ((_l.u.c == 'C310' || _l.u.c == 'C370') && $j("#partsTableBody input[name='PARTS_CODE']").length > 0 && serviceType == "PF") {
