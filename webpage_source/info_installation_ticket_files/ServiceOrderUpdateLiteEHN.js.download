/**
 * 
 * @param parts
 * @param seq
 * @param qty
 * @param partWty
 * @param thisObj
 * @param idx : 몇번째 자재인지 숫자, 0 부터 시작, china : 중국머지치 추가됨
 * @param savedSerial : 티겟에저장되어 있던 자재시리얼.
 */
function openPostingGI(parts, seq, qty, partWty, thisObj, idx, savedSerial) {
	// LCD Serial number check logic should work ONLY when part GI is done. only
	// For C550.requested by Akhil, Navneet.
	if (!isSerialNumberValid()) {//china : 인도만 타므로, 주국은 안캄. 중극 안타야 하므로 정상.
		return;
	}
	
	// 2016.02.19 jiw
	
	if(_l.u.c == 'C560' && _l.u.ConsignmentStockAsc && partWty == "O" && !_l.sawExistRLISubPayment){
		alert(_l.u.WEB_MSG_PREFIX + "SAW RLI(FDS) SUB PAYMENT is not yet approved.");
		return;
	}
	
	if (_l.u.c == 'C550') {
		if(qty > 1){
			if((parts.substring(0, 4) == "GH82" || parts.substring(0, 4) == "GH97")){
				alert(_l.u.WEB_MSG_PREFIX + "Please check and change the part QTY before G/I");
				return;
			}else{
				if(!confirm(_l.u.WEB_MSG_PREFIX +"Part QTY Entered is more than 1. Please Reconfirm the Quantity!")){
					return;
				}
			}
		}
		if(partWty == "O" ){
			if(!confirm(_l.u.WEB_MSG_PREFIX +"Part Term is OUT, Do you want to Proceed?")){
				return;
			}
		}
		if($('MIF_REPAIR').value == "Y"){
			if(!confirm(_l.u.WEB_MSG_PREFIX +"It is mandatory to do IMEI writing before click on GI, Did you complete IMEI writing? (In case of IMEI writing is missing this SO will be considered as Abnormal and Samsung PIC may contact for verification).")){
				return;
			}
		}
	}
	//북미통합2015 invoice no input check
	if(_l.isSEAInteUser && ("C370" == _l.u.c || "C310" == _l.u.c) && _l.usePartInvoiceNoEntry && !_l.isPassInvoiceCheck){
		var btnIdx = $j("#partsTableBody [name=INVOICE_NO]").index($j(thisObj).parent().parent().find("[name=INVOICE_NO]"));
		var invoiceNo = $j("#partsTableBody input[name='INVOICE_NO']").eq(btnIdx).val();
		
		if($j.trim(invoiceNo) == ""){
			alert(_l.u.WEB_MSG_PREFIX + "Input Invoice No");
			$j("#partsTableBody input[name='INVOICE_NO']").eq(btnIdx).focus();
			return;
		}
		var url = urlPatternGZIP;
		var data = "cmd=InvoiceValidCheckCmd&IM_NUMBER=" + invoiceNo + "&IV_PARTS_CODE="+ parts + "&IV_ASC_CODE="
				+ _l.ASC_CODE + "&IV_ENGINEER=" + _l.ENGINEER + "&IV_OBJECT_ID=" + _l.ObjectId;
		var result = true;
		$j.ajax({
			type : "POST",
			async : false, /* 동기 */
			url : url,
			data : data,
			success : function(data) {
				if (data.eV_RET_CODE != "0") {					
					// 정보가 없음
					if(data.eV_RET_MSG != "") alert(_l.u.WEB_MSG_PREFIX + "Invoice number("+invoiceNo+") is not matched parts code("+parts+") \n" + data.eV_RET_MSG);
					$j("#partsTableBody input[name='INVOICE_NO']").eq(btnIdx).val("").focus();
					result = false;
				}
			},
			dataType : 'json'
		});
		if(!result) return;
	}
	
	if (_l.u.isChinaRegion){
		//서비스 타입이 RH인 서비스 오더에 자재 G/I Posting  불가하게 조치 requested by SunEnji 2016.12.20
		if(_l.SERVICE_TYPE == "RH"){
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0586/*RH Service Type is not possible to post GI but delete parts*/);
			return;
		}
		if(checkEngineerForRepairParts()==false) return;
		var partsTableBody = $j('#partsTableBody'); 
		var inputSerial = partsTableBody.find('input[name="SERIAL_MAT"]').eq(idx).val();
		if(savedSerial != inputSerial){
			alert(_l.u.WEB_MSG_PREFIX + 'parts serial should be saved.');
			return;
		}
		//china : 중국은 사용자가 입력한 수량이지만 아직 저장안한 수량으로 GI posting 을 하려고핟낟.
		//사용자가 저장안할수도 있다. 그러므로 이건 적절치 못하다.
		//글로벌처럼 이미 저장된 수량을 사용한다.
		//var inputQty = partsTableBody.find('input[name="PARTS_QTY"]').eq(idx).val();
		var inputQty = qty;
		var ASC_CODE = $j("#ASC_CODE").val();
		if((ASC_CODE == '0003452393' || ASC_CODE =='3452393') && _l.IN_OUT_WTY == "OW"){
			   if(!checkBOM_model_part(parts, inputQty)){
				   return;
			    } 
		}
		
		$j('[name=gi_imei]').remove();
		$j('<input type=hidden name=gi_imei value="'+savedSerial+'" />').appendTo('#tempForm');
	}
	
	var w = window
			.open(
					"",
					"posting_popup",
					'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=700,height=250');
	w.focus();
	var url = "/svctracking/svcorder/SVCPopGiPosting.jsp";
	$('tempForm').gi_postingFlag.value = "Y";
	$('tempForm').gi_material.value = parts;
	$('tempForm').gi_qty.value = qty;
	$('tempForm').gi_seq_no.value = seq;
	$('tempForm').gi_engineer.value = $j("#ENGINEER").val();
	$('tempForm').gi_engineer_nm.value = $j("#ENGINEERNAME").html();
	$('tempForm').gi_partWty.value = partWty;
	$('tempForm').autoDo.value = _l.usePartInvoiceNoAuto && _l.isCompensationAsc ? "Y" : "";
	$('tempForm').action = url;
	$('tempForm').target = 'posting_popup';
	$('tempForm').submit();
}

/**
 * 
 * @param parts
 * @param seq
 * @param qty
 * @param mblnr
 * @param mjahr
 * @param serial : 중국만 사용하는 필드로써 추가됨.
 */
function openCancelGI(parts, seq, qty, mblnr, mjahr, serial) {

	//china : 중국은 아래 로직 없음, 즉 빌링과 무관하게 GI 취소가능. GI버튼은 워런티만 안되면 가능함.
	//gi_imei 는 중국만 사용.
	if(_l.u.isChinaRegion){
		$j('[name=gi_imei]').remove();
		$j('<input type=hidden name=gi_imei value="'+serial+'" />').appendTo('#tempForm');
	}else{
		if (_l.isBillingSaved) {
			alert(_l.u.WEB_MSG_PREFIX + "You can not cancel GI when billing data exists");
			return;
		}
	}
	
	w = window
			.open(
					"",
					"posting_popup",
					'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=700,height=250');
	w.focus();
	var url = "/svctracking/svcorder/SVCPopGiPosting.jsp";
	$('tempForm').gi_postingFlag.value = "N";
	$('tempForm').gi_material.value = parts;
	$('tempForm').gi_qty.value = qty;
	$('tempForm').gi_seq_no.value = seq;
	$('tempForm').gi_engineer.value = _l.ENGINEER;
	
	$('tempForm').MBLNR.value = mblnr;
	$('tempForm').MJAHR.value = mjahr;
	$('tempForm').autoDo.value = _l.usePartInvoiceNoAuto && _l.isCompensationAsc ? "Y" : "";
	
	$('tempForm').action = url;
	$('tempForm').target = 'posting_popup';
	$('tempForm').submit();
}

function isSerialNumberValid() {
	var isValid = true; // true
	if (_l.u.c != 'C550') {
		return isValid;
	}
	var product = $('SVC_PRCD').value;
	var validProductCode = false;
	if (_l.u.c == 'C550') {
		validProductCode = product.substring(0, 3) == "CTV";
	}else if (_l.u.c == 'C310') {
		validProductCode = product.substring(0, 3) == "CTV";
	}else{
		var productCodePossibleEntry = ["CTV","DTV","HTV","LED","LFD","LTV","MON","MOT","MST","OLM","PDM","PDP","TFT"];
		if(product != "" && product.length > 2){
			for (var i = 0; i < productCodePossibleEntry.length; i++) {			
				if(product.substring(0,3) == productCodePossibleEntry[i]){
					validProductCode = true;
					break;
				}
			}
		}
		if(!validProductCode){
			var hqProduct = $('HQ_SVC_PRCD').value;
			if(hqProduct == ""){
				hqProduct = getHQSvcProdAsync();
			}
			if(hqProduct != "" && hqProduct.length > 2){
				for (var i = 0; i < productCodePossibleEntry.length; i++) {			
					if(hqProduct.substring(0,3) == productCodePossibleEntry[i]){
						validProductCode = true;
						break;
					}
				}
			}
		}
	}
	
	
	var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
	var partSerials = $j('#partsTableBody input[name="SERIAL_MAT"]');
	var partDesc = $j('#partsTableBody input[name="PARTS_DESC"]');
	var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
	
	if(validProductCode){
		for ( var i = 0; i < partCodes.length; i++) {
			var partSerial = $j.trim($j(partSerials[i]).val());
			var partCode = $j.trim($j(partCodes[i]).val());

			// If Part number first four digit is BN07
			// then Part Serial Number is mandatory
			// Parts Serial No length = 23 or 25
			// Parts first two digit must be alphabet
			var option1 = false;
			if (_l.u.c == 'C550' || _l.u.c == 'C830'){
				if(partCode.substring(0, 4) == "BN07"){
					option1 = true; 
				}
			}else{
				if ( partCode.substring(0, 4) == "BN07" || partCode.substring(0, 4) == "BN94" || partCode.substring(0, 4) == "BN91" || partCode.substring(0, 4) == "BN44"){
					option1 = true;
				}
			}
			
			// If Parts Number starts with BN95 or BN96 and ASSY PDP MODULE &
			// PRODUCT LCD TEXT in Parts Description
			// then Part Serial Number is mandatory
			// Parts Serial No length = 25 (Refer #3)
			// Parts first two digit must be alphabet (Refer #4),
			
			var option2 = false;
			if(_l.u.c == 'C550'){
				if((partCode.substring(0, 4) == "BN95" || partCode.substring(0, 4) == "BN96")
						&& (($j.trim($j(partDesc[i]).val()).indexOf('ASSY PDP MODULE') >= 0) || ($j
								.trim($j(partDesc[i]).val()).indexOf('PRODUCT LCD') >= 0))){
					option2 = true;
				}
			}else{
				if((partCode.substring(0, 4) == "BN96" && ($j(partDesc[i] ).val().indexOf('ASSY PDP MODULE P') >= 0 || $j(partDesc[i]).val().indexOf('PCB P-MAIN') >= 0 || $j(partDesc[i]).val().indexOf('ASSY PDP P-PANEL') >= 0))
						|| ((partCode.substring(0, 4) == "BN95" || partCode.substring(0, 4) == "BN96") && $j(partDesc[i] ).val().indexOf('PRODUCT LCD') >= 0 )){
					option2 = true;
				}
			}
			if (option1 || option2) {

				if (partSerial == '') {
					isValid = false;
					alert(_l.u.WEB_MSG_PREFIX + 'parts Serial number field is mandatory');
					break;
				}

				if (!(partSerial.length == 23 || partSerial.length == 25)) {
					isValid = false;
					alert(_l.u.WEB_MSG_PREFIX + 'Parts serial number length must be 23 or 25.');
					break;
				}
				// var chars =
				// "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";

				if (containsCharsOnlyByValue(partSerial.charAt(0), chars)
						|| containsCharsOnlyByValue(partSerial.charAt(1), chars)) {
					isValid = false;
					alert(_l.u.WEB_MSG_PREFIX + 'Parts serial number first two digit must be alphabet');
					break;
				}
			}
		}
	}
	
	return isValid;
}

/**
 * 
 * @param val : part seq
 * @param obj : this
 * @param code : part code
 * china : 중국은 cnd 변수는 자재중 몇번째 인지를 파라미터로 던지나, 실제 로직에서는 사용하지 않으므로, 여기서 추가하지 않음.
 */
function deleteParts(val, obj, code) { 
	var cnt = $j('#partsTableBody').find($j('[name=partsDeleteBtn]')).index($j(obj));	 
	var tbodyObj = $('partsTableBody');
	var strMessage;
	var usingParts = false;
	//china : 중국에서 사용하는 requestedParts 변수는 글로벌의 usingParts 과 같은 기능이므로 머지 안함.
	//var requestedParts = false;//Parts Requested - Inventory
	//val = "" 경우는 신규로 추가할려고 입력한 자재에 대한 삭제 인경우. 
	if (val != "") {		
		//china : 왜 이리 섯을까??? $j("#partsTableBody").find("[name=PARTS_SEQ_NO]"); 이리 써야 하는데.
		//결국 $j("#partsTableBody [name=PARTS_SEQ_NO]")); 이거와 같아짐.  	
		//시간될대 확신을 가지고 수정해서 테스트하고, 보완하자.
		var partsSeqObj = $j("#partsTableBody").find($j("[name=PARTS_SEQ_NO]"));  		
		var requestObj = $j("#partsTableBody").find($j("[name=D_REQUEST_NO]"));
		var soObj = $j("#partsTableBody").find($j("[name=D_SO_NO]"));
		
		for ( var i = 0; i < partsSeqObj.length; i++) {
			if (!requestObj[i])
				break;// D_REQUEST_NO 존재하지 않으면 skip --FSC인 경우
			if (partsSeqObj[i].value == val
					&& (requestObj[i].value != "" || soObj[i].value != "")) {
				usingParts = true;
				break;
			}
		}
	}// if(val != ""){

	if (usingParts) {
		//china : 중국은 if(isMedisonUser){ 므로, 메디슨 유저는 MR or PO 낸 자재는 절대 삭제를 못한다.
		//그러나 글로벌은 가능하다.
		var blockDeletePartForMedisonUser = false;//(false && isMedisonUser)
		if(_l.u.isChinaRegion){
			blockDeletePartForMedisonUser = isMedisonUser; 
		}
		if (blockDeletePartForMedisonUser) {
			alert(_l.u.WEB_MSG_PREFIX + "Cannot be deleted, it has related Document.");
			return;
		} else {
			strMessage = _l.r.m.CF_DELETE_01 + " If you delete parts, the screen will be refreshed.";
		}

	} else {
		strMessage = _l.r.m.CONF_DELETE_PART + " If you delete parts, the screen will be refreshed.";
	}

	if("C550" == _l.u.c && $("STATUS").value == "ST030" && ("HP040|HP041|HP042|HP043|HP045|HP046|HP050|HP051|HP065".indexOf($j('#REASON').val()) != -1)){
		alert(_l.u.WEB_MSG_PREFIX + "You cannot delete the part as status of SO is part pending.");
	}else{
		if (confirm(_l.u.WEB_MSG_PREFIX +strMessage)) {
			if (val != "") {//val = "" 경우는 신규로 추가할려고 입력한 자재에 대한 삭제 인경우. 
				haveToReload = true;
				$('tempForm').IV_PARTS_CODE.value = code;
				$('tempForm').cmd.value = 'ServiceOrderPartsDeleteCmd';
				if(_l.u.c == 'C370'){
					$('tempForm').CicCorpCode.value = _l.u.c;					
				}
				////china : 중국은 콜백이 별도 함수이나, 글로벌은 anonymous 이다. 그러나 로직에는 차이가 없다.
				AjaxRequest(urlPatternGZIP + '?PARTS_SEQ_NO=' + val, 'tempForm',
						function(response) {
							try {
								var jsonObj = eval('(' + response.responseText + ')');
								if (jsonObj.success) {
									alert(_l.u.WEB_MSG_PREFIX + _l.r.m.COMP_SAVE);								
									// tbodyObj.deleteRow(cnt);
									$j(obj.parentElement.parentElement).remove();
									
									//china : 중국은 사용자재 탭만 리로드 하지만, 글로벌은 현재 이기능을 제공하지 않고, 삭제된 자재만 화면에서 제거한다.
									// 자재 삭제시에 parts 정보가 갱신됨으로 s/o 화면 갱신한다. 2018.08.06 
									partsReload();
								} else {
									alert(_l.u.SAP_MSG_PREFIX + jsonObj.message);
								}
							} catch (e) {
							}

						});// AjaxRequest(urlPattern +
							// '?PARTS_SEQ_NO='+val,'tempForm',function(response){
			} else {//신규로 추가할려고 입력한 자재에 대한 삭제 인경우. 
				// tbodyObj.deleteRow(cnt);
				$j(obj.parentElement.parentElement).remove(); 
			}
		}
	}
}

function AddCart(parts) {
	try {
		$('progressloading').startWaiting();
		var params = "cmd=AddCartCmd";
		params += "&part=" + parts;

		new Ajax.Request('/gspn/operate.do', {
			method : 'post',
			parameters : params,
			onComplete : function(response){
				var json = response.responseText.evalJSON();
				if(json.success) {
					alert(_l.u.WEB_MSG_PREFIX + "Success to add cart");
				}else{
					alert(_l.u.WEB_MSG_PREFIX + "Fail to add cart.");
				}
				$('progressloading').stopWaiting();
			}
		});
	} catch (e) {
	}
}

function fscGiPost(parts, seq, qty) {
	
	if (_l.u.isChinaRegion){
		if(checkEngineerForRepairParts()==false) return;
		// C610 ow exception
		var isViodf = $('WTY_EXCEPTION').value == 'VOIDF' && _l.ASC_CODE == "0007396610";
		if(_l.IN_OUT_WTY =="OW" && _l.u.c == "C610" && !isViodf){
			alert(_l.u.WEB_MSG_PREFIX + "Wty term must be LP before GI posting");
			return;
		}
	}

	var engCode = _l.ENGINEER;

	if (engCode == "") {
		alert(_l.u.WEB_MSG_PREFIX + "Please select a engineer!");
		return;
	}

	$('progressloading').startWaiting();
	$('tempForm').gi_material.value = parts;
	$('tempForm').gi_qty.value = qty;
	$('tempForm').gi_seq_no.value = seq;
	$('tempForm').gi_engineer.value = engCode;

	$('tempForm').cmd.value = 'FscGiPostCmd';
	AjaxRequest(urlPatternGZIP, 'tempForm', afterFscGiPost);

	$('progressloading').style.height = self.document.body.scrollHeight;
}

function afterFscGiPost(response) {
	$('progressloading').stopWaiting();
	var jsonR = eval('(' + response.responseText + ')');

	if (jsonR.error) {
		cfExceptionPop(jsonR);
		return;
	}
	if (jsonR.success) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.COMP_SAVE);
		partsReload();
	} else {
		alert(_l.u.SAP_MSG_PREFIX + _l.r.m.FAIL_SAVE + "\n Error. " + jsonR.returnMessage);
	}
}

function fscGiReverse(parts, seq, qty, mblnr, mjahr) {

	if (_l.BILLING_DATE.substr(0, 2) != "00") {
		alert(_l.u.WEB_MSG_PREFIX + "You can not cancel GI when billing data exists");
		return;
	}

	$('progressloading').startWaiting();
	$('tempForm').gi_material.value = parts;
	$('tempForm').gi_qty.value = qty;
	$('tempForm').gi_seq_no.value = seq;
	$('tempForm').MBLNR.value = mblnr;
	$('tempForm').MJAHR.value = mjahr;
	$('tempForm').gi_engineer.value = _l.ENGINEER;

	$('tempForm').cmd.value = 'FscGiReverseCmd';
	AjaxRequest(urlPatternGZIP, 'tempForm', afterFscGiPost);

	$('progressloading').style.height = self.document.body.scrollHeight;
}

var invoiceRowNum = 0;
function getInvoiceList(obj) {
	if (false) {
		
		var oPartNo = $j("#partsTableBody input[name='PARTS_CODE']");// document.getElementsByName("PARTS_CODE");
		var oInvNo = $j("#partsTableBody input[name='INVOICE_NO']");// document.getElementsByName("INVOICE_NO");
		var oInvLineNo = $j("#partsTableBody input[name='INVOICE_ITEM_NO']");// document.getElementsByName("INVOICE_ITEM_NO");
		
		var rowNo = $j("#partsTableBody").find($j("[name=PARTS_QTY]")).index($j(obj));
		invoiceRowNum = rowNo;
		if (oPartNo[rowNo].value == "")
			return;
		$("progressloading").startWaiting();
		$('invoiceForm').INVOICE_NO.value = oInvNo[rowNo].value;
		$('invoiceForm').partNo.value = oPartNo[rowNo].value;
		$('invoiceForm').PARTS_QTY.value = obj.value;
		$('invoiceForm').cmd.value = 'DoBalanceSearchCmd';
		AjaxSyncRequest(urlPatternGZIP, 'invoiceForm',setGridJsonObject);
	}else{
		return;
	}
}

function setGridJsonObject(response) {
	try {
		var jsonObj = response.responseText.evalJSON();

		if (jsonObj.success) {
			setInvoiceNo(jsonObj);
		} else {
			/*
			var objInvoiceNo = document.getElementsByName("INVOICE_NO");
			objInvoiceNo[invoiceRowNum].options.length = 0;
			objInvoiceNo[invoiceRowNum].options[0] = new Option(
					"Not Available", "");
					*/
			alert(_l.u.SAP_MSG_PREFIX + jsonObj.returnMessage);
		}
	} catch (e) {
	}
	$('progressloading').stopWaiting();
}


function setInvoiceNo(jsonObj) {
	if (jsonObj != null) {
/*
		var length = jsonObj.ptDataList.length;

		var objInvoiceNo = document.getElementsByName("INVOICE_NO");
		objInvoiceNo[invoiceRowNum].options.length = length;

		var selectedInvoice = "";
		if (jsonObj.selectedInvoice != null) {
			selectedInvoice = jsonObj.selectedInvoice;
		}
		for ( var i = 0; i < length; i++) {
			var obj = jsonObj.ptDataList[i];
			objInvoiceNo[invoiceRowNum].options[i] = new Option(obj.invoiceNo,
					obj.invoiceNo);
			if (obj.invoiceNo == selectedInvoice) {
				objInvoiceNo[invoiceRowNum].options[i].selected = true;
			}
		}
*/
		
		if(jsonObj.etDoData.length > 0){
			var oPartNo = $j("#partsTableBody input[name='PARTS_CODE']");// document.getElementsByName("PARTS_CODE");
			var oInvNo = $j("#partsTableBody input[name='INVOICE_NO']");// document.getElementsByName("INVOICE_NO");
			var oInvLineNo = $j("#partsTableBody input[name='INVOICE_ITEM_NO']");// document.getElementsByName("INVOICE_ITEM_NO");
			
			oInvNo[invoiceRowNum].value = jsonObj.etDoData[0].VBELN;
			oInvLineNo[invoiceRowNum].value = jsonObj.etDoData[0].POSNR;
			if(_l.typeMAP == "1"){
				$j(document.detailForm.INVOICE_NO[invoiceRowNum+1]).removeClass().addClass("inputRO").prop("readonly", true);
				$j(document.detailForm.PARTS_CODE[invoiceRowNum+1]).removeClass().addClass("inputRO").prop("readonly", true);
				$j(document.detailForm.INVOICE_ITEM_NO[invoiceRowNum+1]).removeClass().addClass("inputRO").prop("readonly", true);
			}else{
				
			}
		}else{
			alert(_l.u.WEB_MSG_PREFIX + "No data found.");
		}
			
	}
}

function openNewClaimPop() {
	var statusCode = _l.currStatus;
	if(_l.isAutoWty){
		if(_l.CurrStatus=='ST040' && !_l.isWtyClaimed){
			checkWtyFlag = 'X';
			$("ONLY_WTY_CREATE").value ='X';
			saveServiceOrder('VERIFIED');
		}else{
			
		}
	}else{
		if (!checkHHPAccesorySAW()) {
			return;
		}
		/* three attachement need for C820, C560(Recall) */
		if (!validAttachment()) {
			return;
		}
		
		// C8 중남미 법인일 경우
		if (isLaUser) {
			if (statusCode == 'ST070') {
				if ($("REP_TYPE").value != 'RH') {
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0098);
					return;
				}
				if (($("SERVICE_TYPE").value == 'CI' || $("SERVICE_TYPE").value == 'PS')
						&& $("LAB_TYPE").value != 'HC') {
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0099);
					return;
				}
				if ($("SERVICE_TYPE").value == 'IH' && $("LAB_TYPE").value != 'HI') {
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0100);
					return;
				}
			}
		}// if(isLaUser){

		// Confrim if OW w'ty will be created. (2011-04-04)
		if (_l.IN_OUT_WTY == 'OW') {
			if (!confirm(_l.u.WEB_MSG_PREFIX +'This product is out of warranty, do you want to continue?'))
				return;
		}
		if (_l.sawPending) { /*
			 * SAW Request 상태인게 있으면 그 SO에 대해서는 워런티 생성하지 못하도록 -
			 * 2010-12-01
			 */
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0036);
			return;
		}
		if (checkWtyData()) {
			var url = "/wty/wtyclaim/NewWarrantyCic.jsp";
			
			if("B" == _l.u.CenterType || (centerType == "ASC" && "B" == jsonCenterTypeObj.ES_BP101.b2B_SVC))
				url = "/wty/wtyclaim/NewWarrantyCicMini.jsp";
			
			var blockDate = _l.createWtBlockDate;
			if (blockDate == "") {
				blockDate = "///";
			}
			parent.checkAccessBlockedURI.put(url, blockDate);
			if (parent.checkAccessBlockedURIMethod(url)) {
				if($('IRIS_REPAIR').disabled){
					$('IRIS_REPAIR').disabled = false;
				}
				if($('REP_TYPE').disabled){
					$('REP_TYPE').disabled = false;
				}
				$('progressloading').startWaiting();
				$('detailForm').action = url;
				$('detailForm').target = '_self';
				$('detailForm').submit();
				var firstMenu = 'Warranty';
				var secondMenu = 'Warranty Claim';
				var getMenu = 'Create New Warranty Claim';
				parent.naviDir(url, firstMenu + ':' + secondMenu + ':'
						+ getMenu);
			}
			
		}// if (checkWtyData()) {
	}
}

function validAttachment() {
	var valid = true;
	var statusCode = $("STATUS").value;
	
	if (_l.u.c == "C820") {/* SEDA */
		var chkStatus = (statusCode == "ST035" || statusCode == "ST040");
		var notChkType = (_l.TR_TYPE == "O" && _l.SERVICE_TYPE == "SR");
		// ASC 8225900 & ServiceType PS => Pass 2015.08.25 jiw
		var notChkCondition = ((_l.ASC_CODE == "8225900" || _l.ASC_CODE == "0008225900") && $("SERVICE_TYPE").value=="PS") || (_l.ASC_CODE == "9383863" || _l.ASC_CODE == "0009383863")
							|| (_l.ASC_CODE == "4208219" || _l.ASC_CODE == "0004208219") || (_l.ASC_CODE == "1738303" || _l.ASC_CODE == "0001738303") || (_l.ASC_CODE == "3464745" || _l.ASC_CODE == "0003464745")
							|| (_l.ASC_CODE == "5773179" || _l.ASC_CODE == "0005773179");

		if (chkStatus && !notChkType && !notChkCondition){
			var at01 = false, at02 = false, at03 = false;
			
			// ATTACH_DOC_TYPE ATT01 ATT02 ATT03 -- mandatory check
			// ATT02(serial number check) 제외요청함으로 true 처리함 2016.05.09 jiw
			checkMIFModelAsync();
			if(isFenrirCheckModel){
				at02 = true;
			}
			var docTypeCode = cfArray($("detailForm").docTypeCode);
			// detailForm
			for ( var i = 0; i < docTypeCode.length; i++) {
				if (docTypeCode[i].value == 'ATT01' || docTypeCode[i].value == 'ATT11') {
					at01 = true;
				} else if (docTypeCode[i].value == 'ATT02') {
					at02 = true;
				} else if (docTypeCode[i].value == 'ATT03') {
					at03 = true;
				}
			}
			if (_l.FSC) {/* FSC */
				if (!at01) {
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_undefine);
					valid = false;
				}
			} else {
				if (!(at01 && at02 && at03)) {
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_undefine);
					valid = false;
				}
			}
		}// if(chkStatus && !notChkType){
	}
	// new att logic for C820 2020.12.16
/*	if (_l.u.c == "C820") { SEDA 
		var chkStatus = (statusCode == "ST035" || statusCode == "ST040");
		var notChkType = (_l.TR_TYPE == "O" && _l.SERVICE_TYPE == "SR");
		if (chkStatus && !notChkType){
			var at01 = false, at02 = false;
			checkMIFModelAsync();
			if(isFenrirCheckModel){
                at01 = true; //(S/N Label)
                at02 = true; //(Proof of Purchase) 
			}
			var docTypeCode = cfArray($("detailForm").docTypeCode);
			// detailForm
			for ( var i = 0; i < docTypeCode.length; i++) {
				if (docTypeCode[i].value == 'ATT01') {
					at01 = true;
				} else if (docTypeCode[i].value == 'ATT02') {
					at02 = true;
				}
			}
			if (!(at01 && at02)) {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_undefine);
				valid = false;
			}
		}// if(chkStatus && !notChkType){
	}*/
	if (_l.u.c == "C560") {/* SEAU */
		var chkStatus = statusCode == "ST035";
		var chkType = $("SERVICE_TYPE").value == "BS";
		var modelInfo = $j("#MODEL").val();
		var chkModel = ("SW65V9WIP/XSA,SW75V9WIP/XSA,SW70SPWIP/XSA,SW80SPWIP/XSA,WA85GWGIP/XSA,WA85GWWIP/XSA".indexOf(modelInfo) != -1);
		if (chkStatus && chkType && chkModel){
			if ($('attachTableBody').rows.length < 3) {
				alert(_l.u.WEB_MSG_PREFIX + "Dear Service Agent,\nPlease be advised that it is mandatory to attach a photo set of the repair work carried out on the following recalled washing machine models:\n"
+"\nSW65V9WIP/XSA, SW75V9WIP/XSA, SW70SPWIP/XSA, SW80SPWIP/XSA, WA85GWGIP/XSA, WA85GWWIP/XSA\n"
+"Rework on the above machines must be completed under the service type BS (Before Service).\n\n"
+"You can upload photos using the Mobile GSPN App or web GSPN\n"
+"If you have problems with submitting photos please contact the warranty team on warranty.seau@samsung.com or 1300 887 660 option 7.");
				if(_l.isBlockWithoutAttach){
					valid = false;
				}else{
					valid = true;
				}
			}
		}
	}
	
	if (isNewChina) {/* CHINA */
		var chkStatus = (statusCode == "ST035" || statusCode == "ST040");
		var emptyPurchaseDate = $("PURCHASE_DATE").value=="" || $("PURCHASE_DATE").value.substring(0,2) == "00";
		if (chkStatus && !emptyPurchaseDate){
			if ($('attachTableBody').rows.length < 1) {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0590);
				if(_l.CIC_PRCD != "HHP"){
					valid = false;
				}
			}
		}
	}
	/*
	if(_l.isEWPModel){
		var docTypeCode = cfArray($("detailForm").docTypeCode);
		var isAttachedATT04 = false;
		for ( var i = 0; i < docTypeCode.length; i++) {
			if (docTypeCode[i].value == 'ATT04') {
				isAttachedATT04 = true;
				break;
			}
		}
		if(!isAttachedATT04){
			if(!confirm(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0651)){
				valid = false;
			}
		}	
	}
	*/

	return valid;
}

function openSvcRequestPrintPopForSRSC() {
	var w = window
			.open(
