/* carrier code group. */
function carrierCodeGroupSearch() {
	$('tempForm').cmd.value = 'CICCodeSearchCmd';
	AjaxRequest(urlPatternGZIP+'?CODE_GROUP=CARRIER','tempForm', setCarrierCodeCombo);
}

function setCarrierCodeCombo(response){
	var jsonObjC = eval('('+response.responseText+')');
	var jcode = "";
	var jtitle = "";

	/** Select 박스 ID */
	var selectObj = $j("#CARRIER");
	selectObj.empty().append("<option value=''>-----------")

	var CARRIER = _l.CARRIER;
	var length = jsonObjC.EtCodeInfo.length;

	for (var i=0; i < length; i++) {
		var obj = jsonObjC.EtCodeInfo[i];
		jcode = obj.CODE_VALUE;
		jtitle = obj.CODE_TEXT;

		if(jcode==CARRIER){
			selectObj.append("<option value=\"" + jcode +"\" selected>" + jtitle)
		}else{
			selectObj.append("<option value=\"" + jcode +"\" >" + jtitle)
		}
	}
}

function getServiceIndicator() {
	$('tempForm').cmd.value = 'IrisInfoCmd';
	$('tempForm').Ctype.value = 'SVC_IND';
	AjaxRequest(urlPatternGZIP, "tempForm", setServiceIndicator);
}

function setServiceIndicator(response){
	try {
		var jsonObj_ind = eval('('+response.responseText+')');

		if (jsonObj_ind.success) {
			if (isQledTvCorp()){
				// OLEDTV 모델일때 SVC_INDICATOR 값 삭제
				$j("#SVC_INDICATOR option").remove();
			}
			var length = jsonObj_ind.dataLists.length;
			var SVC_INDICATOR = _l.SVC_INDICATOR;
			var combo_SVC_INDICATOR = $('SVC_INDICATOR');
			var SELECT_INDICATOR = "22H";
			var modelInfo = $j("#MODEL").val();
			
			for (var i = 0; i < length; i++) {
				var objOption = document.createElement('option');
				objOption.appendChild(document.createTextNode('['+jsonObj_ind.dataLists[i].code+'] ' +jsonObj_ind.dataLists[i].codetx));
				objOption.setAttribute("value", jsonObj_ind.dataLists[i].code);
				objOption.setAttribute("title", jsonObj_ind.dataLists[i].codetx);
				if (objOption.value == SVC_INDICATOR)   objOption.selected = true;
				//START : C20090003013 [SEAU] Sero QLED TV - Warranty labour rate
				//OLEDTV 모델일과 해당 법인이 맞는지 확인하기 위해 호출
				if (isQledTv()){
					if(objOption.value == SELECT_INDICATOR){
						objOption.selected = true;
					}else{
						objOption.disabled = true;	
					}
				}
				//END   : C20090003013 [SEAU] Sero QLED TV - Warranty labour rate
				combo_SVC_INDICATOR.appendChild(objOption);
			}
		} else {
			alert(_l.u.WEB_MSG_PREFIX + 'Fail - getServiceIndicator() ');
		}

	} catch (e) {}
}

//START : C20090003013 [SEAU] Sero QLED TV - Warranty labour rate
//OLEDTV 모델일과 해당 법인이 맞는지 확인하기 위해 호출 [code : QLED_TV_MODEL]
function isQledTv() {
	var flag = false;
	var SELECT_MODEL = $j("#MODEL").val();
	var QledTvModeList = _l.r.c.QLED_TV_MODEL.evalJSON();
	
	for(var i=0; i<QledTvModeList.length; i++){
		if(QledTvModeList[i].description =="Y"){
			if(SELECT_MODEL == QledTvModeList[i].codeId && _l.u.c ==  QledTvModeList[i].corpCd){
					flag = true;
					break;
			}
		}
	}
	return flag;
}
//OLEDTV 법인이 맞는지 확인하기 위해 호출 [code : QLED_TV_MODEL_CORP]
function isQledTvCorp() {
	var flag_corp = false;
	var QledTvCorpList = _l.r.c.QLED_TV_MODEL_CORP.evalJSON();
	
	for(var i=0; i<QledTvCorpList.length; i++){
		if(QledTvCorpList[i].description =="Y"){
			if(_l.u.c == QledTvCorpList[i].codeId){
				flag_corp = true;
				break;
			}
		}
	}
	return flag_corp;
}
//END   : C20090003013 [SEAU] Sero QLED TV - Warranty labour rate

function setCodeListRegion(CountryCd){
	var formObj=$('tempForm');
	formObj.cmd.value = 'CICCodeSearchCmd';
	AjaxRequest(urlPatternGZIP+'?CODE_GROUP=REGION&UPPER_GROUP=COUNTRY&UPPER_VALUE='+CountryCd,"tempForm", getCodeListRegion);
}

function getCodeListRegion(response){
	var jsonCodeObj = eval('('+response.responseText+')');
	var selectObj=$("REGION");
	selectObj.length = 1;
	setCICCode(jsonCodeObj,selectObj);
}

function setCICCode(jsonCodeObj,selectObj, defValue){
	
	if (jsonCodeObj.success) {
		var length = jsonCodeObj.EtCodeInfo.length;
		var bpRegionCode = _l.bpRegionCode;
		for (var i = 0; i < length; i++) {
			
			var obj = jsonCodeObj.EtCodeInfo[i];
			var objOption = document.createElement('option');
			
			objOption.appendChild(document.createTextNode(obj.CODE_TEXT));
			objOption.setAttribute("value", obj.CODE_VALUE);
			objOption.setAttribute("title", obj.CODE_TEXT+' - '+obj.CODE_VALUE);
						
			if (objOption.value == bpRegionCode){
				objOption.selected = true;
			}else{
				if(_l.hasRcDatePendingStatus){
					objOption.disabled = true;
				}
			}

				if(objOption.selected == true){
					$('tempForm').STATE2.value = obj.CODE_TEXT;
				}
			selectObj.appendChild(objOption);
		}
	}
}

