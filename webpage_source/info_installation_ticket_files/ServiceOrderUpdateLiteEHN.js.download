function setSymtomCombo1(response) {
	var jsonObjC = eval('(' + response.responseText + ')');
	var jcode = "";
	var jtitle = "";
	var selectObj = $j('#SYMPTOM_CAT1');
	selectObj.empty();// 초기화

	var length = jsonObjC.etSymcodeList.length;

	if (jsonObjC.success) {

		selectObj.append("<option value=''>- Select -");

		for ( var i = 0; i < length; i++) {
			var obj = jsonObjC.etSymcodeList[i];
			jcode = obj.symptom_code;
			jtitle = obj.symptom_text;

			selectObj.append("<option value='" + jcode + "'>" + jcode + " - "+ jtitle);
		}
		setSymptomCodeInit(1);
	}
}
