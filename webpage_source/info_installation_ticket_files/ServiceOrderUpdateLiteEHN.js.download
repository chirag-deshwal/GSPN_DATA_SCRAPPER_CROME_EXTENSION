function confirmADHfromPop(flag, certiNo, damageExplanation, lossType, ewSmcFlag, claimNo, packFlag, policyId){
	if(flag=="Y" || flag=="S"){
		$('adhPackConfirmCheck').checked = true;
		$('ADH_FLAG').value = "X";
		
		if(lossType !='EW' && lossType !='BAT'){
			selectAD();
		}
		$j('#SUB_SVC_TYPE3 option').prop("disabled", false);
		if(_l.blockSubtypeSC){
			$j("#SUB_SVC_TYPE3").find("option:[value=SC]").remove();
		}
		
		if((_l.owPackFlag == "X" || _l.u.c == "C820" || _l.u.c == "C5A0") && "ST015,ST025,ST030".indexOf(_l.CurrStatus) != -1){
			$j("#WTY_EXCEPTION").removeClass().addClass("input").prop("readonly", false).prop("disabled", false);
		}
		
/*		if(_l.useScPlusSubSvcType) {
			if(flag=="S"){
				selectADSub('SC','');
			}else if(flag == "Y"){
				if(isLaUser){
					if(packFlag == "W"){
						selectADSub('PC','');
					}else if(packFlag == "P"){
						selectADSub('SP','');
					}else{
						selectADSub('SC','');
					}
				}
			}
		}*/

		$('DAMAGE_EXPLANATION').value = damageExplanation;
		$('LOSS_TYPE_ID').value = lossType;
		$('CLAIM_INSU_NO').value = claimNo;
		$('POLICY_ID').value = policyId;
	}else{
		
		if(ewSmcFlag == "X"){
			$('DAMAGE_EXPLANATION').value = damageExplanation;
			$('LOSS_TYPE_ID').value = lossType;
			$('CLAIM_INSU_NO').value = claimNo;
			$('POLICY_ID').value = policyId;
			$j('#SUB_SVC_TYPE3 option').prop("disabled", false);
			if(_l.blockSubtypeSC){
				$j("#SUB_SVC_TYPE3").find("option:[value=SC]").remove();
			}
		}
		
		$('adhPackConfirmCheck').checked = false;
		$('ADH_FLAG').value = "";
		// Care Pack 고도화 - 2017.03 - Start //
		//if(_l.isCarePackService){
			$j("#WTY_EXCEPTION").removeClass().addClass("input").prop("readonly", false).prop("disabled", false);
			$j('#MODEL').removeClass().addClass("input").prop("readonly", false);
			$j('#SERIAL_NO').removeClass().addClass("input").prop("readonly", false);
			//IMEI PROJECT
			if(isAutoImei){
				$j('#IMEI_TXT').removeClass().addClass("input").prop("readonly", false);
			}else{
				$j('#IMEI').removeClass().addClass("input").prop("readonly", false);
			}
		//}
		// Care Pack 고도화 - 2017.03 - End //
		
		if(_l.u.isChinaRegion){
			if($j('#SERVICE_TYPE').val() == "AD"){
				$j("#SERVICE_TYPE").html("");
				$j("#SERVICE_TYPE").html(beforeADServiceTypeString);
			}
		}else{
			$j("#SERVICE_TYPE").html("");
			$j("#SERVICE_TYPE").html(beforeADServiceTypeString);
		}
		
		// Care Pack 고도화 - 2017.03 - Start //
		if(_l.isCarePackService){
			$j('#tdSubType1,#tdSubType2').hide();
			$j('#SUB_SVC_TYPE3').html("");
		}
		// Care Pack 고도화 - 2017.03 - End //
	}
	
	if(_l.u.isChinaRegion){
	}else{
		$('REP_TYPE').value = $('SERVICE_TYPE').value;
		$j("#REPAIR_FLAG" ).val("X");
	}//if(_l.u.isChinaRegion){

	$('CERTI_NO').value = certiNo;
}

function clearForm(form){
	$j("#"+form).html("");
}
// 폼에 변수 저장하는 함수
function insertValue(form, name, value){
	var html = "<input type='hidden' id='"+name+"' name='"+name+"' value=\""+value+"\" />";
	$j("#"+form).append(html);
}

function smcSearch() {
	var url = "/svcpack/master/SearchSmcRegister.jsp";
	var isGlobalSCPlus = false;
	if($('SALES_COUNTRY').value != "" && _l.ascWtyCountry != $('SALES_COUNTRY').value){
		isGlobalSCPlus = true;
	}
	if(_l.useScPlusMultiPack || isGlobalSCPlus){
		url = "/svcpack/master/SearchSmcRegisterNew.jsp";
	}else{
		url = "/svcpack/master/SearchSmcRegister.jsp";
	}
	url = url + "?i_imei=" + $j("#IMEI").val() + "&s_country=" + $j("#SALES_COUNTRY").val();

	var w = window
    .open(
            url,
            "smc_popup",
            'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=no,top=150,left=200,width=650,height=650');
}

function checkCertiNoforADH(){
	
	// Care Pack 고도화 - 2017.03 - Start //
	if(!_l.isCarePackService){
		if(false){
			var formId='adhForm';
			$j('#'+formId).remove();
			var $frm = $j('<form id="'+formId+'" method=post />');
			$frm.append('<input type="hidden" name="cmd" value="ZifGspnB2cSerialInfoCmd"/>');
			$frm.append('<input type="hidden" name="IV_MODEL" value="'+$j("#MODEL").val()+'"/>');
			$frm.append('<input type="hidden" name="IV_COMPANY" value="'+chinaCorpCode+'"/>');
			$frm.append('<input type="hidden" name="IV_SERIAL" value="'+$j("#SERIAL_NO").val()+'"/>');
			$frm.append('<input type="hidden" name="IV_IMEI" value="'+$j("#IMEI").val()+'"/>');
			$frm.append('<input type="hidden" name="IV_FLAG" value="A"/>');
			$j('body').append($frm);
			AjaxRequest(urlPattern,formId, setCheckCertiNoforADHJsonObject);
			return;
		}//if(_l.u.isChinaRegion){
	}
	// Care Pack 고도화 - 2017.03 - End //
	
	clearForm("frm");
	// Care Pack 고도화 - 2017.03 - Start //
	if(_l.isCarePackService){
		insertValue("frm", "cmd", "ZifGspnCarePackInfoCmd");	
	}else{
		insertValue("frm", "cmd", "ZifGspnAdhInfoCmd");
		insertValue("frm", "IV_MODEL", $j("#MODEL").val());
		insertValue("frm", "IV_CERTI", $j("#CERTI_NO").val());
	}
	// Care Pack 고도화 - 2017.03 - End //
	insertValue("frm", "IV_GUBUN", "X");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId); 
	insertValue("frm", "IV_SERIAL_NO", $j("#SERIAL_NO").val());
	insertValue("frm", "IV_IMEI", $j("#IMEI").val());
	insertValue("frm", "IV_PURCHASE_DATE", $j("#PURCHASE_DATE").val());
	insertValue("frm", "IV_SALES_COUNTRY", $j("#SALES_COUNTRY").val());
	AjaxSyncRequest(urlPattern,'frm', setCheckCertiNoforADHJsonObject);
}
function setCheckCertiNoforADHJsonObject(response){
	try {
		jsonObj = response.responseText.evalJSON();
		
		if(false){
			var length = jsonObj.EtTab2.length;
			if (jsonObj.success && jsonObj != null && length > 0 ) {
				var todate = getTodayDate();
				for (var i = 0; i < length; i++) {
					
					var obj = jsonObj.EtTab2[i];
	           	    var fromDate = obj.E_DAT;
					if(todate <= fromDate){
						$j('#tdAdhPackConfirm').show();
						$('CERTI_NO').value = obj.CERTI;
					}else{

						if($j('#SERVICE_TYPE').val() == "AD"){
							 resetADHEWflag();
							$j("#SERVICE_TYPE").html("");
							$j("#SERVICE_TYPE").html(beforeADServiceTypeString);
						}
						$j('#tdAdhPackConfirm').hide();
					}
				}
			} else {
				if($j('#SERVICE_TYPE').val() == "AD"){
					 resetADHEWflag();
					$j("#SERVICE_TYPE").html("");
					$j("#SERVICE_TYPE").html(beforeADServiceTypeString);
				}
				$j('#tdAdhPackConfirm').hide();
			}
			return;
		}//if(_l.u.isChinaRegion){

		if (jsonObj.success) {
			// EHN23
			if ("X" == jsonObj.eS_RESULT.ADH_IND || "X" == jsonObj.esSmcInfo.ewSmcFlag) {
				if(isNewChina){
					var todate = getTodayDate();
					var fromDate = jsonObj.eS_RESULT.e_DAT;
					var startDate = jsonObj.eS_RESULT.s_DAT;
					if(startDate <= todate && todate <= fromDate){
						$j('#tdAdhPackConfirm').show();
						$('CERTI_NO').value = jsonObj.eS_RESULT.CERTI;
					}else{
						if($j('#SERVICE_TYPE').val() == "AD"){
							 resetADHEWflag();
							$j("#SERVICE_TYPE").html("");
							$j("#SERVICE_TYPE").html(beforeADServiceTypeString);
						}
						$j('#tdAdhPackConfirm').hide();
					}
				}else{
					$j('#adhPackConfirmArea').show();
					$('CERTI_NO').value = jsonObj.eS_RESULT.CERTI;
					$('PACK_BASE').value = jsonObj.esSmcInfo.packBase; // M, multi pack
		            if ("X" == jsonObj.esSmcInfo.smcFlag){
		            	$('SC_PLUS_FLAG').value = jsonObj.esSmcInfo.smcFlag;
		            	_l.owPackFlag = jsonObj.esSmcInfo.owPackFlag;
		            	$('adhPackConfirmBtn').innerHTML = "<A href=\"javascript:adhPackInfoSearch();\">SC+ Confirm</A>";
		                $('adhPackConfirmDesc').innerHTML = "SC+ Confirm";
		            }
				}
			} else {
				$j('#adhPackConfirmArea').hide();
				$('adhPackConfirmCheck').checked = false;
				$('ADH_FLAG').value = "";
				$j("#SERVICE_TYPE").html("");
				$j("#SERVICE_TYPE").html(beforeADServiceTypeString);
				$('PACK_BASE').value = "";
			}
		}
	} catch (e) {}
}

function checkModelforADH(){
	
	clearForm("frm");
	insertValue("frm", "cmd", "ZifGspnAdhModelCmd");
	insertValue("frm", "IV_GUBUN", "X");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_MODEL", $("detailForm").MODEL.value);
	AjaxRequest(urlPattern,'frm', setCheckModelforADHJsonObject);
}
function setCheckModelforADHJsonObject(response){
	try {
		jsonObj = response.responseText.evalJSON();

		if (jsonObj.success && jsonObj.ev_adh_check=="X") {
			$j('#adhPackConfirmArea').show();
		} else {
			$j('#adhPackConfirmArea').hide();
			$('adhPackConfirmCheck').checked = false;
			$('ADH_FLAG').value = "";
			$j("#SERVICE_TYPE").html("");
			$j("#SERVICE_TYPE").html(beforeADServiceTypeString);
		}
	} catch (e) {}
}

function isAddedPartsForADH() {
	
	var isValidLocationCode = false;
	var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
	var isValidPartFormat = false;
	for ( var i = 0; i < partCodes.length; i++) {
		var partCode = $j.trim($j(partCodes[i]).val());
		if(partCode.substring(0,4) == "GH96" || partCode.substring(0,4) == "GH97" || partCode.substring(0,4) == "GH82" || partCode.substring(0,4) == "GH81"){ 
			isValidPartFormat = true;
		}

		if (isValidPartFormat) {
			break;
		}
	}
	if(!isValidPartFormat){
		alert(_l.u.WEB_MSG_PREFIX + "OCTA Parts(GH96*, GH97*, GH82*, GH81*)should be inputted.");
	}
	return isValidPartFormat;
}

function checkAuthorizedModel(type) {
	$("progressloading").startWaiting();
	// type 1 : ST035, type 2 : Billing, type 3: RH
	var serviceType = $j("#SERVICE_TYPE").val();
	if(serviceType == "RH" && type=="1"){
		type = "3";
	}
	clearForm("frm");
	insertValue("frm", "cmd", "AuthorizedModelCheckCmd");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_COUNTRY", _l.u.CountryCd);
	insertValue("frm", "IV_ASC_CODE", _l.ASC_CODE);
	insertValue("frm", "IV_SVC_PRCD", $j("#SVC_PRCD").val());
	insertValue("frm", "IV_MODEL", $j("#MODEL").val());
	insertValue("frm", "IV_SERVICE_TYPE", serviceType);
	insertValue("frm", "IV_INDEX", "1");
	insertValue("frm", "TYPE", type);
	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId);
	if(type=="1"){
		AjaxRequest(urlPattern,'frm', setAuthorizedModelCheckCmdJsonObject);
	}else if (type=="2"){
		AjaxRequest(urlPattern,'frm', setAuthorizedModelCheckBilling);
	}else if (type=="3"){
		AjaxRequest(urlPattern,'frm', setAuthorizedModelCheckRhProcess);
	}else{
		AjaxRequest(urlPattern,'frm', setAuthorizedModelCheckCmdJsonObject);
	}
}


var confirmEscalation = false;
function setAuthorizedModelCheckCmdJsonObject(response) {
	$('progressloading').stopWaiting();
	try {			
		var jsonObj = eval('('+response.responseText+')');
		
		if (jsonObj.success) {
			if (jsonObj.evCheck =="S" && !confirmEscalation){
				var isExistPart = false;
				var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
				for ( var i = 0; i < partCodes.length; i++) {
					var partCode = $j.trim($j(partCodes[i]).val());
					if (!partCode.blank()) {
						isExistPart = true;
						break;
					}
				}
				if($('IRIS_REPAIR').value != "A06" && isExistPart){
					alert(_l.u.WEB_MSG_PREFIX + "You are authorized to do service(repair) without opening rear cover for "+$j("#MODEL").val()+" / "+$j("#SERVICE_TYPE").val()+". In case the parts-used repair is required, please make sure to change service type(SH) to transfer the case to other authorized service centers. Please change SVC type to RH in case of DOA.");
					setComboValue($('SERVICE_TYPE'),"SH");
					$('SERVICE_TYPE').value = "SH";
					// $("escalAscTd1").style.display='';
					// $("escalAscTd2").style.display='';
					$j("#escalAscTd1,#escalAscTd2").css("display","block");
					if(!json_escalAsc.et_escalation_asc){
						escalAscSearch();
					}
					confirmEscalation = true;
				}else{
					//saveServiceOrder();
					saveServiceOrder();
				}
				
			}else if (jsonObj.evCheck =="F" && !confirmEscalation){
				alert(_l.u.WEB_MSG_PREFIX + "You are not authorized to do any type of service(repair) for "+$j("#MODEL").val()+" / "+$j("#SERVICE_TYPE").val()+". Please make sure to change service type(SH) to transfer the case to other authorized service centers. Please change SVC type to RH in case of DOA.");
				setComboValue($('SERVICE_TYPE'),"SH");
				$('SERVICE_TYPE').value = "SH";
				// $("escalAscTd1").style.display='';
				// $("escalAscTd2").style.display='';
				$j("#escalAscTd1,#escalAscTd2").css("display","block");
				if(!json_escalAsc.et_escalation_asc){
					escalAscSearch();
				}
				confirmEscalation = true;
			}else{
				//saveServiceOrder();
				saveServiceOrder();
			}
		}else{
			if($("SVC_PRCD").value==""){
				alert(_l.u.WEB_MSG_PREFIX + 'Local Service Product Code is missing.');
			}else{
				alert(_l.u.WEB_MSG_PREFIX + 'check Failed.');
			}
		}
		
	} catch (e) {}
}

function setAuthorizedModelCheckBilling(response) {
	try {			
		var jsonObj = eval('('+response.responseText+')');
		
		if (jsonObj.success) {
			if (jsonObj.evCheck =="S" || jsonObj.evCheck =="F"){
				
				if($('SERVICE_TYPE').value == "RH"){
					if(_l.sawExistExchangeApporvedTa){
						openBillingPop(billingPopFlag);
						return;
					}else{
						alert(_l.u.WEB_MSG_PREFIX + "Please make sure “Exchange SAW” has been raised and approved for "+$j("#MODEL").val()+" / "+$j("#SERVICE_TYPE").val()+". You can not repair complete this S/O without approved “Exchange SAW”.");
					}
				}else{
					if(jsonObj.evCheck =="S"){
						var isExistPart = false;
						var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
						for ( var i = 0; i < partCodes.length; i++) {
							var partCode = $j.trim($j(partCodes[i]).val());
							if (!partCode.blank()) {
								isExistPart = true;
								break;
							}
						}
						if(!isExistPart){
							openBillingPop(billingPopFlag);
						}else if(jsonObj.evLabType == "AE" && isExistPart){
							openBillingPop(billingPopFlag);
						}else{
							alert(_l.u.WEB_MSG_PREFIX + "BILLING Calculation NOT Allowed. NON Accessory part used !!.You are authorized to do service(repair) without opening rear cover for "+$j("#MODEL").val()+" / "+$j("#SERVICE_TYPE").val()+". In case the parts-used repair is required, please make sure to change service type(SH) to transfer the case to other authorized service centers. Please change SVC type to RH in case of DOA.");
							setComboValue($('SERVICE_TYPE'),"SH");
							$('SERVICE_TYPE').value = "SH";
							// $("escalAscTd1").style.display='';
							// $("escalAscTd2").style.display='';
							$j("#escalAscTd1,#escalAscTd2").css("display","block");
							if(!json_escalAsc.et_escalation_asc){
								escalAscSearch();
							}
							confirmEscalation = true;
						}
					}else{
						openBillingPop(billingPopFlag);
					}
				}
			}else{
				openBillingPop(billingPopFlag);
			}
		}else{
			if($("SVC_PRCD").value==""){
				alert(_l.u.WEB_MSG_PREFIX + 'Local Service Product Code is missing.');
			}else{
				alert(_l.u.WEB_MSG_PREFIX + 'check Failed.');
			}
		}
		$('progressloading').stopWaiting();
		
	} catch (e) {}
}

function setAuthorizedModelCheckRhProcess(response) {
	try {			
		var jsonObj = eval('('+response.responseText+')');
		
		if (jsonObj.success) {
			if (jsonObj.evCheck =="S" || jsonObj.evCheck =="F"){
				
				if(_l.sawExistExchangeApporvedTa){
					saveServiceOrder();
				}else{
					alert(_l.u.WEB_MSG_PREFIX + "Please make sure “Exchange SAW” has been raised and approved for "+$j("#MODEL").val()+" / "+$j("#SERVICE_TYPE").val()+". You can not repair complete this S/O without approved “Exchange SAW”.");
				}
			}else if (jsonObj.evCheck =="F"){
				saveServiceOrder();
			}else{
				saveServiceOrder();
			}
		}else{
			if($("SVC_PRCD").value==""){
				alert(_l.u.WEB_MSG_PREFIX + 'Local Service Product Code is missing.');
			}else{
				alert(_l.u.WEB_MSG_PREFIX + 'check Failed.');
			}
		}
		$('progressloading').stopWaiting();
		
	} catch (e) {}
}

function ccCodeChange() {
	if(_l.isPSApp) {		
		$('CC_CODE').value=_l.CC_CODE;
	}
}

function onClickRmInstallationCheckBox(objCheckBox) {
	if("rmFlagCheckYes" == objCheckBox.id){
		if($('rmFlagCheckYes').checked){
			$('RM_FLAG').value = $('rmFlagCheckYes').value;
			$('rmFlagCheckNo').checked = false;
			$('RM_REASON_YES').disabled = false;
			$('RM_REASON_NO').disabled = true;
			$('RM_REASON_NO').value = "";
		}else{
			$('RM_FLAG').value = "";
			$('RM_REASON_YES').disabled = true;
			$('RM_REASON_NO').disabled = true;
			$('RM_REASON_YES').value = "";
		}
	}else if("rmFlagCheckNo" == objCheckBox.id){
		if($('rmFlagCheckNo').checked){
			$('RM_FLAG').value = $('rmFlagCheckNo').value;
			$('rmFlagCheckYes').checked = false;
			$('RM_REASON_YES').disabled = true;
			$('RM_REASON_NO').disabled = false;
			$('RM_REASON_YES').value = "";
		}else{
			$('RM_FLAG').value = "";
			$('RM_REASON_YES').disabled = true;
			$('RM_REASON_NO').disabled = true;
			$('RM_REASON_NO').value = "";
		}
	}else{
		$('RM_FLAG').value = "";

		$('rmFlagCheckYes').checked = false;
		$('rmFlagCheckNo').checked = false;
		
		$('RM_REASON_YES').disabled = true;
		$('RM_REASON_NO').disabled = true;
	}
	$('RM_REASON').value ="";
}

function onChangekRmInstallationReason(objReasonCombo) {
	if("RM_REASON_YES" == objReasonCombo.id){
		$('RM_REASON').value = $('RM_REASON_YES').value;
	}else if("RM_REASON_NO" == objReasonCombo.id){
		$('RM_REASON').value = $('RM_REASON_NO').value;
	}else{
		$('RM_REASON').value = "";
	}
}


