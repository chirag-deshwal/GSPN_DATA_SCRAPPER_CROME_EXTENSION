/**
 * 부모창에 업로드된 자재를 넣는다.
 */	
function addPartItem(rowItem){
	
	var partCode = cfV(rowItem.IPART);
	var partQty = cfV(rowItem.IQTY);
	
	var partFlag = "N";
	if(_l.inventoryFlag){
		partFlag = "I";
	}else if(_l.FSC){
		partFlag = "F";
	}	
	
	addParts(partFlag, partCode, partQty);		
}

function checkCoreParts() {
	var url = urlPatternGZIP;
	var data = "cmd=CheckCorePartsCmd&IV_COMPANY=" + _l.u.c + "&OBJECT_ID="+ _l.ObjectId;
	var warningMessageCode;
	var isNeedConfirm = true;
	var isPass = true;
	$j.ajax({
		type : "POST",
		async : false, /* 동기 */
		url : url,
		data : data,
		success : function(data) {
			if (data.success) {
				var alertMsg;
				if(data.warningMessageCode == "1"){
					var warningPartList = "";
					for ( var i = 0; i < data.EtWarPart.length; i++) {
						warningPartList += data.EtWarPart[i].PARTS_CODE;
						if(i < data.EtWarPart.length-1){
							warningPartList += ", ";
						}
					}
					if(_l.u.c == 'C310'){
						alertMsg ="Based on the product design, it is highly unlikely to replace both the main board and the panel at the same time.\nPlease double check the accuracy of the repair to confirm that both parts are needed.\nIf improvement is not made, a SAW may be required on future tickets to be able to complete the ticket with both of these parts used.";
					}else{
						alertMsg = _l.r.m.EXT_0298 + "\n" + _l.r.m.EXT_0292 + "\n" + _l.r.m.EXT_0293;
					}
				}else if(data.warningMessageCode == "2"){
					if(_l.u.c == 'C310'){
						alertMsg ="Your account’s core parts usage ratio is very high.\nPlease carefully manage your parts to lower this core ratio.\nIf improvement is not made, a SAW may be required on future tickets to be able to complete the ticket when a core part is used.";
					}else{
						alertMsg = _l.r.m.EXT_0294 + "\n" + _l.r.m.EXT_0292 + "\n" + _l.r.m.EXT_0293;
					}
					
				}else if(data.warningMessageCode == "3"){
					if(_l.u.c == 'C310'){
						alertMsg ="Your account’s core parts usage ratio is very high.\nPlease carefully manage your parts to lower this core ratio.\nIf improvement is not made, a SAW may be required on future tickets to be able to complete the ticket when a core part is used.";
					}else{
						alertMsg = _l.r.m.EXT_0294 + "\n" + _l.r.m.EXT_0292 + "\n" + _l.r.m.EXT_0293;
					}
				}else if(data.warningMessageCode == "4"){
					// alertMsg = _l.r.m.EXT_0294 + "\n" + _l.r.m.EXT_0292 +
					// "\n" + _l.r.m.EXT_0295 + "\n" + _l.r.m.EXT_0293;
					if(_l.u.c == 'C310'){
						alertMsg ="Your account’s core parts usage ratio is very high.\nPlease carefully manage your parts to lower this core ratio.\nAs a result of this high core parts ratio, a SAW is required on this ticket to be able to complete the ticket (SAW Type: Core Parts Approval).";
					}else{
						alertMsg = _l.r.m.EXT_0296 + "\n" + _l.r.m.EXT_0297 + "\n" + _l.r.m.EXT_0293;
					}
					isNeedConfirm = false;
				}else if(data.warningMessageCode == "5"){
					if(_l.u.c == 'C310'){
						alertMsg ="Your account’s core parts usage ratio is very high.\nPlease carefully manage your parts to lower this core ratio.\nIf improvement is not made, a SAW may be required on future tickets to be able to complete the ticket when a core part is used.";
					}else{
						alertMsg = _l.r.m.EXT_0294 + "\n" + _l.r.m.EXT_0292 + "\n" + _l.r.m.EXT_0293;
					}
				}else{
					isNeedConfirm = false;
				}
				warningMessageCode = data.warningMessageCode;
				if(isNeedConfirm){
					alertMsg = alertMsg + "\n" + "Do you want to save it?";
					if(confirm(_l.u.WEB_MSG_PREFIX +alertMsg)){
						isPass = true;
					}else{
						isPass = false;
					}
				}else{
					if(data.warningMessageCode == "4"){
						if(_l.sawExistCorePartsApprovalApproved){
							isPass = true;
						}else{
							alertMsg = _l.r.m.EXT_0296 + "\n" + _l.r.m.EXT_0297 + "\n" + _l.r.m.EXT_0293;
							alert(_l.u.WEB_MSG_PREFIX + alertMsg);
							isPass = false;
						}
					}else{
						isPass = true;
					}
				}
			} else {
				alert(_l.u.WEB_MSG_PREFIX + "Checking Parts Error.");
				isPass = false;
			}
		},
		dataType : 'json'
	});
	return isPass;
}

