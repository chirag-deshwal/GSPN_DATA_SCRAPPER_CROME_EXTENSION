function initDistance(){
	
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "cmd", "ZifGspnSvcGetDistanceInCmd");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_COUNTRY", _l.u.CountryCd);
	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId);
	AjaxRequest(urlPattern,'frm', setDistance);
	
}

function setDistance(response) {
	try {
		$('progressloading').stopWaiting();

		var distanceObj = eval('('+response.responseText+')');

	    for(var i= $j("#DISTANCE")[0].options.length-1; i>=1 ; i--){
	    	 $j("#DISTANCE")[0].removeChild( $j("#DISTANCE")[0].options[i]);
		}	
	    
		if(distanceObj.success){
			var data = distanceObj.EtDistance;
			var length = data.length;
			
			for(var i=0; i<length; i++){
				$j("#DISTANCE").append("<option value='" + data[i].KEY + "'>" + data[i].VALUE + "</option>");
			}
			
			if($j("#orig_distance_in").val() != ""){
				$j("#DISTANCE").val($j("#orig_distance_in").val());
			}
		}

	} catch (e) {}
}





