function initModifyFlag(newTabId){
	var aryModifyObj = [{ divId :"divGeneral", paramFlag: "GENERAL_FLAG"},
	   				   { divId :"divCustomer", paramFlag: "CUSTOMER_FLAG"},	
	   				   { divId :"divProduct", paramFlag: "PRODUCT_FLAG"},	
	   				   { divId :"divJob", paramFlag: "JOB_FLAG"},	
	   				   { divId :"divRepair", paramFlag: "REPAIR_FLAG"},	
	   				   { divId :"divShipping", paramFlag: "SHIPPING_FLAG"},	
	   				   { divId :"divPendProcess", paramFlag: "PENDPRO_FLAG"},
					   { divId :"divSubEng", paramFlag: "SUBENG_FLAG"}];	// 메디슨
																			// Sub
																			// Eng
																			// 추가
																			// 2015.02.26
																			// jiw
	//예약티켓 예외케이스
	if(!_l.isReservationTicket){
		if(tabCountClicked > 2){
			$j("#GENERAL_FLAG,#CUSTOMER_FLAG,#PRODUCT_FLAG,#JOB_FLAG,#REPAIR_FLAG,#SHIPPING_FLAG,#PENDPRO_FLAG,#SUBENG_FLAG").val("");
		}
	}
		
	for(var i=0; i<aryModifyObj.length;i++){
		if(aryModifyObj[i].divId == newTabId){			
			$j("#"+ aryModifyObj[i].paramFlag ).val("X");
			break;
		}
	}				
}

function checkValidDate(obj){
    if(obj.value=="") return false;
    
	// 메디슨 ASC 1st App, ASC last App, 1st Visit 은 CALL_RCV_DT 이전일 수 없음 2016.04.18 jiw
	if(_l.u.c == "C1X0" || isHmeUser){
		if(obj.name == 'FIRST_VISIT_DATE' || obj.name == 'FIRST_VISIT_DATE_DY_STT'){
			if(!checkFromToDate(_l.CREATE_DATE, obj.value,_l.u.DateFormat2)){
				alert(_l.u.WEB_MSG_PREFIX + "Please check Date : \"1st Visit\" cannot be prior to the \"Repair Received Date \"");
				$j("#" + obj.name).val('');
				return;
			}
		}
	}
	
	var serviceType = $j("#SERVICE_TYPE").val();
    /*if(serviceType == "IH"){*/
    	if (obj.name == "FIRST_VISIT_DATE" || obj.name == "LAST_VISIT_DATE" || obj.name == "SERVICE_DATE" 
    		|| obj.name == "LAST_VISIT_DATE_DY_STT" || obj.name == "FIRST_VISIT_DATE_DY_STT") {
    		if( !checkFutureDate(obj, obj.name)){
    			obj.value = "";
    			return;
    		}
    	}
    	
    	if( !checkFromToDate(_l.CREATE_DATE, obj.value,_l.u.DateFormat2)){
			alert(_l.u.WEB_MSG_PREFIX + "First Visit Date should be after Creation Date."); 
			obj.value = "";
			return;
		}	
    	
    /*}*/
    // 1st visit date 동기화 (main, tab) 2016.04.12 jiw
    if(isEuUser){
	    if(obj.name == 'FIRST_VISIT_DATE_DY_STT'){
			$j("#FIRST_VISIT_DATE").val( obj.value );
		}
    }
    
    if( !checkDate(obj.value, _l.u.DateFormat2) ){
        alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_DATE);
        obj.value = "";
        return false;
    } else return true;
}

function checkValidReqDate(obj){
	if(isEaUser){
		if(!checkFromToDate(obj.value, _l.CREATE_DATE, _l.u.DateFormat2)){
			alert(_l.u.WEB_MSG_PREFIX + "Shipping Date (Pre) should be not be later than S/O creation date.");
			obj.value = "";
			obj.focus();
			return;
		}else if(checkFromToDate(obj.value, _l.before30Date, _l.u.DateFormat2)){
			alert(_l.u.WEB_MSG_PREFIX + "Please key in Shipping Date (Pre) not exceeding 30 days from today.");
			obj.value = "";
			obj.focus();
			return;
		}
	}
}

function checkValidAppDate(obj, dateField){
	if( !checkDate(obj.value, _l.u.DateFormat2) ){
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_DATE/* Please check Date : */ + dateField);
// moreOpenid(5);
		obj.value = "";
		obj.focus();
		return;
	}
	
	// 메디슨 ASC 1st App, ASC last App, 1st Visit 은 CALL_RCV_DT 이전일 수 없음 2016.04.18 jiw
	if(_l.u.c == "C1X0" || isHmeUser){
		if(!checkFromToDate(_l.CREATE_DATE, obj.value,_l.u.DateFormat2)){
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_DATE/* Please check Date : */+  " [" + dateField + "] " + "cannot be prior to the \"Repair Received Date \"");
			$j("#" + obj.name).val('');
			return;
		}
	}
	
	// if (obj.name == "FIRST_APP_DATE" || obj.name == "LAST_APP_DATE") {
		if( !checkFromToDate(_l.toDate, obj.value,_l.u.DateFormat2)){
			/* Please check Date : past date cannot be selected */
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_DATE +  "[" + dateField + "]" + _l.r.m.EXT_0009); // 과거날짜는 안됨
			// moreOpenid(5);
			obj.value = "";
			obj.focus();
			return;
		}	
		
		
	// }
	
	if(obj.name == 'FIRST_APP_DATE_DY_STT'){
		$j("#FIRST_APP_DATE").val( obj.value );
		if ("C310"==_l.u.c) {
			$j("#LAST_APP_DATE_DY_STT").val( obj.value );
		}
	}
	
	getSvcEngineerSearch();// lass app date Change ! Engineer Research.
}

