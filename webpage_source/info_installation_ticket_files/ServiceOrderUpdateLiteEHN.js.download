function cfSearchRecommandedPop(type) {
	var url;
	if(type == 'PART'){
		url = '/svctracking/svcorder/ServiceOrderUpdateRecommendedPartsPop.jsp'
	}else if(type == 'SYMPTOM'){
		url = '/svctracking/svcorder/ServiceOrderUpdateRecommendedIrisPop.jsp'
	}else if(type == 'REPAIR'){
		url = '/svctracking/svcorder/ServiceOrderUpdateRecommendedIrisPop.jsp'
	}else if(type == 'RELATED'){
		url = '/svctracking/svcorder/ServiceOrderUpdateRecommendedRelatedRepairPop.jsp'
	}else{
		url = '/svctracking/svcorder/ServiceOrderUpdateRecommendedPartsPop.jsp'
	}
	
	var arrVal = [];
	$j('#partsTableBody input[name="PARTS_CODE"]').each(function(){
		arrVal.push(this.value);
	});
	
	url = url +'?objectID=' + _l.ObjectId
			+'&type=' + type
			+'&basicModel=' + $('MODEL_NAME').value
			+'&runningModel=' + $('MODEL').value
			+'&symptom1=' + $('SYMPTOM_CAT1').value
			+'&symptom2=' + $('SYMPTOM_CAT2').value
			+'&symptom3=' + $('SYMPTOM_CAT3').value
			+'&productCode=' + $('CIC_PRCD').value
			+'&productDate=' + _l.PRODUCT_DATE_YYYYMMDD
			+'&serialNo=' + $('SERIAL_NO').value
			+'&wtyTerm=' + _l.IN_OUT_WTY
			+'&partCodes=' + arrVal.join()
			+'&isUseProActiveRecommendedPartsAdd=' + _l.isUseProActiveRecommendedPartsAdd
			+'&canChangeRepairPart=' + _l.canChangeRepairPart;
	if(type == 'PART' || type == 'SYMPTOM' || type == 'REPAIR'){
		url = url +'&bomVersion=' + getVersionFromGMES();
		if(type == 'PART'){
			url = url +'&productSummary=' + $j('#sbProductSummary').text();
			
		}
	}else if(type == 'RELATED'){
		url = url +'&symptomCode=' + $('IRIS_SYMPT').value;;
	}
	if(_l.useEngineer || _l.isFieldUser) {
	url = url + '&engineer=' + _l.ENGINEER;
	}
	
	if(type == 'PART'){
		w = window.open(
				url,
				"recommended_parts_popup",
				'toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=1200,height=500');
	}else if(type == 'REPAIR' || type == 'SYMPTOM'){
		w = window.open(
				url,
				"recommended_iris_popup",
				'toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,top=150,left=200,width=550,height=200');
	}else if(type == 'RELATED'){
		w = window.open(
				url,
				"related_history_popup",
				'toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=500');
	}else{
		w = window.open(
				url,
				"recommended_parts_popup",
				'toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=500');
	}
}
function setIRISWithCode(irisType, selectedCode) {
	try {
		
		var length = jsonObjIrisSymptom.dataLists.length;

		var IRIS_CONDI = "";
		var IRIS_DEFEC = "";
		var IRIS_SYMPT = "";
		var IRIS_REPAI = "";
		
		if(irisType == "SYMPTOM"){
			IRIS_SYMPT = selectedCode;
		}else if(irisType == "REPAIR"){
			IRIS_REPAI = selectedCode;
		}else if(irisType == "DEFECT"){
			IRIS_DEFEC = selectedCode;
		}else{
			
		}

		var IRIS_CONDI_DESC = $("tempForm").IRIS_CONDI_DESC;
		var IRIS_DEFECT_DESC = $("tempForm").IRIS_DEFECT_DESC;
		var IRIS_SYMPT_DESC = $("tempForm").IRIS_SYMPT_DESC;
		var IRIS_REPAIR_DESC = $("tempForm").IRIS_REPAIR_DESC;

		var CONDI = $('IRIS_CONDI');
		var DEFECT = $('IRIS_DEFECT');
		var SYMPT = $('IRIS_SYMPT');
		var REPAIR = $('IRIS_REPAIR');

		var isDefectSeleted = false;
		var isSymptomSeleted = false;
		var isRepairSeleted = false;
		
		for ( var i = 0; i < length; i++) {
			var obj = jsonObjIrisSymptom.dataLists[i];
			var ctype = obj.ctype;
			
			if(_l.u.isChinaRegion && obj.code == 'X01'){
				isQQ = false;
			}
			
			if(irisType == "SYMPTOM"){
				if (ctype.indexOf('-S') > 0) {// } else if ( ctype ==
					// 'IRIS-S') {
					if (obj.code == IRIS_SYMPT) {
						isSymptomSeleted = true;
						IRIS_SYMPT_DESC.value = obj.codetx;
						if(_l.isUseGcicIris){
							$('SAVED_IRIS_SYMPT_QCODE').value = obj.qcode;
						}
						$('IRIS_SYMPT_QCODE').value = obj.qcode;
						break;
					}
				} 
			}else if(irisType == "REPAIR"){
				if (ctype.indexOf('-R') > 0) {// } else if ( ctype ==
					// 'IRIS-R') {

					if(isNewChina && (objOption.value == "X15" || objOption.value == "W67")
							&& $('SERVICE_TYPE').value != "SH"){
						continue;
					}else{
						if (obj.code == IRIS_REPAI) {
							isRepairSeleted = true;
							IRIS_REPAIR_DESC.value = obj.codetx;
							if(_l.isUseGcicIris){
								$('SAVED_IRIS_REPAIR_QCODE').value = obj.qcode;
							}
							$('IRIS_REPAIR_QCODE').value = obj.qcode;
							break;
						}
					}
				}
			}else if(irisType == "DEFECT"){
				if (ctype.indexOf('-D') > 0) {// } else if ( ctype ==
					// 'IRIS-D') {
					if (obj.code == IRIS_DEFEC) {
						isDefectSeleted = true;
						IRIS_DEFECT_DESC.value = obj.codetx;
						if(_l.isUseGcicIris && ctype.indexOf('EIA-D') != -1){
							$('SAVED_IRIS_DEFECT_QCODE').value = obj.qcode;
						}
						break;
					}
				}
			}else{
				
			}
		}
		if(_l.isUseGcicIris && irisType != 'DEFECT_BLK'){
			
			var defectMiddleLength = jsonObjIrisSymptom.defectMiddleList.length;
			var symptomMiddleLength = jsonObjIrisSymptom.symptomMiddleList.length;
			var repairMiddleLength = jsonObjIrisSymptom.repairMiddleList.length;
			
			var defectMiddleObj = jsonObjIrisSymptom.defectMiddleList;
			var symptomMiddleObj = jsonObjIrisSymptom.symptomMiddleList;
			var repairMiddleObj = jsonObjIrisSymptom.repairMiddleList;
			
			if(irisType == "SYMPTOM"){
				if(symptomMiddleLength > 0){
					$('IRIS_SYMPT_QCODE').className = "selectF";
					$('IRIS_SYMPT_QCODE').disabled = false;
					changeSymptomQCode($('SAVED_IRIS_SYMPT_QCODE').value, IRIS_SYMPT);
				}
			}else if(irisType == "REPAIR"){
				if(repairMiddleLength > 0){
					$('IRIS_REPAIR_QCODE').className = "selectF";
					$('IRIS_REPAIR_QCODE').disabled = false;
					changeRepairQCode($('SAVED_IRIS_REPAIR_QCODE').value, IRIS_REPAI);
				}
			}else if(irisType == "DEFECT"){
				if(defectMiddleLength > 0){
					$('IRIS_DEFECT_QCODE').className = "selectF";
					$('IRIS_DEFECT_QCODE').disabled = false;
					changeDefectQCode($('SAVED_IRIS_DEFECT_QCODE').value, IRIS_DEFEC);
				}
			}else{
				
			}
		}
	} catch (e) {
	}
}
function setModuleId(){
	var ppidPrdCodeList = _l.r.c.PPID_PRD_CODE_LIST.evalJSON();
	var isPPIDList = false;
	var hqSvcProd = $('HQ_SVC_PRCD').value;
	for(var i=0; i<ppidPrdCodeList.length; i++){
		if(hqSvcProd == ppidPrdCodeList[i].codeId){
			isPPIDList = true;
			break;
		}
	}
	
	if(isPPIDList){
		$("divModuleId").style.display='';
	}
}

function setRank(){
	
	if(_l.blockRankFuncCall){
		return;
	}
	
	var model = $('MODEL').value;
	var modelCode = model.substring(0, 3);
	
	if(modelCode == "MNA"){ //Micro LED 제품에 해당할 경우 (모델코드 : MNA****) Rank # 필드 표시
		$("divRank").style.display='';
	}else{
		$("divRank").style.display='none';
	}
	
}

function initRank(){
	
	if(_l.blockRankFuncCall){
		return;
	}
	
	var model = $('MODEL').value;
	var modelCode = model.substring(0, 3);
	
	if(modelCode == "MNA"){
		$("divRank").style.display='';
		$('RANK_NO').value = "";
	}else{
		$("divRank").style.display='none';
	}
	
}

function checkIMEIfor14DigitAsync(imei) {
	var url = urlPatternGZIP;
	var returnedIMEI = "";
	var data = "cmd=CheckIMEIfor14DigitCmd&CorpCode=" + _l.u.c + "&IMEI="+ imei;
	var returnCode = "F";
	$j.ajax({
		type : "POST",
		async : false, /* 동기 */
		url : url,
		data : data,
		success : function(data) {
			if (data.imei == '') {
				returnCode = "F";
			} else {
				returnCode = "S";
				returnedIMEI = data.imei;
			}
		},
		dataType : 'json'
	});
	return returnedIMEI;
	// return true;
}

var war_popup;
function openWarrantyActionRequestPop(category) {
	
	if("ST035|ST040".indexOf($('STATUS').value) != -1 && _l.extSysFlag=="X"){
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0819);
		return;
	}
	
	var alreadyIsSAWWarning = "";
	
	war_popup = window
			.open(
					"",
					"war_popup",
					'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=680,height=700');
	war_popup.focus();
	var url = "/svctracking/lite/ServiceOrderUpdatePopWAR.jsp";
	$('tempForm').MODEL.value = _l.MODEL;
		$('tempForm').LAST_APP_DATE.value = _l.LAST_APP_DATE;
		$('tempForm').svcProd.value = _l.SVC_PRCD;
		$('tempForm').PURCHASE_PLACE.value = _l.PURCHASE_PLACE;
	
	$('tempForm').SAW_CATEGORY.value = category;
	$('tempForm').REASON.value = $('detailForm').REASON.value;

	
	if(_l.isIndia && _l.isHHPIndia){
		
		$j("#isIndia").remove();
		$j("#isHHPIndia").remove();
		
		insertValue("tempForm", "isIndia", _l.isIndia);
		insertValue("tempForm", "isHHPIndia", _l.isHHPIndia);
