	var url = urlPatternGZIP + "?cmd=ServiceTokenAscCmd&company=" + _l.u.c
			+ "&ascCode=" + ascCode;
	$j.get(url, function(json) {
		tokenASC = json.success;
	}, 'json');// $j.get(url, function(json){
}// function serviceTokenAscchk(ascCode){

