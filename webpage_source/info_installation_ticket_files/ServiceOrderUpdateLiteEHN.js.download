		//수정자 : 채보람 (로젠 솔루션)
		//내  용 : GD로 저장시 OTP 대상일경우 OTP 필수 체크.
		if(isOTPShowSVCType() && _l.isIndia){
			initOTPCheck();
			
			if(_l.TR_TYPE == "I" && _l.mobile_phone == ""){
				alert(_l.u.WEB_MSG_PREFIX + "Customer mobile number is mandatory.");
				return;
			}
			
			var userStatus = frm.STATUS.value;
			var toGDOTPCheck = (currStatus != userStatus && userStatus == "ST040");
			
			if(toGDOTPCheck){
				if(_l.eligibleOTPFlag && !_l.initOTPCheckFlag && _l.mobile_phone != ""){
					alert(_l.u.WEB_MSG_PREFIX + "OTP confirmation is mandatory, can't save ticket");
					return;
				}
			}
		}
		//=================================================================================//
		
