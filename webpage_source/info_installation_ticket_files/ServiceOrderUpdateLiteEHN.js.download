		if(!_l.isWtyClaimed && $('LAB_TYPE').value == ""){
			$j("#detailForm").find("#LAB_TYPE").attr("disabled", false);
			$j("#detailForm").find("#LAB_TYPE").attr('class', 'selectIDS');
		}
		
		isPreventEdit = true;
	}	
	if(tabId == 'divCustomer'){
		$j("#detailForm").find("#NAME_FIRST,#NAME_LAST,#CITY").keyup(function(){
			$j(this).val(returnOnlyAlphabet($j(this).val()));		
		}); 
		$j("#detailForm").find("#HOMEPHON_NUMBER,#OFFICEPHON_NUM,#MOBILE_NUMBER,#POST_CODE").keyup(function(){
			$j(this).val(returnOnlyNum($j(this).val()));		
		});
		$j("#detailForm").find("#HOMEPHON_NUMBER,#OFFICEPHON_NUM,#MOBILE_NUMBER").attr("maxlength", 10);
		
		if(_l.isExchTicket){
			$('EMAIL').className = "inputIDS";// Adv Exchange는 이메일필수
		}
		
	}else if(tabId == 'divProduct'){
		if(_l.isExchTicket){
			$j("#tableBOSBtn").hide();
