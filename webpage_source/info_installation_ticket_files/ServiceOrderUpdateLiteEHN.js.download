function setPRCExtensionCheck() {
	var frm = $('detailForm');
	if (frm.MODEL.value == '') {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_XVALUE_00457);
		return;
	}
	if (frm.SERIAL_NO.value == '') {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_XVALUE_00748);
	}
	frm.cmd.value = 'SVCPopCustomerProductCmd';
	AjaxRequest(urlPatternGZIP, "detailForm", setPRCCheck);
	$('progressloading').startWaiting();
}

function setPRCCheck(response) {
	$('progressloading').stopWaiting();
	var jsonObjC = eval('(' + response.responseText + ')');

	if (jsonObjC.rpcsuccess) {
		$j('#spanRPCCheck').text('Yes');
	} else {
		$j('#spanRPCCheck').text('No');
	}
}

//buds logic
function checkBudsSn(){
	$('progressloading').startWaiting();
	
    clearForm("frm");
    insertValue("frm", "IV_SERIAL_NO", $("SERIAL_NO").value);
    insertValue("frm", "cmd", "ZifGspnBudsSnCmd");
	
    AjaxSyncRequest(urlPattern, "frm", setGridBudsSnJsonObject);
}

function setGridBudsSnJsonObject(response){
    $('progressloading').stopWaiting();
    
    try{
        jsonObj = eval('('+response.responseText+')');
        
        if(jsonObj.success && jsonObj.EV_RET_CODE == "S"){
        	$('SERIAL_NO').value = jsonObj.EV_ORI_SERIAL_NO;
        	$('IMEI').value = jsonObj.EV_ORI_SERIAL_NO;
        	// C22020003801 Manual DOP in BOS, then warranty check But auto remove purchase date - GSPN
        	if(jsonObj.EV_ORI_PURCHASE_DT=="" || jsonObj.EV_ORI_PURCHASE_DT.substring(0,2) == "00"){
        	}else{
        		$('PURCHASE_DATE').value = jsonObj.EV_ORI_PURCHASE_DT;
        	}
        	$('SALES_BUYER').value = jsonObj.EV_SALES_BUYER;
        }else{
			//alert(_l.u.SAP_MSG_PREFIX + jsonObj.EV_RET_MSG);
        }
    } catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
    }
}

//get imei by qr code. 2019-09-02 jiw
function pbaQrChange(){
	if($("pbaQrCode").value == ""){
		alert(_l.u.WEB_MSG_PREFIX + '<%=/*QR Code should be inputted.*/resource.getMessageArg("MSG/MAND_INPUT","QR Code(PBA)")%>');
		return;
	}
	
	if($("pbaQrCode").value.length != 13 && $("pbaQrCode").value.length != 9){
		alert(_l.u.WEB_MSG_PREFIX + "QR Code(PBA) length should be 9 or 13.");
		return;
	}
	
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_QRCODE", $("pbaQrCode").value);
	insertValue("frm", "cmd", "ZifComGetImeiByQrcodeCmd");
	
	AjaxRequest(urlPattern, "frm", setGridPbaQrJsonObject);
}

function setGridPbaQrJsonObject(response){
	$('progressloading').stopWaiting();
 
	try{
	    jsonObj = eval('('+response.responseText+')');
	
		if(jsonObj.success && jsonObj.EV_RET_CODE == "0"){
			$('SERIAL_NO').value = jsonObj.EV_SERIAL_NO;	//중국ODM
			//IMEI PROJECT
			if(isAutoImei){
				$('IMEI_TXT').value = markIMEI(jsonObj.EV_IMEI);
				$('IMEI').value = jsonObj.EV_IMEI;
			}else{
				$('IMEI').value = jsonObj.EV_IMEI;
			}

		    imeiChange('Q');
		}else{
			alert(_l.u.SAP_MSG_PREFIX + jsonObj.EV_RET_MSG);
		}
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
	}
}


/*
 * MPTS 로 체크 여부 : haveTocheckIMEIforHHP
 * 	not (ST035 and ST040) and MPTS_PRD_CODE in WEB include (SVC_PRCD or HQ_SVC_PRCD) and not C550
 * 	not (ST035 and ST040) and MPTS_PRD_CODE in WEB include (SVC_PRCD or HQ_SVC_PRCD) and C550 and HQ_SVC_PRCD not (THB32 and THB35)
 * 
 * MPTS 로 체크할시
 * 	isChinaRegion : GetIMEICheckCmd{call MPTS 또는 call ZCSB_IMEI_OUTPORT_SEARCH}
 * 	310,370 : GetESNorIMEICmd(ststem=SMES){call ZIF_MES_INTERFACE_GATEWAY}
 * 	그외 : GetIMEIofHHPCmd(system=MPTS){call MPTS}
 * MPTS 초 체크 안할시.
 * 	ESB_GMES2
 * 		결과없으면 : ZCSPT_GET_MES_INFO
 * 	
 */
function imeiChange(type) {
	if($('IMEI').value == "000000000000000"){
		return;
	}
	
	if($('IMEI').value.trim().length == 14){
		var returnedIMEI=checkIMEIfor14DigitAsync($('IMEI').value);
		if(returnedIMEI != "" && returnedIMEI.length == 15){
			//IMEI PROJECT
			if(isAutoImei){
				$('IMEI_TXT').value = markIMEI(returnedIMEI);
				$('IMEI').value = returnedIMEI;
			}else{
				$('IMEI').value = returnedIMEI;
			}

		}
	}

	//china version intergration 2016/08/19 js1.baek
	if(_l.u.isChinaRegion){
		//스캐너로직 제외 2016.12.19
/*		if($j('[name=IMEI_SCAN]')[0].checked){
			
			 var now = new Date();
	    	 var Minute = now.getMinutes(); // 분

	     	 var Second = now.getSeconds(); 
	     	var setCompMinute = Minute *60 + Second;
	     	if(isNewChina && setCompMinute - setScanMinute > 4){
	     		alert(_l.r.m.EXT_0463Please use the scan code gun);
	     		resetImeiSerial(true);
	     		$j('#IMEI_SCAN').focus();
	     		return;
	     	}
		}*/
		
		$j('#SERIAL_NO,#IMEI').each(function() {
			this.value = this.value.toUpperCase().trim();
		});
		if(searchedIMEI == $j('#IMEI').val() && searchedSerial == $j('#SERIAL_NO').val()){
			return;
		}
		checkWarranty = true;//**********
		if($j('#SERIAL_NO').val().trim() == 'M000'){
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.B2C_MSG_0033/*Wrong IMEI / Serial Number !!*/);
			resetImeiSerial();
			return;
		}else if($j('#IMEI').val() == ''){
			resetImeiSerial(true);
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.B2C_MSG_0032/*Wrong IMEI !!*/);
			return;
		}
		
		if(type != "I" && $("useMOTPforMPTS") != null && $("useMOTPforMPTS")  != undefined  && $("useMOTPforMPTS").value == "true" && $("masterOTP").value.strip().length < 1){
        	alert(_l.u.WEB_MSG_PREFIX + "Please input Main OTP.");
        
        	//IMEI PROJECT
    		if(isAutoImei){
    			$("IMEI_TXT").value = "";
    			$("IMEI").value = "";
    		}else{
    			$("IMEI").value = "";
    		}

            $("masterOTP").focus();
            $('progressloading').stopWaiting();
            return;
        }

		
	
		
		$('progressloading').startWaiting();
		
		var formId = 'searchImeiModelFrm';
		$j('#'+formId).remove();
		var $frm = $j('<form id="'+formId+'" method=post />');
		$frm.append('<input type="hidden" name="cmd" value="GetIMEICheckCmd"/>');//GetIMEIofHHPCmd
		$frm.append('<input type="hidden" name="imei" value="'+$j('[name=detailForm] [name=IMEI]').val()+'" />');
		$frm.append('<input type="hidden" name="model" value="'+$j('[name=detailForm] [name=MODEL]').val()+'" />');
		$frm.append('<input type="hidden" name="serial" value="'+$j('[name=detailForm] [name=SERIAL_NO]').val()+'" />');
		$frm.append('<input type="hidden" name="sysFrom" value="'+type+'" />');
		
		if($("useMOTPforMPTS") != null && $("useMOTPforMPTS")  != undefined  && $("useMOTPforMPTS").value == "true" ){
			$frm.append('<input type="hidden" name="motp" value="'+$j('[name=detailForm] [name=masterOTP]').val()+'" />');
		}
		
        if(type != "I")
        	$frm.append('<input type="hidden" name="src" value="S" />');
        
		$j('body').append($frm);
		AjaxRequest(urlPattern, formId, setGridIMEIJsonObject);		
		
		return;
	}//if(_l.u.isChinaRegion){
		
	// checkCertiNoforADH();
	if (type != "I") {
		setCheckWtyTrue();
	} else {
		
	}
	
	$j('#SERIAL_NO,#IMEI').each(function() {
		this.value = this.value.toUpperCase().trim();
	});
	
	var mptsPrdCodeList = _l.r.c.MPTS_PRD_CODE_LIST.evalJSON();
	var svcProd = $("SVC_PRCD").value;
	if(_l.useHrPrdCodeMPTS){
		svcProd = $('HQ_SVC_PRCD').value;
	}
	var isHHPProduct = false;
	for(var i=0; i<mptsPrdCodeList.length; i++){
		if(svcProd == mptsPrdCodeList[i].codeId){
			isHHPProduct = true;
			break;
		}
	}
	if(_l.u.c == "C370"){
		isHHPProduct = true;
	}
	
	var imei = $("IMEI").value;
	var model = $("MODEL").value;
	var serial = $("SERIAL_NO").value;
	
	if (_l.useGMESHHPByIMEI
			&& !(_l.CurrStatus == "ST040" || _l.CurrStatus == "ST035")) {
		if (type != "I") {
			$('detailForm').WTY_EXCEPTION.disabled = false;
			setComboValue($('detailForm').WTY_EXCEPTION, "");
		} else {
			if ($('detailForm').WTY_EXCEPTION.value != "") {
				$('detailForm').WTY_EXCEPTION.disabled = true;
			}
		}

		if (isHHPProduct) {

			if (model.strip().length < 5) {
				alert(_l.u.WEB_MSG_PREFIX + "Please Input the model code at first and input the IMEI No!");
				//IMEI PROJECT
				if(isAutoImei){
					$("IMEI_TXT").value = "";
					$("IMEI").value = "";
				}else{
					$("IMEI").value = "";
				}


				serialReadOnly(false);
				return;
			}
			if (serial == "" && (svcProd == "HHP01" || svcProd == "HHP06" || svcProd == "HHP05")) {
				alert(_l.u.WEB_MSG_PREFIX + "Please Input the serial number first and input the IMEI No!");
				//IMEI PROJECT
				if(isAutoImei){
					$("IMEI_TXT").value = "";
					$("IMEI").value = "";
				}else{
					$("IMEI").value = "";
				}
				serialReadOnly(false);
				$("SERIAL_NO").focus();
				return;
			}
			if(imei == "M000" || imei == "12345678" || imei == "TEMP" || imei == "MOOO" || imei == "11111111" || imei == "00000000"
				|| imei.strip().length < 5){
				alert(_l.u.WEB_MSG_PREFIX + "Please input Correct IMEI No.");
				serialReadOnly(false);
				//IMEI PROJECT
				if(isAutoImei){
					$("IMEI_TXT").value = "";
					$("IMEI").value = "";
				}else{
					$("IMEI").value = "";
				}
				return;
			}
			
			if (svcProd == "HHP01" || svcProd == "HHP06") {
				
				if (!isNum($("IMEI"), "IMEI")) {
					serialReadOnly(false);
					//IMEI PROJECT
					if(isAutoImei){
						$("IMEI_TXT").value = "";
						$("IMEI").value = "";
					}else{
						$("IMEI").value = "";
					}
					return;
				}

			}
			isReturnedGMES = false;
		} else {
			return;
		}

	}// if(_l.useGMESHHPByIMEI && !(_l.CurrStatus == "ST040" || _l.CurrStatus
		// == "ST035") ){

	if ( haveTocheckIMEIforHHP(_l.CurrStatus, isHHPProduct,  $("SERVICE_TYPE").value, $("HQ_SVC_PRCD").value)) {
		if(_l.isWorkingMPTS){
			if (model.strip().length < 5) {
				alert(_l.u.WEB_MSG_PREFIX + "Please Input the model code at first and input the IMEI No!");
				serialReadOnly(false);
				//IMEI PROJECT
				if(isAutoImei){
					$("IMEI_TXT").value = "";
					$("IMEI").value = "";
				}else{
					$("IMEI").value = "";
				}
				return;
			}
			/**
			 * 프로그래바를 진행시킨다.
			 */
			$('progressloading').startWaiting();
			$('frmIMEIofHHP').imei.value = imei;
			$('frmIMEIofHHP').model.value = model;
			if(_l.u.c == 'C370' && $('detailForm').SERVICE_COMPANY.value == "C370"){
				if($("IMEI").value == ""){
					//IMEI PROJECT
					if(isAutoImei){
						$("IMEI_TXT").value = "";
						$("IMEI").value = "";
					}else{
						$("IMEI").value = "";
					}
					$("SERIAL_NO").value = "";
					$("UN_IO").value = "";
					serialReadOnly(false);
					wtyInfoReset();
					
					if (!_l.isCompletedReadOnly) {
						$j("#aModelSearch").show();
						$j("#aSerialSearch").show();
						$j("#SERIAL_NO_ICON").show();
					}
					
					$('progressloading').stopWaiting();
					return;
				}
				$('frmIMEIofHHP').system.value = "SMES";
				$('frmIMEIofHHP').imeiP.value = imei;
				$('frmIMEIofHHP').cmd.value = "GetESNorIMEICmd";
			}else{
	            if(type != "I" && $("useMOTPforMPTS") != null && $("useMOTPforMPTS")  != undefined  && $("useMOTPforMPTS").value == "true" && $("masterOTP").value.strip().length < 1){
	            	alert(_l.u.WEB_MSG_PREFIX + "Please input Main OTP.");
	            	//IMEI PROJECT
					if(isAutoImei){
						$("IMEI_TXT").value = "";
						$("IMEI").value = "";
					}else{
						$("IMEI").value = "";
					}
					
	                $("masterOTP").focus();
	                $('progressloading').stopWaiting();
	                return;
	            }

				$('frmIMEIofHHP').system.value = "MPTS";
				
				if($("useMOTPforMPTS") != null && $("useMOTPforMPTS")  != undefined  && $("useMOTPforMPTS").value == "true" ){
            		$('frmIMEIofHHP').motp.value = $("masterOTP").value;
				}
				
		        if(type != "I")
		            $('frmIMEIofHHP').src.value = "S";
				
				$('frmIMEIofHHP').cmd.value = "GetIMEIofHHPCmd";
			}						
			AjaxSyncRequest(urlPatternGZIP, 'frmIMEIofHHP', setGridIMEIJsonObject);
			$('frmIMEIofHHP').src.value = "";
		}else{
			setIMEIChangeEventFromGMES(getHHPInfoFromGMESAsync($("IMEI").value));
		}	
	} else {
		return;
	}
}

function getHHPInfoFromGMESAsync(imei) {
	var returnData = "";
	var paramMap = {};
	paramMap.TYPE = "I";
	paramMap.SERIAL_NO = imei;
	paramMap.HHPYN = "Y";
	$('progressloading').startWaiting();
	
	$j.ajax({
		type : 'post',
		dataType : 'json',
		async : false,
		url : '/svctracking/svcorder/modelBySerialByGMES2ForNonHHP.gspn',
		data : paramMap,
		success : function(data) {
			if (data.esn) {
				returnData = data;
			}else{
				returnData = "";
			}
		},
		error : function(jqXHR, textStatus) {
			// console.log(textStatus);
		}
	});		
	$('progressloading').stopWaiting();
	
	return returnData;
}

function setIMEIChangeEventFromGMES(returnData) {
	try {
		var svcProd = $("SVC_PRCD").value;
		var serial = $("SERIAL_NO").value;
		var imei = $("IMEI").value;
		var model = $("MODEL").value;
		isReturnedGMES = true;
		if (returnData) {
				
			$("UN_IO").value = returnData.unNo;
			//$("DIA_SKU").value = jsonIMEIObj.SKU;
			if("GH82" == returnData.modelNumber.substring(0, 4) 
					|| "AD82" == returnData.modelNumber.substring(0, 4)
					|| "GH81" == returnData.modelNumber.substring(0, 4)){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0270 + returnData.modelNumber);
			}else if(returnData.esn == ""){
				alert(_l.u.WEB_MSG_PREFIX + "Please input IMEI correctly.");
				//IMEI PROJECT
				if(isAutoImei){
					$("IMEI_TXT").value = "";
					$("IMEI").value = "";
				}else{
					$("IMEI").value = "";
				}
				$("UN_IO").value = "";
				$("DIA_SKU").value = "";
				$('progressloading').stopWaiting();
				serialReadOnly(false);
				return;
			}else{
				if($("MODEL").value != returnData.modelNumber){
					$("MODEL").value = returnData.modelNumber;
					modelChange();
				}else{
					$("MODEL").value = returnData.modelNumber;
				}
				$("MODEL").className="inputRO";
				$("MODEL").readOnly = true;
				$("SERIAL_NO").className="inputRO";
				$("SERIAL_NO").readOnly = true;
			}
			if (_l.useGMESHHPByIMEI) {
				// if ($("SERVICE_TYPE").value != "KT") {
				if (svcProd == "HHP02") {
					$("SERIAL_NO").value = $("IMEI").value;
				} else{
					if ('0003429773' == _l.u.AccountCode) {
						$("SERIAL_NO").value = returnData.serialNumber;
					} else {
						if (serial == returnData.serialNumber) {
							$("SERIAL_NO").value = returnData.serialNumber;
						} else if (serial == "M000" || serial == "m000") {
							$("SERIAL_GMES").value = returnData.serialNumber;
						} else {
							alert(_l.u.WEB_MSG_PREFIX + "Wrong IMEI / Serial Number ! Kindly recheck & enter again.");
							//IMEI PROJECT
							if(isAutoImei){
								$("IMEI_TXT").value = "";
								$("IMEI").value = "";
							}else{
								$("IMEI").value = "";
							}
							$("SERIAL_NO").value = "";
							$("UN_IO").value = "";
							$("DIA_SKU").value = "";
							$('progressloading').stopWaiting();
							serialReadOnly(false);
							return;
						}
					}
				}
				// }// if($("SERVICE_TYPE").value!="KT"){
			} else {
				if(serial == returnData.serialNumber){
					$("SERIAL_NO").value = returnData.serialNumber;
				}else {
					if(_l.u.c == "C813" || _l.u.c == "C820"){
						alert(_l.u.WEB_MSG_PREFIX + "Invalid Serial No.");
						//IMEI PROJECT
						if(isAutoImei){
							$("IMEI_TXT").value = "";
							$("IMEI").value = "";
						}else{
							$("IMEI").value = "";
						}
						$("SERIAL_NO").value = "";
						$("UN_IO").value = "";
						$("DIA_SKU").value = "";
						$('progressloading').stopWaiting();
						serialReadOnly(false);
						return;
					}else{
						if (returnData.serialNumber == '') {
							alert(_l.u.WEB_MSG_PREFIX + "Wrong IMEI / Serial Number ! Kindly recheck & enter again.");
							//IMEI PROJECT
							if(isAutoImei){
								$("IMEI_TXT").value = "";
								$("IMEI").value = "";
							}else{
								$("IMEI").value = "";
							}
							$("SERIAL_NO").value = "";
							$("UN_IO").value = "";
							$("DIA_SKU").value = "";
							$('progressloading').stopWaiting();
							serialReadOnly(false);
							return;
						} else {
							$("SERIAL_NO").value = returnData.serialNumber;
						}
					}
				}
			}
			// Search 돋보기 버튼도 보이면 안됨
			if(_l.u.c == "C370"){
				// $("modelSearchImg").style.display='none';
				// $("serialSearchImg").style.display='none';
				$j("#aModelSearch").hide();
				$j("#SERIAL_NO_ICON").hide();
			}	
		} else {
			$("UN_IO").value = "";
			
			if (_l.useGMESHHPByIMEI || _l.u.c == "C813" || _l.u.c == "C820") {
				$('progressloading').startWaiting();
				$('frmIMEIofHHP').cmd.value = "CheckImeiMesCmd";
				$('frmIMEIofHHP').imei.value = imei;
				$('frmIMEIofHHP').model.value = model;
				AjaxRequest(urlPatternGZIP, 'frmIMEIofHHP',
						setCheckImeiMesCmdJsonObject);
			} else {
				alert(_l.u.WEB_MSG_PREFIX + "Invaild IMEI No.");
				if("EA" == _l.u.subRegionCd ){
					//IMEI PROJECT
					if(isAutoImei){
						$("IMEI_TXT").value = "";
						$("IMEI").value = "";
					}else{
						$("IMEI").value = "";
					}
					$("SERIAL_NO").value = "";
					serialReadOnly(false);
				}
				$('progressloading').stopWaiting();
				return;
			}
		}
	getManagedSvc();
	} catch (e) {
	}
	$('progressloading').stopWaiting();
}

function haveTocheckIMEIforHHP(CurrStatus, isHHPProduct, SERVICE_TYPE, HQ_SVC_PRCD){
	var check = false;
	check =  	!(CurrStatus == "ST040" || CurrStatus == "ST035") && isHHPProduct;
	if(_l.u.c != "C550"){
		check = check && HQ_SVC_PRCD != "THB32" && HQ_SVC_PRCD != "THB35";
	}
	
	return check;
}


function setCheckWtyTrue() {
	checkWarranty = true;
}

function setGridIMEIJsonObject(response) {
	
	//china version intergration 2016/08/19 js1.baek
	if(_l.u.isChinaRegion){
		
		exportHK = false;
		$('progressloading').stopWaiting();
		var jsonIMEIObj = response.responseText.evalJSON();
		jsonIMEICheckObj = jsonIMEIObj;
		
		function isTypeCDMA() {
			var flag = false;
			var localSvcPrd = $j('[name=detailForm] #SVC_PRCD').val();
			
			if(localSvcPrd=='THBA1'/*Feature Phone(CDMA)*/ || localSvcPrd=='THBB1'/*Smart Phone(CDMA)*/ || localSvcPrd=='THBB5'/*Smart Phone(CDMA)*/|| 
					localSvcPrd=='THB01'/*CDMA*/ || localSvcPrd=='THB06'/*WORLD PHONE*/ || 
					localSvcPrd=='THB11'/*CDMA 2.0G*/ || localSvcPrd=='THB21'/*CDMA 2.5G*/ || localSvcPrd=='THBB3'/*CDMA 2.5G*/ || localSvcPrd=='THB33'){
				flag = true;
			}
			return flag;
		}
		
		if (jsonIMEIObj.success) {
			if(jsonIMEIObj.sysFrom == "Q"){
				$("MODEL").value = jsonIMEIObj.model;
				$j("#SERIAL_NO").val(jsonIMEIObj.serial);
			}
			if(jsonIMEIObj.model && jsonIMEIObj.model!='-' && jsonIMEIObj.model!=''){
				
				if(jsonIMEIObj.model.substr(0,2)=='GH' || jsonIMEIObj.model.substr(0,2)=='AD'){
					//jsonIMEIObj.model;//item - parts code
					//jsonIMEIObj.model2//model name
					if(jsonIMEIObj.sysFrom == "Q"){
						$("MODEL").value = jsonIMEIObj.model2;
						searchModelInfoForImeiModelChange();
					}
					var modelChk = !(jsonIMEIObj.model2 == 'NONE' && isTypeWiFi()/*Wi-Fi*/);
					if(modelChk && $("MODEL").value != jsonIMEIObj.model2){//model name not equal..(model code or exept model name)
						//model name compare..
						if($j("#MODEL_NAME").val().substr(0,7) != jsonIMEIObj.model2.substr(0,7) && 
								!checkExeptModel($j("#MODEL_NAME").val(),jsonIMEIObj.model2)/*$j("#ANY_MODEL").val() != jsonIMEIObj.model2*/){
							alert(_l.u.WEB_MSG_PREFIX + "Wrong Model Name.["+$j("#MODEL_NAME").val()+']:['+jsonIMEIObj.model2+']');
							resetImeiSerial();
							return;
						}
					}
					
					if($("MODEL").value == $j("#MODEL_NAME").val()){
						//model name input case -- search model code..
						searchPopHhpModelCode();
					}
				}else{
					//jsonIMEIObj.model;//item - model code
					//jsonIMEIObj.model2//model name
					// model or model2 == input model
					if(jsonIMEIObj.sysFrom == "Q"){
						$("MODEL").value = jsonIMEIObj.model;
						searchModelInfoForImeiModelChange();
					}
					if( $("MODEL").value == jsonIMEIObj.model /* model code compare.. */ 
						|| $("MODEL").value == jsonIMEIObj.model2 /* model name compare.. */
					){
						if($("MODEL").value != jsonIMEIObj.model){/*model name != model code*/
							$("MODEL").value = jsonIMEIObj.model;//model name to model code convert..
							searchModelInfoForImeiModelChange();
							if(!validImeiModelChange){
								resetImeiSerial();
								return;
							}
						}
					}
					else if(checkExeptModel($j("#MODEL_NAME").val(),jsonIMEIObj.model2)/*$j("#ANY_MODEL").val() == jsonIMEIObj.model2*/ /*except model name*/){
						if($("MODEL").value == 'SCH-W2013' && jsonIMEIObj.model2 == 'SCH-W889'){
							$("MODEL").value = 'SCH-W2013IDCTC';
						}
						if($("MODEL").value == $j("#MODEL_NAME").val()){
							//model name input case -- search model code..
							searchPopHhpModelCode();
						}
					}
					else{
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.B2C_MSG_0034/*Wrong Model No !!*/);
						resetImeiSerial();
						return;
					}
				}
			}
			
			if(jsonIMEIObj.serial && jsonIMEIObj.serial!='-' && jsonIMEIObj.serial!=''){
				var serial = $j("#SERIAL_NO").val();
				if(serial == "M000" || serial == "m000"){
					
				}
				else if($j("#SERIAL_NO").val().toUpperCase().trim()/**/ != jsonIMEIObj.serial/*prod_sn*/){
					/* no serial skip case*/
					if( isTypeCDMA() || /*CDMA */
							isTypeWiFi()/*Wi-Fi*/ ){
						
						if($j("#SERIAL_NO").val() != $j("#IMEI").val()){
							alert(_l.u.WEB_MSG_PREFIX + _l.r.m.B2C_MSG_0033/*Wrong IMEI / Serial Number !!*/);
							resetImeiSerial();
							return;
						}
					}
					else {
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.B2C_MSG_0033/*Wrong IMEI / Serial Number !!*/);
						resetImeiSerial();
						return;
					}
				}else{ //$j("#SERIAL_NO").val() == jsonIMEIObj.serial/*prod_sn*/
					if( !( isTypeCDMA() || /*CDMA */
							isTypeWiFi()/*Wi-Fi*/) ){
						if($j("#IMEI").val() == jsonIMEIObj.serial/*prod_sn*/){
							alert(_l.u.WEB_MSG_PREFIX + _l.r.m.B2C_MSG_0032/*Wrong IMEI !!*/);
							resetImeiSerial();
							return;
						}
					}
				}
			}
			
			if(jsonIMEIObj.unNum != ""){
			$("UN_IO").value = jsonIMEIObj.unNum;
			}
			if(jsonIMEIObj.countryCode && jsonIMEIObj.countryCode!='-' && jsonIMEIObj.countryCode!='')
				$j("#SOLD_COUNTRY_CODE").val(jsonIMEIObj.countryCode);
			
			if(jsonIMEIObj.countryCode=='HK'){
				exportHK = true;
				$j("#SOLD_COUNTRY_CODE").val('HK');
			}
			$j("#overseas").val(jsonIMEIObj.overseas);
			$("SALES_BUYER").value = jsonIMEIObj.sales_buyercode;
			if(isNewChina) SBSCIMEICheck();
			
		}
		else {
			if(jsonIMEIObj.returnCode == 'SE'){
				alert(_l.u.GERP_MSG_PREFIX + "IMEI check : "+jsonIMEIObj.returnMessage);
				resetImeiSerial();
			}
			else{
				imeiMessage = jsonIMEIObj.returnMessage;
				ZCSPT_GET_MES_INFO();
			}
		}
		
		if($j('[name=detailForm] #prod_category').val()=='HHP' && !($j("#SOLD_COUNTRY_CODE").val() =='CN'|| $j("#SOLD_COUNTRY_CODE").val() == 'HK'|| $j("#SOLD_COUNTRY_CODE").val() == ''|| $j("#SOLD_COUNTRY_CODE").val() == '--')){
			if($('WTY_EXCEPTION').value == 'OTWE1'){
				
			}else{
//				$('detailForm').WTY_EXCEPTION.disabled = true;
//				$('WTY_EXCEPTION').value = 'VOID4';
			}
		}
		searchedIMEI = $j('#IMEI').val();
		
		if(_l.useBudsSerial){
	        // buds logic
	        if($("HQ_SVC_PRCD").value == "THB96" || $("HQ_SVC_PRCD").value == "THBZ6" || $("HQ_SVC_PRCD").value == "THB80"){
	        	checkBudsSn();
	        }
		}
        
		return;
	}//if(_l.u.isChinaRegion){
	
	try {
		var jsonIMEIObj = response.responseText.evalJSON();
		var svcProd = $("SVC_PRCD").value;
		var serial = $("SERIAL_NO").value;
		var imei = $("IMEI").value;
		var model = $("MODEL").value;
		isReturnedGMES = true;
		//var checkD2D = $("STATUS").value == "ST015" && _l.SERVICE_TYPE == "PS" && D2D 체크로직 추가;
		var checkD2D = _l.isIndia && _l.isHHPIndia && $("STATUS").value == "ST015" && _l.SERVICE_TYPE == "PS" && _l.shipMethod == "01";
		
		if (jsonIMEIObj.success) {
			
			if($('frmIMEIofHHP').system.value == "SMES"){
				
				$("MODEL").value = jsonIMEIObj.esnInfo.model;			
				$("SERIAL_NO").value = jsonIMEIObj.esnInfo.MSER;
				// DECIMAL MEID : 18, IMEI : 15
				if(imei.length == 18){
					//IMEI PROJECT
					if(isAutoImei){
						$("IMEI_TXT").value = markIMEI(jsonIMEIObj.esnInfo.imei);
						$("IMEI").value = jsonIMEIObj.esnInfo.imei;
					}else{
						$("IMEI").value = jsonIMEIObj.esnInfo.imei;
					}
				}
				
				$("MODEL").className="inputRO";
				$("MODEL").readOnly = true;
				$("SERIAL_NO").className="inputRO";
				$("SERIAL_NO").readOnly = true;
			}else{
				
				$("UN_IO").value = jsonIMEIObj.unNum;
				$("DIA_SKU").value = jsonIMEIObj.SKU;
				if("GH82" == jsonIMEIObj.model.substring(0, 4) 
						|| "AD82" == jsonIMEIObj.model.substring(0, 4)
						|| "GH81" == jsonIMEIObj.model.substring(0, 4)){
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0270 + jsonIMEIObj.model);
				}else if(!jsonIMEIObj.isCorrectInputIMEI){
					alert(_l.u.WEB_MSG_PREFIX + "Please input IMEI correctly.");
					//IMEI PROJECT
					if(isAutoImei){
						$("IMEI_TXT").value = "";
						$("IMEI").value = "";
					}else{
						$("IMEI").value = "";
					}
					$("UN_IO").value = "";
					$("DIA_SKU").value = "";
					$('progressloading').stopWaiting();
					serialReadOnly(false);
					return;
				}else{
					var selectedModel = jsonIMEIObj.model;
                	if(jsonIMEIObj.salesModel == $("MODEL").value || jsonIMEIObj.manufacturingModel == $("MODEL").value){
                		if(jsonIMEIObj.salesModel == $("MODEL").value){
                			selectedModel = jsonIMEIObj.salesModel;
                		}else{
                			selectedModel = jsonIMEIObj.manufacturingModel;
                		}
                	}else{
                		if(jsonIMEIObj.isExistSalesModel == 'Y' && jsonIMEIObj.isSameBetweenSalesAndManufacturing == 'N'){
                    		if(confirm("Please confirm if the model is " + jsonIMEIObj.salesModel +"\n"+"Confirm"+" : " + jsonIMEIObj.salesModel+"\n"+"Cancel"+" : " + jsonIMEIObj.manufacturingModel)){
                    			selectedModel = jsonIMEIObj.salesModel;
                    		}else{
                    			selectedModel = jsonIMEIObj.manufacturingModel;
                    		}
                    	}
                	}
					
					if($("MODEL").value != selectedModel){
						$("MODEL").value = selectedModel;
						modelChange();
						if(_l.u.c != "C370"){
							//IMEI PROJECT
							if(isAutoImei){
								$("IMEI_TXT").value = "";
								$("IMEI").value = "";
							}else{
								$("IMEI").value = "";
							}
						}
					}else{
						$("MODEL").value = selectedModel;
						$j("#aModelSearch").hide();
						// d2d
						if(!checkD2D){
							$j("#SERIAL_NO_ICON").hide();
						}
					}
					$("MODEL").className="inputRO";
					$("MODEL").readOnly = true;
					// d2d
					if(!checkD2D){
						$("SERIAL_NO").className="inputRO";
						$("SERIAL_NO").readOnly = true;
					}
				}
				if (_l.useGMESHHPByIMEI) {
					// if ($("SERVICE_TYPE").value != "KT") {
					if (svcProd == "HHP02") {
						$("SERIAL_NO").value = $("IMEI").value;
					} else{
						if ('0003429773' == _l.u.AccountCode) {
							$("SERIAL_NO").value = jsonIMEIObj.serial;
						} else {
							if (serial == jsonIMEIObj.serial) {
								$("SERIAL_NO").value = jsonIMEIObj.serial;
							} else if (serial == "M000" || serial == "m000") {
								$("SERIAL_GMES").value = jsonIMEIObj.serial;
							} else {
								alert(_l.u.WEB_MSG_PREFIX + "Wrong IMEI / Serial Number ! Kindly recheck & enter again.");
								//IMEI PROJECT
								if(isAutoImei){
									$("IMEI_TXT").value = "";
									$("IMEI").value = "";
								}else{
									$("IMEI").value = "";
								}
								$("SERIAL_NO").value = "";
								$("UN_IO").value = "";
								$("DIA_SKU").value = "";
								$('progressloading').stopWaiting();
								serialReadOnly(false);
								return;
							}
						}
					}
					// }// if($("SERVICE_TYPE").value!="KT"){
				} else {
					if(serial == jsonIMEIObj.serial){
						$("SERIAL_NO").value = jsonIMEIObj.serial;
					}else {
						if(_l.u.c == "C813" || _l.u.c == "C820"){
							alert(_l.u.WEB_MSG_PREFIX + "Invalid Serial No.");
							//IMEI PROJECT
							if(isAutoImei){
								$("IMEI_TXT").value = "";
								$("IMEI").value = "";
							}else{
								$("IMEI").value = "";
							}
							$("SERIAL_NO").value = "";
							$("UN_IO").value = "";
							$("DIA_SKU").value = "";
							$('progressloading').stopWaiting();
							serialReadOnly(false);
							return;
						}else{
							if (jsonIMEIObj.serial == '') {
								alert(_l.u.WEB_MSG_PREFIX + "Wrong IMEI / Serial Number ! Kindly recheck & enter again.");
								//IMEI PROJECT
								if(isAutoImei){
									$("IMEI_TXT").value = "";
									$("IMEI").value = "";
								}else{
									$("IMEI").value = "";
								}
								$("SERIAL_NO").value = "";
								$("UN_IO").value = "";
								$("DIA_SKU").value = "";
								$('progressloading').stopWaiting();
								serialReadOnly(false);
								return;
							} else {
								$("SERIAL_NO").value = jsonIMEIObj.serial;
							}
						}
					}
				}
				
				$j("#overseas").val(jsonIMEIObj.overseas);
				$("SALES_BUYER").value = jsonIMEIObj.sales_buyercode;
				var shipToByDoNum = jsonIMEIObj.do_num;
            	var otherBuyerService = false;
            	if(shipToByDoNum.indexOf("0003260137") > -1 || shipToByDoNum.indexOf("0001421296") > -1 || shipToByDoNum.indexOf("0002453273") > -1){
            		if('0003260137'==_l.u.AccountCode || '0001421296'==_l.u.AccountCode){
            			if(shipToByDoNum.indexOf("0002453273") > -1){
            				otherBuyerService = true;
            			}
            		}
            		if('0002453273'==_l.u.AccountCode || '0002452867'==_l.u.AccountCode){
            			if(shipToByDoNum.indexOf("0003260137") > -1 || shipToByDoNum.indexOf("0001421296") > -1){
            				otherBuyerService = true;
            			}
            		}
            		if(otherBuyerService){
            			alert("Your company did not sell this product. Please check warranty process with your admin.");
            		}
            	}
				
				if(_l.u.c == "C713"){
					if(jsonIMEIObj.wtyException == "VOID4"){
	            		alert(_l.u.WEB_MSG_PREFIX + "This Product is not allowed in warranty.");
	                    setComboValue($('detailForm').WTY_EXCEPTION, "VOID4");
	                    $('detailForm').WTY_EXCEPTION.disabled = true;
	            	}
	            }
			}
			// Search 돋보기 버튼도 보이면 안됨
			if(_l.u.c == "C370"){
				// $("modelSearchImg").style.display='none';
				// $("serialSearchImg").style.display='none';
				$j("#aModelSearch").hide();
				$j("#SERIAL_NO_ICON").hide();
			}	
		} else {
			
			if($('frmIMEIofHHP').system.value == "SMES"){
                if($('frmIMEIofHHP').model.value == ''){
                    $('frmIMEIofHHP').model.value = 'test11';
                }
                $('frmIMEIofHHP').system.value = "MPTS";
                $('frmIMEIofHHP').cmd.value = "GetIMEIofHHPCmd";
                $('progressloading').startWaiting();
                AjaxRequest(urlPatternGZIP,'frmIMEIofHHP', setGridIMEIJsonObject); // EHN05
                
            }else{
            	$("UN_IO").value = "";
            	
            	if(jsonIMEIObj.returnCode == "M"){
            		alert(_l.u.WEB_MSG_PREFIX + jsonIMEIObj.returnMessage);
            		//IMEI PROJECT
    				if(isAutoImei){
    					$("IMEI_TXT").value = "";
    					$("IMEI").value = "";
    				}else{
    					$("IMEI").value = "";
    				}
            		if($("useMOTPforMPTS") != null && $("useMOTPforMPTS")  != undefined  && $("useMOTPforMPTS").value == "true"){
            			$("masterOTP").value = "";
            		}
            		$('progressloading').stopWaiting(); 
            		return;
            	}
            	
    			if (_l.useGMESHHPByIMEI || _l.u.c == "C813" || _l.u.c == "C820") {
    				$('progressloading').startWaiting();
    				$('frmIMEIofHHP').cmd.value = "CheckImeiMesCmd";
    				$('frmIMEIofHHP').imei.value = imei;
    				$('frmIMEIofHHP').model.value = model;
    				AjaxRequest(urlPatternGZIP, 'frmIMEIofHHP',
    						setCheckImeiMesCmdJsonObject);
    			} else {
    				//IMEI PROJECT
    				if(isAutoImei){
    					$("IMEI_TXT").value = "";
    					$("IMEI").value = "";
    				}else{
    					$("IMEI").value = "";
    				}
    				$("SERIAL_NO").value = "";
    				serialReadOnly(false);
    				$('progressloading').stopWaiting();
    				return;
    			}
            }
			
			
		}
		
	if(_l.useBudsSerial){
	    // buds logic
	    if($("HQ_SVC_PRCD").value == "THB96" || $("HQ_SVC_PRCD").value == "THBZ6" || $("HQ_SVC_PRCD").value == "THB80"){
	    	checkBudsSn();
	    }
	}
    
	getManagedSvc();
	} catch (e) {
	}
	$('progressloading').stopWaiting();
	
}

function setCheckImeiMesCmdJsonObject(response) {
	try {
		var jsonObjImei = response.responseText.evalJSON();
		var svcProd = $("SVC_PRCD").value;
		var serial = $("SERIAL_NO").value;
		isReturnedGMES = true;
		if (jsonObjImei.success) {
			$("MODEL").value = jsonObjImei.ptList[0].model;
			$("SERIAL_NO").value = jsonObjImei.ptList[0].serialNo;
			$("SOLD_COUNTRY_CODE").value = jsonObjImei.ptList[0].country
					.toUpperCase();
			if($("SOLD_COUNTRY_CODE").value == _l.u.CountryCd){
				$j("#overseas").val("N");
			}else{
				$j("#overseas").val("Y");
			}
			$("MODEL").className = "inputRO";
			$("MODEL").readOnly = true;
			$("SERIAL_NO").className = "inputRO";
			$("SERIAL_NO").readOnly = true;
		} else {

			$("SERIAL_NO").value = "";
			$("PRODUCT_DATE").value = "";
			$("SOLD_COUNTRY_CODE").value = "";
			$("SERIAL_GMES").value = "";
			//IMEI PROJECT
			if(isAutoImei){
				$("IMEI_TXT").value = "";
				$("IMEI").value = "";
			}else{
				$("IMEI").value = "";
			}
			serialChange();

			if (jsonObjImei.error) {
				cfExceptionPop(jsonObjImei);
			}
			isReturnedGMES = true;

			// if(confirm("Incorrect IMEI number entered,Pls Re-Check & Enter
			// correct Model/IMEI number.")){
			if (confirm(_l.u.WEB_MSG_PREFIX +"This IMEI # Serial # are not authorized")) {
				serialReadOnly(false);
				//IMEI PROJECT
				if(isAutoImei){
					$("IMEI_TXT").select();
				}else{
					$("IMEI").select();
				}
			}

			$("MODEL").className = "inputIDS";
			$("MODEL").readOnly = false;
			$("SERIAL_NO").removeClassName('inputRO');
			$("SERIAL_NO").addClassName('inputIDS');
			$("SERIAL_NO").readOnly = false;
		}

	} catch (e) {
	}
	$('progressloading').stopWaiting();
}

function purchaseDateChange(obj) {
	setCheckWtyTrue();
	// 2011.10.11 추가
	// 법인:C550, Service type : KT인경우 유저가 Purchase date을 입력하려고 할 경우. 'You can not
	// input purchase date for KT call.'이라는 메시지 출력

	var SERVICE_TYPE = $("SERVICE_TYPE").value;
	// START : C19050007571 [GSPN] Purchase date editable in SVC type KT for Network Product
	var svcProd = $('SVC_PRCD').value.substring(0, 3);
	var serviceTypeNotNeedPD = ((SERVICE_TYPE == "KT" && svcProd != "NEX") || SERVICE_TYPE == "SR");
	// END   : C19050007571 [GSPN] Purchase date editable in SVC type KT for Network Product
	if(_l.u.c =="C550" && serviceTypeNotNeedPD	){
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.SERVICE_KT + " KT & SR");
		obj.value='';
	    return false;
	}

	var objDesc = _l.r.c.LBL_00624;
	if (!checkDateIsCorrectAndNotFuther(obj, objDesc)) {
		checkWarranty = true;
		obj.focus();
		return false;
	}

	// 수정 2011.07.13일 product Date > purchase Date 경우 에러 발생으로 변경
	var PRODUCT_DATE = $('PRODUCT_DATE').value;

	// if product date is empty then product_date is 00000000. so below
	// compairision logic can work
	// 인도의 경우 생산일자보다 구매일자가 앞설 경우 Attachment list 에 파일이 최소 1개 이상 있어야 함으로
	// 수정(2011.11.30 confirmed by amy.kim, modified by Kwon.)
	if (!checkFromToDate(PRODUCT_DATE, obj.value, _l.u.DateFormat2)) {
		if (_l.u.c == "C550" || _l.u.subRegionCd == "EU") {
			if ($('attachTableBody').rows.length < 1) {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0101);
				return false;
			}
		} else{
			//구매일자 변경시 생산일자와 비교는 SAVE verify 시 체크. certi 존재여부 체크 필요위함
		}
	}

	var dateFormat = _l.u.DateFormat;
	if (_l.u.c == "C550"
			&& checkDate($("PURCHASE_DATE").value, dateFormat)
			&& checkDate($("ASC_ASSIGN_DATE").value, dateFormat)
			&& !checkFromToDate($("PURCHASE_DATE").value,
					$("ASC_ASSIGN_DATE").value, dateFormat)) {

		alert(_l.u.WEB_MSG_PREFIX + "Purchase Date[" + $("PURCHASE_DATE").value
				+ "] cannot be later than ASC Assigned Date["
				+ $("ASC_ASSIGN_DATE").value + "].");
		$("PURCHASE_DATE").value = "";
		$("PURCHASE_DATE").focus();
		return false;
	}
}

function checkDateIsCorrectAndNotFuther(obj, objDesc) {
	var dateFormat = _l.u.DateFormat2;

	if (!checkDate(obj.value, dateFormat)) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHK_DATEFORMAT + objDesc);
		obj.value = '';
		return false;
	}

	if (!checkFromToDate(obj.value, _l.today, dateFormat)) {
		alert(_l.u.WEB_MSG_PREFIX + "Please check the " + objDesc + "[" + obj.value + "] : "
				+ _l.r.m.CANT_SELECTED); // 미래날짜는 안됨
		obj.value = '';
		return false;
	}

	return true;
}

