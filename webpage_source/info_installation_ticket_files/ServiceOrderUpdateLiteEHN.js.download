//START : C20070006277 HHP pick up process enhancement
function checkDistance(){
	var DistanceExist = false;
	var svcProd = $("SVC_PRCD").value;
	var isHHPProduct = ("HHP01,HHP05,HHP06".indexOf(svcProd) != -1);
	var isStatus = ("ST035|ST040".indexOf($('STATUS').value) != -1);
	var serviceType = $("SERVICE_TYPE").value;
	var isServiceType = ("PS".indexOf(serviceType) != -1);
	var dataOriginCode = $('DATA_ORIGIN_CODE').value;
	if ($("DISTANCE").value != "") {
		DistanceExist = true;
	}
	if (DistanceExist) {
			if (isHHPProduct && isStatus && isServiceType && "I" == dataOriginCode) {
					alert(_l.u.WEB_MSG_PREFIX + "Cant save, Freight selection not allowed");
            		return false;
       		}
   	 }
	return true;
}
// END : C20070006277 HHP pick up process enhancement

function showFeedBack(){
	$j('#tbodyRecommendedParts').html('');
	$j('#tbodyUsedParts').html('');
	function getRecommendedFromProactive(type) {
		$('progressloading').startWaiting();
		var valid = false;
		var url = urlPatternGZIP;
		if(bomVersion == ""){
			bomVersion = getVersionFromGMES();
		}
		var param = '&objectID=' + _l.ObjectId+'&type=' + type;
		
		var data = "cmd=GetRecommendedFromProactiveCmd" + param;
		$j.ajax({
			type : "POST",
			async : false, /* 동기 */
			url : url,
			data : data,
			success : function(data) {
				if (data.success && data.result !='fail') {
					valid = true;
					var length = data.result.length;
					var index = 1;
					var usedPartCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
					
					for ( var i = 0; i < length; i++) {
						var qGuide = false;
						if(data.result[i].q_guide != null) {
							qGuide = true;
						}
						if(data.result[i].partCode.toLowerCase() == "no parts usage required") {
							if(usedPartCodes.length > 0) {
								data.result[i].used = "";
								data.result[i].notUsed = "checked";
								if(!qGuide) {									
									data.result[i].disabled = "";
								} else {
									data.result[i].disabled = "disabled";
								}							
							} else {								
								data.result[i].used = "checked";
								data.result[i].notUsed = "";
								data.result[i].disabled = "disabled";
							}
						} else {
							if(usedPartCodes.length == 0) {
								data.result[i].used = "";
								data.result[i].notUsed = "checked";
								if(!qGuide) {									
									data.result[i].disabled = "";
								} else {
									data.result[i].disabled = "disabled";
								}
							} else {								
								for ( var j = 0; j < usedPartCodes.length; j++) {
									if (data.result[i].partCode == $j.trim($j(usedPartCodes[j]).val())) {
										data.result[i].used = "checked";
										data.result[i].notUsed = "";
										data.result[i].disabled = "disabled";
										break;
									} else if(j == usedPartCodes.length-1) {
										data.result[i].used = "";
										data.result[i].notUsed = "checked";
										if(!qGuide) {									
											data.result[i].disabled = "";
										} else {
											data.result[i].disabled = "disabled";
										}
									}
								}
							}
						}
					}


					for ( var i = 0; i < length; i++) {
						var obj = data.result[i];
						var $tr	= $j("<tr></tr>");
						
						$tr.append($j("<td class='td_ac'>" + obj.no + "</td>"));
						$tr.append($j("<td class='td_ac'>" + obj.partCode+"</td>"));
						
						if(obj.q_guide == null){
							$tr.append($j("<td class='td_ac' title="+obj.partDesc+">" + obj.partDesc+"<input name='usefulYn' type='hidden' value=''></td>"));
							$tr.append($j("<td class='td_ac'><input class='c_partsRecommendationSuccessYn' name='partsRecommendationSuccessYn"+i+"' type='radio' value='Y'" + obj.used +" disabled> Used"
									+ "<input name='partsRecommendationSuccessYn"+i+"' type='radio' value='N'" + obj.notUsed + " disabled > Not Used</td>"
									+ "<input name='partsRecommendationSuccessYn' type='hidden' value='Y'></td>"));
						}else{
							$tr.append($j("<td class='td_ac'>" + "Q-guide"+"<input name='usefulYn' type='hidden' value='Y'></td>"));
							$tr.append($j("<td class='td_ac'><input class='c_partsRecommendationSuccessYn' name='partsRecommendationSuccessYn"+i+"' type='radio' value='Y' " + obj.used +" disabled> Used"
									+ "<input name='partsRecommendationSuccessYn"+i+"' type='radio' value=''" + obj.notUsed + " disabled> Not Used</td>"
									+ "<input name='partsRecommendationSuccessYn' type='hidden' value=''></td>"));
						}
						
						var selectObj = $j("<select id=\"partsRecommendationReason\" name=\"partsRecommendationReason\" class=\"select\" " + obj.disabled + " style=\"width:99%\"></select>");
						var defaultOption = $j("<option/>").val("").text("----Select reason----");
						defaultOption.appendTo(selectObj);
						$j.each(_l.partRecommendFailReasonArray, function(idx, val){
							var option = $j("<option/>").val(_l.partRecommendFailReasonArray[idx].codeId)
							.text(_l.partRecommendFailReasonArray[idx].codeName); 
							option.appendTo(selectObj);
						});
						var $tdSelect = $j("<td class='td_ac'></td>");
						selectObj.appendTo($tdSelect);
						$tr.append($tdSelect);
						$j('#tbodyRecommendedParts').append($tr);
					}
				} else {
					valid = false;
				}
			},
			dataType : 'json'
		});
		$('progressloading').stopWaiting();
		return valid;
	}// getRecommendedFromProactive()
	if(getRecommendedFromProactive("FEEDBACK")){
		
	}else{
		callDetail();
		return;
	}
	
	//draw used parts list
	var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
	var partDescs = $j('#partsTableBody input[name="PARTS_DESC"]');
	for ( var i = 0; i < partCodes.length; i++) {
		var partCode = $j.trim($j(partCodes[i]).val());
		var partDesc = $j.trim($j(partDescs[i]).val());
		var $tr	= $j("<tr></tr>");
		$tr.append($j("<td class='td_ac'>" + partCode + "</td>"));
		$tr.append($j("<td class='td_ac'>" + partDesc+"</td>"));
		$j('#tbodyUsedParts').append($tr);
	}
	
	$j('#divFeedbackInfo').css('left', $j(window).width()/2-350);
	$j('#divBlock').show();
	$j('#divFeedbackInfo').show();
	
	
	//changeFeedbackReason('Y');
	
	if($("SERVICE_TYPE").value == "IH"){
		$j("#trFTC").css("display","inline-block");
		setFTCReason("Y");
	}else{
		$j("#trFTC").css("display","none");
		$j("[name=firstTimeCompletionSuccessYn]").val("");
	}
}

