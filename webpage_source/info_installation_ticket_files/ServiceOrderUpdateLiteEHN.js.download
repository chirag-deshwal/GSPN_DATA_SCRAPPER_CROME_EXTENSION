function openDistyPartTrackingPop(){
	var url = "";
	var ticket_no = _l.ObjectId;
	
	if (isRunningOnOperation) {
		url += "https://www.samsungasc.com/nawss/rs/disty/DistyPartsTracking/";
	} else {
		url += "https://www.samsungasc.com/nawss/rsdev/disty/DistyPartsTracking/";
	}
	
	url += ticket_no;
	w = window.open(url,"open_distyPartTracking", "toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=0,left=0,width=800,height=600");
	w.focus();
}
