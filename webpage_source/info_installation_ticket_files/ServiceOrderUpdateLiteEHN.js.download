function selectEngineerFromSchedule(engineer) {
	if (_l.inventoryFlag && _l.hasGiPostingPart) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.CHANGE_ENGINEER_GIPOSTING);
		return false;
	} else {
		if($('sENGINEER').options.length==0 || ( $('sENGINEER').options.length==1 && $('sENGINEER').options[0].value=='' )){
			alert(_l.u.WEB_MSG_PREFIX + "Wrong Selected Engineer.");
