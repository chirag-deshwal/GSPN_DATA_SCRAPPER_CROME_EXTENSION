function open_repairAssistance() {
	var userId = _l.u.UserId;
	var frm = $('detailForm');
	var modelCode = frm.MODEL.value;
	var symptom1 = frm.SYMPTOM_CAT1.value;
	var symptom2 = frm.SYMPTOM_CAT2.value;
	var symptom3 = frm.SYMPTOM_CAT3.value;
	if (_l.u.c == "C310" || _l.u.c == "C370") {
		var symptom4 = frm.SYMPTOM_CAT4.value;
		var url = 'http://support-us.samsung.com/partner/tr/ps.jsp?acct='
				+ userId + '&prd_mdl_cd=' + modelCode + '&sym_code1='
				+ symptom1 + '&sym_code2=' + symptom2 + '&sym_code3='
				+ symptom3 + '&sym_code4=' + symptom4;
	} else {
		var url = 'http://support-us.samsung.com/partner/tr/ps.jsp?acct='
				+ userId + '&prd_mdl_cd=' + modelCode + '&sym_code1='
				+ symptom1 + '&sym_code2=' + symptom2 + '&sym_code3='
				+ symptom3;
	}

	open_window_w = window
			.open(
					url,
					'open_repairAssistance',
					'toolbar=yes,location=yes,directories=yes,status=yes,menubar=yes,resizable=yes,copyhistory=no,scrollbars=yes,top=0,left=0,width=800,height=600');
	open_window_w.focus();
}

