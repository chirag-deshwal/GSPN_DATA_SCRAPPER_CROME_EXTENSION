function newImeiChange() {
	
	var newImei = $("NEW_IMEI").value;
	var newModel = $("NEW_MODEL").value;
	var model = $("MODEL").value;
	var newSerial = $("NEW_SERIAL_NO").value;
	
	if(newImei == "M000" || newImei == "12345678" || newImei == "TEMP" || newImei == "MOOO" || newImei == "11111111" || newImei == "00000000"
		|| newImei.strip().length < 5){
		alert(_l.u.WEB_MSG_PREFIX + "Please input Correct IMEI No.");
		//IMEI PROJECT
		if(isAutoImei){
			$("NEW_IMEI").value = "";
			$("NEW_IMEI_TXT").value = "";
		}else{
			$("NEW_IMEI").value = "";
		}
		return;
	}
	
	$('progressloading').startWaiting();
	$('frmIMEIofHHP').imei.value = newImei;
	$('frmIMEIofHHP').model.value = model;
	
	if(_l.isWorkingMPTS){
		if(_l.u.c == 'C370' && $('detailForm').SERVICE_COMPANY.value == "C370"){
			if($("NEW_IMEI").value == ""){
				//IMEI PROJECT
        		if(isAutoImei){
        			$("NEW_IMEI").value = "";
        			$("NEW_IMEI_TXT").value = "";
        		}else{
        			$("NEW_IMEI").value = "";
        		}
				$("NEW_SERIAL_NO").value = "";
				if(_l.u.c != 'C820'){
					$("aNewModelSearch").style.display='';
				}
				$('progressloading').stopWaiting();
        		return;
        	}
			$('frmIMEIofHHP').system.value = "SMES";
			$('frmIMEIofHHP').imeiP.value = newImei;
			$('frmIMEIofHHP').cmd.value = "GetESNorIMEICmd";
		}else{
			$('frmIMEIofHHP').system.value = "MPTS";
			$('frmIMEIofHHP').cmd.value = "GetIMEIofHHPCmd";
		}						
		AjaxRequest(urlPatternGZIP, 'frmIMEIofHHP', setGridNewIMEIJsonObject);
	}else{
		setNewIMEIChangeEventFromGMES(getHHPInfoFromGMESAsync($("NEW_IMEI").value));
	}
}

function setGridNewIMEIJsonObject(response) {
	try {
		var jsonIMEIObj = response.responseText.evalJSON();
		var newSerial = $("NEW_SERIAL_NO").value;
		var newImei = $("NEW_IMEI").value;
		var newModel = $("NEW_MODEL").value;
		
		if (jsonIMEIObj.success) {
			
			if($('frmIMEIofHHP').system.value == "SMES"){
				
				$("NEW_MODEL").value = jsonIMEIObj.esnInfo.model;			
				$("NEW_SERIAL_NO").value = jsonIMEIObj.esnInfo.MSER;
				// DECIMAL MEID : 18, IMEI : 15
				if(imei.length == 18){
					//IMEI PROJECT
					if(isAutoImei){
						$("NEW_IMEI_TXT").value = markIMEI(jsonIMEIObj.esnInfo.imei);
						$("NEW_IMEI").value = jsonIMEIObj.esnInfo.imei;
					}else{
						$("NEW_IMEI").value = jsonIMEIObj.esnInfo.imei;
					}

				}
				
				$("NEW_MODEL").className="inputRO";
				$("NEW_MODEL").readOnly = true;
				$("NEW_SERIAL_NO").className="inputRO";
				$("NEW_SERIAL_NO").readOnly = true;
			}else{
				if("GH82" == jsonIMEIObj.model.substring(0, 4) 
						|| "AD82" == jsonIMEIObj.model.substring(0, 4)
						|| "GH81" == jsonIMEIObj.model.substring(0, 4)){
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0270 + jsonIMEIObj.model);
				}else if(!jsonIMEIObj.isCorrectInputIMEI){
					alert(_l.u.WEB_MSG_PREFIX + "Please input IMEI correctly.");
					//IMEI PROJECT
					if(isAutoImei){
						$("NEW_IMEI_TXT").value = "";
						$("NEW_IMEI").value = "";
					}else{
						$("NEW_IMEI").value = "";
					}
					$('progressloading').stopWaiting();
					$("NEW_MODEL").className="input";
					$("NEW_MODEL").readOnly = false;
					$("NEW_SERIAL_NO").className="input";
					$("NEW_SERIAL_NO").readOnly = false;
					return;
				}else{
					$("NEW_MODEL").value = jsonIMEIObj.model;
					$("NEW_MODEL").className="inputRO";
					$("NEW_MODEL").readOnly = true;
					$("NEW_SERIAL_NO").className="inputRO";
					$("NEW_SERIAL_NO").readOnly = true;
				}
				if(newSerial == jsonIMEIObj.serial || newSerial == ''){
					$("NEW_SERIAL_NO").value = jsonIMEIObj.serial;
				}else {
					if (jsonIMEIObj.serial == '') {
						alert(_l.u.WEB_MSG_PREFIX + "Wrong IMEI / Serial Number ! Kindly recheck & enter again.");
						//IMEI PROJECT
						if(isAutoImei){
							$("NEW_IMEI_TXT").value = "";
							$("NEW_IMEI").value = "";
						}else{
							$("NEW_IMEI").value = "";
						}
						$("NEW_SERIAL_NO").value = "";
					} else {
						alert(_l.u.WEB_MSG_PREFIX + "Invalid Serial No.");
						//IMEI PROJECT
						if(isAutoImei){
							$("NEW_IMEI_TXT").value = "";
							$("NEW_IMEI").value = "";
						}else{
							$("NEW_IMEI").value = "";
						}
						$("NEW_SERIAL_NO").value = "";
					}
					$('progressloading').stopWaiting();
					return;
				}
			}
			// Search 돋보기 버튼도 보이면 안됨
			if(_l.u.c != "C820"){
				// $("modelSearchImg").style.display='none';
				// $("serialSearchImg").style.display='none';
				$j("#aNewModelSearch").hide();
			}	
		}else{
			alert(_l.u.SAP_MSG_PREFIX + jsonIMEIObj.returnMessage);
			//IMEI PROJECT
			if(isAutoImei){
				$("NEW_IMEI_TXT").value = "";
				$("NEW_IMEI").value = "";
			}else{
				$("NEW_IMEI").value = "";
			}
			$("NEW_SERIAL_NO").value = "";
			$("NEW_MODEL").className="input";
			$("NEW_MODEL").readOnly = false;
			$("NEW_SERIAL_NO").className="input";
			$("NEW_SERIAL_NO").readOnly = false;
			$('progressloading').stopWaiting();
			return;
		}
	}catch (e) {
	}
	$('progressloading').stopWaiting();
}

function setNewIMEIChangeEventFromGMES(returnData) {
	try {
		var newSerial = $("NEW_SERIAL_NO").value;
		var newImei = $("NEW_IMEI").value;
		var newModel = $("NEW_MODEL").value;
		if (returnData) {
			
			if("GH82" == returnData.modelNumber.substring(0, 4) 
					|| "AD82" == returnData.modelNumber.substring(0, 4)
					|| "GH81" == returnData.modelNumber.substring(0, 4)){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0270 + returnData.modelNumber);
			}else if(returnData.esn == ""){
				alert(_l.u.WEB_MSG_PREFIX + "Please input IMEI correctly.");
				//IMEI PROJECT
				if(isAutoImei){
					$("NEW_IMEI_TXT").value = "";
					$("NEW_IMEI").value = "";
				}else{
					$("NEW_IMEI").value = "";
				}
				$('progressloading').stopWaiting();
				return;
			}else{
				$("NEW_MODEL").value = returnData.modelNumber;
				$("NEW_MODEL").className="inputRO";
				$("NEW_MODEL").readOnly = true;
				$("NEW_SERIAL_NO").className="inputRO";
				$("NEW_SERIAL_NO").readOnly = true;
			}
			if(serial == returnData.serialNumber){
				$("SERIAL_NO").value = returnData.serialNumber;
			}else {
				if (returnData.serialNumber == '') {
					alert(_l.u.WEB_MSG_PREFIX + "Wrong IMEI / Serial Number ! Kindly recheck & enter again.");
					//IMEI PROJECT
					if(isAutoImei){
						$("NEW_IMEI_TXT").value = "";
						$("NEW_IMEI").value = "";
					}else{
						$("NEW_IMEI").value = "";
					}
					$("NEW_SERIAL_NO").value = "";
				} else {
					alert(_l.u.WEB_MSG_PREFIX + "Invalid Serial No.");
					//IMEI PROJECT
					if(isAutoImei){
						$("NEW_IMEI_TXT").value = "";
						$("NEW_IMEI").value = "";
					}else{
						$("NEW_IMEI").value = "";
					}
					$("NEW_SERIAL_NO").value = "";
				}
				$('progressloading').stopWaiting();
				return;
			}
			// Search 돋보기 버튼도 보이면 안됨
			if(_l.u.c != "C820"){
				// $("modelSearchImg").style.display='none';
				// $("serialSearchImg").style.display='none';
				$j("#aNewModelSearch").hide();
			}
		}else{
			alert(_l.u.WEB_MSG_PREFIX + "Invalid IMEI No.");
			//IMEI PROJECT
			if(isAutoImei){
				$("NEW_IMEI_TXT").value = "";
				$("NEW_IMEI").value = "";
			}else{
				$("NEW_IMEI").value = "";
			}
			$("NEW_SERIAL_NO").value = "";
			$("NEW_MODEL").className="input";
			$("NEW_MODEL").readOnly = false;
			$("NEW_SERIAL_NO").className="input";
			$("NEW_SERIAL_NO").readOnly = false;
			$('progressloading').stopWaiting();
			return;
		}
	} catch (e) {
	}
	$('progressloading').stopWaiting();
}

function getCenterType(type){
	
	//type 1 : assinged ASC
	//type 2 : default Branch
	//default : default Branch
	clearForm("frm");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	if(type == "1"){
		insertValue("frm", "IV_ASC_CODE", _l.ASC_CODE);
	}else if(type == "2"){
		insertValue("frm", "IV_ASC_CODE", _l.u.DefaultBranch);
	}else{
		insertValue("frm", "IV_ASC_CODE", _l.u.DefaultBranch);
	}
	
	insertValue("frm", "cmd", "ServiceOrderASCDetailCmd");

	AjaxSyncRequest(urlPattern, 'frm', setCenterTypeForBranch);
}

function setCenterTypeForBranch(response){
	jsonCenterTypeObj = eval('('+response.responseText+')');
	if (jsonCenterTypeObj.success) {
		centerType = jsonCenterTypeObj.ES_BP101.CENTER_TYPE;
	}
}

function rejectReason(PO_NO, PO_DATE){	  
	 
	  $('tempForm').cmd.value = 'PoRejectReasonCmd';
	  $('tempForm').poNo.value = PO_NO;
	  $('tempForm').fromDate.value = PO_DATE;
	  $('tempForm').toDate.value = PO_DATE;
	  $('tempForm').b2bId.value = $('ASSIGNED_ASC_CODE').value;
	  
	AjaxRequest(urlPatternGZIP,'tempForm', reasonAlert);
	 	 
}	

function reasonAlert(response){
	 
			var jsonObj = eval('('+response.responseText+')');
			if (jsonObj.success) {
				alert();
				if (jsonObj != null) {
					var obj = jsonObj.ptDataList[0];
					var val = obj.remark1;
		
					//val = obj.REMARK3 + ":" + obj.remark2 + ":" + obj.remark1
					//val = obj.remark2 + ":" + obj.remark1
					
					if(val!=''){
						alert(_l.u.WEB_MSG_PREFIX + val);
					}
				}
			} else {
				if(jsonObj.error){
				     cfExceptionPop(jsonObj);
				}
			}
}



function getRecallFlag() {
	 
 	if(_l.u.c != "C310" && _l.u.c != "C330" && _l.u.c != "C370" && _l.u.c != "C390")
	{
 		return;
	}
 	
	var url = urlPatternGZIP;

	var data = "cmd=ServiceOrderGetRecallFlagCmd&IV_COMPANY=" + _l.u.c + "&IV_OBJECT_ID="+_l.ObjectId;
	var returnCode = "F";
	var isMIFCheckModelAsync = false;
	$j.ajax({
		type : "POST",
		async : false, /* 동기 */
		url : url,
		data : data,
		success : function(data) {
			if (data.success) {
				var alertMsg;
				if(data.recallFlag == "X"){
					var serviceType = $j("#SERVICE_TYPE").val();
					var wtyInOut = $('IN_OUT_WTY').value;
					
