	//중국 사용안함.
	if (corp == "C390" && SVC_PRCD == 'K30') {
		hasRepairHistoryWithSearchSerial();
	}
	function hasRepairHistoryWithSearchSerial() {
		var url = urlPatternGZIP;
		var data = "cmd=SerialNoCheckPopCmd&MODEL=" + modelInfo + "&ASC_CODE="
				+ _l.ASC_CODE + "&SERNO=" + $j("#SERIAL_NO").val();
		$j.ajax({
			type : "POST",
			async : false, /* 동기 */
			url : url,
			data : data,
			success : function(data) {
				if (data.ptModel.length > 0) {
					if (data.ptWdata.length > 0) {
						if (confirm(_l.u.WEB_MSG_PREFIX +_l.r.m.EXT_0262)) {
							// save 그대로 진행
						} else {
							return;
						}
					}
				} else {
					// 모델 시리얼 정보가 없음
					// return false;
				}

			},
			dataType : 'json'
		});
	}// function hasRepairHistoryWithSearchSerial(){

