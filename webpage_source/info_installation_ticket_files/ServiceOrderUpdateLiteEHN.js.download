/**
 * Search Invoice (CIS only) and North America
 */
function searchInvoice(obj) {
	
	if(_l.isCompensationAsc && _l.currStatus == "ST035"){
		alert(_l.u.WEB_MSG_PREFIX + "Invoice No cannot be changed in case of Repair completed already.");
		return;
	}
	
	var oPartNo = $j("#partsTableBody input[name='PARTS_CODE']");// document.getElementsByName("PARTS_CODE");
	var oInvNo = $j("#partsTableBody input[name='INVOICE_NO']");// document.getElementsByName("INVOICE_NO");
	var oInvLineNo = $j("#partsTableBody input[name='INVOICE_ITEM_NO']");// document.getElementsByName("INVOICE_ITEM_NO");
	var oPARTS_QTY = $j("#partsTableBody input[name='PARTS_QTY']");// document.getElementsByName("INVOICE_ITEM_NO");
	
	
	var rowNo = $j("#partsTableBody").find($j("[name=searchInvoiceAtag]")).index($j(obj));
	
	if (_l.usePartInvoiceNo && _l.isCompensationAsc && _l.usePartInvoiceLineNo) {
		if(oPARTS_QTY.eq(rowNo).val() == "" || Number(oPARTS_QTY.eq(rowNo).val()	) < 1){
			alert(_l.u.WEB_MSG_PREFIX + "Please input Qty first to search Invoice No.");
			return;
		}
	}

	var url = "/wty/common/CISInvoiceSearchPop.jsp";
	url = url + "?Part=" + oPartNo.eq(rowNo).val();
	url = url + "&field1=" + oInvNo.eq(rowNo).attr("name");
	url = url + "&IV_OBJECT_ID=" + _l.ObjectId;
	url = url + "&field2=" + oInvLineNo.eq(rowNo).attr("name");
	url = url + "&idx=" + rowNo;
	url = url + "&partQty=" + oPARTS_QTY.eq(rowNo).val();
	url = url + "&account=" + _l.ticketAccount;
	url = url + "&ascCode=" + _l.ASC_CODE;
	url = url + "&invoiceNo=" + oInvNo.eq(rowNo).val();
	url = url + "&field3=" + oPARTS_QTY.eq(rowNo).attr("name");
	url = url + "&type=SO";
	w = window
			.open(
					url,
					"invoice_popup",
					'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=430');
}

