	//SO 완료 또는 취소시, SAW pending check 2019.06.25 jiw
	if (!(corp == "C310" && !_l.isFieldUser) && _l.sawPending) { 
		
		if("|ST035|ST040|ST050|ST051|ST052|".indexOf(statusCode) > 0){
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0057);
