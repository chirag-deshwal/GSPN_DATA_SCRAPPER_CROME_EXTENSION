	if ("C701,C702,C711,C712".indexOf(corp) != -1 || ("C710" == corp && "IR,DZ,TN,PK".indexOf(_l.u.CountryCd) != -1)) {
		if(serviceType == "PR" && statusCode == "ST035"){
			if(!_l.sawExistExchangeForBranchApproved){
				alert(_l.u.WEB_MSG_PREFIX + "Please make sure “Exchange for Branch” has been raised and approved for "+$j("#SERVICE_TYPE").val()+". You can not repair complete this S/O without approved “Exchange for Branch”.");
				return;
			}	
		}
