function serialReadOnly(flag){
	var svcProd = $("SVC_PRCD").value;
	var model = $("MODEL").value;
	if(_l.useGMESHHPByIMEI){
		if(flag){
			if(svcProd == "HHP01" ){
				//IMEI PROJECT
				if(isAutoImei){
					$("IMEI_TXT").className="inputIDS";
				}else{
					$("IMEI").className="inputIDS";
				}				
				
				$("SERIAL_NO").className="inputRO";
				$("SERIAL_NO").readOnly = true;
				$("MODEL").className="inputRO";
				$("MODEL").readOnly = true;
			}else if(svcProd == "HHP02"){
				$("SERIAL_NO").className="inputRO";
				$("SERIAL_NO").readOnly = true;
				//IMEI PROJECT
				if(isAutoImei){
					$("IMEI_TXT").className="inputIDS";
				}else{
					$("IMEI").className="inputIDS";
				}	
				$("MODEL").className="inputRO";
				$("MODEL").readOnly = true;
			}
		}else{
			if(svcProd == "HHP01" ){
				$("SERIAL_NO").className="inputIDS";
				$("SERIAL_NO").readOnly = false;
				//IMEI PROJECT
				if(isAutoImei){
					$("IMEI_TXT").className="inputIDS";
					$("IMEI_TXT").readOnly=false;
				}else{
					$("IMEI").className="inputIDS";
					$("IMEI").readOnly=false;
				}	
				$("MODEL").className="inputIDS";
				$("MODEL").readOnly = false;
			}else if(svcProd == "HHP02"){
				$("SERIAL_NO").className="inputRO";
				$("SERIAL_NO").readOnly = true;
				//IMEI PROJECT
				if(isAutoImei){
					$("IMEI_TXT").className="inputIDS";
					$("IMEI_TXT").readOnly=false;
				}else{
					$("IMEI").className="inputIDS";
					$("IMEI").readOnly=false;
				}	
				$("MODEL").className="inputIDS";
				$("MODEL").readOnly = false;
			}else{
				// $("SERIAL_NO").className="inputIDS";
				// $("SERIAL_NO").readOnly = false;
			}
		}
	}
}



