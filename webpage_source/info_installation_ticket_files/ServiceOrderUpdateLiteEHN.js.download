function resetSerial(){
	//****Imei Reset
	//IMEI PROJECT
	if(isAutoImei){
		$j("#IMEI_TXT").val("");
		$j("#IMEI").val("");
	}else{
		$j("#IMEI").val("");
	}
	$j("#PRODUCT_DATE").val('');
	$j("#SOLD_COUNTRY_CODE").val('');
	
	$j("#PURCHASE_DATE").val('');
	$j("#WTY_EXCEPTION").val('');
	$('detailForm').WTY_EXCEPTION.disabled = false;
	wtyInfoReset();
	
	//*** serial reset..
	var tmpSerial = $j('#SERIAL_NO').val();
	if(tmpSerial && tmpSerial.toUpperCase()=='M000'){
		$j('#SERIAL_NO').val('M000');
	}else{
		$j("#SERIAL_NO").val("");
	}	
}

function changeSymptomCodeForII(code){
	$('progressloading').startWaiting();
	
	var selectedQCode = "";
	var selectedQcodeText = "";
	
	var selectedCode = code;
	var selectedCodeText = "";
	
	var length = jsonObjIrisSymptom.symptomList.length;
	for(var i = 0; i < length ; i++){
		var obj = jsonObjIrisSymptom.symptomList[i];
		if(obj.code == code){
			$('SAVED_IRIS_SYMPT_QCODE').value = obj.qcode;
			selectedQCode = obj.qcode;
			selectedQcodeText = obj.qcodetx;
			selectedCode = obj.code;
			selectedCodeText = obj.codetx;
			break;
		}
	}
	if(length == 0){
		selectedQCode = "";
		selectedQcodeText = "- " + _l.r.m.EXT_0600 + " -";
		for ( var i = 0; i < jsonObjIrisSymptom.dataLists.length; i++) {
			var obj = jsonObjIrisSymptom.dataLists[i];
			if(obj.code == code){
				selectedCode = obj.code;
				selectedCodeText = obj.codetx;
				break;
			}
		}
	}
	$j("#IRIS_SYMPT_QCODE").empty();;// 초기화
	$j("#IRIS_SYMPT_QCODE").append("<option value='" + selectedQCode + "' selected>" + selectedQCode + "-" + selectedQcodeText);
	
	$j("#IRIS_SYMPT").empty();;// 초기화
	$j("#IRIS_SYMPT").append("<option value='" + selectedCode + "' selected>" + selectedCode + "-" + selectedCodeText);
	$('progressloading').stopWaiting();
}

