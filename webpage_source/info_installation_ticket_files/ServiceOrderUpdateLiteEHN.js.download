	}
	
	if(_l.sawExistCompressorSerialApproved){
		$('tempForm').sawExistCompressorSerialApproved.value = "Y";
	}
	
	if(_l.sawExistSerialNoValidationApproved){
		$('tempForm').sawExistSerialNoValidationApproved.value = "Y";
	}
	
	if(_l.sawExistReverseVoidApproved){
		$('tempForm').sawExistReverseVoidApproved.value = "Y";
	}
	
	$('tempForm').SAW_CATEGORY.value = category;
	$('tempForm').REASON.value = $('detailForm').REASON.value;
	
	$('tempForm').bosFlag.value = _l.BOS_FLAG;

	// =================================================================================//
	// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
	// Activation
	// 수정일 : 2015.04.28
	// 수정자 : 채보람 (로젠 솔루션)
