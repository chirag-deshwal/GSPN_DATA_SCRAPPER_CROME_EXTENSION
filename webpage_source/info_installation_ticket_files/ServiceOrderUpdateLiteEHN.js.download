	// $j("#"+tabId).find('input')
}

function initialize() {
	var _l = window._l;
	
	if(!(_l.u.isChinaRegion || isMedisonUser)){
		if(_l.isDreamModel){
			$j("#OLD_PARTS_SEQ_NO,#OLD_SHIP_DATE,#OLD_SERIAL_MAT,#OLD_FAB_ID").removeAttr("disabled");
			$j("#OLD_PARTS_SN_CHK,#newPartsFront,#OLD_FAB_ID_CHK,#newFabIdFront").css("display","inline");
		}else{
			$j("#OLD_PARTS_SEQ_NO,#OLD_SHIP_DATE,#OLD_SERIAL_MAT,#OLD_FAB_ID").attr("disabled", "disabled");
			$j("#OLD_PARTS_SN_CHK,#newPartsFront,#OLD_FAB_ID_CHK,#newFabIdFront").css("display","none");
		}
	}
	
	if(_l.u.c == "C813"){
		$j("#defectDetailDescTr").show();
		$j("#defectDescTr").show();
	}else if(_l.useDefectDetailDesc){
		$j("#defectDetailDescTr").show();
		$j("#defectDescTr").hide();
	}else{
		$j("#defectDetailDescTr").hide();
		$j("#defectDescTr").show();
	}
	//아래  로직에 중국분기를 넣지않고, 별도 함수로 분리한 이유//////////////////////////////////////
	//1. 중국 특화외에 글로벌과 겹치는 부분이 적어서 아래로직에 중국이면 안타게 해야할 부분이 많아지고 그리되면 아래 로직이 복잡해짐.
	//2. engineer,IRIS code 등 콤보를 구성하는 순서가 다름. 중국은 중국만의 순서로 여러 함수를 호출하다가 어느싯점에 콤보구성하는 함수를 호출하므로,
	//이걸 머지할려면 이전 중국로직을 주석 처리해야함.
	//3. 글로벌과 겹치는 곳은 changeStatusCode() 처럼 글로벌 함수에 머지햇고, 동일 로직은 initHME_PATIENT_IMP() 처럼 중국/글로벌 같이 사용할 함수를 신규로 생성해서 호출햇음.
	//**중국/글로벌에 BP를 확산하기 위해서는 신규 함수 생성후 중국/글로벌 초기화 함수에서 신규함수를 호출하는식으로 구현 필요함. 
	if(_l.u.isChinaRegion){
		beforeADServiceTypeString = $j("#SERVICE_TYPE").html();
		initializeChina();
		openSkpBulletin();
		return;
	}
	
	if (_l.wty_err_flag == "W" && _l.WTY_BILL_NO != "") {
		openViewClaimPop(_l.WTY_BILL_NO);
	}

	if (_l.isDOA && !_l.canPrintDOA) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0055);
	}

	if (_l.useRedo) {
		alertRedoGrade();
	}

	changeStatusCode();

	addServiceTypeReason(document.detailForm.SERVICE_TYPE,
			document.detailForm.MODEL, _l.ServiceTypeReason);
	
	getEngineerList();
	
	getCodeGroup();
	
	var defectblock = "DEFECT_BLOCK";
	if (isEuUser) {
		defectblock = "IRIS-E";
	} else if (_l.u.c == 'C560' || _l.u.c == 'C565') {
		defectblock = "";
	} else {
		defectblock = "DEFECT_BLOCK";
	}
	if (defectblock != "")
		getIRIS(defectblock);

	// setMandatoryFieldColor();
	if (_l.u.c == 'C370' || _l.u.c == 'C310' || _l.u.c == 'C550' || _l.u.c == 'C460' || _l.u.c == 'C4M6'){
		if(_l.CurrStatus == "ST035"){
			$j('#REPAIR_DESC,#DEFECT_DESC').attr('class','inputIDS');
		}
	}	
    if(_l.CurrStatus == "ST025"){
    	var engObj = $('ENGINEER');
		// engineer 가 없는 경우 필수 체크 하지 않음...
    	if(engObj == undefined || $('sENGINEER').options.length==0 || ( $('sENGINEER').options.length==1 && $('sENGINEER').options[0].value=='' ) ) {
		} else {
			$('ENGINEER').className = "inputIDS";
    	}
    }
	if(_l.CurrStatus == "ST035"){// Status Repair Completed , Goods Delivered
		$('IRIS_REPAIR').className = "selectIDS";
		if("C310;C330;C370".indexOf(_l.u.c) == -1) {/* SEA,SECA */ 
			$j('#IRIS_CONDI,#IRIS_SYMPT').attr("class","selectIDS");
		}
		if("C550"==_l.u.c){
			if(_l.SVC_PRCD.substring(0,3)=="HHP"){
				$('IRIS_REPAIR').className = "selectRO";
				$('IRIS_REPAIR').disabled = true;
			}
		}else{
			
			if(isHHPProductForMPTS()){
				$('IRIS_REPAIR').className = "selectRO";
				$('IRIS_REPAIR').disabled = true;
			}
		}
	}
	
	// initialize310():
	if (_l.u.c == 'C310' || _l.u.c == 'C370'){
		
		getCenterType("1");
		
		$j('#IrisCodeDec').hide();
		$j('#trEngineer').hide();
		$j('#tdPartList').show();
		
		
		/*
		 * 미주 통합 - RT-007 - Assigned ASC 를 추가하여 Service Branch를 선택할 수 있도록 한다
		 * (SEA CE & IM 동일) ST015, ST025에서만 활성 - Assigned ASC가 선택되면 ASC 의 Active
		 * Engineer List를 선택할 수 있도록 한다. ST015, ST025, ST030에서만 선택가능, ST035부터는
		 * Read-Only - 2015-09-14
		 */	
		$j('#ASSIGNED_ASC_CODE').removeClass().addClass("inputRO").prop("readonly", true).prop("disabled", true);
		
		
		if (_l.isFieldManager){
			if(_l.partslength==0 && (_l.CurrStatus == "ST010" || _l.CurrStatus == "ST015" || _l.CurrStatus == "ST025" || _l.CurrStatus == "ST030")  ){
				$j('#ASSIGNED_ASC_CODE').removeClass().addClass("selectSN").prop("readonly", false).prop("disabled", false);
				$j('#sENGINEER').removeClass().addClass("selectSN").prop("readonly", false).prop("disabled", false);
			}
		}

		
		/*
		 * 미주 통합 - RT-007 - 아래 Service Type은 각 Center Type별로 선택이 가능한 코드만 나열한
		 * 정보이므로 - 그외의 Service Type은 선택이 불가능하도록 정의되어야합니다. - 2015-09-14
		 */				
			limitServiceType();
		
		if (_l.u.c == 'C370'){
			/*
			 * 미주 통합 - RT-007 - Defect Type SEA IM - IP Inspection (Service
			 * Type이 SW(Set Swap일 경우만 해당) - MN Minor - 2015-09-14
			 */			
			limitDefectType370();
			//Walk In Service
			initWis();
		}	
		
		if(_l.isFieldNewUser){
			initFeme();
		}
		
		if(_l.u.c == 'C310'){
			if (_l.BosBusiness_warns) {
				alert(_l.u.WEB_MSG_PREFIX + _l.BosBusiness_WarningMessage);
			}	
		}else if(_l.u.c == 'C370'){
			if (_l.BosBusiness_wisWarns) {
				alert(_l.u.WEB_MSG_PREFIX + _l.BosBusiness_wisWarningMessage);
			}			
		}		
	}else{
		limitServiceType100();
		if (_l.u.c == 'C4D0' || _l.u.c == 'C4A0'){
			limitDefectTypeEU();
		}		
	}
	
	if (_l.u.c == 'C330' || _l.u.c == 'C813'){
		limitTicketCancelStatus();
	}

	if ((_l.u.c == 'C9E0' || _l.u.c == 'C941' || _l.u.c == 'C962') && _l.vipLevel == "P") { // SRSC 법인 통합 
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0155);
	}
	if ((_l.u.c == 'C310' || _l.u.c == 'C370') && _l.vipLevel == "B") { // Builder 
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0589);
	}
	if (_l.u.c == 'C710' || _l.u.c == 'C711' || _l.u.c == 'C712' || _l.u.c == 'C713' || _l.u.c == 'C750' || _l.u.c == 'C770' || _l.u.c == 'C780') {
		limitServiceTypeMena();
	}

	serviceTokenAscchk(_l.ASC_CODE);
	
	
	if(_l.partslength < 1 ) {
		// EHN01 : part list 수정에 따라 불필요
		//$j("#partsTable").children().hide();
	}else{
		// EHN01 : part list 수정에 따라 불필요
		//$j("#btnPartShow").val(_l.r.c.HIDEALL);
		//PartListVisible = true;
		toggleTable('Rparts');
		
		//inventory user 인 경우, gi posting 했으면 모델 변경 불가
		if (_l.userHaveToDoGI) {
			var partCode = $j("#partsTableBody input[name='PARTS_CODE']");// document.getElementsByName('PARTS_CODE');
			var GIObj = null;
			
			if (_l.inventoryFlag) {
				GIObj = $j("#partsTableBody input[name='GI_DATE']");// document.getElementsByName('GI_DATE');
			} else if (_l.FSC) {
				GIObj = $j("#partsTableBody input[name='gi_document_no']");// document.getElementsByName('gi_document_no');
			}

			for ( var i = 0; i < GIObj.length; i++) {
				if (partCode[i].value != "" && GIObj[i].value != "") {
					isAbleToChangeModel = false;
					break;
				}
			}
			if(!isAbleToChangeModel){
				$("MODEL").className="inputRO";
				$("MODEL").readOnly = true;
				$j("#aModelSearch").hide();
			}
		}
	}
	
	// if(_l.filelength < 1){
		// EHN15 : (attach hide/show 제어는 별도의 script에서 처리)
		//$j("#attachTable").children().hide();
	// }
	

	if (_l.u.c =="C310" || _l.u.c =="C330" || _l.u.c =="C370") {
		if (_l.isSymptomOptional) {
			alert(_l.u.WEB_MSG_PREFIX + "The symptom codes of this ticket are no longer visible in the symptom fields.\nYou can view the symptom codes related to this ticket in the Interaction History section if necessary.\n\nYou may continue with this repair without the symptom codes present.");
		}
	}
	
	if (_l.useMobileInterface && !_l.useFenrirCheck && !_l.isExchTicket) {
		checkMIFModel();
	}

	//중국에도 동일로직 필요해서, 소스중복 줄이기 위해 신규함수 추가함.
	toggle_gDRunDivActive();
	
	if(_l.isPSApp || _l.CurrStatus == "ST035" || _l.CurrStatus == "ST040") {
		if(isMeaUser && _l.isPSApp &&  _l.CurrStatus != "ST035" && _l.CurrStatus != "ST040") {
			// C770은 IS만 허용한다. 중동 전체 확산
		} else {			
			$j(document.detailForm.SERVICE_TYPE).removeClass().addClass("inputRO").prop("readonly", true).prop("disabled", true);
		}
	}
	if (_l.u.c == "C550" && (_l.CurrStatus == "ST015" || _l.CurrStatus == "ST025")){
		// callRefreshSTB(_l.ObjectId);
		if ($("SERVICE_TYPE").value == "DM" || $("SERVICE_TYPE").value == "II") {
			var isCheckedDate = true;
			//var isExceptionPeriod =  "HTV19|HTV22|HTV23|HTV26|HTV27|HTV28|HTV32|HTV37|HTV39|HTV40|HTV42|HTV46|HTV48|HTV50|HTV52|HTV55|HTV58|HTV60|HTV65|HTV75|PJM01|PDM63|PDM50|PDM42|LFT55|LFT48|LFD99|LFD8A|LFD82|LFD75|LFD70|LFD65|LFD57|LFD55|LFD52|LFD48|LFD46|LFD40|LFD32|LFD24|LFD23|LFD22|".indexOf($j("#SVC_PRCD").val()) > 0;
			//var isExceptionPeriod = "CTV04|CTV06|CTV07|CTV13|CTV14|HME01|HME02|HME03|HME04|HME05|HME06|HME07|HME08|HME09|HME10|HME11|HME12|HME13|HME14|HME15|HME16|HME17|HME18|MON05|MON06|MON07|MON08|MON09|MON10|MON11|MON12".indexOf($j("#HQ_SVC_PRCD").val()) > 0;
			var isExceptionPeriod = "LFD14|LFD18|LFD19|LFD22|LFD23|LFD24|LFD32|LFD40|LFD46|LFD48|LFD52|LFD55|LFD57|LFD65|LFD70|LFD75|LFD82|LFD8A|LFD98|LFD99|LFT99|LFT55|LFT40|LFT48|LFT75|LFT65|LFT32|LFT46|LFT85|HTV19|HTV22|HTV26|HTV27|HTV28|HTV32|HTV37|HTV39|HTV40|HTV42|HTV46|HTV48|HTV50|HTV55|HTV65".indexOf($j("#HQ_SVC_PRCD").val()) > 0;
			if(($("SERVICE_TYPE").value == "II" || $("SERVICE_TYPE").value == "DM") && isExceptionPeriod) {
				if($('PURCHASE_DATE').value == "" || $('PURCHASE_DATE').value.substring(0, 2) =="00"){
					isCheckedDate = checkFromToDate($('PRODUCT_DATE').value, _l.CREATE_DATE_15M, _l.u.DateFormat2);
				}else{
					isCheckedDate = checkFromToDate($('PURCHASE_DATE').value, _l.CREATE_DATE_12M, _l.u.DateFormat2);
				}
			} else {	// Calculation based on Months : 6 Months / 9 Months 2018.12.26 jiw			
				if($('PURCHASE_DATE').value == "" || $('PURCHASE_DATE').value.substring(0, 2) =="00"){
					//isCheckedDate = checkFromToDate($('PRODUCT_DATE').value, _l.CREATE_DATE_270, _l.u.DateFormat2);
					isCheckedDate = checkFromToDate($('PRODUCT_DATE').value, _l.CREATE_DATE_9M, _l.u.DateFormat2);
				}else{
					//isCheckedDate = checkFromToDate($('PURCHASE_DATE').value, _l.CREATE_DATE_180, _l.u.DateFormat2);
					isCheckedDate = checkFromToDate($('PURCHASE_DATE').value, _l.CREATE_DATE_6M, _l.u.DateFormat2);
				}
			}
			if (isCheckedDate) {
				if ($('WTY_EXCEPTION').value == "") {
					alert(_l.u.WEB_MSG_PREFIX + "Demo/Installation will be provided on chargeable basis.");
					
					//EHN : product 탭이 열리기 전에는 select box 가 아닌 input hidden 이여서, 둘다 적용되는 .val() 메소드 로 변경함.
					//setComboValue($('detailForm').WTY_EXCEPTION, "VOID5");
					$j('#WTY_EXCEPTION').val("VOID5");
					$('IN_OUT_WTY').value = "OW";
					$('detailForm').WTY_EXCEPTION.disabled = true;
				} else if ($('WTY_EXCEPTION').value == "VOID5") {
					$('detailForm').WTY_EXCEPTION.disabled = true;
				}
			} else {
				$('detailForm').WTY_EXCEPTION.disabled = false;
			}
		} else {
			$('detailForm').WTY_EXCEPTION.disabled = false;
		}
	}
	
	if(false && _l.rmFlag != ""){
		$('RM_FLAG').value = _l.rmFlag;
		$('RM_REASON').value = _l.rmReason;
		if(_l.rmFlag == "Y"){
			$('rmFlagCheckYes').checked = true;
			$('RM_REASON_YES').disabled = false;
			$('RM_REASON_YES').value = _l.rmReason;
		}else if(_l.rmFlag == "N"){
			$('rmFlagCheckNo').checked = true;
			$('RM_REASON_NO').disabled = false;
			$('RM_REASON_NO').value = _l.rmReason;
		}else{}
	}
	
	beforeADServiceTypeString = $j("#SERVICE_TYPE").html();
	
	// Care Pack 고도화 - 2017.03 - Start //
	if(_l.ADH_FLAG=="X"){
		$j("#adhPackConfirmArea").show();
		$('adhPackConfirmCheck').checked = true;
		//selectAD();
		if(_l.SERVICE_TYPE == "AD"){
			selectAD();
			if(_l.owPackFlag == "X" || _l.u.c == "C820" || _l.u.c == "C5A0"){
				$j("#WTY_EXCEPTION").removeClass().addClass("input").prop("readonly", false).prop("disabled", false);
			}
		}
	}
	// Care Pack 고도화 - 2017.03 - End //
	
	// after save with tab info then open
	//중국 초기화시도 해당함수 사용이 필요하여, 별도 함수로 분리해서 맨 아래에 둠.
	//function openTabBegining(){
	//}
	openTabBegining();
	
	
	// HME user role 화면 2015.04.17 jiw
	//중국에도 동일로직 필요해서, 소스중복 줄이기 위해 신규함수 추가함.
	initHME_PATIENT_IMP();
	
	// =================================================================================//
	// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
	// Activation
	// 수정일 : 2015.04.28
	// 수정자 : 채보람 (로젠 솔루션)
	// 내 용 : 인도일 경우 페이지 로드 후 바로 Sim Activation Date 를 가져 온다.
	if(_l.isIndia || _l.isBangladesh || _l.isSrilanka || _l.isNepal){
		
		//=================================================================================//
		//제  목 : 인도 Demand OTP link with GSPN
		//수정일 : 2015.09.15
		//수정자 : 채보람 (로젠 솔루션)
		//내  용 : 인도일 경우 OTP 체크 대상인지 체크하는 Function 호출.
		if(_l.isIndia){
			initOTPCheck();
		}
		//=================================================================================//
		
		if(_l.isHHPIndia){
			pageInitSearchSim();
		}
	}
	// =================================================================================//

	//C720 - 9개 수리점에 대해서 SVC Type 'IS' activation
	if(_l.u.c == 'C720' && !limitTypeSSA){
			$j("#detailForm").find("#SERVICE_TYPE").find("option:[value=IS]").remove();
	}
	
	/*C710, Country Code : IR 경우에만 로직 패스*/
	if (_l.u.c == 'C710' && _l.u.CountryCd != "IR"){	
		$j("#detailForm").find("#LAB_TYPE").find("option:[value=IP]").remove();
	}
	
	if (_l.u.c == 'C701' && blockDefectTypeMJ && "LED42|LED58|LED70|LED75".indexOf($('SVC_PRCD').value) > -1){	
		$j("#detailForm").find("#LAB_TYPE").find("option:[value=MJ]").remove();
	}
	
	// LK(스리랑카) 법인에 SVC TPYE 'SE' 추가 반영 요청건 - LK가 아니면 SE TYPE remove 
	if(_l.SERVICE_TYPE != "SE"){
		if(_l.u.c == 'C550' && _l.u.CountryCd != "LK"){
			$j("#detailForm").find("#SERVICE_TYPE").find("option:[value=SE]").remove();
		}
	}
	
	if(_l.u.c_SEA == 'C310'){
		//C310이고 Part List에서 Create PO버튼으로 SAVE하여 ReLoad 시
		//_l.SEA_fromModelVersion true 생명 주기 $('CreatePOForm').fromModelVersion.value 값 대입 후 false
		if(_l.SEA_fromModelVersion){
			openNewPOPop();
		}
		 
		// SO Update화면 저장전 또 Stock Overview 못하게 하기 위해 ableStockOverView flag 사용[화면 리로딩 되면서 초기화되긴 함]
		$('tempForm').ableStockOverView.value = 'Y';
	}
	
	//중국은 안탐. 310,330,370,390만 탐.
	//getRecallFlag();
	
	getVanId();
	
	if(_l.isUseNewUPC && ($j("#STATUS").val() == "ST035" || $j("#STATUS").val() == "ST040") ){ 
		getUsedPartsCheck(false);
	}
	
	if(_l.isEWPModel){
		//$j("#ewpAttachBtn,#ewpAttachBtnRight").css("display","block");
	}
	if(_l.useQNACodeSearch && _l.currReason == "HP010"){
		$j("#QNA_CODE").removeAttr("disabled");
		$j("#tdQnaLabel,#tdQnaInput").css("display","inline");
	}else{
		$j("#QNA_CODE").removeAttr("disabled");
		$j("#tdQnaLabel,#tdQnaInput").css("display","none");
	}	
	
	if(isEuUser){
		limitSvcGrade();
	}

	if(_l.isRrrOverBp){
		showRrrOverBpReport();
	}
	
	if(_l.u.c =="C390" || _l.u.c.startsWith("C8")) { //중남미 법인만 대상
		if (_l.bpType == "C008" || _l.bpType == "C009" || _l.bpType == "C010") {
			alert(_l.r.m.EXT_0710 + _l.bpTypeDesc + _l.r.m.EXT_0711);
		}
	}

	if(_l.isSMA235M) {
		window.open("/svctracking/common/SVCPopA235mAlert.jsp", "alert_popup", 'toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=370');
	}
	
	openSkpBulletin();
}

