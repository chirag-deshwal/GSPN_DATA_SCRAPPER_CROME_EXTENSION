function setCurrentDateTime_VisitDt(dateObj,timeObj){
	if(_l.u.c == "C550"){
		setRealDateTime(dateObj,timeObj);
	}else{
		setCurrentDateTime(dateObj,timeObj);
	}
	if(isEuUser){
		if(dateObj == 'FIRST_VISIT_DATE_DY_STT'){
			$j("#FIRST_VISIT_DATE").val( $j("#FIRST_VISIT_DATE_DY_STT").val() );
		}
		if(timeObj == 'FIRST_VISIT_TIME_DY_STT'){
			$j("#FIRST_VISIT_TIME").val( $j("#FIRST_VISIT_TIME_DY_STT").val() );
		}
	}
}

function setCurrentDateTime_AppDt(dateObj,timeObj){
	var tmp=$(dateObj).value;
	if(_l.u.c == "C550"){
		setRealDateTime(dateObj,timeObj);
	}else{
		setCurrentDateTime(dateObj,timeObj);
	}

	if(dateObj == 'FIRST_APP_DATE_DY_STT'){
		$j("#FIRST_APP_DATE").val( $j("#FIRST_APP_DATE_DY_STT").val() );
		if ("C310"==_l.u.c) {
			$j("#LAST_APP_DATE_DY_STT").val( $j("#FIRST_APP_DATE_DY_STT").val() );
		}
	}
	if(timeObj == 'FIRST_APP_TIME_DY_STT'){
		$j("#FIRST_APP_TIME").val( $j("#FIRST_APP_TIME_DY_STT").val() );
		if ("C310"==_l.u.c) {
			$j("#LAST_APP_TIME_DY_STT").val( $j("#FIRST_APP_TIME_DY_STT").val() );
		}
	}
	
	
	if(tmp != $(dateObj).value)
		getSvcEngineerSearch();// lass app date Change ! Engineer Research.
}

