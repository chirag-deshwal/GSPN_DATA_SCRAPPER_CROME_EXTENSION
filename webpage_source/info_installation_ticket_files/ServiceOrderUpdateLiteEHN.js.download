function saveEstimateRepairCost(){
	
	
	if($("NEW_STD_CHECK").checked || $("NEW_LCD_CHECK").checked || $("NEW_PBA_CHECK").checked
			|| $("DISCOUNT_CHECK").checked || $("FREE_CHECK").checked){
		$("NEW_STD_PRICE").value = "";
		$("NEW_LCD_PRICE").value = "";
		$("NEW_PBA_PRICE").value = "";
		$("DISCOUNTED_PRICE").value = "";
	}else{
		alert(_l.u.WEB_MSG_PREFIX + "Please check a item to save at least.");
		return;
	}
	
	if(confirm(_l.u.WEB_MSG_PREFIX +"Repair cost will be saved with checked data only.")){
		
		$('progressloading').startWaiting();
		var param = "cmd=ZifGspnWisRepairCostSaveCmd&IV_TYPE_FLAG=8";
		param += "&IV_ASC_CODE=" + _l.ASC_CODE;
		param += "&IV_COMPANY=" + _l.u.c;
		param += "&IV_OBJECT_ID=" + _l.ObjectId;
		param += "&IV_MODEL=" + $j("#MODEL").val();
		param += "&IV_EXT_USER=" + _l.u.UserId;;
		if($("NEW_STD_CHECK").checked){
			$("NEW_STD_PRICE").value = $("NEW_STD_PRICE_SHOW").value;
			param += "&NEW_STD_PRICE=" + $("NEW_STD_PRICE").value;
		}
		if($("NEW_LCD_CHECK").checked){
			$("NEW_LCD_PRICE").value = $("NEW_LCD_PRICE_SHOW").value;
			param += "&NEW_LCD_PRICE=" + $("NEW_LCD_PRICE").value;
		}
		if($("NEW_PBA_CHECK").checked){
			$("NEW_PBA_PRICE").value = $("NEW_PBA_PRICE_SHOW").value;
			param += "&NEW_PBA_PRICE=" + $("NEW_PBA_PRICE").value;
		}
		if($("DISCOUNT_CHECK").checked){
			$("DISCOUNTED_PRICE").value = $("DISCOUNT_PRICE_SHOW").value;
			param += "&DISCOUNTED_PRICE=" + $("DISCOUNTED_PRICE").value;
		}
		if($("FREE_CHECK").checked){
			$("NEW_STD_PRICE").value = "";
			$("NEW_LCD_PRICE").value = "";
			$("NEW_PBA_PRICE").value = "";
			$("DISCOUNTED_PRICE").value = "";
			$("F_FREE").value="X";
			param += "&F_FREE=" + "X";
		}
		$j.ajax({
			type : 'post',
			dataType : 'json',
			async : false,
			url : urlPatternGZIP,
			data : param,
			success : function(data) {
				if (data.success) {
					alert(_l.u.WEB_MSG_PREFIX + "saved success.");
				}else{
					alert(_l.u.WEB_MSG_PREFIX + "saved fail.");
				}
			},
			error : function(jqXHR, textStatus) {
				// console.log(textStatus);
			}
		});
	}else{
		return;
	}
	$('progressloading').stopWaiting();
}
