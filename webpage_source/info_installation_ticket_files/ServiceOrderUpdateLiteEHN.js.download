			}
		}
		
		if(_l.isFieldNewUser){
			var sCode = $("STATUS").value;
			var rCode = $("REASON").value;
			var caDt = $("CALL_ATTEMPT1_DT").value;
			if( sCode == "ST030" && rCode == "HP025" && (caDt.substring(0, 2) == '00' || caDt.substring(0, 2) == '') ){
				alert(_l.u.WEB_MSG_PREFIX + 'Please enter the 1st Customer Call Attempt date and time');
				return false;
			}	
			
			if(_l.CurrStatus == "ST035" && sCode == "ST040"){
				if(_l.sawExistExtraManRequested){
					alert(_l.u.WEB_MSG_PREFIX + "SAW - Extra Man category request is exist");
					return;
				}
			}
		}
		
		
		if("C370" == _l.u.c){
			
			/*
			if ($('SERVICE_TYPE').value == 'CI' && "ST025|ST030|ST035".indexOf($('STATUS').value) != -1) {
				
				//MAN_CHK_UNIT_RECV_DATE_10 중복
				if($("UNIT_RECV_DATE").value == "" || $("UNIT_RECV_DATE").value.substring(0, 2) == '00'){
					alert(_l.r.m.MAND_INPUT_00898);
					$("UNIT_RECV_DATE").focus();
					$j("#UNIT_RECV_DATE").removeClass().addClass("inputIDS").prop("readonly", false).val("");
					return;
				}
			}
			 */
			
			if($j("#bosAttContentTableBody").find("tr").length > 0){// exist bos
																	// file case
				if($j("#PURCHASE_DATE").val() == "" || $j("#PURCHASE_DATE").val().substring(0,2) == "00"){
					alert(_l.u.WEB_MSG_PREFIX + "Please input Purchase Date");
					$j("#PURCHASE_DATE").focus();
					return;
				}
			}
			
			if(_l.isExchTicket){// WIS Adv Exchange Case
				if(!validateExchangeSave()) return;
			}
			
			//VAL_CHK_BILLING_DATE_2 이관, VAL_CHK_BILLING_DATE_3 이관
			/*
			if(_l.CurrStatus == "ST035" && $j("#STATUS").val() == "ST040" && !_l.isBillingSaved
					&& _l.IN_OUT_WTY == "OW"){
				alert("Please billing before Status Change");
				return;
			}
			*/
			
		}	
		

	//auto wty 적용 : 중국 워런티 화면에 있던 체크로직을 여기서 호출함.
	if(_l.u.isChinaRegion && (statusCode == "ST035" || statusCode == "ST040")){
		//auto_wty_verify_Step 이메소드 안에서 콜백을 쫒아가다보념 verify_step9() 맨 마지막에 saveServiceOrder() 이 있다.
		//ㅠ.ㅠ 아래의 바이두 거리 로직은 부득이 콜백함수에서 saveServiceOrder 호출할수 밖에 없으며,
		//그래서 이것을 모두 동기방식으로 변경해서 true/false 를 리턴하도록 변경햇음.
		if(!auto_wty_verify_Step()){
			return;
		}
	}
	
	/**
	 * 무인건비 관련 로직은 워런티 수정화면에 있던 것이였으나,
	 * 값을 지정하는 로직은 티겟 저장쪽으로 옮겨간다.
	 * 오토워런티 되면수 워런티 수정화면이 티겟 수정화면이다.
	 */
	if(_l.u.isChinaRegion){
		setupNoLabor();
	}
	
	//중국 대형화 원거리 거리체크  verify() 함수 호출시(SO저장시) - 기존의 원거리 체크로직 이전에 체크함 bh1130.park
	if(isNewChina){
		if(!checkChinaLongDistance()){
			return false;
		}
	}
	//중국 대형화 원거리 거리체크  bh1130.park
	
	if(isNewChina && !_l.FSC
		&& $j('#i_distance').length == 1 && ($j('#i_distance').val()!=null  || _l.sawExtraMileageApproved) ){
			//이메소드 안에서 콜백을 쫒아가다보념 verifyChinaDistance() 맨 마지막에 verifyTail, saveServiceOrder() 이 있다.
			//1. Extra Mileage SRC01 SAW 승인 거리(conf amt) 로 거리값을 지정하고, 바이두 체크는 하지 않고 바로 티겟 저장한다.
			//2. 바이두 거리 체크한다.
			verifyChinaDistance();
			return;
	}

	if(isVerifyDistance && !/^[0-9]*$/.test($j('#distance').value)) {
		alert(_l.u.WEB_MSG_PREFIX + "Please input only number in Distance."); 
		return;
	}

	//Service Type이 Inspection 인 경우 자재 등록 불가
	/*HAICC-13909 냉장고 질소가압 진단 적용시, RH/IS 타입에서 자재 사용 가능하도록 예외 처리 요청
	if(serviceType == 'IS' && hasPart){
		alert(_l.u.WEB_MSG_PREFIX + "If the service type is IS(inspection), it is prohibited to insert parts."); 
		return;
	}
	*/
	
	if(!validateVanId())
	{
		return;
	}
	
	if(_l.usePriceType && statusCode == "ST030" && statusReason == "HP070"){
		if(!($("priceType2").disabled)){
			if (!confirm(_l.u.WEB_MSG_PREFIX + "Confirm Price Type 2 is correct.\n"
					+ "Price cannot be changed after confirmation.\n"
					+ "- Price Type2 = " + $j("#priceType2 option:selected").text())) {
				return;
			}
		}
	}

    // Start -- India Demand . 2017/03/30. j.peter.kim
    if ("C550" == _l.u.c && "IN" == _l.u.CountryCd) {
        if(!checkSAWForIndia()){
            return;
        }
    }   
    // India -- India Demand . 2017/03/30. j.peter.kim  

    // EHN19
    if(("C701" == _l.u.c || isMeaUser) 
    		&& "ST035|ST040".indexOf($('STATUS').value) != -1 && wtyInOut == "LP" && $("PURCHASE_DATE").value !="" && $("PURCHASE_DATE").value.substring(0,2) != "00"  
    		&& $("PURCHASE_DATE").value != $("PRODUCT_DATE").value 
    		&& $('attachTableBody').rows.length < 1) {
		var tvPrdCodeList = _l.r.c.PURCHASEDATE_ATTACH_CHECK.evalJSON();
		var attachMandatory = false;
		for(var i=0; i<tvPrdCodeList.length; i++){
			if($("SVC_PRCD").value == tvPrdCodeList[i].codeId){
				attachMandatory = true;
				break;
			}
			if(isMeaUser){
				if($("SVC_PRCD").value.substring(0,3) == tvPrdCodeList[i].codeId){
					attachMandatory = true;
					break;
				}
			}
		}
		if(attachMandatory) {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.PURCHASEDATE_ATTACH_CHECK);
			return false;
		}
	}
    // 全제품에 대해 구매일자를 입력했으나 POP 미첨부건에 대해서는 아래 메시지 Display 되도록 로직 추가 
    if(_l.eulaFlag == "" && ("C701" == _l.u.c || "C702" == _l.u.c)){
		if($("PURCHASE_DATE").value !="" && $("PURCHASE_DATE").value.substring(0,2) != "00"){
			if($('attachTableBody').rows.length < 1){
				alert(_l.u.WEB_MSG_PREFIX + "If purchase date is input in progress, purchase evidence Must be attached.");
				return false;
			}
		}
	}
    
	// START : C20070006277 HHP pick up process enhancement
	if ("C550" == corp && (_l.u.CountryCd == "BD" || _l.u.CountryCd == "LK"  || _l.u.CountryCd == "NP" || _l.u.CountryCd == "MV")){
        if(!checkDistance()){
            return;
        }
    }  
	// END : C20070006277 HHP pick up process enhancement
	
	if("C962" == _l.u.c && serviceType == 'ER'){
		var isSSDProduct = ("SSD01,SSD02,SSD03,SSD04,SSD05".indexOf($('HQ_SVC_PRCD').value.substring(0,5)) > -1);
		if("SSD01".indexOf($('SVC_PRCD').value.substring(0,5)) >= 0 || isSSDProduct){
		}else{
			alert(_l.u.WEB_MSG_PREFIX + "You can not change to ER SVC order. Please select another SVC type.");
			return;
		}
	}

    verifyTail();
	/*아래 로직은 verifyTail 메소드로 들어갓다.*/
	//if (corp == 'C962' && statusCode == "ST040"
	//		&& $('detailForm').NEW_MODEL.value != "") {
	//	getBufferOverviewDetail();
	//} else {
	//	if(_l.u.c == "C550" && statusCode == 'ST035'){
	//		checkAuthorizedModel("1");
	//		return false;
	//	}else if(_l.canWtyVerify && $j("#STATUS").val() == "ST040"){
	//		verifyWty("1");
	//	}else if(_l.useVerifyWtyPending && (currStatus == "ST025" || currStatus == "ST030") && statusCode == "ST035"){
	//		verifyWty("3");	// 구주 Pending -> R/C 시 Wty Verify 필수로직 적용
	//	}else{
	//		saveServiceOrder();
	//	}
	//}

}// verify()


/*baidu 거리 체크는 부득이 콜백메소드를 사용해야 하고, 거기서 호출하기 위해 아래 메소드를 생성한다.
 * 안그러면, 콜백에 아래와 동일한 라인이 들어가야한다.
 * */
function verifyTail(){
	
	var statusCode = $j("#STATUS").val();
	var currStatus = _l.CurrStatus;
	
	if (_l.u.c == 'C962' && statusCode == "ST040"
		&& $('detailForm').NEW_MODEL.value != "") {
		getBufferOverviewDetail();
	} else {
		if(_l.u.c == "C550" && statusCode == 'ST035'){
			
			//EHN : checkAuthorizedModel() 에서 서비스타입이 필수값이나, 체크로직이 샙으로 이관됨에 따라, C550 경우만 로직은 남겨둠.
			if ($j("#SERVICE_TYPE").val() == "") {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_XVALUE_00769);
				return false;
			}					
			
			checkAuthorizedModel("1");
			return false;
		/*
		}else if(_l.canWtyVerify && statusCode == "ST040"){
			verifyWty("1");
		}else if(_l.useVerifyWtyPending && (currStatus == "ST025" || currStatus == "ST030") && statusCode == "ST035"){
			verifyWty("3");	// 구주 Pending -> R/C 시 Wty Verify 필수로직 적용
		*/
		}else{
			saveServiceOrder();
		}
	}
}

function checkLEDSinage(){
	var ledSinagePrdCode = _l.r.c.LED_SINAGE.evalJSON();
	var isLEDSinage = false;
	var svcProd = $("SVC_PRCD").value;
	for(var i=0; i<ledSinagePrdCode.length; i++){
		if(svcProd == ledSinagePrdCode[i].codeId){
			isLEDSinage = true;
			break;
		}
	}
	return isLEDSinage;
}


/**
 * When Create step 1. add onchange event : create screen <Select
 * name="SERVICE_TYPE" id="SERVICE_TYPE"
 * onchange="addServiceTypeReason(document.frmSearch.SERVICE_TYPE,
 * document.frmSearch.MODEL)"> step2. add validation check on create screen
 * if(!isValidServiceTypeReason(this.form.SERVICE_TYPE,
 * this.form.MODEL)){return;} step 3. on change screen :
 * addServiceTypeReason(document.frmSearch.SERVICE_TYPE,
 * document.frmSearch.MODEL,"01")
 */
/**
 * onchange service type : event function
 */
function addServiceTypeReason(svcTypeElement, modelElement, svcTypeReason) {

	if (_l.u.c != "C550")
		return;

	if (!svcTypeElement)
		svcTypeElement = $("SERVICE_TYPE");
	if (!modelElement)
		modelElement = $("MODEL");

	var svcType = svcTypeElement.value;
	var model = modelElement.value.strip();
	$j("#divServiceTypeReason").empty();

	if (svcType == "SR") {// Stock Repair
		serviceTypeReasonSearch("STOCK_REPAIR_REASON", model, svcType,
				svcTypeReason);
	}
}
/**
 * when Service Type is SR or RB or BS, get service type reason code to display
 */
function serviceTypeReasonSearch(codeGroup, model, svcType, svcTypeReason) {
	try {
		$('progressloading').startWaiting();
		var params = "cmd=CICCodeSearchCmd";
		params += "&CODE_GROUP=" + codeGroup;
		params += "&model=" + model;
		params += "&svc_type=" + svcType;

		new Ajax.Request(urlPatternGZIP, {
			method : 'post',
			parameters : params,
			onComplete : function(response) {
				var jsonSvcTyRsnObj = response.responseText.evalJSON();

				if (jsonSvcTyRsnObj.success) {
					gridDrawServiceTypeReason(jsonSvcTyRsnObj, svcTypeReason);
				} else {
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0044);
					if (jsonSvcTyRsnObj.error) {
						cfExceptionPop(jsonSvcTyRsnObj);
					}
				}// if (jsonSvcTyRsnObj.success) {
			}
		});
	} catch (e) {
	}
	$('progressloading').stopWaiting();
}

/**
 * display the Service type reason on the screen with jsonSvcTyRsnObj
 */
function gridDrawServiceTypeReason(jsonSvcTyRsnObj, svcTypeReason) {
	if (jsonSvcTyRsnObj != null) {
		/** TBody 객체 ID */
		var tbodyObj = $('divServiceTypeReason');

		/** 이전 Grid 객체에 노드가 있는 경우 새로 갱신하기 위해 삭제한다. */
		clearGridJsonObject(tbodyObj);

		var sltSvcTypReason;
		var optSvcTypReason;

		sltSvcTypReason = new Element("select", {
			"id" : "serviceTypeReason",
			"name" : "serviceTypeReason",
			"class" : "selectSN"
		});
		optSvcTypReason = new Element("option", {
			"value" : ""
		});
		optSvcTypReason.update(_l.r.c.LBL_01395);
		sltSvcTypReason.appendChild(optSvcTypReason);

		/**
		 * DAO결과를 화면에 출력
		 */
		var tdTag = null;
		var length = jsonSvcTyRsnObj.EtCodeInfo.length;
		totRow = length;
		for ( var i = 0; i < length; i++) {
			var obj = jsonSvcTyRsnObj.EtCodeInfo[i];
			optSvcTypReason = new Element("option", {
				"value" : obj.CODE_VALUE
			});
			optSvcTypReason.update(obj.CODE_TEXT);

			if (svcTypeReason == obj.CODE_VALUE) {
				optSvcTypReason.selected = true;
			}

			sltSvcTypReason.appendChild(optSvcTypReason);
		}// for (var i = 0; i < length; i++) {
		tbodyObj.appendChild(sltSvcTypReason);
		// sltSvcTypReason.focus();
	}// if (jsonSvcTyRsnObj != null) {
}

/**
 * validation check : in case C550 and service type in (SR, Rb, BS), if there is
 * no service type reason, then alert to user
 * if(!isValidServiceTypeReason(document.detailForm.SERVICE_TYPE,
 * document.detailForm.MODEL)){return;}
 */
function isValidServiceTypeReason(svcTypeElement, modelElement) {
	var valid = false;
	if (_l.u.c != "C550") {
		valid = true;
		return valid;
	}

	var serviceTypeReason = $("serviceTypeReason");

	if (!svcTypeElement)
		svcTypeElement = $("SERVICE_TYPE");
	if (!modelElement)
		modelElement = $("MODEL");

	var svcType = svcTypeElement.value;
	// svcType == "RB" || svcType == "BS" are selected, no need Reason.
	// requested by Sanjay, confirmed by Mr.Yoon, modified by Mr.Kwon 20110531
	if (svcType == "SR") {// Stock Repair,
		if (serviceTypeReason && serviceTypeReason.selectedIndex > 0)
			valid = true;
		else
			valid = false;
	} else {
		valid = true;
	}

	if (!valid) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0042);
	}

	return valid;
}

/**
 * for china  : 중국 전용의 service type onchange event functino
 */
function serviceTypechangeForChina() {
	if (!_l.u.isChinaRegion) return;
	
	//중국의 function serviceTypechange(){ 함수 로직.
	//본로직은 onServiceTypeChanged()  안으로 머지되어야 하나 
	//그러면, onServiceTypeChanged()와 serviceTypechange() 에서 다른로직은 안타도록 해야하는것이 오히려 더 복잡해 져서 
	//맨위로 분기처리함. 
	if( _l.SERVICE_TYPE=='SH' && $("SERVICE_TYPE").value!='SH'){
		$("SERVICE_TYPE").value='SH';
		return;
	}

	if( $("SERVICE_TYPE").value=='SC'){
		$("PURCHASE_DATE").value='';
	}
	
//	Escalation 사용안하므로 모두 주석 처리함.
//	Escalation 로직도  onServiceTypeChanged()안에 존재함.
//if(!_l.isRunningOnOperation){
		if ($("SERVICE_TYPE").value == 'SH') {// Service Handling
			$j("#escalAscTd1,#escalAscTd2").css("display","block");
			if (!json_escalAsc.et_escalation_asc)
				escalAscSearch();
		} else {
			$j("#escalAscTd1,#escalAscTd2").css("display","none");
			confirmEscalation = false;
		}
//	}
	
	if(isNewChina){
		if(flagExchLoad){//flagExchLoad=true : exchange 탭을 한번 열경우 
			exchTabControl();
		}
		viewAIR_INOUT_TYPE();//실내외기 구분 show/hide
		C6V0_fieldView();// product 별로 필드 숨기기,보이기,일기전용 처리 IMEI,PN_NO,OLD_FIRMWARE,NEW_FIRMWARE,UNIT_LOC,imeiScanTd1,imeiScanTd2
    }
	//end : 중국의 function serviceTypechange(){ 함수 로직.
	
	//svcOrderCommon_STS.js 안의 document.ready 에서 이벤트 부친 로직을 이곳으로 옮겨옴.
	if(!ascChangeEvent){
		var tmp = $j('[name=detailForm] [name=ASC_CODE]').val();
		changeC6V0Asc_codeList();
		
		if(tmp != $j('[name=detailForm] [name=ASC_CODE]').val()){
			svcTypeChangeEvent = true;
			$j('[name=detailForm] select[name=ASC_CODE]').trigger('change');
			svcTypeChangeEvent = false;
		}
	}
	//생성화면에서만 사용하므로, 주석 처리함.
	//if($j('[name="detailForm"] [name="OBJECT_ID"]').length == 0 ){//Create Order
	//	if($j('#SERVICE_TYPE').val()=='II'){
	//		$j('#SERIAL_NO').val("M000");
	//	}else{
	//		if($j('#SERIAL_NO').val()=='M000')$j('#SERIAL_NO').val("");
	//	}
	//}
	//end : svcOrderCommon_STS.js 안의 document.ready 에서 이벤트 부친 로직을 이곳으로 옮겨옴.		
	
		
	//ServiceOrderDetailProdRepInfoLite.jsp 안의 document.ready 에서 이벤트 부친 로직이지만 옮기지 않음.
	//!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
	//그러므로 곡꼭!! onchange 시 로직은 ServiceOrderDetailProdRepInfoLite.jsp 안의 document.ready 까지 확인 해야함.
	//이유 : live 로 부쳐서 SERVICE_TYPE html 이 조작된 후에도 이벤트가 연결되므로...
	//$j('select[name="SERVICE_TYPE"]').live('change', function(e) {
	
	if(_l.u.c == "C1X0" || isHmeUser){
		hmeServiceTypechange($("SERVICE_TYPE").value);
	}
	
	return;		

}
function serviceTypechange() {
	
	// EHN15 : field control for EHN
	serviceTypeChangeEHN($("SERVICE_TYPE").value, false);
	
	if (_l.u.c == "C810") {
		if ($("SERVICE_TYPE").value =="CI" || $("SERVICE_TYPE").value =="SR" || $("SERVICE_TYPE").value =="II") {
			$("FREIGHT_AMT_ETC").className="inputRO";
			$("FREIGHT_AMT_ETC").readOnly = true;
			$("FREIGHT_AMT_ETC").value = "";
		} else {
			$("FREIGHT_AMT_ETC").className="input";
			$("FREIGHT_AMT_ETC").readOnly = false;
		}
	}

	if (_l.u.isChinaRegion){
		serviceTypechangeForChina();
		return;		
	}
	
	
	if(_l.isPSApp) {
		if(_l.u.c == 'C770' && ($("SERVICE_TYPE").value =="PS" || $("SERVICE_TYPE").value=="IS")) {
			return;
		} else if(isMeaUser && ($("SERVICE_TYPE").value =="PS" || $("SERVICE_TYPE").value=="IS")) {			
			// 중동은 IS 변경 가능, 단 아래 로직을 타야 해서 분리
		} else {			
			$("SERVICE_TYPE").value = "PS";
			return;
		}
	}
	onServiceTypeChanged(document.detailForm.SERVICE_TYPE.value);
	addServiceTypeReason(document.detailForm.SERVICE_TYPE,
			document.detailForm.MODEL);
	// 서비스 타입만 변경이므로 고민 필요, 토큰 대상 asc 여부만 있으면 별도 함수 호출없이 토글 가능
	// serviceTokenAscchk( document.detailForm.ASC_CODE.value);

	var serviceType = $("SERVICE_TYPE").value;
	var statusCode = $("STATUS").value;
	
	if (_l.isRhSelectCheck && serviceType == "RH"){
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0642);
		$("SERVICE_TYPE").value = _l.SERVICE_TYPE;
		return;
	}	

	if (_l.hasServiceTypeNeedSAW) {
		if (serviceType == "IS" || serviceType == "PD") { // Inspection or Product Discount
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0186);
		} else if (serviceType == "SR") { // Srvice Return
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0187);
		} else if (serviceType == "SP") { // Service Point
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0188);
		}
	}// if(_l.hasServiceTypeNeedSAW){

	if (_l.u.c == "C550") {
		if(_l.u.CountryCd == "LK") {
			changeDistanceSlab(serviceType);
		}
		
		if ((statusCode == "ST035" || statusCode == "ST040")
				&& serviceType == "CI" && statusCode != _l.currStatus) {
			$j("#serviceDateTD1,#serviceDateTD2,#serviceDateTD3").css("display","inline");
			$j("#reasonCodeCom").css("display","inline").attr("disabled","true");
			if (statusCode == "ST035") {
				$("reasonCodeCom").innerHTML = _l.COMPL_DELAY_REAS_COMBO;
			} else if (statusCode == "ST040") {
				if ($("COMPL_DELAY_REAS")) {
					$("COMPL_DELAY_REAS").value = _l.COMPL_DELAY_REAS;
				}
				$("reasonCodeCom").innerHTML = _l.DLVRY_DELAY_REAS_COMBO;
			}
		} else {
			$j("#serviceDateTD3,#reasonCodeCom").css("display","none");
		}
		
		reasonCodeGroupSearch();
		
		$('REP_TYPE').value = $('SERVICE_TYPE').value;
		
	}// if(_l.u.c == "C550"){

	// [EU] Show the drop-down list for Sub Service Type
	if (currTabId == 'divJob') {
		toggleSubServicetype(isEuUser, true, serviceType);
	}
	// HME 확산에 따른 isMedisonUser 추가 2015.03.19 jiw
	// HME user role 화면 2015.04.17 jiw
	if(_l.u.c == "C1X0" || isHmeUser){
		hmeServiceTypechange($("SERVICE_TYPE").value);
	}

	// =============================================================================
	// 제 목 : 인도 Demand
	// 과 제 : Fedex system integration with GSPN
	// 수 정 일 : 2015-05-18
	// 내 용 : CorpCode가 "C550"와 CountryCode가 "IN"일때 Docket 버튼과 Challan버튼 생성
	// SH건일때는 Status ST035로 변경되기 전에 Generate docket 버튼 생성
	// PS건일때는 Status ST035로 변경된 후에 Gnererate docket 버튼 생성
	// =============================================================================
	initFedexShipButton("divShipping");
	// =============================================================================

	if(serviceType=='PS'){// Pick up Service
		$j('#trShipMethod').show();
	}else{
		$j('#trShipMethod').hide();
	}
	
	/*
	 * 미주 통합 - RT-007 - Defect Type IP Inspection (Service Type이 SW(Set Swap일
	 * 경우만 해당) - 2015-09-14
	 */	
	if (_l.u.c == 'C370' ){
		limitDefectType370();
	}else if (_l.u.c == 'C4D0' || _l.u.c == 'C4A0'){
		limitDefectTypeEU();
	}
	if(_l.u.c == 'C310'){
		initializeBOS();
	}
	
	getEngineerList();

}

function onServiceTypeChanged(objValue) {
	function rollbackSvcType(SERVICE_TYPE, currSvcType) {
		SERVICE_TYPE.value = currSvcType;
		SERVICE_TYPE.focus();
	}
	var SERVICE_TYPE = $("SERVICE_TYPE");
	var svctype = SERVICE_TYPE.value;
	var corp = _l.u.c;
	var currSvcType = _l.SERVICE_TYPE;

	
	/*
	 * - Allow only Below svc type change . 1. From IH to PS (Where Center Type=
	 * MSC and ASC) 2. From CI to SH ( For all Centre Type) 3. From DM to II (
	 * For all Centre Type) 4. From II to DM
	 */
	if ("C550" == corp && _l.u.CountryCd == "IN"){
		if(currSvcType == "IH" && svctype == "PS" &&  (_l.u.CenterType == "C" || _l.u.CenterType == "M" || _l.u.CenterType == "A")  ){
		}else if(currSvcType == "CI" && svctype == "SH"){
		}else if(currSvcType == "IH" && svctype == "SH"){
		}else if(currSvcType == "DM" && svctype == "II"){
		}else if(currSvcType == "II" && svctype == "DM"){
		}else if(currSvcType == "CI" && svctype == "CC"){
		}else if(currSvcType == "CC" && svctype == "CI"){
		}else{
			
			// =================================================================================//
			// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
			// Activation
			// 수정일 : 2015.04.28
			// 수정자 : 채보람 (로젠 솔루션)
			// 내 용 : _l.SVC_PRCD == "HHP01", "HHP05", "HHP06"이고 Posring Date 와
			// Purchase Date 가 7일 이내 이고, Activation Date가 존재하면
			// 서비스 타입이 RH 로 변경 가능 from (CI, IH, PS, SR)
			if(_l.isIndia && _l.isHHPIndia){
				// return = true 이면 권한 alert 후 return
				var returnFlag = false;
				
				// header.getCREATE_DATE()
				var initpostingDate = toDisplayScreenDate(_l.CREATE_DATE, ".", _l.u.DateFormat2);
				
				// model.getPURCHASE_DATE()
				var initPurchaseDate = _l.PURCHASE_DATE;
				
				// Posting Date 와 Purchase Date 의 날짜 비교
				var compareDate = cfGetDateDiff(cfGetDate(initPurchaseDate, _l.u.DateFormat2), cfGetDate(initpostingDate, _l.u.DateFormat2));
				
				var indiaDOA = false;
				
				if($j("#BOS_FLAG").val() == ""){
					if(compareDate < 14){
						indiaDOA = true;
					}
				}
				else{
					if(_l.sawExistExchangeApporvedTa){
						indiaDOA = true;
					}
				}
				
				if(initPurchaseDate != "" && initPurchaseDate != "00000000"){
					if(indiaDOA){
						if((currSvcType == "CI" || currSvcType == "IH" || currSvcType == "PS" || currSvcType == "SR") && svctype == "RH"){ // Service Type 을 "RH"로 변경 가능
							if(_l.sielDOAreturnPilot){
								if(_l.sawExistExchangeRequestedTa){
									alert("SAW should be approved before changing svc type");
									returnFlag = true;
								}else if(!_l.sawExistExchangeApporvedTa){
									alert("Please raise Exchange SAW!");
									returnFlag = true;
								}
							}
						}else{
							returnFlag = true;
						}
					}else{
						returnFlag = true;
					}
				}else{
					returnFlag = true;
				}
				
				// return = true 이면 권한 alert 후 return
				if(returnFlag){
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0263);
					rollbackSvcType(SERVICE_TYPE, currSvcType);
					return;
				}
			// =================================================================================//
				
			}else{
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0263);
				rollbackSvcType(SERVICE_TYPE, currSvcType);
				return;
			}
		}
	}
	
	// =================================================================================//
	// 제 목 : 표준 반품 프로세스 적용 테스트를 위한 QA 반영 요청건
	// 수정일 : 2017.04.06
	// 수정자 : jinhaw.bae
	// 내 용 : 서비스 타입 RH에서 다른 서비스 타입으로 변경 않되도록 적용
	
	if ("C550" == corp && (_l.u.CountryCd == "BD" || _l.u.CountryCd == "NP" || _l.u.CountryCd == "LK")){
		if(currSvcType == "RH"){
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0263);
			rollbackSvcType(SERVICE_TYPE, currSvcType);
			return;
		} 
	}
	// =================================================================================//
	var possibleIHAscForSEF = "0004771341,0002100766,0001786501,0003199589,0003199589,0004925037,0002100778,0001786782,0009329237,0002295673,0001782340,0001408989";
	if (_l.CALL_CATEGORY == "O" && currSvcType != "IH") {
		if("C560" == corp && currSvcType == "IS"){

		} else if ("C480" == corp && possibleIHAscForSEF.indexOf(_l.ASC_CODE) != -1) {

		} else if (svctype == 'IH') {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_NOTICEIH);
			rollbackSvcType(SERVICE_TYPE, currSvcType);
			return;
		}
	}// if(_l.CALL_CATEGORY == "O" && _l.SERVICE_TYPE != "IH")
	// [SRSC|SEUC|SETK] ASCs cannot change tickets to IH regardless of whether
	// it is inbound or outboud.
	if ("C9E0|C941|C962|C750|C560|C713".indexOf(corp) > -1 && currSvcType != "IH") { // SRSC 법인 통합
		if("C560" == corp && currSvcType == "IS"){
			
		}else if (svctype == 'IH') {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_NOTICEIH);
			rollbackSvcType(SERVICE_TYPE, currSvcType);
			return;
		}
	}// if("C9E0|C962|C750".indexOf(corp) > -1 && _l.SERVICE_TYPE != "IH") {

	if ("C550,".indexOf(corp) != -1 && currSvcType != "CI") {
		if (svctype == 'CI') {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0254);
			rollbackSvcType(SERVICE_TYPE, currSvcType);
			return;
		}
	}// if("C550,".indexOf(corp) != -1 && _l.SERVICE_TYPE != "CI") {
	
	if (corp == "C701" && "CI|PS|RH|SR".indexOf(currSvcType) > -1) {
		if (svctype == 'IH') {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_NOTICEIH);
			rollbackSvcType(SERVICE_TYPE, currSvcType);
			return;
		}
	}

	// SEWA(C701) PR 타입 변경 못함 2015.09.02 jiw
	if(corp == "C701" && currSvcType == 'PR') {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0263);
		rollbackSvcType(SERVICE_TYPE, currSvcType);
		return;
	}// if (corp == "C701" && currSvcType == 'PR') {
	
	// EU user, saw 교환일때 RH 이외 타입 변경 못함 2016.03.02 jiw
	if(isEuUser){
		if(currSvcType == 'RH') {			
			if(_l.sawExistExchange && _l.sawExistExchangeSataus == "SS010"){
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_NOTCHGSVCTYPE);
				SERVICE_TYPE.value = currSvcType;
				return;
			}
		} else if(svctype == 'RH') {
			// RH 수기립력 불가 적용
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_NOTCHGSVCTYPERH);
			SERVICE_TYPE.value = currSvcType;
			return;
		}
		if (corp == "C430" && currSvcType == "BS") {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0263);
			rollbackSvcType(SERVICE_TYPE, currSvcType);
			return;
		}
	}
	
	// C23070005633 [SENZ] Apply RH Auto change logic
	if(corp == "C565" && ((currSvcType == "RH" && svctype != 'RH') || (currSvcType != "RH" && svctype == 'RH'))) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0263);
   		rollbackSvcType(SERVICE_TYPE, currSvcType);
   		return;
	}

	if(!_l.isRunningOnOperation && corp == "C941" && ((currSvcType == "RH" && svctype != 'RH') || (currSvcType != "RH" && svctype == 'RH'))) {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0263);
   		rollbackSvcType(SERVICE_TYPE, currSvcType);
   		return;
	}

	// Repair Escalation Process
	if (corp != 'C4A0' && currSvcType == 'SH' && svctype != 'SH') {
		svctype = 'SH';
		return;
	}
	if (corp == 'C4A0' && $("SVC_PRCD").value == '') {
		SERVICE_TYPE.value = currSvcType;
		$j("#escalAscTd1,#escalAscTd2").css("display","none");
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0162);
		return;
	} else {
		if (svctype == 'SH' && !(_l.u.c == "C370" || isEuUser) ) {// Service Handling
			$j("#escalAscTd1,#escalAscTd2").css("display","block");
			if (!json_escalAsc.et_escalation_asc)
				escalAscSearch();
		} else {
			$j("#escalAscTd1,#escalAscTd2").css("display","none");
			confirmEscalation = false;
		}
	}

	if ("C530" == corp && currSvcType != "DM" && svctype == 'DM') {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_NOTICEDM);
		rollbackSvcType(SERVICE_TYPE, currSvcType);
		return;
	}
	
	if ("C570" == corp && currSvcType != "DM" && svctype == 'DM') {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_NOTICEDM);
				rollbackSvcType(SERVICE_TYPE, currSvcType);
				return;
	}

	if(_l.blockServiceTypeChangeDOA && ((currSvcType == "IS" && svctype != 'IS') || (currSvcType == "RH" && svctype != 'RH'))) {
	  	if(_l.sawExistExchangeForBranchApproved) {
	   		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0263);
	   		rollbackSvcType(SERVICE_TYPE, currSvcType);
	   		return;
	  	}
	 }
	
	if((corp == 'C770' || corp == 'C780') && ((currSvcType != "IS" && svctype == 'IS') || (currSvcType != "RH" && svctype == 'RH'))) {
	  	if(!_l.haveSAW || _l.sawExistExchangeForBranchApproved) {
	   		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0263);
	   		rollbackSvcType(SERVICE_TYPE, currSvcType);
	   		return;
	  	}
	}
	
	if (corp == 'C702' && currSvcType == 'IS' && svctype != 'IS') {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0263);
		rollbackSvcType(SERVICE_TYPE, currSvcType);
		return;
	}
	haveToReload = true;
} // function onServiceTypeChanged(objValue)

function checkGdResult() {
	$('progressloading').startWaiting();
	$('detailForm').cmd.value = 'GDValidCheckResultCmd';
	AjaxSyncRequest(urlPatternGZIP,	'detailForm', setCheckGdResult);
}

function setCheckGdResult(response) {
	try {
		var jsonObj = response.responseText.evalJSON();
		if (jsonObj.success) {
			if(jsonObj.EV_RET_TYPE == "9") {
				_l.isVerifiedCC = true;
			} else {
				_l.isVerifiedCC = false;
			}
		} else {
			_l.isVerifiedCC = false;
		}
	} catch (e) {
		_l.isVerifiedCC = false;
	} finally{	    			
		$('progressloading').stopWaiting();
	}
}

/* Escal ASC code group. */
function escalAscSearch() {
	$('tempForm').cmd.value = 'EscalAscSearchCmd';
	AjaxRequest(urlPatternGZIP+'?IV_ASC_CODE='
			+ $('ASC_CODE').value + '&IV_SVC_PRD=' + $('SVC_PRCD').value,
			'tempForm', setEscalAsc);
}

var json_escalAsc = '';
function setEscalAsc(response) {
	json_escalAsc = eval('(' + response.responseText + ')');
	var jcode = "";
	var jtitle = "";
	/** Select 박스 ID */
	var selectObj = $('ESCAL_ASC');
	selectObj.length = 1;
	var length = json_escalAsc.et_escalation_asc.length;
	if (length == 0) {
		$("SERVICE_TYPE").value = _l.SERVICE_TYPE;
		$j("#escalAscTd1,#escalAscTd2").css("display","none");
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0163);
	} else {
		for ( var i = 0; i < length; i++) {
			var obj = json_escalAsc.et_escalation_asc[i];
			jcode = obj.escalation_asc;
			jtitle = obj.asc_name;
			var newOption = document.createElement('option');
			newOption
					.appendChild(document.createTextNode(jcode + ' ' + jtitle));
			newOption.setAttribute("value", jcode);
			selectObj.appendChild(newOption);
		}
	}
}

/*
 * on transit status below dates fields will appear...dynamically 25 : asc 1st
 * app, asc last app 30 : asc last app, 1st visit, last visit 35 : 1st visit,
 * last visit //dynamicDateOnTransitStatus
 */
function bindDynamicDateOnTransitStatus(saveFlag){
	var _l = window._l;
	var statusCode = $j("#STATUS").val();
	var currStatus = _l.CurrStatus;
	
	if( saveFlag ){
		if (statusCode != currStatus) {
			if (statusCode == "ST025"){
				$j("#FIRST_APP_DATE,#FIRST_APP_TIME,#LAST_APP_DATE,#LAST_APP_TIME").prop("disabled","false").parent().find("img").remove();
			}else if (statusCode == "ST030"){
				$j("#LAST_APP_DATE,#LAST_APP_TIME,#FIRST_VISIT_DATE,#FIRST_VISIT_TIME,#LAST_VISIT_DATE,#LAST_VISIT_TIME").prop("disabled","false").parent().find("img").remove();
			}else if (statusCode == "ST035"){
				$j("#FIRST_VISIT_DATE,#FIRST_VISIT_TIME,#LAST_VISIT_DATE,#LAST_VISIT_TIME").prop("disabled","false").parent().find("img").remove();
			}
		}
	}
	
	if (statusCode != currStatus) {
		if (statusCode == "ST025"){
			if(_l.FIRST_APP_DATE != $j("#FIRST_APP_DATE_DY_STT").val()){
				$j("#FIRST_APP_DATE").val($j("#FIRST_APP_DATE_DY_STT").val());
				$j("#FIRST_APP_TIME").val($j("#FIRST_APP_TIME_DY_STT").val());
			}
			if(_l.LAST_APP_DATE != $j("#LAST_APP_DATE_DY_STT").val()){
				$j("#LAST_APP_DATE").val($j("#LAST_APP_DATE_DY_STT").val());
				$j("#LAST_APP_TIME").val($j("#LAST_APP_TIME_DY_STT").val());
			}
		}else if (statusCode == "ST030"){
			if(_l.LAST_APP_DATE != $j("#LAST_APP_DATE_DY_STT").val()){
				$j("#LAST_APP_DATE").val($j("#LAST_APP_DATE_DY_STT").val());
				$j("#LAST_APP_TIME").val($j("#LAST_APP_TIME_DY_STT").val());
			}
			if(_l.LAST_VISIT_DATE != $j("#LAST_VISIT_DATE_DY_STT").val()){
				$j("#LAST_VISIT_DATE").val($j("#LAST_VISIT_DATE_DY_STT").val());
				$j("#LAST_VISIT_TIME").val($j("#LAST_VISIT_TIME_DY_STT").val());
			}
			if(_l.FIRST_VISIT_DATE != $j("#FIRST_VISIT_DATE_DY_STT").val()){
				$j("#FIRST_VISIT_DATE").val($j("#FIRST_VISIT_DATE_DY_STT").val());
				$j("#FIRST_VISIT_TIME").val($j("#FIRST_VISIT_TIME_DY_STT").val());
			}
		}else if (statusCode == "ST035"){
			if(_l.FIRST_VISIT_DATE != $j("#FIRST_VISIT_DATE_DY_STT").val()){
				$j("#FIRST_VISIT_DATE").val($j("#FIRST_VISIT_DATE_DY_STT").val());
				$j("#FIRST_VISIT_TIME").val($j("#FIRST_VISIT_TIME_DY_STT").val());
			}
			
			if(_l.LAST_VISIT_DATE != $j("#LAST_VISIT_DATE_DY_STT").val()){
				$j("#LAST_VISIT_DATE").val($j("#LAST_VISIT_DATE_DY_STT").val());
				$j("#LAST_VISIT_TIME").val($j("#LAST_VISIT_TIME_DY_STT").val());
			}
			/*
			 * ASC last App[LAST_APP_DATE_DY_STT](main)과 ASC last
			 * App[LAST_APP_DATE](job&date) 값이 달라 저장시 job&date의 값이 저장되어야 하는데
			 * main의 hidden 값으로 저장되어 job&date 의 데이터가 저장될수 있도록 치환 로직 추가 jiw
			 * 2015.01.28
			 */
			if($j("#LAST_APP_DATE").val() != $j("#LAST_APP_DATE_DY_STT").val()){
				// EHN20
				//$j("#LAST_APP_DATE_DY_STT").val($j("#LAST_APP_DATE").val());
				//$j("#LAST_APP_TIME_DY_STT").val($j("#LAST_APP_TIME").val());
				$j("#LAST_APP_DATE").val($j("#LAST_APP_DATE_DY_STT").val());
				$j("#LAST_APP_TIME").val($j("#LAST_APP_TIME_DY_STT").val());				
			}
		}
	}else{		
		if( saveFlag ){// when save, this is true...
			//EHN : as-is : job 탭이 기본 열렷지만(job_flag=X), to-be 는 job 탭이 기본 안열림. 그래서 JOB_FLAG='' 임.
			//to-be는  아래날짜값들이 svc_modify 로 전달될때 is_job_info 가 아닌, is_main_info 값을 사용한다.
			//결국 is_main_info 에 값이 없어서, 샙이관된 체크로직에 걸리게 된다.(값이 있음에도 공백이 넘어가므로)
			//그래서 아래 빈값 처리하는 로직을 주석 처리햇다. 값이 is_main_info에 넘어 가도록 하가 위해서.  
			//$j("#FIRST_APP_DATE_DY_STT,#FIRST_APP_TIME_DY_STT,#LAST_APP_DATE_DY_STT,#LAST_APP_TIME_DY_STT,#FIRST_VISIT_DATE_DY_STT,#FIRST_VISIT_TIME_DY_STT,#LAST_VISIT_DATE_DY_STT,#LAST_VISIT_TIME_DY_STT").val("");
		
			//위처럼 주석처리하더라도, 상태변경은 안하고 잡탭에서 날짜/시간을 변경한경우, 메인탭의 히든 값이 저장되어버린다(즉 날짜/시간 변경안된다)
			// EHN20
			/*
			$j("#FIRST_APP_DATE_DY_STT").val($j("#FIRST_APP_DATE").val());
			$j("#FIRST_APP_TIME_DY_STT").val($j("#FIRST_APP_TIME").val());			
			$j("#LAST_APP_DATE_DY_STT").val($j("#LAST_APP_DATE").val());
			$j("#LAST_APP_TIME_DY_STT").val($j("#LAST_APP_TIME").val());
			
			$j("#FIRST_VISIT_DATE_DY_STT").val($j("#FIRST_VISIT_DATE").val());
			$j("#FIRST_VISIT_TIME_DY_STT").val($j("#FIRST_VISIT_TIME").val());			
			$j("#LAST_VISIT_DATE_DY_STT").val($j("#LAST_VISIT_DATE").val());
			$j("#LAST_VISIT_TIME_DY_STT").val($j("#LAST_VISIT_TIME").val());	
			*/
		}
	}
	
}

function toggleDynamicDateOnTransitStatus(statusCode, currStatus){
    // EHN20
	var statusArray = ["ST040", "ST052"];
	if ($j.inArray(statusCode, statusArray) == -1) {
		if ("" == _l.FIRST_APP_DATE || "00" == _l.FIRST_APP_DATE.substring(0, 2)) {
			$j("#serviceDateTD1_FIRST_APP,#serviceDateTD2_FIRST_APP").show();
		} else {
			$j("#serviceDateTD1_LAST_APP,#serviceDateTD2_LAST_APP").show();
		}
		if ("" == _l.FIRST_VISIT_DATE || "00" == _l.FIRST_VISIT_DATE.substring(0, 2)) {
			$j("#serviceDateTD1_FIRST_VISIT,#serviceDateTD2_FIRST_VISIT").show();
		} else {
			$j("#serviceDateTD1_LAST_VISIT,#serviceDateTD2_LAST_VISIT").show();
		}
	}

	if (statusCode != currStatus) {
		// EHN20
		/*
		if (statusCode == "ST025"){
			$j("#serviceDateTD1_FIRST_APP,#serviceDateTD2_FIRST_APP,#serviceDateTD1_LAST_APP,#serviceDateTD2_LAST_APP").show();
		}else if (statusCode == "ST030"){
			$j("#serviceDateTD1_LAST_APP,#serviceDateTD2_LAST_APP,#serviceDateTD1_FIRST_VISIT,#serviceDateTD2_FIRST_VISIT,#serviceDateTD1_LAST_VISIT,#serviceDateTD2_LAST_VISIT").show();
		}else if (statusCode == "ST035"){
			$j("#serviceDateTD1_FIRST_VISIT,#serviceDateTD2_FIRST_VISIT,#serviceDateTD1_LAST_VISIT,#serviceDateTD2_LAST_VISIT").show();
		}
		*/
		if(currTabId == "divJob"){
			hideDynamicDateOnTransitStatus();
		}
	}	
}

function hideDynamicDateOnTransitStatus(){
	var _l = window._l;
	var statusCode = $j("#STATUS").val();
	var currStatus = _l.CurrStatus;
	
	// EHN20
	/*
	if (statusCode != currStatus) {
		if (statusCode == "ST025"){
			$j("#FIRST_APP_DATE,#FIRST_APP_TIME,#LAST_APP_DATE,#LAST_APP_TIME").prop("disabled","true").parent().find("img").remove();
		}else if (statusCode == "ST030"){
			$j("#LAST_APP_DATE,#LAST_APP_TIME,#FIRST_VISIT_DATE,#FIRST_VISIT_TIME,#LAST_VISIT_DATE,#LAST_VISIT_TIME").prop("disabled","true").parent().find("img").remove();
		}else if (statusCode == "ST035"){
			$j("#FIRST_VISIT_DATE,#FIRST_VISIT_TIME,#LAST_VISIT_DATE,#LAST_VISIT_TIME").prop("disabled","true").parent().find("img").remove();
		}
	}
	*/
    $j("#FIRST_APP_DATE,#FIRST_APP_TIME,#LAST_APP_DATE,#LAST_APP_TIME").addClass("inputRO").parent().find("img").remove();
    $j("#FIRST_VISIT_DATE,#FIRST_VISIT_TIME,#LAST_VISIT_DATE,#LAST_VISIT_TIME").addClass("inputRO").parent().find("img").remove();
	
}
// Status에 따른 Reason code로 변경, display 변경
function changeStatusCode() {

	var statusCode = $("STATUS").value;
	var serviceType = $('SERVICE_TYPE').value;
	var reasonCode = _l.currReason;
	var currStatus = _l.currStatus;
	var strHTML = "";

	if(_l.u.isChinaRegion && !isCPSo){
		$j('#SERVICE_DATE').val("");
		$j('#SERVICE_TIME').val("");
	}
	
	$j("#serviceDateTD1,#serviceDateTD2,#serviceDateTD1_FIRST_APP,#serviceDateTD2_FIRST_APP,#serviceDateTD1_LAST_APP,#serviceDateTD2_LAST_APP,#serviceDateTD1_FIRST_VISIT,#serviceDateTD2_FIRST_VISIT,#serviceDateTD1_LAST_VISIT,#serviceDateTD2_LAST_VISIT").hide();
	
	if (statusCode == "ST030" || statusCode == "ST015") { // "PENREASON";
															// //pending
		$j("#serviceDateTD1,#serviceDateTD2").hide();
		
		//HP040,HP045 : parts not available
		if(_l.u.isChinaRegion && statusCode == "ST030" && (reasonCode == "HP040" || reasonCode == "HP045")){
			//moreOpenid(10);/*Parts Info Tab*/
			// EHN15 : (division id 변경)
			$j('#divRparts').show();
			//$j('#partInfoTr').show();
		}
		
		
	} else {
		if (currStatus == "ST035" || currStatus == "ST025" 
				|| currStatus == "ST040") {
			$j("#serviceDateTD1,#serviceDateTD2").hide();
		}

		if (statusCode != currStatus
				&& (statusCode == "ST025" || statusCode == "ST035"
						|| statusCode == "ST040" || statusCode == "ST052")) {
			if (statusCode == "ST025")
				$("serviceDateTD1").innerHTML = _l.r.c.LBL_00263;
			if (statusCode == "ST035")
				$("serviceDateTD1").innerHTML = _l.r.c.LBL_00663;
			if (statusCode == "ST040")
				$("serviceDateTD1").innerHTML = _l.r.c.LBL_00332;
			if (statusCode == "ST052")
				$("serviceDateTD1").innerHTML = _l.r.c.LBL_02469;
			
			$j("#serviceDateTD1,#serviceDateTD2").show();
			
			if(_l.u.isChinaRegion && (!isCPSo || statusCode != "ST040")){
				setDefaultStatusDate();
			}
		}

		if ("C550" == _l.u.c) {
			if (statusCode != currStatus
					&& (statusCode == "ST035" || statusCode == "ST040")
					&& serviceType == "CI") {
				if (!$("serviceDateTD3").checked) {
					$("SERVICE_DATE").readOnly = true;
					$("SERVICE_TIME").readOnly = true;
				} else {
					$("SERVICE_DATE").readOnly = false;
					$("SERVICE_TIME").readOnly = false;
				}

				$j("#serviceDateTD2,#serviceDateTD3").css("display","inline");
				$j("#reasonCodeCom").css("display","inline").attr("disabled","true");
				
				if (statusCode == "ST035") {
					$("reasonCodeCom").innerHTML = _l.COMPL_DELAY_REAS_COMBO;
				} else if (statusCode == "ST040") {
					if ($("COMPL_DELAY_REAS")) {
						$("COMPL_DELAY_REAS").value = _l.COMPL_DELAY_REAS;
					}
					$("reasonCodeCom").innerHTML = _l.DLVRY_DELAY_REAS_COMBO;
				}
			} else {

				if ($("serviceDateTD3")) {
					$j("#serviceDateTD3,#reasonCodeCom").hide();
				}
			}
			
		}// if("C550"==_l.u.c){
	}// if(statusCode == "ST030"){

	// display dynamic fields : 
	//상태에 따라 같이 입력해야 하는 날자 정보가 나타난다, 탭으로 이동하지 않고 날짜정보를 입력하기 위함.
	//중국은 없는 기근이지만, 이대로 둔다. 법인테스트시 이의를 제가하면 그때 주석처리 한다. 
	toggleDynamicDateOnTransitStatus(statusCode, currStatus);
	
	//중국은 수리타입에 무관하게 언제나 reason을 뿌림.
	if(_l.u.isChinaRegion){
		reasonCodeGroupSearch();
	}else{
		if(_l.isRepairTicket){		
			//AscDepotUser : SEA 전용. role : 0009	DepotService	SEA의 ASC Depot Service
			// ASC Depot User 이고 Pending 또는 , Ready for shipping.이면
			if (_l.u.AscDepotUser && (statusCode == "ST030" || statusCode == "ST034")) {
				$("reasonCodeTD").innerHTML = _l.DEPOT_REASON_COMBO;
			} else {
				reasonCodeGroupSearch();
			}
			getEngineerList();
		}else if(_l.u.c == "C370" && _l.isExchTicket){
			reasonCodeExch();
		}
	}

	/**
	 * Field manager can change job's branch()
	 */
	/*
	 * if(isFieldManager && !resource.isAscRO(header.getASC_CODE()) &&
	 * !blockSaveFlag){ if(statusCode == "ST015" || statusCode == "ST025"){
	 * if($("trAssignedFe")){ $("trAssignedFe").show(); } }else{
	 * if($("trAssignedFe")){ $("trAssignedFe").hide(); } } }
	 */
}

/* reason code group. */
function reasonCodeGroupSearch() {
	$('tempForm').cmd.value = 'CICCodeSearchCmd';
	
	var UPPER_GROUP="TRSTATUS";
	if(_l.u.isChinaRegion){
		UPPER_GROUP = _l.detailTypeGroup;
	}
	
	if(_l.u.c == "C550" && ($("SERVICE_TYPE").value == "IH"|| $("SERVICE_TYPE").value == "PS" || $("SERVICE_TYPE").value == "CI" || $("SERVICE_TYPE").value == "II" || $("SERVICE_TYPE").value == "DM")){
		AjaxRequest(urlPatternGZIP + '?CODE_GROUP=&UPPER_GROUP=TRSTATUS_'+$("SERVICE_TYPE").value+'&UPPER_VALUE='
				+ $("STATUS").value, 'tempForm', setReasonCodeCombo);
	}else if(_l.u.isChinaRegion){
		if(UPPER_GROUP == "EXSTATUS" || UPPER_GROUP == "RFSTATUS"){
			AjaxRequest(urlPatternGZIP + '?CODE_GROUP='+'RMASTATUS'+'&UPPER_GROUP='+UPPER_GROUP+'&UPPER_VALUE='
					+ $("STATUS").value, 'tempForm', setReasonCodeCombo);
		}else{
			AjaxRequest(urlPatternGZIP + '?CODE_GROUP=&UPPER_GROUP='+UPPER_GROUP+'&UPPER_VALUE='
					+ $("STATUS").value, 'tempForm', setReasonCodeCombo);
		}
	}else{
		AjaxRequest(urlPatternGZIP + '?CODE_GROUP=&UPPER_GROUP='+UPPER_GROUP+'&UPPER_VALUE='
				+ $("STATUS").value, 'tempForm', setReasonCodeCombo);
	}
}
function setReasonCodeCombo(response) { // 2015.08.06
	var jsonObjC = eval('(' + response.responseText + ')');
	var jcode = "";
	var jtitle = "";
	var REASON = _l.REASON;
	
	$("reasonCodeTD").innerHTML = "&nbsp;";// 초기화
	/** Select 박스 ID */
	var selectObj = new Element("select", {
		'name' : 'REASON',
		'id' : 'REASON',
		'class' : 'select',
		'style' : 'width:98%'
	});
	

	if(_l.u.c == 'C310' && _l.currStatus != "ST035") {
		if ($("STATUS").value != "ST035") {
			if(beforeServiceType != "" && $("SERVICE_TYPE").value == "IS") {
 				$("SERVICE_TYPE").value = beforeServiceType;
 				beforeServiceType = "";
 			}
		}
	}
	
	if(_l.currStatus == "ST040" && _l.currReason == "HOZ07"){
		
		var firstOption = document.createElement('option');
		firstOption.appendChild(document.createTextNode("Transfer to Advance Exchange[HOZ07]"));
		firstOption.setAttribute("value", "HOZ07");
		selectObj.appendChild(firstOption);
	
	}else{
		
		//중국은 reson onchange 이벤트가 없으므로, 바로 return 처리한다.
		selectObj.onchange = (function(obj) {
			return function() {

				var corpcode = _l.u.c;
				var statusCode = $("STATUS").value;
				
				if((corpcode == 'C6V0' || corpcode == 'C630') && obj.value == "HL020"){//wait to cconfirm(mobile)
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.REASON_NOTICE);
					$('REASON').focus();
					$('REASON').value = REASON;
					
					return;////중국은 reson onchange 이벤트가 없으므로, 바로 return 처리한다.
				}
				

	
				if (corpcode == 'C820' && statusCode == "ST030") {
					if (obj.value == "HPZ42" || obj.value == "HPZ43"
							|| obj.value == "HPZ51") {
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.REASON_NOTICE);
						$('REASON').focus();
						$('REASON').value = REASON;
						return;
					}
				}
				
				if(corpcode == 'C550' && statusCode == "ST030"){
					if(_l.currReason == "HP040" || _l.currReason == "HP041" || _l.currReason == "HP042" || _l.currReason == "HP043" 
					|| _l.currReason == "HP045" || _l.currReason == "HP046" || _l.currReason == "HP050" || _l.currReason == "HP051" || _l.currReason == "HP065"){
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0697);
						$('REASON').focus();
						$('REASON').value = REASON;
						return;
					}
				}
				
	        	if(corpcode == 'C310' && _l.currStatus != "ST035") {             		
	             	if (statusCode == "ST035") {
	             		if (($("SERVICE_TYPE").value == "IH" || $("SERVICE_TYPE").value == "CI") && obj.value == "HLZ05") {             			
	             			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.REASON_NOTICEFORIS);
	             			if ($("SERVICE_TYPE").value != "IS") {
		             			beforeServiceType = $("SERVICE_TYPE").value;
	             			}
	             			$("SERVICE_TYPE").value = "IS";
	             		} else if ($("SERVICE_TYPE").value == "PS" && (obj.value == "HLZ06" || obj.value == "HLZ05")) {
	             			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.REASON_NOTICEFORIS);
	             			if ($("SERVICE_TYPE").value != "IS") {
	             				beforeServiceType = $("SERVICE_TYPE").value;
	             			}
	             			$("SERVICE_TYPE").value = "IS";
	             		} else if ($("SERVICE_TYPE").value == "IS" && (obj.value == "HLZ05" || obj.value == "HLZ06")) {
	             			
	             		} else {
	             			if(beforeServiceType != "" && $("SERVICE_TYPE").value == "IS") {
	             				$("SERVICE_TYPE").value = beforeServiceType;
	             				beforeServiceType = "";
	             			}
	             		}
	             	}
	        	}
	            
				setShowImgSearchConfirm(); // Image Search Confirm을 보이게 할지 숨길지
											// 처리
	
				// ST052 cancelled by asc and customer not home(HC025)
				showCustomerCallAttempt(canSeeCallAttempt);
				
				if(_l.useQNACodeSearch && obj.value == "HP010"){
					$j("#QNA_CODE").removeAttr("disabled");
					$j("#tdQnaLabel,#tdQnaInput").css("display","inline");
				}else{
					$j("#QNA_CODE").removeAttr("disabled");
					$j("#tdQnaLabel,#tdQnaInput").css("display","none");
				}
			}
		})(selectObj);
	
		var possibleType = "HA005,HE003,HE004,HP010,HP020,HP023,HP025,HP030,HP040,HP060,HP076,HP096,HE043,HPZ03,HPZ22,HPZ62,HPZ82,HPZ83,HPZ86,HPZ84,HPZ85,HPZ92,HP035,HPZ89,HP095,HPZ94";
		if(_l.u.c == 'C310'){
			if(isAuthMenuSTDB()){
				possibleType = "HA005,HE003,HE004,HEZ03,HP010,HP020,HP023,HP025,HP030,HP040,HP060,HP076,HP096,HE043,HPZ03,HPZ22,HPZ62,HPZ82,HPZ83,HPZ86,HPZ84,HPZ85,HPZ92,HP035,HPZ89,HP095,HPZ94";
			}
		}
		
		/** 전체옵션을 맨 상단에 위치 시킨다. */
		var firstOption = document.createElement('option');
			
		/*
		 * SIEL(C550), Engineer Assigned(ST025), reason = HE005 default
		 * SIEL(C550), Engineer Assigned(ST025), reason default option remove
		 * 2015.08.06 jiw
		 */
		var defaultOption = 0;
		if(_l.u.c == 'C550'){
			if($("STATUS").value == "ST025"){
				defaultOption = 1;
				if(REASON == "" || _l.currStatus != "ST025"){
				REASON = "HE005";
				}
			}
		}
		if(defaultOption != '1'){
			firstOption.appendChild(document.createTextNode("- - - -"));
			firstOption.setAttribute("value", "");
			selectObj.appendChild(firstOption);
		}

		var length = jsonObjC.EtCodeInfo.length;// alert(length);
	
		for ( var i = 0; i < length; i++) {
			var obj = jsonObjC.EtCodeInfo[i];
			jcode = obj.CODE_VALUE;
			jtitle = obj.CODE_TEXT;
			if (jtitle == '')
				continue;// gabarge data
	
			var newOption = document.createElement('option');
			if("C701|C702|C710|C711|C712|C713|C750|C770|C780".indexOf(_l.u.c) > -1 && jcode == "HP040" && REASON != "HP040") {
			} else {
				newOption.appendChild(document.createTextNode(jtitle + "[" + jcode
						+ "]"));// +"["+jcode+"]"
				newOption.setAttribute("value", jcode);
				
						if (jcode == REASON)
					newOption.selected = true;
		
				if(_l.u.c == 'C310' && ($("STATUS").value == "ST015" || $("STATUS").value == "ST025" || $("STATUS").value == "ST030")){
					var existInEntry =  ( possibleType.indexOf(jcode) != -1 );
					newOption.disabled = !existInEntry;
				}
				if(_l.u.c == 'C310' && $("STATUS").value == "ST035" && (jcode=="HLZ05" || jcode=="HLZ07")){
					newOption.disabled = true;
				}
				if(_l.u.c == 'C370' && (jcode=="HOZ07" || jcode=="HP069")){//SEA WIS Repair티켓에서 교환Reason 선택못하도록 처리 JS.BAEK 2015-10-05
					newOption.disabled = true;
				}
				if(isNewChina && jcode=="HL020"){//wait to confirm(mobile)
					newOption.disabled = true;
				}
				if(_l.u.c == 'C550' && REASON != jcode) {
					if("NP" == _l.u.CountryCd || "LK" == _l.u.CountryCd){
						if("HP041|HP042|HP043|HP046".indexOf(jcode) > -1){
							continue;
						}
					}else{
						if("HP041|HP042|HP043|HP045|HP046|HPZ83".indexOf(jcode) > -1){
							continue;
						}
					}
					
				}
				if(_l.u.c == 'C550' && $("STATUS").value == "ST052" && _l.SUB_SVC_TYPE == "SC"){
					if("HCZ83|HCZ84".indexOf(jcode) == -1){
						continue;
					}
				}
				
				if(_l.u.c == 'C550' && $("STATUS").value == "ST052" && ($("SERVICE_TYPE").value == "AD" || $("SERVICE_TYPE").value == "CI")){
					if("HCZ83".indexOf(jcode) > -1){
						continue;
					}
				}

				if(_l.u.c != 'C550' && $("SERVICE_TYPE").value != "AD" && "HCZ83|HCZ84".indexOf(jcode) > -1){
					continue;
				}
				
				if(obj.CODE_FLAG == 'D'){
					if(REASON == jcode)
						newOption.disabled = true;
					else
						continue;
						
				}
				selectObj.appendChild(newOption);
			}
		}
	}
	$("reasonCodeTD").appendChild(selectObj);

	// init 할때 이 함수가 실행되므로 여기에 추가하자!!!
	//중국도 사용하므로 그대로 둠. 티겟 사용자재의 confirmation No 검색 팝업 제공 여부.
	setShowImgSearchConfirm(); // Image Search Confirm을 보이게 할지 숨길지 처리
}

/**
 * [SEA] Limits the options of the service type to CI, IH & PS.
 */

function limitServiceType() {	
	var options = $j('#SERVICE_TYPE option');
	var possibleEntry = "";
	
	if(_l.u.c == "C310"){
		if(_l.isFieldUser){
			if(_l.isMeUser){// ME(HA)
				possibleEntry = "DM,IH,II,SH,SR";
			}else{// FE(VD)
				possibleEntry = "IH,SH";
			}
		}else{// ASC
			possibleEntry = "CI,IH,PS";
			if("" != _l.DISPLAY_UNIT){  /* DISPLAY_UNIT있을 경우 DM만 활성화 */ 
				possibleEntry = "DM";
			}
			if("D" == _l.u.CenterType || (centerType == "ASC" && "Y" == jsonCenterTypeObj.ES_BP101.ZEXCLUSIVE)){	/* DSC (Dealer SVC Center) */
				possibleEntry += ",SR";
			}// if("D".equals(userVO.getCenterType())){%>
		}
		
	}else{// C370
		possibleEntry = "CI,PS,SH,SW,IH";
	}
	
	possibleEntry += ",PF";
	
	var SERVICE_TYPE = $('SERVICE_TYPE').value;	
	for (var i = 0; i < options.length; i++) {			
		var option = options[i];
		var svcType = option.value; 
		var existInEntry =  ( possibleEntry.indexOf(svcType) != -1 );
		option.disabled = !existInEntry; 
		if(!_l.isFemeUser && svcType == 'SH'){
			if(SERVICE_TYPE== 'CI' || SERVICE_TYPE == 'IH' || SERVICE_TYPE == 'PS'){
				option.disabled = false;
			}
		}
	}// for (var i = 0; i < options.length; i++) {
}

/*
 * 미주 통합 - RT-007 - Defect Type SEA IM - IP Inspection (Service Type이 SW(Set
 * Swap일 경우만 해당) - MN Minor - 2015-09-14
 */	
function limitDefectType370() {	
	var options = $j('#LAB_TYPE option');
	var possibleEntry = "IP,MN,AE";
    var SERVICE_TYPE = $j('#SERVICE_TYPE').val();	
// var SERVICE_TYPE = document.detailForm.SERVICE_TYPE.value;
	var curDefectType = $j("#LAB_TYPE" ).val();
	for (var i = 0; i < options.length; i++) {
		var option = options[i];
		var defectType = option.value; 
		var existInEntry =  ( possibleEntry.indexOf(defectType) != -1 );
		option.disabled = !existInEntry; 
		if(SERVICE_TYPE != 'SH'){// SW -> SH로 변경 SEA IM requested by 정상천 과장
			if(defectType == 'IP' ){
				option.disabled = true;
				if(curDefectType == 'IP'){
					$j("#LAB_TYPE" ).val(null);
				}
			}
		}
	}// for (var i = 0; i < options.length; i++) {
}

function limitDefectTypeEU() {	
	var options = $j('#LAB_TYPE option');
	var possibleEntry = "";
	
    var SERVICE_TYPE = $j('#SERVICE_TYPE').val();
    
    if(_l.u.c == 'C4D0'){
	    /*
	     * a)Return Handling
	     * b)Inspection
	     * c)Initial installation
	     */
	    if(SERVICE_TYPE == "RH"){
	    	possibleEntry = "FL";
		}else if(SERVICE_TYPE == "IS"){
			possibleEntry = "IP";
		}else if(SERVICE_TYPE == "II"){
			possibleEntry = "FL";
		}
    }else if(_l.u.c == 'C4A0'){
    	if(SERVICE_TYPE == "IS" || SERVICE_TYPE == "RH"){
	    	possibleEntry = "HC,HI";
		}
    }
    
	if(possibleEntry != ""){
		for (var i = 0; i < options.length; i++) {
			var option = options[i];
			var defectType = option.value; 
			var existInEntry =  ( possibleEntry.indexOf(defectType) != -1 );
			option.disabled = !existInEntry; 
		}
	}else{
		for (var i = 0; i < options.length; i++) {
			var option = options[i];
			option.disabled = !option;
		}
	}
	
}

function limitServiceType550() {	
	var options = $j('#SERVICE_TYPE option');
	
	var impossibleEntry = "BS";
	
	var SERVICE_TYPE = $('SERVICE_TYPE').value;	
	if(SERVICE_TYPE !="BS"){
		for (var i = 0; i < options.length; i++) {			
			var option = options[i];
			if(option.value == impossibleEntry){
				option.disabled = true;
			}
		}
	}
	
}

function limitServiceTypeMena() {	
	var options = $j('#SERVICE_TYPE option');
	
	var impossibleEntry = "";
	var possibleEntry = "";
	var currSvcType = _l.SERVICE_TYPE;

	if(_l.u.c == 'C710' && _l.u.CountryCd == "IR"){
		impossibleEntry = "AD,RH,PR";
	}else if(_l.u.c == 'C710' && _l.u.CountryCd == "PK"){
		//HAICC-1960 [SEPAK] Request to block SVC Types in GSPN
		impossibleEntry = "BR,BS,ER,FC,FI,MX,PD,PF,PL,RB,RC,RD,RL,SC,SE,SI,SP,SW,BS,II,IN,IU";
	}else if(_l.u.c == 'C710' && _l.u.CountryCd == "DZ"){
		//HAICC-1938 [SEMAG] Request to block SVC Types in GSPN
		impossibleEntry = "BR,BS,ER,FC,FI,IN,IS,IU,KT,MX,PD,PF,PL,RB,RC,RD,RL,SC,SE,SH,SI,SP,SW";
	}else if(_l.u.c == 'C710' && (_l.u.CountryCd == "AE" || _l.u.CountryCd == "KW" || _l.u.CountryCd == "OM" || _l.u.CountryCd == "BH" || _l.u.CountryCd == "QA")){
		impossibleEntry = "AD,PR,IH";
		//HAICC-2054 [SGE] Request to block SVC Types in GSPN
		impossibleEntry += "DM,ER,FC,FI,IU,KT,MX,PD,PF,PL,RB,RC,RD,RL,SC,SE,SI,SP,SW";
	}else if(_l.u.c == 'C713'){
		impossibleEntry = "AD,RH,PR,IH";
		//HAICC-2053 [SEIL] Request to block SVC Types in GSPN
		impossibleEntry += "AD,BR,BS,CC,DM,ER,FC,FI,II,IN,IU,KT,MX,PD,PF,PL,RB,RC,RD,RL,SC,SE,SI,SP,SR,SW";
	}else if(_l.u.c == 'C712'){
		impossibleEntry = "AD,IH,PR";
		//HAICC-1959 [SEEG] Request to block SVC Types in GSPN
		impossibleEntry += "BR,DM,ER,FC,FI,IN,KT,MX,PD,PF,RB,RC,RD,RL,SC,SE,SI,SP,SR,SW";
	}else if(_l.u.c == 'C711'){
		impossibleEntry = "AD,IH,PR";
		//HAICC-1937 [SESAR] Request to block SVC Types in GSPN
		impossibleEntry += "BS,DM,ER,FC,FI,II,IN,IU,KT,MX,PD,PF,PL,RB,RC,RD,RL,SC,SE,SI,SP,SR,SW";
	}else if(_l.u.c == 'C750'){
		if(_l.limitTypeII){
			impossibleEntry = "AD,II,PR";
		}
		//HAICC-2017 [SETK] Request to block SVC Types in GSPN
		impossibleEntry += "BR,BS,DM,ER,FC,FI,IS,IU,KT,MX,PD,PF,PL,RB,RC,RD,RL,SC,SE,SI,SP,SW";
	}else if(_l.u.c == 'C770'){
		if(_l.isPSApp) {
			possibleEntry = "IS";
		}
		//HAICC-2045 [SELV] Request to block SVC Types in GSPN
		impossibleEntry += "BR,DM,ER,FC,FI,IS,IU,KT,MX,PD,PF,PL,RB,RC,RD,RL,SC,SE,SI,SP,SW";
	}else if(_l.u.c == 'C780'){
		//HAICC-1938 [SEMAG] Request to block SVC Types in GSPN
		impossibleEntry = "BR,BS,ER,FC,FI,IN,IS,IU,KT,MX,PD,PF,PL,RB,RC,RD,RL,SC,SE,SH,SI,SP,SW";
	}

	//HAICC-7733 allow changing SVC Type change from CI/IH to BM
	if(currSvcType != "IH" && currSvcType != "CI") {
		impossibleEntry += "BM";
	}

	var SERVICE_TYPE = $('SERVICE_TYPE').value;	
	for (var i = 0; i < options.length; i++) {			
		var option = options[i];
		var isLimitType =  ( impossibleEntry.indexOf(option.value) != -1 );
		if(possibleEntry != "") {
			isLimitType = (possibleEntry.indexOf(option.value) == -1); 
		}
		if(SERVICE_TYPE != option.value && isLimitType){
			option.disabled = true;
		}
	}
	
}

function limitServiceType100() {
	var options = $j('#SERVICE_TYPE option');
	
	var impossibleEntry = "AD,PR";
	var possibleEntry = "";
	
	var impossibleAscForSEEA = "3385999,5338425,8220996,4417923,7360622,4417925,4249038,8221002,5379609,4411295,4229544,0003385999,0005338425,0008220996,0004417923,0007360622,0004417925,0004249038,0008221002,0005379609,0004411295,0004229544";
	// SSA 특정 ASC IH block 2015.08.06 jiw
	var impossibleAscForSSA = "3273861,8348501,4373849,4374519,0003273861,0008348501,0004373849,0004374519";
	
	var svcProd = _l.SVC_PRCD;
	var hqSvcPrcd = _l.hqSvcProd;
	
	if(_l.u.c == 'C550'){
		impossibleEntry = "AD,BS,PR,IS";
		if(_l.isBangladesh || _l.isSrilanka || _l.isNepal || _l.isMaldives){
			impossibleEntry = "AD,BS,PR,IS,RH,BM";
		}
	}else if(_l.u.c == 'C701'){	// 아프리카 법인 RH,PR 선택 불가 2016.01.23 jiw
		if("NG" == _l.u.CountryCd){
			impossibleEntry = "AD,RH,PR";
		}else{
			if(_l.useSvcTypeInitInstall){
				impossibleEntry = "AD,RH,PR";
			}else{
				impossibleEntry = "AD,RH,PR,II";
			}
		}
	}else if(_l.u.c == 'C702'){	// 아프리카 법인 RH,PR 선택 불가 2016.01.23 jiw
		if(impossibleAscForSEEA.indexOf(_l.u.AccountCode) != -1){	// SEEA(C702) 특정 ASC 서비스타입 PS block
			impossibleEntry = "AD,PS,RH,PR";
		}else{
			impossibleEntry = "AD,RH,PR";
		}
		if(_l.SERVICE_TYPE == "CI"){
			impossibleEntry += ",IH"; 
		}
	}else if(_l.u.c == 'C720'){	// SSA(C720) 특정 ASC 서비스타입 IH block
		if(impossibleAscForSSA.indexOf(_l.u.AccountCode) != -1){	
			impossibleEntry = "AD,IH,RH,PR";		// 아프리카 법인 RH,PR 선택 불가 2016.01.23 jiw
		}else{
			impossibleEntry = "AD,RH,PR";		// 아프리카 법인 RH,PR 선택 불가 2016.01.23 jiw
		}
	}else if(_l.u.c == 'C540' || _l.u.c == 'C5B3' || _l.u.c == 'C5F0' || _l.u.c == 'C565'){
        impossibleEntry = "AD,RH,PR";		
	}else if(_l.u.c == 'C962'){
        //C962 SSD product 일때만 ER 선택 가능
		if(svcProd == "SSD01" || hqSvcPrcd == "SSD01" || hqSvcPrcd == "SSD02" || hqSvcPrcd == "SSD03" || hqSvcPrcd == "SSD04" || hqSvcPrcd == "SSD05"){
        	impossibleEntry = "AD,PR";
        }else{
        	impossibleEntry = "AD,PR,ER";
        }
	}else if(_l.u.c == 'C570'){
			    impossibleEntry = "AD,PR,DM";		
	}else{
		impossibleEntry = "AD,PR";
	}
	
	var SERVICE_TYPE = $('SERVICE_TYPE').value;	
	for (var i = 0; i < options.length; i++) {			
		var option = options[i];
		var isLimitType =  ( impossibleEntry.indexOf(option.value) != -1 );
		if(possibleEntry != "") {
			isLimitType = (possibleEntry.indexOf(option.value) == -1); 
		}
		if(SERVICE_TYPE != option.value && isLimitType){
			option.disabled = true;
		}
	}
}

// Image Search Confirm을 보이게 할지 숨길지 처리
//티겟 사용자재의 confirmation No 검색 팝업 제공 여부.
function setShowImgSearchConfirm() {

	// Status가 Pending이고 Reason 이 Pendding 이면 돋보기가 보이도록 함.
	if (thisStatusCanSearchSalesOrder()) { // 임시 PENDING REASON
		$j("img[name='imgSearchConfirm']").each(function() {
			$j(this).show();
		});
	} else {
		$j("img[name='imgSearchConfirm']").each(function() {
			$j(this).hide();
		});
	}
}

function thisStatusCanSearchSalesOrder() {
	var salesOrder_popup = false;

	if (_l.salesOrderPopup) {
		var reasonForPartPending = "HPZ02";
		if ("C820" == _l.u.c) {
			reasonForPartPending = "HP040,HP045,HP050,PR045,PR040";
		} else if ("C550" == _l.u.c) {
			reasonForPartPending = "HP040,HPZ16,HPZ17";
		} else if (isEuUser) {	// C4M6 HP040 추가 2016.04.12 jiw
			reasonForPartPending = "HPZ02,HP040";
		}
		salesOrder_popup = $("STATUS").value == "ST030"
				&& reasonForPartPending.indexOf($('REASON').value) != -1;
	}

	return salesOrder_popup;
}

function showCal1Hour(val) {
	if(_l.u.isChinaRegion && isCPSo){
		return;
	}
	var statusCode = $("STATUS").value;
	var serviceType = $('SERVICE_TYPE').value;

	if ("C550" == _l.u.c) {
		if (statusCode != _l.currStatus
				&& (statusCode == "ST035" || statusCode == "ST040")
				&& serviceType == "CI") {
			if (!$("serviceDateTD3").checked) {
				$j(val).datepicker("destroy");
				$j('.hasDatepicker').keypress("destroy");
			} else {
				$j(val).datepicker(defaultDatePickerOption).css('margin-right','3px');
				$j('.hasDatepicker').keypress(validateDate);
			}
		} else {
			$j(val).datepicker(defaultDatePickerOption).css('margin-right','3px');
			$j('.hasDatepicker').keypress(validateDate);
		}
	} else {// if("C550"==_l.u.c){
		$j(val).datepicker(defaultDatePickerOption).css('margin-right','3px');
		$j('.hasDatepicker').keypress(validateDate);
	}// if("C550"==_l.u.c){
}

function timeCheck(obj) {
	var str = obj.value;
	if (str == '')
		return;
	var temp = "";
	for ( var i = 0; i < str.length; i++) {
		var ch = str.charAt(i);
		var chars = "0123456789";
		if (chars.indexOf(ch) != -1) {
			temp += ch;
		}
	}
	var timeChk = true;
	if (temp.length == 5)
		temp = "0" + temp;
	else if (temp.length == 4)
		temp = temp + "00";
	else if (temp.length == 3)
		temp = '0' + temp + "00";
	if (temp.length < 6 || temp.length > 6)
		timeChk = false;

	var err = 0;
	var hh, mm, ss;
	if (temp.length == 6) {
		hh = temp.substring(0, 2); // hour
		mm = temp.substring(2, 4); // min
		ss = temp.substring(4, 6); // sec
		if (hh < 0 || hh > 23)
			err = 1;
		if (mm < 0 || mm > 59)
			err = 1;
		if (ss < 0 || ss > 59)
			err = 1;
		if (err == 1)
			timeChk = false;

		temp = temp.substring(0, 2) + ':' + temp.substring(2, 4) + ':'
				+ temp.substring(4, 6);
	}
	if (timeChk)
		obj.value = temp;
	else {
		alert(_l.u.WEB_MSG_PREFIX + '[' + obj.value
				+ '] time format error! check the time format. ex)23:59:59');
		obj.value = '00:00:00';
	}
}

function setCurrentDateTime(dateObj, timeObj) {
	$(dateObj).value = _l.toDate;
	$(timeObj).value = _l.toTime;
}

function setCurrentTime(timeObj){	
	$(timeObj).value = _l.toTime;	
}

function setRealDateTime(dateObj, timeObj) {
	try {
		$('progressloading').startWaiting();
		var params = "cmd=GetRealDateTimeCmd";

		new Ajax.Request('/gspn/operate.do', {
			method : 'post',
			parameters : params,
			onComplete : function(response) {
				var json = response.responseText.evalJSON();
				if (json.success) {
					$(dateObj).value = json.realDate;
					$(timeObj).value = json.realTime;
				} else {
					$(dateObj).value = _l.toDate;
					$(timeObj).value = _l.toTime;
				}
				$('progressloading').stopWaiting();
			}
		});
	} catch (e) {
	}
}

function setGcicDateTime(dateObj, timeObj) {
	try {
		$('progressloading').startWaiting();
		var params = {
				cmd: 'CurrentDateTimeFromGcicCmd',
				IV_ASC_CODE: _l.ASC_CODE
		};
		
		new Ajax.Request('/gspn/operate.do', {
			method : 'post',
			parameters : params,
			onComplete : function(response) {
				var json = response.responseText.evalJSON();
				if (json.success) {
					$(dateObj).value = json.curDate;
					$(timeObj).value = json.curTime;
				} else {
					$(dateObj).value = _l.toDate;
					$(timeObj).value = _l.toTime;
				}
				$('progressloading').stopWaiting();
			}
		});
	} catch (e) {
	}
}

function saveCustColDate(){
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId);
	insertValue("frm", "CUST_RETURN_DT", $("CUST_RETURN_COLLECTION_DT").value);
	insertValue("frm", "CUST_RETURN_TM", $("CUST_RETURN_COLLECTION_TM").value);
	insertValue("frm", "CUST_RETURN_DT_FLAG", "X");
	insertValue("frm", "cmd", "ZifGspnSvcUpdateAfterCompCmd");
	
	AjaxSyncRequest(urlPattern, "frm", setSaveCustColDate);
}

function setSaveCustColDate(response){
	$('progressloading').stopWaiting();
	var jsonObj = eval('(' + response.responseText + ')');
	if (jsonObj.success && jsonObj.EV_RET_CODE == "S") {
		alert("success");
		$j('#saveCustColDateBtn').hide();
	}else{
		alert("failed");
	}
	$('CUST_RETURN_DT').value = jsonObj.ES_RESULT.CUST_RETURN_DT;
	$('CUST_RETURN_TM').value = jsonObj.ES_RESULT.CUST_RETURN_TM;
}

function onChangeReasonField() {
	var statusCode = $("STATUS").value;
	if (!$("serviceDateTD3").checked) {

		$("SERVICE_DATE").value = "";
		$("SERVICE_TIME").value = "";
		$("SERVICE_DATE").readOnly = true;
		$("SERVICE_TIME").readOnly = true;
		if ($j($("SERVICE_DATE")).datepicker) {
			$j($("SERVICE_DATE")).datepicker("destroy");
			$j('.hasDatepicker').keypress("destroy");
		}

		if (statusCode == "ST035") {
			$("COMPL_DELAY_REAS").value = "";
		}
		if (statusCode == "ST040") {
			$("DLVRY_DELAY_REAS").value = "";
		}
		$("reasonCodeCom").disabled = true;
	} else {
		$("reasonCodeCom").disabled = false;
		$("SERVICE_DATE").readOnly = false;
		$("SERVICE_TIME").readOnly = false;
	}
}

