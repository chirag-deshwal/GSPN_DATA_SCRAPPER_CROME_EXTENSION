function clickPatientImpact(){
	var check = $('PATIENT_IMP').checked;
	if(check){
		document.detailForm.INJURED_FLAG[0].disabled = false;
		document.detailForm.INJURED_FLAG[1].disabled = false;
		document.detailForm.INJURED_FLAG[1].checked = true;
		$('PATIENT_IMP').value = "Y";
	}else{
		document.detailForm.INJURED_FLAG[0].disabled = true;
		document.detailForm.INJURED_FLAG[1].disabled = true;
		document.detailForm.INJURED_FLAG[0].checked = false;
		document.detailForm.INJURED_FLAG[1].checked = false;
		$('PATIENT_IMP').value = "N";
	}
}

function hmeServiceTypechange(value){
	// HME 확산에 따른 isMedisonUser 추가 2015.03.19 jiw
	// HME user role 화면 2015.04.17 jiw
	if(_l.u.c == "C1X0" || isHmeUser){
		var hmeServiceTypeList = null;
		var hmeServiceType = $("HME_SVC_TYPE");
		
		if(hmeServiceType == null)
			return;
		
		var len = hmeServiceType.options.length;
		for(var i=1; i<len; i++){
			hmeServiceType.remove(1);
		}
		
		if($j('#SERVICE_TYPE').val() == 'BS'){
			hmeServiceTypeList = _l.HME_BS_SERVICE_TYPE.evalJSON();
		}else if($j('#SERVICE_TYPE').val() == 'IH'){
			hmeServiceTypeList = _l.HME_IH_SERVICE_TYPE.evalJSON();
		}
		
		if(hmeServiceTypeList != null){
			for(var j=0; j<hmeServiceTypeList.length; j++){
				var op = new Option();
				op.value = hmeServiceTypeList[j].codeId;
				op.text = hmeServiceTypeList[j].description;
				hmeServiceType.options.add(op);
			}
		}
	}
}

/**
 * IRIS_CONDI onchange event
 * onchange="changeCoditionCode(this);"
 * @param condition
 */
function changeCoditionCode(condition){
	var hmeConditionList = null;
	var hmeCondition = $("HME_CONDI");
	
	if(hmeCondition == null)
		return;
	
	var len = hmeCondition.options.length;
	for(var i=1; i<len; i++){
		hmeCondition.remove(1);

	}



	var text = condition.options[condition.selectedIndex].text;
	if(condition.value == "1"){
		hmeConditionList = _l.HME_1_CONDI.evalJSON();
	}else if(condition.value == "2"){
		hmeConditionList = _l.HME_2_CONDI.evalJSON();
	}
	
	if(hmeConditionList != null){
		for(var j=0; j<hmeConditionList.length; j++){
			var op = new Option();
			op.value = hmeConditionList[j].codeId;
			op.text = hmeConditionList[j].description;
			hmeCondition.options.add(op);
		}
	}
}

function validAssginedEngineer() {
	var isValid = true;
	if (!isValidEngWithinTheComp(_l.ASC_CODE)) {
		var alertMessage = "There was an error saving the information. Please try again. Sorry for the inconvenience.";
		isValid = false;
		alert(_l.u.WEB_MSG_PREFIX + alertMessage);
		goList();
	}
	return isValid;

}



function isValidEngWithinTheComp(ascCode) {

	var matched = false;

	var jsonTechList = _l.jsonTechList.evalJSON();

	for (var i=0; i < jsonTechList.length; i++) {

		var obj = jsonTechList[i];

		if (ascCode == obj['codeId']) {

			matched = true;

			break;

		}

	}

	return matched;

}



function needToCheckMIF(corp, currStatus, statusCode, serviceType, defectType) {

	var wtyInOut = $j('#IN_OUT_WTY').val();

	var isStatusToCheckMIF = false;
	if(isMIFCheckByPass){
		isStatusToCheckMIF = false;
		$("detailForm").MB_IF_RT_INFO.value="A"+$("detailForm").MB_IF_RT_INFO.value;
		$("detailForm").MIF_IO.value="1";	// 로그파일 업로드 건

	}else if(wtyInOut == "OW" && ($('IRIS_REPAIR').value == "X09" || $('REASON').value=="HLZ17")){

		isStatusToCheckMIF = false;
		$("detailForm").MB_IF_RT_INFO.value="B"+$("detailForm").MB_IF_RT_INFO.value;
		$("detailForm").MIF_IO.value="2";	// X04 X09
	}else if(corp == "C330" && $('IRIS_REPAIR').value == "203"){

		isStatusToCheckMIF = false;
		$("detailForm").MB_IF_RT_INFO.value="I"+$("detailForm").MB_IF_RT_INFO.value;
		$("detailForm").MIF_IO.value="9";	// X04 X09
	}else{

		if(corp == "C550"){
			// Production date >= 201305
			if(((currStatus != 'ST035' && statusCode == 'ST035') || (_l.REASON != 'HL030' && _l.MIF_IO == '' && statusCode == 'ST040' && checkFromToDate(_l.Date20150617, _l.REPAIR_COMP_DATE,_l.u.DateFormat2))) 
					&& (serviceType == "CI" || serviceType == "PS" || serviceType == "SR")){

				isStatusToCheckMIF = true;
				$("detailForm").MB_IF_RT_INFO.value="C"+$("detailForm").MB_IF_RT_INFO.value;
			}else{

				if(statusCode == 'ST035' && (serviceType == "CI" || serviceType == "PS" || serviceType == "SR")){

					if(_l.MIF_IO == "2" && _l.IRIS_REPAI=="X09" && $('IRIS_REPAIR').value != "X09"){	// X09
																										// 로
																										// 패스했던
																										// 케이스인데
																										// 변경시

						isStatusToCheckMIF = true;
						$("detailForm").MB_IF_RT_INFO.value="D"+$("detailForm").MB_IF_RT_INFO.value;
					}else{

						isStatusToCheckMIF = false;// 체크대상 status 가 아님
						$("detailForm").MIF_IO.value=""; // 체크대상 status 가 아님
						$("detailForm").MB_IF_RT_INFO.value="2"+$("detailForm").MB_IF_RT_INFO.value;
					}

				}else{

					isStatusToCheckMIF = false;// 체크대상 status 가 아님
					$("detailForm").MB_IF_RT_INFO.value="3"+$("detailForm").MB_IF_RT_INFO.value;
					$("detailForm").MIF_IO.value=""; // 체크대상 status 가 아님

				}

			}

		}else{

			if(defectType=="AE"){

				isStatusToCheckMIF = false;

				$("detailForm").MIF_IO.value="3";	// Accessory Exchange
				$("detailForm").MB_IF_RT_INFO.value="E"+$("detailForm").MB_IF_RT_INFO.value;
			}else{

				 if(serviceType == "CI" || serviceType == "PS" || serviceType == "SR" || (corp == "C720" && serviceType == "IU")){

					if(_l.LAB_TYPE=="AE"){	// 원 defect Type 이 AE 인데, 현재는 바꿨을 경우

						if(currStatus == 'ST035' || (currStatus == 'ST040' && statusCode == 'ST035')

								|| (_l.REASON != 'HL030' && _l.MIF_IO == '' && statusCode == 'ST040')){	// ST035
																										// ST040
																										// 로
																										// 변경시
																										// 두 경우
																										// 모두
																										// 체크해야
																										// 함

							isStatusToCheckMIF = true;
							$("detailForm").MB_IF_RT_INFO.value="F"+$("detailForm").MB_IF_RT_INFO.value;
						}else{

							isStatusToCheckMIF = false;

							$("detailForm").MIF_IO.value=""; // 체크대상 status 가
																// 아님
							$("detailForm").MB_IF_RT_INFO.value="4"+$("detailForm").MB_IF_RT_INFO.value;
						}

					}else{
						if((currStatus != 'ST035' && statusCode == 'ST035') || (_l.MB_IF_YN != 'Y' && _l.REASON != 'HL030' && _l.MIF_IO == '' && statusCode == 'ST040' && checkFromToDate(_l.Date20150617, _l.REPAIR_COMP_DATE,_l.u.DateFormat2))){
							isStatusToCheckMIF = true;
							$("detailForm").MB_IF_RT_INFO.value="G"+$("detailForm").MB_IF_RT_INFO.value;
						}else{

							isStatusToCheckMIF = false;

							$("detailForm").MIF_IO.value=""; // 체크대상 status 가
																// 아님
							$("detailForm").MB_IF_RT_INFO.value="5"+$("detailForm").MB_IF_RT_INFO.value;
						}

					}

				}else{

					isStatusToCheckMIF = false;

					$("detailForm").MIF_IO.value=""; // 체크대상 service Type이 아님
					$("detailForm").MB_IF_RT_INFO.value="6"+$("detailForm").MB_IF_RT_INFO.value;
				}

			}

			if(isStatusToCheckMIF == false && corp == "C6A0"){

				if($('IRIS_REPAIR').value == "A06" || $('IRIS_REPAIR').value == "A20"){

					isStatusToCheckMIF = false;
					$("detailForm").MB_IF_RT_INFO.value="H"+$("detailForm").MB_IF_RT_INFO.value;
					$("detailForm").MIF_IO.value="4";	// 대만 Repair code A06
														// A20

				}else{
					if(((currStatus != 'ST035' && statusCode == 'ST035') || (_l.MB_IF_YN != 'Y' && _l.REASON != 'HL030' && _l.MIF_IO == '' && statusCode == 'ST040' && checkFromToDate(_l.Date20150617, _l.REPAIR_COMP_DATE,_l.u.DateFormat2))) 
							&& (serviceType == "CI" || serviceType == "PS" || serviceType == "SR")){
						$("detailForm").MB_IF_RT_INFO.value="I"+$("detailForm").MB_IF_RT_INFO.value;
						isStatusToCheckMIF = true;
					}else{

						isStatusToCheckMIF = false;// 체크대상 status 가 아님
						$("detailForm").MB_IF_RT_INFO.value="7"+$("detailForm").MB_IF_RT_INFO.value;
						$("detailForm").MIF_IO.value=""; // 체크대상 status 가 아님
					}
				}
			}
			if(isStatusToCheckMIF == true && corp == "C710") {
				if(!checkFromToDate(_l.CosmosMigrationDate,_l.CREATE_DATE,_l.u.DateFormat2)) {						
					isStatusToCheckMIF = false;
					
					$("detailForm").MIF_IO.value="9";
				}
				
			}
		}
	}
	
	
	return isStatusToCheckMIF;
}
//실물검증용 GMES check 2016.09.21 jiw
function callGMESToCheckPartSn(partCode,partSerial) {
	var compareYn = "Y";
	var paramMap = {};
	paramMap.TYPE = "V";
	paramMap.SERIAL_NO = $j('#SERIAL_NO').val();
	paramMap.PART_SERIAL = partSerial;
	paramMap.PART_CODE = partCode;
	// 로그 테이블 저장용 PARAM 2016.02.07 jiw
	paramMap.OBJECT_ID = _l.ObjectId;
	paramMap.COMPANY = _l.u.c;
	paramMap.ASC_CODE = _l.ASC_CODE;
	paramMap.CIC_PRD = $j('input#CIC_PRCD').val();
	paramMap.MODEL = $j("#MODEL").val();
	paramMap.SYMPTOM_CODE = $('IRIS_SYMPT').value;
	paramMap.REPAIR_CODE = $('IRIS_REPAIR').value;
	paramMap.SERVICE_TYPE = $j("#SERVICE_TYPE").val();
	paramMap.IMEI = $j('#IMEI').val();
	paramMap.COMPLETE_DT = $("SERVICE_DATE").value;
	paramMap.STATUS = $("STATUS").value;
	
	$('progressloading').startWaiting();
	var isValid = true;
	$j.ajax({
		type : 'post',
		dataType : 'json',
		async : false,
		url : '/svctracking/svcorder/modelBySerialByGMES2ForNonHHP.gspn',
		data : paramMap,
		success : function(data) {
			if (data && data.compareYn) {
				compareYn = data.compareYn;
			}else{
				compareYn = "";
			}
		},
		error : function(jqXHR, textStatus) {
			// console.log(textStatus);
		}
	});		
	$('progressloading').stopWaiting();
	
	return compareYn;
}

function isValidCheckGMES(partCode,partSerial) {
	var isPassing = true;
	var statusCode = $j("#STATUS").val();
	var PRODUCT_DATE = $('PRODUCT_DATE').value;
	if(checkFromToDate(_l.Date20140101, PRODUCT_DATE,_l.u.DateFormat2)){
		if(!_l.sawExistCompressorSerialApproved ){
			var compareSn = callGMESToCheckPartSn(partCode,partSerial);
			if("Y" == compareSn || "P" == compareSn){
				isPassing = true;
			}else if("N" == compareSn){ 
				// 다르면 무조건 경고, 에러
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.PART_SERIAL_SAW_POP);
				isPassing = false;
			}else{
				// 없으면 경고, ST035 일때만 에러
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.PART_SERIAL_SAW_POP);
				if(statusCode=="ST035"){	// ST035 일때는 무조건 에러
					isPassing = false;
				}
			}
		}
	}
	return isPassing;
}


/**
 * 화면 시리얼과 GMES2 unitSn이 같은지 리턴.
 */
function callGMESToCheckCompSn(partSerial) {
	var compareYn = "Y";
	var paramMap = {};
	paramMap.TYPE = "C";
	paramMap.SERIAL_NO = $j('#SERIAL_NO').val();
	paramMap.PART_SERIAL = partSerial;
	
	$('progressloading').startWaiting();
	var isValid = true;
	$j.ajax({
		type : 'post',
		dataType : 'json',
		async : false,
		url : '/svctracking/svcorder/modelBySerialByGMES2ForNonHHP.gspn',
		data : paramMap,
		success : function(data) {
			if (data && data.compareYn) {
				compareYn = data.compareYn;
			}else{
				compareYn = "";
			}
		},
		error : function(jqXHR, textStatus) {
			// console.log(textStatus);
		}
	});		
	$('progressloading').stopWaiting();
	
	return compareYn;
}
/**
 * //2014-01-01 이후 생산된 제품은 승인된 SerialNoValidation SAW가 없으면,
	//callGMESToCheckCompSn(partSerial) 호출해서
	//Y 리턴되면 isPassing = true
	//N 리턴되면 경고출력, isPassing = false
	//else : 경고출력, ST035시 isPassing = false
 * @param partSerial : 사용자재의 시리얼
 * @returns {Boolean} : isPassing
 */
function isCompressorWarningError(partSerial) {
	var isPassing = true;
	var statusCode = $j("#STATUS").val();
	var PRODUCT_DATE = $('PRODUCT_DATE').value;
	// Production date >= 201305
	if(checkFromToDate(_l.Date20140101, PRODUCT_DATE,_l.u.DateFormat2)){
		if(!_l.sawExistCompressorSerialApproved ){
			var compareSn = callGMESToCheckCompSn(partSerial);
			if("Y" == compareSn){
				isPassing = true;
			}else if("N" == compareSn){ 
				// 다르면 무조건 경고, 에러
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.PART_SERIAL_SAW_POP);
				isPassing = false;
			}else{
				// 없으면 경고, ST035 일때만 에러
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.PART_SERIAL_SAW_POP);
				if(statusCode=="ST035"){	// ST035 일때는 무조건 에러
					isPassing = false;
				}
			}
		}
	}
	
	return isPassing;
}
/**
 * //2014-01-01 이후 생산된 제품은 승인된 SerialNoValidation SAW가 없으면,
	//callGMESToCheckSetSerial(partSerial) 호출해서
	//Y 리턴되면 isPassing = true
	//N 리턴되면 경고출력, isPassing = false
	//else : 경고출력, ST035시 isPassing = false
 * @param serial : 화면 모델의 시리얼
 * @returns {Boolean} : isPassing
 */
function isCheckingThroughGMES(serial) {
	var isPassing = true;
	var statusCode = $j("#STATUS").val();
	var PRODUCT_DATE = $('PRODUCT_DATE').value;
	// Production date >= 201305
	if(checkFromToDate(_l.Date20140101, PRODUCT_DATE,_l.u.DateFormat2)){
		if(!_l.sawExistSerialNoValidationApproved ){
			var compareSn = callGMESToCheckSetSerial(serial);
			if("Y" == compareSn){
				isPassing = true;
			}else if("N" == compareSn){// 다르면 무조건 경고, 에러 
				
				alert(_l.u.WEB_MSG_PREFIX + "If Set Serial No. and Model No. is correct as per physical Set then create “S/N validation” SAW and upload Model & Sr. no. photograph.");
				if(statusCode=="ST035"){	// ST035 일때는 무조건 에러
					isPassing = false;
				}
			}else{
				// 없으면 경고, ST035 일때만 에러
				alert(_l.u.WEB_MSG_PREFIX + "If Set Serial No. and Model No. is correct as per physical Set then create “S/N validation” SAW and upload Model & Sr. no. photograph.");
				if(statusCode=="ST035"){	// ST035 일때는 무조건 에러
					isPassing = false;
				}
			}
		}
	}
	
	return isPassing;
}
/**
 * 	//화면 시리얼과 GMES2 시리얼(serialNumber)이 같은지검사.
	//같으면 : Y, 다르면 : N
 * @param serial : 화면 모델의 시리얼
 * @returns {String}
 */
function callGMESToCheckSetSerial(serial) {
	var compareYn = "Y";
	var paramMap = {};
	paramMap.TYPE = "M";
	paramMap.SERIAL_NO = $j('#SERIAL_NO').val();
		
	$('progressloading').startWaiting();
	
	$j.ajax({
		type : 'post',
		dataType : 'json',
		async : false,
		url : '/svctracking/svcorder/modelBySerialByGMES2ForNonHHP.gspn',
		data : paramMap,
		success : function(data) {
			if (data && data.serialNumber) {
				if(data.serialNumber == $j('#SERIAL_NO').val()){
					compareYn = "Y";
				}else{
					compareYn = "N";
				}
			}else{
				compareYn = "F";
			}
		},
		error : function(jqXHR, textStatus) {
			// console.log(textStatus);
		}
	});		
	$('progressloading').stopWaiting();
	
	return compareYn;
}
function onChangeSubserviceType() {
	var svctype = $j("#SERVICE_TYPE").val();
	
   	if (((svctype == 'CI' || svctype == 'IH') && $j('#SUB_SVC_TYPE2').val()=="ES")
   			|| (svctype == 'PS' && $j('#SUB_SVC_TYPE').val()=="ES")){
		$j("#escalAscTd1,#escalAscTd2").css("display","block");
		if (!json_escalAsc.et_escalation_asc)
			escalAscSearch();
	} else {
		$j("#escalAscTd1,#escalAscTd2").css("display","none");
		confirmEscalation = false;
	}
}

function isExistInvoiceNoForPart(){
	var isValid = true;
	
	if (_l.u.c != "C820"){
		return true;
	}

	try{
		var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
		var arrInvoices = $j("#partsTableBody input[name='INVOICE_NO']");// cfArray(frm.INVOICE_NO);
		
		for ( var i = 0; i < partCodes.length; i++) {
			var partCode = $j.trim($j(partCodes[i]).val());
			var partInvoice = $j.trim($j(arrInvoices[i]).val());
			
			var isTargetPart1 = partCode != null && partCode.length > 4 && targetPartCode1.indexOf(partCode.substring(0,4)) != -1;
			var isTargetPart2 = partCode != null && partCode.length == 11 && targetPartCode2.indexOf(partCode) != -1;
			if(isTargetPart1 || isTargetPart2) {
				if(partInvoice == null || partInvoice ==""){
					alert(_l.u.WEB_MSG_PREFIX + "It is mandatory to enter Delivery No. [" + partCode + "]");
					$j(arrInvoices[i]).focus();
					isValid = false;
					break;
				}
			}
		}
	}catch(e){}
	return isValid;
}

function removeDate(now_date) {
	if (now_date == null)
		return "00000000";

	now_date = now_date.replace('.', '');
	now_date = now_date.replace('.', '');

	now_date = now_date.replace('/', '');
	now_date = now_date.replace('/', '');

	return now_date;
}
function setWorkDate(day,worktime){
	if (currTabId == 'divJob') {
		if(
			($('FIRST_APP_DATE').value.substring(0,2)=='00'||$('FIRST_APP_DATE').value.strip()=='')
		&&($('FIRST_APP_DATE').readOnly==false)
		) {
			$('FIRST_APP_DATE').value=day;
			$('FIRST_APP_TIME').value=worktime;
		}else{
			$('LAST_APP_DATE').value=day;
			$('LAST_APP_TIME').value=worktime;
		}
	}else{
		alert(_l.u.WEB_MSG_PREFIX + "Please select Job&Date tab before choose engineer Time.");
		return;
	}
	
}

function displayDiagnosisResult() {	
	var url = '/svctracking/lite/displayDiaResult.jsp?TA_OBJECT_ID=' + TA_OBJECT_ID;

	var pop = window
			.open(
					url,
					'diaResultList',
					'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=600,height=500');
	pop.focus();
}


