function setcheckEngAtten(response){
	$('progressloading').stopWaiting();
	
	try{
		var setcheckEngAttenJsonObj = eval('('+response.responseText+')');
		
		if(setcheckEngAttenJsonObj.success && setcheckEngAttenJsonObj.EV_RET_CODE == "S"){
			//SO 저장 가능
			_l.isEngineerAttendance = true;
		}else{
			alert(_l.u.SAP_MSG_PREFIX + setcheckEngAttenJsonObj.EV_RET_MSG);
			
			_l.isEngineerAttendance = false;
		}
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
	}
}

//제  목 : 인도 Demand Enhancement of CS operations using biometric system
//수정일 : 2015.10.06
//수정자 : 채보람 (로젠 솔루션)
//내  용 : 인도일 경우 ST025 또는 ST030으로 저장 시 
//		  BiometricStatus가 수리 할 수 있는 상태인지 엔지니어 체크
function checkEngBioStatus(){
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "IV_ASC_CODE", _l.ASC_CODE);
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_COUNTRY", _l.u.CountryCd);
	insertValue("frm", "IV_CON_DT", _l.CREATE_DATE);
	insertValue("frm", "IV_ENGINEER", $j("#ENGINEER").val());
	insertValue("frm", "cmd", "ZifBioEngrChkInfoCmd");
	
	AjaxSyncRequest(urlPattern, "frm", setcheckEngBioStatus);
}

function setcheckEngBioStatus(response){
	$('progressloading').stopWaiting();
	
	try{
		var bioStatusJsonObj = eval('('+response.responseText+')');
		
		if(bioStatusJsonObj.success && bioStatusJsonObj.EV_RET_CODE == "S"){
			//SO 저장 가능
			_l.isEngineerAttendance = true;
		}else{
			alert(_l.u.SAP_MSG_PREFIX + bioStatusJsonObj.EV_RET_MSG);
			_l.isEngineerAttendance = false;
		}
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
	}
}
//=================================================================================//

//kg model block check 2019.04.24 jiw
var kgFlag = "0";
function checkKgModel(){
	kgFlag = "0";
    clearForm("frm");
    insertValue("frm", "model", $('MODEL').value);
    insertValue("frm", "cmd", "ZifGspnKgModelCheckCmd");
	// kg model check RFC call
    AjaxSyncRequest(urlPattern, "frm", setCheckKgModel);
}

function setCheckKgModel(response){
    try{
        var kgModelCheckObj = eval('('+response.responseText+')');
        
        if(kgModelCheckObj.success){
            clearForm("frm");
            insertValue("frm", "IMEI", $('IMEI').value);
            insertValue("frm", "kgMode", "B");
            insertValue("frm", "cmd", "GetKnoxGuardStatusCmd");
         	// kg model block check webservice call
        	AjaxSyncRequest(urlPattern, "frm", setCheckKgModelBlock);
        }
    } catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
    }
}

function setCheckKgModelBlock(response) {
	try {
		jsonObj = response.responseText.evalJSON();

		if (jsonObj.success) {
			if(jsonObj.deviceState != undefined && jsonObj.deviceExist){
				kgFlag = "3";	// kg
				if(jsonObj.isRepairable != undefined && !jsonObj.isRepairable){
					kgFlag = "1"; // kg locked
					var kgFiCustIdList = _l.r.c.KG_FI_CUST_ID_LIST.evalJSON();
					for(var i=0 ; i < kgFiCustIdList.length ; i++) {
						if(jsonObj.customerId == kgFiCustIdList[i].codeId){
							kgFlag = "2";	// kg locked && finance
							break;
						}
					}
				}
			}
		}			
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
	}
}

function serviceOrderWtyCheck() {

	
	/** U01 Start : 2017.09.14 채보람 서남아 Demand : 인도일 경우
	 * 	1. 36 Months SAW Approved
	 * 	2. SVC Type = SR
	 * 	3. Product category = SAW condition ('ACN' OR 'AUD' OR 'CAM' OR 'CLE' OR 'HKE' OR 'LED' OR 'REF' OR 'VDE' OR 'VEE' OR 'WSM')
	 * 	위 3가지일 경우 Wty Check 불가
	**/
	if (_l.isIndia) {
		var isWtyCheck = true;
		
		if ($j("#divSAW").find("input").length > 2) {
			$j.each($j("#divSAW").find("input"), function(key, obj){
				if (obj.value == "SRC09") {
					var apprStatus = $j("#divSAW").find("input").slice(key - 1, key).val();
					
					if (apprStatus == "SS010" && _l.SERVICE_TYPE == "SR") {
						var sawCondition = ["ACN", "AUD", "CAM", "CLE", "HKE", "LED", "REF", "VDE", "VEE", "WSM"];
						
						if ($j.inArray(_l.CIC_PRCD, sawCondition) != -1) {
							isWtyCheck = false;
						}
					}
				}
			});
			
			if (!isWtyCheck) {
				alert(_l.u.WEB_MSG_PREFIX + "Unit is under 36 months warranty as per SR policy");
				return;
			}
		}
	}
	/** U01 End   : 2017.09.14 채보람 서남아 Demand : 인도일 경우... End **/	
	
	if ($("detailForm").MODEL.value == '') {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_XVALUE_00457);
		wtyInfoReset();
		return;
	}
	if ($("detailForm").SERIAL_NO.value == '') {
		// wtyInfoReset();
		// return;
	}
	
	if(_l.u.c == 'C820'){
		if("XE500C13,XE501C13".indexOf($("detailForm").MODEL.value) != -1){
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.C820_BATT_REPLACE);
		}
	}
	
    // KG model block double check(RFC+WebService) 2019.04.24 jiw
    if(_l.useKgCheck){
        checkKgModel();
        
    	if(kgFlag == "1"){
    		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.KG_CHECK);
    		return;
    	}else if(kgFlag == "2"){
    		alert("This is a Samsung Finance Plus Device. In order to proceed for repair, please go to MCS Portal to unlock the device.\n" + 
    				"Path : GMCS > Sensing > Samsung Finance Plus");
    		return;
    	}else if(kgFlag == "3"){
    		alert("This is a Knox Guard device.");
    	}
	}
	
	$('detailForm').cmd.value = 'ServiceOrderWtyCheckCmd';
	
	//china version intergration 2016/08/19 js1.baek
	if(_l.u.isChinaRegion){
		//S/O수정화면에서는 searchedIMEI가 탭init할때 정의되고 imeichange함수 안에서 새로 정의된다. 
		//wtycheck할때 IMEI의 value와 searchedIMEI가 다른 경우 imeichange함수가 실행되지 않은것으로 판단하고 리턴한다.
		if($j("#IMEI").val() != "" && $j("#IMEI").val() != searchedIMEI){
			imeiChange();
			return;
		}		
		//액세서리인 경우 IMEI체크 하지 않음. 2013.11.14 add by hyi
		var isACC = ($j('#SVC_PRCD').val().substr(0,4)=='THB9' || $j('#SVC_PRCD').val().substr(0,4)=='THBZ');
		var isHHP = $j('[name=detailForm] #prod_category').val()=='HHP';
		if (isHHP && !isACC && $("detailForm").IMEI.value == '') {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_XVALUE_IMEI/*Please Input the IMEI.*/);
			wtyInfoReset();
			return;
		}
		if(isACC && loginUserCorpCode == "C610" && ($('PRODUCT_DATE').value == "" || $('PRODUCT_DATE').value == "00000000")){
			$j("#PRODUCT_DATE").val($('PURCHASE_DATE').value);
		}
    
	    if(jsonIMEICheckObj.success && jsonIMEICheckObj.imei == $j("#IMEI").val()){
			if(jsonIMEICheckObj.productDate && jsonIMEICheckObj.productDate!='-' && jsonIMEICheckObj.productDate!='')
				$j("#PRODUCT_DATE").val(jsonIMEICheckObj.productDate);
		}

		AjaxRequest(urlPattern+'?IV_WTY_EXCEPTION='+$('WTY_EXCEPTION').value+'&IV_ASC_CODE='+$('ASC_CODE').value+'&USE_PARALLEL=0'
			+'&IV_CONSUMER='+$j('#CONSUMER').val(),
			"detailForm", setWtyCheck);
		$('progressloading').startWaiting();
		return;
			
	}//if(_l.u.isChinaRegion){
	
	var svcProd = $("SVC_PRCD").value;

	if (!(_l.CurrStatus == "ST040" || _l.CurrStatus == "ST035")
			&& _l.useGMESHHPByIMEI) {

		if ((svcProd == "HHP01" || svcProd == "HHP02" || svcProd == "HHP05") && $("IMEI").value == "") {
			if(svcProd == "HHP05"){
				alert(_l.u.WEB_MSG_PREFIX + "Serial / IMEI is mandatory field. In case it is Wi-Fi Tablet (without IMEI No), Please input Sr No in IMEI Field.");
			}else{
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_FIELD_00747);
			}
			//IMEI PROJECT
			if(isAutoImei){
				$("IMEI_TXT").className = "inputIDS";
				$("IMEI_TXT").select();
			}else{
				$("IMEI").className = "inputIDS";
				$("IMEI").select();
			}			
			return;
		}
		if ((svcProd == "HHP01" || svcProd == "HHP02" || svcProd == "HHP05") && !isReturnedGMES) {
			alert(_l.u.WEB_MSG_PREFIX + 'Interface for import country is in progress !');
			return;
		}
	}// if(!(currStatus.equals("ST040") || currStatus.equals("ST035"))){

	// KT/RB/SR : KT = Kit 반제품 Kit를 통채로 교환 , 제품을 구매하지 않은 service type은 구매일자가
	// 없으므로, 건너띈다.
	var serviceType = $("SERVICE_TYPE").value;
	var serviceTypeNotRelatedPurchaseDate = false;
	if ((serviceType == "KT" && svcProd.substring(0, 3) !="NEX") || serviceType == "RB" || serviceType == "SR") {
		serviceTypeNotRelatedPurchaseDate = true;
	}

	// =================================================================================//
	// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
	// Activation
	// 수정일 : 2015.04.28
	// 수정자 : 채보람 (로젠 솔루션)
	// 내 용 : IMEI Tracker I/F
	if((_l.isIndia || _l.isBangladesh || _l.isSrilanka || _l.isNepal) && isProdHHPIndia()){
		checkIMEITracker();
		
		var cssFlag = $j("#tableBOSBtn").css("display");
		
		if(!_l.IMEITrackerActDtFlag && cssFlag != "none"){
			return;
		}
	}
	// =================================================================================//
	
	var needToWarnForPurcaseDate = !serviceTypeNotRelatedPurchaseDate
			&& !needPurchaseDateForOW && !manageE_Warranty && !isMedisonUser
			&& $("detailForm").PURCHASE_DATE.value == '';

	// =================================================================================//
	// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
	// Activation
	// 수정일 : 2015.08.05
	// 수정자 : 채보람 (로젠 솔루션)
	// 내 용 : 인도일 경우 needToWarnForPurcaseDate 체크를 하지 않는다.
	if(!(_l.isIndia || _l.isBangladesh || _l.isSrilanka || _l.isNepal)){
		if (needToWarnForPurcaseDate) {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_XVALUE_00624);
		}
	}else{
		if(!isProdHHPIndia()){
			if (needToWarnForPurcaseDate) {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_XVALUE_00624);
			}
		}
	}
	// =================================================================================//

	AjaxRequest(urlPatternGZIP + '?IV_WTY_EXCEPTION=' + $('WTY_EXCEPTION').value
			+ '&IV_ASC_CODE=' + $('ASC_CODE').value + '&USE_PARALLEL=0',
			"detailForm", setWtyCheck);
	$('progressloading').startWaiting();
}

function setWtyCheck(response) {
	$('progressloading').stopWaiting();

	$('CERTI_NO').value = "";

	var jsonObjC = eval('(' + response.responseText + ')');
	var builderInfo = jsonObjC.esBuilderInfo;
	
	if(_l.u.isChinaRegion){
		if (jsonObjC.success) {
			
			$('IN_OUT_WTY').value =jsonObjC.lp_inout;//jsonObjC.in_out--wtyType;
			$('TERM_LABOR').value =jsonObjC.laborterm;
			$('TERM_PARTS').value =jsonObjC.partsterm;
			$('TERM_OTHER').value =jsonObjC.otherterm;
			$('SALES_COUNTRY').value =jsonObjC.salesCountry;			
			//$('PRODUCT_DATE').value = jsonObjC.prod_date=='00000000'?"":jsonObjC.prod_date;
			processAfterWtyCheck(jsonObjC);
			
			$('PACK_NUMBER').value =jsonObjC.packNumber;
			
			if (jsonObjC.prod_date=='00000000' && jsonObjC.lp_inout == 'OW') {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0126/*This ticket is OW(Out of Warranty)*/);
			}
			checkWarranty = false;
			
			//VOID5 Mark
			if(jsonObjC.EsExtraInfo.disabledWtyException == "X"){
				alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EsExtraInfo.newWtyExcMsg);
				setComboValue($('detailForm').WTY_EXCEPTION, jsonObjC.EsExtraInfo.newWtyException);
				$('detailForm').WTY_EXCEPTION.disabled = true;
				$('rType').value = jsonObjC.EsExtraInfo.rType;
				$('sCompany').value = jsonObjC.EsExtraInfo.sCompany;
			}else{
				if($('WTY_EXCEPTION').value != ""){
					setComboValue($('detailForm').WTY_EXCEPTION, $('WTY_EXCEPTION').value);
				}else if(jsonObjC.EsExtraInfo.newWtyException != ""){
					setComboValue($('detailForm').WTY_EXCEPTION, jsonObjC.EsExtraInfo.newWtyException);
				}
				$('WTY_EXCEPTION').disabled = false;
				$('rType').value = jsonObjC.EsExtraInfo.rType;
				$('sCompany').value = jsonObjC.EsExtraInfo.sCompany;
			}
			
		    // bog model warning 2020.11.23 jiw
		    if(jsonObjC.EsBogInfo.bogFlag == "X"){
		        alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EsBogInfo.bogMsg);
			}
			
			if(jsonObjC.EsEwpAttach.targetFlag == "X"){
				if(jsonObjC.EsEwpAttach.warningMsg != ''){
					alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EsEwpAttach.warningMsg);
				}
				_l.isEWPModel = true;
				//$j("#ewpAttachBtn,#ewpAttachBtnRight").css("display","block");
			}else{
				_l.isEWPModel = false;
				//$j("#ewpAttachBtn,#ewpAttachBtnRight").css("display","none");
			}
			
			if(jsonObjC.EsExtraInfo.butlerXFlag != "" || jsonObjC.EsExtraInfo.popupMsgFlag != "" || jsonObjC.EsExtraInfo.covid19Flag == "X"){
				var warningMsgLength = jsonObjC.EtWarningMsg.length;
				if(warningMsgLength > 0) {				
					for (var i = 0; i < warningMsgLength; i++) {
						if(jsonObjC.EtWarningMsg[i].msgType == "W") {
							alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EtWarningMsg[i].msg);
						}else if (jsonObjC.EtWarningMsg[i].msgType == "P") {
							window.open("/svctracking/common/SVCPopA235mAlert.jsp", "alert_popup", 'toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=370');
						}
					}
				}
			}
		}else{
		    if(jsonObjC.returnMessage!='')alert(_l.u.SAP_MSG_PREFIX + jsonObjC.returnMessage);
		    else alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0465/*Warranty Check Error.*/);
			wtyInfoReset();
		}
		//if(isNewChina){
			checkCertiNoforADH();
		//}   
		//GD IQC 재수리건 GD IQC 의무화 로직
		if(_l.useNewIQCGd){
			//추후 IQC REDO조건적용시 주석제거할것
			//if(jsonObjC.redo == "Y" && $('detailForm').DIA_CHECK_FLAG.value == "Y"){
			//	$('detailForm').REDO.value = "Y";
			//}else{
			//	$('detailForm').REDO.value = "";
			//}
		}
		
		// Care Pack 고도화 - 2017.03 - Start //
		if($j("#SERVICE_TYPE").val() == "AD"){
			if(_l.owPackFlag == "X" || _l.u.c == "C820" || _l.u.c == "C5A0"){
				setComboValue($('detailForm').WTY_EXCEPTION, $('WTY_EXCEPTION').value);
			}else{
				$('WTY_EXCEPTION').value = "";
			}
			$('WTY_EXCEPTION').disabled = "disabled";
		}
		// Care Pack 고도화 - 2017.03 - End //

		if(isNewChina) {
			if(jsonObjC.redo == "Y") {
				alert(_l.u.SAP_MSG_PREFIX + jsonObjC.redoMessage);
			}
		} else {
			if(jsonObjC.redo == "Y") {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MSG_00101);
				isRedoCheck = "Y";
				serial_search();
			}
		}
		isRedoCheck = "";
		
		if(jsonObjC.EtReserviceMsg != null) {
			var msgLength = jsonObjC.EtReserviceMsg.length;
			if(msgLength > 0) {				
				for (var i = 0; i < msgLength; i++) {
					if(jsonObjC.EtReserviceMsg[i].IW_RS_FLAG == "X") {
						alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EtReserviceMsg[i].IW_RS_MSG);
					}
				}
				isRsCheck = true;
				serial_search();
				isRsCheck = false;
			}
		}
		
		if (jsonObjC.changePurDt == "Y" ) {
			$('PURCHASE_DATE').value = jsonObjC.purchase_date == '00000000' ? "" : jsonObjC.purchase_date;
			
			if(jsonObjC.EsEulaInfo.eulaFlag != ""){
				if(jsonObjC.EsEulaInfo.eulaFlag == "C" || jsonObjC.EsEulaInfo.eulaFlag == "S"){
					$j("#PURCHASE_DATE").datepicker("destroy");
					$j("#PURCHASE_DATE").attr("readonly", "readonly");
				}else if(jsonObjC.EsEulaInfo.eulaFlag == "P"){
					alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EsEulaInfo.eulaMsg);
				}else if(jsonObjC.EsEulaInfo.eulaFlag == "D" || jsonObjC.EsEulaInfo.eulaFlag == "E" || jsonObjC.EsEulaInfo.eulaFlag == "L"){
					$j("#PURCHASE_DATE").datepicker("destroy");
					$j("#PURCHASE_DATE").attr("readonly", "readonly");
					alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EsEulaInfo.eulaMsg);
				}else if(jsonObjC.EsEulaInfo.eulaFlag == "A"){
					$('PURCHASE_DATE').value = "";
					alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EsEulaInfo.eulaMsg);
				}
			}
		}
		
		if(_l.sawExistReverseVoidApproved){
			$('WTY_EXCEPTION').disabled = true;
		}
		
		return;
	}//if(_l.u.isChinaRegion){

	if (jsonObjC.success) {
		
		if(!(_l.u.isChinaRegion || isMedisonUser)){
			if(jsonObjC.EsExtraInfo.oldPartsSnChk == "X"){
				_l.isDreamModel = true;
				$j("#OLD_PARTS_SEQ_NO,#OLD_SHIP_DATE,#OLD_SERIAL_MAT,#OLD_FAB_ID").removeAttr("disabled");
				$j("#OLD_PARTS_SN_CHK,#newPartsFront,#OLD_FAB_ID_CHK,#newFabIdFront").css("display","inline");
			}else{
				_l.isDreamModel = false;
				$j("#OLD_PARTS_SEQ_NO,#OLD_SHIP_DATE,#OLD_SERIAL_MAT,#OLD_FAB_ID").attr("disabled", "disabled");
				$j("#OLD_PARTS_SN_CHK,#newPartsFront,#OLD_FAB_ID_CHK,#newFabIdFront").css("display","none");
			}
		}

		if(_l.displayNote7Alert && jsonObjC.returnMessage != "" && jsonObjC.returnMessage.indexOf("[GN7]") > -1) {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.NOTE7_ALERT);
		}

		if (_l.u.c == 'C310') { // Builder 
			if(jsonObjC.esBuilderInfo.svcLevel == "BUILD") {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0589);
			}
			$('BUILDER').value = builderInfo.builder;
			$('BUILDER_BP_KIND_DESC').value = builderInfo.builderBpKindDesc;
			$('BUILDER_NAME').value = builderInfo.builderNameF + builderInfo.builderNameL;
			$('DEALER').value = builderInfo.dealer;
		}

		$('IN_OUT_WTY').value = jsonObjC.lp_inout;// jsonObjC.in_out--wtyType;
		
		$('TERM_LABOR').value = jsonObjC.laborTermC4;
		$('TERM_PARTS').value = jsonObjC.partsTermC4;
		$('TERM_OTHER').value = jsonObjC.otherterm;
		$('SALES_COUNTRY').value =jsonObjC.salesCountry;
		$('PRODUCT_DATE').value = jsonObjC.prod_date == '00000000' ? ""
				: jsonObjC.prod_date;
		$('PACK_NUMBER').value = jsonObjC.packNumber;
		$('SKIP_SN').value = jsonObjC.skipSn;

		if (jsonObjC.packNumber != '' || jsonObjC.contractNo !='') {
			if ($('B2B_SVC').value != 'X') {
				$('B2B_SVC').selectedIndex = 1;
				$('B2B_SVC').value = 'X';
			}
			var purchaseDate = $('PURCHASE_DATE').value;
			if(jsonObjC.packNumber.indexOf("WINNER") > -1){
				
			}else{
				$('PURCHASE_DATE').value = jsonObjC.purchase_date == '00000000' ? purchaseDate : jsonObjC.purchase_date;
			}
			
			
			$('PACK_CODE').value = jsonObjC.packNumber;
			$('PACK_DESC').value = jsonObjC.packDesc;
			$('CONTRACTNO').value = jsonObjC.contractNo;
			$('CERTI').value = jsonObjC.certiNo;
		}else{
			$('PACK_CODE').value = "";
			$('PACK_DESC').value = "";
			$('CONTRACTNO').value = "";
			$('CERTI').value = "";
		}
		if(isNaUser) {
        	if(jsonObjC.EsContractInfo.contractNo !=""){
        		$j("#trExtWtyInfo").css("display","inline");
    			$('extWtyDesc').value = jsonObjC.EsContractInfo.contractDesc;
    			$('SVC_CONTRACT').value = jsonObjC.EsContractInfo.contractNo;
				$('eppContractNo').value = jsonObjC.EsContractInfo.contractNo;
    			$('extWtyDuration').value = jsonObjC.EsContractInfo.contractStartD +" ~ "+jsonObjC.EsContractInfo.contractExpDate;
    			$('zCourseValue').value = jsonObjC.EsContractInfo.zCourseValue;
        	}
		}
		if (_l.needRefurbishGoodFlag) {
			$("spanRBCheck").update(jsonObjC.historyType);
		}

		if (_l.useWtyTermDate) {
			$('NEW_LABOR_WT_D').value = '(L)' + jsonObjC.new_labor_wt_d;
			$('NEW_PARTS_WT_D').value = '(P)' + jsonObjC.new_parts_wt_d;
		}

		if (manageE_Warranty) {
			if (jsonObjC.ewtyPurchaseDate != "") {
				$('PURCHASE_DATE').value = jsonObjC.ewtyPurchaseDate == '00000000' ? ""
						: jsonObjC.ewtyPurchaseDate;
				$('detailForm').EWTY_FLAG.value = jsonObjC.ewtyPurchaseDate == '00000000' ? ""
						: "X";
				$('detailForm').EWTY_YN.value = jsonObjC.ewtyPurchaseDate == '00000000' ? "N"
						: "Y";
			} else {
				$('detailForm').EWTY_FLAG.value = "";
				$('detailForm').EWTY_YN.value = "N";
			}
		}

		if (isMedisonUser || jsonObjC.changePurDt == "Y" ) {
			$('PURCHASE_DATE').value = jsonObjC.purchase_date == '00000000' ? ""
					: jsonObjC.purchase_date;
			
			if(jsonObjC.EsEulaInfo.eulaFlag != ""){
				if(jsonObjC.EsEulaInfo.eulaFlag == "C" || jsonObjC.EsEulaInfo.eulaFlag == "S"){
					$j("#PURCHASE_DATE").datepicker("destroy");
					$j("#PURCHASE_DATE").attr("readonly", "readonly");
				}else if(jsonObjC.EsEulaInfo.eulaFlag == "P"){
					alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EsEulaInfo.eulaMsg);
				}else if(jsonObjC.EsEulaInfo.eulaFlag == "D" || jsonObjC.EsEulaInfo.eulaFlag == "E" || jsonObjC.EsEulaInfo.eulaFlag == "L"){
					$j("#PURCHASE_DATE").datepicker("destroy");
					$j("#PURCHASE_DATE").attr("readonly", "readonly");
					alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EsEulaInfo.eulaMsg);
				}else if(jsonObjC.EsEulaInfo.eulaFlag == "A"){
					$('PURCHASE_DATE').value = "";
					alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EsEulaInfo.eulaMsg);
				}
				
				$j("#trEULAINFO").css("display","");
				$j("#spanBasicDate").text("Basic Date");
				$j('#PURCHASE_DATE').removeClass().addClass("inputRO").prop("readonly", true);
				$('EULA_ACT_DATE').value = jsonObjC.EsEulaInfo.eulaActDate;
				$('EULA_SAW_PUR_DT').value = jsonObjC.EsEulaInfo.eulaSawPurDt;
				$('EULA_PREV_DATE').value = jsonObjC.EsEulaInfo.eulaPrevDate;
				
			}else{
				
			}
			if(jsonObjC.historyType == "EXCH"){
				$j("#PURCHASE_DATE").datepicker("destroy");
				$j('#PURCHASE_DATE').removeClass().addClass("inputRO").prop("readonly", true);
			}
		}

		if ($('SKIP_SN').value != "Y" && $('PRODUCT_DATE').value == "" && jsonObjC.lp_inout != 'OW') {
			alert(_l.u.GERP_MSG_PREFIX + _l.r.m.SERIAL_INVALID);
		}

		if ($('SKIP_SN').value != "Y" && $('PRODUCT_DATE').value == "" && jsonObjC.lp_inout == 'OW') {
			alert(_l.u.GERP_MSG_PREFIX + _l.r.m.SERIAL_INVALID);
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0126);
		}

		if (parallelImportCheck && jsonObjC.parallel == "P") {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.TURKEY_PARELLEL);
		}

		/**
		 * * need the purchase date and purchase date is empty and Out of
		 * warranty then block save with warning message
		 */
		if (!validPurchaseDate()) {
			// check this logic again on click save

		}
		
		
		
		checkWarranty = false;
		var svcProd = $("SVC_PRCD").value;
		if(_l.useHrPrdCodeMPTS){
			svcProd = $('HQ_SVC_PRCD').value;
		}
		var isHHPProduct = false;
		var mptsPrdCodeList = _l.r.c.MPTS_PRD_CODE_LIST.evalJSON();
		for(var i=0; i<mptsPrdCodeList.length; i++){
			if(svcProd == mptsPrdCodeList[i].codeId){
				isHHPProduct = true;
				break;
			}
		}
		if (_l.useGMESHHPByIMEI
				&& !(_l.CurrStatus == "ST040" || _l.CurrStatus == "ST035")) {
			if (isHHPProduct) {
				var serial = $("SERIAL_NO").value;
				var wtyInOut = $('IN_OUT_WTY').value;
				var soldCountryCode = $("SOLD_COUNTRY_CODE").value;
				
				var inWty_InOut = ("LP" == wtyInOut);
				var unknownSerial = (serial == "M000" || serial == "m000");
				var sameCountry = ($j("#overseas").val() != "Y");
				
				var caseNoGmes = 0;
				if           ( inWty_InOut &&  unknownSerial &&  sameCountry){ caseNoGmes = 1;
				}else if ( inWty_InOut &&  unknownSerial && !sameCountry){ caseNoGmes = 2;					
				}else if ( inWty_InOut && !unknownSerial &&  sameCountry){ caseNoGmes = 3;
				}else if ( inWty_InOut && !unknownSerial && !sameCountry){ caseNoGmes = 4;
				}else if (!inWty_InOut &&  unknownSerial &&  sameCountry){ caseNoGmes = 5;
				}else if (!inWty_InOut &&  unknownSerial && !sameCountry){ caseNoGmes = 6;
				}else if (!inWty_InOut && !unknownSerial &&  sameCountry){ caseNoGmes = 7;
				}else if (!inWty_InOut && !unknownSerial && !sameCountry){ caseNoGmes = 8;
				}				
				
				if(caseNoGmes == 1 || caseNoGmes == 2){
					alert(_l.u.WEB_MSG_PREFIX + "This Product is not allowed in warranty.");
					setComboValue($('detailForm').WTY_EXCEPTION, "VOID6");
					$('detailForm').WTY_EXCEPTION.disabled = true;
					return;
				}else if(caseNoGmes == 5 ){
					alert(_l.u.WEB_MSG_PREFIX + "This Product is not allowed in warranty.");
					if($('detailForm').WTY_EXCEPTION.value == ""){
						setComboValue($('detailForm').WTY_EXCEPTION, "VOID6");
					}
					$('detailForm').WTY_EXCEPTION.disabled = true;
					return;
				}else if(caseNoGmes == 4 || caseNoGmes == 6 || caseNoGmes == 8){
					if('0003429773' != _l.u.AccountCode){
						if(_l.useWebOverseas){
							setComboValue($('detailForm').WTY_EXCEPTION, "VOID4");
							if($('SALES_COUNTRY').value != "" && _l.ascWtyCountry != $('SALES_COUNTRY').value){
								//global wty
								$('detailForm').WTY_EXCEPTION.disabled = false;
							}else{
								alert(_l.u.WEB_MSG_PREFIX + "This Product is not allowed in warranty.");
								$('detailForm').WTY_EXCEPTION.disabled = true;
								return;
							}
						}
					}
				}else if(caseNoGmes == 3 || caseNoGmes == 7){
					// setComboValue($('detailForm').WTY_EXCEPTION, "");
					$('detailForm').WTY_EXCEPTION.disabled = false;
				}
				
				
			}
		}// if(_l.useGMESHHPByIMEI && !(_l.CurrStatus=="ST040" ||
			// _l.CurrStatus == "ST035")){

		if(_l.useWebOverseas){
			if(_l.u.c == "C701" || _l.u.c == "C702" || (_l.u.c == "C710" && _l.u.CountryCd == "PK")){
				// OTWE가 아닐때만 타도록 함 2017.07.25 jiw
				var WTY_EXCEPTION = $('WTY_EXCEPTION').value;
				if(WTY_EXCEPTION.indexOf("OTWE") == -1){
					isOverseaProductCheck();
				}
			}
			
			if (_l.u.c == "C5A0"
					&& !(_l.CurrStatus == "ST040" || _l.CurrStatus == "ST035")) {
				if (isHHPProduct) {
					/*if ("LP" != $('IN_OUT_WTY').value && $j("#overseas").val() == "Y") {*/
					if ($j("#overseas").val() == "Y") {
						setComboValue($('detailForm').WTY_EXCEPTION, "VOID4");
						if($('SALES_COUNTRY').value != "" && _l.ascWtyCountry != $('SALES_COUNTRY').value){
							//global wty
							$('detailForm').WTY_EXCEPTION.disabled = false;
						}else{
							alert(_l.u.WEB_MSG_PREFIX + "This Product is not allowed in warranty.");
							$('detailForm').WTY_EXCEPTION.disabled = true;
							$('progressloading').stopWaiting();
							return;
						}
					}
				}
			}
		}
		
		if (_l.u.c == "C550"
				&& ($("SERVICE_TYPE").value == "DM" || $("SERVICE_TYPE").value == "II")) {
			
			var isCheckedDate = true;
			//var isExceptionPeriod =  "HTV19|HTV22|HTV23|HTV26|HTV27|HTV28|HTV32|HTV37|HTV39|HTV40|HTV42|HTV46|HTV48|HTV50|HTV52|HTV55|HTV58|HTV60|HTV65|HTV75|PJM01|PDM63|PDM50|PDM42|LFT55|LFT48|LFD99|LFD8A|LFD82|LFD75|LFD70|LFD65|LFD57|LFD55|LFD52|LFD48|LFD46|LFD40|LFD32|LFD24|LFD23|LFD22|".indexOf($j("#SVC_PRCD").val()) > 0;
			//var isExceptionPeriod = "CTV04|CTV06|CTV07|CTV13|CTV14|HME01|HME02|HME03|HME04|HME05|HME06|HME07|HME08|HME09|HME10|HME11|HME12|HME13|HME14|HME15|HME16|HME17|HME18|MON05|MON06|MON07|MON08|MON09|MON10|MON11|MON12".indexOf($j("#HQ_SVC_PRCD").val()) > 0;
			var isExceptionPeriod = "LFD14|LFD18|LFD19|LFD22|LFD23|LFD24|LFD32|LFD40|LFD46|LFD48|LFD52|LFD55|LFD57|LFD65|LFD70|LFD75|LFD82|LFD8A|LFD98|LFD99|LFT99|LFT55|LFT40|LFT48|LFT75|LFT65|LFT32|LFT46|LFT85|HTV19|HTV22|HTV26|HTV27|HTV28|HTV32|HTV37|HTV39|HTV40|HTV42|HTV46|HTV48|HTV50|HTV55|HTV65".indexOf($j("#HQ_SVC_PRCD").val()) > 0;
			if(($("SERVICE_TYPE").value == "II" || $("SERVICE_TYPE").value == "DM") && isExceptionPeriod) {
				if($('PURCHASE_DATE').value == "" || $('PURCHASE_DATE').value.substring(0, 2) =="00"){
					isCheckedDate = checkFromToDate($('PRODUCT_DATE').value, _l.CREATE_DATE_15M, _l.u.DateFormat2);
				}else{
					isCheckedDate = checkFromToDate($('PURCHASE_DATE').value, _l.CREATE_DATE_12M, _l.u.DateFormat2);
				}
			} else {	// Calculation based on Months : 6 Months / 9 Months 2018.12.26 jiw			
				if($('PURCHASE_DATE').value == "" || $('PURCHASE_DATE').value.substring(0, 2) =="00"){
					//isCheckedDate = checkFromToDate($('PRODUCT_DATE').value, _l.CREATE_DATE_270, _l.u.DateFormat2);
					isCheckedDate = checkFromToDate($('PRODUCT_DATE').value, _l.CREATE_DATE_9M, _l.u.DateFormat2);
				}else{
					//isCheckedDate = checkFromToDate($('PURCHASE_DATE').value, _l.CREATE_DATE_180, _l.u.DateFormat2);
					isCheckedDate = checkFromToDate($('PURCHASE_DATE').value, _l.CREATE_DATE_6M, _l.u.DateFormat2);
				}
			}
			if (isCheckedDate) {
				if ($('WTY_EXCEPTION').value == "") {
					alert(_l.u.WEB_MSG_PREFIX + "Demo/Installation will be provided on chargeable basis.");
					
					//EHN : product 탭이 열리기 전에는 select box 가 아닌 input hidden 이여서, 둘다 적용되는 .val() 메소드 로 변경함.
					//setComboValue($('detailForm').WTY_EXCEPTION, "VOID5");
					$j('#WTY_EXCEPTION').val("VOID5");
					$('IN_OUT_WTY').value = "OW";
					$('detailForm').WTY_EXCEPTION.disabled = true;
				} else if ($('WTY_EXCEPTION').value == "VOID5") {
					$('detailForm').WTY_EXCEPTION.disabled = true;
				}
			} else {
				$('detailForm').WTY_EXCEPTION.disabled = false;
			}
		} else {
			if(!(_l.u.c == "C713" && $('WTY_EXCEPTION').value == "VOID4")){
				$('detailForm').WTY_EXCEPTION.disabled = false;
			}
		}

		if(loginUserCorpCode == "C370") {
			if(jsonObjC.redo == "Y" || jsonObjC.redo_in == "Y") {
				alert(_l.u.SAP_MSG_PREFIX + jsonObjC.redoMessage);
				isRedoCheck = "Y";
				serial_search();
			}
		} else {
			if(jsonObjC.redo == "Y") {
				alert(_l.u.SAP_MSG_PREFIX + jsonObjC.redoMessage);
				isRedoCheck = "Y";
				serial_search();
			}
		}
		isRedoCheck = "";

		var isUseGCICOversea = true;
		if(_l.useMPTSOversea){
			if ($j("#overseas").val() == "Y") {
	        	isUseGCICOversea = true;
	        }else{
	        	isUseGCICOversea = false;
	        }
		}
		
		var isGlobalSCPlus = false;
		if($('SALES_COUNTRY').value != "" && _l.ascWtyCountry != $('SALES_COUNTRY').value){
			isGlobalSCPlus = true;
		}
      	//VOID5 Mark
		if(jsonObjC.EsExtraInfo.disabledWtyException == "X" && isUseGCICOversea){
			alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EsExtraInfo.newWtyExcMsg);
			setComboValue($('detailForm').WTY_EXCEPTION, jsonObjC.EsExtraInfo.newWtyException);
			$('detailForm').WTY_EXCEPTION.disabled = true;
			$('rType').value = jsonObjC.EsExtraInfo.rType;
			$('sCompany').value = jsonObjC.EsExtraInfo.sCompany;
		}else{
			if($('WTY_EXCEPTION').value != ""){
				setComboValue($('detailForm').WTY_EXCEPTION, $('WTY_EXCEPTION').value);
			}else if(jsonObjC.EsExtraInfo.newWtyException != ""){
				setComboValue($('detailForm').WTY_EXCEPTION, jsonObjC.EsExtraInfo.newWtyException);
			}
			if(isEuUser && _l.sawExistReverseVoidApproved){
				$('WTY_EXCEPTION').disabled = true;
			}else{
				$('WTY_EXCEPTION').disabled = false;
			}
			$('rType').value = jsonObjC.EsExtraInfo.rType;
			$('sCompany').value = jsonObjC.EsExtraInfo.sCompany;
		}
		
		if(jsonObjC.EsEwpAttach.targetFlag == "X"){
			if(jsonObjC.EsEwpAttach.warningMsg != ''){
				alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EsEwpAttach.warningMsg);
			}
			_l.isEWPModel = true;
			//$j("#ewpAttachBtn,#ewpAttachBtnRight").css("display","block");
		}else{
			_l.isEWPModel = false;
			//$j("#ewpAttachBtn,#ewpAttachBtnRight").css("display","none");
		}
		
		if(jsonObjC.EsExtraInfo.butlerXFlag != "" || jsonObjC.EsExtraInfo.popupMsgFlag != "" || jsonObjC.EsExtraInfo.covid19Flag == "X"){
			var warningMsgLength = jsonObjC.EtWarningMsg.length;
			if(warningMsgLength > 0) {				
				for (var i = 0; i < warningMsgLength; i++) {
					if(jsonObjC.EtWarningMsg[i].msgType == "W") {
						alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EtWarningMsg[i].msg);
					} else if (jsonObjC.EtWarningMsg[i].msgType == "P") {
						window.open("/svctracking/common/SVCPopA235mAlert.jsp", "alert_popup", 'toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=370');
					}
				}
			}
		}
		
		if(jsonObjC.EtReserviceMsg != null) {
			var msgLength = jsonObjC.EtReserviceMsg.length;
			if(msgLength > 0) {				
				for (var i = 0; i < msgLength; i++) {
					if(jsonObjC.EtReserviceMsg[i].IW_RS_FLAG == "X") {
						alert(_l.u.SAP_MSG_PREFIX + jsonObjC.EtReserviceMsg[i].IW_RS_MSG);
					}
				}
				isRsCheck = true;
				serial_search();
				isRsCheck = false;
			}
		}
	} else {
		if (jsonObjC.returnMessage != '')
			alert(_l.u.SAP_MSG_PREFIX + jsonObjC.returnMessage);
		wtyInfoReset();
	}
	
    // C550 DOP alert 2017.08.24 jiw
    // Local SVC Product <> HHP01/05/06, SVC Type <> KT, RB, PR
    var serviceType = $("SERVICE_TYPE").value;
    var isAlertDOP = !(svcProd == "HHP01" || svcProd == "HHP05" || svcProd == "HHP06") 
    					&& !(serviceType == "KT" || serviceType == "RB" || serviceType == "PR")
    					&& $('PURCHASE_DATE').value != _l.PURCHASE_DATE;
    if(loginUserCorpCode == "C550"){
    	if(isAlertDOP){
    		alert(_l.u.WEB_MSG_PREFIX + "Please upload invoice copy.");
    	}
    }
	
/*    if(loginUserCorpCode == "C820" || loginUserCorpCode == "C5A0" || loginUserCorpCode == "C540"){
    	checkCertiNoforADH();
    }else{
		if(jsonObjC.lp_inout == "LP"){
			// Care Pack 고도화 - 2017.03 - Start //
			if(_l.isCarePackService){
				checkCertiNoforADH();
			}else{
				if((_l.u.c == "C850" || _l.u.c == "C813") && !_l.noMoreUseModelForADH){
					checkModelforADH();
				}else{
					checkCertiNoforADH();
				}
			}
			// Care Pack 고도화 - 2017.03 - End //
			if(calledGMESBySerialButNoData && $j('#IN_OUT_WTY').val() == 'LP'){
				checkMesProduct();
			}
		}
    }*/
    if((_l.u.c == "C850" || _l.u.c == "C813") && !_l.noMoreUseModelForADH){
    	if(jsonObjC.lp_inout == "LP"){
    		checkModelforADH();
    	}
    }else{
    	checkCertiNoforADH();
    }
    
	if(calledGMESBySerialButNoData && $j('#IN_OUT_WTY').val() == 'LP'){
		checkMesProduct();
	}
	
	// =================================================================================//
	// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
	// Activation
	// 수정일 : 2015.04.28
	// 수정자 : 채보람 (로젠 솔루션)
	// 내 용 : IMEI Tracker I/F 후 Activation Date 를 Purchase Date 에 넣는다.
	var SERVICE_TYPE = $("SERVICE_TYPE").value;
	// START : C19050007571 [GSPN] Purchase date editable in SVC type KT for Network Product
	var svcProd = $('SVC_PRCD').value.substring(0, 3);
	var serviceTypeNotNeedPD = ((SERVICE_TYPE == "KT" && svcProd != "NEX")|| SERVICE_TYPE == "SR");
	// END   : C19050007571 [GSPN] Purchase date editable in SVC type KT for Network Product
	
	if(!serviceTypeNotNeedPD){
		if(_l.imeiTrackerActDate != ""){
	    	$j("#PURCHASE_DATE").val(_l.imeiTrackerActDate);
	    }
	}
	// =================================================================================//
	//GD IQC 재수리건 GD IQC 의무화 로직
	if(!isRunningOnOperation && _l.canUseIqcGd && isDiagnosticCheckModel){
		if(jsonObjC.redo == "Y"){
			$('detailForm').REDO.value = "Y";
		}else{
			$('detailForm').REDO.value = "";
		}
	}
	
	// Care Pack 고도화 - 2017.03 - Start //
	if($j("#SERVICE_TYPE").val() == "AD"){
		if(_l.owPackFlag == "X" || _l.u.c == "C820" || _l.u.c == "C5A0"){
			setComboValue($('detailForm').WTY_EXCEPTION, $('WTY_EXCEPTION').value);
		}else{
			$('WTY_EXCEPTION').value = "";
		}
		$('WTY_EXCEPTION').disabled = "disabled";
	}
	// Care Pack 고도화 - 2017.03 - End //

	getEngineerList();
}



function wtyInfoReset() {
	
	// =================================================================================//
	// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
	// Activation
	// 수정일 : 2015.04.28
	// 수정자 : 채보람 (로젠 솔루션)
	// 내 용 : 인도일 경우 초기화를 막는다.
	if((_l.isIndia || _l.isBangladesh || _l.isSrilanka || _l.isNepal) && isProdHHPIndia()){
		return;
	}
	// =================================================================================//
	
	$('IN_OUT_WTY').value = '';
	$('TERM_LABOR').value = '';
	$('TERM_PARTS').value = '';
	$('TERM_OTHER').value = '';
	$('PRODUCT_DATE').value = '';
	$('SALES_COUNTRY').value = '';

	if (isMedisonUser) {
		$('PURCHASE_DATE').value = '';
	}
}

function setComboValue(selectObj, def) {
	for ( var i = 0; i < selectObj.length; i++) {
		if (def == selectObj[i].value) {
			selectObj[i].selected = true;
			break;
		}
	}
}

function SymptomFeedback() {
	if ($('IV_FEEDBACK').value.strip() == "") {
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_XVALUE_00243);
		$('IV_FEEDBACK').focus();
		return;
	}
	$('svcSymptomReason').IV_FEEDBACK.value = $('IV_FEEDBACK').value;
	$('svcSymptomReason').IV_CATEGORY.value = 'O';
	$('svcSymptomReason').cmd.value = 'ServiceOrderSympReasonCmd';
	isSumitFeedback = true;

	AjaxRequest(urlPatternGZIP, 'svcSymptomReason', setSymptoServeymMessage);
}

function setSymptoServeymMessage(response) {
	try {
		var jsonObj = eval('(' + response.responseText + ')');
		if (jsonObj.success) {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.SAVE);
		} else {
			if (jsonObj.error) {
				cfExceptionPop(jsonObj);
			}
			if (jsonObj.message)
				alert(_l.u.SAP_MSG_PREFIX + jsonObj.message);
		}
	} catch (e) {
	}

}

function SvcSymptomChange() {
	$('progressloading').startWaiting();
	$('svcSymptomCode').cmd.value = 'ServiceOrderDirectCmd';
	$('svcSymptomCode').SYMPTOM_CAT1.value = $('detailForm').SYMPTOM_CAT1.value
	$('svcSymptomCode').SYMPTOM_CAT2.value = $('detailForm').SYMPTOM_CAT2.value
	$('svcSymptomCode').SYMPTOM_CAT3.value = $('detailForm').SYMPTOM_CAT3.value
	$('svcSymptomCode').SYMPTOM_CAT4.value = $('detailForm').SYMPTOM_CAT4.value

	AjaxRequest(urlPatternGZIP, 'svcSymptomCode', setSymptomMessage);
}
function setSymptomMessage(response) {
	try {
		var jsonObj = eval('(' + response.responseText + ')');
		if (jsonObj.success) {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.SAVE);
			callDetail();
		} else {
			if (jsonObj.error) {
				cfExceptionPop(jsonObj);
			}
			if (jsonObj.returnMessage)
				alert(_l.u.SAP_MSG_PREFIX + jsonObj.returnMessage);
		}
	} catch (e) {
	}
	$('progressloading').stopWaiting();

}

