	function validateSymFeedbackSaved(){
		var url = urlPatternGZIP;
		var data = "cmd=ServiceOrderSymFeedbackVer2Cmd&IV_OBJECT_ID=" + _l.ObjectId + "&IV_ASC_CODE=" + _l.ASC_CODE + "&IV_TYPE=D";
		var isValid = true;
		$j.ajax({
			type : "POST",
			async : false,  /* 동기 */ 
			url : url,
			data : data,
			success : function(data) {
				if (data.eT_FEEDBACK.length > 0) {
					isSymFeedbackSaved = true;
					isValid = true;
				}else{
					isValid = false;
				}
			},
			dataType : 'json'
		});
		
		return isValid;		
	}
	
