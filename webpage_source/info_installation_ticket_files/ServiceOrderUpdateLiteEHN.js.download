// 제 목 : 인도 Demand
// 과 제 : Fedex system integration with GSPN
// 수 정 일 : 2015-05-18
// 수 정 자 : 정성균 (로젠 솔루션)
// 내 용 : Fedex system integration with GSPN 관련 펑션
// =============================================================================

// 배송 번호 생성하기
function genDocket(){
	var serviceType = $j("#SERVICE_TYPE").val();
	var shipCompany = $j("#SHIP_COMPANY").val();

	if( serviceType != "SH" && serviceType != "PS"){
		alert(_l.u.WEB_MSG_PREFIX + "You can generate docket# when Service type is SH/PS.");
		return;
	}

	if( $j("#SHIP_COMPANY").val() != "SHC003"){
		alert(_l.u.WEB_MSG_PREFIX + "You can generate docket# when shipping company is FEDEX.");
		return;
	}

	if(_l.SERVICE_TYPE == "CI" && serviceType == "SH" && $j("#ESCAL_ASC").val() == ""){
		alert(_l.u.WEB_MSG_PREFIX + "Select Escal ASC.");
		return;
	}

	$('progressloading').startWaiting();

	clearForm("frm");
	insertValue("frm", "cmd", "FedexShipCmd");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_FROM_ASC", _l.ASC_CODE );
	insertValue("frm", "IV_TO_ASC", $j("#ESCAL_ASC").val() );
	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId);
	insertValue("frm", "IV_SERVICE_TYPE", serviceType);
	AjaxRequest(urlPattern,'frm', setGenerateDockNo);
}

function setGenerateDockNo(response) {
	try {
		$('progressloading').stopWaiting();

		var dockJsonObj = eval('('+response.responseText+')');

		if(dockJsonObj.success){
			if(dockJsonObj.ET_RET_CODE == "S"){
				$j("#SHIP_OUT_NO").val(dockJsonObj.TrackingNo);
				_l.isDockNoSave = true;
			}
			else{
				alert(_l.u.SAP_MSG_PREFIX + dockJsonObj.ET_RET_MSG);
			}
		}
		else{
			alert(_l.u.WEB_MSG_PREFIX + "Data not found.");
		}

	} catch (e) {}
}

// 배송지 출력 및 배송 신청 하기 위한 팝업창 띄우기
function genPrintChallan(savedShipOutNo){

	var serviceType = $j("#SERVICE_TYPE").val();
	var shipCompany = $j("#SHIP_COMPANY").val();

	if(savedShipOutNo == "" || _l.isDockNoSave){
		alert(_l.u.WEB_MSG_PREFIX + "Docket no is mandatory in Shipment No (Post) before printing challan.");
		return;
	}

	if(_l.IMEI == "M000" || _l.IMEI == "12345678" || _l.IMEI == "TEMP" || _l.IMEI == "MOOO" || _l.IMEI == "11111111" || _l.IMEI == "00000000"
	 		|| _l.IMEI.strip().length < 5){
	 	alert(_l.u.WEB_MSG_PREFIX + "Please input Correct IMEI No.");
	 	return;
	 }

	if( serviceType != "SH" && serviceType != "PS"){
		alert(_l.u.WEB_MSG_PREFIX + "You can generate docket number when service type is SH/PS.");
		return;
	}

	if(_l.SERVICE_TYPE == "CI" && serviceType == "SH" && $j("#ESCAL_ASC").val() == ""){
		alert(_l.u.WEB_MSG_PREFIX + "Select Escal ASC.");
		return;
	}

	if($j("#SHIP_OUT_NO").val() == ""){
		alert(_l.u.WEB_MSG_PREFIX + "Please insert Shipment No (Post).");
		return;
	}

	var url = "/svctracking/common/SVCPopShipmentChallan.jsp";
 	var w = window.open(url,"shipment_popup",
 		'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=240');
 	w.focus();

 	clearForm("frm");
 	insertValue("frm", "dockNo", $j("#SHIP_OUT_NO").val() );
 	insertValue("frm", "imei", _l.IMEI);
 	insertValue("frm", "shipCompany", $j("#SHIP_COMPANY").val());
 	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_FROM_ASC", _l.u.AccountCode);
	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId);
	insertValue("frm", "IV_SERVICE_TYPE", serviceType);
	insertValue("frm", "IV_TO_ASC", $j("#ESCAL_ASC").val());

	var frm = $('frm');
	frm.action='/svctracking/common/SVCPopShipmentChallan.jsp';
	frm.target='shipment_popup';
	frm.submit();
}

// 배송 추적
function fedexTrack(trackingNumber){

	var url = "https://www.fedex.com/apps/fedextrack/?action=track&trackingnumber="+trackingNumber;
	 w = window.open(url,"tracking_popup",
		'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=600');
	 w.focus();
}

// 탭을 바꾸었을 때 버튼 초기화
function initFedexShipButton(newTabId){
	if(!_l.isIndia){
		return;
	}
	
	if(newTabId != "divShipping"){
		return;
	}
	var status = $j("#STATUS").val();
	var isRepair = (status == "ST035" || status == "ST040");
	var isFedex = $j("#SHIP_COMPANY").val() == "SHC003";
	var isLocal = $j("#SHIP_COMPANY").val() == "SHC021";

	setHideFedex();
	
	if(isFedex){
		$j("#SHIP_IN_NO").removeClass().addClass("inputRO").prop("readonly", true);
		$j("#SHIP_OUT_NO").removeClass().addClass("inputRO").prop("readonly", true);
	
		if(_l.SERVICE_TYPE == "SH"){
			if(!isRepair){
				$j("#generateDocket").show();
				$j("#printChallan").show();
			}
		}
		else if(_l.SERVICE_TYPE == "PS"){
			if(isRepair){
				$j("#generateDocket").show();
				$j("#printChallan").show();
			}
		}
		else{
			if($j("#SERVICE_TYPE").val() == "SH" || $j("#SERVICE_TYPE").val() == "PS"){
				$j("#generateDocket").show();
			}
		}
	}
	else if(isLocal){
		$j("#SHIP_IN_NO").removeClass().addClass("inputRO").prop("readonly", true);
		
		if(_l.SERVICE_TYPE == "SH"){
			if(!isRepair){
				$j("#printChallan").show();
			}
		}
		else if(_l.SERVICE_TYPE == "PS"){
			if(isRepair){
				$j("#printChallan").show();
			}
		}
	}
}

function setHideFedex(){
	$j("#generateDocket").hide();
	$j("#printChallan").hide();
	$j("#SHIP_IN_NO").removeClass().addClass("input").prop("readonly", false);
	$j("#SHIP_OUT_NO").removeClass().addClass("input").prop("readonly", false);
}

// ====================================================================================


function validCancelSAW() {
	var isValid = true;
	var statusReason = $j('#REASON').val();
	
//	getCenterType("1");
	var isIndependentASC = ("ASC" == centerType && "B" != jsonCenterTypeObj.ES_BP101.b2B_SVC 
			&& "Y" != jsonCenterTypeObj.ES_BP101.ZEXCLUSIVE 
			&& "N" != jsonCenterTypeObj.ES_BP101.ASC_REL && "C" != jsonCenterTypeObj.ES_BP101.ASC_REL);
	
	if(("FE" == centerType || "BE" == centerType || "MSC" == centerType || isIndependentASC || $('WTY_EXCEPTION').value == "OTWEU") 
			&& $j("#SVC_PRCD").val() != "HME" 
			&& ($j("#SERVICE_TYPE").val() == "IH" || $j("#SERVICE_TYPE").val() == "SI" || _l.u.c == "C370")){
		if ($j("#STATUS").val() == "ST052") {
			if(_l.sawExistAscCancelRequestApproved){
				// pass;
			}else if(_l.sawExistAscCancelRequest && !_l.sawExistAscCancelRequestApproved){
				alert(_l.u.WEB_MSG_PREFIX + "Your SAW Cancel Request is pending review. No further action is permitted at this time.");
				isValid = false;
			}else{
				// popup SAW with Cancel Requested - SEA in Review.
				openSAWCreatePop("SRC70");
				isValid = false;
			}
		}
	}else{
		if(
				$("STATUS").value == "ST052" 
				&& ($('STATUS_COMMENT').value == null || $('STATUS_COMMENT').value.trim() == "")
				&& (_l.u.c == "C310" || _l.u.c == "C370")
		  )
		{
			alert('Please input status comment.');
			return;
		}
	}
	
	return isValid;
}

function getUnNoFromMPTSAsync() {
	var url = urlPatternGZIP;
	var data = "cmd=GetIMEIofHHPCmd&imei=" + $("IMEI").value + "&model="+ $("detailForm").MODEL.value + "&multinum=Y";
	var mptsUnNo = "";
	var returnParamMap = {};

	$j.ajax({
		type : "POST",
		async : false, /* 동기 */
		url : url,
		data : data,
		success : function(data) {
			if (data) {
				if (data.success) {
					mptsUnNo = data.unNum;
					returnParamMap.MPTS_UN_NO = data.unNum;
					returnParamMap.MASTER_NUM = data.masterNum;
					returnParamMap.WP_IMEI = data.wpImei;
					returnParamMap.SLAVE_IMEI = data.slaveImei;
					returnParamMap.THIRD_IMEI = data.thirdImei;
				} else {
					returnParamMap.MPTS_UN_NO = "";
					returnParamMap.MASTER_NUM = "";
					returnParamMap.WP_IMEI = "";
					returnParamMap.SLAVE_IMEI = "";
					returnParamMap.THIRD_IMEI = "";
				}
			} else {
				returnParamMap.MPTS_UN_NO = "";
				returnParamMap.MASTER_NUM = "";
				returnParamMap.WP_IMEI = "";
				returnParamMap.SLAVE_IMEI = "";
				returnParamMap.THIRD_IMEI = "";
			}
		},
		dataType : 'json'
	});
	return returnParamMap;
	// return true;
}

function isFeaturePhoneAsync() {
	var url = urlPatternGZIP;
	var data = "cmd=ServiceOrderModelSearchCmd&CorpCode=" + _l.u.c + "&MODEL="+ $("detailForm").MODEL.value+"&IV_DATE="+_l.CREATE_DATE+"&ASC_CODE"+_l.ASC_CODE;
	var isFeaturePhoneAsync = false;
	$j.ajax({
		type : "POST",
		async : false, /* 동기 */
		url : url,
		data : data,
		success : function(data) {
			if (data.success) {
				if(data.etModelInfoList[0].local_svc_prod == "THBA1" || data.etModelInfoList[0].hq_svc_prod == "THBA1" || data.etModelInfoList[0].local_svc_prod == "THBA2" || data.etModelInfoList[0].hq_svc_prod == "THBA2"){
					isFeaturePhoneAsync = true;
				}else{
					isFeaturePhoneAsync = false;
				}
			} else {
				isFeaturePhoneAsync = false;
			}
		},
		dataType : 'json'
	});
	return isFeaturePhoneAsync;
	// return true;
}
function getHQSvcProdAsync() {
	var url = urlPatternGZIP;
	var data = "cmd=ServiceOrderModelSearchCmd&CorpCode=" + _l.u.c + "&MODEL="+ $("detailForm").MODEL.value+"&IV_DATE="+_l.CREATE_DATE+"&ASC_CODE"+_l.ASC_CODE;
	var hqSvcProd = "";
	$j.ajax({
		type : "POST",
		async : false, /* 동기 */
		url : url,
		data : data,
		success : function(data) {
			if (data.success) {
				hqSvcProd = data.etModelInfoList[0].hq_svc_prod;
			}
		},
		dataType : 'json'
	});
	return hqSvcProd;
}
