		}
	
		//원래 중국 메소드명은 searchNewModelInfo() 엿는데 validNewModelNameInfo 변경함.
		function validNewModelNameInfo() {
			var valid = true;
			var url = urlPatternGZIP;
			var NEW_MODEL = $j('#NEW_MODEL').val().trim();
			var modelInfo = NEW_MODEL;
			if(NEW_MODEL == ''){
				modelInfo = 'X';
			}
			
			var data = "cmd=ServiceOrderModelSearchCmd&MODEL=" + modelInfo;
			$j.ajax({
				type : "POST",
				async : false, /* 동기 */
				url : url,
				data : data,
				success : function(data) {
							

							if (data.success) {		
								if(data.etModelInfoList.length == 1 ){
									$('NEW_MODEL_NAME').value = data.etModelInfoList[0].model_name;
								}
								else {
									$('NEW_MODEL_NAME').value = '';
								}
							} else {
								$('NEW_MODEL_NAME').value = '';
							}
							
							//Old Model_NAME과 New Model_NAME이 동일한지 체크
							if($('NEW_MODEL').value.trim() != ""){
								if($('MODEL_NAME').value != $('NEW_MODEL_NAME').value){
									alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0391 + "\n"+ "(MODEL_NAME:" + $j('#MODEL_NAME').val() + ",NEW_MODEL_NAME:" + $j('#NEW_MODEL_NAME').val() + ")");
									valid = false;
								}		
							}
					
							//중국은 여기서 verify1() 을 호출햇으나, 이제는 validNewModelInfo() 다음에 호출함.
							//verify1();

				},
				dataType : 'json'
			});
			return valid;
		}// validNewModelNameInfo()
		if(!validNewModelNameInfo()){
			return;
		}		
		
