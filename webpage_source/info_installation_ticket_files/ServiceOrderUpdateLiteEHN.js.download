/**
 * [General, Repair Tab 삭제에 따른 load script 이동]
 * @return {[type]} [description]
 */
function initializeEHN() {

	// General tab
	if (_l.u.isChinaRegion) {
		$j('[name=B2B_SVC]').attr('disabled',true);	
	} else {
		if ("Y" != _l.autoBill && !_l.isQuotationUser){
			$('ASC_JOB_NO').className = "inputIDS";
		}
		
		if ("C370" != _l.u.c) getCPList();
		if ("C310" == _l.u.c || "C370" == _l.u.c) {
			//$('dataorigin').writeAttribute("colspan", "3")
			$('cpdealer').hide();
			$('cpdealerin').hide();
		}// if(_l.u.c == "C310"){
		
		if (_l.isPSApp) {
			$("CC_CODE").className="inputRO";
			$("CC_CODE").readOnly==true;
			$("CC_CODE_ICON").style.display="none";
		}
	}

	// Repair tab
	/* Service Indicator */
	if(_l.useSvcIndicator){
		var obj = eval($('SVC_INDICATOR'));
		if (obj != null) getServiceIndicator();
	}
	
	if(_l.useTechnicianId){
		getTechnicianList("tab");
	}

	var statusCode = $("STATUS").value;
	if ("ST035" == statusCode) {// Status Repair Completed , Goods Delivered
		$('REP_TYPE').className = "selectIDS";
		$('LAB_TYPE').className = "selectIDS";
	}
	if ("C550" == _l.u.c) {
		$('REP_TYPE').value = $('SERVICE_TYPE').value;
	}
	
	if ("C310" == _l.u.c || "C370" == _l.u.c) {
		$('GasChargeDistanceTr').hide();
		$('IrisCodeDec').hide();
		// $('defectbolck').hide();
	}
	
	// =============================================================================
	// 제 목 : 인도 Demand
	// 과 제 : extra conveyance process flow
	// 수 정 자 : 채보람 (로젠솔루션)
	// 수 정 일 : 2015-06-16
	// 내 용 : 인도일때 실거리를 가져오는 function 호출
	// =============================================================================
	if ("C550" == _l.u.c && "IN" == _l.u.CountryCd && "LP" == _l.IN_OUT_WTY) {
		initDistance();
	}
	// =============================================================================
	
	if ("C550" == _l.u.c) {
		changeVANID();
	}

	$j('#GENERAL_FLAG').val('X');
//	$j('#CUSTOMER_FLAG').val('X');
	$j('#PRODUCT_FLAG').val('X');
	$j('#REPAIR_FLAG').val('X');	

	$j('#divRepair').show();

    // EHN : 필드 제어
	if(_l.u.c == "C370"){
		initWisTab('divRepair');
	}else if(_l.isFieldNewUser){
		initFemeTab('divRepair');
	}  
	
	//initCustomerTab();
	//initProductTab();

	// EHN15 : field control
	serviceTypeChangeEHN($("SERVICE_TYPE").value, false);
	modelChangeEHN(_l.CIC_PRCD, false);		

	initialize();

}


function serviceTypeChangeEHN(serviceType, tab) {

	// Repeat Token
	if ("C550" == _l.u.c && "IN" == _l.u.CountryCd) {
		if ("CI" == serviceType) {
			$j('#RE_TOKEN_NO').closest('td').prev().show();
			$j('#RE_TOKEN_NO').closest('td').show();
		} else {
			$j('#RE_TOKEN_NO').closest('td').prev().hide();
			$j('#RE_TOKEN_NO').closest('td').hide();
		}
	} /*end if ("C550" == _l.u.c && "IN" == _l.u.CountryCd)*/

	// Collection Point, CP/Dealer Ref. No
	if (!isChinaRegion) {
		if ("CI" == serviceType) {
			$j('#tdCCPoint').closest('tr').hide();
		} else {
			$j('#tdCCPoint').closest('tr').show();
		}
	}

	// Distance
	if (isChinaRegion) {
		if ("CI" == serviceType) {
			$j('#trDistance').hide();
		} else {
			$j('#trDistance').show();
		}
	} else {
		if ("CI" == serviceType) {
			$j('#trDistance').closest('td').hide();
			$j('#trDistance').closest('td').prev().hide();
		} else {
			$j('#trDistance').closest('td').show();
			$j('#trDistance').closest('td').prev().show();
		}
	}
	if("C610" == _l.u.c  && "II" == serviceType) {
	    if($j('#SVC_PRCD').val() == "LED65" || $j('#SVC_PRCD').val() == "LED75" || $j('#SVC_PRCD').val() == "LED85"){
	        $j('#trDistance').hide();
	    }
	}

	// Extra Freight
	if ("EU" == _l.u.subRegionCd) {
		if ("CI" == serviceType) {
			$j('#EXTRA_FREIGHT').closest('td').hide();
			$j('#EXTRA_FREIGHT').closest('td').prev().hide();
		} else {
			$j('#EXTRA_FREIGHT').closest('td').show();
			$j('#EXTRA_FREIGHT').closest('td').prev().show();
		}
	}else{
		$('REP_TYPE').value = $('SERVICE_TYPE').value;
	}

	if (isEaUser && serviceType == 'SH' && (relatedTicketCancelFlag || relatedTicketId == "")) {// Service Handling
		$j("#escalAscTd1,#escalAscTd2").css("display","block");
		if (!json_escalAsc.et_escalation_asc) {
			escalAscSearch();
			
		}	
	}
	
	// Token No
	if (tab || "divJob" == currTabId) {
		if (isChinaRegion) {
			if ("CI" == serviceType) {
				$j('#TOKEN_NO').closest('td').show();
				$j('#TOKEN_NO').closest('td').prev().show();
			} else {
				$j('#TOKEN_NO').closest('td').hide();
				$j('#TOKEN_NO').closest('td').prev().hide();
			}
		} else {
			if ("CI" == serviceType || "AD" == serviceType) {
				$j('#tdTokenNo1').show();
				$j('#tdTokenNo2').show();
			} else {
				$j('#tdTokenNo1').hide();
				$j('#tdTokenNo2').hide();
			}
		}
	} /*end if (serviceType != _l.SERVICE_TYPE)*/

	// 기존 field 제어 호출
	if (isNewChina) {
		C6V0_fieldView();
		if (jsonOther != null) setDistanceCombo();
	}
	
	if(isNewChina && $('SERVICE_TYPE').value == "II"){
		if("LED|PDP|LTV".indexOf($('SVC_PRCD').value.substring(0,3)) > -1){
			if(_l.isSawOTWE1Approved) {
			} else {
				$j("#WTY_EXCEPTION").find("option:[value=OTWE1]").remove();
			}
		}	
	}
}


function modelChangeEHN(cicPrcd, tab) {

	if (!isNewChina) {
		// IMEI
		if ("HHP" == cicPrcd) {
			//IMEI PROJECT
			if(isAutoImei){
				$j('#IMEI_TXT').show();
			}else{
				$j('#IMEI').show();
			}
			if ("C540" == _l.u.c) {
				$j('#TD_CARRIER').show();
				$j('#TD_CARRIER').prev().show();
			}
		} else {
			//$j('#IMEI').hide(); // EHN20
			if ("C540" == _l.u.c) {
				$j('#TD_CARRIER').hide();
				$j('#TD_CARRIER').prev().hide();
			}
		}
	}
	
	if(_l.CIC_PRCD == "HHP" && _l.SERIAL_NO == "M000"){
		$j("#td_QrPba,#pbaQrCode,#txt_QrPba").show();
	}else{
		$j("#td_QrPba,#pbaQrCode,#txt_QrPba").hide();
	}

	// Firmware Version, New Firmware
//	var cirPrcdArray = ["HHP", "VDE", "WSM", "WM"];
	var cirPrcdArray = ["HHP", "VDE"];
	var euCirPrcdArray = ["ACN", "SAC", "WSM", "HKE", "REF", "CLE"];
	if (($j.inArray(cicPrcd, cirPrcdArray) > -1) || (isEuUser && $j.inArray(cicPrcd, euCirPrcdArray) > -1)) {
		if (!isChinaRegion) {
			if (tab || "divJob" == currTabId) {
				$j('#NEW_FIRMWARE').closest('td').show();
				$j('#NEW_FIRMWARE').closest('td').prev().show();
			}
		} else {
			if (!isNewChina) {
				$j('#OLD_FIRMWARE').closest('td').show();
				$j('#OLD_FIRMWARE').closest('td').prev().show();
				if (tab || "divJob" == currTabId) {
					$j('#NEW_FIRMWARE').closest('td').show();
					$j('#NEW_FIRMWARE').closest('td').prev().show();
				}
			}
		}
	} else {
		if (!isChinaRegion) {
			if (tab || "divJob" == currTabId) {	
				$j('#NEW_FIRMWARE').closest('td').hide();
				$j('#NEW_FIRMWARE').closest('td').prev().hide();
			}
		} else {
			if (!isNewChina) {
				$j('#OLD_FIRMWARE').closest('td').hide();
				$j('#OLD_FIRMWARE').closest('td').prev().hide();
				if (tab || "divJob" == currTabId) {
					$j('#NEW_FIRMWARE').closest('td').hide();
					$j('#NEW_FIRMWARE').closest('td').prev().hide();
				}
			}
		}
	}

	// Page Count
	if ("PRT" == cicPrcd) {
		$j('#PRINTED_PAGE').closest('td').show();
		$j('#PRINTED_PAGE').closest('td').prev().show();
	} else {
		$j('#PRINTED_PAGE').closest('td').hide();
		$j('#PRINTED_PAGE').closest('td').prev().hide();
	}

	// NEW IMEI
	if ("HHP" == cicPrcd) {
		//IMEI PROJECT
		if(isAutoImei){
			$j('#NEW_IMEI_TXT').closest('td').show();
			$j('#NEW_IMEI_TXT').closest('td').prev().show();
		}else{
			$j('#NEW_IMEI').closest('td').show();
			$j('#NEW_IMEI').closest('td').prev().show();
		}
		
		$j('#TD_CARRIER').closest('td').show();
		$j('#TD_CARRIER').closest('td').prev().show();
	} else {
		//IMEI PROJECT
		if(isAutoImei){
			$j('#NEW_IMEI_TXT').closest('td').hide();
			$j('#NEW_IMEI_TXT').closest('td').prev().hide();
		}else{
			$j('#NEW_IMEI').closest('td').hide();
			$j('#NEW_IMEI').closest('td').prev().hide();
		}
		

		$j('#TD_CARRIER').closest('td').hide();
		$j('#TD_CARRIER').closest('td').prev().hide();
	}

	// Gas Charge
	cirPrcdArray = ["ACN", "REF"];
	if ($j.inArray(cicPrcd, cirPrcdArray) > -1) {
		if (!isChinaRegion) {
			$j('#GAS_CHARGE').closest('td').show();
			$j('#GAS_CHARGE').closest('td').prev().show();
		}
	} else {
		if (!isChinaRegion) {
			$j('#GAS_CHARGE').closest('td').hide();
			$j('#GAS_CHARGE').closest('td').prev().hide();
		}
	}
		
	if(_l.u.c == 'C550' && $j('#IN_OUT_WTY').val() =="OW" && ($j("#SERVICE_TYPE").val() == "IH" || $j("#SERVICE_TYPE").val() == "PS")
			&& "W/M01,W/M02,W/M03".indexOf($j('input#SVC_PRCD').val().substring(0,5)) >= 0){
		$j('#GAS_CHARGE').closest('td').show();
		$j('#GAS_CHARGE').closest('td').prev().show();
	}
	
	if(_l.u.c == 'C550' && _l.u.CountryCd == "IN" && "CI,IH,PS,SR".indexOf($j("#SERVICE_TYPE").val()) >= 0
			&& "CTV12,CTV13,CTV14,CTV16,CTV17".indexOf($j('input#SVC_PRCD').val().substring(0,5)) >= 0){
		$j('#GAS_CHARGE').closest('td').show();
		$j('#GAS_CHARGE').closest('td').prev().show();
	}
	
	if(isNewChina && $('SERVICE_TYPE').value == "II"){
		if("LED|PDP|LTV".indexOf($('SVC_PRCD').value.substring(0,3)) > -1){
			if(_l.isSawOTWE1Approved) {
			} else {
				$j("#WTY_EXCEPTION").find("option:[value=OTWE1]").remove();
			}
		}	
	}

	if(_l.u.c == 'C962'){
		var isSSDProduct = ("SSD01,SSD02,SSD03,SSD04,SSD05".indexOf($('HQ_SVC_PRCD').value.substring(0,5)) > -1);
		if("SSD01".indexOf($('SVC_PRCD').value.substring(0,5)) >= 0 || isSSDProduct){
			$j("#SERVICE_TYPE").find("option:[value=ER]").prop("disabled",false);
		}else{
			$j("#SERVICE_TYPE").find("option:[value=ER]").prop("disabled",true);
		}
	}
}
var showListCount = 0;
function resultVSR(jsonObj_result, status){
	$('progressloading').startWaiting();
	var length = jsonObj_result.EtVsr2ErrInfo.length;
	showListCount = 0;
	var showListCountExceptEwithFileExist = 0;
	var confirmStr = _l.r.m.EXT_0805 + "“"+_l.r.c.LBL_00331+"”" + "<br>" + _l.r.m.EXT_0806 + _l.r.c.LBL_07138+"?";
	if(status == "ST040"){
		if(_l.isAutoWty){
			//Wty Verify 이후에 사용자에게 한번더 물어보고 ST040 & Wty Claim진행시킨다.
			confirmStr = _l.r.m.EXT_0805 + "“"+_l.r.c.LBL_00331+"”" + "<br>" + _l.r.m.EXT_0806 + _l.r.c.LBL_07138+"?";
		}else{
			//EHN : autowty 없이 VSR2 만 적용된느 경우, 워런티 안하므로 "submit a warranty claim" 삭제함.
			confirmStr = _l.r.m.EXT_0805 + "“"+_l.r.c.LBL_00331+"”?";
		}
	}else if(status == "ST035"){
		//Wty Verify 이후에 사용자에게 한번더 물어보고 ST035 진행시킨다.
		confirmStr = _l.r.m.EXT_0805 + "“"+_l.r.c.LBL_00662+"”?";
	}
	if(status == "ST040"){	
		if(_l.isAutoWty){			//EHN : autowty 경우.
			$j("#spanSubmitBtn").text(_l.r.c.LBL_06839);
			$j("#spanSubmitBtn2").text(_l.r.c.LBL_06839);
		}else{						//EHN : auto wty 사용 안함
			$j("#spanSubmitBtn").text(_l.r.c.LBL_00331);
			$j("#spanSubmitBtn2").text(_l.r.c.LBL_00331);
		}
	}else if(status == "ST035"){
		$j("#spanSubmitBtn").text(_l.r.c.LBL_00662);
		$j("#spanSubmitBtn2").text(_l.r.c.LBL_00662);
	}
	
	if(length > 0){
		var attachmentStr = _l.r.m.EXT_0647;
		$j('#tbodyError').html('');
		var fileExist = $('attachTableBody').rows.length > 0;
		var existTypeE = false;
		for(var i=0;i<length;i++){
			var errorCd = jsonObj_result.EtVsr2ErrInfo[i].msgNo;
			var errorTxt = jsonObj_result.EtVsr2ErrInfo[i].msgTx;
			if(_l.isVSR2Check){
				if(jsonObj_result.EtVsr2ErrInfo[i].descFollowUpCode != ""){
					if(_l.u.c == "C310" || _l.u.c == "C370" || _l.u.c == "C550" || isNewChina || isCisUser || isMeaUser || isAfUser || isEuUser || isEaUser){	//미국인 경우 E 무조건 보여줬으나, 전법인 보여주는 것으로 변경
						var $tr	= $j("<tr></tr>");
						$tr.append($j("<td class='td_ac'>" + errorCd + "</td>"));
						$tr.append($j("<td style='text-align:left'>" + errorTxt + "</td>"));
						$tr.append($j("<td class='td_ac'>" + jsonObj_result.EtVsr2ErrInfo[i].descFollowUpCode + "</td>"));
						$j('#tbodyError').append($tr);
						if(jsonObj_result.EtVsr2ErrInfo[i].msgFu == "E"){
							existTypeE = true;
						}
						showListCount++;
						if(jsonObj_result.EtVsr2ErrInfo[i].msgFu != "S"){
							if(fileExist && jsonObj_result.EtVsr2ErrInfo[i].msgFu == "E"){
								continue;
							}else{
								showListCountExceptEwithFileExist++;
							}
						}
					}else{
						if(fileExist && jsonObj_result.EtVsr2ErrInfo[i].msgFu == "E"){
							continue;
						}else{
							var $tr	= $j("<tr></tr>");
							$tr.append($j("<td class='td_ac'>" + errorCd + "</td>"));
							$tr.append($j("<td style='text-align:left'>" + errorTxt + "</td>"));
							$tr.append($j("<td class='td_ac'>" + jsonObj_result.EtVsr2ErrInfo[i].descFollowUpCode + "</td>"));
							$j('#tbodyError').append($tr);
							if(jsonObj_result.EtVsr2ErrInfo[i].msgFu == "E"){
								existTypeE = true;
							}
							showListCount++;
							if(jsonObj_result.EtVsr2ErrInfo[i].msgFu != "S"){
								showListCountExceptEwithFileExist++;
							}
						}
					}
				}
			}else{
				var $tr	= $j("<tr></tr>");
				$tr.append($j("<td class='td_ac'>" + errorCd + "</td>"));
				$tr.append($j("<td style='text-align:left'>" + errorTxt + "</td>"));
				$j('#tbodyError').append($tr);
				showListCountExceptEwithFileExist++;
				showListCount++;
			}
		}
		
		$j('#divErrorInfo').css('left', $j(window).width()/2-325);
		$j('#divBlock').show();
		$j('#divErrorInfo').show();
		
		
		if(showListCount > 0){	// 에러 존재시, 타법인은 E type 첨부파일 존재시 패스
			if(_l.u.c == "C310" || _l.u.c == "C370" || _l.u.c == "C550" || isNewChina || isCisUser || isMeaUser || isAfUser || isEuUser || isEaUser){ // 미국인 경우
				if(status == "ST035" && (_l.u.c == "C310" || _l.u.c == "C370")){	//RC 변경시
					if(existTypeE && !fileExist){	//E type 존재시 파일첨부안했을 경우에만 warning 메세지
						$('warningVSR').show();
					}else{
						$('warningVSR').hide();
					}
					if(_l.isBlockAsVSR){
						if(showListCountExceptEwithFileExist > 0){
							$j('#submitBtnTable').hide();
						}else{
							$j('#submitBtnTable').show();
						}
					}else{
						$j('#submitBtnTable').show();	//항상 RC 버튼 보여주고
					}
				}else{		// GD 변경시 혹은 미국제외한 ST035 변경 포함
					if(existTypeE && fileExist){	
						var $tr	= $j("<tr></tr>");
						$tr.append($j("<td colspan='3' style='text-align:left; font-weight:bold; color:#e90000'>&nbsp;&nbsp;" + attachmentStr + "</td>"));
						$j('#tbodyError').append($tr);
						if(!_l.isBlockAsVSR && (_l.u.c == "C310" || _l.u.c == "C370")){
							$j('#submitBtnTable').show();
						}else{
							if(showListCountExceptEwithFileExist > 0){
								$j('#submitBtnTable').hide();
							}else{
								$j('#submitBtnTable').show();
							}
						}
					}else if(showListCountExceptEwithFileExist > 0){
						$j('#submitBtnTable').hide();
					}else{
						$j('#submitBtnTable').show();
					}
				}
			}else{
				$j('#submitBtnTable').hide();
			}
		}else{	//1,3 일때는 save 가능. 단, 버튼메세지는 type 에 맞게
			if(_l.isVSR2Check){
				
				$j('#divBlock').hide();
				$j('#divErrorInfo').hide();
				$j('#tbodyWtyNotice').html('');
				var $tr	= $j("<tr></tr>");					
				$tr.append($j("<td class='td_ac'>" + confirmStr + "</td>"));
				$j('#tbodyWtyNotice').append($tr);
				$j('#divWtyNoticeInfo').css('left', $j(window).width()/2-325);
				$j('#divBlock').show();
				$j('#divWtyNoticeInfo').show();
				$j('#submitBtnTable2').show();
			}else{
				$j('#submitBtnTable').show();
			}
		}
	}else{
		$j('#tbodyWtyNotice').html('');
		var $tr	= $j("<tr></tr>");					
		$tr.append($j("<td class='td_ac'>" + confirmStr + "</td>"));
		$j('#tbodyWtyNotice').append($tr);
		$j('#divWtyNoticeInfo').css('left', $j(window).width()/2-325);
		$j('#divBlock').show();
		$j('#divWtyNoticeInfo').show();
		$j('#submitBtnTable2').show();
	}
	$('progressloading').stopWaiting();
}

function resultVSRNew(jsonObj_result, status, message, isSaved){
	$('progressloading').startWaiting();
	var length = jsonObj_result.EtVsr2ErrInfo.length;
	var confirmStr = _l.r.m.EXT_0805 + "“"+_l.r.c.LBL_00331+"”" + "<br>" + _l.r.m.EXT_0806 + _l.r.c.LBL_07138+"?";
	if(status == "ST040"){
		if(_l.isAutoWty){
			//Wty Verify 이후에 사용자에게 한번더 물어보고 ST040 & Wty Claim진행시킨다.
			confirmStr = _l.r.m.EXT_0805 + "“"+_l.r.c.LBL_00331+"”" + "<br>" + _l.r.m.EXT_0806 + _l.r.c.LBL_07138+"?";
		}else{
			//EHN : autowty 없이 VSR2 만 적용된느 경우, 워런티 안하므로 "submit a warranty claim" 삭제함.
			confirmStr = _l.r.m.EXT_0805 + "“"+_l.r.c.LBL_00331+"”?";
		}
	}else if(status == "ST035"){
		//Wty Verify 이후에 사용자에게 한번더 물어보고 ST035 진행시킨다.
		confirmStr = _l.r.m.EXT_0805 + "“"+_l.r.c.LBL_00662+"”?";
	}
	if(status == "ST040"){	
		if(_l.isAutoWty){			//EHN : autowty 경우.
			$j("#spanSubmitBtnNew").text(_l.r.c.LBL_06839);
			$j("#spanSubmitBtn2").text(_l.r.c.LBL_06839);
		}else{						//EHN : auto wty 사용 안함
			$j("#spanSubmitBtnNew").text(_l.r.c.LBL_00331);
			$j("#spanSubmitBtn2").text(_l.r.c.LBL_00331);
		}
	}else if(status == "ST035"){
		$j("#spanSubmitBtnNew").text(_l.r.c.LBL_00662);
		$j("#spanSubmitBtn2").text(_l.r.c.LBL_00662);
	}
	$j("#spanSubmitBtnAsPending").text("Save as Pending");
	
	if(length > 0){
		var attachmentStr = _l.r.m.EXT_0647;
		$j('#tbodyErrorNew').html('');
		var fileExist = $('attachTableBody').rows.length > 0;
		var existError = false;
		var warTarget = false;
		var messageGuideExist = false;
		var messageGuide = "";
		for(var i=0;i<length;i++){
			var errorCd = jsonObj_result.EtVsr2ErrInfo[i].msgNo;
			var errorTxt = jsonObj_result.EtVsr2ErrInfo[i].msgTx;
			if(errorCd == "WARN1"){
				messageGuideExist = true;
				messageGuide = errorTxt;
				continue;
			}
			var $tr	= $j("<tr></tr>");
			$tr.append($j("<td class='td_ac'>" + errorCd + "</td>"));
			$tr.append($j("<td class='td_ac'>" + jsonObj_result.EtVsr2ErrInfo[i].statusDesc+"</td>"));
			$tr.append($j("<td style='text-align:left'>" + errorTxt + "</td>"));
			$j('#tbodyErrorNew').append($tr);
			
			if(jsonObj_result.EtVsr2ErrInfo[i].errorMode == "E"){
				existError = true;
			}
			if(jsonObj_result.EtVsr2ErrInfo[i].warTarget == "X"){
				warTarget = true;
			}
		}
		
		$j('#divErrorInfoNew').css('left', $j(window).width()/2-325);
		$j('#divBlock').show();
		$j('#divErrorInfoNew').show();
		
		$j('#submitBtnTableNew').hide();
		$j('#submitBtnTableAsPending').hide();

		
		if (isSaved =="S"){	//ST035 이전
			$j('#divCloseWithoutCallDetail').hide();
			$j('#divCloseWithCallDetail').show();
			$('savedMessage').show();
			if(messageGuideExist){
				message = message + "\n" + messageGuide;
				$j("#savedMessageDiv").text(message);
			}else{
				if(warTarget){
					$j("#savedMessageDiv").text(message + "\n" + "To have the Warranty Errors passed, please refer to a description & guide above.");
				}
			}
		}else{	//ST035 이후
			$j('#divCloseWithoutCallDetail').show();
			$j('#divCloseWithCallDetail').hide();
			if(!existError || _l.extSysFlag=="X"){
				$j('#submitBtnTableNew').show();
			}else{
				if((_l.u.c == "C310" || _l.u.c == "C370") && status == "ST035"){
					$j('#submitBtnTableAsPending').show();
				}
			}
			if(messageGuideExist || warTarget){
				$('savedMessage').show();
				if(messageGuideExist){
					$j("#savedMessageDiv").text(messageGuide);
				}else{
					if(warTarget){
						$j("#savedMessageDiv").text("To have the Warranty Errors passed, please refer to a description & guide above.");
					}
				}
			}
		}
		
/*		if(existError){
		}else{
			if(status == "ST035" || status == "ST040"){
				$j('#submitBtnTableNew').show();
				if(warTarget){
					$('savedMessage').show();
					$j("#savedMessageDiv").text("To have the Warranty Errors passed, ‘Warranty Approval Request’ is required");
				}
			}else{
				$('savedMessage').show();
				$j("#savedMessageDiv").text(message);
			}
		}*/
	}else{
		if(status == "ST035" || status == "ST040"){
			$j('#tbodyWtyNotice').html('');
			var $tr	= $j("<tr></tr>");					
			$tr.append($j("<td class='td_ac'>" + confirmStr + "</td>"));
			$j('#tbodyWtyNotice').append($tr);
			$j('#divWtyNoticeInfo').css('left', $j(window).width()/2-325);
			$j('#divBlock').show();
			$j('#divWtyNoticeInfo').show();
			$j('#submitBtnTable2').show();
		}
	}
	$('progressloading').stopWaiting();
}
//EHN : Material Request 버튼누를때 호출된다.
function setMaterialRequest(parts, seq, qty, sc) {

	if (_l.u.isChinaRegion){
		if(checkEngineerForRepairParts()==false) return;
	}
	
	var url =urlPatternGZIP;
	var compay = _l.u.c_SEA;
	var ext_user = _l.u.UserId;
	var ascCode = _l.ASC_CODE;
	var account = _l.u.AccountCode;
	var ireq_date = _l.toDate;
	var iengineer = _l.ENGINEER;
	var IASC_JOB_NO = $j("#ASC_JOB_NO").val();
	var refno2 = _l.ObjectId;
	var ireq_type = '02';
	var i_remark = $j("#partsTableBody input[name='REQUEST_COMMENT']").get(sc).value;
	
	if (_l.u.isChinaRegion && isNewChina ){
		var branchStockAsc = false;
		var useEngineerStock = true;
		var isASCHeadUser = _l.u.isASCHeadUser;
		
		if(ascCode == '0002300589' || ascCode == '0006083917') {
			branchStockAsc = true;
		}
		if(branchStockAsc){
			useEngineerStock = false;//useBranchStock 
		}
		else if(isASCHeadUser 
			&& ascCode == account
		){
			useEngineerStock = true;
		}else{
			useEngineerStock = false;//useBranchStock
		}
		if(!useEngineerStock) {
			ireq_type = '03';
		}
	}
	
	var param = "cmd=MaterialRequestCmd&Company=" + compay + "&ext_user=" + ext_user + "&ascCode=" + ascCode + "&account=" + account + 
						"&ireq_date=" + ireq_date + "&ireq_type="+ireq_type+"&iengineer=" + iengineer + "&IASC_JOB_NO=" + IASC_JOB_NO + 
						"&refno2=" + refno2 + "&ref_item=" + seq + "&i_material=" + parts + "&i_req_qty=" + qty + "&i_remark=" + i_remark;
	$j.ajax({
		type : 'post',
		dataType : 'json',
		async : false,
		url : url,
		data : param,
		success : function(data) {
			if(data.success){
				if(_l.u.isChinaRegion){
					alert(_l.r.m.SAVE);
				}else{//if(isChinaRegion){
					alert("success");
				}//if(isChinaRegion){
				refreshPartsList();
			} else {
				alert(data.returnMessage);
			}
		},
		error : function(jqXHR, textStatus) {
			alert(data.returnMessage);
		}
	});
}

/**
 * EHN21 : Chrome 브라우저 등 에서 input 필드에서 enter key 입력 후 submit 방지
 *         keyPress, keyDown, keyUp 이벤트가 정의 되지 않은 필드에서 enter key 제어
 */
function preventInputEnter() {
	var inputs = $j('#detailForm input[type=text]');
	for (var i = 0 ; i < inputs.length ; i++) {
		if (typeof $j(inputs[i]).attr('onKeyPress') == 'undefined' && typeof $j(inputs[i]).attr('onKeyUp') == 'undefined' && typeof $j(inputs[i]).attr('onKeyDown') == 'undefined') {
			$j(inputs[i]).on('keypress keydown keyup', function() {
				if (event.keyCode=='13') event.returnValue = false;
			});
		}
	}
}

function getUsedPartsCheck(savedFlag) {
	try{
		var url = urlPatternGZIP;
		var data = "cmd=SOPartsCheckCmd&COMPANY=" + _l.u.c + "&OBJECT_ID=" + _l.ObjectId;
	
		$j.ajax({
			type : "POST",
			async : true, 
			url : url,
			data : data,
			success : function(data) {
				if (data.success) {
					if(data.ptDataList != null && data.ptDataList.length > 0){
						//$('tdUClsButton').style.display= 'block';
						$('UCLS_PRINT').style.display= '';
				        if(savedFlag && confirm("Print U-Class Label?")){
				            openUClassPrintPop(_l.ObjectId);
				        }
					}
				} else {
					//$('tdUClsButton').style.display= 'none';
					$('UCLS_PRINT').style.display= 'none';
				}
			},
			error : function(jqXHR, textStatus) {
				if(savedFlag)
					callDetail();
			},
			dataType : 'json'
		});
	}catch(e){
		if(savedFlag)
        	callDetail();
	}
}

function openUClassPrintPop(soNo) 
{
	var frm = $('tempForm');
	var w = window
	.open(
			"",
			"UClsPrintPop",
			'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=420,height=600');
    frm.action="/pc/collection/PrintUClsLabelShipt.jsp?ewpFlag="+_l.ewpTargetFlag;
    frm.target='UClsPrintPop';
    $('tempForm').gi_material.value = soNo;
    frm.submit();   
	
}

function openSkpBulletin(){
	try{
		if(_l.skpContentIds != null && _l.skpContentIds != "" && _l.skpContentIds.split('|').length > 0)
		{
			var contId =  _l.skpContentIds.split('|');
			var model =  _l.skpModels.split('|');
			for(var z=0; z<_l.skpContentIds.split('|').length;z++){
				var url = '/common/KnowledgeModelBulletinPopup.jsp?modelCode='+model[z]+"&contentId="+contId[z];
				var posTop = 150 + z*50;
				var posLeft = 150 + z*50;
				w = window.open(
										url,
										"",
										'toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top='+posTop+',left='+posLeft+',width=1000,height=600');
						w.focus();
			}
		}
	}catch(e){}
}

function getTodayDate() {
	var curDate = new Date();
	var year = curDate.getFullYear();
	var month = "" + (curDate.getMonth() + 1);
	var day = "" + curDate.getDate();
	
	if (month.length == 1) month = "0" + month;
	if (day.length == 1) day = "0" + day;
	var tmp = "" + year + month + day;
	
	return tmp;
}

function getCustSymptomOnGD(){
    $('detailForm').cmd.value = 'GetCustSymptOnGDCmd';
    AjaxSyncRequest(urlPattern,'detailForm', setCustSymptomOnGD);
}

function setCustSymptomOnGD(response) {
    try {
        var jsonObj = eval('('+response.responseText+')');
        var formObj = $('runGDForm');
        if(!gdParamEncript) {
        	formObj = $('formGDActor');
        }
        formObj.GD_CUST_SYMP.value = "";
        
        if (jsonObj.success) {
        	formObj.GD_CUST_SYMP.value = jsonObj.EV_CUST_SYMP;
        }
    } catch (e) {
//    	$('formGDActor').GD_CUST_SYMP.value = "";
    }
}

function openQnaCodeSearchPop() {
	
	var url = "";
	var w = window
			.open(
					url,
					"qnaCodeSearch_popup",
					'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=200,width=800,height=530');
	w.focus();

	var formObj = $('tempForm');
	
	formObj.action = '/svctracking/common/SVCPopQnASearch.jsp';
