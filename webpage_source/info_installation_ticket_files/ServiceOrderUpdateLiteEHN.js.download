function isHHPProductForMPTS(){
	var mptsPrdCodeList = _l.r.c.MPTS_PRD_CODE_LIST.evalJSON();
	var svcProd = $("SVC_PRCD").value;
	if(_l.useHrPrdCodeMPTS){
		svcProd = $('HQ_SVC_PRCD').value;
	}
	var isHHPProduct = false;
	for(var i=0; i<mptsPrdCodeList.length; i++){
		if(svcProd == mptsPrdCodeList[i].codeId){
			isHHPProduct = true;
			break;
		}
	}
	
	return isHHPProduct;
}

function getUnNoFromGMESAsync(imei) {
	var unNoFromGMES = "";
	var paramMap = {};
	paramMap.TYPE = "I";
	paramMap.SERIAL_NO = imei;
	paramMap.HHPYN = "Y";
	$('progressloading').startWaiting();
	
	$j.ajax({
		type : 'post',
		dataType : 'json',
		async : false,
		url : '/svctracking/svcorder/modelBySerialByGMES2ForNonHHP.gspn',
		data : paramMap,
		success : function(data) {
			if (data && data.unNo) {
				unNoFromGMES = data.unNo;
			}else{
				unNoFromGMES = "";
			}
		},
		error : function(jqXHR, textStatus) {
			// console.log(textStatus);
		}
	});		
	$('progressloading').stopWaiting();
	
	return unNoFromGMES;
}

