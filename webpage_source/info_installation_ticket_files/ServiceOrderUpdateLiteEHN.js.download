// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim Activation
// 수정일 : 2015.04.28
// 수정자 : 채보람 (로젠 솔루션)
// 내 용 : IMEI Tracker I/F
function checkIMEITracker(){
	var cssFlag = $j("#tableBOSBtn").css("display");

	if(cssFlag == "none"){
		_l.imeiTrackerActDate = "";
		return;
	}
	
	$('progressloading').startWaiting();

	imeiTrackerInit();
	
	clearForm("frm");
	insertValue("frm", "imei", $j("#IMEI").val());
	insertValue("frm", "cmd", "SDSIGSPNServiceCmd");
	
	AjaxSyncRequest(urlPattern, "frm", setSDSIGSPNService);
}

function setSDSIGSPNService(response){
	$('progressloading').stopWaiting();
	
	try{
		var jsonObjSDSIGSPNService = eval('('+response.responseText+')');
		
		if(jsonObjSDSIGSPNService.success && jsonObjSDSIGSPNService.EV_RET_CODE == "S"){
			if(jsonObjSDSIGSPNService.responseStatus == 1){
				_l.imeiTrackerActDate = toDisplayScreenDate(jsonObjSDSIGSPNService.activationDate, ".", _l.u.DateFormat2);
				_l.imeiTrackerImei = jsonObjSDSIGSPNService.imei;
				_l.imeiTrackerMobileNo = jsonObjSDSIGSPNService.mobileNo;
				_l.imeiTrackerOperator = jsonObjSDSIGSPNService.operator;
				_l.IMEITrackerActDtFlag = true;
				
				$j("#ACT_DATE").val(jsonObjSDSIGSPNService.activationDate);
				$j("#ACT_MOBILE_NO").val(jsonObjSDSIGSPNService.mobileNo);
				$j("#SVC_PROVIDER").val(jsonObjSDSIGSPNService.operator);
				
				var SERVICE_TYPE = $("SERVICE_TYPE").value;
				// START : C19050007571 [GSPN] Purchase date editable in SVC type KT for Network Product
				var svcProd = $('SVC_PRCD').value.substring(0, 3);
				var serviceTypeNotNeedPD = ((SERVICE_TYPE == "KT" && svcProd != "NEX") || SERVICE_TYPE == "SR");
				// END   : C19050007571 [GSPN] Purchase date editable in SVC type KT for Network Product
				
				if(!serviceTypeNotNeedPD){
					if(_l.imeiTrackerActDate != "" && jsonObjSDSIGSPNService.activationDate != "00000000"){
						$j("#PURCHASE_DATE").val(_l.imeiTrackerActDate);
					}
				}
			}else if(jsonObjSDSIGSPNService.responseStatus == 2){
			}else if(jsonObjSDSIGSPNService.responseStatus == 3){
			}else if(jsonObjSDSIGSPNService.responseStatus == 4){
				alert(_l.u.WEB_MSG_PREFIX + "IMEI Tracker Error(3) : Time out Error. Try again.");
			}else if(jsonObjSDSIGSPNService.responseStatus == 0){
				_l.IMEITrackerActDtFlag = true;
			}
		}else{
			alert(_l.u.WEB_MSG_PREFIX + "IMEI Tracker did not Interface. Try again.");
		}
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + "IMEI Tracker did not Interface. Try again.");
	}
}

function imeiTrackerInit(){
	_l.imeiTrackerActDate = "";
	_l.imeiTrackerImei = "";
	_l.imeiTrackerMobileNo = "";
	_l.imeiTrackerOperator = "";
	_l.IMEITrackerActDtFlag = false;
	
	$j("#ACT_DATE").val("");
	$j("#ACT_MOBILE_NO").val("");
	$j("#SVC_PROVIDER").val("");	
	$j("#PURCHASE_DATE").val(toDisplayScreenDate("00000000", ".", _l.u.DateFormat2));
}

function toDisplayScreenDate(dbdate, gubun, scrFormat) {
	var RetDay = "";
	
	if(scrFormat.indexOf(".") > 0){
		gubun = ".";
	}
	else if(scrFormat.indexOf("/") > 0){
		gubun = "/";
	}
	else if(scrFormat.indexOf("-") > 0){
		gubun = "-";
	}
	
	var userFormat = removeChar(scrFormat.toUpperCase(),".");
	userFormat = removeChar(userFormat.toUpperCase(),"/");
	userFormat = removeChar(userFormat.toUpperCase(),"-");

   	if( removeChar(dbdate, gubun).length != 8) return;

	Year = removeChar(dbdate,gubun).substring(0,4);
	MM = removeChar(dbdate,gubun).substring(4,6);
	DD  = removeChar(dbdate,gubun).substring(6,8);

	if( userFormat == "YYYYMMDD" ){
		RetDay = Year+gubun+MM+gubun+DD ;
	}else if( userFormat == "MMDDYYYY" ){
		RetDay = MM+gubun+DD+gubun+Year ;
	}else if( userFormat == "DDMMYYYY" ){
		RetDay = DD+gubun+MM+gubun+Year ;
	}

	return RetDay ;
}

function readSIM(action) {
	 var url = "";
	    w = window.open(url, "ServiceOrderUpdateSimActPopup", 'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=150,left=300,width=700,height=300');
	    w.focus();
	    
	    clearForm("frm");
		insertValue("frm", "objectId", _l.ObjectId);
		insertValue("frm", "isIndia", _l.isIndia);
		insertValue("frm", "isHHPIndia", _l.isHHPIndia);
		
	    var obj = $('frm');
	    obj.action = action;
	    obj.method = 'post';
	    obj.target = 'ServiceOrderUpdateSimActPopup';
	    obj.submit(); 
}

function setPurDate(purDate, reason){
	// 현재 Status 가 ST035, ST040 일 경우 BOS 첨부 불가 로직 강화
	if(_l.CurrStatus == "ST035" || _l.CurrStatus == "ST040"){
		alert(_l.u.WEB_MSG_PREFIX + "BOS attachment is possible before [ Repair Complete ] status.");
		return;
	}
	
	$j("#PURCHASE_DATE").val(purDate);
	
	$j("#BOS_FLAG").val("X");
	$j("#PURCHASE_DT").val(converttoDBFormat(purDate, _l.u.DateFormat2));
	$j("#BOS_REASON").val(reason);
	checkWarranty = true;
}

function searchSimInfo(){
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId);
	insertValue("frm", "cmd", "ZifGspnSvcSimActInfoCmd");
	
	AjaxSyncRequest(urlPattern, "frm", setSearchInfo);
}

function setSearchInfo(response){
	$('progressloading').stopWaiting();

	try{
		var serviceTypeFlag = 0;
		
		var simInfojsonObj = eval('('+response.responseText+')');
		
		if(simInfojsonObj.success){
			if(simInfojsonObj.EV_ACT_DATE != "00000000" && simInfojsonObj.EV_ACT_DATE != ""){
				serviceTypeFlag = 1;
			}
			else if((simInfojsonObj.EV_ACT_DATE == "00000000" || simInfojsonObj.EV_ACT_DATE == "") && simInfojsonObj.EV_BOS_FLAG != ""){
				serviceTypeFlag = 2;
			}
						
			if(serviceTypeFlag == 0){
				return;
			}
			
			if(serviceTypeFlag == 1){
				if(_l.SERVICE_TYPE == "RH"){
					activationExistValidate();
				}else{
					if(_l.sawExistExchange &&
							(_l.sawExistExchangeSataus == "SS005" || _l.sawExistExchangeSataus == "SS010")){
						
						activationExistValidate();
					}else{
						_l.sawTabSaveFlag = true;
					}
				}
			}else if(serviceTypeFlag == 2){
				if(_l.SERVICE_TYPE == "RH"){
					activationNotExistValidate();
				}else{
					if(_l.sawExistExchange &&
							(_l.sawExistExchangeSataus == "SS005" || _l.sawExistExchangeSataus == "SS010")){
						
						activationNotExistValidate();
					}else{
						_l.sawTabSaveFlag = true;
					}
				}
			}
			
		}
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
	}
}

function changeDistanceSlab(serviceType) {
	$j("#DISTANCE option").remove();
	
	if(serviceType == "IH") { var distanceList = _l.DISTANCE_LK_IH.evalJSON();} 
	else {var distanceList = _l.DISTANCE_SAARC.evalJSON();}
	
	var distance = $("DISTANCE");
	distance.append(new Option("- - - - -",""));
	
	if(distanceList != null){
		for(var j=0; j<distanceList.length; j++){
			var op = new Option();
			op.value = distanceList[j].codeId;
			op.text = distanceList[j].description;
			distance.options.add(op);
		}
	}
}

function changeModel(){
	$j("#PURCHASE_DATE").datepicker(defaultDatePickerOption);
	
	if(isProdHHPIndia()){
		$j("#PURCHASE_DATE").val("");
		$j("#PURCHASE_DATE").parent().find("img").remove();
		$j("#PURCHASE_DATE").datepicker("destroy");
// $j("#PURCHASE_DATE").attr("class", "inputRO");
// $j("#PURCHASE_DATE").css("width", "70px");
		$j("#PURCHASE_DATE").attr("readonly", "readonly");
		
		changeBOSbtn(true);
	}else{
		// $j("#PURCHASE_DATE").datepicker(defaultDatePickerOption);
// $j("#PURCHASE_DATE").attr("class", "input_date");
		$j("#PURCHASE_DATE").attr("readonly", false);
		
		changeBOSbtn(false);
	}
}

function initSearchSim(){
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId);
	insertValue("frm", "cmd", "ZifGspnSvcSimActInfoCmd");
	
	AjaxSyncRequest(urlPattern, "frm", setinitSearchSim);
}

function setinitSearchSim(response){
	$('progressloading').stopWaiting();
	
	try{
		var initSimJsonObj = eval('('+response.responseText+')');
		
		// BOS 첨부 후 저장 했는지 여부 판단 하여 첨부만 했을 경우 선 삭제
		// EV_BOS_FLAG -> 첨부 후 저장 여부
		// EV_ATTACH_FLAG -> 첨부 파일 존재 여부
		if(initSimJsonObj.success){
			_l.simBOSFlag = initSimJsonObj.EV_BOS_FLAG;
			$j("#BOS_FLAG").val("");
			
			if(initSimJsonObj.EV_ACT_DATE != "" && initSimJsonObj.EV_ACT_DATE != "00000000"){
				$j("#ACT_DATE").val(initSimJsonObj.EV_ACT_DATE);
				$j("#ACT_MOBILE_NO").val(initSimJsonObj.EV_ACT_MOBILE_NO);
				$j("#SVC_PROVIDER").val(initSimJsonObj.EV_SVC_PROVIDER);
			}

			if(initSimJsonObj.EV_BOS_FLAG == "X" && initSimJsonObj.EV_ATTACH_FLAG == "Y"){
				$j("#BOS_FLAG").val("X");
				$j("#PURCHASE_DT").val(initSimJsonObj.EV_PURCHASE_DT);
				$j("#BOS_REASON").val(initSimJsonObj.EV_BOS_REASON);
			}else if(initSimJsonObj.EV_BOS_FLAG != "X" && initSimJsonObj.EV_ATTACH_FLAG != "Y"){
				if(_l.CurrStatus == "ST035" || _l.CurrStatus == "ST040"){
					return;
				}
			}
			
			if(initSimJsonObj.EV_BOS_FLAG == "" && initSimJsonObj.EV_ATTACH_FLAG == "Y"){
				initDeleteBOS();
				return;
			}

			changeBOSbtn(true);
			displayBosAtt(); // bosAttachment.js
		}
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
	}
	
	if(_l.SERVICE_TYPE == "SR"){
		$j("#tableBOSBtn").remove();
	}
}

function initDeleteBOS(){
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "ObjectId", _l.ObjectId);
	insertValue("frm", "cmd", "AttachFileBOSDeleteCmd");
	
	AjaxSyncRequest(urlPattern, "frm", setinitDeleteBOS);
}

function setinitDeleteBOS(response){
	$('progressloading').stopWaiting();
	
	try{
		var initDelBOSJsonObj = eval('('+response.responseText+')');

		_l.bosAttachFlag = "";
		
		if(initDelBOSJsonObj.success){
			$j("#BOS_FLAG").val("");
			$j("#PURCHASE_DT").val("");
			$j("#BOS_REASON").val("");
			
			$j('#bosAttContentTableBody').empty();
			changeBOSbtn(true);
		}
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
	}
}

function displayBosDelAttIndo(){
	if($j("#BOS_FLAG").val() == "X"){
		alert(_l.u.WEB_MSG_PREFIX + "The actual deletion will be deleted after saving !!");
	}else{
		alert(_l.u.WEB_MSG_PREFIX + "Successfully Deleted");
	}
	
	$j("#BOS_FLAG").val("D");
	$j('#bosAttContentTableBody').empty();
	$j("#tableBOSBtn").css("display", "block");
	$j("#PURCHASE_DATE").val(toDisplayScreenDate("00000000", ".", _l.u.DateFormat2));
	checkWarranty = true;
	_l.bosAttachFlag = "Y";
}

