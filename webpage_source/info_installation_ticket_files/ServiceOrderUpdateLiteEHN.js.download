			}else{
				ret = (val != subtype);
			}
			$j(this).prop("disabled", ret);
	    });
*/
		if("AD" == svctype || _l.ewSmcFlag == "X"){
			//selectADSub(subtype,'');
			$j('#SUB_SVC_TYPE3 option').prop("disabled", false);
			if(_l.blockSubtypeSC){
				$j("#SUB_SVC_TYPE3").find("option:[value=SC]").remove();
			}
