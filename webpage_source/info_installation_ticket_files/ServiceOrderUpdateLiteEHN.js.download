function changeCancelReason() {
	$('progressloading').startWaiting();
	$('frmStatusReasonAfterCancel').cmd.value = 'ServiceOrderDirectCmd';
	AjaxRequest(urlPatternGZIP, 'frmStatusReasonAfterCancel',
			changeCancelReasonCallBack);
}

function changeCancelReasonCallBack(response) {
	try {
		var jsonObj = response.responseText.evalJSON();
		if (jsonObj.success) {
			$j("#btnChangeCancelReason").hide();
			$("REASON").value = "HC030";
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.SAVE);
		} else {
			if (jsonObj.error) {
				cfExceptionPop(jsonObj);
			}
			if (jsonObj.returnMessage)
				alert(_l.u.SAP_MSG_PREFIX + jsonObj.returnMessage);
		}
	} catch (e) {
	}
	$('progressloading').stopWaiting();
}

