	// 제 목 : 인도 Demand HHP Warranty Verification Process Change with Sim
	// Activation
	// 수정일 : 2015.04.28
	// 수정자 : 채보람 (로젠 솔루션)
	// 내 용 : IMEI Tracker I/F
	if(_l.isIndia){
		if(_l.isHHPIndia){
			// Purchase Date 가 사라지고 BOS와 Activation Date가 존재 할 때 다시 체크하도록 로직 강화.
			var SERVICE_TYPE = $("SERVICE_TYPE").value;
			// START : C19050007571 [GSPN] Purchase date editable in SVC type KT for Network Product
			var svcProd = $('SVC_PRCD').value.substring(0, 3);
			var serviceTypeNotNeedPD = ((SERVICE_TYPE == "KT" && svcProd != "NEX")|| SERVICE_TYPE == "SR");
			// END   : C19050007571 [GSPN] Purchase date editable in SVC type KT for Network Product
			
			// Service Type 이 KT, SR 일경우는 제외
			if(!serviceTypeNotNeedPD){
				var isDOPExist = $j("#PURCHASE_DATE").val() != "" &&
									$j("#PURCHASE_DATE").val() != toDisplayScreenDate("00000000", ".", _l.u.DateFormat2) &&
									$j("#PURCHASE_DATE").val() != "00000000";
				
				if($j("#BOS_FLAG").val() == "X" && !isDOPExist){
					alert(_l.u.WEB_MSG_PREFIX + "Purchase date is not exist. Please reload screen.");
					return;
				}
				
				if($j("#ACT_DATE").val() != "" && !isDOPExist){
					alert(_l.u.WEB_MSG_PREFIX + "Please check Warranty again.");
					return;
				}
			}
			
			// 수리 완성 후(ST035) SAW 로직 추가
			if($j("#STATUS").val() == "ST035"){
				searchSimInfo();
				
				if(_l.sawTabSaveFlag == false){
					// alert("Cannot Save as SAW Tab !!");
					return;
				}
			}
		}
		
