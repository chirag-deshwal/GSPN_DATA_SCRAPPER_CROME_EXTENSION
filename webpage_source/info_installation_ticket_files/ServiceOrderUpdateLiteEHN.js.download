function changeRepairQCode(qcode, code){
	$('progressloading').startWaiting();
	var filteredDataLists = [];
	var selectedQCode = qcode;
	
	var length = jsonObjIrisRepair.repairList.length;
	for(var i = 0; i < length ; i++){
		var obj = jsonObjIrisRepair.repairList[i];
