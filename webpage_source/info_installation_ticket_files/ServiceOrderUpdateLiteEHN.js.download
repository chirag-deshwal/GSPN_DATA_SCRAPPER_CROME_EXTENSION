/**
 * 파일 삭제/추가시 파일목록 다시 그리기 위해 호출됨.
 */
function AttachListSearch() {
	$('tempForm').cmd.value = 'ServiceOrderAttachListCmd';
	AjaxRequest(urlPatternGZIP, 'tempForm', setFileInfo);
}

function getDocTypeText(docType) {
	var docTypeTxt = docType;
	var selObj = $('attach_doc_type');
	var isSelected = false;
	for ( var i = 0, len = selObj.options.length; i < len; i++) {
		if (docType == selObj.options[i].value) {
			docTypeTxt = selObj.options[i].text;
			isSelected = true; 
			break;
		}
	}
	if(!isSelected){
		var selObjEwp = $('attach_doc_type_ewp');
		for ( var i = 0, len = selObjEwp.options.length; i < len; i++) {
			if (docType == selObjEwp.options[i].value) {
				docTypeTxt = selObjEwp.options[i].text;
				break;
			}
		}
	}
	
	return docTypeTxt;
}

function setFileInfo(response) {// alert(response.responseText);
	$('progressloading').stopWaiting();

	var jsonFile = eval('(' + response.responseText + ')');

	if (jsonFile.success) {
		//china : 중국은 이로직 없지만, 별상관 없음.
		$j("#attachTable").children().show();
			
		
		/** TBody 객체 ID */
		var tbodyObj = $('attachTableBody');
		/** 이전 Grid 객체에 노드가 있는 경우 새로 갱신하기 위해 삭제한다. */
		clearGridJsonObject(tbodyObj);

		var tdTag = null;
		var aTag = null;
		var inputTag = null;
		var length = jsonFile.etFileInfoList.length;

		// EHN17
		$j('#fileCnt').html(length);

		for ( var i = 0; i < length; i++) {
			var obj = jsonFile.etFileInfoList[i];

			var trTag = document.createElement("tr");

			/** NO */
			tdTag = new Element("td", {
				"class" : "td_ac"
			});
			tdTag.update(i + 1);
			trTag.appendChild(tdTag);

			/** Doc Type */
			var docTypeDesc = getDocTypeText(obj.description);
			var docTypeCode = obj.description;
			tdTag = new Element("td", {
				"class" : "td_ac"
			});
			tdTag.update(docTypeDesc);

			var hiddenDocType = new Element("input", {
				"type" : "hidden",
				"name" : "docTypeCode",
				"value" : docTypeCode
			});
			tdTag.appendChild(hiddenDocType);

			var hiddenFileNameOrg = new Element("input", {
				"type" : "hidden",
				"name" : "file_name_org",
				"value" : obj.filename
			});
			tdTag.appendChild(hiddenFileNameOrg);

			trTag.appendChild(tdTag);

			/** File Type */
			tdTag = new Element("td", {
				"class" : "td_ac"
			});
			tdTag.update(obj.filetype);
			trTag.appendChild(tdTag);

			/** File Name */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			aTag = document.createElement("a");
			aTag.href = 'javascript:void(0)';
			aTag.onclick = (function(fileobjkey, filename, fileSize) {
				return function() {
					downFile(fileobjkey, filename, fileSize);
				}
			})(obj.fileobjkey, obj.filename, obj.file_size);
			aTag.appendChild(document.createTextNode(obj.filename));
			tdTag.appendChild(aTag);
			trTag.appendChild(tdTag);

			//china : 중국만 있는 로직이지만, 그대로 둬도 문제 안되므로, 그냥둠. 되도록 분기문을 줄이고 싶음. 
			//저장시 PS 티겟을 ST035,40으로 저장시 첨부파일명이 PS 글자가 없으면 저장 못하도록함.
			if(obj.filename.toUpperCase().indexOf("PS") != -1){
				psAttached = true;
			}
			
			var size = obj.file_size;
			var sizeInt = new Number(size);// parseInt(obj.file_size,10);

			/** Size */
			tdTag = new Element("td", {
				"class" : "td_ac"
			});
			 tdTag.update(bytesToSize(sizeInt));
			trTag.appendChild(tdTag);

			/** Date */
			tdTag = new Element("td", {
				"class" : "td_ac"
			});
			tdTag.update(obj.created_dt + " " + obj.created_tm);
			trTag.appendChild(tdTag);

			/** delete */
			tdTag = document.createElement("td");
			tdTag.className = "td_ac";
			
			//china : 중국은 if(!blockSaveFlag){ 경우만 삭제 가능. 
			var canDeleteFile = true;
			if(_l.u.isChinaRegion){
				canDeleteFile = !_l.blockSaveFlag;
			}
			if(_l.isWerApproved){
				canDeleteFile = false;
			}
			if(canDeleteFile){
				var aTag1 = document.createElement("a");
				aTag1.href = 'javascript:void(0)';
				var imgTag = document.createElement("img");
				imgTag.src = '/img/ico_delete.gif';
				imgTag.width = '15';
				imgTag.height = '13';
				imgTag.onclick = (function(fileobjkey) {
					return function() {
						deleteAttach(fileobjkey);
					}
				})(obj.fileobjkey);
				aTag1.appendChild(imgTag);
				tdTag.appendChild(aTag1);
			}
			trTag.appendChild(tdTag);

			tbodyObj.appendChild(trTag);
		}

	} else {
		if (jsonFile.returnMessage)
			alert(_l.u.SAP_MSG_PREFIX + _l.r.m.ERROR + jsonFile.returnMessage);
		else
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.ERROR + ". No Result!!");
	}
}
//EHN 파일 사이즈 mb로 보여달라는 요구사항 ksy2702.kwon
function bytesToSize(bytes) {
    return bytes = (bytes/1048576).toFixed(2);
}

function downFile(FILEOBJKEY, fileName, fileSize) {
	var obj = $('tempForm');
	obj.cmd.value = 'AttachFileDownloadSvcCmd';
	obj.IV_OBJKEY.value = FILEOBJKEY;
	obj.fileSize.value = fileSize;
	obj.file_name.value = encodeURIComponent(fileName);
	obj.action = urlPattern;
	obj.method = 'post';
	obj.target = 'ifr_attach';
	obj.submit();
}

function deleteAttach(FILEOBJKEY) {
	if (!canDeleteFile()) {
		return;
	}

	if (confirm(_l.u.WEB_MSG_PREFIX +_l.r.m.CONF_DELETE)) {
		$('tempForm').cmd.value = 'AttachFileDeleteSvcCmd';
		$('tempForm').IV_OBJKEY.value = FILEOBJKEY;
		AjaxRequest(urlPatternGZIP, 'tempForm', afterAttachDelete);
		$('progressloading').startWaiting();
		$('progressloading').style.height = self.document.body.scrollHeight;
	}
}

function afterAttachDelete(response) {
	$('progressloading').stopWaiting();
	try {
		var jsonFileDel = eval('(' + response.responseText + ')');
		if (jsonFileDel.success) {
			alert(_l.u.WEB_MSG_PREFIX + 'success');
			AttachListSearch();
		} else {
			if (jsonFileDel.error) {
				cfExceptionPop(jsonFileDel);
			}
			if (jsonFileDel.returnMessage)
				alert(_l.u.SAP_MSG_PREFIX + "Error. " + jsonFileDel.returnMessage);
		}
	} catch (e) {
	}
}

function canDeleteFile() {
	var valid = true;

	if (_l.HHPAccessoryNoSerial) {

		var fileExist = $('attachTableBody').rows.length > 0;
		var status = _l.currStatus;
		var svcProd = _l.SVC_PRCD;
		var wtyTerm = _l.IN_OUT_WTY;

		valid = !(fileExist && svcProd == "HHP03" && status == "ST035" && wtyTerm == "LP");
		if (!valid) {
			alert(_l.u.WEB_MSG_PREFIX + "You are not allowed to delete the attachment. \nIn case of Accessory purchased separately, uploading of accessory Invoice copy is madatory.");
		}

	}// if(HHPAccessoryNoSerial){
	
	if(isMeaUser){
		if(_l.currStatus == "ST040" && _l.isWtyClaimed){
			valid = false;
			alert(_l.u.WEB_MSG_PREFIX + "You are not allowed to delete the attachment. Warranty has already been created.");
		}
	}
	
	return valid;
}

/**
 * button event...
 */
function goList() {
	try {
		parent.setBackForward();
	} catch (e) {
	}// jsonTemp

	if (_l.jspName == "/report/kpi/QualityOfService.jsp") {
		var formObj = $('tempForm');
		formObj.action = '/report/kpi/QualityOfService.jsp?frYear=' + _l.frYear
				+ '&frMonth=' + _l.frMonth + '&toYear=' + _l.toYear
				+ '&toMonth=' + _l.toMonth;
		formObj.target = '_self';
		formObj.submit();
	}else if(_l.jspName=="/svctracking/svcorder/ServiceOrderListBatch.jsp"){
		var formObj=$('tempForm');
		formObj.action='/svctracking/svcorder/ServiceOrderListBatch.jsp';
		formObj.target='_self';
		formObj.submit();
	
	}
	// else if ("B" == _l.u.CenterType){
		// var formObj = $('tempForm');
		// formObj.action = '/svctracking/svcorder/ServiceOrderListMini.jsp';
		// formObj.target = '_self';
		// formObj.submit();
	// }
	else {
		var formObj = $('tempForm');
		formObj.fromListButton.value = "Y";
		formObj.action = '/svctracking/lite/ServiceOrderListLite.jsp';
		formObj.target = '_self';
		formObj.submit();
	}
}

function callDetail() {
	$('progressloading').startWaiting();
	$('progressloading').style.height = self.document.body.scrollHeight;
	if(_l.u.c == 'C370'){
		$('tempForm').CicCorpCode.value = _l.u.c;
	}
	$('tempForm').target = "_self";
	$('tempForm').action = urlPatternGZIP + "?UI="+_l.ehnUI+"&currTabId="+currTabId;
	$('tempForm').cmd.value = 'ZifGspnSvcMainLDCmd';
	$('tempForm').submit();
}

function callModifyPending() {
	$('progressloading').startWaiting();
	$('progressloading').style.height = self.document.body.scrollHeight;
	$('STATUS').value="ST030";
	$("reasonCodeTD").innerHTML = "&nbsp;";// 초기화
	/** Select 박스 ID */
	var selectObj = new Element("select", {
		'name' : 'REASON',
		'id' : 'REASON',
		'class' : 'select',
		'style' : 'width:98%'
	});
	var newOption = document.createElement('option');
	newOption.appendChild(document.createTextNode("SAW Requested." + "[HPZ99]"));
	newOption.setAttribute("value", "HPZ99");
	newOption.selected = true;
	selectObj.appendChild(newOption);
	$("reasonCodeTD").appendChild(selectObj);
	saveServiceOrder();
}

/**
 * General information
 */
function initGeneralTab() {
	$('progressloading').startWaiting();
	
	
	$j("#divGeneral").load(urlPatternGZIP, {
		cmd : 'ZifGspnSvcGeneralLDCmd',
		objectId : _l.ObjectId,
		ascCode : _l.ASC_CODE,
		tab : '/svctracking/lite/ServiceOrderUpdateGenInfo.jsp'
	}, function() {
			//china version intergration 2016/08/11 js1.baek
			if(_l.u.isChinaRegion){
				$j('[name=B2B_SVC]').attr('disabled',true);	
			}else{
				if(_l.autoBill != "Y" && !_l.isQuotationUser){
					$('ASC_JOB_NO').className = "inputIDS";
				}
				
				if(_l.u.c != "C370") getCPList();
				if (_l.u.c == "C310" || _l.u.c == "C370") {
					$('dataorigin').writeAttribute("colspan", "3");
					$('cpdealer').hide();
					$('cpdealerin').hide();
				}// if(_l.u.c == "C310"){
				
				if(_l.isPSApp) {
					$("CC_CODE").className="inputRO";
					$("CC_CODE").readOnly==true;
					$("CC_CODE_ICON").style.display="none";
				}
			}
			$('progressloading').stopWaiting();
			toggleOptionTab("divGeneral");
						
	});
}

function searchCollectionPointPop() {
