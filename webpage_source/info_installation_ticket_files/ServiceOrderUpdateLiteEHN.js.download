/**
 * India Demand Panel Water logged. 2017/03/30. j.peter.kim
 * check ticket must have approved SAW (Panel Water logged (SIEL), SRC81)
 * Condition : 
 *   - current status : Pending
 *   - next status : Repair Complete
 *   - In/Out Warranty : 'LP'
 *   - Symtom Code in ["T9C", "TM8"]
 *   - Service Product in ["CTV04","CTV05","CTV06","CTV07","CTV08","CTV09","CTV10","CTV11","CTV12","CTV13","CTV14","CTV15", "CTV16"]
 *   - Part code start with "BN07" or "BN95"
 */
function checkPanelWaterLoggedTicket() {

    // current status is ST030 (Pending)
    if ("ST030" != $j('#currStatus').val()) {
        return false;
    }

    // next status is ST035 (Repair Completed)
    if ("ST035" != $j('#STATUS').val()) {
        return false;
    }

    // in warranty
    if ("LP" != $j('#wtyInOut').val()) {
        return false;
    }

    // Symtom Code
    var symtomCodeArray = ["T9C", "TM8"];
    if ($j.inArray($j('#IRIS_SYMPT').val(), symtomCodeArray) == -1) {
        return false;
    }

    // service product in ["CTV04","CTV05","CTV06","CTV07","CTV08","CTV09","CTV10","CTV11","CTV12","CTV13","CTV14","CTV15", "CTV16"]
    var svcProductArray = ["CTV04","CTV05","CTV06","CTV07","CTV08","CTV09","CTV10","CTV11","CTV12","CTV13","CTV14","CTV15", "CTV16"];
    if ($j.inArray($j('#SVC_PRCD').val(), svcProductArray) == -1) {
        return false;
    }

    // part code
    var isValidPart = false;
    var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');

    for (var i=0 ; i < partCodes.length ; i++) {
        var partCode = $j.trim($j(partCodes[0]).val());
        if (partCode.substring(0, 4) == "BN07" || partCode.substring(0, 4) == "BN95") {
            isValidPart = true;
            break;
        }
    }

    if (!isValidPart) {
        return false;
    }

    return true;

}
function isOverseaProductCheck(){
	$("progressloading").startWaiting();
	
	clearForm("frm");
	insertValue("frm", "cmd", "OverseaProductCheckCmd");
	insertValue("frm", "IV_COMPANY", _l.u.c);
	insertValue("frm", "IV_COUNTRY", _l.u.CountryCd);
	insertValue("frm", "IV_LOCAL_PRD", $("SVC_PRCD").value);
	insertValue("frm", "IV_MODEL", $("MODEL").value);
	insertValue("frm", "IV_SERIAL_NO", $j("#SERIAL_NO").val());
	
	AjaxRequest(urlPattern,'frm', setOverseaProductCheckCmdJsonObject);
}

function setOverseaProductCheckCmdJsonObject (response) {
	$('progressloading').stopWaiting();
	try {			
		var jsonObjOverseaProductCheck = eval('('+response.responseText+')');
			
			if (jsonObjOverseaProductCheck.success) {
				if (jsonObjOverseaProductCheck.isOverseaProduct ){
					setComboValue($('detailForm').WTY_EXCEPTION, "VOID4");
					if($('SALES_COUNTRY').value != "" && _l.ascWtyCountry != $('SALES_COUNTRY').value){
						//global wty
						$('detailForm').WTY_EXCEPTION.disabled = false;
					}else{
						alert(_l.u.WEB_MSG_PREFIX + "Not allowed in warranty due to an Overseas Purchased Product.");
						$('IN_OUT_WTY').value = "OW";
						$('detailForm').WTY_EXCEPTION.disabled = true;
						$('progressloading').stopWaiting(); return;
					}
				}else{
					
				}
			}
	} catch (e) {}
}

/**
 * India Demand. 2017/05/30. j.peter.kim
 * check push message condition
 * condition : 
 *   - next status : Engineer Assigned
 *   - service type in ["IH", "PS", "DM", "II", "SR", "BS"]
 */ 
function checkPushForIndia() {

    // service type in ["IH", "PS", "DM", "II", "SR", "BS"]
    var svcTypeArray = ["IH", "PS", "DM", "II", "SR", "BS"];
    if ($j.inArray($j('#SERVICE_TYPE').val(), svcTypeArray) == -1) {
        return;
    }

    // engineer 
    if (_l.ENGINEER == $j("#ENGINEER").val()) {
        return;
    }

    sendPushForIndia();

}


/**
 * India Demand. 2017/05/30. j.peter.kim
 * send push message to engineer
 * parameter : soNo, engineerCode
 */ 
function sendPushForIndia() {
    
    var url = urlPatternGZIP;
    var data = "cmd=SendPushMessageCmd&soNo=" + _l.ObjectId + "&engineerCode=" + $j("#ENGINEER").val();
    
    $j.ajax({
        type : "POST",
        async : true, /* 비동기 */
        url : url,
        data : data,
        success : function(data) {
            //console.dir(data);
        },
        dataType : 'json'
    });

}
function isTypeWiFi() {
	var flag = false;
	var localSvcPrd = $j('[name=detailForm] #SVC_PRCD').val();
	var wifiPrdCodeList = _l.r.c.WIFI_PRD_CODE.evalJSON();
	
	for(var i=0; i<wifiPrdCodeList.length; i++){
		if(localSvcPrd == wifiPrdCodeList[i].codeId){
			flag = true;
			break;
		}
	}
	return flag;
}

/** U01 Start : 2017.06.27 채보람 서남아 Demand : GST 적용 대상 여부 RFC 호출
 *  ZIF_GSPN_GET_GST_CONFIG_INFO 호출시 GST 대상 여부 리턴 (CorpCode == C550, Country == IN 조건도 포함)
 *	S : GST 대상
 *	E : GST 비대상
**/
function getGSTAuth(){
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "ivAscCode", _l.ASC_CODE);
	insertValue("frm", "ivCompany", _l.u.c);
	insertValue("frm", "ivDate", converttoDBFormat(_l.toDate, _l.u.DateFormat2));
	insertValue("frm", "cmd", "ZifGspnGetGstConfigInfoCmd");
	
	AjaxSyncRequest(urlPattern, "frm", setGSTAuth);
}

function setGSTAuth(response){
	$('progressloading').stopWaiting();
	
	try{
		var gstJsonObj = eval('('+response.responseText+')');
			_l.gstFlag = gstJsonObj.gstFlag;
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + e);
	}
}
/** U01 End   : 2017.06.27 채보람 서남아 Demand : GST 적용 대상 여부 RFC 호출 **/

function changeDefectQCode(qcode, code){
	$('progressloading').startWaiting();
	var filteredDataLists = [];
	var selectedQCode = qcode;
	
	var length = jsonObjIrisDefect.defectList.length;
	for(var i = 0; i < length ; i++){
		var obj = jsonObjIrisDefect.defectList[i];
		if(obj.qcode == selectedQCode ){
			filteredDataLists.push(obj);
		}
	}
	
	jsonObjIrisDefect.filteredDataLists = filteredDataLists;
	
	$j("#IRIS_DEFECT").empty();;// 초기화
	
	$j("#IRIS_DEFECT").append("<option value=''>- " + _l.r.c.LBL_01035 + " -</option>");
	for ( var i = 0; i < jsonObjIrisDefect.filteredDataLists.length; i++) {
		var jcode = jsonObjIrisDefect.filteredDataLists[i].code;
		var jtitle = jsonObjIrisDefect.filteredDataLists[i].codetx;
		var selected = false;
		if (jcode == code) {
			$j("#IRIS_DEFECT").append("<option value='" + jcode + "' selected>" + jcode + "-" + jtitle);
		}else{
			$j("#IRIS_DEFECT").append("<option value='" + jcode + "'>" + jcode + "-" + jtitle);
		}
	}
	$('progressloading').stopWaiting();
}

