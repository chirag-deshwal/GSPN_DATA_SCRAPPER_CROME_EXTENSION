	//isPSApp : MGSPN 을 통한 티겟이므로 기존 중국에서는 절대 참잉 ㅏ님.
	//이제는 사용하게 되므로 아래 로직을 탈수있음.
	if(_l.isPSApp) {
		if(checkStatusMGSPNTicket) {
			var CONSUMER = $j('#CONSUMER').val();
			if( CONSUMER == "" || CONSUMER == _l.dummyUser || CONSUMER == undefined ) {
				alert(_l.u.WEB_MSG_PREFIX + "Customer should be changed.");
				return;
			}
		}
		var UNIT_RECV_DATE = $j("#UNIT_RECV_DATE").val();
		if(UNIT_RECV_DATE == "" || removeDate(UNIT_RECV_DATE) == "00.00.0000") {
			$("detailForm").TODATE.value = _l.toDate;
			$("detailForm").TOTIME.value = _l.toTime;			
		}
	}
	var returnParamMap;	
	if(_l.CurrStatus != 'ST035' && statusCode == 'ST035'){
		if($("IMEI").value != ""){
			
			if($('IMEI').value == "000000000000000" && !isPLCase){
				alert("Please change IMEI first.");
				return;
			}
			
			// MPTS UN IO 를 가져와야 한다
			if(_l.u.isChinaRegion){
					returnParamMap = getIMEIofHHPAsync();
					$("UN_IO").value = returnParamMap.MPTS_UN_NO;
			}else{
					
					if(_l.isWorkingMPTS){
						returnParamMap = getUnNoFromMPTSAsync();
						$("UN_IO").value = returnParamMap.MPTS_UN_NO;
						if($("UN_IO").value == "" || $("UN_IO").value == "-"){
							$("UN_IO").value = getUnNoFromGMESAsync($("IMEI").value);
						}
					}else{
						$("UN_IO").value = getUnNoFromGMESAsync($("IMEI").value);
					}	
					
			}			
		}
	}
	
	//중국날짜 추가 필드는 유익한 기능으로 중국에도 보여줌.
	bindDynamicDateOnTransitStatus(true);
	
	//중극은 MIF 사용안하므로, 글로벌 로직 그대로 유지함.
	//중국은 코드(USE_MIF_CORP,USE_MOBILE_INTERFACE)값이 없어서 useMobileInterface 함수 false 가 되므로 아래로직 안탐.
	$("detailForm").MIF_COMPARE_FLAG.value ="N";
	if (!_l.isExchTicket && _l.useMobileInterface && !_l.isMifCheckOnServer && !_l.useFenrirCheck && !(_l.MIF_IO =="5" && (_l.u.c == 'C9E0' || _l.u.c == 'C941'))){ // SRSC 법인 통합 
		var returnCode = checkMIFModelAsync();
		if( returnCode == "N" ){
			$("detailForm").MB_IF_RT_INFO.value="1"+$("detailForm").MB_IF_RT_INFO.value;
			$("detailForm").MIF_IO.value="";	// 그냥 눌러본 경우 대상 모델이 아니면 공백처리
		}else if( returnCode == "F" ){
			alert(_l.u.WEB_MSG_PREFIX + "Error occoured to check Model on System. Please try to save again.");
			return;
		}else if(returnCode == "Y"){
			if(needToCheckMIF(corp, currStatus, statusCode, serviceType, defectType)){
				var mifImei14digit = $j("#spanMB_IF_IMEI").text();
				if(mifImei14digit.length > 14){
					mifImei14digit = mifImei14digit.substring(0, 14);
				}
				var mifImei14digit2 = $j("#spanMB_IF_IMEI2").text();
				if(mifImei14digit2.length > 14){
					mifImei14digit2 = mifImei14digit2.substring(0, 14);
				}
				var userImei14digit = "";
				if ((corp == "C750" &&  ($('IRIS_REPAIR').value == "A04" || $('IRIS_REPAIR').value == "M01")) 
						|| (corp == "C6A0" && ($('IRIS_REPAIR').value == "A04" || $('IRIS_REPAIR').value == "A08" || ($('IRIS_REPAIR').value == "A02" && $j("#partsTableBody input[name='PARTS_CODE']").length > 0)))) {
					if($("detailForm").NEW_IMEI.value.length > 14){
						userImei14digit = $("detailForm").NEW_IMEI.value.substring(0, 14);
					}
					if( SVC_PRCD == "HHP05"  || mifImei14digit == ""){
						if($("detailForm").NEW_SERIAL_NO.value == ""){
							alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0282);
							return;
						}
					}else{
						if($("detailForm").NEW_SERIAL_NO.value == "" || userImei14digit == ""){
							alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0281);
							return;
						}
					}
					if("Y" == $("detailForm").MIF_IO.value){
						var isCompare = false;
						if(isFeaturePhoneAsync() || $j("#spanMB_IF_SERIAL").text() == "None" || $j("#spanMB_IF_SERIAL").text() == "" || $j("#spanMB_IF_SERIAL").text() == "00000000000"){
							isCompare = userImei14digit == mifImei14digit;
						}else{
							if(mifImei14digit == "" || ($j("#spanMB_IF_IMEI").text() == $j("#spanMB_IF_SERIAL").text())){
								isCompare = $("detailForm").NEW_SERIAL_NO.value == $j("#spanMB_IF_SERIAL").text();
							}else{
								isCompare = $("detailForm").NEW_SERIAL_NO.value == $j("#spanMB_IF_SERIAL").text() && (userImei14digit == mifImei14digit || userImei14digit == mifImei14digit2);
							}
						}
						if(!isCompare && $("detailForm").NEW_IMEI.value != ""){
							if(_l.isWorkingMPTS){
								if(returnParamMap == undefined){
									returnParamMap = getUnNoFromMPTSAsync();
								}
								if(mifImei14digit == returnParamMap.MASTER_NUM || mifImei14digit == returnParamMap.WP_IMEI
										|| mifImei14digit == returnParamMap.SLAVE_IMEI || mifImei14digit == returnParamMap.THIRD_IMEI){
									//IMEI PROJECT
									if(isAutoImei){
										$("detailForm").NEW_IMEI_TXT.value = markIMEI(mifImei14digit);
										$("detailForm").NEW_IMEI.value = mifImei14digit;
									}else{
										$("detailForm").NEW_IMEI.value = mifImei14digit;
									}									
									isCompare = true;
								}
							}
						}
						
						if(isCompare){
							$("detailForm").MIF_COMPARE_FLAG.value ="Y";
						}else{
							$("detailForm").MIF_COMPARE_FLAG.value ="N";
							alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0281);
							$('STATUS').value = currStatus;
							changeStatusCode();
						}
						haveToReload = true;
					}else{
						$("detailForm").MIF_COMPARE_FLAG.value ="N";
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0271);
						$("detailForm").MIF_IO.value ="N";
						$j(document.detailForm.MB_IF_YN).val("N");
						return;
					}
				}else {					
					if("Y" == $("detailForm").MIF_IO.value){
						if($("detailForm").IMEI.value.length > 14){
							userImei14digit = $("detailForm").IMEI.value.substring(0, 14);
						}
						var isCompare = false;
						if(isFeaturePhoneAsync() || $j("#spanMB_IF_SERIAL").text() == "None" || $j("#spanMB_IF_SERIAL").text() == ""  || $j("#spanMB_IF_SERIAL").text() == "00000000000"){
							isCompare = userImei14digit == mifImei14digit;
						}else{
							if(mifImei14digit == "" || ($j("#spanMB_IF_IMEI").text() == $j("#spanMB_IF_SERIAL").text())){
								isCompare = $("detailForm").SERIAL_NO.value == $j("#spanMB_IF_SERIAL").text();
							}else{
								isCompare = $("detailForm").SERIAL_NO.value == $j("#spanMB_IF_SERIAL").text() && (userImei14digit == mifImei14digit || userImei14digit == mifImei14digit2);
							}
							if(!isCompare){
								if((isEaUser && ($('IRIS_REPAIR').value == "A04" || $('IRIS_REPAIR').value == "A4")) 
										|| (isCisUser &&  $('IRIS_REPAIR').value == "A2") || ($('HQ_SVC_PRCD').value=="THB42" || $('HQ_SVC_PRCD').value=="THB43")){
									if(mifImei14digit == "" || ($j("#spanMB_IF_IMEI").text() == $j("#spanMB_IF_SERIAL").text())){
										isCompare = $("detailForm").NEW_SERIAL_NO.value == $j("#spanMB_IF_SERIAL").text();
									}else{
										isCompare = $("detailForm").NEW_SERIAL_NO.value == $j("#spanMB_IF_SERIAL").text() && (userImei14digit == mifImei14digit || userImei14digit == mifImei14digit2);
									}
								}
							}
						}
						if(!isCompare && $("detailForm").IMEI.value != ""){
							if(returnParamMap == undefined){
								returnParamMap = getUnNoFromMPTSAsync();
							}
							if(mifImei14digit == returnParamMap.MASTER_NUM || mifImei14digit == returnParamMap.WP_IMEI
									|| mifImei14digit == returnParamMap.SLAVE_IMEI || mifImei14digit == returnParamMap.THIRD_IMEI){
								//IMEI PROJECT
								if(isAutoImei){
									$("detailForm").IMEI_TXT.value = markIMEI(mifImei14digit);
									$("detailForm").IMEI.value = mifImei14digit;
								}else{
									$("detailForm").IMEI.value = mifImei14digit;
								}


								isCompare = true;
							}
						}
						
						if(isCompare){
							$("detailForm").MIF_COMPARE_FLAG.value ="Y";
							if($j("#spanMB_IF_UN").text() != "" ){	// 실물 UN 이
																	// 있을 경우
								// 실물 UN과 PBA 교체테이블 UN 체크하는 로직은 검증
								if($("detailForm").UN_IO.value == "" || $("detailForm").UN_IO.value == "-"){
									$("detailForm").MIF_IO.value ="6";
								}else{
									if($('MIF_REPAIR').value == "Y"){	// PBA
																		// 교체건
										if($("detailForm").UN_IO.value.toUpperCase() == $j("#spanMB_IF_UN").text().toUpperCase()){
											$("detailForm").MIF_COMPARE_FLAG.value ="N";
											alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0291);
											$('STATUS').value = currStatus;
											changeStatusCode();
										}else{
											$("detailForm").MIF_UN_IO.value = $j("#spanMB_IF_UN").text();
											$("detailForm").MIF_COMPARE_FLAG.value ="Y";
										}
									}else{	// 미교체건
										if($("detailForm").UN_IO.value.toUpperCase() == $j("#spanMB_IF_UN").text().toUpperCase()){
											$("detailForm").MIF_UN_IO.value = $j("#spanMB_IF_UN").text();
											$("detailForm").MIF_COMPARE_FLAG.value ="Y";
										}else{
											$("detailForm").MIF_UN_IO.value = $j("#spanMB_IF_UN").text();
											$("detailForm").MIF_COMPARE_FLAG.value ="Y";
										}
									}
								}
							}else{	// 실물 UN 이 없을 경우
								if($("detailForm").UN_IO.value == "" || $("detailForm").UN_IO.value == "-"){
									$("detailForm").MIF_IO.value ="6";
								}else{
									$("detailForm").MIF_COMPARE_FLAG.value ="Y";
								}
							}					
						}else{
							$("detailForm").MIF_COMPARE_FLAG.value ="N";
							if(isEuUser && !_l.isRunningOnOperation){
								$("detailForm").MIF_IO.value ="F";
							}else{
								if(corp == "C540"){
									alert(_l.u.WEB_MSG_PREFIX + "Please connect the correct HHP unit to the MIF Program to complete the repair.");
								}else{
									alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0281);
								}
								$('STATUS').value = currStatus;
								changeStatusCode();
							}
							
						}
						haveToReload = true;
					}else{
						$("detailForm").MIF_COMPARE_FLAG.value ="N";
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0271);
						$("detailForm").MIF_IO.value ="N";
						$j(document.detailForm.MB_IF_YN).val("N");
						return;
					}
				}
			}else{
				if($("detailForm").MIF_COMPARE_FLAG.value != "Y"){
					$("detailForm").MIF_COMPARE_FLAG.value ="N";
				}
			}
		}else{
			alert(_l.u.WEB_MSG_PREFIX + "Error occoured to check Model on System. Please try to save again.");
