function isProdHHPIndia(){
	return ($j("#SVC_PRCD").val() == "HHP01" ||
	$j("#SVC_PRCD").val() == "HHP05" ||
	$j("#SVC_PRCD").val() == "HHP06");
}

function changeBOSbtn(flag){
	if(flag){
		$('tdBOS').show();
	}else{
		$('tdBOS').hide();
	}
}

function isEligibleDOA(){
	// header.getCREATE_DATE()
	var initpostingDate = toDisplayScreenDate(_l.CREATE_DATE, ".", _l.u.DateFormat2);
	
	// model.getPURCHASE_DATE()
	var initPurchaseDate = _l.PURCHASE_DATE;
	
	// Posting Date 와 Purchase Date 의 날짜 비교
	var compareDate = cfGetDateDiff(cfGetDate(initPurchaseDate, _l.u.DateFormat2), cfGetDate(initpostingDate, _l.u.DateFormat2));
	
	if($j("#BOS_FLAG").val() == ""){
		if(compareDate < 14){
			if(_l.sawExistExchange){
				if(_l.sawExistExchangeApporvedTa){
					return true;
				}
			}else{
				return true;
			}
		}
	}
	else{
		if(compareDate < 14){
			if(_l.sawExistExchange){
				if(_l.sawExistExchangeApporvedTa){
					return true;
				}
			}else{
				return false;
			}
		}
	}
	
	return false;
}

function activationExistValidate(){
	if(isEligibleDOA()){
		_l.sawTabSaveFlag = true;
	}else{
		if( ($j("#STATUS").val() == "ST035" || $j("#STATUS").val() == "ST040")
				&& _l.sawExistExchange
				&& _l.sawExistExchangeSataus == "SS010" ){
			
			_l.sawTabSaveFlag = true;
		}else{
			_l.sawTabSaveFlag = false;
			alert(_l.u.WEB_MSG_PREFIX + "Cannot Save as SAW is not approved/exist !!");
		}
	}
}

function activationNotExistValidate(){
	if(isEligibleDOA()){
		if(_l.sawExistExchangeApporvedTa){
			_l.sawTabSaveFlag = true;
		}else{
			_l.sawTabSaveFlag = false;
			alert(_l.u.WEB_MSG_PREFIX + "DOA certificate cannot be issued as SAW is not approved/exist.");
		}
	}else{
		if( ($j("#STATUS").val() == "ST035" || $j("#STATUS").val() == "ST040")
				&& _l.sawExistExchange
				&& _l.sawExistExchangeSataus == "SS010"
				&& _l.sawExistExchangeNotReasonTa){
			
			_l.sawTabSaveFlag = true;
		}else{
			_l.sawTabSaveFlag = false;
			alert(_l.u.WEB_MSG_PREFIX + "Cannot Save as SAW is not approved/exist !!");
		}
	}
}
