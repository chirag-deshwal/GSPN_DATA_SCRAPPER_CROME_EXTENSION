function bindCollectionPointPop(cc_code) {
	$j("#CC_CODE").val(cc_code);
}

function getCPList() {
	$('progressloading').startWaiting();
	$('tempForm').cmd.value = 'CollectPntListCmd';
	$('tempForm').assignedFlag.value = 'X';
	AjaxRequest(urlPatternGZIP + '?IV_F4_FLAG=X', 'tempForm', setCPList);
}

function setCPList(response) {
	try {
		var jsonObj = eval('(' + response.responseText + ')');
		var length = jsonObj.etCCInfoList.length;
		if (jsonObj.success && jsonObj.etCCInfoList.length > 0) {
			var selectBox = $('CC_CODE');
			clearGridJsonObject(selectBox);
			var CC_CODE = _l.CC_CODE;
			selectBox.insert("<option value=''>- Select -");
			for ( var i = 0; i < length; i++) {
				var val = jsonObj.etCCInfoList[i].SHOP_CODE;
				var txt = val + " " + jsonObj.etCCInfoList[i].SHOP_NAME;
				selectBox.insert("<option value='" + val + "' >" + txt);
			}
			selectBox.value = CC_CODE;
		} else {
			$j("#tdCCPoint").append(_l.r.m.INF_NOCOLLECTION);
			// appendGridNoObjectDisplay('ccTable', '1',
			// _l.r.m.INF_NOCOLLECTION);
		}

	} catch (e) {
	}
	$('progressloading').stopWaiting();
	// console.log('cp list - complete');
}

