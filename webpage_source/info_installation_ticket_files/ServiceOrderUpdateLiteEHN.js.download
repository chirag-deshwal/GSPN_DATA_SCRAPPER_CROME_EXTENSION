var tabCountClicked = 0;
function viewTab(obj, newTabId) {

	if(newTabId == currTabId) return;// 활성탭 또 누른경우
	
	// 탭을 빠져나갈려고 할때의 탭내의 모든 값
	var afterTabValue = getAllValueInTab(currTabId);
	if(beforeTabValue != '' && beforeTabValue != afterTabValue){
		tabCountClicked++;
	}
	if(tabCountClicked > 2 && beforeTabValue != '' && beforeTabValue != afterTabValue && !isPreventEdit && !_l.isReservationTicket){
		if(confirm(_l.u.WEB_MSG_PREFIX +'Please Save your information at first!')){
			verify();
			return;
		}
	}
	
	var tblTab = $j('#tblTab');
	tblTab.find('.tab_left_ov').attr('class', 'tab_left')
		.end().find('.tab_ov').attr('class', 'tab')
		.end().find('.tab_right_ov').attr('class', 'tab_right');

	$j(obj).prev().attr('class', 'tab_left_ov');
	$j(obj).attr('class', 'tab_ov');
	$j(obj).next().attr('class', 'tab_right_ov');

	if(_l.useDynatrace) {
		dynaTrace.setAutomaticActionDetection(false);
		dtAction = dynaTrace.enterAction('SO open tab(' + newTabId + ');'+_l.dtADKCode, newTabId);
	}
	
	if (newTabId == 'divGeneral')
		initGeneralTab();
	else if (newTabId == 'divCustomer')
		initCustomerTab();
	else if (newTabId == 'divProduct')
		initProductTab();
	else if (newTabId == 'divJob')
		initJobTab();
	else if (newTabId == 'divRepair')
		initRepairTab();
	else if (newTabId == 'divSAW')
		initSAWTab();
	else if (newTabId == 'divBilling')
		initBillingTab();
	else if (newTabId == 'divShipping')
		initShippingTab();
	else if (newTabId == 'divHistory')
		initHistoryTab();
	else if (newTabId == 'divEstimate')
		initEstimateTab();
	else if (newTabId == 'divANC')
		initANCTab();
	else if (newTabId == 'divScenario')
		initScenarioTab();
	else if (newTabId == 'divPendProcess')
		initPendProcessTab();
	else if (newTabId == 'divSympEffSurvey')
		initdivSympEffSurveyTab();
	else if (newTabId == 'divSubEng') // medison sub eng 2015.02.26 jiw
		initSubEngTab();
	else if (newTabId == 'divCreditInfo') // SEA Walk in Service 2015.09.09
											// JS.BAEK
		initCreditInfoTab();
	else if (newTabId == 'divChangeLog') // * 미주 통합 - RT-013 - Chage Log 조회
											// 기능 유지 - C370 적용 - 2015-09-08
		initChangeLog();
	else if (newTabId == 'divIqc')
		initIqcTab();
	else if (newTabId == 'divOqc')
		initOqcTab();
	else if (newTabId == 'divGm')
		initGmTab();
	else if (newTabId == 'divTa')
		initTaTab();
	//china version intergration 2016/08/09 js1.baek
	else if (newTabId == 'divVipInfo')
		initVipTab();
	else if (newTabId == 'divExchangeRefundInfo')
		initExchangeTab();
	else if (newTabId == 'divDoaDapInfo')
		initDoaDapTab();
	else if (newTabId == 'divAccInspInfo')
		initAccInspTab();
	else if (newTabId == 'divWtyFeedback')
		initWtyFeedbackTab();
}


function viewShipTabForC750Turkcell() {

	if("divShipping" == currTabId) return;// 활성탭 또 누른경우
	
	// 탭을 빠져나갈려고 할때의 탭내의 모든 값
	var afterTabValue = getAllValueInTab(currTabId);
	if(beforeTabValue != '' && beforeTabValue != afterTabValue){
		if(confirm(_l.u.WEB_MSG_PREFIX +'Please Save your information at first!')){
			verify();
			return;
		}
	}
	var tblTab = $j('#tblTab');
	tblTab.find('.tab_left_ov').attr('class', 'tab_left')
		.end().find('.tab_ov').attr('class', 'tab')
		.end().find('.tab_right_ov').attr('class', 'tab_right');

	$j($j("#tdShipping")[0]).prev().attr('class', 'tab_left_ov');
	$j($j("#tdShipping")[0]).attr('class', 'tab_ov');
	$j($j("#tdShipping")[0]).next().attr('class', 'tab_right_ov');

	initShippingTabC750Tuckcell();
}

function toggleOptionTab(newTabId) {
	if (currTabId != newTabId) {
		if (currTabId != '') {
			$j("#"+currTabId).css("display","none");
		}
		$j("#"+newTabId).css("display","block");
		currTabId = newTabId;
		beforeTabValue = getAllValueInTab(newTabId);
		
		initModifyFlag(newTabId);

		// =============================================================================
		// 제 목 : 인도 Demand
		// 과 제 : Fedex system integration with GSPN
		// 수 정 일 : 2015-05-18
		// 내 용 : CorpCode가 "C550"와 CountryCode가 "IN"일때 Docket 버튼과 Challan버튼 생성
		// SH건일때는 Status ST035로 변경되기 전에 Generate docket 버튼 생성
		// PS건일때는 Status ST035로 변경된 후에 Gnererate docket 버튼 생성
		// =============================================================================
		initFedexShipButton(newTabId);
		// =============================================================================
		// 북미통합 Walk in Service
		if(_l.u.c == "C370"){
			initWisTab(newTabId);
		}else if(_l.isFieldNewUser){
			initFemeTab(newTabId);
		}
	}
	if(_l.useDynatrace) {
		dynaTrace.leaveAction(dtAction);
	}

	// EHN21
	preventInputEnter();
}

function getAllValueInTab(tabId){
	if(tabId == "" || $j("#" + tabId).length == 0 
			// not need to input any information, just use themselves function
			|| tabId == 'divSAW'
			|| tabId == 'divBilling'
			|| tabId == 'divANC'
			|| tabId == 'divScenario'
			// || tabId == 'divHistory'
			// || tabId == 'divSympEffSurvey'
	){
		return "";
	}
	
	// 탭간 이동시 정보를 변경하면 저장하도록 권유하기 위해 이전정보 저장
	var arrVal = [];
	// :input type=text,hidden + radio & checkbox 의 checked 된것 + select,
	// textarea 이들의 값이 변경되엇는지 확인한다.
	$j("#" + tabId ).find("input:text,input:hidden,input:checked,select,textarea").not("input:button").each(function(){
		arrVal.push(this.name+"="+this.value);
	});
	// console.log(tabId + " informations >> " + arrVal.join());
	return arrVal.join();	
}

