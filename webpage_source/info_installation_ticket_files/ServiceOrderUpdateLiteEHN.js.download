function getEngineerList() {
	
	
	/*
	 * 미주 통합 - RT-007 - Assigned ASC 를 추가하여 Service Branch를 선택할 수 있도록 한다 (SEA CE &
	 * IM 동일) - Assigned ASC가 선택되면 ASC 의 Active Engineer List를 선택할 수 있도록 한다. -
	 * 2015-09-14
	 */	

		if (_l.u.c == "C550" || _l.u.c == "C330" || (_l.isFieldUser && _l.isRepairTicket) ) {
			getSvcEngineerSearch();
		} else {
			var prodStr = "&IV_PROD_AUTH=X";
//			if(exceptRACheckForOW && $j('#IN_OUT_WTY').val() == "OW") {
//				prodStr = "";  
//			}
//			if(isCisUser && $j('#SERVICE_TYPE').val()=="SH") {
//				prodStr = "";  
//			}
			$('tempForm').IV_INOUTWTY.value = $j('#IN_OUT_WTY').val();
			$('tempForm').curSvcType.value = $j('#SERVICE_TYPE').val();
			$('tempForm').cmd.value = 'EngineerSearchCmd';
			AjaxRequest(urlPatternGZIP + '?IV_F4_FLAG=X'+prodStr, 'tempForm', setEngineerList);
		}
		
	
}
function getTechnicianList(type) {
	$('tempForm').cmd.value = 'EngineerSearchCmd';
	if(type=="main"){
		AjaxRequest(urlPatternGZIP + '?IV_F4_FLAG=X', 'tempForm', setTechnicianListMain);
	}else{
		AjaxRequest(urlPatternGZIP + '?IV_F4_FLAG=X', 'tempForm', setTechnicianList);
	}
}

function setEngineerList(response) {
	var jsonObj = eval('(' + response.responseText + ')');
	var length = jsonObj.EtEngineerInfo.length;
	$('sENGINEER').length = 1;
	var ENGINEER = _l.ENGINEER;
	if (jsonObj.success && length > 0) {
		for ( var i = 0; i < length; i++) {
			var objOption = document.createElement('option');
			objOption.appendChild(document
					.createTextNode(jsonObj.EtEngineerInfo[i].ENGINEER_NAME
							+ " | " + jsonObj.EtEngineerInfo[i].ENGINEER
							+ " | " + jsonObj.EtEngineerInfo[i].ASC_ENGINEER));
			objOption.setAttribute("value", jsonObj.EtEngineerInfo[i].ENGINEER);
			if (objOption.value == ENGINEER) {
				objOption.selected = true;
				
				if(_l.u.c == "C330") {					
					$('TECH_ID').value = jsonObj.EtEngineerInfo[i].ASC_ENGINEER;
				}
			}
			$('sENGINEER').appendChild(objOption);
		}
	}
}

var jsonObjTechnicianList;

function setTechnicianList(response) {
	jsonObjTechnicianList = eval('(' + response.responseText + ')');
	var length = jsonObjTechnicianList.EtEngineerInfo.length;
	technicianLengh = length;
	if (jsonObjTechnicianList.success && length > 0) {
		var objOption = document.createElement('option');
		objOption.appendChild(document.createTextNode("---------"));
		objOption.setAttribute("value", "");
		$('sTECH_ID').appendChild(objOption);
		for ( var i = 0; i < length; i++) {
			var objOption = document.createElement('option');
			objOption.appendChild(document
					.createTextNode(jsonObjTechnicianList.EtEngineerInfo[i].ENGINEER_NAME
							+ " | " + jsonObjTechnicianList.EtEngineerInfo[i].ASC_ENGINEER));
			objOption.setAttribute("value", jsonObjTechnicianList.EtEngineerInfo[i].ASC_ENGINEER);
			if (objOption.value == _l.TECH_ID)
				objOption.selected = true;
			$('sTECH_ID').appendChild(objOption);
		}
	} else{
		$j('#TECH_ID').removeAttr("readonly").removeClass().addClass("input");
		var techIdList_area = $j('#techIdList_area');
		techIdList_area.css("display","none");
	}
}
function setTechnicianListMain(response) {
	jsonObjTechnicianList = eval('(' + response.responseText + ')');
	var length = jsonObjTechnicianList.EtEngineerInfo.length;
	technicianLengh = length;
	if (jsonObjTechnicianList.success && length > 0) {
		for ( var i = 0; i < length; i++) {
			if (jsonObjTechnicianList.EtEngineerInfo[i].ASC_ENGINEER == _l.TECH_ID)
				$('TECH_ID_DESC').value = jsonObjTechnicianList.EtEngineerInfo[i].ENGINEER_NAME+ " | " + jsonObjTechnicianList.EtEngineerInfo[i].ASC_ENGINEER;
		}
	}
}

function getSvcEngineerSearch(changeFlag) {
	if(!$('sENGINEER')) return;
	if(_l.FIRST_APP_DATE != $j("#FIRST_APP_DATE_DY_STT").val()){
		$j("#FIRST_APP_DATE").val($j("#FIRST_APP_DATE_DY_STT").val());
		$j("#FIRST_APP_TIME").val($j("#FIRST_APP_TIME_DY_STT").val());
	}
	if(_l.LAST_APP_DATE != $j("#LAST_APP_DATE_DY_STT").val()){
		$j("#LAST_APP_DATE").val($j("#LAST_APP_DATE_DY_STT").val());
		$j("#LAST_APP_TIME").val($j("#LAST_APP_TIME_DY_STT").val());
	}
	
	var fir_app_dt = $('FIRST_APP_DATE').value;
	var last_app_dt = $('LAST_APP_DATE').value;
	var cust_req_dt = _l.CUST_REQ_DATE;
	var last_visit_dt = $('LAST_VISIT_DATE').value;
	
	var app_dt;
	var app_time;
	if(last_app_dt.substring(0, 2) == '00' || last_app_dt.substring(0, 2) == ''){
		app_dt = fir_app_dt;
		app_time = $('FIRST_APP_TIME').value;
	}else{
		app_dt = last_app_dt;
		app_time = $('LAST_APP_TIME').value;
	}

	if (_l.u.c == 'C310' && (app_dt.substring(0, 2) == '00' || app_dt.substring(0, 2) == '')) {
		app_dt = cust_req_dt;
		app_time = _l.CUST_REQ_TIME;
		if(app_dt.substring(0, 2) == '00' || app_dt.substring(0, 2) == ''){
			app_dt = last_visit_dt;
			app_time = $('LAST_VISIT_TIME').value;
		}
	}
	
	var model = $j("#MODEL").val();
	
	
	/*
	 * 미주 통합 - RT-007 - Assigned ASC 를 추가하여 Service Branch를 선택할 수 있도록 한다 (SEA CE &
	 * IM 동일) - Assigned ASC가 선택되면 ASC 의 Active Engineer List를 선택할 수 있도록 한다. -
	 * 2015-09-14
	 */	
		var tmpAscCode = _l.ASC_CODE;
		var statusCode = $("STATUS").value;
		var wtyinout = $j('#IN_OUT_WTY').val(); 
		
		if(_l.isFieldUser){
			tmpAscCode = $j("#ASSIGNED_ASC_CODE").val();
			if(changeFlag){
				var partsCnt = $j("#detailForm input[name=PARTS_SEQ_NO]").length;
				if(_l.partslength > 0){
					$j("#ASSIGNED_ASC_CODE").val($j("#ASC_CODE").val());
					alert(_l.u.WEB_MSG_PREFIX + "Can't change ASC, because current ASC used parts!");
					return false;
				}
				$('ENGINEER').value = "";
				$('ENGINEERNAME').innerHTML = "";
			}
		}
		if(_l.isCallEngineerPortal && ((_l.u.c == 'C310' && $('SERVICE_TYPE').value == "IH")
				|| ((_l.u.c == 'C370'||_l.u.c == 'C330') && ($('SERVICE_TYPE').value == "CI" || $('SERVICE_TYPE').value == "IH" || $('SERVICE_TYPE').value == "PS")))){
			var param = {
				cmd : 'GetTechEngineerNoCmd',
				IV_ASC_APP_DT : app_dt,
				IV_ASC_APP_TM : app_time,
				TICKET_NO : _l.ObjectId,
				STATUS : statusCode,
				ASC_CODE : tmpAscCode
			};
		}else{
			var param = {
				cmd : 'SvcEngineerSearchCmd',
				IV_ASC_APP_DT : app_dt,
				MODEL : model,
				ASC_CODE : tmpAscCode,
				IV_INOUTWTY : wtyinout
			};
		}
		$j.get(urlPatternGZIP, param, setSvcEngineerList, "json");
		
}

function setSvcEngineerList(jsonObj) {
	// var jsonObj = eval('('+response.responseText+')');
	var statusCode = $("STATUS").value;
	if(_l.isCallEngineerPortal && ((_l.u.c == 'C310' && $('SERVICE_TYPE').value == "IH")
			|| ((_l.u.c == 'C370' || _l.u.c == 'C330') && ($('SERVICE_TYPE').value == "CI" || $('SERVICE_TYPE').value == "IH" || $('SERVICE_TYPE').value == "PS")))){
		
		$('sENGINEER').length = 1;
		var ENGINEER = _l.ENGINEER;
		var length;
		if(jsonObj.data == null){
			jsonObj.success = false;
			length = 0;
		}else{
			length = jsonObj.data.techs.length;
		}
		
		if (jsonObj.success && length > 0) {
			for ( var i = 0; i < length; i++) {
				var objOption = document.createElement('option');
				objOption.appendChild(document.createTextNode(jsonObj.data.techs[i].techId
						+ " | " + jsonObj.data.techs[i].firstName + " "+jsonObj.data.techs[i].lastName
						+ " | " + jsonObj.data.techs[i].engineerNo));
				objOption.setAttribute("value",jsonObj.data.techs[i].engineerNo);
				
				if (objOption.value == ENGINEER){
					objOption.selected = true;
					$('ENGINEER').value = objOption.value;
					$('ENGINEERNAME').innerHTML = objOption.innerHTML;
					if ("C310"==_l.u.c  || _l.u.c == "C330") {
						$('TECH_ID').value = $j.trim(objOption.innerHTML.split('|')[0]);
					}
				}
				$('sENGINEER').appendChild(objOption);
			}
		}
	}else{
		var length = jsonObj.et_engineer_list.length;
		$('sENGINEER').length = 1;
		var ENGINEER = _l.ENGINEER;
		if (jsonObj.success && length > 0) {
			for ( var i = 0; i < length; i++) {
				var objOption = document.createElement('option');
				if (jsonObj.et_engineer_list[i].engineer_type == 'C') {
					objOption.appendChild(document.createTextNode(jsonObj.et_engineer_list[i].engineer_name
							+ " | " + jsonObj.et_engineer_list[i].engineer + " | BE"));
				}else{
					objOption.appendChild(document.createTextNode(jsonObj.et_engineer_list[i].engineer_name
							+ " | " + jsonObj.et_engineer_list[i].engineer));
				}
				objOption.setAttribute("value",jsonObj.et_engineer_list[i].engineer);
				
				if (objOption.value == ENGINEER){
					objOption.selected = true;
					$('ENGINEER').value = objOption.value;
					$('ENGINEERNAME').innerHTML = objOption.innerHTML;
					if ("C310"==_l.u.c  || _l.u.c == "C330") {
						$('TECH_ID').value = $j.trim(objOption.innerHTML.split('|')[0]);
					}
				}
				$('sENGINEER').appendChild(objOption);
			}
		}
	}
	
	
	//=================================================================================//
	//제  목 : 인도 Demand Enhancement of CS operations using biometric system
	//수정일 : 2015.10.06
	//수정자 : 채보람 (로젠 솔루션)
	//내  용 : Engineer 선택시 해당 Engineer 의 GSPN ID 존재 여부 체크
	//		   사용할 변수에 매핑
	_l.selectEngineer = $j("#ENGINEER").val();
	_l.selectEngineerName = $j("#ENGINEERNAME").html();
	//=================================================================================//
	
}

/**
 * china region user use getIRISCodeGroup() method to get the IRIS code
 */
function getCodeGroup() {
	$('tempForm').action = urlPatternGZIP;
	$('tempForm').cmd.value = 'GetIRISGroupCmd';

	AjaxRequest(urlPatternGZIP, "tempForm", setCodeGroup);
}

function setCodeGroup(response) {
	var codeGroup = '';
	try {

		var jsonObj_group = eval('(' + response.responseText + ')');

		if (jsonObj_group.success) {
			var length = jsonObj_group.codeGroup.length;

			for ( var i = 0; i < length; i++) {
				var tmp = jsonObj_group.codeGroup[i].code_group;
				if(_l.u.isChinaRegion){
					codeGroup += tmp + ",";
				}else{
					if ((tmp.indexOf("-C") > 0) || (tmp.indexOf("-D") > 0)
							|| (tmp.indexOf("-R") > 0) || (tmp.indexOf("-S") > 0)) {
						codeGroup += tmp + ",";
					}
				}
			}
			codeGroup = codeGroup.substring(0, codeGroup.lastIndexOf(","));
			userIRISCodeGroup = codeGroup;
			if(_l.isUseGcicIris && codeGroup.indexOf('EIA-D') != -1){
				$j("#IRIS_DEFECT_QCODE").css("display","block");
			}
			if(codeGroup.indexOf('EIA') != -1){
				$j('#IrisCodeDec').hide();
			}
			getIRIS(codeGroup);

		} else {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.ERROR + '-IRIS');
		}
	} catch (e) {
	}
}

/**
 * if C6V0 : use another function to get IRIS code from DB
 * but C610 use this function same with the global
 * @param ctype
 */
function getIRIS(ctype) {
	$('tempForm').cmd.value = 'GetIRISInfoCmd';
	$('tempForm').Ctype.value = ctype;
	$('tempForm').AUTH_GR.value = _l.AUTH_GR;
	var irisTyp = '';
	if (ctype.indexOf('-C') > 0 || ctype.indexOf('-D') > 0
			|| ctype.indexOf('-R') > 0 || ctype.indexOf('-S') > 0) {
		irisTyp = '';
	} else {
		irisTyp = 'DEFECT_BLK';
	}
	$('tempForm').MODEL.value = $('detailForm').MODEL.value;
	if (irisTyp == '') {
		AjaxRequest(urlPatternGZIP, "tempForm", setIRIS);
	} else {
		AjaxRequest(urlPatternGZIP, "tempForm", setIRIS_DEFECT_BLK);
	}
}

function setIRIS_DEFECT_BLK(response) {
	setIRIS(response, null, 'DEFECT_BLK');
}

var jsonObjIrisDefect;
var jsonObjIrisSymptom;
var jsonObjIrisRepair;

function setIRIS(response, jsonTemp, irisType) {
	try {
		var jsonObj = null;
		var isQQ = true;//for china
		
		if (response) {
			jsonObj = eval('(' + response.responseText + ')');
			if (irisType == null || irisType == '')
				parent.jsonIrisCodeGroup_temp = jsonObj;
			// else //DEFECT_BLK
		} else {
			jsonObj = jsonTemp;
		}

		if (jsonObj.success) {
			if(_l.isUseGcicIris && irisType != 'DEFECT_BLK'){
				jsonObjIrisDefect = jsonObj;
				jsonObjIrisSymptom = jsonObj;
				jsonObjIrisRepair = jsonObj;
				jsonObjIrisDefect.defectList = jsonObj.defectList;
				jsonObjIrisSymptom.symptomList = jsonObj.symptomList;
				jsonObjIrisRepair.repairList = jsonObj.repairList;
			}
			
			var length = jsonObj.dataLists.length;

			var IRIS_CONDI = _l.IRIS_CONDI;
			var IRIS_DEFEC = _l.IRIS_DEFEC;
			var IRIS_SYMPT = _l.IRIS_SYMPT;
			var IRIS_REPAI = _l.IRIS_REPAI;
			var DEF_BLK = _l.DEF_BLK;

			var IRIS_CONDI_DESC = $("tempForm").IRIS_CONDI_DESC;
			var IRIS_DEFECT_DESC = $("tempForm").IRIS_DEFECT_DESC;
			var IRIS_SYMPT_DESC = $("tempForm").IRIS_SYMPT_DESC;
			var IRIS_REPAIR_DESC = $("tempForm").IRIS_REPAIR_DESC;

			var CONDI = $('IRIS_CONDI');
			var DEFECT = $('IRIS_DEFECT');
			var SYMPT = $('IRIS_SYMPT');
			var REPAIR = $('IRIS_REPAIR');
			var DEF_BLK__ = $('DEF_BLK');

			var isDefectSeleted = false;
			var isSymptomSeleted = false;
			var isRepairSeleted = false;
			var isIrisSympt = false;
			
			for ( var i = 0; i < length; i++) {
				var obj = jsonObj.dataLists[i];
				var ctype = obj.ctype;
				var objOption = document.createElement('option');
				objOption.appendChild(document.createTextNode(obj.code + '-'
						+ obj.codetx));
				objOption.setAttribute("value", obj.code);

				if(_l.u.isChinaRegion && obj.code == 'X01'){
					isQQ = false;
				}
				
				if (ctype.indexOf('-C') > 0) {// if ( ctype == 'IRIS-C') {
					if (objOption.value == IRIS_CONDI) {
						objOption.selected = true;
						IRIS_CONDI_DESC.value = obj.codetx;
					}
					CONDI.appendChild(objOption);
				} else if (ctype.indexOf('-D') > 0) {// } else if ( ctype ==
														// 'IRIS-D') {
					if (objOption.value == IRIS_DEFEC) {
						objOption.selected = true;
						isDefectSeleted = true;
						IRIS_DEFECT_DESC.value = obj.codetx;
						if(_l.isUseGcicIris && ctype.indexOf('EIA-D') != -1){
							$('SAVED_IRIS_DEFECT_QCODE').value = obj.qcode;
						}
					}
					DEFECT.appendChild(objOption);
				} else if (ctype.indexOf('-S') > 0) {// } else if ( ctype ==
														// 'IRIS-S') {
					if(IRIS_SYMPT == "" || IRIS_SYMPT == undefined){
						if(_l.gdproaSymp != "" && _l.gdproaSymp != undefined){
							if(objOption.value == _l.gdproaSymp){
								IRIS_SYMPT = _l.gdproaSymp;
								isIrisSympt = true;
							}
						}	
					}
					if (objOption.value == IRIS_SYMPT) {
						objOption.selected = true;
						isSymptomSeleted = true;
						IRIS_SYMPT_DESC.value = obj.codetx;
						if(_l.isUseGcicIris){
							$('SAVED_IRIS_SYMPT_QCODE').value = obj.qcode;
						}
					}
					SYMPT.appendChild(objOption);
				} else if (ctype.indexOf('-R') > 0) {// } else if ( ctype ==
														// 'IRIS-R') {

					if(isNewChina && (objOption.value == "X15" || objOption.value == "W67")
							&& $('SERVICE_TYPE').value != "SH"){
						continue;
					}else{
						if (objOption.value == IRIS_REPAI) {
							objOption.selected = true;
							isRepairSeleted = true;
							IRIS_REPAIR_DESC.value = obj.codetx;
							if(_l.isUseGcicIris){
								$('SAVED_IRIS_REPAIR_QCODE').value = obj.qcode;
							}
						}
						REPAIR.appendChild(objOption);
					}
				} else {// } else if ( ctype == 'IRIS-E' || ctype ==
						// 'DEFECT_BLOCK') {
					if (objOption.value == DEF_BLK)
						objOption.selected = true;
					DEF_BLK__.appendChild(objOption);
				}
			}
			
			
			// EHN15 : gd symptom mapping
			if (!("C310" == _l.u.c || "C370" == _l.u.c)) {
				if ("S" == _l.gdMappingCode && typeof irisType == "undefined") {
/*					if(_l.gdMappingMessage != "" && _l.gdMappingMessage != undefined){
						alert(_l.u.WEB_MSG_PREFIX + _l.gdMappingMessage);
					}*/
					var gdSymptomCode = "";
					if (userIRISCodeGroup.indexOf("NSAM") > -1) {
						gdSymptomCode = _l.gdQcNsam;
						if(_l.gdQc2Nsam != "" && _l.gdQc2Nsam != undefined){
							IRIS_SYMPT = _l.gdQc2Nsam;
						}
					} else if (userIRISCodeGroup.indexOf("EIA") > -1) {
						gdSymptomCode = _l.gdQcEia;
						if(_l.gdQc2Eia != "" && _l.gdQc2Eia != undefined){
							IRIS_SYMPT = _l.gdQc2Eia;
						}
					} else if (userIRISCodeGroup.indexOf("IRIS") > -1) {
						gdSymptomCode = _l.gdQcIris;
						if(_l.gdQc2Iris != "" && _l.gdQc2Iris != undefined){
							IRIS_SYMPT = _l.gdQc2Iris;
						}
					}
					if(isIrisSympt){
						gdSymptomCode = $('SAVED_IRIS_SYMPT_QCODE').value;
						IRIS_SYMPT = _l.gdproaSymp;
					}
					$('SAVED_IRIS_SYMPT_QCODE').value = gdSymptomCode;
				}
			}
			
			if(_l.isUseGcicIris && irisType != 'DEFECT_BLK'){
				
				var defectMiddleLength = jsonObj.defectMiddleList.length;
				var symptomMiddleLength = jsonObj.symptomMiddleList.length;
				var repairMiddleLength = jsonObj.repairMiddleList.length;
				
				var defectMiddleObj = jsonObj.defectMiddleList;
				var symptomMiddleObj = jsonObj.symptomMiddleList;
				var repairMiddleObj = jsonObj.repairMiddleList;
				
				var opt_html = "<option value=''>- " + _l.r.c.LBL_01035 + " -</option>";
				var no_opt_html = "<option value=''>- " + _l.r.m.EXT_0600 + " -</option>";
				$j("#IRIS_DEFECT_QCODE").empty();;// 초기화
				$j("#IRIS_SYMPT_QCODE").empty();;// 초기화
				$j("#IRIS_REPAIR_QCODE").empty();;// 초기화
				if(defectMiddleLength > 0){
					$('IRIS_DEFECT_QCODE').className = "selectF";
					$('IRIS_DEFECT_QCODE').disabled = false;
					$('IRIS_DEFECT_QCODE').insert(opt_html);
					
					for(var i=0; i < defectMiddleLength; i++){
						
						var objOption = document.createElement('option');
						objOption.appendChild(document.createTextNode(defectMiddleObj[i].qcode + '-'
								+ defectMiddleObj[i].qcodetx));
						objOption.setAttribute("value", defectMiddleObj[i].qcode);
						if (objOption.value == $('SAVED_IRIS_DEFECT_QCODE').value) {
							objOption.selected = true;
						}
						$('IRIS_DEFECT_QCODE').appendChild(objOption);
					}
					
					changeDefectQCode($('SAVED_IRIS_DEFECT_QCODE').value, IRIS_DEFEC);
					
				}else{
					$('IRIS_DEFECT_QCODE').insert(no_opt_html);
					$('IRIS_DEFECT_QCODE').className = "selectRO";
					$('IRIS_DEFECT_QCODE').disabled = true;
				}
				
				if(symptomMiddleLength > 0){
					$('IRIS_SYMPT_QCODE').className = "selectF";
					$('IRIS_SYMPT_QCODE').disabled = false;
					$('IRIS_SYMPT_QCODE').insert(opt_html);
					for(var i=0; i < symptomMiddleLength; i++){
						
						var objOption = document.createElement('option');
						objOption.appendChild(document.createTextNode(symptomMiddleObj[i].qcode + '-'
								+ symptomMiddleObj[i].qcodetx));
						objOption.setAttribute("value", symptomMiddleObj[i].qcode);
						if (objOption.value == $('SAVED_IRIS_SYMPT_QCODE').value) {
							objOption.selected = true;
						}
						$('IRIS_SYMPT_QCODE').appendChild(objOption);
					}
					
					changeSymptomQCode($('SAVED_IRIS_SYMPT_QCODE').value, IRIS_SYMPT);
					
				}else{
					$('IRIS_SYMPT_QCODE').insert(no_opt_html);
					$('IRIS_SYMPT_QCODE').className = "selectRO";
					$('IRIS_SYMPT_QCODE').disabled = true;
				}
				
				if(repairMiddleLength > 0){
					$('IRIS_REPAIR_QCODE').className = "selectF";
					$('IRIS_REPAIR_QCODE').disabled = false;
					$('IRIS_REPAIR_QCODE').insert(opt_html);
					for(var i=0; i < repairMiddleLength; i++){
						
						var objOption = document.createElement('option');
						objOption.appendChild(document.createTextNode(repairMiddleObj[i].qcode + '-'
								+ repairMiddleObj[i].qcodetx));
						objOption.setAttribute("value", repairMiddleObj[i].qcode);
						if (objOption.value == $('SAVED_IRIS_REPAIR_QCODE').value) {
							objOption.selected = true;
						}
						$('IRIS_REPAIR_QCODE').appendChild(objOption);
					}
					
					changeRepairQCode($('SAVED_IRIS_REPAIR_QCODE').value, IRIS_REPAI);
					
				}else{
					$('IRIS_REPAIR_QCODE').insert(no_opt_html);
					$('IRIS_REPAIR_QCODE').className = "selectRO";
					$('IRIS_REPAIR_QCODE').disabled = true;
				}
				
			}
			//china version intergration 2016/08/16 pcs73
			if(_l.u.isChinaRegion){					
					if($('SERVICE_TYPE').value == 'IS'){
						if(IRIS_REPAI == "RP" || IRIS_REPAI =="RT" || IRIS_REPAI =="RR"){
							$j('#i_distance').val( $j('[name=DISTANCE]').val() );
							$j("#trDistance").show();	
						}else{
							$j('#i_distance').val("");
							$j("#trDistance").hide();		
						}
					}
					
					if(_l.isQQUser && isQQ){//isQQ:code=X01
						var objOption2 = document.createElement('option');
						objOption2.appendChild(document.createTextNode('X01' + '-' + '查无故障'));
						objOption2.setAttribute("value", "X01");
						if ("X01" == IRIS_REPAI){
							objOption2.selected = true;
					    	$("tempForm").IRIS_REPAIR_DESC.value = '查无故障';
						}
						$('IRIS_REPAIR').appendChild(objOption2);
					}	
					
			}
			
			
			
			if (jsonObj.retcode != 'S') {
				// alert('Fail to get IRIS
				// codes'+(irisType=='DEFECT_BLK'?"[Defect Block]":"")+' from
				// G-ERP!! SAP Message: '+jsonObj.retmsg);
			}
			// HME 확산에 따른 isMedisonUser 추가 2015.03.19 jiw
			// HME user role 화면 2015.04.17 jiw
			if(_l.u.c == "C1X0" || isHmeUser){
				changeCoditionCode(CONDI);
				var hmeCondition = $("HME_CONDI");
				
				if(1 < hmeCondition.options.length){
					for(var j=0; j<hmeCondition.options.length; j++){
						if(hmeCondition.options[j].value == _l.HME_CONDI){
							hmeCondition.options[j].selected = true;
							break;
						}
					}
				}
			}
			
			//only for C550, make some options of the defect type option disabled.
			blockEntryOfDefectType();
		
			if(_l.isUseGcicIris){
				if((isNewChina || _l.u.c == "C610") && $("STATUS").value=="ST035" || $("STATUS").value=="ST040"){
					if(!isSymptomSeleted && IRIS_SYMPT != ""){
						setOldDataForIris('IRIS_SYMPT',IRIS_SYMPT, IRIS_SYMPT_DESC.value, false);
					}
					/*
					if(!_l.isWtyClaimed && !_l.isBillingSaved){
						var isUseOldIRISData = true;
						
						if($('IRIS_CONDI').value == "" && IRIS_CONDI != ""){
							if(isUseOldIRISData){
								setOldDataForIris('IRIS_CONDI',IRIS_CONDI, IRIS_CONDI_DESC.value, true);
							}else{
								setOldDataForIris('IRIS_CONDI',IRIS_CONDI, IRIS_CONDI_DESC.value, false);
							}
						}
						
						if(!isSymptomSeleted && IRIS_SYMPT != ""){
							if(isUseOldIRISData){
								$('IRIS_SYMPT_QCODE').className = "selectRO";
								$('IRIS_SYMPT_QCODE').disabled = true;
								setOldDataForIris('IRIS_SYMPT',IRIS_SYMPT, IRIS_SYMPT_DESC.value, true);
							}else{
								setOldDataForIris('IRIS_SYMPT',IRIS_SYMPT, IRIS_SYMPT_DESC.value, false);
							}
						}
						if(!isRepairSeleted && IRIS_REPAI != ""){
							if(isUseOldIRISData){
								$('IRIS_REPAIR_QCODE').className = "selectRO";
								$('IRIS_REPAIR_QCODE').disabled = true;
								setOldDataForIris('IRIS_REPAIR',IRIS_REPAI, IRIS_REPAIR_DESC.value, true);
							}else{
								setOldDataForIris('IRIS_REPAIR',IRIS_REPAI, IRIS_REPAIR_DESC.value, false);
							}
						}
					}
					*/
				}
			}

		} else {
			alert(_l.u.WEB_MSG_PREFIX + 'Fail to get IRIS codes from G-ERP ');
		}
	} catch (e) {
	}
	
	//$j("select.flexselect").flexselect();
	
	if(_l.hasRcDatePendingStatus && !_l.isSeaImAscUser){
		preventModifyPendingSO();
	}	
	
	if(_l.u.isChinaRegion){
		setDefaultIRISSetting('');
	}
}

function setOldDataForIris(name, code, text, isUsingOld){
	if(isUsingOld){
		$j('select[name='+name+'] option').each(function() {
			$j(this).remove();
		});
		$j('<option value="'+code+'">'+code+'-'+text+'</option>').attr('selected',true).appendTo('select[name='+name+']');
	}
	$j('#'+name+'').prop("disabled", false);
	
	if($j('#detailForm [name='+name+']').length > 1){
		$j('#detailForm [name='+name+']:hidden').remove();
	}
}

function limitTicketCancelStatus() {
	var options = $j('#STATUS option');
	var isTicketCancelUser = _l.isTicketCancelUser;
	for ( var i = 0; i < options.length; i++) {
		var option = options[i];
		var status = option.value;
		if (status == "ST052" && !isTicketCancelUser) {
			option.disabled = true;
		}
		if("C330" == _l.u.c && status == "ST051"){
			option.disabled = true;
		}
	}
}// function limitTicketCancelStatus() {

/**
 * 	only for C550, 
 * make some options of the defect type disabled.
 */
function blockEntryOfDefectType() {
	if ("C550" == _l.u.c) {
		var svcProduct = $j("#SVC_PRCD").val();
		var isHHP = (svcProduct == "DSC05" || svcProduct.substr(0, 3) == "HHP");
		var entrys = "";
		if (isHHP) {
			entrys = "AE,L1,L2,L3,IP,UB";
		} else {
			entrys = "AE, MN, MJ, FL, SP, IP";
		}
		$j("#LAB_TYPE option").each(function() {
			var val = $j(this).val();
			var dis = (entrys.indexOf(val) == -1);
			$j(this).prop("disabled", dis);
		});

	}// if("C550" == _l.u.c){
}


function setPartsStatus(index, status) {
	var objPartsStatus = document.getElementsByName("PARTS_STATUS");
	objPartsStatus[index].value = status;
}

var po_popup;
function openNewPOPop(type) {
	var frmObj = $('CreatePOForm');
	$("notCheckSO").value = "";

	var partsSOObj = $j("#partsTableBody input[name='D_SO_NO']");// document.getElementsByName('D_SO_NO');
	var partsSeqObj = $j("#partsTableBody input[name='PARTS_SEQ_NO']");// document.getElementsByName('PARTS_SEQ_NO');
	var partsCodeObj = $j("#partsTableBody input[name='PARTS_CODE']");// document.getElementsByName('PARTS_CODE');
	var partsQtyObj = $j("#partsTableBody input[name='PARTS_QTY']");// document.getElementsByName('PARTS_QTY');
	var partsWtyObj = $j("#partsTableBody input[name='PARTS_INOUT']");// document.getElementsByName('PARTS_INOUT');
	var partsGiDateObj = $j("#partsTableBody input[name='GI_DATE']");
	var partsTypeObj = $j("#partsTableBody input[name='PARTS_TYPE']");
	
	var po_cnt = 0;
	var po_so_cnt = 0;
	var rtype_cnt = 0;
	var nonRtype_cnt = 0;
	var partLen = partsSeqObj.length;
	
	var needToSavePart = false;
	//china : 중국은 아래 체크로직이 없음, 
	//그러나 아직 저장안된 자재를 ticket no를 물고 주문을 하는건 맞지 않으므로, 글로벌 로직을 유지한다.
	for ( var i = 0; i < partLen; i++) {
		if (partsSeqObj[i].value == "") {
			needToSavePart = true;
			alert(_l.u.WEB_MSG_PREFIX + "Please save the service order before placing an order the repair parts on the Create Purchase Order screen.");
			return;
		}
	}

	// function addPartInfoForPO(skipSoNo, arrSoNo, arrSeq, arrPart, arrQty){
	//china : 중국에서는 partsQtyObj 를 파라미터로 던지지 않지만 isValidPartInfoForPO() 내부에서 아무런 사용도 안하므로, 글로벌 로직 그대로 둠.
	for ( var i = 0; i < partLen; i++) {
		if (isValidPartInfoForPO(false, partsSOObj[i].value,
				partsSeqObj[i].value, partsCodeObj[i].value,
				partsQtyObj[i].value, partsGiDateObj[i].value)) {
			if (_l.possibleRtypePo) {
				if(type == "R" && (partsTypeObj[i].value != "R" || $j('#IN_OUT_WTY').val() != "OW")) {
					//alert(_l.u.WEB_MSG_PREFIX + "R type materials and general materials can not be ordered together." + "[" + partsCodeObj[i].value + "]");
					nonRtype_cnt++;
					continue;
				} else if(type != "R" && partsTypeObj[i].value == "R" && $j('#IN_OUT_WTY').val() == "OW") {
					rtype_cnt++;
					continue;
				}
			}
			po_cnt++;
		} else if(_l.inventoryFlag && partsSOObj[i].value != "" && partsGiDateObj[i].value == "") {
			po_so_cnt++;
		}
	}
	//GI Date가 모두 들어 있어서 (GI Cancel상태) 카운트가 0이면
	if (po_cnt == 0) {

		if (partLen == 0) {
			alert(_l.u.WEB_MSG_PREFIX + "Please enter the part at first!");
			return;
		} else {
			if (_l.possibleRtypePo) {
				if(type == "R") {
					if(nonRtype_cnt > 0) {
						alert("There is no Rtype order case. Please click [Create PO] button.");
					}
				} else {
					if(rtype_cnt > 0) {
						alert("There is only R type order case. Please click [Create PO(R)] button.");
					}
				}
			}
			if (_l.u.c == "C310") {
				if(!_l.inventoryFlag || po_so_cnt > 0) {					
					if (!confirm(_l.u.WEB_MSG_PREFIX +"There is parts already ordered. Make sure that it is DOA parts.\n\nDo you want to order it anyway?")) {
						return;
					} else {
						$("notCheckSO").value = "X";
						addPartInfoForPO(true, partsSOObj, partsSeqObj,
								partsCodeObj, partsQtyObj, partsWtyObj, partsGiDateObj, partsTypeObj, type);
					}
				} else {
					alert(_l.u.WEB_MSG_PREFIX + "There is parts already issued.");
					return;
				}
			} else {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0039);
				return;
			}
		}
	} else {
		addPartInfoForPO(false, partsSOObj, partsSeqObj, partsCodeObj,
				partsQtyObj, partsWtyObj, partsGiDateObj, partsTypeObj, type);
	}

	$('CreatePOForm').partsType.value = type;
	$('CreatePOForm').action = getPOCreateUrl();
	$('CreatePOForm').assignedAscCode.value = $('ASSIGNED_ASC_CODE').value;
	$('CreatePOForm').fromModelVersion.value = _l.SEA_fromModelVersion;
	$('CreatePOForm').svcLevel.value = _l.vipLevel;
	_l.SEA_fromModelVersion = false;
	
	$('CreatePOForm').target = 'po_popup';// _new

	po_popup = window
			.open(
					"",
					"po_popup",
					"toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=0,left=200,width=1000,height=700");
	po_popup.focus();

	$('CreatePOForm').submit();
}

/**
 * * add some part for PO
 */
function addPartInfoForPO(skipSoNo, arrSoNo, arrSeq, arrPart, arrQty, arrWty, arrGiDate, partsType, type) {
	var divPartForPO = $('divPartForPO');
	clearGridJsonObject(divPartForPO);

	var serviceDate = _l.LAST_APP_DATE;
	var objectId = _l.ObjectId;
	var partLen = arrSeq.length;
	var hidTag = null;

	for ( var i = 0; i < partLen; i++) {
		
		if (isValidPartInfoForPO(skipSoNo, arrSoNo[i].value, arrSeq[i].value,
				arrPart[i].value, arrQty[i].value, arrGiDate[i].value)) {
			
			if (_l.possibleRtypePo) {
				if(type == "R" && (partsType[i].value != "R" || $j('#IN_OUT_WTY').val() != "OW")) {
					continue;
				} else if(type != "R" && partsType[i].value == "R" && $j('#IN_OUT_WTY').val() == "OW") {
					continue;
				}
			}

			hidTag = new Element("input", {
				"type" : "hidden",
				"name" : "poRefNo",
				"value" : objectId
			});
			divPartForPO.insert({
				bottom : hidTag
			});

			hidTag = new Element("input", {
				"type" : "hidden",
				"name" : "poSvcPartSeqNo",
				"value" : arrSeq[i].value
			});
			divPartForPO.insert({
				bottom : hidTag
			});

			hidTag = new Element("input", {
				"type" : "hidden",
				"name" : "poPart",
				"value" : arrPart[i].value
			});
			divPartForPO.insert({
				bottom : hidTag
			});

			hidTag = new Element("input", {
				"type" : "hidden",
				"name" : "poQty",
				"value" : arrQty[i].value
			});
			divPartForPO.insert({
				bottom : hidTag
			});

			hidTag = new Element("input", {
				"type" : "hidden",
				"name" : "poSvcDate",
				"value" : serviceDate
			});
			divPartForPO.insert({
				bottom : hidTag
			});

			if (_l.eurpeDistributor) {
				hidTag = new Element("input", {
					"type" : "hidden",
					"name" : "poPartWty",
					"value" : arrWty[i].value
				});
				divPartForPO.insert({
					bottom : hidTag
				});
			}// if(eurpeDistributor){%>

		}
	}// for
}
/**
 * china : 중국에서는 partsQtyObj 를 파라미터로 던지지 않지만 isValidPartInfoForPO() 내부에서 아무런 사용도 안하므로, 글로벌 로직 그대로 둠.
 */
function isValidPartInfoForPO(skipSoNo, soNo, seq, part, qty, giDate) {
	var valid = false;
	if (skipSoNo) {
		if(_l.inventoryFlag) {
			valid = (seq != "" && part != "" && giDate == "");
		} else {
			valid = (seq != "" && part != "");
		}
	} else {
		if(_l.inventoryFlag) {
			valid = (seq != "" && part != "" && soNo == "" && giDate == "");
		} else {
			valid = (seq != "" && part != "" && soNo == "");
		}
	}
	return valid;
}

