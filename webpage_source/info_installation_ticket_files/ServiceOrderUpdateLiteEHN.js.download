function setQnaCode(qnaCodeInfoObj, index){
	$('detailForm').QNA_CODE.value = qnaCodeInfoObj[index].qnaID;
}
var searchedQnaCode = "";
function searchQnaCodeInfo() {

	if(searchedQnaCode != "" && searchedQnaCode == $('QNA_CODE').value.trim()){
		return;
	}
	
	$('tempForm').cmd.value = 'QnaCodeSearchCmd';
	AjaxRequest(urlPatternGZIP, "tempForm", setJsonObjectQnaCode);
}
function setJsonObjectQnaCode(response) {
	try {
		var jsonObjQnaCodeInfo = eval('(' + response.responseText + ')');

		if (jsonObjQnaCodeInfo.success) {
			
			if(jsonObjQnaCodeInfo.qnaCodeInfoList.length > 1 ){
				openQnaCodeSearchPop();
				return;
			}else{
				setQnaCode(jsonObjQnaCodeInfo.qnaCodeInfoList, 0);					
			}
		} else {
			$('QNA_CODE').value = "";
			alert(_l.u.WEB_MSG_PREFIX + jsonObjQnaCodeInfo.returnMessage);
		}
	} catch (e) {
	}
}
function onKeyPressPartsQty(event){
	var keyCode = event.keyCode;
	if(keyCode == 0){
	  keyCode = e.which;
	}

	if (keyCode < 26 || keyCode < 45 || keyCode > 57){
		event.returnValue = false;
	}
}
function checkMesProduct() {

	if($j('#SERIAL_NO').val() == "" ){
		return;
	}
	if($j('#MODEL').val() == "" ){
		return;
	}
	//_l.ObjectId
	/*
	 * corpCode
MODEL
SERIAL
objectID
wtyInOut
cicProd
mesChkFlag
ReturnCode
ReturnMessage
	 * 
	 */
	$('tempForm').MODEL.value = $j('#MODEL').val();
	$('tempForm').SERIAL.value = $j('#SERIAL_NO').val();
	$('tempForm').wtyInOut.value = $j('#IN_OUT_WTY').val();
	$('tempForm').mesChkFlag.value = 'X';
	
	$('tempForm').cmd.value = 'MesModelCheckCmd';
	AjaxRequest(urlPatternGZIP, "tempForm", setJsonObjectMesModel);
}
function setJsonObjectMesModel(response) {
	try {
		var jsonObjMesModel = eval('(' + response.responseText + ')');

		if (jsonObjMesModel.success) {
			
		} else {
			alert(_l.u.WEB_MSG_PREFIX + jsonObjMesModel.returnMessage);
		}
	} catch (e) {
	}
}
var inputtedMaterial;
function getWtyPartsTerm(material){
	inputtedMaterial = material;
	$('progressloading').startWaiting();
	
	clearForm("frm");
	insertValue("frm", "ValidDate", _l.todayUserFormat);
	insertValue("frm", "Model", $j("#MODEL").val());
	insertValue("frm", "Serial", $j('#SERIAL_NO').val().toUpperCase());
	insertValue("frm", "SvcType", $j("#SERVICE_TYPE").val());
	insertValue("frm", "PostalCode", $j('#POST_CODE').val());
	insertValue("frm", "PurDate", $j("#PURCHASE_DT").val());
	insertValue("frm", "matnr", inputtedMaterial);
	
	insertValue("frm", "cmd", "WtyPartsTermListCmd");
	
	AjaxRequest(urlPatternGZIP, "frm", setPartsTermJsonObject);
}

function setPartsTermJsonObject(response) {
	try {
		$('progressloading').stopWaiting();
		var jsonObjPartTerm = eval('('+response.responseText+')');

		if (jsonObjPartTerm.success) {
			var messageHeader = _l.r.m.CORE_PART_TERM;
			var length = jsonObjPartTerm.dataLists.length;
			if(length > 0){
				for(var i=0; i<length;i++){
					if(jsonObjPartTerm.dataLists[0].matnr == inputtedMaterial){
						alert(messageHeader +"\n"+jsonObjPartTerm.dataLists[0].matnr +"("+jsonObjPartTerm.dataLists[0].matnr_desc+")"+" : " +Number(jsonObjPartTerm.dataLists[0].sbps_term) +"(月)");
						break;
					}
				}
			}
		} else {
			
		}

	} catch (e) {}	
}

function checkIceMakerIrKit() {
	var url = urlPatternGZIP;
	var data = "cmd=CheckIceMakerIrKitCmd&MODEL=" + $j("#MODEL").val()+ "&serialNo=" + $j("#SERIAL_NO").val()
	+ "&symptomCat1=" + $j('#SYMPTOM_CAT1').val()+ "&symptomCat2=" + $j('#SYMPTOM_CAT2').val()+ "&symptomCat3=" + $j('#SYMPTOM_CAT3').val()
	+ "&defectCode=" + $j("#IRIS_DEFECT").val();
	
	$j.ajax({
		type : "POST",
		async : false, /* 동기 */
		url : url,
		data : data,
		success : function(data) {
			if (data) {
				if (data.returnCode == 'S') {
					alert(_l.u.SAP_MSG_PREFIX + data.returnMessage)
				}
			}
		},
		dataType : 'json'
	});
}

