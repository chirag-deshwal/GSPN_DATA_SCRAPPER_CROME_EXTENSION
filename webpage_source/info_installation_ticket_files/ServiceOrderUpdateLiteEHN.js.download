function checkNewSerialNewIMEI() {
	var isValid = true; // true
	
	var product = $('HQ_SVC_PRCD').value;
	if(product == ""){
		product = getHQSvcProdAsync();
	}
	var partCodes = $j('#partsTableBody input[name="PARTS_CODE"]');
	var partSerials = $j('#partsTableBody input[name="SERIAL_MAT"]');
	var partDesc = $j('#partsTableBody input[name="PARTS_DESC"]');
	var isProductToCheck = product == "THB42" || product =="THB43"; 
	if(!isRunningOnOperation){
		isProductToCheck = product == "THB42" || product =="THB43" || product =="THB96"; 
	}
	if(isProductToCheck){
		for ( var i = 0; i < partCodes.length; i++) {
			
			if ($j.trim($j(partDesc[i]).val()).indexOf('CH SET') >= 0) {
				if($('NEW_SERIAL_NO').value.strip() == "" ){
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0050_00479);
					isValid = false;
				}
				if($('NEW_IMEI').value.strip() == ""){
					alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0050_00475);
					isValid = false;
				}
			}
		}
	}
	
	return isValid;
}

