		*/
	}else{
		if (billingFlag && !isBillingSaved && statusCode == "ST040") {
			alert(_l.u.WEB_MSG_PREFIX + _l.r.m.MAND_SAVEBILL);
			return;
		}
	}
	
	if (_l.u.c == "C750"){
		if(_l.PURCHASE_PLACE.toUpperCase()=="TURKCELL" && serviceType =="PS"){
				//C20060009736-Reason Code 표준화
				if((statusCode == "ST040" && statusReason =="HOZ01") || (statusCode == "ST040" && statusReason =="HG071") || statusCode == "ST052"){
				

				if(document.detailForm.SHIP_OUT_NO == undefined) {
					viewShipTabForC750Turkcell();
					return;
				} else{
					if(document.detailForm.SHIP_OUT_NO.value == "")	{
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0370);
						return;
					}
					
					if(!$j.isNumeric(document.detailForm.SHIP_OUT_NO.value)) {
						alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0371);
						return;
					}
					
					if(document.detailForm.SHIP_OUT_NO.value != "0000000") {						
						checkTrackingBoxAvailability();
						if(!_l.isTrackingBoxAvailability) {
							return false;
						}
					}
					
				}
			}
		}
	}

	//중국과 동일
	if (billingFlag && isBillingSaved) {
