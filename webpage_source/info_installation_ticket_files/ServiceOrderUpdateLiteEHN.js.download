function invoiceValidCheck(idx){
	
	var invoiceNum = $j("#partsTableBody input[name='INVOICE_NO']").eq(idx).val();
	var partsCode = $j("#partsTableBody input[name='PARTS_CODE']").eq(idx).val();
	if($j.trim(invoiceNum) == ""){
		alert(_l.u.WEB_MSG_PREFIX + "Input Invoice No");
		return false;
	}
	var result;
	var url = urlPatternGZIP;
	var data = "cmd=InvoiceValidCheckCmd&IM_NUMBER=" + invoiceNum + "&IV_PARTS_CODE="+ partsCode + "&IV_ASC_CODE="
			+ _l.ASC_CODE + "&IV_ENGINEER=" + _l.ENGINEER + "&IV_OBJECT_ID=" + _l.ObjectId;
	$j.ajax({
		type : "POST",
		async : false, /* 동기 */
		url : url,
		data : data,
		success : function(data) {
			if (data.eV_RET_CODE == "0") {					
				result = true;
			} else {
				// 정보가 없음
				if(data.eV_RET_MSG != "") alert(_l.u.SAP_MSG_PREFIX + "Invoice number("+invoiceNum+") is not matched parts code("+partsCode+") \n" + data.eV_RET_MSG);
				$j("#partsTableBody input[name='INVOICE_NO']").eq(idx).val("");
				result = false;
			}
		},
		dataType : 'json'
	});	
	return result;
}
function preventModifyPendingSO(){
	//Repaire Complete 이후에 Pending으로 다시 되돌아 온 경우
	//Defect / Repair description, SAW, Part 만 수정가능 requested by David Um 2015-11-20
	//적용대상 : FEME , WIS(837 제외)
	$j("input:text[name!=DEFECT_DESC][name!=REPAIR_DESC][name!=REPAIR_LOC][name!=PARTS_CODE][name!=INVOICE_NO][name!=PARTS_QTY][name!=SERIAL_MAT]")
	.attr("readonly", "readonly");
	$j("select[name!=PARTS_INOUT]").find("option:not(:selected)").each(function(){			
		if(	$j(this).parent().attr("name") != "STATUS" && $j(this).parent().attr("name") != "REASON"){
			$j(this).prop("disabled", true);
		}
	});
	//Can't select ST025
	$j("select[name=STATUS]").find("option[value=ST025]").prop("disabled", true);
	//attach
	if($j("#btnInsertAttach").length > 0) $j("#btnInsertAttach").hide();
	//customer tab - region code select fn.setCICCode에서 disabled처리
	//product tab - model code, serial, bos
	if($j("#aModelSearch").length > 0) $j("#aModelSearch").hide(); 
	if($j("#aSerialSearch").length > 0) $j("#aSerialSearch").hide(); 
	//bos는 bos버튼 숨기기/readonly 로직에 hasRcDatePendingStatus 변수 조건 추가 처리
	//job & date tab - New Model,New IMEI, date and time picker
	if($j("#aNewModelSearch").length > 0) $j("#aNewModelSearch").hide(); 
	if($j("#aNewImeiSearch").length > 0) $j("#aNewImeiSearch").hide(); 		
	$j("#divJob").find("input:text").removeAttr("onclick", "");//date picker		
	if($j("#divJob img[src*='/img/ico_time.gif']").length > 0) $j("#divJob img[src*='/img/ico_time.gif']").hide();//time picker
	$j("#divShipping").find("input:text").removeAttr("onclick", "");//date picker
}

function getRecommendedPartList(){
	$('progressloading').startWaiting();
	$j("#frm").empty();
	
	insertValue("frm", "IV_OBJECT_ID", _l.ObjectId);
	insertValue("frm", "cmd", "ZifGspnInvPredictPartsCmd");
	
	AjaxRequest(urlPatternGZIP, 'frm', callbackGetRecommendedPartList);
}
function callbackGetRecommendedPartList(response){
	try{
		var jsonObjRecommendedPartList = eval('('+response.responseText+')');
		if (jsonObjRecommendedPartList.error) {
			cfExceptionPop(jsonObjRecommendedPartList);
		}
		if (jsonObjRecommendedPartList.success){
			$j("#recommendedPartListTable").children().show();
			/** TBody 객체 ID */
			var tbodyObj = $('searchRecommendedPartListTableBody');
			/** 이전 Grid 객체에 노드가 있는 경우 새로 갱신하기 위해 삭제한다. */
			clearGridJsonObject(tbodyObj);

			var tdTag = null;
			var aTag = null;
			var inputTag = null;
			var length = jsonObjRecommendedPartList.etPredictPartsList.length;
			for ( var i = 0; i < length; i++) {
				var obj = jsonObjRecommendedPartList.etPredictPartsList[i];

				var trTag = document.createElement("tr");

				/** NO */
				tdTag = new Element("td", {
					"class" : "td_ac"
				});
				tdTag.update(i + 1);
				trTag.appendChild(tdTag);

				/** Parts No */
				tdTag = new Element("td", {"class" : "td_ac"});
				tdTag.update(obj.PARTS_CODE);
				trTag.appendChild(tdTag);
				
				/** PARTS_Description */
				tdTag = new Element("td", {"class" : "td_ac"});
				tdTag.update(obj.PARTS_DES);
				trTag.appendChild(tdTag);
				
				/** Recommended by */
				tdTag = new Element("td", {"class" : "td_ac"});
				tdTag.update(obj.TYPE_DESC);
				trTag.appendChild(tdTag);
			
				/** Detail */
				tdTag = document.createElement("td");
				tdTag.className = "td_ac";
				var aTag1 = document.createElement("a");
				aTag1.href = 'javascript:void(0)';
				var btnTag = new Element("input", {
					"type" : "button",
					"value" : "View"
				});
				btnTag.onclick = (function(partCode) {
					return function() {
						selectPart(partCode);
					}
				})(obj.PARTS_CODE);
				aTag1.appendChild(btnTag);
				tdTag.appendChild(aTag1);
				trTag.appendChild(tdTag);
				
				if(i == 0){
					/** PARTS_TEXT */
					tdTag = new Element("td", {"rowspan":length, "class":"td_ac"});
					tdTag.update(obj.PARTS_TEXT);
					trTag.appendChild(tdTag);
				}
				
				tbodyObj.appendChild(trTag);
			}
			
		}else{
			//alert(jsonObj.message + "\n" + "");			
		}
	    $('progressloading').stopWaiting();
	}catch(e){}
}

function selectPart(part){
	cfPopupPartsDetail(part);
}

function openNewClaimPopOnlyForVerify() {
	var statusCode = _l.currStatus;
	
	if (!checkHHPAccesorySAW()) {
		//return;
	}
	/* three attachement need for C820, C560(Recall) */
	if (!validAttachment()) {
		return;
	}
	
	// C8 중남미 법인일 경우
	if (isLaUser) {
		if (statusCode == 'ST070') {
			if ($("REP_TYPE").value != 'RH') {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0098);
				//return;
			}
			if (($("SERVICE_TYPE").value == 'CI' || $("SERVICE_TYPE").value == 'PS')
					&& $("LAB_TYPE").value != 'HC') {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0099);
				//return;
			}
			if ($("SERVICE_TYPE").value == 'IH' && $("LAB_TYPE").value != 'HI') {
				alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0100);
				//return;
			}
		}
	}// if(isLaUser){

	// Confrim if OW w'ty will be created. (2011-04-04)
	if (_l.IN_OUT_WTY == 'OW') {
		if (!confirm(_l.u.WEB_MSG_PREFIX +'This product is out of warranty, do you want to continue?'))
			return;
	}

	if (_l.sawPending) { /*
							 * SAW Request 상태인게 있으면 그 SO에 대해서는 워런티 생성하지 못하도록 -
							 * 2010-12-01
							 */
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0036);
	}

	if (checkWtyData()) {
		var url = "/wty/wtyclaim/NewWarrantyCic.jsp";
		
		if("B" == _l.u.CenterType)
			url = "/wty/wtyclaim/NewWarrantyCicMini.jsp";
		
		if($('IRIS_REPAIR').disabled){
			$('IRIS_REPAIR').disabled = false;
		}
		if($('REP_TYPE').disabled){
			$('REP_TYPE').disabled = false;
		}
		$('detailForm').action = url;
		$('detailForm').target = 'verify_popup';
		$('detailForm').submit();
		var firstMenu = 'Warranty';
		var secondMenu = 'Warranty Claim';
		var getMenu = 'Create New Warranty Claim';
		parent.naviDir(url, firstMenu + ':' + secondMenu + ':'
				+ getMenu);
	}
}

function gdBypassPopup(referer) {
	// 파일 업로드 실행
	var w = window
	.open(
			"",
			"bypass_popup",
			'toolbar=no,location=no,directories=no,status=yes,menubar=no,resizable=yes,copyhistory=no,scrollbars=no,top=150,left=300,width=700,height=200');
	w.focus();
	var obj = $('detailForm');
	obj.DIA_TYPE.value = referer;
	obj.action = '/svctracking/lite/gdBypassPopup.jsp';
	obj.method = 'post';
	obj.target = 'bypass_popup';
	obj.submit();
}

function setGDBypassReason(reason) {
	if(reason == null || reason == "") {
		alert(_l.u.WEB_MSG_PREFIX + "You did not select the Skip Reason.");
		isCanDIACheckByPass = false;
		return;
	}
	isCanDIACheckByPass = true;
	$("detailForm").DIA_ERROR.value = reason;
	verify();
}

function onChkUnablePan(obj){
	if(obj.checked)	{
		$j("#CUSTOMER_PAN").removeClass().addClass("inputRO").prop("readonly", true).val("");
		if($('IN_OUT_WTY').value == "OW")
			alert(_l.u.WEB_MSG_PREFIX + "Please enter Customer PAN or If PAN is not available then Service partner must retain signed copy of 'Form 60' from customer");
	} else 	{
		$j("#CUSTOMER_PAN").removeClass().addClass("input").prop("readonly", false);
	}
}


function getTurkcellTrackingInfo() {
	$('progressloading').startWaiting();
	
	$('detailForm').cmd.value = 'GetTurkcellTrackingInfoCmd';
	AjaxRequest(urlPattern,"detailForm", setTurkcellTrackingInfo);

}

function setTurkcellTrackingInfo(response){
	$('progressloading').stopWaiting();
	
	try{
		var result = eval('('+response.responseText+')');
		if(result.success){
			if(result.returnMessage != undefined && result.returnMessage != "") {
				alert(_l.u.SAP_MSG_PREFIX + result.returnMessage);
			} else {
				
				if(result.deliveredToTsDate != null && result.deliveredToTsDate.substring(0, 2) !="00") {				
					$j("#UNIT_RECV_DATE").val(result.deliveredToTsDate);
					$j("#UNIT_RECV_TIME").val(result.deliveredToTstime);
					$j("#FROM_CUST_DATE").val(result.deliveredToTsDate);
					$j("#JOB_FLAG" ).val("X");
				}
				
				if(result.arriveToTsDate != null && result.arriveToTsDate.substring(0, 2) !="00") {
					$j("#TO_ASC_DATE").val(result.arriveToTsDate);
				}
				
				if(result.departedFromTsDate != null && result.departedFromTsDate.substring(0, 2) !="00") {				
					$j("#FROM_ASC_DATE").val(result.departedFromTsDate);	
				}
				
				if(result.deliveredToDealerDate != null && result.deliveredToDealerDate.substring(0, 2) !="00") {				
					$j("#TO_CUST_DATE").val(result.deliveredToDealerDate);
				}
				
			}
			
		}else{
			alert(_l.u.SAP_MSG_PREFIX + result.returnMessage);
		}
	} catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + "TurkcellTrackingInfo error");
	}
}
function checkTrackingBoxAvailability() {
	if(document.detailForm.SHIP_OUT_NO.value == "")	{
		alert(_l.u.WEB_MSG_PREFIX + _l.r.m.EXT_0370);
		return "F";
	}
	$('detailForm').cmd.value = 'CheckShipOutNoAvailabilityCmd';
	AjaxSyncRequest(urlPattern,"detailForm", setcheckTrackingBoxAvailability);
}

function setcheckTrackingBoxAvailability(response){
	$('progressloading').stopWaiting();
	
	try{
		var result = eval('('+response.responseText+')');
		if (result.success) {
			_l.isTrackingBoxAvailability = true;
		} else {
			alert(_l.u.SAP_MSG_PREFIX + result.returnMessage);
			_l.isTrackingBoxAvailability = false;
		}
	}  catch (e) {
		alert(_l.u.WEB_MSG_PREFIX + "CheckTrackingBoxAvailability error");
		_l.isTrackingBoxAvailability = false;
	}
}
function setIRISCodeValueForCC(group){	
	/**
	 *                        Samsung                                 IRIS                                         EIA
	 * Condition Code      2-No Defect                         2-Intermittently                                     -      
	 * Symptom Code  1순위  TX1-No problem found                181-Test and check                           NTF-No Trouble Found      
	 *               2순위  TNDF-NDF                            18C-Software / Firmware updrade requested    F46-CUSTOMER SAT      
	 * Defect Code         Z-Software Bug                      3-No Problem found                           FNT-No Trouble Found      
	 * Repair Code   1순위  X01-no fault found                  L-Functional check                           51-NO EFRECT FOUND(NFF)          
	 *               2순위  SW4-S/W Ugrade(External Factor)     C3-Software adjustment by external service           -
	 */	
	if(group != ""){
		var IRIS = {};
		if(group.indexOf("NSAM") > -1){
			IRIS.CONDI = "2";
//			if($j("#detailForm").find("[name=IRIS_SYMPT]").find("option:[value=TX1]").length > 0){
//				IRIS.SYMPT = "TX1";
//			}else{
//				IRIS.SYMPT = "TNDF";		
//			}
			IRIS.DEFECT = "Z";
			if($j("#detailForm").find("[name=IRIS_REPAIR]").find("option:[value=X01]").length > 0){
				IRIS.REPAIR = "X01";
			}else{
				IRIS.REPAIR = "SW4";		
			}
		}else if(group.indexOf("IRIS") > -1){
			IRIS.CONDI = "2";
//			if($j("#detailForm").find("[name=IRIS_SYMPT]").find("option:[value=181]").length > 0){
//				IRIS.SYMPT = "181";
//			}else{
//				IRIS.SYMPT = "18C";		
//			}
			IRIS.DEFECT = "3";
			if($j("#detailForm").find("[name=IRIS_REPAIR]").find("option:[value=L]").length > 0){
				IRIS.REPAIR = "L";
			}else{
				IRIS.REPAIR = "C3";		
			}			
		}else if(group.indexOf("EIA") > -1){
			IRIS.CONDI = $("detailForm").IRIS_CONDI.value;
//			if($j("#detailForm").find("[name=IRIS_SYMPT]").find("option:[value=NTF]").length > 0){
//				IRIS.SYMPT = "NTF";
//			}else{
//				IRIS.SYMPT = "F46";		
//			}
			IRIS.DEFECT = "FNT";			
			IRIS.REPAIR = "51";		
		}else{return;}
		
		$("detailForm").DEFECT_DESC.value = "NDF";
		$("detailForm").REPAIR_DESC.value = "Consultation with GD";
		$("detailForm").LAB_TYPE.value = "L1";//Defect type Level 1
		
		$("detailForm").IRIS_CONDI.value = IRIS.CONDI;
		//$("detailForm").IRIS_SYMPT.value = IRIS.SYMPT;
		$("detailForm").IRIS_DEFECT.value = IRIS.DEFECT;
		$("detailForm").IRIS_REPAIR.value = IRIS.REPAIR;
	}
}

function toggle_gDRunDivActive(){
	if(_l.canUseIqcGd || _l.canUseOqcGd) {		
		if(isDiagnosticCheckModel){
			$j("#gDRunDivActive").css("display","block");
			$j("#gDRunDivNonActive").css("display","none");
			$j(".gd_iqc_btn").toggle(_l.canUseIqcGd && "ST015;ST025;ST030".indexOf(_l.CurrStatus) > -1);
			$j(".gd_oqc_btn").toggle(_l.canUseOqcGd);
			if (TA_OBJECT_ID != null && TA_OBJECT_ID != "") {
				$j("#btnDisplayDiagnosisResult").css("display" , "block");
			}
		} else {
			$j("#gDRunDivActive").css("display","none");
			$j("#gDRunDivNonActive").css("display","block");
		}	
	} else {		
		$j("#gDRunDivActive").css("display","none");
		$j("#gDRunDivNonActive").css("display","none");
	}
}


function initHME_PATIENT_IMP(){
	// HME user role 화면 2015.04.17 jiw
	if(_l.u.c == "C1X0" || isHmeUser){
		$('PATIENT_IMP').value = _l.PATIENT_IMP;
		if(_l.PATIENT_IMP == 'Y'){
			$('PATIENT_IMP').checked = true;
			document.detailForm.INJURED_FLAG[0].disabled = false;
			document.detailForm.INJURED_FLAG[1].disabled = false;
			if(_l.INJURED_FLAG == 'Y'){
				document.detailForm.INJURED_FLAG[0].checked = true;
			}else{
				document.detailForm.INJURED_FLAG[1].checked = true;
			}
		}
		
		hmeServiceTypechange($("SERVICE_TYPE").value);
		var hmeServiceType = $("HME_SVC_TYPE");
		
		if(1 < hmeServiceType.options.length){
			for(var i=0; i<hmeServiceType.options.length; i++){
				if(hmeServiceType.options[i].value == _l.HME_SVC_TYPE){
					hmeServiceType.options[i].selected = true;
					break;
				}
			}
		}
		
	}
}

