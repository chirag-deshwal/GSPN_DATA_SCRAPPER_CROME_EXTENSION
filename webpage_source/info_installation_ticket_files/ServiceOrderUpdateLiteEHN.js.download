	w = window.open(url + '?' + $j.param(params), "irn_login_popup", strPop);
}

function saveIRN(irnId, irnPwd, invNo){
	
	$('progressloading').startWaiting();
	
	clearForm("irnForm");
	
    insertValue("irnForm", "ivType", "3");
    insertValue("irnForm", "ivIrnId", irnId);
    insertValue("irnForm", "ivIrnPwd", irnPwd);
    insertValue("irnForm", "ivInvoiceNo", invNo);
    insertValue("irnForm", "ivAscCode", _l.ticketAccount);
	insertValue("irnForm", "ivCompany", _l.u.c_SEA);
	insertValue("irnForm", "CicCorpCode", _l.u.c);
	insertValue("irnForm", "ascCode", _l.ASC_CODE);
	insertValue("irnForm", "objectID", _l.ObjectId);
	
    insertValue("irnForm", "cmd", "ServiceOrderGetIRNSaveCmd");
    
    AjaxRequest(urlPatternGZIP, "irnForm", setSaveIRN);
	
}

function setSaveIRN(response){
	$('progressloading').stopWaiting();
	
    var jsonObjResult = eval('('+response.responseText+')');
    
    if(jsonObjResult.success){
        if(jsonObjResult.evRetCode == "E"){			// Error
			alert("Error in generation IRN! Please raise QNA with below error message.\n" + 
					" - IRN API Response : [" + jsonObjResult.evRetMsg + "]"
				);
        }else{										// success
        	alert("IRN generated successfully!");
        	//alert(jsonObjResult.evRetMsg);
        }
    }
	
}

