		//		  BiometricStatus가 수리 할 수 있는 상태인지 엔지니어 체크
		if(_l.isIndia){
			if($j("#STATUS").val() == "ST025" || $j("#STATUS").val() == "ST030" ){
				checkEngBioStatus();
				
				if(false &&  !_l.isEngineerAttendance){
